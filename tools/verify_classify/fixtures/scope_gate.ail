module tools/verify_classify/fixtures/scope_gate

-- The mutation gate's fixture for new_contract_policy's SCOPE pass
-- (test_new_contract_policy.py copies it into a scratch repository under
-- src/core/ and mutates it). As written it is GREEN: one production helper
-- with a contract, and four test-only declarations with none -- a tag helper,
-- a function only ever stored unapplied in a record, the fixture builder that
-- stores it, and a `pure func` that carries a tests block.
--
-- Every name here is deliberately NOT test-shaped: the pass must find the
-- scaffolding from the call graph, and the gate renames, moves and comments the
-- production helper to prove none of that moves it out of scope.

type Hook = { name: string, run: (int) -> int }

export pure func api(x: int) -> int
  ensures { result == x + 1 }
{
  render(x)
}

pure func render(x: int) -> int
  ensures { result == x + 1 }
{
  x + 1
}

pure func tag_of(x: int) -> string { "t${show(x)}" }

pure func bump(x: int) -> int { x + 2 }

pure func hook_fixture() -> Hook { { name: "h", run: bump } }

pure func scope_gate_check() -> bool
  tests [((), true)]
{
  let h = hook_fixture();
  tag_of(1) == "t1" && h.run(1) == 3 && api(1) == 2
}
