module registry/registry_generated

import pkg/fixture/motoko_ext_alpha/register (register_with_config as register_alpha)
import pkg/fixture/motoko_ext_beta/register (register_with_config as register_beta)
import registry/config (RuntimeConfig)
import pkg/sunholo/motoko_ext_abi/types (ExtRegistration, ExtEntry)
import pkg/sunholo/motoko_ext_abi/types (ExtRegistry)
import registry/normalize (normalize_registration, rejection_message)
import std/string (split, trim)
import std/option (Option, Some, None)
import std/result (Ok, Err)
import std/list as List (length)
import std/io (println, exit)
import std/json (encode, jo, kv, js)

func resolve(name: string, cfg: RuntimeConfig) -> Option[ExtRegistration] ! {IO} {
  if name == "alpha" then Some(register_alpha(cfg))
  else if name == "beta" then Some(register_beta(cfg))
  else None
}

-- B8: the registration boundary. Every resolved registration goes through
-- `normalize_registration` (D3 votes, D3 disjoint provider names, D4 fold
-- repeats, D7 empty), which builds the entry and carries `reg.config` into
-- `ExtEntry.config` unchanged (031 ADR-001 D2). A rejection FAILS THE
-- BUILD -- reported and exit 2 -- because silently omitting a mis-registered extension while the others load
-- is the fail-open shape [AR-codex "Missed"]. An EMPTY registration is
-- omitted by name (D7, recommended reading), never silently.
--
-- Both notices go out as JSONL events, not bare `println` lines: stdout is the
-- agent event channel, and the TUI's `parseAgentEventLine` drops every line
-- that is not JSON with a `type`. A bare print would leave the operator with a
-- runtime that exits 2 for no stated reason -- and, from a boot pre-spawn, a
-- fresh runtime dying the same way on every prompt.
func parse_tokens(xs: [string], idx: int, acc: [ExtEntry], cfg: RuntimeConfig) -> ExtRegistry ! {IO} {
  match xs {
    [] => { entries: acc },
    raw :: rest => {
      let name = trim(raw);
      match resolve(name, cfg) {
        None => parse_tokens(rest, idx + 1, acc, cfg),
        Some(reg) => {
          let id = "${name}#${show(idx)}";
          match normalize_registration(id, reg.config, reg.caps) {
            Err(e) => {
              let _ = println(encode(jo([
                kv("type", js("error")),
                kv("message", js("extension registry rejected: ${rejection_message(e)}"))])));
              let _ = exit(2);
              { entries: acc }
            },
            Ok(entry) =>
              if List.length(entry.caps) == 0 then {
                let _ = println(encode(jo([
                  kv("type", js("warning")),
                  kv("message", js("extension '${id}' registers no capability atom; omitted from the registry (D7)"))])));
                parse_tokens(rest, idx + 1, acc, cfg)
              } else parse_tokens(rest, idx + 1, acc ++ [entry], cfg)
          }
        }
      }
    }
  }
}

export func parse_core_ext_order(raw: string, cfg: RuntimeConfig) -> ExtRegistry ! {IO} {
  if trim(raw) == "" then { entries: [] }
  else parse_tokens(split(raw, ","), 0, [], cfg)
}
