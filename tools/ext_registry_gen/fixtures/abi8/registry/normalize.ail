-- 031 P0.5 registry fixture: a STUB of `src/core/ext/registry_normalize.ail` at
-- its 8.0 signature. The boundary that builds the entry receives the
-- registration's `config` and keeps it unchanged; the real module moves to this
-- signature at P1.1 and keeps its D3/D4/D7 rules, which this stub does not
-- restate (one rule is kept so the `Err` arm the template emits is reachable).
module registry/normalize

import std/json (Json)
import std/list as List (length)
import std/result (Result, Ok, Err)
import pkg/sunholo/motoko_ext_abi/types (Capability, ExtEntry)

export type RegistrationRejection = TooManyAtoms(string, int)

export pure func rejection_message(r: RegistrationRejection) -> string {
  match r { TooManyAtoms(id, n) => "[fixture-too-many-atoms] extension '${id}' registers ${show(n)} atoms" }
}

export pure func normalize_registration(id: string, config: Json, caps: [Capability]) -> Result[ExtEntry, RegistrationRejection] {
  if List.length(caps) > 8 then Err(TooManyAtoms(id, List.length(caps)))
  else Ok({ id: id, config: config, caps: caps })
}
