-- SURVIVOR for the per-file cap: slow.ail with fib(15), ~0.1 s. The same small
-- cap must NOT fire on it, so the timeout row cannot pass by firing on
-- everything.

module tools/test_coverage/timeout_fixtures/quick

pure func fib(n: int) -> int {
  if n < 2 then n else fib(n - 1) + fib(n - 2)
}

pure func quick_fib_is_positive() -> bool
  tests [((), true)]
{
  fib(15) > 0
}
