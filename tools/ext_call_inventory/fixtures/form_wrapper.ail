module tools/ext_call_inventory/fixtures/form_wrapper

-- FORM 3: a WRAPPER FUNCTION. The field is not called here at all -- it is taken
-- as a VALUE and handed to a wrapper, which calls it somewhere the receiver's
-- type is no longer visible. The port's own type resolves fine; what escapes is
-- the function.
--
-- This is the form most likely to look clean to a careless matcher, because the
-- text `ctx.ports.ai_step` appears verbatim and a matcher that keys on the path
-- rather than on the call would happily count it as a resolved site. It is the
-- opposite: the call site is elsewhere and invisible.

import pkg/sunholo/motoko_ext_abi/types (AiStepOutcome, ExtCtx, ExtWorld, Msg)

export func call_step(
  f: (ExtWorld, string, [Msg]) -> AiStepOutcome ! {AI, IO, Trace},
  w: ExtWorld,
  model: string,
  msgs: [Msg]
) -> AiStepOutcome ! {AI, IO, Trace} {
  f(w, model, msgs)
}

export func summarize(ctx: ExtCtx, model: string, msgs: [Msg])
  -> AiStepOutcome ! {AI, IO, Trace} {
  call_step(ctx.ports.ai_step, ctx.world, model, msgs)
}
