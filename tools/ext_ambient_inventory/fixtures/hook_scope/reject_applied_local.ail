-- REJECTION: `applied-local`.  A hook APPLIES a value it closed over at
-- registration.  A local can hold a function, so its effects are whatever the
-- caller put there -- classifier 2's discipline: an unresolvable receiver is a
-- rejection, not a pass.  This is door 6's dangerous corner: registration
-- usually hands a hook DATA, and this fixture is the case where it does not.
-- B8: eight-atom list, the application in `Compactor`.
-- P1.7r (031 ADR-001 D2): KEPT ON THE 7.4 SHAPE DELIBERATELY.  A payload that
-- CLOSES OVER a registration local is exactly the construction the 8.0
-- boundary forbids (a named top-level function captures nothing; fact 4 is
-- the reason `payload-inline-lambda` exists), so there is no 8.0 form of this
-- door to migrate to -- on 8.0 the same walk rejection reappears only as an
-- applied PARAMETER of a higher-order helper (herdr's `f`, pinned in the
-- tree-wide yield).  The gate is TESTING this old form: it pins
-- `payload-inline-lambda` and `return-shape-unsupported` on this text, beside
-- the walk's `applied-local`.
module fixture/reject_applied_local

import pkg/sunholo/motoko_ext_abi/types (ExtCtx, Capability, DescribeTools, PromptShaper, BudgetShaper, Compactor, ToolPolicy, ToolProvider, ResponseInterceptor, SolverJudge, PreStepOutcome, ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome)

export func register_with_config(cfg: a) -> [Capability] {
  let injected = cfg.callback;
  [
    DescribeTools(\_ . []),
    PromptShaper(\_ctx. { prepend: [], append: [] }),
    BudgetShaper(\_ctx _plan. { requested_total: None, requested_solver: None, requested_verifier: None }),
    Compactor(func(ctx: ExtCtx, msgs) -> PreStepOutcome ! {AI, IO, Trace} { { decision: { injected(msgs) }, next_state: ctx.world } }),
    ToolPolicy(\_ctx _call. NoOpinion),
    ToolProvider([], func(ctx: ExtCtx, _c) -> ToolHandleOutcome ! {IO, Process} { { decision: { Delegate }, next_state: ctx.world } }),
    ResponseInterceptor(func(ctx: ExtCtx, _r) -> ResponseInterceptOutcome ! {IO, Clock} { { decision: { NoIntercept }, next_state: ctx.world } }),
    SolverJudge(func(ctx: ExtCtx, _c) -> FinalizeOutcome ! {Process} { { decision: { NoDecision }, next_state: ctx.world } })
  ]
}
