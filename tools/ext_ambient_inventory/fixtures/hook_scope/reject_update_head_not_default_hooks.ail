-- REJECTION: `hook-record-unresolvable`, the update-head corner.  The base is a
-- builder declared in THIS module, so it is resolvable in principle -- and it is
-- still rejected, because the only base whose un-overridden slots this tool
-- reads is the ABI's `default_hooks`.  Admitting an arbitrary base means binding
-- seven slots to whatever that base's author wrote, which is the fail-open the
-- tiling assertion exists to prevent.  A computed base is the same rejection.
module fixture/reject_update_head_not_default_hooks

import pkg/sunholo/motoko_ext_abi/types (ExtensionHooks, ExtCtx, FinalizeOutcome)

func my_base(id: string) -> ExtensionHooks {
  {
    id: id,
    provided_tools: [],
    on_describe_tools: \_ . [],
    on_build_system_prompt: \_ctx. { prepend: [], append: [] },
    on_budget_plan: \_ _ . { requested_total: None },
    on_pre_step: func(ctx: ExtCtx, _m) -> PreStepOutcome ! {AI, IO, Trace} { { decision: { PassThrough }, next_state: ctx.world } },
    on_tool_policy: \_ctx _call. NoOpinion,
    on_tool_handle: func(ctx: ExtCtx, _c) -> ToolHandleOutcome ! {IO, Process} { { decision: { Delegate }, next_state: ctx.world } },
    on_response_intercept: func(ctx: ExtCtx, _r) -> ResponseInterceptOutcome ! {IO, Clock} { { decision: { NoIntercept }, next_state: ctx.world } },
    on_solver_candidate: func(ctx: ExtCtx, _c) -> FinalizeOutcome ! {Process} { { decision: { NoDecision }, next_state: ctx.world } }
  }
}

func finalize(ctx: ExtCtx, _candidate: string) -> FinalizeOutcome ! {Process} {
  { decision: { NoDecision }, next_state: ctx.world }
}

export func register_with_config(_cfg: a) -> ExtensionHooks {
  { my_base("reject_update_head_not_default_hooks") | on_solver_candidate: finalize }
}
