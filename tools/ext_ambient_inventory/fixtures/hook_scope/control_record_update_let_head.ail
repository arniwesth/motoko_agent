-- The update head as a LOCAL: `let base = default_hooks(id); { base | ... }`.
-- The base resolves through the producing body's `let` to the same ABI call, so
-- the seven default slots are read from the same literal.  Two overrides here,
-- one inline and one named, so both override routes are exercised behind an
-- update head.  Must resolve CLEAN.
module fixture/control_record_update_let_head

import pkg/sunholo/motoko_ext_abi/types (default_hooks, ExtensionHooks, ExtCtx, FinalizeOutcome)

func finalize(ctx: ExtCtx, _candidate: string) -> FinalizeOutcome ! {Process} {
  { decision: { NoDecision }, next_state: ctx.world }
}

export func register_with_config(_cfg: a) -> ExtensionHooks {
  let base = default_hooks("control_record_update_let_head");
  { base | on_build_system_prompt: \_ctx. { prepend: ["fixture"], append: [] }, on_solver_candidate: finalize }
}
