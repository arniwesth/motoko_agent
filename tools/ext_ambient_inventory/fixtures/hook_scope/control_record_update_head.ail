-- ADR-001 §1 / Q4: THE RECORD-UPDATE HEAD.  The live `empty_stop_guard` shape
-- after the `default_hooks` minor: one slot overridden by a named function in
-- the registration module, seven bound by the ABI's neutral literal.  A tool
-- that reads only the fields written HERE sees one of eight and must reject on
-- tiling; the fix binds the other seven to `default_hooks`'s own lambdas (read
-- from the real ABI module, not a copy) and walks them.  Must resolve CLEAN.
module fixture/control_record_update_head

import pkg/sunholo/motoko_ext_abi/types (default_hooks, ExtensionHooks, ExtCtx, FinalizeOutcome)

func finalize(ctx: ExtCtx, _candidate: string) -> FinalizeOutcome ! {Process} {
  { decision: { NoDecision }, next_state: ctx.world }
}

export func register_with_config(_cfg: a) -> ExtensionHooks {
  { default_hooks("control_record_update_head") | on_solver_candidate: finalize }
}
