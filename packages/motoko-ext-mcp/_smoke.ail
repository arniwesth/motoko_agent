-- Boot smoke test for motoko-ext-mcp.
--
-- M-EXT-PORTABILITY-GATE (v0.19.0): asserts register_with_config returns
-- without runtime panic in an empty workdir. mcp tolerates a missing
-- profile dir at register time (read_mcp_config returns an empty config),
-- so this should pass cleanly.
--
-- Run by:
--   - parent Makefile :: verify-extensions (process-per-package isolation)
--   - ailang publish (pre-publish smoke gate, AILANG v0.19.0+)
module sunholo/motoko_ext_mcp/_smoke

import std/io (println)
import pkg/sunholo/motoko_ext_mcp/register (register_with_config)

export func main() -> () ! {Env, FS, IO} {
  let _ = register_with_config(0);
  println("OK: register_with_config returned without panic")
}
