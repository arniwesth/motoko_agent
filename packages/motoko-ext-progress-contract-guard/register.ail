module sunholo/motoko_ext_progress_contract_guard/register

import std/option (None)
import pkg/sunholo/motoko_ext_abi/types (PreStepOutcome, ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome, 
  BudgetPlan,
  BudgetPatch,
  ExtCtx,
  Capability, DescribeTools, PromptShaper, BudgetShaper, Compactor, ToolPolicy, ToolProvider, ResponseInterceptor, SolverJudge,
  FinalizeDecision,
  Msg,
  PreStepDecision,
  ResponseInterceptDecision,
  ToolCallEnvelope,
  ToolHandleDecision,
  ToolPolicyDecision
)
import pkg/sunholo/motoko_ext_progress_contract_guard/progress_contract_guard (decide)

func no_budget_patch(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch {
  { requested_total: None, requested_solver: None, requested_verifier: None }
}

export func register_with_config(_cfg: a) -> [Capability] ! {Env, FS} {
  [
    DescribeTools(\_ . []),
    PromptShaper(\_ctx. { prepend: [], append: [] }),
    BudgetShaper(no_budget_patch),
    Compactor(func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {AI, IO, Trace}  { { decision: { PassThrough }, next_state: ctx.world } }),
    ToolPolicy(\_ctx _call. NoOpinion),
    ToolProvider([], func(ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand}  { { decision: { Delegate }, next_state: ctx.world } }),
    ResponseInterceptor(func(ctx: ExtCtx, _r: string) -> ResponseInterceptOutcome ! {IO, Process, FS, Clock}  { { decision: { NoIntercept }, next_state: ctx.world } }),
    SolverJudge(func(ctx: ExtCtx, candidate: string) -> FinalizeOutcome ! {Process}  { { decision: {
      decide(ctx, candidate)
    }, next_state: ctx.world } })
  ]
}
