module sunholo/motoko_ext_progress_contract_guard/register

import std/option (None)
import pkg/sunholo/motoko_ext_abi/types (PreStepOutcome, ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome, 
  ExtCtx,
  Capability, DescribeTools, PromptShaper, BudgetShaper, Compactor, ToolPolicy, ToolProvider, ResponseInterceptor, SolverJudge,
  FinalizeDecision,
  Msg,
  PreStepDecision,
  ResponseInterceptDecision,
  ToolCallEnvelope,
  ToolHandleDecision,
  ToolPolicyDecision
)
import pkg/sunholo/motoko_ext_progress_contract_guard/progress_contract_guard (decide)

export func register_with_config(_cfg: a) -> [Capability] ! {Env, FS} {
  -- Item 4 (6.0 trimming): only the atoms this extension binds with a real body.
  [
    SolverJudge(func(ctx: ExtCtx, candidate: string) -> FinalizeOutcome ! {Process}  { { decision: {
      decide(ctx, candidate)
    }, next_state: ctx.world } })
  ]
}
