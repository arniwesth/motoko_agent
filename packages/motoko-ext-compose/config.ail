module sunholo/motoko_ext_compose/config

import std/fs (fileExists, readFile)
import std/json (Json, decode, encode, jo, ja, kv, js, jb, jnum, getString, getInt, getBool, getObject, getStringArrayOrEmpty, get, asArray, JArray)
import std/result (Ok, Err)
import pkg/sunholo/motoko_ext_compose/types (
  ComposeConfig, ComposeAuthoringConfig, ComposeClaimcheckConfig, ComposeHostConfig
)

func empty_json() -> Json { jo([]) }

func object_at(root: Json, key: string) -> Json {
  match getObject(root, key) {
    Some(j) => j,
    None => empty_json()
  }
}

func json_string(obj: Json, key: string, fallback: string) -> string {
  match getString(obj, key) { Some(v) => v, None => fallback }
}

func json_int(obj: Json, key: string, fallback: int) -> int {
  match getInt(obj, key) { Some(v) => v, None => fallback }
}

func json_bool(obj: Json, key: string, fallback: bool) -> bool {
  match getBool(obj, key) { Some(v) => v, None => fallback }
}

func json_string_array(obj: Json, key: string, fallback: [string]) -> [string] {
  match get(obj, key) {
    Some(JArray(_)) => getStringArrayOrEmpty(obj, key),
    _ => fallback
  }
}

func read_json_silent(path: string) -> Json ! {FS} {
  if not fileExists(path) then empty_json()
  else match decode(readFile(path)) {
    Ok(j)  => j,
    Err(_) => empty_json()
  }
}

func parse_authoring(authoring: Json) -> ComposeAuthoringConfig {
  {
    structured: json_bool(authoring, "structured", true),
    author_tools: json_bool(authoring, "author_tools", false),
    author_tools_budget: json_int(authoring, "author_tools_budget", 25),
    author_tools_max_bytes: json_int(authoring, "author_tools_max_bytes", 16384),
    author_tools_max_turns: json_int(authoring, "author_tools_max_turns", 24),
    author_tools_deny_globs: json_string_array(authoring, "author_tools_deny_globs", []),
    authoring_budget: json_int(authoring, "authoring_budget", 40),
    fallback_after: json_int(authoring, "fallback_after", 3),
    min_observed_chars: json_int(authoring, "min_observed_chars", 180),
    stdout_max_bytes: json_int(authoring, "stdout_max_bytes", 4000)
  }
}

func parse_claimcheck(claimcheck: Json) -> ComposeClaimcheckConfig {
  {
    enabled: json_bool(claimcheck, "enabled", true),
    informalizer_model: json_string(claimcheck, "informalizer_model", ""),
    comparator_model: json_string(claimcheck, "comparator_model", ""),
    timeout_ms: json_int(claimcheck, "timeout_ms", 30000),
    max_invocations: json_int(claimcheck, "max_invocations", 10),
    stdout_max_bytes: json_int(claimcheck, "stdout_max_bytes", 4000),
    ledger_in_informalizer: json_bool(claimcheck, "ledger_in_informalizer", true)
  }
}

func parse_compose_json(root: Json) -> ComposeConfig {
  let c = object_at(root, "compose");
  let authoring = object_at(c, "authoring");
  let claimcheck = object_at(c, "claimcheck");
  {
    mode: json_string(c, "mode", "subagent"),
    subagent_model: json_string(c, "subagent_model", ""),
    max_attempts: json_int(c, "max_attempts", 50),
    effect_guard: json_string(c, "effect_guard", "1"),
    certificate_template: json_bool(c, "certificate_template", false),
    authoring: parse_authoring(authoring),
    claimcheck: parse_claimcheck(claimcheck)
  }
}

export func read_compose_config(profile_dir: string) -> ComposeConfig ! {FS} {
  let root = read_json_silent("${profile_dir}/compose.json");
  parse_compose_json(root)
}

export func read_snippet_caps(profile_dir: string) -> [string] ! {FS} {
  let root = read_json_silent("${profile_dir}/config.json");
  let tools = object_at(root, "tools");
  json_string_array(tools, "snippet_caps", ["IO", "FS", "Process"])
}

export func read_compose_host_config(profile_dir: string) -> ComposeHostConfig ! {FS} {
  let compose_cfg = read_compose_config(profile_dir);
  let caps = read_snippet_caps(profile_dir);
  { compose: compose_cfg, snippet_caps: caps }
}

-- ABI 8.0 (031 ADR-001 D2): the configuration channel. `register_with_config`
-- discloses the host config it read as `config`, ENCODED ONCE, and each named
-- callback decodes what it needs from `ext_config` per call. Every field is
-- written explicitly, so `host_config_of(host_config_json(c)) == c` (the
-- decoder is `parse_compose_json`, whose defaults then never apply). No field
-- is a credential: models, modes, limits, flags, globs and capability names.
pure func strs_json(xs: [string]) -> [Json] {
  match xs { [] => [], x :: rest => js(x) :: strs_json(rest) }
}

pure func int_json(n: int) -> Json { jnum(intToFloat(n)) }

pure func authoring_json(a: ComposeAuthoringConfig) -> Json {
  jo([
    kv("structured", jb(a.structured)),
    kv("author_tools", jb(a.author_tools)),
    kv("author_tools_budget", int_json(a.author_tools_budget)),
    kv("author_tools_max_bytes", int_json(a.author_tools_max_bytes)),
    kv("author_tools_max_turns", int_json(a.author_tools_max_turns)),
    kv("author_tools_deny_globs", ja(strs_json(a.author_tools_deny_globs))),
    kv("authoring_budget", int_json(a.authoring_budget)),
    kv("fallback_after", int_json(a.fallback_after)),
    kv("min_observed_chars", int_json(a.min_observed_chars)),
    kv("stdout_max_bytes", int_json(a.stdout_max_bytes))
  ])
}

pure func claimcheck_json(c: ComposeClaimcheckConfig) -> Json {
  jo([
    kv("enabled", jb(c.enabled)),
    kv("informalizer_model", js(c.informalizer_model)),
    kv("comparator_model", js(c.comparator_model)),
    kv("timeout_ms", int_json(c.timeout_ms)),
    kv("max_invocations", int_json(c.max_invocations)),
    kv("stdout_max_bytes", int_json(c.stdout_max_bytes)),
    kv("ledger_in_informalizer", jb(c.ledger_in_informalizer))
  ])
}

export pure func host_config_json(cfg: ComposeHostConfig) -> Json {
  let c = cfg.compose;
  jo([
    kv("compose", jo([
      kv("mode", js(c.mode)),
      kv("subagent_model", js(c.subagent_model)),
      kv("max_attempts", int_json(c.max_attempts)),
      kv("effect_guard", js(c.effect_guard)),
      kv("certificate_template", jb(c.certificate_template)),
      kv("authoring", authoring_json(c.authoring)),
      kv("claimcheck", claimcheck_json(c.claimcheck))
    ])),
    kv("snippet_caps", ja(strs_json(cfg.snippet_caps)))
  ])
}

export func host_config_of(cfg: Json) -> ComposeHostConfig {
  { compose: parse_compose_json(cfg), snippet_caps: json_string_array(cfg, "snippet_caps", ["IO", "FS", "Process"]) }
}

-- The two values the policy and the interceptor read, decoded without the rest.
export func composition_mode_of(cfg: Json) -> string {
  json_string(object_at(cfg, "compose"), "mode", "subagent")
}

export func snippet_caps_of(cfg: Json) -> [string] {
  json_string_array(cfg, "snippet_caps", ["IO", "FS", "Process"])
}

pure func caps_csv(xs: [string]) -> string {
  match xs { [] => "", x :: [] => x, x :: rest => "${x},${caps_csv(rest)}" }
}

-- The channel round-trips: every field survives encode then decode, including
-- the non-default ones (a default-valued decode would hide a dropped field).
func host_config_roundtrip(max_attempts: int) -> bool
  tests [(7, true), (50, true)]
{
  let c: ComposeHostConfig = {
    compose: {
      mode: "inline", subagent_model: "m-sub", max_attempts: max_attempts, effect_guard: "0",
      certificate_template: true,
      authoring: { structured: false, author_tools: true, author_tools_budget: 3, author_tools_max_bytes: 99,
                   author_tools_max_turns: 5, author_tools_deny_globs: [".env*", "secrets/**"], authoring_budget: 11,
                   fallback_after: 0, min_observed_chars: 12, stdout_max_bytes: 13 },
      claimcheck: { enabled: false, informalizer_model: "m-i", comparator_model: "m-c", timeout_ms: 14,
                    max_invocations: 15, stdout_max_bytes: 16, ledger_in_informalizer: false }
    },
    snippet_caps: ["IO", "Net"]
  };
  let d = host_config_of(host_config_json(c));
  encode(host_config_json(d)) == encode(host_config_json(c))
    && d.compose.max_attempts == max_attempts && d.compose.authoring.author_tools_budget == 3
    && composition_mode_of(host_config_json(c)) == "inline" && caps_csv(snippet_caps_of(host_config_json(c))) == "IO,Net"
}
