-- AI-powered conversation compaction extension.
-- Uses host-provided ports to summarize old conversation turns when context fills up.

module sunholo/motoko_ext_compaction_ai/compaction_ai

import std/ai (Message)
import std/crypto (sha256Hex)
import std/json (Json, jo, kv, js, jnum, get, getInt, asString)
import std/list (length as list_length)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/string (contains, substring, length as string_length)
import pkg/sunholo/motoko_ext_abi/types (ExtCtx, ExtPorts, PreStepDecision, PassThrough, Compacted, Msg, ToolCall)
import pkg/sunholo/motoko_ext_compaction_ai/types (CompactionAiConfig)
import src/core/ext/ctx_defaults (noop_ext_ports, empty_ext_artifacts, zero_token_telemetry)
import src/core/compaction (calibrated_usage_percent_anchored)

func msg_to_message(m: Msg) -> Message {
  { role: m.role, content: m.content, tool_calls: m.tool_calls, tool_call_id: m.tool_call_id }
}

func msgs_to_messages(msgs: [Msg]) -> [Message] {
  match msgs {
    [] => [],
    m :: rest => msg_to_message(m) :: msgs_to_messages(rest)
  }
}

-- Measure against provider truth: calibrate the char/4 estimate using the last
-- real input_tokens (ctx.telemetry) so the threshold fires at real usage, not
-- at char/4's ~23%-low estimate. See src/core/compaction.calibrated_usage_percent_anchored.
func usage_percent(ctx: ExtCtx, msgs: [Msg], context_limit: int) -> int {
  calibrated_usage_percent_anchored(
    msgs_to_messages(msgs),
    context_limit,
    ctx.telemetry.last_input_tokens,
    ctx.telemetry.last_estimated_input_tokens
  )
}

func format_msg(m: Msg) -> string {
  "[${m.role}] ${m.content}"
}

func format_msgs_for_summary(msgs: [Msg]) -> string {
  match msgs {
    [] => "",
    m :: [] => format_msg(m),
    m :: rest => "${format_msg(m)}\n${format_msgs_for_summary(rest)}"
  }
}

func summarization_prompt(old_turns: [Msg], recent_turns: [Msg]) -> string {
  let old_text = format_msgs_for_summary(old_turns);
  let recent_count = list_length(recent_turns);
  "Summarize the following conversation history in 2-3 sentences for a continuing agent session.
Preserve:
- Key decisions made
- Files modified
- Errors encountered and how they were resolved
- Original task objective and current task state
- Unresolved stop conditions, progress gates, and status/reporting cadence
- Latest status/progress facts and the next required action

Do not frame this as a new session, fresh context window, or handoff. Do not ask the user what to do
next unless the old turns prove the original task is complete.

OLD TURNS (summarize these):
${old_text}

RECENT TURNS (keep these verbatim - ${show(recent_count)} messages):
[... see recent context ...]

Provide a concise summary that captures essential context for continuing the original task."
}

-- Number of summarizer attempts before giving up. A transient provider
-- error (RateLimit / ConnectionFailed / Timeout, surfaced as Err) or an
-- empty response gets one retry; a persistent failure is reported so the
-- caller can degrade to PassThrough rather than corrupting the compacted
-- context with a placeholder summary.
--
-- NOTE: this does NOT interrupt an already in-flight stalled request —
-- std/ai's step/stepWithStream expose no per-call timeout, so an endpoint
-- that accepts the connection and then never streams still blocks the loop
-- (observed with :free OpenRouter models; MOT-38). A true wall-clock
-- timeout has to come from AILANG core; route that via ailang-feedback.
-- What this DOES fix: every summarizer failure that actually returns is
-- now converted into a safe skip instead of being spliced into the
-- context as if it were a real summary.
func summarizer_max_attempts() -> int { 2 }

func summarize_attempt(ctx: ExtCtx, prompt: string, model: string, attempts_left: int) -> Result[string, string] ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream} {
  let prompt_msgs: [Msg] = [{ role: "user", content: prompt, tool_calls: [], tool_call_id: "" }];
  match ctx.ports.ai_step(model, prompt_msgs) {
    Ok(content) =>
      if string_length(content) == 0 then
        (if attempts_left > 1 then summarize_attempt(ctx, prompt, model, attempts_left - 1) else Err("empty summary"))
      else Ok(content),
    Err(msg) =>
      if attempts_left > 1 then summarize_attempt(ctx, prompt, model, attempts_left - 1) else Err(msg)
  }
}

-- Result-returning summarizer used on the compaction path. Ok(summary) on
-- success; Err(reason) once attempts are exhausted so compact_with_ai can
-- degrade to PassThrough.
export func summarize_with_ai_result(ctx: ExtCtx, prompt: string, model: string) -> Result[string, string] ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream} {
  summarize_attempt(ctx, prompt, model, summarizer_max_attempts())
}

-- Back-compat string-returning wrapper. Preserves the historical
-- "[summarizer unavailable: ...]" sentinel for external callers and the
-- package smoke contract.
export func summarize_with_ai(ctx: ExtCtx, prompt: string, model: string) -> string ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream} {
  match summarize_with_ai_result(ctx, prompt, model) {
    Ok(content) => content,
    Err(msg) => "[summarizer unavailable: ${msg}]"
  }
}

type SplitResult = { prefix: [Msg], old: [Msg], recent: [Msg] }

func split_prefix(msgs: [Msg]) -> { prefix: [Msg], rest: [Msg] } {
  match msgs {
    [] => { prefix: [], rest: [] },
    m :: rest =>
      if m.role == "system" then {
        let next = split_prefix(rest);
        { prefix: m :: next.prefix, rest: next.rest }
      } else { prefix: [], rest: msgs }
  }
}

func has_tool_call_id(calls: [ToolCall], id: string) -> bool {
  match calls {
    [] => false,
    c :: rest => if c.id == id then true else has_tool_call_id(rest, id)
  }
}

func has_tool_result_for(calls: [ToolCall], msgs: [Msg]) -> bool {
  match msgs {
    [] => false,
    m :: rest =>
      if m.role == "tool" && has_tool_call_id(calls, m.tool_call_id) then true
      else has_tool_result_for(calls, rest)
  }
}

func split_at(msgs: [Msg], n: int) -> { old: [Msg], recent: [Msg] } {
  if n <= 0 then { old: [], recent: msgs }
  else match msgs {
    [] => { old: [], recent: [] },
    m :: rest => {
      let next = split_at(rest, n - 1);
      { old: m :: next.old, recent: next.recent }
    }
  }
}

func recent_starts_with_tool(recent: [Msg]) -> bool {
  match recent {
    [] => false,
    m :: _ => m.role == "tool"
  }
}

func old_has_tool_result_in_recent(old: [Msg], recent: [Msg]) -> bool {
  match old {
    [] => false,
    m :: rest =>
      if list_length(m.tool_calls) > 0 && has_tool_result_for(m.tool_calls, recent) then true
      else old_has_tool_result_in_recent(rest, recent)
  }
}

func move_boundary_earlier(old: [Msg], recent: [Msg]) -> { old: [Msg], recent: [Msg], moved: bool } {
  match old {
    [] => { old: [], recent: recent, moved: false },
    m :: [] => { old: [], recent: m :: recent, moved: true },
    m :: rest => {
      let next = move_boundary_earlier(rest, recent);
      { old: m :: next.old, recent: next.recent, moved: next.moved }
    }
  }
}

func adjust_split_boundary(old: [Msg], recent: [Msg]) -> { old: [Msg], recent: [Msg] } {
  if recent_starts_with_tool(recent) || old_has_tool_result_in_recent(old, recent) then {
    let moved = move_boundary_earlier(old, recent);
    if moved.moved then adjust_split_boundary(moved.old, moved.recent)
    else { old: old, recent: recent }
  } else { old: old, recent: recent }
}

func split_body(body: [Msg], keep_recent: int) -> { old: [Msg], recent: [Msg] } {
  let n = list_length(body);
  if n <= keep_recent then { old: [], recent: body }
  else {
    let initial = split_at(body, n - keep_recent);
    adjust_split_boundary(initial.old, initial.recent)
  }
}

func split_msgs(msgs: [Msg], keep_recent: int) -> SplitResult {
  let p = split_prefix(msgs);
  let body = split_body(p.rest, keep_recent);
  { prefix: p.prefix, old: body.old, recent: body.recent }
}

func status_call_ids(calls: [ToolCall]) -> [string] {
  match calls {
    [] => [],
    c :: rest =>
      if c.name == "MotokoRuntimeStatus" then c.id :: status_call_ids(rest)
      else status_call_ids(rest)
  }
}

func contains_id(ids: [string], wanted: string) -> bool {
  match ids {
    [] => false,
    id :: rest => if id == wanted then true else contains_id(rest, wanted)
  }
}

func latest_runtime_status_result_rec(msgs: [Msg], status_ids: [string], latest: Option[string]) -> Option[string] {
  match msgs {
    [] => latest,
    m :: rest => {
      if m.role == "assistant" then
        latest_runtime_status_result_rec(rest, status_ids ++ status_call_ids(m.tool_calls), latest)
      else if m.role == "tool" && contains_id(status_ids, m.tool_call_id) then
        latest_runtime_status_result_rec(rest, status_ids, Some(m.content))
      else latest_runtime_status_result_rec(rest, status_ids, latest)
    }
  }
}

func latest_status_marker_fallback(msgs: [Msg], latest: Option[string]) -> Option[string] {
  match msgs {
    [] => latest,
    m :: rest => {
      let next =
        if m.role == "tool" && contains(m.content, "\"tool\":\"MotokoRuntimeStatus\"") then Some(m.content)
        else latest;
      latest_status_marker_fallback(rest, next)
    }
  }
}

func latest_runtime_status_result(msgs: [Msg]) -> Option[string] {
  match latest_runtime_status_result_rec(msgs, [], None) {
    Some(content) => Some(content),
    None => latest_status_marker_fallback(msgs, None)
  }
}

func bounded_status_excerpt(content: string) -> string {
  let max = 1200;
  if string_length(content) <= max then content else "${substring(content, 0, max)}...[truncated]"
}

func status_section(status: Option[string]) -> string {
  match status {
    None => "not observed in compacted segment",
    Some(content) => "- correlated MotokoRuntimeStatus result observed\n- bounded_excerpt: ${bounded_status_excerpt(content)}"
  }
}

func summary_msg(ctx: ExtCtx, summary: string, status: Option[string]) -> Msg {
  {
    role: "assistant",
    content: "[RUNTIME COMPACTION SUMMARY]
This message was inserted by Motoko compaction. It is not a new user request, not a fresh session,
and not permission to stop. Continue the original task.

ORIGINAL TASK:
${ctx.task}

RUNTIME STATE:
- current_step_before_request: ${show(ctx.step)}
- model: ${ctx.model}
- context_limit: ${show(ctx.context_limit)}
- compaction: active; older turns were summarized for this request only

ACTIVE CONTROL OBLIGATIONS:
- Continue satisfying ORIGINAL TASK.
- Do not ask what to work on next unless ORIGINAL TASK is complete.
- Preserve explicit stop conditions from ORIGINAL TASK.
- If ORIGINAL TASK requires tool/status cadence, continue that cadence.

LATEST RUNTIME STATUS:
${status_section(status)}

AI SUMMARY OF OLDER CONTEXT:
${summary}",
    tool_calls: [],
    tool_call_id: ""
  }
}

func canonical_msgs(msgs: [Msg]) -> string {
  match msgs {
    [] => "",
    m :: rest => "${m.role}|${m.tool_call_id}|${show(list_length(m.tool_calls))}|${m.content}\n${canonical_msgs(rest)}"
  }
}

func segment_digest(msgs: [Msg]) -> string {
  "sha256:${sha256Hex(canonical_msgs(msgs))}"
}

func cached_summary(artifacts: Json, digest: string) -> Option[string] {
  match get(artifacts, "compaction_ai") {
    None => None,
    Some(node) => {
      let stored_digest = match get(node, "segment_digest") { None => "", Some(j) => match asString(j) { None => "", Some(s) => s } };
      if stored_digest != digest then None
      else match get(node, "summary") {
        None => None,
        Some(sj) => asString(sj)
      }
    }
  }
}

func last_ran_step(artifacts: Json) -> int {
  match get(artifacts, "compaction_ai") {
    None => -1,
    Some(node) => match getInt(node, "last_ran_step") {
      None => -1,
      Some(step) => step
    }
  }
}

func cache_artifact(digest: string, summary: string, step: int) -> Json {
  jo([
    kv("compaction_ai", jo([
      kv("segment_digest", js(digest)),
      kv("summary", js(summary)),
      kv("last_ran_step", jnum(_int_to_float(step)))
    ]))
  ])
}

-- Assemble the Compacted decision from a resolved summary (fresh or
-- cached). Returns PassThrough if the summary fails to relieve pressure.
func finalize_compaction(ctx: ExtCtx, msgs: [Msg], prefix: [Msg], recent_turns: [Msg], old_count: int, digest: string, summary: string, pct: int) -> PreStepDecision {
  let status = latest_runtime_status_result(msgs);
  let compacted = prefix ++ [summary_msg(ctx, summary, status)] ++ recent_turns;
  let new_pct = usage_percent(ctx, compacted, ctx.context_limit);
  if new_pct > pct then PassThrough
  else Compacted(compacted, "AI-summarized ${show(old_count)} turns (${show(pct)}% -> ${show(new_pct)}%)", cache_artifact(digest, summary, ctx.step))
}

export func compact_with_ai(ctx: ExtCtx, msgs: [Msg], cfg: CompactionAiConfig) -> PreStepDecision ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream} {
  let pct = usage_percent(ctx, msgs, ctx.context_limit);
  if pct < cfg.threshold_pct then PassThrough
  else if cfg.rate_limit_enabled && last_ran_step(ctx.artifacts) >= 0 && (ctx.step - last_ran_step(ctx.artifacts)) > 0 && (ctx.step - last_ran_step(ctx.artifacts)) < cfg.min_gap_steps && pct < cfg.hard_override_pct then PassThrough
  else {
    let keep_recent = if pct >= 90 then (cfg.keep_recent / 2) else cfg.keep_recent;
    let split_result = split_msgs(msgs, keep_recent);
    let old_turns = split_result.old;
    let recent_turns = split_result.recent;

    if list_length(old_turns) == 0 then PassThrough
    else {
      let projected = split_result.prefix ++ recent_turns;
      let projected_pct = usage_percent(ctx, projected, ctx.context_limit);
      if pct - projected_pct < cfg.min_relief_pct then PassThrough
      else {
      let digest = segment_digest(old_turns);
      match cached_summary(ctx.artifacts, digest) {
        Some(cached) => finalize_compaction(ctx, msgs, split_result.prefix, recent_turns, list_length(old_turns), digest, cached, pct),
        -- Fresh summary: on any returned failure, skip compaction this step
        -- rather than splice a broken placeholder into the context (MOT-38).
        None => match summarize_with_ai_result(ctx, summarization_prompt(old_turns, recent_turns), cfg.model) {
          Ok(summary) => finalize_compaction(ctx, msgs, split_result.prefix, recent_turns, list_length(old_turns), digest, summary, pct),
          Err(_) => PassThrough
        }
      }
      }
    }
  }
}

func test_cfg(rate_limit_enabled: bool) -> CompactionAiConfig {
  {
    model: "test-summarizer",
    threshold_pct: 1,
    keep_recent: 4,
    min_relief_pct: 5,
    rate_limit_enabled: rate_limit_enabled,
    min_gap_steps: 3,
    hard_override_pct: 95
  }
}

func test_ctx(step: int, limit: int, artifacts: Json) -> ExtCtx {
  {
    task: "t",
    step: step,
    model: "m",
    cwd: ".",
    hybrid_tools: false,
    budget: { total: 1, solver: 1, verifier: 0 },
    mode: "default",
    workdir: ".",
    env_server_url: "",
    budget_remaining: 1,
    history_slice: [],
    state_key: "k",
    context_limit: limit,
    ports: noop_ext_ports(),
    artifacts: artifacts,
    telemetry: zero_token_telemetry()
  }
}

-- A summarizer port that actually succeeds, so the compaction happy-path
-- tests exercise a real summary rather than relying on the degrade path.
func stub_ai_step(_model: string, _msgs: [Msg]) -> Result[string, string] ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream} {
  Ok("stub summary of prior turns")
}

func stub_ext_ports() -> ExtPorts {
  { noop_ext_ports() | ai_step: stub_ai_step }
}

func test_ctx_stub(step: int, limit: int, artifacts: Json) -> ExtCtx {
  { test_ctx(step, limit, artifacts) | ports: stub_ext_ports() }
}

func user(content: string) -> Msg {
  { role: "user", content: content, tool_calls: [], tool_call_id: "" }
}

func assistant(content: string) -> Msg {
  { role: "assistant", content: content, tool_calls: [], tool_call_id: "" }
}

func tool_call_msg(id: string) -> Msg {
  { role: "assistant", content: "calling ${id}", tool_calls: [{ id: id, name: "Tool", arguments: "{}" }], tool_call_id: "" }
}

func tool_result_msg(id: string, content: string) -> Msg {
  { role: "tool", content: content, tool_calls: [], tool_call_id: id }
}

func old_pair(n: int, content: string) -> [Msg] {
  [user("question ${show(n)}"), tool_call_msg("call-${show(n)}"), tool_result_msg("call-${show(n)}", content), assistant("observed ${show(n)}")]
}

func repeated_pairs(n: int, content: string) -> [Msg] {
  if n <= 0 then [] else old_pair(n, content) ++ repeated_pairs(n - 1, content)
}

func long_content() -> string {
  "deterministic payload abcdefghijklmnopqrstuvwxyz 0123456789 deterministic payload abcdefghijklmnopqrstuvwxyz 0123456789 deterministic payload abcdefghijklmnopqrstuvwxyz 0123456789 deterministic payload abcdefghijklmnopqrstuvwxyz 0123456789"
}

func test_ai_drip_projected_relief_passthrough() -> bool
  tests [((), true)]
  {
    let msgs = repeated_pairs(2, "tiny");
    match compact_with_ai(test_ctx(1, 500, empty_ext_artifacts()), msgs, test_cfg(false)) {
      PassThrough => true,
      Compacted(_, _, _) => false
    }
  }

func test_ai_batch_compacts_many_old_messages() -> bool
  tests [((), true)]
  {
    let msgs = repeated_pairs(8, long_content());
    match compact_with_ai(test_ctx_stub(1, 250, empty_ext_artifacts()), msgs, test_cfg(false)) {
      Compacted(out, note, _) =>
        contains(note, "AI-summarized")
          && list_length(out) < list_length(msgs)
          && not recent_starts_with_tool(out),
      PassThrough => false
    }
  }

-- MOT-38: a batch that WOULD compact with a working summarizer must skip
-- compaction (PassThrough) when the summarizer fails, instead of splicing
-- a "[summarizer unavailable: ...]" placeholder in as if it were a real
-- summary. Uses test_ctx (noop ports → ai_step returns Err).
func test_ai_summarizer_failure_degrades_to_passthrough() -> bool
  tests [((), true)]
  {
    let msgs = repeated_pairs(8, long_content());
    match compact_with_ai(test_ctx(1, 250, empty_ext_artifacts()), msgs, test_cfg(false)) {
      PassThrough => true,
      Compacted(_, _, _) => false
    }
  }

func test_ai_rate_limit_gap_and_same_step_cache() -> bool
  tests [((), true)]
  {
    let msgs = repeated_pairs(8, long_content());
    let cfg = test_cfg(true);
    match compact_with_ai(test_ctx_stub(10, 1000, empty_ext_artifacts()), msgs, cfg) {
      PassThrough => false,
      Compacted(out1, _, artifacts) => {
        let later = compact_with_ai(test_ctx_stub(11, 1000, artifacts), msgs, cfg);
        let same_step = compact_with_ai(test_ctx_stub(10, 1000, artifacts), msgs, cfg);
        match later {
          PassThrough =>
            match same_step {
              Compacted(out2, _, _) => list_length(out1) == list_length(out2),
              PassThrough => false
            },
          Compacted(_, _, _) => false
        }
      }
    }
  }

func test_summary_capsule_preserves_control_state() -> bool
  tests [((), true)]
  {
    let ctx = { test_ctx(7, 1000, empty_ext_artifacts()) | task: "Run until phase 200; report MotokoRuntimeStatus every 10 phases; do not stop early." };
    let m = summary_msg(ctx, "What would you like to work on?", None);
    contains(m.content, "[RUNTIME COMPACTION SUMMARY]")
      && contains(m.content, "ORIGINAL TASK")
      && contains(m.content, "not a fresh session")
      && contains(m.content, "Continue the original task")
      && contains(m.content, ctx.task)
      && contains(m.content, "What would you like to work on?")
  }

func runtime_status_call_msg(id: string) -> Msg {
  { role: "assistant", content: "status", tool_calls: [{ id: id, name: "MotokoRuntimeStatus", arguments: "{}" }], tool_call_id: "" }
}

func other_tool_call_msg(id: string) -> Msg {
  { role: "assistant", content: "other", tool_calls: [{ id: id, name: "OtherTool", arguments: "{}" }], tool_call_id: "" }
}

func test_latest_runtime_status_prefers_correlated_result() -> bool
  tests [((), true)]
  {
    let msgs = [
      other_tool_call_msg("other-1"),
      tool_result_msg("other-1", "unrelated mention \"tool\":\"MotokoRuntimeStatus\" current_step bad"),
      runtime_status_call_msg("status-1"),
      tool_result_msg("status-1", "{\"tool\":\"MotokoRuntimeStatus\",\"current_step\":47,\"step_budget\":100,\"finish_reason_so_far\":\"tool_calls\",\"stage_applied_total\":9,\"compaction_ai_applied\":8}")
    ];
    match latest_runtime_status_result(msgs) {
      None => false,
      Some(content) => contains(content, "\"current_step\":47") && not contains(content, "current_step bad")
    }
  }
