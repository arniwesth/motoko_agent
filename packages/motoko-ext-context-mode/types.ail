module sunholo/motoko_ext_context_mode/types

import std/json (Json, jo, kv, js, jint, getInt, getString)
import std/option (Some, None)

export type CtxConfig = {
  bin: string,
  timeout_ms: int,
  max_output_chars: int,
  snapshot_key_prefix: string
}

export type CtxSession = {
  snapshot: string,
  loaded: bool
}

-- THE CONFIGURATION CHANNEL (ABI 8.0, 031 ADR-001 D2 and Amendment 3).
-- `register` resolves `CtxConfig` from the environment and the agent prompt
-- from the workdir once, and discloses both as one object; every callback
-- decodes what it needs per call from `ctx.ext_config`. The workdir itself is
-- not disclosed. An absent key reads as the registration default.
export pure func default_ctx_config() -> CtxConfig {
  {
    bin: "context-mode",
    timeout_ms: 25000,
    max_output_chars: 6000,
    snapshot_key_prefix: "ctxmode:snapshot:"
  }
}

export pure func ctx_config_json(cfg: CtxConfig, cached_prompt: string) -> Json {
  jo([
    kv("cached_prompt", js(cached_prompt)),
    kv("bin", js(cfg.bin)),
    kv("timeout_ms", jint(cfg.timeout_ms)),
    kv("max_output_chars", jint(cfg.max_output_chars)),
    kv("snapshot_key_prefix", js(cfg.snapshot_key_prefix))
  ])
}

export pure func ctx_config_of(j: Json) -> CtxConfig {
  let d = default_ctx_config();
  {
    bin: match getString(j, "bin") { Some(v) => v, None => d.bin },
    timeout_ms: match getInt(j, "timeout_ms") { Some(n) => n, None => d.timeout_ms },
    max_output_chars: match getInt(j, "max_output_chars") { Some(n) => n, None => d.max_output_chars },
    snapshot_key_prefix: match getString(j, "snapshot_key_prefix") { Some(v) => v, None => d.snapshot_key_prefix }
  }
}

export pure func cached_prompt_of(j: Json) -> string {
  match getString(j, "cached_prompt") { Some(p) => p, None => "" }
}
