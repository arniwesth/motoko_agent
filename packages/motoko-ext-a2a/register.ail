module sunholo/motoko_ext_a2a/register

import std/env (getEnvOr)
import pkg/sunholo/motoko_ext_abi/types (Capability)
import pkg/sunholo/motoko_ext_a2a/config (read_a2a_config)
import pkg/sunholo/motoko_ext_a2a/a2a (make_hooks)

export func register_with_config(_cfg: a) -> [Capability] ! {Env, FS, Net, Rand} {
  let profile_dir = getEnvOr("MOTOKO_PROFILE_DIR", ".");
  let cfg = read_a2a_config(profile_dir);
  make_hooks(cfg)
}
