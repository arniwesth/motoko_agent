-- ABI contract for motoko_agent extension packages.
--
-- Every motoko-ext-* package depends on this module and must export:
--   register_with_config(cfg: RuntimeConfig) -> ExtensionHooks ! {}
-- from a module named <package-name>/register.
--
-- Bumping ExtensionHooks is a major version of motoko-ext-abi.

module sunholo/motoko_ext_abi/types

import std/option (Option)
import std/json (Json, jo)

-- Inlined from std/ai to avoid importing AI-effect functions into this pure ABI package.
export type ToolSchema = { name: string, description: string, parameters: string }

-- Inlined from std/ai.ToolCall — structurally identical so call.id / call.name /
-- call.arguments work the same across abi-typed and ai-typed values.
-- Added in motoko_ext_abi 2.1.0 to support Msg.tool_calls.
export type ToolCall = {
  id: string,
  name: string,
  arguments: string
}

-- Msg is the lightweight conversation-message type passed to extension
-- hooks (notably on_pre_step). Structurally compatible with std/ai.Message
-- so motoko_agent can convert between them losslessly.
--
-- v2.0.0 shape (still works for code that destructures only .role / .content):
--   { role: string, content: string }
--
-- v2.1.0 adds tool_calls + tool_call_id (M-ABI-MSG-WIRE-PARITY): assistant
-- messages with tool dispatch carry tool_calls; tool-role messages carry
-- the tool_call_id that providers use to correlate tool_use → tool_result.
-- Without these fields, on_pre_step compaction strips tool_call_id and
-- providers reject the next request with 422 (OpenRouter / OpenAI /
-- Anthropic all enforce this).
export type Msg = {
  role: string,
  content: string,
  tool_calls: [ToolCall],
  tool_call_id: string
}

-- Inlined from motoko_agent/src/core/tool_contract
export type ToolCallEnvelope = { id: string, tool: string, arguments: Json }
export type ToolResultEnvelope = {
  tool_call_id: string,
  tool: string,
  exit_code: int,
  stdout: string,
  stderr: string,
  metadata: Json
}

-- Inlined from motoko_agent/src/core/config
export type VerificationConfig = { enabled: bool, command: string }

export type BudgetPlan = { total: int, solver: int, verifier: int }

-- WI-B2b. THE WORLD TOKEN — D1's successor state, crossing the extension seam.
--
-- `token` is OPAQUE and extension code must not read it. It is produced and
-- consumed only by the host (`src/core/ext_world.ail`); an extension's whole
-- obligation is to CARRY it — take the one in `ExtCtx.world`, pass it to every
-- world-threading port call, and return the last one it holds as `next_state`.
--
-- WHY OPAQUE, and this is the item's central decided binding. The successor is
-- `src/core/ports.WorldState`, and this ABI cannot name that type: `motoko_core`
-- depends on THIS package, so the dependency cannot invert. Three alternatives
-- were measured and rejected:
--
--   1. INLINE IT, the idiom this file already uses for `Msg`, `ToolCall`,
--      `ToolCallEnvelope` and `ToolResultEnvelope`. Those work because AILANG
--      unifies records STRUCTURALLY — a probe confirmed a differently-NAMED but
--      identically-shaped record unifies across modules. It does not extend to
--      `WorldState`, because `WorldState` transitively contains SUM types
--      (`IdentityBody`, `OutcomeStatus`, `ToolFaultChoice`) and the same probe
--      showed sums are NOMINAL: two identically-shaped sums fail to unify with
--      `cannot unify type constructors: BStatus vs AStatus`. A mirrored world
--      would therefore not type-check at the seam.
--   2. PARAMETRISE this ABI over the world type. That changes `ExtCtx` into
--      `ExtCtx[W]` and so rewrites `on_build_system_prompt` and `on_tool_policy`
--      — two of D5's three ROWLESS slots, which are its entire coverable
--      surface and which B1, B2a and B3 all left byte-identical. Rejected.
--   3. EXTRACT `dst_interaction` (404 lines) and `dst_generator` (1519) into a
--      leaf package below this one. Both import only `std/*`, so it is feasible
--      — but it puts the DST generator into all fourteen extension packages'
--      dependency graphs to serve one seam. Out of proportion.
--
-- So the token is a Json carrier, which is exactly why D5 says "explicit/OPAQUE
-- world token": the dependency direction is what makes opacity necessary, not a
-- preference. The cost is a real codec, and its guard is S7's record-level rule
-- — a field-by-field round trip with every field holding a distinct value, at
-- the foot of `src/core/ext_world.ail`. A field the encoder writes and the
-- decoder ignores is this design's one silent failure mode; both halves of it
-- were mutation-tested when the codec landed and both mutants died.
export type ExtWorld = { token: Json }

-- The empty world, for a context that has no driver behind it — test fixtures,
-- smoke harnesses, and the no-op ports. It is `jo([])` rather than a sentinel
-- because the host's decoder is TOTAL: every field falls back, so an empty
-- object decodes to exactly `empty_world_state()`. That means a fixture using
-- this is not carrying a special value the host has to recognise; it is
-- carrying a real, empty world.
--
-- It is NOT a default for production code. A hook handed this on a live path
-- would see an empty script and be told the model answered — which is precisely
-- the pre-WI-B2b behaviour this widening removed.
export pure func empty_ext_world() -> ExtWorld { { token: jo([]) } }

-- The result of a world-threading `ai_step`. A RECORD and not a sum, per plan
-- decision P1 (A12's precedent): a later effect class adds a FIELD here, where a
-- sum would make it a variant restructuring at every match site.
--
-- `next_state` is named for the criterion, not for taste. D5's classifier 2
-- selects "a field whose call is the extension-side entry to a core seam that D1
-- requires to thread successor state, AND WHICH CANNOT RETURN IT", and
-- `tools/ext_call_inventory/derive.py` derives that mechanically by asking
-- whether the result type has a field literally called `next_state`
-- (`SUCCESSOR_FIELD`). Renaming this field silently puts `ai_step` back in the
-- classifier-2 set. That is a DISCOVERED binding, matching `ProviderExchange`,
-- `EnvRead`, `ToolExecution` and `ClockReading` in `src/core/ports.ail`.
export type AiStepOutcome = {
  result: Result[string, string],
  next_state: ExtWorld
}

-- The result of a world-threading `clock_now`. WI-C5, and it is the SAME shape
-- as `AiStepOutcome` above and `ClockReading` in `src/core/ports.ail` for the
-- same reason: a record, so a later effect class adds a field rather than
-- restructuring every match site (plan decision P1).
--
-- `next_state` is again named for D5's classifier-2 criterion rather than for
-- taste — `tools/ext_call_inventory/derive.py` looks for that literal field
-- name. Renaming it puts `clock_now` back in the classifier-2 set silently.
export type ExtClockReading = {
  now_ms: int,
  next_state: ExtWorld
}

export type ExtPorts = {
  -- WI-B2b: takes and returns the world token. This is the widening that lifts
  -- D1's extension-model-path exclusion — `session.ext_ai_step` handed
  -- `empty_world_state()` and dropped the successor precisely because this
  -- signature had nowhere to put it.
  --
  -- WI-B2a: `+ Trace`. Demanded, not chosen: `Ports.model_step` has carried
  -- `Trace` since WI-A1, and `session.ext_ports_of` bridges `Ports` to
  -- `ExtPorts`, so the bridging lambda performs `Trace` and a closed row cannot
  -- hide it. M2 predicted this row; WI-B1 could not confirm it because the
  -- module died on `images` first.
  ai_step: (ExtWorld, string, [Msg]) -> AiStepOutcome ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream, Trace},
  -- `proc_exec` and `env_get` stay un-widened and stay in the classifier-2 set.
  -- They front `Ports.tool_exec` and `Ports.env_get`, both of which thread a
  -- successor, so both still drop one. Widening them is WI-C5's, and leaving
  -- them measured-and-named is S2: the classifier keeps reporting them.
  proc_exec: (string, string) -> string ! {IO, Process, FS},
  -- WI-C5: takes and returns the world token, exactly as `ai_step` does.
  --
  -- WHAT THIS WIDENING BOUGHT, precisely, because the shape and the coverage are
  -- different questions. Before it, this field was `() -> int` — zero-argument,
  -- and AILANG has no zero-arg lambdas in expression position on the pin, so
  -- `session.ext_ports_of` could not write a closure capturing the world AT ALL.
  -- Plan rule S2 therefore bound it to an ambient `now()` deliberately, choosing
  -- a read that reddens the Clock poison probe over a frozen snapshot that
  -- nothing could see. That was the ONLY unroutable-by-shape seam in the ABI and
  -- it is now routed: `ext_ports_of` bridges it to `Ports.clock_now` through the
  -- same `token_to_world`/`world_to_token` codec `ai_step` uses, and
  -- `src/core/session.ail:878` has left the declared-unrouted set.
  --
  -- It did NOT make any extension coverable. Coverage is D5's per-hook question
  -- and it is blocked on `on_budget_plan`'s row below, not on this one.
  -- SUPERSEDED IN ITS SECOND CLAUSE AT WI-D6 (2026-08-06), and the first clause
  -- stands: this widening still made nothing coverable, but `on_budget_plan`'s
  -- row below no longer blocks anything — D6 narrowed it. The sentence was true
  -- when written at WI-C5 and is kept rather than re-dated, per plan rule S15.
  clock_now: (ExtWorld) -> ExtClockReading ! {Clock},
  env_get: (string, string) -> string ! {Env}
}

export type TokenTelemetry = {
  last_input_tokens: int,
  last_output_tokens: int,
  -- char/4 estimate of the window that produced last_input_tokens. Lets the
  -- compaction gate anchor on provider truth (last_input_tokens/last_estimated).
  -- 0 before the first provider result.
  last_estimated_input_tokens: int
}

export type ExtCtx = {
  task: string,
  step: int,
  model: string,
  cwd: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  mode: string,
  workdir: string,
  env_server_url: string,
  budget_remaining: int,
  history_slice: [Msg],
  state_key: string,
  -- v2.2.0: context_limit in tokens for ctx.model. Populated by the host
  -- via src/core/context_usage.context_limit_for(model). 0 means
  -- "unknown" — extensions should treat as "skip context-aware behaviour"
  -- rather than guessing with a stale heuristic. Eliminates the duplicate
  -- model-registry tables that previously lived in motoko_ext_compaction_ai.
  context_limit: int,
  ports: ExtPorts,
  artifacts: Json,
  telemetry: TokenTelemetry,
  -- WI-B2b: the INBOUND half of the world token. The successor travels back out
  -- on the hook's outcome record; this is where it comes in.
  --
  -- It rides on `ExtCtx` rather than being added as a parameter to every hook
  -- deliberately: `ExtCtx` is a record, so this is an ADDITIVE field (A12's P1
  -- argument again), and it leaves the type NAME of every hook slot's parameter
  -- list unchanged. That is what keeps D5's three rowless slots
  -- (`on_describe_tools`, `on_build_system_prompt`, `on_tool_policy`)
  -- byte-identical through this ABI major, which B1, B2a and B3 all managed and
  -- which `make profile_coverage` would otherwise report.
  --
  -- A hook that performs no world-threading effect returns this value unchanged
  -- as its `next_state`. That is D1's identity transition, not a stub.
  world: ExtWorld
}

export type PromptPatch = {
  prepend: [string],
  append: [string]
}

export type BudgetPatch = {
  requested_total: Option[int],
  requested_solver: Option[int],
  requested_verifier: Option[int]
}

export type PolicyDefault
  = AllowAfterTimeout
  | DenyAfterTimeout
  deriving (Eq)

export type ToolPolicyDecision
  = Allow
  | Deny(string)
  | NoOpinion
  | Pending(string, PolicyDefault)
  deriving (Eq)

export type ToolHandleDecision
  = Handled(ToolResultEnvelope)
  | Delegate

export type ResponseInterceptDecision
  = InterceptHandled(ToolResultEnvelope)
  | NoIntercept

export type FinalizeDecision
  = Accept(string)
  | ContinueWithFeedback(string)
  | NoDecision
  deriving (Eq)


-- Decision type for pre-step compaction hooks.
-- PassThrough: no compaction needed, proceed with original msgs
-- PassThroughObserved: no compaction, but record one bounded diagnostic
-- Compacted: extension has compacted the message list, use the new one
export type DiagnosticField = { key: string, value: string }

export type PreStepDecision
  = PassThrough
  | PassThroughObserved(code: string, fields: [DiagnosticField])
  | Compacted(msgs: [Msg], note: string, artifacts: Json)
  deriving (Eq)

-- WI-B2b. THE OUTBOUND HALF of the world token, one wrapper per hook result.
--
-- The four decision types above are unchanged and stay SUMS — they are genuine
-- alternatives and a reader matches on them. What is added is a RECORD around
-- each, carrying the decision beside the successor, which is plan decision P1's
-- shape: a later effect class adds a field to these four records, where folding
-- the successor INTO each sum would have meant restructuring every variant and
-- every match arm in the tree.
--
-- `next_state` is named to satisfy `derive.py`'s `SUCCESSOR_FIELD`, exactly as
-- on `AiStepOutcome` above — see that type's comment.
--
-- A hook that performs no world-threading effect writes
-- `{ decision: <its decision>, next_state: ctx.world }`. Returning a DIFFERENT
-- world than the one it was given, without having called a world-threading
-- port, is the F6 defect this whole protocol exists to prevent.
-- WI-B4 MEASURED A HOLE IN THE CLOSED-ROW GUARANTEE, and it is recorded here
-- because this is the file whose rows the guarantee is about.
--
-- WI-B2a's argument, which WI-B2b re-confirmed and which this plan leaned on to
-- excuse 123 sites from mutation testing, is: a closed row admits exactly one
-- width -- an implementation must EQUAL its ABI field's row, not be a subset or
-- a superset -- so a lockstep site has no band in which two answers type-check.
-- That holds for a DIRECT implementation. It does NOT hold through a
-- FUNCTION-TYPED PARAMETER.
--
-- Reproduced at HEAD: `ext/runtime.ail:545`'s
-- `chain_base_hook(id, pre: (ExtCtx, [Msg]) -> PreStepOutcome ! {...})` assigns
-- `pre` straight into `on_pre_step`, whose row below is closed and includes
-- `Trace`. Drop `Trace` from that PARAMETER's row and `ailang check` on the file
-- is green and `make check_core` is green -- 52/52. Two widths type-check, and
-- the narrower one is silent. WI-B4's mutation loop over the wave's 139 widened
-- function rows found seven sites of exactly this shape and NO other over-wide
-- row, so the hole is not hypothetical: it is where every finding landed.
--
-- All seven are deliberately held at the FULL row. Do not "tidy" them narrower:
-- the wide row is the one that matches this ABI, and the compiler will not tell
-- you when it stops doing so. Relatedly, D5 already records that a declared row
-- does not bound performed effects through function-valued record fields at all
-- (`fb_74f53de3ae65854c`); this is the same seam seen from the declaration side.
export type PreStepOutcome = { decision: PreStepDecision, next_state: ExtWorld }
export type ToolHandleOutcome = { decision: ToolHandleDecision, next_state: ExtWorld }
export type ResponseInterceptOutcome = { decision: ResponseInterceptDecision, next_state: ExtWorld }
export type FinalizeOutcome = { decision: FinalizeDecision, next_state: ExtWorld }

export type ExtensionHooks = {
  id: string,
  provided_tools: [string],
  on_describe_tools: () -> [ToolSchema],
  on_build_system_prompt: (ExtCtx) -> PromptPatch,
  -- WI-D6 NARROWED THIS ROW, and it is the row that blocked every install in
  -- the tree from the ABI's first version until 2026-08-06.
  --
  -- WAS, through WI-D5: `! {Env, FS}` — closed. Under D5's coverage criteria
  -- the slot was then coverable under NEITHER: criterion 1 (deterministic and
  -- effect-free) failed on the declared row, and criterion 2 (world-mediated
  -- with explicit world state returned) failed because `BudgetPatch` carries no
  -- successor field. The slot is also UNCONDITIONALLY dispatched, so a profile
  -- could not exclude it either. Every extension in the tree binds it, so no
  -- extension was installable in a conformant profile — see WI-D5's verdict,
  -- which named this row as "the one item that would make the name transfer".
  --
  -- IS, from WI-D6 (2026-08-06): no row. The slot is coverable under criterion
  -- 1, and the empty install list of `driver_only` is now a CHOICE rather than
  -- a consequence of this line.
  --
  -- WHY THIS IS A NARROWING TO THE MEASUREMENT RATHER THAN A RELAXATION.
  -- `make declared_vs_performed` measures all fifteen bindings against two
  -- independent producers and NOT ONE of them performs `Env` or `FS`:
  --   * the runtime capability trap, out of process, witnessed 7 of 15
  --     directly (the other 8 are unreachable by that instrument because their
  --     own `register_with_config` reads `Env`/`FS` BEFORE any hook runs — the
  --     confound is documented in the runner);
  --   * the effect checker, over all 15, total over inputs — which is what
  --     licenses the claim for the 8 the runtime producer cannot reach.
  -- WI-D5's verdict had already concluded from C5's single measurement that
  -- "the barrier is the rule, not the behaviour". D6 measured the other
  -- fourteen and moved the rule to the behaviour.
  --
  -- THE COMPILER NOW ENFORCES THIS, and that is the point rather than a bonus.
  -- Record-field rows are CLOSED and admit exactly one width, so a binding that
  -- performs `Env` or `FS` here no longer type-checks:
  --   incompatible closed rows: r1 has extra labels [], r2 has extra labels [Env FS]
  -- An extension that starts reading a config file in its budget hook fails to
  -- build. Re-widening this row is therefore a deliberate act, not a drift, and
  -- `make declared_vs_performed` asserts the narrow row on every run.
  --
  -- WHAT THIS DID NOT DO: it did not make any profile cover anything.
  -- `driver_only` still installs nothing, and the axis's extension-model
  -- coverage is still ZERO. This row removed the blocker; spending it is
  -- WI-C5's `compose`-bearing profile.
  on_budget_plan: (ExtCtx, BudgetPlan) -> BudgetPatch,
  -- WI-B2a: `+ Trace`, and it is the SECOND and last row this item changed.
  -- It is a CONSEQUENCE of `ExtPorts.ai_step` above, not an independent finding:
  -- `Trace` reaches the extension surface only through `ai_step`, and the only
  -- two callers of `ai_step` in the tree — `compaction_ai.summarize_attempt`
  -- and `reject_fixtures.nocache_pre_step` — are both on the `on_pre_step` path.
  -- That is why THIS row moved and the other two did not: measured, not assumed.
  -- WI-D7 MEASURED THIS ROW AND DID NOT MOVE IT. Recorded because "unchanged"
  -- and "unexamined" are indistinguishable in a diff, and this row is now the
  -- former.
  --
  -- THE MEASUREMENT: all fifteen bindings narrowed to no row at all, tree-wide,
  -- and `ailang check` run over all 71 files of the fifteen packages derived
  -- from `registry_generated.ail`. FOURTEEN of fifteen accept the empty row.
  -- ONE refuses, and the compiler names it:
  --
  --   packages/motoko-ext-compaction-ai/register.ail:93
  --   failed to unify record field 'on_pre_step': incompatible closed rows:
  --   r1 has extra labels [AI Clock Env FS IO Net Process SharedMem Stream Trace]
  --
  -- and the body confirms it independently — narrowing `compact_with_ai`'s own
  -- annotation gives `Effect checking failed for function 'fresh_compaction'`,
  -- which is the effect checker inferring from the body over ALL inputs rather
  -- than comparing two annotations.
  --
  -- WHY NO NARROWER ROW IS AVAILABLE, and it is NOT that the behaviour is wide.
  -- `compaction_ai`'s pre-step reaches every one of those ten effects through a
  -- SINGLE call — `ctx.ports.ai_step`, whose own port row above is exactly
  -- those ten. The row here is a consequence of the PORT's row, so narrowing it
  -- is a port-surface change and not a hook-row change. That is WI-C5/D1 work
  -- and deliberately not done here.
  --
  -- THE PART THAT MATTERS FOR D5'S CRITERIA, and it is a shape finding rather
  -- than a measurement. `ai_step` IS a D1 world-mediated port — WI-B2b widened
  -- it to return `AiStepOutcome` with `next_state` — `PreStepOutcome` carries
  -- `next_state`, and `compact_with_ai` returns `s.next_state` rather than
  -- `ctx.world`. So criterion 2's SUBSTANCE is already satisfied by the only
  -- binding that performs anything. What refuses the slot is that criterion 2
  -- is evaluated against the DECLARED row, and a declared row cannot say
  -- "these ten arrive through a world-mediated port". THE BARRIER IS THE
  -- ROW'S VOCABULARY, not the behaviour and not the row's width.
  on_pre_step: (ExtCtx, [Msg]) -> PreStepOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Trace},
  on_tool_policy: (ExtCtx, ToolCallEnvelope) -> ToolPolicyDecision,
  on_tool_handle: (ExtCtx, ToolCallEnvelope)
    -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand},
  -- WI-D7 NARROWED THIS ROW from nine effects to four, and the narrowing is
  -- to a MEASUREMENT rather than to zero.
  --
  -- WAS, through WI-D6: `! {IO, Process, FS, AI, Env, Net, SharedMem, Clock,
  -- Stream}` — nine, closed, and never measured against any binding.
  --
  -- THE MEASUREMENT: all fifteen bindings narrowed to no row at all, tree-wide,
  -- and checked over all 71 files of the fifteen packages derived from
  -- `registry_generated.ail`. FOURTEEN of fifteen accept the empty row — every
  -- one of them returns a constant `NoIntercept` beside `ctx.world`. ONE
  -- refuses, and the compiler names it:
  --
  --   packages/motoko-ext-compose/compose.ail:816
  --   failed to unify record field 'on_response_intercept': incompatible
  --   closed rows: r1 has extra labels [Clock FS IO Process]
  --
  -- confirmed from the body independently: narrowing `compose`'s own
  -- `on_response_intercept` annotation gives `Effect checking failed for
  -- function 'on_response_intercept'`.
  --
  -- THIS IS THE ROW WI-C5 PREDICTED WOULD REFUSE, AND IT NAMED THE PATH.
  -- `make declared_vs_performed` has carried `must_die_on
  -- compose_intercept_inline FS` since C5 precisely so that a green non-inline
  -- arm could not be read as "on_response_intercept performs no FS". The
  -- compiler agrees and is more specific than the runtime witness was: the
  -- inline path performs `Clock, FS, IO, Process` — `now()` for the snippet
  -- name, `mkdirAll`/`writeFile`/`removeFile` for the scratch module, and
  -- `check_snippet`/`run_snippet` spawning the compiler.
  --
  -- WHY THIS DOES NOT MAKE THE SLOT COVERABLE. A four-effect row is still a
  -- non-empty row, so D5's criterion 1 fails exactly as it did at nine. None
  -- of the four is a world-mediated port, so criterion 2 fails too, even
  -- though `ResponseInterceptOutcome` carries `next_state`. THE SLOT IS STILL
  -- A BARRIER. What the narrowing buys is the compiler: a binding that starts
  -- reading `Env` in this slot now fails to build, where at nine effects it
  -- would have compiled silently.
  on_response_intercept: (ExtCtx, string)
    -> ResponseInterceptOutcome ! {IO, Process, FS, Clock},
  -- WI-D7 NARROWED THIS ROW from nine effects to one, on the same method.
  --
  -- FOURTEEN of fifteen bindings accept the empty row. ONE refuses:
  --
  --   packages/motoko-ext-context-mode/register.ail:56
  --   failed to unify record field 'on_solver_candidate': incompatible closed
  --   rows: r1 has extra labels [Process]
  --
  -- and from the body: narrowing `context_mode.finalize_with_index`'s own
  -- annotation gives `Effect checking failed for function
  -- 'finalize_with_index'`. It spawns a `node` bridge fire-and-forget to index
  -- the final output — a real subprocess, on the default path, not a fixture.
  --
  -- THE HANDOFF FOR THIS ITEM PREDICTED ROUTE A HERE — "bindings return
  -- constants; measure and see". They do not. `context_mode`'s does not, and
  -- it is in `registry_generated.ail` like the rest. Recorded because the
  -- prediction was reasonable from reading twelve of the fifteen bindings, and
  -- that is exactly the failure mode S22 exists for.
  --
  -- STILL A BARRIER, for the same reason as `on_response_intercept` above:
  -- `! {Process}` is non-empty, so criterion 1 fails, and `Process` is not a
  -- world-mediated port, so criterion 2 fails despite `FinalizeOutcome`
  -- carrying `next_state`.
  on_solver_candidate: (ExtCtx, string)
    -> FinalizeOutcome ! {Process}
}

export type ExtRegistry = { hooks: [ExtensionHooks] }

export type ExtRuntime = {
  registry: ExtRegistry,
  strict_mode: bool,
  verification: VerificationConfig
}

export type ToolDecisionEnvelope = {
  call: ToolCallEnvelope,
  decision: ToolPolicyDecision
}
