module sunholo/motoko_ext_compaction_structural/compaction_structural

import std/string (length, substring)
import std/list (foldl)
import std/result (Result, Ok, Err)
import std/json (jo)
import pkg/sunholo/motoko_ext_abi/types (
  ExtCtx,
  Msg,
  PreStepDecision,
  PassThrough,
  Compacted
)
import src/core/ext/ctx_defaults (noop_ext_ports, empty_ext_artifacts, zero_token_telemetry)

export pure func elide_tier_pct() -> int { 70 }

export pure func elide_hard_tier_pct() -> int { 85 }

export pure func emergency_pct() -> int { 95 }

export pure func elide_keep_last() -> int { 10 }

export pure func elide_hard_keep_last() -> int { 5 }

export pure func emergency_keep_last() -> int { 3 }

export pure func emergency_final_keep_last() -> int { 1 }

pure func count_tool_msgs(msgs: [Msg]) -> int {
  foldl(\acc m. acc + (if m.role == "tool" then 1 else 0), 0, msgs)
}

export pure func estimate_tokens_messages(msgs: [Msg]) -> int {
  let total = foldl(\acc m. acc + length(m.content), 0, msgs);
  (total + 3) / 4
}

export pure func usage_percent_with_limit(msgs: [Msg], limit: int) -> int {
  if limit == 0 then 0
  else (estimate_tokens_messages(msgs) * 100) / limit
}

pure func elide_content(content: string) -> string {
  let n = length(content);
  if n <= 80 then content
  else {
    let preview = substring(content, 0, 80);
    let elided = "${preview}...[elided ${show(n - 80)} chars]";
    if length(elided) < n then elided else content
  }
}

pure func elide_walk(msgs: [Msg], total: int, keep_last: int, seen: int) -> [Msg] {
  match msgs {
    [] => [],
    m :: rest => {
      if m.role == "tool" then {
        let keep = total - seen <= keep_last;
        let new_content = if keep then m.content else elide_content(m.content);
        let updated: Msg = {
          role: m.role,
          content: new_content,
          tool_calls: m.tool_calls,
          tool_call_id: m.tool_call_id
        };
        updated :: elide_walk(rest, total, keep_last, seen + 1)
      } else
        m :: elide_walk(rest, total, keep_last, seen)
    }
  }
}

export pure func elide_old_tool_results(msgs: [Msg], keep_last: int) -> [Msg]
  requires { keep_last >= 0 }
  {
    elide_walk(msgs, count_tool_msgs(msgs), keep_last, 0)
  }

pure func try_emergency_compaction_with_limit(msgs: [Msg], model: string, limit: int) -> Result[[Msg], string] {
  let emergency1 = elide_old_tool_results(msgs, emergency_keep_last());
  let pct1 = usage_percent_with_limit(emergency1, limit);
  if pct1 < emergency_pct() then Ok(emergency1)
  else {
    let emergency2 = elide_old_tool_results(msgs, emergency_final_keep_last());
    let pct2 = usage_percent_with_limit(emergency2, limit);
    if pct2 < emergency_pct() then Ok(emergency2)
    else Err("compaction_exhausted: context at ${show(pct2)}% of ${model} limit after emergency compaction")
  }
}

export pure func compact_step_with_limit(msgs: [Msg], model: string, limit: int) -> Result[[Msg], string] {
  let pct = usage_percent_with_limit(msgs, limit);
  if pct >= emergency_pct() then try_emergency_compaction_with_limit(msgs, model, limit)
  else if pct >= elide_hard_tier_pct() then Ok(elide_old_tool_results(msgs, elide_hard_keep_last()))
  else if pct >= elide_tier_pct() then Ok(elide_old_tool_results(msgs, elide_keep_last()))
  else Ok(msgs)
}

pure func same_msgs(a: [Msg], b: [Msg]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs =>
      match b {
        [] => false,
        y :: ys =>
          x.role == y.role
            && x.content == y.content
            && x.tool_call_id == y.tool_call_id
            && same_msgs(xs, ys)
      }
  }
}

pure func structural_note(tier: string, keep_last: int) -> string {
  "structural: tier=${tier} keep_last=${show(keep_last)}"
}

export pure func compact_for_pre_step(ctx: ExtCtx, msgs: [Msg]) -> PreStepDecision {
  let pct = usage_percent_with_limit(msgs, ctx.context_limit);
  if pct >= emergency_pct() then {
    let emergency1 = elide_old_tool_results(msgs, emergency_keep_last());
    if not same_msgs(msgs, emergency1) then Compacted(emergency1, structural_note("emergency", emergency_keep_last()), jo([]))
    else {
      let emergency2 = elide_old_tool_results(msgs, emergency_final_keep_last());
      if not same_msgs(msgs, emergency2) then Compacted(emergency2, structural_note("emergency", emergency_final_keep_last()), jo([]))
      else PassThrough
    }
  }
  else if pct >= elide_hard_tier_pct() then {
    let elided = elide_old_tool_results(msgs, elide_hard_keep_last());
    if same_msgs(msgs, elided) then PassThrough else Compacted(elided, structural_note("hard", elide_hard_keep_last()), jo([]))
  }
  else if pct >= elide_tier_pct() then {
    let elided = elide_old_tool_results(msgs, elide_keep_last());
    if same_msgs(msgs, elided) then PassThrough else Compacted(elided, structural_note("tier1", elide_keep_last()), jo([]))
  }
  else PassThrough
}

func tool(id: string, content: string) -> Msg {
  { role: "tool", content: content, tool_calls: [], tool_call_id: id }
}

func user(content: string) -> Msg {
  { role: "user", content: content, tool_calls: [], tool_call_id: "" }
}

func long_tool_content() -> string {
  "long tool output that genuinely exceeds eighty characters in length and then keeps on going for a while longer until it definitely passes the elide threshold and triggers actual shortening of the message body"
}

func count_elided(msgs: [Msg]) -> int {
  match msgs {
    [] => 0,
    m :: rest => (if m.role == "tool" && length(m.content) < length(long_tool_content()) then 1 else 0) + count_elided(rest)
  }
}

func test_elide_preserves_length() -> bool
  tests [((), true)]
  {
    let msgs = [tool("t1", "some tool output"), tool("t2", "some tool output"), tool("t3", "some tool output"), tool("t4", "some tool output"), tool("t5", "some tool output")];
    _list_length(elide_old_tool_results(msgs, 2)) == 5
  }

func test_count_tool_messages() -> bool
  tests [((), true)]
  {
    count_tool_msgs([user("q"), { role: "assistant", content: "a", tool_calls: [], tool_call_id: "" }, tool("c1", "r1"), tool("c2", "r2")]) == 2
  }

func test_elide_all_tool_results() -> bool
  tests [((), true)]
  {
    let original = long_tool_content();
    let compacted = elide_old_tool_results([user("q"), tool("c1", original)], 0);
    match compacted {
      [] => false,
      u :: t :: [] => u.content == "q" && length(t.content) < length(original),
      _ => false
    }
  }

func test_single_tier_ladder_selects_correctly() -> bool
  tests [((), true)]
  {
    let original = long_tool_content();
    let msgs = [tool("t1", original), tool("t2", original), tool("t3", original), tool("t4", original), tool("t5", original), tool("t6", original), tool("t7", original), tool("t8", original), tool("t9", original), tool("t10", original), tool("t11", original), tool("t12", original)];
    match compact_step_with_limit(msgs, "test", 740) {
      Ok(out) => usage_percent_with_limit(msgs, 740) >= elide_tier_pct() && usage_percent_with_limit(msgs, 740) < elide_hard_tier_pct() && count_elided(out) == 2,
      Err(_) => false
    }
  }

func test_pre_step_passthrough_when_unchanged() -> bool
  tests [((), true)]
  {
    let ctx: ExtCtx = {
      task: "t",
      step: 0,
      model: "m",
      context_limit: 1,
      cwd: ".",
      hybrid_tools: false,
      budget: { total: 1, solver: 1, verifier: 0 },
      mode: "default",
      workdir: ".",
      env_server_url: "",
      budget_remaining: 1,
      history_slice: [],
      state_key: "k",
      context_limit: 1,
      ports: noop_ext_ports(),
      artifacts: empty_ext_artifacts(),
      telemetry: zero_token_telemetry()
    };
    match compact_for_pre_step(ctx, [tool("t1", "short")]) {
      PassThrough => true,
      Compacted(_, _, _) => false
    }
  }
