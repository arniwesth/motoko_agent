module sunholo/motoko_ext_herdr/dagr

-- THE DAGR RUN FILE, WRITTEN BY THE EXTENSION AND NEVER BY THE MODEL.
--
-- `herdr-dagr` renders a run graph from a JSON file that someone else must
-- write. This module is that writer's PURE half: every function here maps a
-- document plus one observation to the next document, with no effects, so the
-- whole contract mapping is testable without a herdr, a filesystem, or a dagr
-- binary. The I/O half — read, modify, publish — lives in `herdr.ail`.
--
-- WHY THE EXTENSION AND NOT THE MODEL (`DESIGN-dagr-as-delegation-view.md` §2).
-- dagr's `evidence` tier is the field that separates "the delegate said done"
-- from "something checked it", and the validator DOES NOT ENFORCE IT —
-- measured: `evidence: "verified"` with the receipt `"trust me bro"` exits 0
-- under `--strict`. A model-authored producer fabricates under ordinary
-- pressure; one hand-authored file in that session carried four invented
-- receipts, three of them stamped verified, and checked clean. An
-- extension-authored producer derives the tier MECHANICALLY from what
-- `DelegateCheck` actually observed, so the unenforced field stops mattering.
--
-- THE ONE RULE THIS FILE EXISTS TO KEEP: nothing here may emit a fact the code
-- did not observe. Four fields are refused by name, each for its own reason
-- (§3.1, §3.4, §4):
--
--   `verified`        no path independently checks a delegate's ANSWER, so
--                     every settle of delegated work lands at `reported` and
--                     the pane is visibly short of `◆`. That is the honest
--                     reading and it is also the progress bar for 023. The one
--                     place the tier is earned is `open_failed_task`, which
--                     grades a spawn this code watched fail rather than a
--                     result it was told about; its receipt is herdr's exit
--                     code.
--   `asserted`        reading a prose claim needs a screen read, which neither
--                     check path does.
--   `model`           (was refused: nothing selected one. Since Delegate gained a
--                     free-string `model` param, the REQUEST is recorded on the
--                     attempt as `model` verbatim — a display chip (`fable·xhigh`),
--                     never a claim about what ran. Empty means the caller said
--                     nothing and the field is omitted.)
--   `last_output_at`  the extension never reads pane output, and dagr renders
--   `queued_input`    this field as staleness ("14m silent"). A value nobody
--                     observed is a misreport, not a placeholder.
--
-- MEASURED AGAINST THE v0.3.1 BINARY, and one of these overturns the design's
-- guess: a task with no `kind` is REJECTED (`E111: task … missing kind`), so
-- the fallback §3.1 named is the one in force — `task`, deliberately neutral,
-- whenever the model did not say. Emitting `kind` from the agent kind was
-- never an option: a review delegated to claude is still a review.
--
-- Contract v3. The v0.3.1 binary reads v1/v2 and writes v3; its README is from
-- `main` and documents flags the binary rejects, so the binary is the
-- authority, not the README.

import std/option (Option, Some, None)
import std/string (length, substring, contains, replace, split, intToStr, join)
import std/json (Json, jo, ja, kv, js, jb, jnum, get, asString, asArray, asObject, encode, decode)
import std/result (Ok, Err)
import std/datetime (formatRFC3339)

-- ---------------------------------------------------------------------------
-- Small JSON surgery
-- ---------------------------------------------------------------------------
--
-- The document is read back from disk every call and rewritten whole, so these
-- are the only mutators needed: set one key, and map over a list.

pure func kvs_without(kvs: [{key: string, value: Json}], key: string) -> [{key: string, value: Json}] {
  match kvs {
    [] => [],
    p :: rest => if p.key == key then kvs_without(rest, key) else p :: kvs_without(rest, key)
  }
}

pure func obj_set(o: Json, key: string, v: Json) -> Json {
  match asObject(o) {
    None => jo([kv(key, v)]),
    Some(kvs) => jo(kvs_without(kvs, key) ++ [kv(key, v)])
  }
}

pure func obj_del(o: Json, key: string) -> Json {
  match asObject(o) { None => o, Some(kvs) => jo(kvs_without(kvs, key)) }
}

pure func arr_of(j: Json) -> [Json] {
  match asArray(j) { Some(xs) => xs, None => [] }
}

pure func field(o: Json, key: string) -> Json {
  match get(o, key) { Some(v) => v, None => jo([]) }
}

pure func sfield(o: Json, key: string) -> string {
  match get(o, key) {
    None => "",
    Some(v) => match asString(v) { Some(s) => s, None => "" }
  }
}

pure func arr_field(o: Json, key: string) -> [Json] {
  match get(o, key) { Some(v) => arr_of(v), None => [] }
}

pure func last_of(xs: [Json]) -> Option[Json] {
  match xs {
    [] => None,
    x :: rest => match rest { [] => Some(x), _ => last_of(rest) }
  }
}

pure func count_of(xs: [Json]) -> int {
  match xs { [] => 0, _ :: rest => 1 + count_of(rest) }
}

-- ---------------------------------------------------------------------------
-- Identity and placement
-- ---------------------------------------------------------------------------
--
-- ONE WRITER PER FILE, and that is not only a recursion question (§5). Two
-- operator Motokos in the same checkout — two panes, one repo, an ordinary way
-- to use herdr — would both resolve a plain `.dagr/run.json` and clobber each
-- other with no recursion involved. Keying the file by the producer's own pane
-- AND its session makes every writer unique by construction; the session half
-- is what stops a Motoko restarted in the same pane from reopening the
-- previous run's document.

pure func slug(s: string) -> string { replace(s, ":", "-") }

export pure func run_id(own_pane: string, session_ms: string) -> string
  tests [(("w1:p1", "1756000000000"), "run-motoko-w1-p1-1756000000000")]
  { "run-motoko-${slug(own_pane)}-${session_ms}" }

export pure func run_file_name(own_pane: string, session_ms: string) -> string
  tests [(("w1:p1", "1756000000000"), "run-w1-p1-1756000000000.json")]
  { "run-${slug(own_pane)}-${session_ms}.json" }

export pure func run_file(dagr_dir: string, own_pane: string, session_ms: string) -> string
  tests [(("/w/.dagr", "w1:p1", "1756000000000"), "/w/.dagr/run-w1-p1-1756000000000.json")]
  { "${dagr_dir}/${run_file_name(own_pane, session_ms)}" }

-- The `.tmp` sibling stays in the SAME directory on purpose: `mv` is atomic
-- only within a filesystem, and a tmp under /tmp with the run file in the tree
-- would silently become a copy-then-unlink that a reader can observe halfway.
export pure func run_tmp(dagr_dir: string, own_pane: string, session_ms: string) -> string
  tests [(("/w/.dagr", "w1:p1", "1756000000000"), "/w/.dagr/run-w1-p1-1756000000000.json.tmp")]
  { "${run_file(dagr_dir, own_pane, session_ms)}.tmp" }

-- THE SETTLE-ON-EXIT CANDIDATE: the run file as it would read if this session
-- ended right now, rewritten beside the live one on every publish and renamed
-- over it by the HOST at clean exit (ABI 7.1 `PublishFile`).
--
-- WHY IT IS WRITTEN EAGERLY AND NOT AT EXIT. The exit render's effect row is
-- `! {FS}` and carries no `Clock`, so a document composed there could not stamp
-- `ended_at` with anything true. Written here it is stamped with the same
-- `now_ms` as the write beside it, which is the LAST MOMENT THIS PRODUCER
-- OBSERVED ANYTHING -- the most truthful time available for "this attempt was
-- never seen again", and the one a reader can reconcile against the events
-- above it. The cost is a second render per publish, doubling the constant on
-- the O(n^2) byte growth `DESIGN-dagr` §6 already flags; it is not a new shape
-- of cost.
--
-- SAME DIRECTORY, same reason as `run_tmp`, and a DIFFERENT NAME from it: this
-- one must survive the publish that writes it, and `run_tmp` is renamed away
-- mid-transaction.
export pure func run_settled_tmp(dagr_dir: string, own_pane: string, session_ms: string) -> string
  tests [(("/w/.dagr", "w1:p1", "1756000000000"), "/w/.dagr/run-w1-p1-1756000000000.json.settled")]
  { "${run_file(dagr_dir, own_pane, session_ms)}.settled" }

-- The tmp a SWEEPER uses to republish somebody else's run file. Keyed by the
-- sweeping session, not by the file's owner: two sessions sweeping the same
-- directory must not share a temporary inode, which is `run_tmp`'s rule applied
-- to the one case where the writer is not the owner.
export pure func sweep_tmp(path: string, own_pane: string, session_ms: string) -> string
  tests [(("/w/.dagr/run-w1-p9-100.json", "w1:p1", "200"), "/w/.dagr/run-w1-p9-100.json.sweep-w1-p1-200")]
  { "${path}.sweep-${slug(own_pane)}-${session_ms}" }

-- ---------------------------------------------------------------------------
-- The operator's plan, read and never written (DESIGN §10.4 option A2)
-- ---------------------------------------------------------------------------
--
-- THE OWNERSHIP IS INVERTED, and that is the whole design. The operator
-- declares INTENT — task ids, titles, kinds, deps — in a file this producer
-- READS and never writes; the producer keeps sole ownership of the state
-- document it already owns, seeds the declared tasks into it, and attaches
-- attempts to them as delegations happen. One document with the plan's deps in
-- it, and still exactly ONE writer.
--
-- WHY NOT WRITE THE OPERATOR'S FILE (§10.4 option A1). `dagr` cannot merge at
-- the pinned release, so every writer replaces the whole document; the model's
-- edit cycle spans turns, so its whole-file rewrite silently drops whatever
-- this producer recorded since it last read. §10.3: it would also disable
-- settle-on-exit, whose precondition is the digest of what the render read.
--
-- SEEDING IS IDEMPOTENT AND ONE-DIRECTIONAL. A plan task already present is
-- left completely alone — once a task exists here, its state is this producer's
-- and the plan cannot reach back in and change it. So an operator editing the
-- plan mid-run adds tasks and never rewrites observations.
pure func plan_task_of(t: Json, now_ms: int) -> Json {
  let id = sfield(t, "id");
  let state = if sfield(t, "state") == "" then "queued" else sfield(t, "state");
  -- THE OPTIONAL FIELDS ARE NOT DECORATION; ONE OF THEM IS LOAD-BEARING FOR
  -- VALIDITY. Measured 2026-09-08, the first time a real operator plan was
  -- seeded: `dagr check --strict` — which `publish` runs, and whose exit 1
  -- refuses the write (`types.ail:1482`) — reports W205 for a `blocked` task
  -- naming no unblock owner. The plan named one; this function dropped it. Two
  -- blocked tasks were therefore enough to refuse EVERY publish for the whole
  -- session, so the producer wrote no run file at all and the operator's dagr
  -- pane sat on "waiting for run file" with nothing said.
  --
  -- The others are carried because a seeded task that loses them is a worse
  -- picture than no task: `owner` is what the queue renders as `unassigned`,
  -- `criteria` is the whole content of a gate, and `note` is where a plan says
  -- why a task exists. Copied ONLY when non-empty, so a plan that omits them
  -- produces the same document it produced before.
  let base0 = jo([
    kv("id", js(id)),
    kv("title", js(if sfield(t, "title") == "" then id else sfield(t, "title"))),
    kv("kind", js(if sfield(t, "kind") == "" then "task" else sfield(t, "kind"))),
    kv("state", js(state)),
    kv("deps", ja(arr_field(t, "deps")))]);
  let base = carry_str(carry_str(carry_str(carry_str(carry_str(
               base0, t, "unblock"), t, "owner"), t, "criteria"), t, "note"), t, "project");
  -- A TERMINAL STATE NEEDS AN ATTEMPT, and this is not a formality: `dagr check`
  -- rejects a `done` task with no attempts as E150, "nothing settled it".
  -- Measured against the v0.3.1 binary before this was written.
  --
  -- So the operator's own work gets an attempt that says who did it and that
  -- NOBODY CHECKED IT. `reported` is the tier for a claim this producer did not
  -- observe, and the actor is the operator rather than a delegate, because
  -- attributing hand-done work to an agent would be the confident-wrong
  -- reporting this project keeps eliminating. This is §10.4's stated cost of
  -- A2 — "taking a task over by hand needs a way to say so" — and this is that
  -- way.
  if attempt_is_terminal(state) == false then obj_set(base, "attempts", ja([]))
  else obj_set(base, "attempts", ja([jo([
    kv("id", js("${id}·a1")),
    kv("n", jnum(1.0)),
    kv("cause", jo([kv("type", js("initial"))])),
    kv("actor", js("operator")),
    kv("state", js(state)),
    kv("started_at", js(at(now_ms))),
    kv("ended_at", js(at(now_ms))),
    kv("outcome", jo([
      kv("result", js(state)),
      kv("evidence", js("reported")),
      kv("reason", js("declared `${state}` in the operator's plan; this producer did not observe it"))]))])]))
}

-- Copy an optional string field only when the plan actually sets it, so a plan
-- without it seeds exactly what it seeded before this existed.
pure func carry_str(o: Json, src: Json, key: string) -> Json {
  let v = sfield(src, key);
  if v == "" then o else obj_set(o, key, js(v))
}

pure func seed_tasks(doc: Json, plan: [Json], now_ms: int) -> Json {
  match plan {
    [] => doc,
    t :: rest => {
      let id = sfield(t, "id");
      let next =
        if id == "" || has_task(doc, id) then doc
        else with_tasks(doc, tasks_of(doc) ++ [plan_task_of(t, now_ms)]);
      seed_tasks(next, rest, now_ms)
    }
  }
}

-- An unreadable or absent plan seeds NOTHING and is not an error: the producer
-- ran without a plan for its whole life before this existed, and a plan it
-- cannot parse is the operator's to fix, not this producer's to guess at.
export pure func seed_from_plan(doc: Json, present: bool, content: string, now_ms: int) -> Json {
  if present == false || content == "" then doc
  else match decode(content) {
    Err(_) => doc,
    -- PROJECTS BEFORE TASKS, and they travel TOGETHER or not at all. A task
    -- carrying `project` into a document with no matching entry in `projects`
    -- is E107 ("task names unknown project") and refuses the publish, so
    -- seeding one without the other would trade this function's old defect for
    -- a louder one. Seeding neither was the state before 2026-09-08 and cost
    -- the operator the grouping their plan was written around: 23 tasks under
    -- five projects rendered as 23 rows under none.
    Ok(p) => seed_tasks(seed_projects(doc, arr_field(p, "projects")), tasks_of(p), now_ms)
  }
}

-- Idempotent like `seed_tasks`, and for the same reason: a project already in
-- this document is the producer's, and the plan describes intent rather than
-- what was observed.
pure func seed_projects(doc: Json, plan: [Json]) -> Json {
  match plan {
    [] => doc,
    pr :: rest => {
      let id = sfield(pr, "id");
      let next =
        if id == "" || has_project(doc, id) then doc
        else obj_set(doc, "projects", ja(projects_of(doc) ++ [
          carry_str(carry_str(jo([
            kv("id", js(id)),
            kv("title", js(if sfield(pr, "title") == "" then id else sfield(pr, "title")))]),
            pr, "parent"), pr, "owner")]));
      seed_projects(next, rest)
    }
  }
}

pure func projects_of(doc: Json) -> [Json] { arr_field(doc, "projects") }

pure func has_project(doc: Json, id: string) -> bool {
  any_id(projects_of(doc), id)
}

pure func any_id(xs: [Json], id: string) -> bool {
  match xs {
    [] => false,
    x :: rest => if sfield(x, "id") == id then true else any_id(rest, id)
  }
}

export pure func seed_from_plan_str(content: string, now_ms: int) -> string
  tests [
    -- structure only: declared tasks arrive queued, with their deps, and no attempts
    (("{\"tasks\":[{\"id\":\"P1A\",\"title\":\"first\",\"kind\":\"impl\",\"deps\":[]},{\"id\":\"P1B\",\"deps\":[\"P1A\"]}]}", 1000),
     "P1A:queued:0,P1B:queued:0"),
    -- the operator's own work arrives settled, with ONE attempt to settle it
    (("{\"tasks\":[{\"id\":\"INV\",\"state\":\"done\"}]}", 1000), "INV:done:1"),
    -- a plan that does not parse, or is empty, seeds nothing
    (("not json", 1000), ""),
    (("{\"tasks\":[]}", 1000), ""),
    -- a task with no id is not a task
    (("{\"tasks\":[{\"title\":\"nameless\"}]}", 1000), "")
  ]
  {
    let seeded = seed_from_plan(empty_doc("w1:p1", "200", now_ms), true, content, now_ms);
    join(",", seeded_summary(tasks_of(seeded)))
  }

pure func seeded_summary(ts: [Json]) -> [string] {
  match ts {
    [] => [],
    t :: rest =>
      "${sfield(t, "id")}:${sfield(t, "state")}:${intToStr(count_of(arr_field(t, "attempts")))}"
        :: seeded_summary(rest)
  }
}

-- Written once per session, next to the run file, when the run file exists and
-- does not parse. Its presence is what makes "tell the model once" once.
export pure func refused_marker(dagr_dir: string, own_pane: string, session_ms: string) -> string
  tests [(("/w/.dagr", "w1:p1", "1756000000000"), "/w/.dagr/.unparseable-w1-p1-1756000000000")]
  { "${dagr_dir}/.unparseable-${slug(own_pane)}-${session_ms}" }

-- THE VIEW-PANE SENTINEL, and it is the reason auto-opening cannot run away.
--
-- The extension has no state between tool calls (`herdr.dagr_record` says so),
-- so "did this session already open a view?" has to be a fact on disk. It is
-- keyed like every other per-run path here — by producer pane AND session — so
-- a Motoko restarted in the same pane opens its own view for its own run file
-- rather than inheriting the previous run's marker.
--
-- IT HOLDS THE PANE ID, not just a bit. That costs nothing over an empty
-- sentinel and it is what lets a later reader — the operator, or anything that
-- wants to replace the view rather than add a second one — name the pane it is
-- allowed to touch. `scripts/dagr-pane.sh` keeps `.dagr/.pane` for the same
-- purpose and for the same reason: a pane is only ours to close if we can prove
-- we opened it.
--
-- MEASURED WHY: 2026-09-01 a session opened ~90 view panes by opening one per
-- poll. The marker goes down BEFORE the open is attempted, which is
-- `sweep_once`'s rule too — a failed attempt that retries on every subsequent
-- Delegate call is the same runaway with a slower fuse.
export pure func pane_marker(dagr_dir: string, own_pane: string, session_ms: string) -> string
  tests [(("/w/.dagr", "w1:p1", "1756000000000"), "/w/.dagr/.pane-w1-p1-1756000000000")]
  { "${dagr_dir}/.pane-${slug(own_pane)}-${session_ms}" }

-- THE DECLARED-PLAN SENTINEL (A2's second channel), and it exists because the
-- first channel asked the wrong person.
--
-- `HERDR_DAGR_PLAN` made the plan a property of the CONTAINER. Measured
-- 2026-09-08: an operator said "start implementing `.dagr/run-plan003.json`",
-- the model understood it well enough to pass `dagr_task: "P1P1"` unprompted,
-- and the linkage was refused because nothing had exported that variable — in
-- a container whose `.devcontainer` is mounted read-only, so the one channel
-- that existed could not be used from inside at all. Which plan is being
-- implemented changes every day; which container this is does not.
--
-- So the model may declare it, and this file is where that declaration lives
-- between tool calls. Keyed by producer pane AND session like every other path
-- here (`pane_marker` says why), so a Motoko restarted in the same pane starts
-- with no plan rather than inheriting the last one's.
--
-- IT HOLDS THE PATH, not a bit: `dagr_record` reads it on every write point,
-- including the check-side ones, so a plan declared at the first `Delegate` is
-- still in effect at the `DelegateCheck` that settles it.
export pure func plan_marker(dagr_dir: string, own_pane: string, session_ms: string) -> string
  tests [(("/w/.dagr", "w1:p1", "1756000000000"), "/w/.dagr/.plan-w1-p1-1756000000000")]
  { "${dagr_dir}/.plan-${slug(own_pane)}-${session_ms}" }

-- THE OPERATOR'S SENTINEL, and it is not this producer's to write.
-- `scripts/dagr-pane.sh` writes the pane id of a HAND-OPENED dagr view here,
-- for the same reason `pane_marker` exists: a pane is only ours to touch if we
-- can prove we opened it. The extension reads it and yields — a second view of
-- a different run file, on screen next to one the operator opened deliberately,
-- is the "yet another dagr view" they objected to in the PLAN-001 live run.
-- (`.agent/issues/herdr-extension-run-file-drifts-from-operator-plan-file.md`,
-- option B.)
--
-- NOT KEYED BY PANE OR SESSION, unlike everything else here, because it is not
-- this session's file: the script keeps exactly one and re-points it at each
-- replacement. That asymmetry is the whole reason it is named separately rather
-- than derived from `pane_marker`.
export pure func operator_pane_marker(dagr_dir: string) -> string
  tests [("/w/.dagr", "/w/.dagr/.pane")]
  { "${dagr_dir}/.pane" }

export pure func attempt_id(task_id: string, n: int) -> string
  tests [(("mot-dlg-7", 1), "mot-dlg-7·a1"), (("mot-dlg-7", 2), "mot-dlg-7·a2")]
  { "${task_id}·a${intToStr(n)}" }

-- ISO-8601 with a Z, which is what the contract wants and what
-- `std/datetime.formatRFC3339` produces from epoch milliseconds.
export pure func at(now_ms: int) -> string
  tests [(1756000000000, "2025-08-24T01:46:40Z")]
  { formatRFC3339(now_ms) }

-- A task needs a title, and the only text the extension has is the prompt the
-- model wrote. First line, bounded: dagr renders this in a pane column.
export pure func task_title(prompt: string) -> string
  tests [
    ("Fix the parser\n\nDetails follow", "delegate: Fix the parser"),
    ("", "delegate: (no prompt)")
  ]
  {
    let first = match split(prompt, "\n") { [] => "", l :: _ => l };
    let cut = if length(first) > 72 then "${substring(first, 0, 72)}…" else first;
    if cut == "" then "delegate: (no prompt)" else "delegate: ${cut}"
  }

-- ENUMERATED, NOT FREE TEXT (§3.1). Every session would otherwise invent its
-- own vocabulary. An unknown value is not an error worth failing a delegation
-- over — it degrades to the neutral kind, which is also what an omitted one
-- does. `task` rather than nothing because the v0.3.1 validator rejects a
-- kind-less task with E111 (measured 2026-08-31).
export pure func task_kind_or_default(k: string) -> string
  tests [
    ("impl", "impl"), ("review", "review"), ("research", "research"),
    ("test", "test"), ("docs", "docs"),
    ("", "task"), ("whatever", "task")
  ]
  {
    if k == "impl" || k == "review" || k == "research" || k == "test" || k == "docs"
    then k else "task"
  }

export pure func known_task_kinds() -> string
  tests [((), "impl, review, research, test, docs")]
  { "impl, review, research, test, docs" }

-- ---------------------------------------------------------------------------
-- Reading the document
-- ---------------------------------------------------------------------------

export pure func empty_doc(own_pane: string, session_ms: string, now_ms: int) -> Json {
  jo([
    kv("dagr", jnum(3.0)),
    kv("run", jo([
      kv("id", js(run_id(own_pane, session_ms))),
      kv("title", js("motoko delegation (pane ${own_pane})")),
      kv("started_at", js(at(now_ms)))
    ])),
    kv("generated_at", js(at(now_ms))),
    kv("tasks", ja([])),
    kv("events", ja([]))
  ])
}

-- A file that exists but does not parse is NEVER overwritten. Silently
-- replacing a document is the failure the whole design warns about: the reader
-- sees a confident graph with no idea it lost the previous one. `None` means
-- "stop writing for this session and say so".
export pure func load_doc(present: bool, content: string, own_pane: string, session_ms: string, now_ms: int) -> Option[Json] {
  if present == false || content == "" then Some(empty_doc(own_pane, session_ms, now_ms))
  else match decode(content) {
    Err(_) => None,
    Ok(d) => Some(d)
  }
}

pure func tasks_of(doc: Json) -> [Json] { arr_field(doc, "tasks") }

pure func find_task(ts: [Json], id: string) -> Option[Json] {
  match ts {
    [] => None,
    t :: rest => if sfield(t, "id") == id then Some(t) else find_task(rest, id)
  }
}

export pure func is_empty_run(doc: Json) -> bool
  { count_of(tasks_of(doc)) == 0 }

export pure func has_task(doc: Json, id: string) -> bool
  { match find_task(tasks_of(doc), id) { Some(_) => true, None => false } }

-- THE HANDLE THE MODEL HOLDS IS NOT ALWAYS THE TASK ID, and that is a
-- consequence of `retry_of` rather than a wrinkle worth avoiding. A linked
-- retry appends attempt n to the EXISTING task, so the new handle names a task
-- whose id came from the first delegation. The task carries the current handle
-- as its `owner` — a free string in the contract, and the honest reading of
-- "who is working on this now" — so one lookup serves both cases: the ordinary
-- one where id == handle, and the retry where only `owner` matches.
pure func find_owner(ts: [Json], key: string) -> Option[Json] {
  match ts {
    [] => None,
    t :: rest => if sfield(t, "owner") == key then Some(t) else find_owner(rest, key)
  }
}

export pure func task_of_key(doc: Json, key: string) -> string {
  match find_task(tasks_of(doc), key) {
    Some(t) => sfield(t, "id"),
    None => match find_owner(tasks_of(doc), key) {
      Some(t) => sfield(t, "id"),
      None => ""
    }
  }
}

-- Terminal ATTEMPT states, which is the transition guard §3.5 asks for: a
-- second `DelegateCheck` on a finished delegate must append nothing, and the
-- motoko path's early read succeeds on every call once the answer exists.
export pure func attempt_is_terminal(state: string) -> bool
  tests [
    ("done", true), ("failed", true), ("rejected", true),
    ("settled_unverified", true), ("lost", true),
    ("working", false), ("queued", false), ("", false)
  ]
  {
    state == "done" || state == "failed" || state == "rejected"
      || state == "settled_unverified" || state == "lost"
  }

pure func latest_attempt(doc: Json, id: string) -> Option[Json] {
  match find_task(tasks_of(doc), id) {
    None => None,
    Some(t) => last_of(arr_field(t, "attempts"))
  }
}

export pure func latest_attempt_state(doc: Json, id: string) -> string
  { match latest_attempt(doc, id) { None => "", Some(a) => sfield(a, "state") } }

export pure func latest_attempt_id(doc: Json, id: string) -> string
  { match latest_attempt(doc, id) { None => "", Some(a) => sfield(a, "id") } }

export pure func is_settled_already(doc: Json, id: string) -> bool
  { attempt_is_terminal(latest_attempt_state(doc, id)) }

-- `retry_of` is refused, never the delegation (§3.6). Three conditions, all
-- local: the task exists in THIS run file, and its latest attempt is terminal —
-- linking onto work still in flight would claim a retry of something nobody
-- has given up on. (That the handle was issued by this extension is checked by
-- the caller with `owns_name`, which is where that rule already lives.)
export pure func can_link_retry(doc: Json, id: string) -> bool
  { has_task(doc, id) && is_settled_already(doc, id) }

-- ---------------------------------------------------------------------------
-- Writing the document
-- ---------------------------------------------------------------------------

pure func with_tasks(doc: Json, ts: [Json]) -> Json { obj_set(doc, "tasks", ja(ts)) }

pure func append_event(doc: Json, ev: Json) -> Json
  { obj_set(doc, "events", ja(arr_field(doc, "events") ++ [ev])) }

export pure func touch(doc: Json, now_ms: int) -> Json
  { obj_set(doc, "generated_at", js(at(now_ms))) }

pure func map_task(ts: [Json], id: string, f: (Json) -> Json) -> [Json] {
  match ts {
    [] => [],
    t :: rest => if sfield(t, "id") == id then f(t) :: rest else t :: map_task(rest, id, f)
  }
}

pure func map_last_attempt(t: Json, f: (Json) -> Json) -> Json {
  let ats = arr_field(t, "attempts");
  obj_set(t, "attempts", ja(map_last(ats, f)))
}

pure func map_last(xs: [Json], f: (Json) -> Json) -> [Json] {
  match xs {
    [] => [],
    x :: rest => match rest { [] => [f(x)], _ => x :: map_last(rest, f) }
  }
}

pure func started_event(task: string, attempt: string, actor: string, now_ms: int) -> Json {
  jo([kv("at", js(at(now_ms))), kv("type", js("attempt_started")),
      kv("task", js(task)), kv("attempt", js(attempt)), kv("actor", js(actor))])
}

pure func settled_event(task: string, attempt: string, actor: string, detail: string, now_ms: int) -> Json {
  jo([kv("at", js(at(now_ms))), kv("type", js("attempt_settled")),
      kv("task", js(task)), kv("attempt", js(attempt)), kv("actor", js(actor)),
      kv("detail", js(detail))])
}

-- LIVENESS IS ONE FIELD, LATCHED. `prompt_acknowledged` starts false and turns
-- true on the first observed `working`, `blocked` or `done`; it never goes
-- back, because `idle` is ALSO the resting state after a completed turn and
-- recomputing from `status != idle` would flip a live attempt back to
-- unacknowledged on the next poll. The other two contract fields are omitted —
-- see this file's header.
pure func liveness(ack: bool) -> Json { jo([kv("prompt_acknowledged", jb(ack))]) }

pure func locator(pane: string, agent: string) -> Json
  { jo([kv("pane", js(pane)), kv("agent", js(agent))]) }

-- `model` is the REQUESTED model chip, recorded verbatim (dagr renders it as a
-- display chip, never a claim about what ran). Empty omits the field — the
-- caller said nothing and the CLI default stands.
pure func new_attempt(task_id: string, n: int, cause: Json, actor: string,
                      pane: string, agent: string, now_ms: int) -> Json {
  new_attempt_model(task_id, n, cause, actor, pane, agent, now_ms, "")
}

pure func new_attempt_model(task_id: string, n: int, cause: Json, actor: string,
                            pane: string, agent: string, now_ms: int, model: string) -> Json {
  let base = jo([
    kv("id", js(attempt_id(task_id, n))), kv("n", jnum(_int_to_float(n))),
    kv("cause", cause), kv("actor", js(actor)),
    kv("locator", locator(pane, agent)),
    kv("state", js("working")), kv("started_at", js(at(now_ms))),
    kv("liveness", liveness(false))
  ]);
  if model == "" then base else obj_set(base, "model", js(model))
}

-- THE FIRST WRITE POINT, and it is deliberately not "after `pane split`"
-- (§3.2). Four failure branches sit between the split and a working delegate,
-- each of which closes the pane; a task appended at the split would survive as
-- a phantom `working` row for a delegation that never happened.
export pure func open_task(doc: Json, id: string, title: string, kind: string,
                           actor: string, pane: string, loc_agent: string, now_ms: int) -> Json {
  open_task_model(doc, id, title, kind, actor, pane, loc_agent, now_ms, "")
}

-- The requested-model variant. Records the ask verbatim on the attempt; empty
-- omits the field (CLI default). A retry carries its own ask on its own attempt.
export pure func open_task_model(doc: Json, id: string, title: string, kind: string,
                                 actor: string, pane: string, loc_agent: string,
                                 now_ms: int, model: string) -> Json {
  let a = new_attempt_model(id, 1, jo([kv("type", js("initial"))]), actor, pane, loc_agent, now_ms, model);
  -- `owner` is the handle the model holds, which at open time IS the id; a
  -- linked retry is the only thing that moves it, to the NEW handle, so a
  -- reader comparing the task's `id` (the first delegation) with its `owner`
  -- (who is working on it now) can tell a retried task from new work.
  -- `locator.agent` is a different fact — what herdr calls the agent — and for a motoko delegate
  -- the row self-reports as `motoko` (MOT-120), not as the handle.
  let t = jo([
    kv("id", js(id)), kv("title", js(title)), kv("kind", js(kind)),
    kv("owner", js(id)), kv("state", js("working")), kv("deps", ja([])),
    kv("attempts", ja([a]))
  ]);
  append_event(with_tasks(doc, tasks_of(doc) ++ [t]),
               started_event(id, attempt_id(id, 1), actor, now_ms))
}

-- A DELEGATION THAT CONSUMED RESOURCES AND FAILED IS STILL A FACT (F3).
--
-- `open_task` above explains why nothing is written at `pane split`: a task
-- appended there would survive as a phantom `working` row for a delegation that
-- never happened. Measured live 2026-09-01, the OTHER half of that choice cost
-- more than the phantom would have. Two `claude` spawns each took a pane, an
-- `agent start` and a task file, failed at `agent prompt` with `agent_not_ready`
-- — and left the run file with NO ROW AT ALL. A reader of that document sees a
-- session that delegated three times. It delegated five.
--
-- So the answer is not to open earlier. It is to open and settle in ONE
-- transition: the task is BORN `failed` with an already-terminal attempt, so it
-- is never observable as `working` and the phantom the comment above refuses
-- cannot appear, while the work that was actually spent stays on the record.
--
-- `verified` IS THE HONEST TIER HERE AND NOWHERE ELSE IN THIS FILE, and the
-- header's refusal of it is unchanged in substance. Every other settle grades a
-- claim about A DELEGATE'S ANSWER, which nothing independently checks, so every
-- one of those lands at `reported`. This one grades a claim about THE SPAWN,
-- and its evidence is herdr's own exit status read by this code — a mechanical
-- receipt in the contract's own terms, with the exit code as the receipt.
--
-- The tier travels as a PARAMETER rather than a constant because one call-site
-- never invoked herdr at all: the motoko quoting refusal spends a pane but its
-- only "receipt" is this extension's own prose, so it lands at `reported`.
-- `verified` here means "herdr-observed or extension-observed spawn spend",
-- never "the delegate's answer was checked" — that reading stays refused.
--
-- TWO CLOCK READINGS, not one. `started_at` is when the delegation began and
-- `ended_at` is when it failed; collapsing them onto the failure moment would
-- state that a spawn which spent 3.9s on `agent start` took no time at all.
export pure func open_failed_task(doc: Json, id: string, title: string, kind: string,
                                  actor: string, pane: string, loc_agent: string,
                                  receipt: string, reason: string,
                                  started_ms: int, now_ms: int, tier: string) -> Json {
  let a0 = new_attempt(id, 1, jo([kv("type", js("initial"))]), actor, pane, loc_agent, started_ms);
  let outcome = jo([kv("result", js("failed")), kv("evidence", js(tier)),
                    kv("receipt", js(receipt)), kv("reason", js(reason))]);
  let a = obj_set(obj_set(obj_set(a0, "state", js("failed")),
                          "ended_at", js(at(now_ms))),
                  "outcome", outcome);
  let t = jo([
    kv("id", js(id)), kv("title", js(title)), kv("kind", js(kind)),
    kv("owner", js(id)), kv("state", js("failed")), kv("deps", ja([])),
    kv("attempts", ja([a]))
  ]);
  touch(append_event(append_event(with_tasks(doc, tasks_of(doc) ++ [t]),
                                  started_event(id, attempt_id(id, 1), actor, started_ms)),
                     settled_event(id, attempt_id(id, 1), actor, reason, now_ms)),
        now_ms)
}

-- A RETRY IS AN ATTEMPT, NOT A NEW TASK (§3.6). This is the whole of what
-- `retry_of` buys: dagr's rework rendering needs attempt n to carry a cause
-- pointing back at attempt n−1, and without it every re-delegation looks like
-- new work and the rework count — arguably the one thing the pane shows that
-- the transcript does not — is always zero. `owner` moves to the new handle
-- for the same reason: `task_of_key` resolves EITHER handle to this task, and
-- the task's `id` keeps the first handle so the retry chain stays visible.
export pure func open_retry(doc: Json, id: string, new_key: string, actor: string,
                            pane: string, agent: string, reason: string, now_ms: int) -> Json {
  open_retry_model(doc, id, new_key, actor, pane, agent, reason, now_ms, "")
}

-- Attach a delegation's attempt to a task the OPERATOR DECLARED (A2's other
-- half). Structurally `open_retry_model` with one difference that matters: a
-- declared task has NO attempts yet, and `open_retry_model` would give its
-- first attempt `cause: {type: "followup", ref: ""}` — a followup referring to
-- nothing. The first attempt on a declared task is an INITIAL one; a second is
-- a followup like any other, so this delegates to `open_retry_model` once there
-- is something to follow.
export pure func attach_to_task(doc: Json, id: string, new_key: string, actor: string,
                                pane: string, agent: string, now_ms: int, model: string) -> Json {
  match find_task(tasks_of(doc), id) {
    None => doc,
    Some(t) =>
      if count_of(arr_field(t, "attempts")) > 0 then
        open_retry_model(doc, id, new_key, actor, pane, agent,
                         "delegated again against the operator's plan", now_ms, model)
      else {
        let cause = jo([kv("type", js("initial"))]);
        let a = new_attempt_model(id, 1, cause, actor, pane, agent, now_ms, model);
        let t2 = obj_set(obj_set(obj_set(t, "attempts", ja([a])),
                                 "state", js("working")),
                         "owner", js(new_key));
        append_event(with_tasks(doc, map_task(tasks_of(doc), id, func(_x: Json) -> Json { t2 })),
                     started_event(id, attempt_id(id, 1), actor, now_ms))
      }
  }
}

export pure func open_retry_model(doc: Json, id: string, new_key: string, actor: string,
                                  pane: string, agent: string, reason: string,
                                  now_ms: int, model: string) -> Json {
  match find_task(tasks_of(doc), id) {
    None => doc,
    Some(t) => {
      let n = count_of(arr_field(t, "attempts")) + 1;
      let prev = latest_attempt_id(doc, id);
      let cause = jo([kv("type", js("followup")), kv("ref", js(prev)), kv("reason", js(reason))]);
      let a = new_attempt_model(id, n, cause, actor, pane, agent, now_ms, model);
      let t2 = obj_set(obj_set(obj_set(t, "attempts", ja(arr_field(t, "attempts") ++ [a])),
                               "state", js("working")),
                       "owner", js(new_key));
      append_event(with_tasks(doc, map_task(tasks_of(doc), id, func(_x: Json) -> Json { t2 })),
                   started_event(id, attempt_id(id, n), actor, now_ms))
    }
  }
}

-- Latched, and only from a RECOGNISED, NON-EMPTY status: `agent_status_of`
-- returns "" for missing or undecodable output, and a decode failure must not
-- become `working` in the graph.
export pure func latch_ack(doc: Json, id: string) -> Json {
  with_tasks(doc, map_task(tasks_of(doc), id, func(t: Json) -> Json {
    map_last_attempt(t, func(a: Json) -> Json {
      if attempt_is_terminal(sfield(a, "state")) then a
      else obj_set(a, "liveness", liveness(true))
    })
  }))
}

-- `blocked` is a TASK state over a still-`working` attempt: the delegate has
-- not failed and has not finished, it is sitting on a prompt someone has to
-- answer. W205 requires the unblocker be named — a blocked node is never just
-- a red mark — and here the unblocker is always a human at that pane.
export pure func mark_blocked(doc: Json, id: string, pane: string, now_ms: int) -> Json {
  touch(with_tasks(doc, map_task(tasks_of(doc), id, func(t: Json) -> Json {
    let t2 = obj_set(obj_set(t, "state", js("blocked")),
                     "unblock", js("operator: answer the prompt on pane ${pane}"));
    map_last_attempt(t2, func(a: Json) -> Json {
      if attempt_is_terminal(sfield(a, "state")) then a
      else obj_set(a, "liveness", liveness(true))
    })
  })), now_ms)
}

-- A blocked task that comes back to life must not stay blocked. Same shape as
-- the latch: only the non-terminal case moves.
export pure func mark_working(doc: Json, id: string, now_ms: int) -> Json {
  touch(with_tasks(doc, map_task(tasks_of(doc), id, func(t: Json) -> Json {
    -- The unblock line goes with the block. Leaving it behind would state, of a
    -- task that is running again, that someone still has to answer a prompt —
    -- exactly the kind of stale fact this producer exists not to publish.
    if sfield(t, "state") == "blocked"
    then obj_del(obj_set(t, "state", js("working")), "unblock")
    else t
  })), now_ms)
}

-- THE ONLY TERMINAL WRITE, and it is a TRANSITION, not an assignment (§3.5).
-- `do_check_motoko`'s early read succeeds on every call once the answer file
-- exists — nothing consumes it — so a second check on a finished delegate must
-- append no second `attempt_settled`. An already-terminal attempt returns the
-- document untouched.
--
-- `task_state` is separate from `attempt_state` because they differ in exactly
-- one row that matters: an attempt `lost` projects to a task `failed`.
export pure func settle(doc: Json, id: string, attempt_state: string, task_state: string,
                        evidence: string, receipt: string, reason: string,
                        now_ms: int) -> Json {
  if has_task(doc, id) == false || is_settled_already(doc, id) then doc
  else {
    let aid = latest_attempt_id(doc, id);
    -- The actor is read back off the attempt rather than passed in: the check
    -- paths do not know which kind was delegated (the handle does not carry
    -- it), and the document already recorded it at open time.
    let actor = match latest_attempt(doc, id) { Some(a) => sfield(a, "actor"), None => "" };
    let outcome0 = jo([kv("result", js(attempt_state)), kv("evidence", js(evidence))]);
    let outcome1 = if receipt == "" then outcome0 else obj_set(outcome0, "receipt", js(receipt));
    let outcome  = if reason == "" then outcome1 else obj_set(outcome1, "reason", js(reason));
    let ts2 = map_task(tasks_of(doc), id, func(t: Json) -> Json {
      -- Settling also clears any unblock line, for `mark_working`'s reason.
      let t2 = obj_del(obj_set(t, "state", js(task_state)), "unblock");
      map_last_attempt(t2, func(a: Json) -> Json {
        let a1 = if attempt_state == "done" then obj_set(a, "liveness", liveness(true)) else a;
        obj_set(obj_set(obj_set(a1, "state", js(attempt_state)),
                        "ended_at", js(at(now_ms))),
                "outcome", outcome)
      })
    });
    touch(append_event(with_tasks(doc, ts2),
                       settled_event(id, aid, actor, if reason == "" then receipt else reason, now_ms)),
          now_ms)
  }
}

-- Provenance for things that are true but are not state changes: a close that
-- failed, a refused `retry_of` link, the fact that a task settles only when the
-- model asks (§6's no-poll case, which is a Motoko-side misreport and not an
-- F-5 orphan).
export pure func add_note(doc: Json, id: string, detail: string, now_ms: int) -> Json {
  touch(append_event(doc,
    jo([kv("at", js(at(now_ms))), kv("type", js("note")),
        kv("task", js(id)), kv("detail", js(detail))])), now_ms)
}

export pure func render(doc: Json) -> string { encode(doc) }

-- ---------------------------------------------------------------------------
-- What a PREVIOUS session left behind (F1)
-- ---------------------------------------------------------------------------
--
-- `dagr_open` already writes, in the run file's own words, that a task settles
-- only when the model calls `DelegateCheck`. What it cannot say is what happens
-- after that: the session ends, the document freezes with its last attempt
-- `working`, and nothing ever revisits it. Measured live 2026-09-01 — `.dagr/`
-- still held `run-w1-p6-1788279509710.json` from a run three hours earlier,
-- carrying task `mot-dlg-1788282630477` `working` on pane `w1:p8`, a pane that
-- no longer existed. The startup sweep reported nothing, and was right to: it
-- enumerates PANES, and that pane was gone. Nobody was looking at the records.
--
-- SO THIS READS AND NEVER WRITES. One writer per file is what keeps two
-- Motokos in one checkout from clobbering each other (§5) and it gets no
-- exception for a file whose writer merely LOOKS dead — "looks dead" is the
-- judgement P2-6 measured going wrong, one class over. What comes out is a
-- sentence; the correction stays with whoever owns that file.

pure func starts_with(s: string, pre: string) -> bool
  { length(s) >= length(pre) && substring(s, 0, length(pre)) == pre }

pure func ends_with(s: string, suf: string) -> bool
  { length(s) >= length(suf) && substring(s, length(s) - length(suf), length(s)) == suf }

-- A `.dagr/` entry this producer wrote in SOME session. `own_file` is this
-- session's own basename and is never included — that is the one file we are
-- the writer of, and its in-flight tasks are genuinely in flight. `run.json`
-- fails the `run-` test on purpose: it is the hand-authored install probe and
-- nothing about it is this producer's to read as a record.
export pure func is_foreign_run_file(name: string, own_file: string) -> bool
  tests [
    (("run-w1-p6-100.json", "run-w1-p1-200.json"), true),
    (("run-w1-p1-200.json", "run-w1-p1-200.json"), false),
    (("run.json", "run-w1-p1-200.json"), false),
    (("probe-alpha.txt", "run-w1-p1-200.json"), false),
    ((".unparseable-w1-p1-200", "run-w1-p1-200.json"), false)
  ]
  { starts_with(name, "run-") && ends_with(name, ".json") && name != own_file }

-- ---------------------------------------------------------------------------
-- Pruning the scratch a dead session left in `.dagr/`
-- ---------------------------------------------------------------------------
--
-- `scan_files`' header says this directory "wants pruning, not a silent limit"
-- if it grows past reading. It has: one run file, one view-pane marker and (as
-- of settle-on-exit) one settled candidate per session, none of them ever
-- removed. This is the pruning, and it is deliberately narrow.
--
-- SCRATCH ONLY, NEVER A RECORD. `run-<pane>-<ms>.json` is a document with a
-- reader — the graph, the report, and an operator's history — and nothing here
-- deletes one. What it removes is the two files that mean nothing once their
-- session is gone:
--
--   `.pane-<pane>-<ms>`               the at-most-once marker for the view pane
--   `run-<pane>-<ms>.json.settled`    a settle-on-exit candidate never renamed,
--                                     which means the session did not exit
--                                     cleanly and the candidate is now a
--                                     description of a moment nobody will
--                                     publish
--
-- THE OWNING PANE IS THE EVIDENCE, and it is in the name. A pane absent from
-- `pane list` cannot be running a Motoko, so its scratch is dead — the same
-- positive-proof standard `sweep_class` and `abandoned_tasks` use, and NOT
-- "the name looks stale". A pane that is still there may host a different
-- session now, so nothing is removed on that branch: the cost of keeping a
-- dead file is a directory entry, and the cost of removing a live one is a
-- session losing its own at-most-once marker mid-run.
pure func scratch_owner_pane(name: string) -> string {
  if starts_with(name, ".pane-") then pane_of_tail(drop_prefix(name, ".pane-"))
  else if starts_with(name, "run-") && ends_with(name, ".json.settled")
  then pane_of_tail(drop_prefix(name, "run-"))
  else ""
}

-- `w1-p6-100` -> `w1:p6`. The session ms is the last dash-segment and the pane
-- is everything before it, with the slug undone.
pure func pane_of_tail(tail: string) -> string {
  let parts = split(tail, "-");
  match parts {
    a :: b :: _ :: [] => "${a}:${b}",
    _ => ""
  }
}

pure func drop_prefix(s: string, pre: string) -> string {
  substring(s, length(pre), length(s))
}

export pure func is_prunable_scratch(name: string, own_pane: string, session_ms: string, live: [string]) -> bool {
  let owner = scratch_owner_pane(name);
  -- Never this session's own scratch, whatever the pane list says: our marker
  -- and our candidate are both in use right now.
  owner != "" && contains(name, session_ms) == false
    && owner != own_pane && has_str(live, owner) == false
}

export pure func prunable_scratch(names: [string], own_pane: string, session_ms: string, live: [string]) -> [string] {
  match names {
    [] => [],
    n :: rest => {
      let tail = prunable_scratch(rest, own_pane, session_ms, live);
      if is_prunable_scratch(n, own_pane, session_ms, live) then n :: tail else tail
    }
  }
}

export pure func prunable_scratch_str(names: [string], own_pane: string, session_ms: string, live: [string]) -> string
  tests [
    -- a dead session's marker and candidate: both go
    (([".pane-w1-p6-100", "run-w1-p6-100.json.settled"], "w1:p1", "200", ["w1:p1"]),
     ".pane-w1-p6-100,run-w1-p6-100.json.settled"),
    -- the RECORD is never scratch, whatever became of its session
    ((["run-w1-p6-100.json"], "w1:p1", "200", ["w1:p1"]), ""),
    -- the owning pane is still there: it may host a live session now
    (([".pane-w1-p6-100"], "w1:p1", "200", ["w1:p1", "w1:p6"]), ""),
    -- our own scratch, on our own pane
    (([".pane-w1-p1-200", "run-w1-p1-200.json.settled"], "w1:p1", "200", ["w1:p1"]), ""),
    -- our session id on another pane is still ours to keep
    (([".pane-w1-p9-200"], "w1:p1", "200", ["w1:p1"]), ""),
    -- anything this producer did not write
    ((["run.json", "probe-alpha.txt", ".unparseable-w1-p6-100"], "w1:p1", "200", ["w1:p1"]), "")
  ]
  { join(",", prunable_scratch(names, own_pane, session_ms, live)) }

export pure func prune_report(names: [string], removed: bool) -> string {
  match names {
    [] => "",
    _ => {
      let n = count_str(names);
      let noun = if n == 1 then "file" else "files";
      if removed then
        "\n\nPruned ${intToStr(n)} scratch ${noun} left in the dagr directory by sessions that are gone (${join(", ", names)}). No run file was touched."
      else
        "\n\n${intToStr(n)} scratch ${noun} in the dagr directory belong to sessions that are gone (${join(", ", names)}). They are markers and unpublished candidates, not records — set HERDR_SWEEP_STALE=1 to have future sessions remove them."
    }
  }
}

pure func has_str(xs: [string], needle: string) -> bool {
  match xs {
    [] => false,
    x :: rest => if x == needle then true else has_str(rest, needle)
  }
}

-- BOTH CONDITIONS, and the pane one is what makes this a fact rather than a
-- guess. An in-flight attempt whose pane is STILL THERE may be a delegate of a
-- session that is still running; saying it is abandoned would be the same class
-- of misreport this file exists to prevent, pointed the other way.
--
-- EXTRACTED 2026-09-07 so the REPORT and the SETTLEMENT cannot drift. They are
-- the same claim about the same task, made to a person and to a document, and
-- two copies of this predicate would eventually disagree about which.
export pure func task_is_abandoned(t: Json, live: [string]) -> bool {
  match last_of(arr_field(t, "attempts")) {
    None => false,
    Some(a) => {
      let pane = sfield(field(a, "locator"), "pane");
      attempt_is_terminal(sfield(a, "state")) == false
        && pane != "" && has_str(live, pane) == false
    }
  }
}

pure func abandoned_of(ts: [Json], live: [string]) -> [string] {
  match ts {
    [] => [],
    t :: rest => {
      let tail = abandoned_of(rest, live);
      let id = sfield(t, "id");
      match last_of(arr_field(t, "attempts")) {
        None => tail,
        Some(a) => {
          let pane = sfield(field(a, "locator"), "pane");
          if task_is_abandoned(t, live)
          then "${id} (${sfield(t, "kind")}) on pane ${pane}" :: tail
          else tail
        }
      }
    }
  }
}

-- ---------------------------------------------------------------------------
-- THE EXIT-INTENT QUERY (ABI 7.0). Which panes does this run still hold open?
--
-- This is `abandoned_of`'s question with the live-pane half removed, and the
-- removal is the point: at exit there is no `pane list` to compare against,
-- because the render runs while the turn is ending and the answer is consumed
-- much later, in another process. So this returns a CLAIM — "the run file says
-- these panes were in flight" — and the host re-checks the ownership token on
-- each one before closing it. The freshness this cannot have is supplied there.
--
-- LATEST ATTEMPT ONLY, and terminal states excluded, for `abandoned_of`'s
-- reason: a task that was retried names its old pane in an earlier attempt, and
-- that pane belongs to nobody by the time the retry is running.
--
-- AND THAT EXCLUSION LOSES A CLEANUP THE PRE-7.0 REAPER CAUGHT. `dagr_settle`
-- marks the attempt terminal whether or not the pane close SUCCEEDED -- a
-- failed close adds a note ("so it may still be running", herdr.ail:376) and
-- nothing more. So a delegate whose close failed for any reason other than
-- `pane_not_found` is recorded terminal, is excluded here, and is therefore
-- absent from every later exit render. The old reaper enumerated by TOKEN and
-- ignored task state entirely, so it would have retried that pane at exit.
--
-- This is a behavioural narrowing, not an oversight, and it is recorded rather
-- than fixed here because the fix belongs on the other side: a cleanup
-- obligation should survive a failed cleanup, which means the run file needs to
-- carry "close attempted and failed" as its own fact rather than folding it
-- into a note on a settled attempt. Until it does, the startup orphan sweep is
-- what catches these -- the same backstop that catches everything a SIGKILL
-- skipped.
--
-- THE RUN FILE IS ALREADY SESSION-KEYED (`run_file_name`: producer pane plus
-- session), so every pane named here was spawned by THIS session. That is what
-- makes reading it a substitute for a separate owned-pane set rather than a
-- weaker version of one.
pure func open_panes_of(ts: [Json], seen: [string]) -> [string] {
  match ts {
    [] => [],
    t :: rest =>
      match last_of(arr_field(t, "attempts")) {
        None => open_panes_of(rest, seen),
        Some(a) => {
          let pane = sfield(field(a, "locator"), "pane");
          if attempt_is_terminal(sfield(a, "state")) == false
             && pane != "" && has_str(seen, pane) == false
          then pane :: open_panes_of(rest, pane :: seen)
          else open_panes_of(rest, seen)
        }
      }
  }
}

-- Distinct panes whose latest attempt is still in flight. An unparseable or
-- absent file yields nothing — the same fail-closed reading `abandoned_tasks`
-- takes, and here it means "close nothing", which is the safe direction.
-- The ids of tasks whose latest attempt is still in flight -- the same
-- population `open_panes_of` walks, keyed by task rather than by pane, because
-- an attempt with no locator still has to be settled and would be invisible to
-- a pane list.
pure func open_ids_of(ts: [Json]) -> [string] {
  match ts {
    [] => [],
    t :: rest =>
      match last_of(arr_field(t, "attempts")) {
        None => open_ids_of(rest),
        Some(a) =>
          if attempt_is_terminal(sfield(a, "state")) == false && sfield(t, "id") != ""
          then sfield(t, "id") :: open_ids_of(rest)
          else open_ids_of(rest)
      }
  }
}

export pure func open_task_ids(doc: Json) -> [string] { open_ids_of(tasks_of(doc)) }

-- Asserted through the string wrapper, for `show_argv`'s reason in `types.ail`:
-- a list is not a literal. The settlement itself is asserted end to end in
-- `scripts/verify_exit_intent.ail`, against a document `dagr check --strict`
-- then has to accept.
export pure func open_task_ids_str(content: string) -> string
  tests [
    ("{\"tasks\":[{\"id\":\"a\",\"attempts\":[{\"state\":\"working\"}]}]}", "a"),
    -- terminal attempts are not in flight, whatever their task says
    ("{\"tasks\":[{\"id\":\"a\",\"attempts\":[{\"state\":\"done\"}]}]}", ""),
    -- only the LATEST attempt counts: a retry reopens a settled task
    ("{\"tasks\":[{\"id\":\"a\",\"attempts\":[{\"state\":\"lost\"},{\"state\":\"working\"}]}]}", "a"),
    -- an in-flight attempt with NO pane is still ours to settle, which is the
    -- whole reason this is keyed by task and not by locator
    ("{\"tasks\":[{\"id\":\"a\",\"attempts\":[{\"state\":\"queued\"}]},{\"id\":\"b\",\"attempts\":[{\"state\":\"done\"}]}]}", "a"),
    ("{\"tasks\":[]}", ""),
    ("not json", "")
  ]
  {
    match decode(content) {
      Err(_) => "",
      Ok(doc) => join(",", open_task_ids(doc))
    }
  }

-- THE SESSION-END SETTLEMENT, and every word of its state choice is deliberate.
--
-- `settled_unverified · heuristic` is the SAME verdict `do_check` writes for
-- P2-3 (an agent that settled with no answer file), and it is right here for
-- the same reason: nothing observed says the work failed, only that no envelope
-- arrived and now none ever will. It is NOT `lost`. `lost` is this producer's
-- word for a MEASURED absence -- `agent_not_found` from a real `agent get` --
-- and the exit path measures nothing: the panes may still be running, and even
-- when the reap is on, the close is best-effort and proof-gated and may be
-- refused. Writing `lost` here would be the producer asserting an observation
-- it did not make, which is the one failure this whole design exists to avoid.
--
-- The reason names the session, not the delegate, because that is what changed.
export pure func settle_at_session_end(doc: Json, now_ms: int) -> Json {
  settle_ids(doc, open_task_ids(doc), now_ms)
}

pure func settle_ids(doc: Json, ids: [string], now_ms: int) -> Json {
  match ids {
    [] => doc,
    id :: rest =>
      settle_ids(
        settle(doc, id, "settled_unverified", "settled_unverified", "heuristic", "",
               "the session that delegated this ended while the attempt was in flight; no answer was ever collected",
               now_ms),
        rest, now_ms)
  }
}

export pure func open_delegate_panes(content: string) -> [string] {
  match decode(content) {
    Err(_) => [],
    Ok(doc) => open_panes_of(tasks_of(doc), [])
  }
}

export pure func open_delegate_panes_str(content: string) -> string
  tests [
    ("{\"tasks\":[{\"id\":\"mot-dlg-5\",\"attempts\":[{\"state\":\"working\",\"locator\":{\"pane\":\"w1:p8\"}}]}]}",
     "w1:p8"),
    -- settled work holds no pane open
    ("{\"tasks\":[{\"id\":\"mot-dlg-5\",\"attempts\":[{\"state\":\"done\",\"locator\":{\"pane\":\"w1:p8\"}}]}]}",
     ""),
    -- only the LATEST attempt counts: the retried pane is not ours any more
    ("{\"tasks\":[{\"id\":\"mot-dlg-5\",\"attempts\":[{\"state\":\"lost\",\"locator\":{\"pane\":\"w1:p7\"}},{\"state\":\"working\",\"locator\":{\"pane\":\"w1:p9\"}}]}]}",
     "w1:p9"),
    -- two tasks sharing a pane name it once
    ("{\"tasks\":[{\"id\":\"a\",\"attempts\":[{\"state\":\"working\",\"locator\":{\"pane\":\"w1:p8\"}}]},{\"id\":\"b\",\"attempts\":[{\"state\":\"queued\",\"locator\":{\"pane\":\"w1:p8\"}}]}]}",
     "w1:p8"),
    ("not json", ""),
    ("", "")
  ]
  { join(",", open_delegate_panes(content)) }

-- Tasks in `content` whose latest attempt is still in flight on a pane that is
-- not in `live`. An unparseable file yields nothing: we are not its writer and
-- not its validator either.
export pure func abandoned_tasks(content: string, live: [string]) -> [string] {
  match decode(content) {
    Err(_) => [],
    Ok(doc) => abandoned_of(tasks_of(doc), live)
  }
}

export pure func abandoned_tasks_str(content: string, live: [string]) -> string
  tests [
    (("{\"tasks\":[{\"id\":\"mot-dlg-5\",\"kind\":\"review\",\"attempts\":[{\"state\":\"working\",\"locator\":{\"pane\":\"w1:p8\"}}]}]}",
      ["w1:p1"]), "mot-dlg-5 (review) on pane w1:p8"),
    -- the pane is still there: not this function's call to make
    (("{\"tasks\":[{\"id\":\"mot-dlg-5\",\"kind\":\"review\",\"attempts\":[{\"state\":\"working\",\"locator\":{\"pane\":\"w1:p8\"}}]}]}",
      ["w1:p1", "w1:p8"]), ""),
    -- settled work is not abandoned, whatever became of its pane
    (("{\"tasks\":[{\"id\":\"mot-dlg-5\",\"kind\":\"review\",\"attempts\":[{\"state\":\"done\",\"locator\":{\"pane\":\"w1:p8\"}}]}]}",
      ["w1:p1"]), ""),
    -- only the LATEST attempt counts: a1 lost, a2 running on a live pane
    (("{\"tasks\":[{\"id\":\"mot-dlg-5\",\"kind\":\"impl\",\"attempts\":[{\"state\":\"lost\",\"locator\":{\"pane\":\"w1:p7\"}},{\"state\":\"working\",\"locator\":{\"pane\":\"w1:p9\"}}]}]}",
      ["w1:p9"]), ""),
    (("not json", ["w1:p1"]), ""),
    (("", ["w1:p1"]), "")
  ]
  { join(",", abandoned_tasks(content, live)) }

pure func abandoned_ids_of(ts: [Json], live: [string]) -> [string] {
  match ts {
    [] => [],
    t :: rest => {
      let tail = abandoned_ids_of(rest, live);
      if task_is_abandoned(t, live) && sfield(t, "id") != ""
      then sfield(t, "id") :: tail
      else tail
    }
  }
}

export pure func abandoned_ids(content: string, live: [string]) -> [string] {
  match decode(content) {
    Err(_) => [],
    Ok(doc) => abandoned_ids_of(tasks_of(doc), live)
  }
}

export pure func abandoned_ids_str(content: string, live: [string]) -> string
  tests [
    (("{\"tasks\":[{\"id\":\"mot-dlg-5\",\"attempts\":[{\"state\":\"working\",\"locator\":{\"pane\":\"w1:p8\"}}]}]}",
      ["w1:p1"]), "mot-dlg-5"),
    -- the pane is alive: NOT abandoned, and this is the conjunct that keeps a
    -- concurrent session's live delegates out of another session's settlement
    (("{\"tasks\":[{\"id\":\"mot-dlg-5\",\"attempts\":[{\"state\":\"working\",\"locator\":{\"pane\":\"w1:p8\"}}]}]}",
      ["w1:p1", "w1:p8"]), ""),
    (("{\"tasks\":[{\"id\":\"mot-dlg-5\",\"attempts\":[{\"state\":\"done\",\"locator\":{\"pane\":\"w1:p8\"}}]}]}",
      ["w1:p1"]), ""),
    (("not json", ["w1:p1"]), "")
  ]
  { join(",", abandoned_ids(content, live)) }

-- SETTLING SOMEONE ELSE'S RECORD, and the verdict is the one this producer
-- already writes for exactly this observation.
--
-- `lost · heuristic` is what `do_check` writes when herdr answers
-- `agent_not_found`: the pane is gone and no answer file was written. The sweep
-- makes the SAME observation by a different route -- the pane is absent from
-- `pane list` -- so it writes the same verdict rather than inventing one. It is
-- not `settled_unverified`: that is for an attempt nobody can observe any more,
-- and this one WAS observed, just not by its own session.
--
-- WHY THIS IS NOT THE "FABRICATED SETTLEMENT" F-5 §5.5 FORBIDS. That sentence
-- is about the pane that is STILL ALIVE with its orchestrator gone -- there,
-- nothing has been measured and the honest act is a note. Here the pane's
-- absence is positive proof, which is the same standard P2-6 sets for closing
-- one. `task_is_abandoned`'s liveness conjunct is what keeps the two apart, and
-- a task on a live pane is left exactly as it was.
--
-- IDEMPOTENT BY `settle`'s CONTRACT: an already-terminal attempt returns the
-- document untouched, so two sessions sweeping the same file write the same
-- bytes and the second changes nothing.
export pure func settle_abandoned(doc: Json, live: [string], sweeper: string, now_ms: int) -> Json {
  settle_abandoned_ids(doc, abandoned_ids_of(tasks_of(doc), live), sweeper, now_ms)
}

pure func settle_abandoned_ids(doc: Json, ids: [string], sweeper: string, now_ms: int) -> Json {
  match ids {
    [] => doc,
    id :: rest =>
      settle_abandoned_ids(
        add_note(
          settle(doc, id, "lost", "failed", "heuristic", "",
                 "the pane is gone and no answer file was written", now_ms),
          id,
          "settled by the startup sweep of a later session (${sweeper}); the session that delegated this never observed the end",
          now_ms),
        rest, sweeper, now_ms)
  }
}

pure func count_str(xs: [string]) -> int {
  match xs { [] => 0, _ :: rest => 1 + count_str(rest) }
}

-- REPORT, NEVER REPAIR, and the sentence says which. A model told "there is a
-- stale record" without being told it is not its to fix will try to fix it.
-- THE SENTENCE HAS TO SAY WHICH OF THE TWO THINGS HAPPENED. Finding 4 of the
-- PLAN-001 run recorded that the report-only version "is correct and nobody
-- will ever act on it from a tool result" -- so when the sweep DOES act, saying
-- "nothing was changed" would be false, and saying nothing would hide a write to
-- a file this session does not own. Both halves are spelled out.
export pure func abandoned_report(items: [string], settled: bool) -> string
  tests [
    (([], false), ""),
    (([], true), ""),
    ((["run-w1-p6-100.json — mot-dlg-5 (review) on pane w1:p8"], false),
     "\n\nStale delegation record: 1 task in another session's dagr run file is recorded still in flight on a pane that no longer exists (run-w1-p6-100.json — mot-dlg-5 (review) on pane w1:p8). Nothing was changed: this session is not that file's writer and never writes to it. The record is stale, not the work — that delegate is gone, and its result, if any, was never collected."),
    ((["run-w1-p6-100.json — mot-dlg-5 (review) on pane w1:p8"], true),
     "\n\nStale delegation record: 1 task in another session's dagr run file is recorded still in flight on a pane that no longer exists (run-w1-p6-100.json — mot-dlg-5 (review) on pane w1:p8). HERDR_SWEEP_SETTLE is set, so each was settled `lost` in that file and a note recording this session as the settler was added. The record is stale, not the work — that delegate is gone, and its result, if any, was never collected.")
  ]
  {
    match items {
      [] => "",
      _ => {
        let n = count_str(items);
        let noun = if n == 1 then "task" else "tasks";
        let verb = if n == 1 then "is" else "are";
        let action =
          if settled then
            "HERDR_SWEEP_SETTLE is set, so ${if n == 1 then "each was" else "each was"} settled `lost` in that file and a note recording this session as the settler was added."
          else
            "Nothing was changed: this session is not that file's writer and never writes to it.";
        "\n\nStale delegation record: ${intToStr(n)} ${noun} in another session's dagr run file ${verb} recorded still in flight on a pane that no longer exists (${join(", ", items)}). ${action} The record is stale, not the work — ${if n == 1 then "that delegate is" else "those delegates are"} gone, and ${if n == 1 then "its result" else "their results"}, if any, ${if n == 1 then "was" else "were"} never collected."
      }
    }
  }
