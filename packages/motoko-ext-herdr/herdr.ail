module sunholo/motoko_ext_herdr/herdr

-- DELEGATION AS AN ADDRESSABLE SESSION. Two tools that hand a bounded sub-task
-- to a coding agent running in its own herdr pane, and then let the model come
-- back for the answer.
--
-- WHY TWO TOOLS AND NOT ONE, and why neither of them waits. 021 §4.1 proposed
-- an "optimistic-synchronous" `Delegate` that waits up to 25s so that a fast
-- task completes in a single call. Measured against a running herdr that is the
-- wrong default: the median delegated task takes 23.1s, the worst case measured
-- was 91.2s, and HALF of realistic tasks exceed the 25s bound — while
-- `agent get` costs 4ms and submitting a prompt without `--wait` costs 3-5ms.
-- A coin-flip is not a fast path: half of all delegations would spend ~25s of
-- Motoko's 30s process budget and STILL return a handle. So `Delegate` submits
-- and returns immediately, and `DelegateCheck` is cheap enough to call often.
-- The model decides when to come back, which is what an agent loop is for.
--
-- WHY `on_tool_handle`. It is one of only two ABI slots carrying the whole
-- `{IO, Process, FS}` row, and the other one runs after the model has produced
-- text. No new ABI slot is added; 017 prices one at 16 packages.
--
-- THIS EXTENSION IS INERT OUTSIDE A HERDR PANE, and that is enforced in
-- `register.ail` by returning empty `provided_tools` rather than here by
-- failing at call time. A tool that is offered and then errors costs the model
-- a turn and teaches it nothing.

import std/option (Option, Some, None)
import std/string (length, substring, contains)
import std/json (Json, jo, kv, js, jnum, jb, get, asString)

import pkg/sunholo/motoko_ext_abi/types (
  PreStepOutcome, ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome,
  ExtCtx, Capability, DescribeTools, PromptShaper, BudgetShaper, Compactor, ToolPolicy, ToolProvider, ResponseInterceptor, SolverJudge, ExtPorts, ExtWorld, PromptPatch, BudgetPlan, BudgetPatch,
  ToolPolicyDecision, ToolHandleDecision, ResponseInterceptDecision, FinalizeDecision,
  PassThrough, PreStepDecision, Msg, ToolSchema,
  ToolCallEnvelope, ToolResultEnvelope
)
import pkg/sunholo/motoko_ext_herdr/types (
  delegate_name, owns_name, task_path, answer_path, task_wrapper_prompt,
  known_kind, default_kind, kind_allowed, grants_relaxation,
  path_is_safe, path_within, argv_is_safe, show_argv,
  argv_split, argv_start, argv_prompt, argv_get, argv_explain, argv_close,
  argv_wait, wait_elapsed, elapsed_note, format_ms, start_ms_of, elapsed_is_exact,
  is_motoko, motoko_kind, motoko_run_payload, motoko_payload_is_safe,
  argv_pane_run, argv_wait_until, motoko_handle, handle_is_motoko,
  handle_pane, handle_name,
  depth_allows, next_depth, argv_env_depth,
  failure_code, failure_message, explain_says_ready,
  split_pane_id, agent_status_of, agent_pane_of, is_settled,
  bash_exec_tool, bash_exec_args, bash_field, bash_exit
)

export type HerdrConfig = {
  bin: string,
  own_pane: string,
  work_dir: string,
  kind: string,
  -- Operator policy: which kinds the MODEL may select. See
  -- `types.kind_allowed` for why this exists and why it defaults to claude.
  allowed_kinds: string,
  -- Recursion control. `depth` is this Motoko's own depth (0 for the
  -- operator's); `max_depth` is how deep delegation may go. See
  -- `types.depth_allows`.
  depth: int,
  max_depth: int,
  motoko_script: string,
  start_timeout_ms: int,
  -- How long DelegateCheck blocks server-side before answering "still working".
  -- See `types.argv_wait` for why blocking is the default and not an option the
  -- model has to remember to ask for.
  check_wait_ms: int,
  max_output_chars: int
}

export func tool_names() -> [string] { ["Delegate", "DelegateCheck"] }

-- The schema names the ALLOWED set, not every kind herdr knows. Advertising a
-- kind the operator has not permitted costs the model a turn to discover it
-- cannot have it.
func delegate_params(allowed: string) -> string {
  "{\"type\":\"object\",\"properties\":{\"prompt\":{\"type\":\"string\",\"description\":\"The complete task statement. The delegate shares none of this conversation, so it must stand alone. Shell metacharacters and code fences are fine here — this text travels in a file, never on a command line.\"},\"kind\":{\"type\":\"string\",\"description\":\"Agent kind to run. The operator permits only: ${allowed}. Omit it unless you have a specific reason — the default is the fastest kind and the one needing no privilege relaxation.\"},\"cwd\":{\"type\":\"string\",\"description\":\"Working directory for the delegate's pane. Defaults to Motoko's own.\"}},\"required\":[\"prompt\"]}"
}

func check_params() -> string {
  "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"The delegate handle returned by Delegate.\"}},\"required\":[\"name\"]}"
}

export func describe_tools(allowed: string) -> [ToolSchema] {
  [
    { name: "Delegate",
      description: "Hand a self-contained sub-task to a coding agent running in its own terminal pane. Returns a handle immediately; the delegate keeps working after this call returns. Poll with DelegateCheck — a typical task takes 20-30s and some take over a minute.",
      parameters: delegate_params(allowed) },
    { name: "DelegateCheck",
      description: "Fetch a delegate's current state and its answer if it has landed. Cheap; call it as often as you like.",
      parameters: check_params() }
  ]
}

func meta(name: string, pane: string) -> Json {
  jo([kv("delegate", js(name)), kv("pane_id", js(pane)), kv("channel", js("answer-file"))])
}

-- A privileged delegate should be legible in the TRANSCRIPT, not only in the
-- pane label. The operator found the first one by noticing the pane said codex.
func meta_kind(name: string, pane: string, kind: string) -> Json {
  jo([kv("delegate", js(name)), kv("pane_id", js(pane)), kv("channel", js("answer-file")),
      kv("kind", js(kind)),
      kv("permissions", js(if grants_relaxation(kind) then "relaxed: sandbox and approvals disabled for this kind" else "default: no relaxation"))])
}

-- Timing in metadata as well as prose: a caller that wants to compare two
-- delegates should not have to parse a sentence.
func meta_timed(name: string, pane: string, now_ms: int, waited_ms: int) -> Json {
  let started = start_ms_of(name);
  jo([kv("delegate", js(name)), kv("pane_id", js(pane)), kv("channel", js("answer-file")),
      kv("started_ms", jnum(_int_to_float(started))),
      kv("elapsed_ms", jnum(_int_to_float(if started > 0 then now_ms - started else 0))),
      kv("waited_ms", jnum(_int_to_float(waited_ms))),
      kv("elapsed_is_exact", jb(elapsed_is_exact(waited_ms)))])
}

func relaxation_note(kind: string) -> string {
  if grants_relaxation(kind) then
    ", which the operator has permitted to run with its sandbox and approval prompts disabled"
  else ""
}

func err_result(call_id: string, tool: string, msg: string) -> ToolResultEnvelope {
  { tool_call_id: call_id, tool: tool, exit_code: 1, stdout: "", stderr: msg,
    metadata: jo([]) }
}

func truncate(s: string, limit: int) -> string {
  if length(s) > limit then substring(s, 0, limit) else s
}

func arg_str(args: Json, key: string, fallback: string) -> string {
  match get(args, key) {
    None => fallback,
    Some(v) => match asString(v) {
      Some(s) => if s == "" then fallback else s,
      None => fallback
    }
  }
}

-- ---------------------------------------------------------------------------
-- One herdr call
-- ---------------------------------------------------------------------------

type HerdrRun = { out: string, err: string, code: int, next_state: ExtWorld }

-- Routed through `ExtPorts.tool_handle`, which is reachable here because the argv
-- is token-free by construction — see the note in `types.ail`. The guard is not
-- decoration: if a caller ever manages to get a shell token into an argv
-- element, sending it would silently drop every argument and run bare `herdr`,
-- so the call is refused with an explanation instead.
func run_herdr(cfg: HerdrConfig, p: ExtPorts, w: ExtWorld, argv: [string]) -> HerdrRun ! {IO, Process, FS} {
  if argv_is_safe(argv) == false then
    { out: "", err: "refused: the herdr argv contained a shell metacharacter and would have been mangled by motoko_agent#158 (`${show_argv(argv)}`)",
      code: 1, next_state: w }
  else {
    let r = p.tool_handle(w, bash_exec_tool(), bash_exec_args(cfg.bin, argv));
    { out: bash_field(r.output, "stdout"),
      err: bash_field(r.output, "stderr"),
      code: bash_exit(r.output),
      next_state: r.next_state }
  }
}

-- The one place both error vocabularies meet. `code == -1` is the tool
-- runtime's envelope failing to decode, which is neither a herdr error nor a
-- ProcessError and must not be dressed up as either.
func explain_failure(step: string, argv: [string], run: HerdrRun) -> string {
  if run.code == -1 then
    "${step}: the tool runtime returned no readable result for `herdr ${show_argv(argv)}`. No subprocess outcome is available, so this is not a delegate failure."
  else
    "${step} failed (herdr exit ${show(run.code)}, code `${failure_code(run.code, run.err)}`). ${failure_message(run.code, run.err)}"
}

-- ---------------------------------------------------------------------------
-- Delegate
-- ---------------------------------------------------------------------------

func do_delegate(cfg: HerdrConfig, ctx: ExtCtx, call: ToolCallEnvelope)
  -> { result: ToolResultEnvelope, next_state: ExtWorld } ! {IO, Process, FS, Clock} {
  let p = ctx.ports;
  let prompt = arg_str(call.arguments, "prompt", "");
  let kind = arg_str(call.arguments, "kind", cfg.kind);
  let cwd = arg_str(call.arguments, "cwd", ctx.workdir);

  if prompt == "" then
    { result: err_result(call.id, "Delegate", "Delegate requires a non-empty `prompt`."), next_state: ctx.world }
  else if known_kind(kind) == false then
    { result: err_result(call.id, "Delegate", "`${kind}` is not an agent kind herdr knows at all. The operator permits: ${cfg.allowed_kinds}."), next_state: ctx.world }
  -- OPERATOR POLICY, CHECKED BEFORE ANYTHING IS SPENT. Refusing here rather
  -- than at `agent start` also saves a pane and a start timeout for a kind that
  -- was never going to be permitted.
  -- RECURSION GATE, BEFORE ANYTHING IS SPENT. Checked for every kind, not just
  -- motoko: the default limit of 1 means the operator's Motoko may delegate and
  -- a delegate may not, which is what "recursion default-off" means. It also
  -- bounds the orphan story — an orphaned delegate at the limit cannot spawn.
  else if depth_allows(cfg.depth, cfg.max_depth) == false then
    { result: err_result(call.id, "Delegate",
        "Delegation is not permitted at this depth. This Motoko is itself a delegate (depth ${show(cfg.depth)}) and the limit is ${show(cfg.max_depth)}, so it must do the work itself rather than delegating further. The operator can raise HERDR_MAX_DELEGATE_DEPTH; recursion is off by default because a tree of agent loops has no budget propagation and nothing would notice it growing."),
      next_state: ctx.world }
  else if kind_allowed(cfg.allowed_kinds, kind) == false then
    { result: err_result(call.id, "Delegate",
        "`${kind}` is a kind herdr knows, but the operator has not permitted it here. Permitted: ${cfg.allowed_kinds}. This is an operator decision, not something to work around — `${kind}` may require relaxed permissions or be unverified in this container. Use a permitted kind, or ask the operator to widen HERDR_ALLOWED_KINDS."),
      next_state: ctx.world }
  else if path_is_safe(cwd) == false then
    { result: err_result(call.id, "Delegate", "The working directory `${cwd}` contains a shell metacharacter and cannot be passed safely."), next_state: ctx.world }
  else {
    -- The name is seeded from the clock so it is unique among live agents and
    -- monotonic across runs in the same pane.
    let clock = p.clock_now(ctx.world);
    let name = delegate_name(clock.now_ms);
    let task = task_path(cfg.work_dir, name);
    let answer = answer_path(cfg.work_dir, name);

    if path_is_safe(task) == false || path_is_safe(answer) == false then
      { result: err_result(call.id, "Delegate", "The delegate work directory `${cfg.work_dir}` contains a shell metacharacter; set HERDR_DELEGATE_DIR to a plain path."), next_state: clock.next_state }
    -- REFUSE BEFORE TOUCHING THE FILESYSTEM. A path outside AILANG_FS_SANDBOX
    -- is not an error this handler could catch — it terminates the run — so
    -- the check has to happen before the first `dir_make`, not around it.
    else if path_within(ctx.workdir, cfg.work_dir) == false then
      { result: err_result(call.id, "Delegate", "The delegate work directory `${cfg.work_dir}` is outside Motoko's filesystem sandbox (`${ctx.workdir}`). Reading a file there would terminate the run rather than fail, so the call is refused. Set HERDR_DELEGATE_DIR to a path under the working directory."), next_state: clock.next_state }
    else {
      let dir = p.dir_make(clock.next_state, cfg.work_dir);
      -- THE MODEL-AUTHORED PROMPT NEVER TOUCHES ARGV. This write is the whole
      -- reason #158 is avoidable here.
      let wrote = p.file_write(dir.next_state, task, prompt);
      if wrote.ok == false then
        { result: err_result(call.id, "Delegate", "Could not write the task file `${task}`: ${wrote.error}"), next_state: wrote.next_state }
      else {
        let sp = run_herdr(cfg, p, wrote.next_state, argv_split(cwd, argv_env_depth(cfg.depth)));
        let pane = split_pane_id(sp.out);
        if sp.code != 0 || pane == "" then
          { result: err_result(call.id, "Delegate", explain_failure("Splitting a pane for the delegate", argv_split(cwd, argv_env_depth(cfg.depth)), sp)), next_state: sp.next_state }
        else if is_motoko(kind) then {
          -- MOTOKO IS A SECOND LIFECYCLE, NOT A KIND. `agent start --kind` takes
          -- a fixed list of 22 and motoko is not on it (020 ADR-001 option B).
          -- It does not need it: Motoko is a lifecycle AUTHORITY (020 D1) and
          -- announces itself, ~0.8s after `pane run` against 3.9s for
          -- `agent start --kind claude`.
          --
          -- The task arrives as argv[2]. `agent prompt` refuses reported agents
          -- ("not an active named agent") and `pane send-text` is screen-driving
          -- that the handoff forbids, so argv is the only channel — and it is a
          -- better one, since it needs no readiness gate at all.
          if motoko_payload_is_safe(cfg.motoko_script, task, answer) == false then {
            let cleaned = run_herdr(cfg, p, sp.next_state, argv_close(pane));
            { result: err_result(call.id, "Delegate", "The delegate paths or script path contain a single quote, which would break the shell quoting of the `pane run` payload. Refused rather than sent."), next_state: cleaned.next_state }
          }
          else {
            let payload = motoko_run_payload(cfg.motoko_script, task, answer);
            let rn = run_herdr(cfg, p, sp.next_state, argv_pane_run(pane, payload));
            if rn.code != 0 then {
              let cleaned = run_herdr(cfg, p, rn.next_state, argv_close(pane));
              { result: err_result(call.id, "Delegate", explain_failure("Starting a motoko delegate", argv_pane_run(pane, payload), rn)), next_state: cleaned.next_state }
            }
            else {
              -- THE HANDLE CARRIES THE PANE. The row does not exist yet — it
              -- appears ~0.8s from now — and `agent wait` will not block for an
              -- agent that does not exist (measured: agent_not_found in 2ms), so
              -- there is nothing to rename and nothing to gate on. See
              -- `types.motoko_handle`.
              let t = p.clock_now(rn.next_state);
              let h = motoko_handle(clock.now_ms, pane);
              { result: {
                  tool_call_id: call.id, tool: "Delegate", exit_code: 0,
                  stdout: "Delegate `${h}` is running motoko in pane ${pane}. Starting it took ${format_ms(t.now_ms - clock.now_ms)}. A motoko delegate does not report readiness the way claude and codex do and it will not stop on its own, so DelegateCheck watches for the answer file rather than for the agent going idle. Call DelegateCheck with `${h}`.",
                  stderr: "", metadata: meta_kind(h, pane, motoko_kind())
                },
                next_state: t.next_state }
            }
          }
        }
        else {
          let st = run_herdr(cfg, p, sp.next_state, argv_start(name, kind, pane, cfg.start_timeout_ms));
          if st.code != 0 then {
            -- Do not leak the pane we just made. This is the narrowest orphan
            -- rule that works and it is deliberately not a sweep: it closes the
            -- one pane this call created, by id.
            let cleaned = run_herdr(cfg, p, st.next_state, argv_close(pane));
            { result: err_result(call.id, "Delegate", explain_failure("Starting a `${kind}` delegate", argv_start(name, kind, pane, cfg.start_timeout_ms), st)), next_state: cleaned.next_state }
          }
          else {
            -- READINESS GATE. herdr reports `interactive_ready: true` for
            -- agents that are not usable — measured on an unauthenticated codex
            -- and on a claude stuck at its API-key modal. Prompting one of
            -- those is not harmless: in testing it pressed Enter on codex's
            -- sign-in menu and started an OAuth device flow.
            let ex = run_herdr(cfg, p, st.next_state, argv_explain(pane));
            if explain_says_ready(ex.out) == false then {
              let cleaned = run_herdr(cfg, p, ex.next_state, argv_close(pane));
              { result: err_result(call.id, "Delegate",
                  "A `${kind}` agent started in pane ${pane} but is not at a usable prompt — herdr matched no screen rule for it, which in this image means it is sitting on a sign-in screen or a modal. The pane has been closed. Check that `${kind}` is authenticated in this container."),
                next_state: cleaned.next_state }
            }
            else {
              -- NO `--wait`. See the header.
              let text = task_wrapper_prompt(task, answer);
              let pr = run_herdr(cfg, p, ex.next_state, argv_prompt(name, text));
              if pr.code != 0 then {
                let cleaned = run_herdr(cfg, p, pr.next_state, argv_close(pane));
                { result: err_result(call.id, "Delegate", explain_failure("Submitting the task to the delegate", argv_prompt(name, text), pr)), next_state: cleaned.next_state }
              }
              else {
                -- SETUP IS NOT FREE AND WAS INVISIBLE. `pane split` +
                -- `agent start` + the readiness gate run sequentially inside
                -- this one call, and `agent start` alone measured ~3.9s. Two
                -- Delegate calls in one step were 3.9s apart for exactly this
                -- reason, and nothing said so.
                let t = p.clock_now(pr.next_state);
                { result: {
                    tool_call_id: call.id,
                    tool: "Delegate",
                    exit_code: 0,
                    stdout: "Delegate `${name}` is running `${kind}` in pane ${pane}${relaxation_note(kind)}. Starting it took ${format_ms(t.now_ms - clock.now_ms)}. It has the task and is working now; this call did not wait for it. Typical completion is 20-30s and some tasks take over a minute. Call DelegateCheck with name `${name}` to collect the answer.",
                    stderr: "",
                    metadata: meta_kind(name, pane, kind)
                  },
                  next_state: t.next_state }
              }
            }
          }
        }
      }
    }
  }
}

-- ---------------------------------------------------------------------------
-- DelegateCheck
-- ---------------------------------------------------------------------------

-- THE COMPLETION GATE FOR A MOTOKO DELEGATE IS THE ANSWER FILE, FULL STOP.
--
-- Motoko reports `idle` AT STARTUP — 020 D2's deliberate initial report, which
-- exists so the row appears before the first task. Measured: `motoko idle` 869ms
-- after `pane run`, with the task not begun. Run through the normal path that
-- would hit `is_settled("idle")`, take the settled branch, find no answer file
-- and report P2-3's "finished but never wrote" against a delegate that has not
-- started. So the agent state is never consulted for completion here; it is used
-- only to pick which transition to wait on.
--
-- It also does not stop after answering (measured: `working` 18s+ later), so
-- reaping is an explicit close once the file lands, not a wait for a settle that
-- never comes.
func do_check_motoko(cfg: HerdrConfig, ctx: ExtCtx, call: ToolCallEnvelope, handle: string)
  -> { result: ToolResultEnvelope, next_state: ExtWorld } ! {IO, Process, FS, Clock} {
  let p = ctx.ports;
  let pane = handle_pane(handle);
  let answer = answer_path(cfg.work_dir, handle_name(handle));
  let t0 = p.clock_now(ctx.world);

  -- The file first, always. If it is there the delegate is done regardless of
  -- what its state says, and nothing else needs asking.
  let early = p.file_read(t0.next_state, answer);
  if early.present && early.content != "" then {
    let closed = run_herdr(cfg, p, early.next_state, argv_close(pane));
    { result: {
        tool_call_id: call.id, tool: "DelegateCheck", exit_code: 0,
        stdout: "Delegate `${handle}` finished.${elapsed_note(handle, t0.now_ms, 999999)}\n\n${truncate(early.content, cfg.max_output_chars)}",
        stderr: "", metadata: meta_timed(handle, pane, t0.now_ms, 999999)
      },
      next_state: closed.next_state }
  }
  else {
    let g = run_herdr(cfg, p, early.next_state, argv_get(pane));
    if g.code != 0 then
      { result: err_result(call.id, "DelegateCheck", explain_failure("Reading motoko delegate in pane `${pane}`", argv_get(pane), g)), next_state: g.next_state }
    else {
      -- Which transition to wait on. `working` means it is doing the task, so
      -- wait for it to go idle. Anything else means it has not begun (the
      -- startup idle), so wait for it to START. Both are bounded.
      let status = agent_status_of(g.out);
      let target = if status == "working" then "idle" else "working";
      let w = run_herdr(cfg, p, g.next_state, argv_wait_until(pane, target, cfg.check_wait_ms));
      let t1 = p.clock_now(w.next_state);
      let waited = t1.now_ms - t0.now_ms;
      let rd = p.file_read(t1.next_state, answer);
      if rd.present && rd.content != "" then {
        let closed = run_herdr(cfg, p, rd.next_state, argv_close(pane));
        { result: {
            tool_call_id: call.id, tool: "DelegateCheck", exit_code: 0,
            stdout: "Delegate `${handle}` finished.${elapsed_note(handle, t1.now_ms, waited)}\n\n${truncate(rd.content, cfg.max_output_chars)}",
            stderr: "", metadata: meta_timed(handle, pane, t1.now_ms, waited)
          },
          next_state: closed.next_state }
      }
      else
        { result: {
            tool_call_id: call.id, tool: "DelegateCheck", exit_code: 0,
            stdout: "Delegate `${handle}` has not written its answer yet (state `${agent_status_of(g.out)}`, waited ${format_ms(waited)} for a transition to `${target}`). A motoko delegate reports idle at startup, so its state is not a completion signal — only the answer file is. Check again.",
            stderr: "", metadata: meta_timed(handle, pane, t1.now_ms, waited)
          },
          next_state: rd.next_state }
    }
  }
}

func do_check(cfg: HerdrConfig, ctx: ExtCtx, call: ToolCallEnvelope)
  -> { result: ToolResultEnvelope, next_state: ExtWorld } ! {IO, Process, FS, Clock} {
  let p = ctx.ports;
  let name = arg_str(call.arguments, "name", "");

  if name == "" then
    { result: err_result(call.id, "DelegateCheck", "DelegateCheck requires the `name` returned by Delegate."), next_state: ctx.world }
  -- POSITIVE OWNERSHIP, not self-exclusion. `agent list` in this workspace
  -- returns Motoko's own row AND any agent the operator started by hand;
  -- during Phase A it returned an operator-owned codex pane. "Not me" is not
  -- enough to justify touching something.
  else if owns_name(name) == false then
    { result: err_result(call.id, "DelegateCheck", "`${name}` was not started by this extension. Only handles returned by Delegate can be checked, and nothing else in the session will be touched."), next_state: ctx.world }
  else if handle_is_motoko(name) then do_check_motoko(cfg, ctx, call, name)
  else {
    -- WAIT FIRST, SERVER-SIDE. Without this the model busy-polls: `agent get`
    -- returns in 4ms, a model cannot sleep, so the loop runs at whatever rate
    -- the model can emit tool calls. Measured on a real run: ten DelegateCheck
    -- steps for an eleven-second delegation.
    --
    -- It is unconditional rather than a parameter. The observed failure IS a
    -- model failing to pace itself, so a knob it has to remember to set would
    -- reproduce the bug exactly.
    -- TIMESTAMPED EITHER SIDE OF THE WAIT, not at the end of the handler. See
    -- `types.elapsed_note`: the naive reading inverts results when two checks
    -- are dispatched in one step, which is exactly how the defect was found.
    let t0 = p.clock_now(ctx.world);
    let w = run_herdr(cfg, p, t0.next_state, argv_wait(name, cfg.check_wait_ms));
    let t1 = p.clock_now(w.next_state);
    let waited = t1.now_ms - t0.now_ms;
    let took = elapsed_note(name, t1.now_ms, waited);
    -- `timeout` here is the poll interval elapsing, not a failure. Everything
    -- else non-zero — agent_not_found above all — keeps its own message.
    if w.code != 0 && wait_elapsed(w.code, w.err) == false then
      { result: err_result(call.id, "DelegateCheck", explain_failure("Waiting on delegate `${name}`", argv_wait(name, cfg.check_wait_ms), w)), next_state: t1.next_state }
    else {
    -- AND THEN CHECK ANYWAY. The wait settles on the AGENT going idle, which is
    -- not the same event as the answer file landing — P2-3 measured a delegate
    -- reaching a clean `done` having written nothing. Wait-then-check, never
    -- wait-instead-of-check.
    let g = run_herdr(cfg, p, t1.next_state, argv_get(name));
    if g.code != 0 then
      { result: err_result(call.id, "DelegateCheck", explain_failure("Reading delegate `${name}`", argv_get(name), g)), next_state: g.next_state }
    else {
      let status = agent_status_of(g.out);
      let pane = agent_pane_of(g.out);
      let answer = answer_path(cfg.work_dir, name);
      let rd = p.file_read(g.next_state, answer);

      -- THE ANSWER FILE IS THE EVIDENCE, THE REPLY IS NOT. Measured three
      -- times: a delegate settles at a clean `done`, replies with exactly the
      -- path it was asked for, and has written nothing. Reporting that as
      -- success is the failure mode this branch exists to prevent.
      if rd.present && rd.content != "" then {
        let closed = run_herdr(cfg, p, rd.next_state, argv_close(pane));
        { result: {
            tool_call_id: call.id, tool: "DelegateCheck", exit_code: 0,
            stdout: "Delegate `${name}` finished.${took}\n\n${truncate(rd.content, cfg.max_output_chars)}",
            stderr: "", metadata: meta_timed(name, pane, t1.now_ms, waited)
          },
          next_state: closed.next_state }
      }
      else if status == "blocked" then
        { result: {
            tool_call_id: call.id, tool: "DelegateCheck", exit_code: 0,
            stdout: "Delegate `${name}` is BLOCKED in pane ${pane}, waiting for someone to answer a prompt on its screen. It will not progress until that is answered. It has not been closed.${took}",
            stderr: "", metadata: meta_timed(name, pane, t1.now_ms, waited)
          },
          next_state: rd.next_state }
      else if is_settled(status) then {
        -- Settled with no answer file. Close the pane — it is finished and
        -- would otherwise be an unattended agent outliving its caller — and
        -- name the failure honestly.
        let closed = run_herdr(cfg, p, rd.next_state, argv_close(pane));
        { result: {
            tool_call_id: call.id, tool: "DelegateCheck", exit_code: 1,
            stdout: "",
            stderr: "Delegate `${name}` finished (state `${status}`) but never wrote its answer file `${answer}`.${took} The delegate may have replied with the path without writing it, which is a known failure of unsandboxed delegates in this container. Nothing was produced; re-delegate, or run the task directly.",
            metadata: meta_timed(name, pane, t1.now_ms, waited)
          },
          next_state: closed.next_state }
      }
      else
        { result: {
            tool_call_id: call.id, tool: "DelegateCheck", exit_code: 0,
            stdout: "Delegate `${name}` is still `${status}` in pane ${pane} after ${format_ms(t1.now_ms - start_ms_of(name))}. No answer yet — this call already waited ${format_ms(waited)} server-side for it, so check again rather than assuming it is stuck.",
            stderr: "", metadata: meta_timed(name, pane, t1.now_ms, waited)
          },
          next_state: rd.next_state }
    }
    }
  }
}

-- ---------------------------------------------------------------------------
-- Hooks
-- ---------------------------------------------------------------------------

export func on_tool_handle(cfg: HerdrConfig, ctx: ExtCtx, call: ToolCallEnvelope)
  -> ToolHandleOutcome ! {IO, Process, FS, Clock} {
  if call.tool == "Delegate" then {
    let r = do_delegate(cfg, ctx, call);
    { decision: Handled(r.result), next_state: r.next_state }
  }
  else if call.tool == "DelegateCheck" then {
    let r = do_check(cfg, ctx, call);
    { decision: Handled(r.result), next_state: r.next_state }
  }
  else { decision: Delegate, next_state: ctx.world }
}

export func make_hooks(cfg: HerdrConfig, tools: [string]) -> [Capability] ! {IO, Process, FS, Clock} {
  let handle = func(ctx: ExtCtx, call: ToolCallEnvelope)
    -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand} {
      on_tool_handle(cfg, ctx, call)
    };
  let describe = func(_u: ()) -> [ToolSchema] {
    match tools { [] => [], _ => describe_tools(cfg.allowed_kinds) }
  };
  -- Item 4 (6.0 trimming): only the atoms this extension binds with a real body.
  [
    DescribeTools(describe),
    -- EMPTY OUTSIDE A HERDR PANE. `register.ail` decides; this list only
    -- carries the decision, so the two can never disagree.
    ToolProvider(tools, handle)
  ]
}
