module sunholo/motoko_ext_empty_stop_guard/register

import pkg/sunholo/motoko_ext_abi/types (
  default_hooks,
  ExtCtx,
  ExtensionHooks,
  FinalizeOutcome
)
import pkg/sunholo/motoko_ext_empty_stop_guard/empty_stop_guard (decide)

func finalize(ctx: ExtCtx, candidate: string) -> FinalizeOutcome ! {Process} {
  { decision: decide(ctx, candidate), next_state: ctx.world }
}

export func register_with_config(_cfg: a) -> ExtensionHooks ! {Env, FS} {
  { default_hooks("empty_stop_guard") | on_solver_candidate: finalize }
}
