module sunholo/motoko_ext_empty_stop_guard/register

import std/option (None)
import pkg/sunholo/motoko_ext_abi/types (PreStepOutcome, ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome, 
  BudgetPlan,
  BudgetPatch,
  ExtCtx,
  ExtensionHooks,
  FinalizeDecision,
  Msg,
  PreStepDecision,
  ResponseInterceptDecision,
  ToolCallEnvelope,
  ToolHandleDecision,
  ToolPolicyDecision
)
import pkg/sunholo/motoko_ext_empty_stop_guard/empty_stop_guard (decide)

func no_budget_patch(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch {
  { requested_total: None, requested_solver: None, requested_verifier: None }
}

export func register_with_config(_cfg: a) -> ExtensionHooks ! {Env, FS} {
  {
    id: "empty_stop_guard",
    provided_tools: [],
    on_describe_tools: \_ . [],
    on_build_system_prompt: \_ctx. { prepend: [], append: [] },
    on_budget_plan: no_budget_patch,
    on_pre_step: func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Trace}  { { decision: { PassThrough }, next_state: ctx.world } },
    on_tool_policy: \_ctx _call. NoOpinion,
    on_tool_handle: func(ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand}  { { decision: { Delegate }, next_state: ctx.world } },
    on_response_intercept: func(ctx: ExtCtx, _r: string) -> ResponseInterceptOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream}  { { decision: { NoIntercept }, next_state: ctx.world } },
    on_solver_candidate: func(ctx: ExtCtx, candidate: string) -> FinalizeOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream}  { { decision: {
      decide(ctx, candidate)
    }, next_state: ctx.world } }
  }
}
