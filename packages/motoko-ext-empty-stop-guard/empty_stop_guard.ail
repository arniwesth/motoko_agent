module sunholo/motoko_ext_empty_stop_guard/empty_stop_guard

import std/string (trim, contains)
import std/json (Json, jo)
import std/result (Result, Err)
import pkg/sunholo/motoko_ext_abi/types (empty_ext_world, ExtWorld, ExtClockReading, ExtProcOutcome, ExtFileRead, ExtFileMutation, ExtPathStat, ExtDirListing, ExtPathKind, ExtPathMissing, AiStepOutcome, ExtCtx, ExtPorts, FinalizeDecision, ContinueWithFeedback, NoDecision, Msg, TokenTelemetry)

export pure func is_blank(s: string) -> bool {
  trim(s) == ""
}

export pure func guard_marker() -> string {
  "[motoko-empty-stop-guard]"
}

export pure func guard_message() -> string {
  "You returned an empty response but the task is not marked complete. Continue working on the task, or if you are genuinely finished, state your final answer or conclusion explicitly. ${guard_marker()}"
}

-- THE SAME SILENCE, TWO CAUSES, AND UNTIL ABI 7.2 THEY WERE INDISTINGUISHABLE.
-- A step that ends `finish_reason: "length"` with no text and no tool call did
-- not decline to answer: it was CUT OFF at the output-token cap, having spent
-- the whole budget reasoning. Measured on the PLAN-001 live run — five such
-- steps per stalled worker — where this guard told the model it "returned an
-- empty response", which is true, useless, and points at the wrong layer. The
-- model cannot act on it, and the operator reading the transcript concludes the
-- model went quiet.
--
-- The advice differs because the remedy differs: there is nothing to "continue"
-- into, only a next attempt that has to be SHORTER or has to lead with the
-- tool call.
export pure func truncated_message() -> string {
  "Your previous response was cut off at the output-token limit before it produced anything — the reasoning filled the entire budget. Do not simply retry: make the next response shorter, and if you intend to call a tool, emit the tool call FIRST, before any explanation. ${guard_marker()}"
}

-- `length` is the OpenAI-family name and the one Motoko's providers report.
-- Matched exactly rather than by prefix: an unknown reason is "no opinion"
-- (`ExtCtx.finish_reason`), and guessing from a substring would misread a
-- provider that invents `length_limit_not_reached`.
export pure func was_truncated(ctx: ExtCtx) -> bool {
  ctx.finish_reason == "length"
}

export pure func budget() -> int {
  2
}

export pure func count_markers(history: [Msg]) -> int {
  match history {
    [] => 0,
    m :: rest => {
      let here = if m.role == "user" && contains(m.content, guard_marker()) then 1 else 0;
      here + count_markers(rest)
    }
  }
}

-- The BUDGET IS SHARED between the two messages, deliberately: both are the
-- same marker, so a model that is truncated twice and then silent once has had
-- three nudges and gets no more. Counting them separately would double the
-- guard's budget for a model in the worst shape.
export pure func decide_with_budget(ctx: ExtCtx, candidate: string, max_feedback: int) -> FinalizeDecision {
  if is_blank(candidate) && count_markers(ctx.history_slice) < max_feedback
  then ContinueWithFeedback(if was_truncated(ctx) then truncated_message() else guard_message())
  else NoDecision
}

export pure func decide(ctx: ExtCtx, candidate: string) -> FinalizeDecision {
  decide_with_budget(ctx, candidate, budget())
}

func user(content: string) -> Msg {
  { role: "user", content: content, tool_calls: [], tool_call_id: "" }
}

func assistant(content: string) -> Msg {
  { role: "assistant", content: content, tool_calls: [], tool_call_id: "" }
}

func noop_ai_step(world: ExtWorld, _model: string, _msgs: [Msg]) -> AiStepOutcome ! {AI, IO, Trace} { { result: {
  Err("ext ai_step port unavailable")
}, next_state: world } }

-- WI-D16 widened `ExtPorts.tool_handle` to thread the world token. Returning
-- `world` unchanged is S12's IDENTITY TRANSITION and is the correct answer for
-- exactly `noop_clock_now`'s reason below: this port executes nothing, so there
-- is no cursor to advance. It would be a silent defect in a binding that DID
-- something, and no type tells the two apart.
--
-- WI-D21 RENAMED THE PARAMETERS. They read `_cmd, _cwd` here, and the seam
-- takes a MOTOKO TOOL NAME and that tool's JSON ARGUMENTS -- see the ABI row.
-- Both are `string`, so the wrong reading compiled; this binding ignores them
-- and was harmless, but it is a template, and a real implementation written
-- from a `(cmd, cwd)` signature would shell out the tool name in a directory
-- named by a JSON blob. That is why the rename reached bindings that use
-- neither argument.
--
-- `exit_code: -1` (WI-D23), NOT 0: a no-op executes nothing, and -1 is
-- exactly the "no subprocess ran" value the ABI row's domain names. Writing
-- 0 here would assert a success no process produced.
func noop_tool_handle(world: ExtWorld, _tool: string, _args_json: string) -> ExtProcOutcome ! {IO, Process, FS} {
  { output: "", exit_code: -1, next_state: world }
}

-- WI-D16's file read seam. `present: false` is the honest answer for a port
-- with no filesystem behind it, and it is NOT the same claim as `content: ""` —
-- see `ExtFileRead`'s comment. A no-op that reported `present: true` with empty
-- contents would tell a caller an empty file exists, which is the branch this
-- seam was shaped to keep distinguishable.
func noop_file_read(world: ExtWorld, _path: string) -> ExtFileRead ! {FS} {
  { present: false, content: "", next_state: world }
}

-- WI-D17's filesystem MUTATOR seams. `ok: false` is the honest answer for a port
-- with no filesystem behind it, and it is the same judgement `noop_file_read`
-- makes with `present: false`: reporting success for a write that did not happen
-- tells the caller a fact about the world that is not true. The world token is
-- returned unchanged, which is S12's identity transition and correct here —
-- nothing was written, so there is no successor to thread.
func noop_file_write(world: ExtWorld, _path: string, _content: string) -> ExtFileMutation ! {FS} {
  { ok: false, error: "no filesystem behind this port", next_state: world }
}

func noop_file_remove(world: ExtWorld, _path: string) -> ExtFileMutation ! {FS} {
  { ok: false, error: "no filesystem behind this port", next_state: world }
}

-- WI-D18's DIRECTORY seams. `ExtPathMissing` and `present: false` for
-- `noop_file_read`'s reason: this port has no filesystem behind it, and a no-op
-- claiming a path is a file would state something about the world that is not
-- true.
func noop_path_stat(world: ExtWorld, _path: string) -> ExtPathStat ! {FS} {
  { kind: ExtPathMissing, next_state: world }
}

func noop_dir_list(world: ExtWorld, _path: string) -> ExtDirListing ! {FS} {
  { present: false, entries: [], next_state: world }
}

func noop_dir_make(world: ExtWorld, _path: string) -> ExtFileMutation ! {FS} {
  { ok: false, error: "no filesystem behind this port", next_state: world }
}

-- WI-C5 widened `ExtPorts.clock_now` to thread the world token. Returning
-- `world` unchanged is S12's IDENTITY TRANSITION, and here it is the correct
-- answer rather than a silent defect: this clock reads nothing, so there is no
-- cursor to advance. The distinction matters because the same expression is a
-- real defect in a port that DID something — S12 exists because no type tells
-- the two apart.
func noop_clock_now(world: ExtWorld) -> ExtClockReading ! {Clock} {
  { now_ms: 0, next_state: world }
}

func noop_env_get(_key: string, fallback: string) -> string ! {Env} {
  fallback
}

func noop_ext_ports() -> ExtPorts {
  {
    ai_step: noop_ai_step,
    tool_handle: noop_tool_handle,
    file_read: noop_file_read,
    file_write: noop_file_write,
    file_remove: noop_file_remove,
    path_stat: noop_path_stat,
    dir_list: noop_dir_list,
    dir_make: noop_dir_make,
    clock_now: noop_clock_now,
    env_get: noop_env_get
  }
}

pure func empty_ext_artifacts() -> Json {
  jo([])
}

pure func zero_token_telemetry() -> TokenTelemetry {
  { last_input_tokens: 0, last_output_tokens: 0, last_estimated_input_tokens: 0 }
}

func test_ctx(history: [Msg]) -> ExtCtx { test_ctx_reason(history, "") }

func test_ctx_reason(history: [Msg], reason: string) -> ExtCtx {
  {
    task: "t",
    step: 0,
    model: "m",
    cwd: ".",
    hybrid_tools: false,
    budget: { total: 1, solver: 1, verifier: 0 },
    mode: "default",
    workdir: ".",
    env_server_url: "",
    budget_remaining: 1,
    history_slice: history,
    state_key: "k",
    finish_reason: reason,
    context_limit: 0,
    ports: noop_ext_ports(),
    artifacts: empty_ext_artifacts(),
    telemetry: zero_token_telemetry(), world: empty_ext_world()
  }
}

pure func test_blank_detection() -> bool
  tests [((), true)]
  {
    is_blank("") && is_blank(" \n\t ") && not is_blank("done")
  }

pure func test_marker_count_counts_only_user_messages() -> bool
  tests [((), true)]
  {
    count_markers([
      user("a ${guard_marker()}"),
      assistant("b ${guard_marker()}"),
      user("c")
    ]) == 1
  }

pure func test_decide_continues_under_budget() -> bool
  tests [((), true)]
  {
    match decide_with_budget(test_ctx([user("first ${guard_marker()}")]), " ", 2) {
      ContinueWithFeedback(msg) => contains(msg, guard_marker()),
      _ => false
    }
  }

pure func test_decide_stops_at_budget() -> bool
  tests [((), true)]
  {
    match decide_with_budget(test_ctx([
      user("first ${guard_marker()}"),
      user("second ${guard_marker()}")
    ]), "", 2) {
      NoDecision => true,
      _ => false
    }
  }

-- The differential the field exists for: same blank candidate, same history,
-- two different provider reasons, two different messages.
pure func test_truncation_and_silence_get_different_advice() -> bool
  tests [((), true)]
  {
    let truncated = match decide_with_budget(test_ctx_reason([], "length"), "", 2) {
      ContinueWithFeedback(m) => m,
      _ => ""
    };
    let silent = match decide_with_budget(test_ctx_reason([], "stop"), "", 2) {
      ContinueWithFeedback(m) => m,
      _ => ""
    };
    contains(truncated, "cut off at the output-token limit")
      && contains(silent, "returned an empty response")
      && truncated != silent
      -- both still carry the marker, so the shared budget still counts them
      && contains(truncated, guard_marker()) && contains(silent, guard_marker())
  }

-- An unknown or absent reason must fall through to the original message rather
-- than to the truncation advice, which would be a confident wrong diagnosis.
pure func test_unknown_reason_is_no_opinion() -> bool
  tests [((), true)]
  {
    not was_truncated(test_ctx_reason([], ""))
      && not was_truncated(test_ctx_reason([], "tool_calls"))
      && not was_truncated(test_ctx_reason([], "length_limit_not_reached"))
      && was_truncated(test_ctx_reason([], "length"))
  }

pure func test_decide_ignores_non_blank_candidate() -> bool
  tests [((), true)]
  {
    match decide_with_budget(test_ctx([]), "done", 2) {
      NoDecision => true,
      _ => false
    }
  }
