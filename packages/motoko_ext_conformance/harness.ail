module sunholo/motoko_ext_conformance/harness

import std/io (println)
import std/json (Json, jo, kv, js, encode)
import std/result (Result, Ok, Err)
import pkg/sunholo/motoko_ext_abi/types (
  BudgetPlan,
  ExtCtx,
  ExtPorts,
  ExtensionHooks,
  Msg,
  PreStepDecision,
  PassThrough,
  Compacted,
  TokenTelemetry,
  ToolCall
)
import pkg/sunholo/motoko_ext_conformance/invariants (
  conformance_abi_version,
  no_system_in_output,
  pairing_preserved,
  ids_preserved
)

export type ScenarioFailure = {
  failed_invariant: string,
  trace: [string]
}

export type Scenario = {
  id: string,
  run: (ExtensionHooks) -> Result[(), ScenarioFailure] ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream}
}

func noop_proc_exec(_cmd: string, _cwd: string) -> string ! {IO, Process, FS} {
  ""
}

func noop_clock_now() -> int ! {Clock} {
  0
}

func noop_env_get(_key: string, fallback: string) -> string ! {Env} {
  fallback
}

func canned_ai_step(_model: string, _msgs: [Msg]) -> Result[string, string] ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream} {
  Ok("CANNED SUMMARY")
}

func poison_ai_step(_model: string, _msgs: [Msg]) -> Result[string, string] ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream} {
  Ok("POISON")
}

export func canned_ports() -> ExtPorts {
  {
    ai_step: canned_ai_step,
    proc_exec: noop_proc_exec,
    clock_now: noop_clock_now,
    env_get: noop_env_get
  }
}

export func poison_ports() -> ExtPorts {
  {
    ai_step: poison_ai_step,
    proc_exec: noop_proc_exec,
    clock_now: noop_clock_now,
    env_get: noop_env_get
  }
}

export pure func empty_ext_artifacts() -> Json {
  jo([])
}

export pure func zero_token_telemetry() -> TokenTelemetry {
  { last_input_tokens: 0, last_output_tokens: 0, last_estimated_input_tokens: 0 }
}

func budget() -> BudgetPlan {
  { total: 100, solver: 60, verifier: 40 }
}

export func mk_conformance_ctx(segment: [Msg], artifacts: Json, ports: ExtPorts) -> ExtCtx {
  {
    task: "conformance",
    step: 1,
    model: "conformance-model",
    cwd: ".",
    hybrid_tools: false,
    budget: budget(),
    mode: "conformance",
    workdir: ".",
    env_server_url: "",
    budget_remaining: 100,
    history_slice: segment,
    state_key: "conformance",
    context_limit: 10,
    ports: ports,
    artifacts: artifacts,
    telemetry: zero_token_telemetry()
  }
}

func tool_call(id: string) -> ToolCall {
  { id: id, name: "inspect", arguments: "{\"id\":\"${id}\"}" }
}

func msg(role: string, content: string) -> Msg {
  { role: role, content: content, tool_calls: [], tool_call_id: "" }
}

func assistant_call(id: string) -> Msg {
  { role: "assistant", content: "calling ${id}", tool_calls: [tool_call(id)], tool_call_id: "" }
}

func tool_result(id: string) -> Msg {
  { role: "tool", content: long_tool_content(id), tool_calls: [], tool_call_id: id }
}

func long_tool_content(id: string) -> string {
  "tool ${id} result: long conformance fixture output that exceeds eighty characters and keeps going long enough that structural compaction can shorten it deterministically without changing ids"
}

export func compaction_segment() -> [Msg] {
  [
    msg("user", "opening request with context to summarize"),
    msg("assistant", "initial analysis before tool work"),
    msg("user", "second request with more prose"),
    msg("assistant", "second answer with details"),
    assistant_call("tc1"),
    tool_result("tc1"),
    assistant_call("tc2"),
    tool_result("tc2"),
    assistant_call("tc3"),
    tool_result("tc3"),
    assistant_call("tc4"),
    tool_result("tc4"),
    assistant_call("tc5"),
    tool_result("tc5"),
    assistant_call("tc6"),
    tool_result("tc6"),
    assistant_call("tc7"),
    tool_result("tc7"),
    assistant_call("tc8"),
    tool_result("tc8"),
    msg("user", "recent follow-up"),
    msg("assistant", "recent answer")
  ]
}

func same_tool_calls(a: [ToolCall], b: [ToolCall]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs =>
      match b {
        [] => false,
        y :: ys =>
          x.id == y.id
            && x.name == y.name
            && x.arguments == y.arguments
            && same_tool_calls(xs, ys)
      }
  }
}

export pure func same_msgs(a: [Msg], b: [Msg]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs =>
      match b {
        [] => false,
        y :: ys =>
          x.role == y.role
            && x.content == y.content
            && x.tool_call_id == y.tool_call_id
            && same_tool_calls(x.tool_calls, y.tool_calls)
            && same_msgs(xs, ys)
      }
  }
}

func decision_msgs(input: [Msg], d: PreStepDecision) -> [Msg] {
  match d {
    PassThrough => input,
    Compacted(msgs, _, _) => msgs
  }
}

func decision_artifacts(d: PreStepDecision) -> Json {
  match d {
    PassThrough => empty_ext_artifacts(),
    Compacted(_, _, artifacts) => artifacts
  }
}

export func compaction_occurred(hooks: ExtensionHooks) -> bool ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  let segment = compaction_segment();
  let ctx = mk_conformance_ctx(segment, empty_ext_artifacts(), canned_ports());
  match hooks.on_pre_step(ctx, segment) {
    Compacted(_, _, _) => true,
    PassThrough => false
  }
}

func trace_line(scenario: string, invariant_name: string, segment: [Msg], output: [Msg]) -> string {
  encode(jo([
    kv("scenario", js(scenario)),
    kv("invariant", js(invariant_name)),
    kv("segment", js(show(segment))),
    kv("output", js(show(output)))
  ]))
}

func failure(scenario: string, invariant_name: string, segment: [Msg], output: [Msg]) -> ScenarioFailure {
  { failed_invariant: invariant_name, trace: [trace_line(scenario, invariant_name, segment, output)] }
}

func ok_or_failure(ok: bool, scenario: string, invariant_name: string, segment: [Msg], output: [Msg]) -> Result[(), ScenarioFailure] {
  if ok then Ok(())
  else Err(failure(scenario, invariant_name, segment, output))
}

export func scenario_system_prefix_preserved() -> Scenario {
  {
    id: "conformance.compactor.system_prefix_preserved",
    run: func(hooks: ExtensionHooks) -> Result[(), ScenarioFailure] ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
      let segment = compaction_segment();
      let ctx = mk_conformance_ctx(segment, empty_ext_artifacts(), canned_ports());
      let out = decision_msgs(segment, hooks.on_pre_step(ctx, segment));
      ok_or_failure(no_system_in_output(out), "conformance.compactor.system_prefix_preserved", "no_system_in_output", segment, out)
    }
  }
}

export func scenario_tool_pairing_preserved() -> Scenario {
  {
    id: "conformance.compactor.tool_pairing_preserved",
    run: func(hooks: ExtensionHooks) -> Result[(), ScenarioFailure] ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
      let segment = compaction_segment();
      let ctx = mk_conformance_ctx(segment, empty_ext_artifacts(), canned_ports());
      let out = decision_msgs(segment, hooks.on_pre_step(ctx, segment));
      if not pairing_preserved(segment, out) then Err(failure("conformance.compactor.tool_pairing_preserved", "pairing_preserved", segment, out))
      else ok_or_failure(ids_preserved(segment, out), "conformance.compactor.tool_pairing_preserved", "ids_preserved", segment, out)
    }
  }
}

export func scenario_deterministic_replay() -> Scenario {
  {
    id: "conformance.compactor.deterministic_replay",
    run: func(hooks: ExtensionHooks) -> Result[(), ScenarioFailure] ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
      let segment = compaction_segment();
      let ctx1 = mk_conformance_ctx(segment, empty_ext_artifacts(), canned_ports());
      let ctx2 = mk_conformance_ctx(segment, empty_ext_artifacts(), canned_ports());
      let out1 = decision_msgs(segment, hooks.on_pre_step(ctx1, segment));
      let out2 = decision_msgs(segment, hooks.on_pre_step(ctx2, segment));
      ok_or_failure(same_msgs(out1, out2), "conformance.compactor.deterministic_replay", "deterministic_replay", segment, out2)
    }
  }
}

export func scenario_artifact_cache_effective() -> Scenario {
  {
    id: "conformance.compactor.artifact_cache_effective",
    run: func(hooks: ExtensionHooks) -> Result[(), ScenarioFailure] ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
      let segment = compaction_segment();
      let ctx1 = mk_conformance_ctx(segment, empty_ext_artifacts(), canned_ports());
      let d1 = hooks.on_pre_step(ctx1, segment);
      let out1 = decision_msgs(segment, d1);
      let ctx2 = mk_conformance_ctx(segment, decision_artifacts(d1), poison_ports());
      let out2 = decision_msgs(segment, hooks.on_pre_step(ctx2, segment));
      ok_or_failure(same_msgs(out1, out2), "conformance.compactor.artifact_cache_effective", "artifact_cache_effective", segment, out2)
    }
  }
}

export func all_scenarios() -> [Scenario] {
  [
    scenario_system_prefix_preserved(),
    scenario_tool_pairing_preserved(),
    scenario_deterministic_replay(),
    scenario_artifact_cache_effective()
  ]
}

func print_trace(lines: [string]) -> () ! {IO} {
  match lines {
    [] => (),
    line :: rest => {
      let _ = println("trace ${line}");
      print_trace(rest)
    }
  }
}

export func run_scenario(hooks: ExtensionHooks, s: Scenario) -> Result[(), ScenarioFailure] ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  s.run(hooks)
}

func run_all(hooks: ExtensionHooks, scenarios: [Scenario], failed: int) -> int ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  match scenarios {
    [] => failed,
    s :: rest => {
      match run_scenario(hooks, s) {
        Ok(_) => {
          let _ = println("scenario=${s.id} ok");
          run_all(hooks, rest, failed)
        },
        Err(f) => {
          let _ = println("scenario=${s.id} invariant=${f.failed_invariant}");
          let _ = print_trace(f.trace);
          run_all(hooks, rest, failed + 1)
        }
      }
    }
  }
}

export func run_conformance(hooks: ExtensionHooks) -> int ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  let _ = println("conformance kit ${conformance_abi_version()} ABI ${conformance_abi_version()} hooks=${hooks.id}");
  run_all(hooks, all_scenarios(), 0)
}
