module sunholo/motoko_ext_exa_search/exa_search

import std/option (Option, Some, None)

import pkg/sunholo/motoko_ext_abi/types (PreStepOutcome, ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome, 
  ExtCtx, ExtensionHooks, PromptPatch, BudgetPlan, BudgetPatch,
  ToolPolicyDecision, ToolHandleDecision, ResponseInterceptDecision, FinalizeDecision,
  PassThrough, PreStepDecision, Msg,
  ToolCallEnvelope
)
import pkg/sunholo/motoko_ext_mcp/types (McpServerConfig, McpToolMapping)
import pkg/sunholo/motoko_ext_mcp/exec (run_mcp_tool)
import pkg/sunholo/motoko_ext_mcp/resolve (resolve_tool, all_tool_names)
import pkg/sunholo/motoko_ext_exa_search/types (mcp_config, tool_mappings)
import pkg/sunholo/motoko_ext_exa_search/prompts (load_agent_prompt, build_prompt_patch)

func no_budget_patch() -> BudgetPatch {
  {
    requested_total: None,
    requested_solver: None,
    requested_verifier: None
  }
}

func budget_hook(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch {
  no_budget_patch()
}

func no_tool_policy(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolPolicyDecision {
  NoOpinion
}

func no_response_intercept() -> ResponseInterceptDecision {
  NoIntercept
}

func no_finalize_decision() -> FinalizeDecision {
  NoDecision
}

export func provided_tools() -> [string] {
  all_tool_names(tool_mappings())
}

export func on_build_system_prompt(cached_prompt: string, _ctx: ExtCtx) -> PromptPatch {
  build_prompt_patch(cached_prompt)
}

export func on_tool_handle(cfg: McpServerConfig, mappings: [McpToolMapping], ctx: ExtCtx, call: ToolCallEnvelope) -> ToolHandleOutcome ! {Process, FS, Rand}  { { decision: {
  match resolve_tool(call.tool, mappings) {
    Some(m) => match run_mcp_tool(call.id, m.canonical, ctx.workdir, cfg, m.mcp_name, call.arguments) {
      Some(result) => Handled(result),
      None => Delegate
    },
    None => Delegate
  }
}, next_state: ctx.world } }

export func make_hooks(workdir: string, timeout_ms: int, max_output_chars: int) -> ExtensionHooks ! {FS, Process, Rand} {
  let cfg = mcp_config(timeout_ms, max_output_chars);
  let mappings = tool_mappings();
  let cached_prompt = load_agent_prompt(workdir);
  let handle = func(ctx: ExtCtx, call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand}  { on_tool_handle(cfg, mappings, ctx, call) };
  let intercept = func(ctx: ExtCtx, _response_text: string) -> ResponseInterceptOutcome ! {IO, Process, FS, Clock}  { { decision: {
    no_response_intercept()
  }, next_state: ctx.world } };
  let finalize = func(ctx: ExtCtx, _candidate: string) -> FinalizeOutcome ! {Process}  { { decision: {
    no_finalize_decision()
  }, next_state: ctx.world } };
  {
    id: "exa_search",
    provided_tools: all_tool_names(mappings),
    on_describe_tools: \_ . [],
    on_build_system_prompt: \ctx. on_build_system_prompt(cached_prompt, ctx),
    on_budget_plan: budget_hook,
    on_pre_step: func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Trace}  { { decision: { PassThrough }, next_state: ctx.world } },
    on_tool_policy: no_tool_policy,
    on_tool_handle: handle,
    on_response_intercept: intercept,
    on_solver_candidate: finalize
  }
}

func list_len(xs: [string]) -> int {
  match xs {
    [] => 0,
    _ :: rest => 1 + list_len(rest)
  }
}

func first_or_empty(xs: [string]) -> string {
  match xs {
    [] => "",
    x :: _ => x
  }
}

func eq_string_list(a: [string], b: [string]) -> bool {
  match (a, b) {
    ([], []) => true,
    (x :: xs, y :: ys) => x == y && eq_string_list(xs, ys),
    _ => false
  }
}

func mappings_define_expected_canonicals() -> bool
  tests [((), true)]
  {
    let names = all_tool_names(tool_mappings());
    list_len(names) == 12
      && first_or_empty(names) == "ExaSearch"
      && eq_string_list(names, [
        "ExaSearch", "exa_search", "exa.search", "exa_search.search",
        "ExaFetch", "exa_fetch", "exa.fetch", "exa_search.fetch",
        "ExaCrawl", "exa_crawl", "exa.crawl", "exa_search.crawl"
      ])
  }

func alias_resolves_to_mcp_tool() -> bool
  tests [((), true)]
  {
    match resolve_tool("exa.fetch", tool_mappings()) {
      Some(m) => m.canonical == "ExaFetch" && m.mcp_name == "web_fetch_exa",
      None => false
    }
  }

func provided_tools_matches_resolver_flattening() -> bool
  tests [((), true)]
  {
    eq_string_list(provided_tools(), all_tool_names(tool_mappings()))
  }
