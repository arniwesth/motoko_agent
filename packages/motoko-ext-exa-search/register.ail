module sunholo/motoko_ext_exa_search/register

import std/env (getEnvOr)
import std/string (stringToInt)
import std/option (Some, None)
import pkg/sunholo/motoko_ext_abi/types (
  ExtRegistration, PromptShaper, ToolProvider,
  PureCtx, ProviderCtx, PromptPatch, ToolCallEnvelope, ToolHandleOutcome
)
import pkg/sunholo/motoko_ext_mcp/resolve (all_tool_names)
import pkg/sunholo/motoko_ext_exa_search/types (tool_mappings)
import pkg/sunholo/motoko_ext_exa_search/prompts (load_agent_prompt)
import pkg/sunholo/motoko_ext_exa_search/exa_search (
  on_build_system_prompt, on_tool_handle,
  exa_config, cached_prompt_of, mcp_config_of, default_timeout_ms, default_max_output_chars
)

func parse_int_or(s: string, fallback: int) -> int {
  match stringToInt(s) {
    Some(n) => n,
    None    => fallback
  }
}

func exa_prompt(ctx: PureCtx) -> PromptPatch {
  on_build_system_prompt(cached_prompt_of(ctx.ext_config), ctx)
}

-- The provider payload: named, in this module (a payload imported from another
-- module leaks its row into `register_with_config` on the pin), carrying the
-- slot's whole row. The tool mappings are a module constant, not configuration.
func exa_tool_handle(ctx: ProviderCtx, call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand, Trace} {
  on_tool_handle(mcp_config_of(ctx.ext_config), tool_mappings(), ctx, call)
}

-- ABI 8.0 (031 ADR-001 D2): `{ config, caps }`, every payload a named
-- top-level function bound directly.
export func register_with_config(_cfg: a) -> ExtRegistration ! {Env, FS} {
  let workdir          = getEnvOr("MOTOKO_WORKDIR", ".");
  let timeout_ms       = parse_int_or(getEnvOr("EXA_TIMEOUT_MS", "30000"), default_timeout_ms());
  let max_output_chars = parse_int_or(getEnvOr("EXA_MAX_OUTPUT_CHARS", "8000"), default_max_output_chars());
  -- Item 4 (6.0 trimming): only the atoms this extension binds with a real body.
  {
    config: exa_config(load_agent_prompt(workdir), timeout_ms, max_output_chars),
    caps: [
      PromptShaper(exa_prompt),
      ToolProvider(all_tool_names(tool_mappings()), exa_tool_handle)
    ]
  }
}
