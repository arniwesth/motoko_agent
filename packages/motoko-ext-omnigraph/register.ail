module sunholo/motoko_ext_omnigraph/register

import std/env (getEnvOr)
import std/extension (requireWorkdirFile)
import std/option (Option, None)
import std/result (Result, Ok, Err)
import pkg/sunholo/motoko_ext_abi/types (
  PureCtx, ProviderCtx,
  ExtRegistration,
  PromptShaper, ToolPolicy, ToolProvider,
  PromptPatch,
  ToolCallEnvelope, ToolHandleOutcome
)
import pkg/sunholo/motoko_ext_omnigraph/omnigraph (
  provided_tools, on_tool_policy, on_tool_handle, on_build_system_prompt
)
import pkg/sunholo/motoko_ext_omnigraph/prompts (load_agent_prompt, prompt_config, cached_prompt_of)

-- Self-disable check (M-EXT-PORTABILITY-GATE, v0.19.0): when the workdir
-- lacks omnigraph/omnigraph.yaml, the extension advertises an empty tools
-- list. Hosts won't dispatch unadvertised tools, so on_tool_handle is never
-- invoked and the extension cleanly skips itself instead of crashing.
func enabled_in(workdir: string) -> bool ! {FS} {
  match requireWorkdirFile(workdir, "omnigraph/omnigraph.yaml") {
    Ok(_) => true,
    Err(_) => false
  }
}

-- ABI 8.0 (031 ADR-001 D2): every payload a named top-level function bound
-- directly. The prompt read at registration reaches the shaper through
-- `ext_config` (the configuration channel), never by capture.
func omnigraph_prompt(ctx: PureCtx) -> PromptPatch {
  on_build_system_prompt(cached_prompt_of(ctx.ext_config), ctx)
}

-- `on_tool_handle` declares only `{Process}`; the slot's row is closed, so this
-- named wrapper carries the ToolProvider row (8.0: with `Trace`).
func omnigraph_tool_handle(ctx: ProviderCtx, call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand, Trace} {
  on_tool_handle(ctx, call)
}

-- register_with_config uses a type variable for cfg so this extension is
-- host-config-agnostic. workdir is read from MOTOKO_WORKDIR env var
-- (set by the host at startup), falling back to "." if unset. Only the
-- prompt's text is disclosed as `config`; the workdir value is not.
export func register_with_config(_cfg: a) -> ExtRegistration ! {Env, FS, Process, Rand} {
  let workdir = getEnvOr("MOTOKO_WORKDIR", ".");
  let active = enabled_in(workdir);
  let cached_prompt = load_agent_prompt(workdir);
  let tools = if active then provided_tools() else [];
  -- Item 4 (6.0 trimming): only the atoms this extension binds with a real body.
  {
    config: prompt_config(cached_prompt),
    caps: [
      PromptShaper(omnigraph_prompt),
      ToolPolicy(on_tool_policy),
      ToolProvider(tools, omnigraph_tool_handle)
    ]
  }
}
