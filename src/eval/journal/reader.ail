pure func ev_cons_hist(acc: [EvHistMsg], h: EvHistMsg) -> [EvHistMsg] { h :: acc }

-- SOURCE src/core/journal.ail L1352-1352 B57304-57389 sha256:cb95d5af4a3a77bf5116b2b5d021710660058ae16a7ee094b62fbcda02851e8e symbol=reverse_hist
pure func ev_reverse_hist(xs: [EvHistMsg]) -> [EvHistMsg] { List.foldl(ev_cons_hist, [], xs) }

-- SOURCE src/core/journal.ail L1354-1354 B57390-57480 sha256:801fd9217035c313a6bcc0f31199c2972b7c68d5e45464b3e57e880c2eb23db3 symbol=cons_entry
pure func ev_cons_entry(acc: [EvJournalEntry], e: EvJournalEntry) -> [EvJournalEntry] { e :: acc }

-- SOURCE src/core/journal.ail L1355-1355 B57480-57579 sha256:177f53dc93b34edc55b09a9c94dabda7e6e84e438af63e1d7ab49ae9339b91e4 symbol=reverse_entries
pure func ev_reverse_entries(xs: [EvJournalEntry]) -> [EvJournalEntry] { List.foldl(ev_cons_entry, [], xs) }

-- SOURCE src/core/journal.ail L1360-1362 B57736-57821 sha256:0e169666b6aabe8e03708105dc6f72cfb7ba48869e020f95b22f6f0348e4c3d2 symbol=hist_messages
pure func ev_hist_messages(xs: [EvHistMsg]) -> [Message] {
