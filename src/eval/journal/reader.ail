-- Copies: The entry decoders (journal).
-- ============================================================================

-- SOURCE src/core/journal.ail L661-668 B29916-30036 sha256:15de460256a067c53d0f1bcd1669800010f5fc3f82f79faae2336218410b33c1 symbol=JournalEntry
export type EvJournalEntry = {
  id: string,
  parent_id: string,
  seq: int,
  at_ms: int,
  kind: string,
  raw: Json
}

-- SOURCE src/core/journal.ail L670-672 B30037-30197 sha256:b6604f22593ab1d9fc687489565d38e73781481c8b2b06a8959b27b741920ca3 symbol=at_string
pure func ev_at_string(j: Json, key: string, seq: int) -> Result[string, EvRefusal] {
  match getString(j, key) { None => Err(EvEntry(seq, key)), Some(s) => Ok(s) }
}

-- SOURCE src/core/journal.ail L674-676 B30198-30349 sha256:b1340e729881fab49891578602b1a6d6afbd102015bbb7ed9ea3d48d3ebc0344 symbol=at_int
pure func ev_at_int(j: Json, key: string, seq: int) -> Result[int, EvRefusal] {
  match getInt(j, key) { None => Err(EvEntry(seq, key)), Some(n) => Ok(n) }
}

-- SOURCE src/core/journal.ail L678-680 B30350-30504 sha256:f9f6c30481807680e5234969bfe000312476e76d91611b9e490dd214f950507c symbol=at_bool
pure func ev_at_bool(j: Json, key: string, seq: int) -> Result[bool, EvRefusal] {
  match getBool(j, key) { None => Err(EvEntry(seq, key)), Some(b) => Ok(b) }
}

-- SOURCE src/core/journal.ail L682-684 B30505-30665 sha256:c15015faa1cc31eda08e9df832854422ed4f3b1da28c2649ebf718d44286e15e symbol=at_array
pure func ev_at_array(j: Json, key: string, seq: int) -> Result[[Json], EvRefusal] {
  match getArray(j, key) { None => Err(EvEntry(seq, key)), Some(xs) => Ok(xs) }
}

-- SOURCE src/core/journal.ail L686-691 B30666-30891 sha256:ccda026c38da705df4975d2fc3e467f3fdcaac4a51031c8dbe4687d7dbc64b02 symbol=at_object
pure func ev_at_object(j: Json, key: string, seq: int) -> Result[Json, EvRefusal] {
  match get(j, key) {
    None => Err(EvEntry(seq, key)),
    Some(v) => match asObject(v) { None => Err(EvEntry(seq, key)), Some(_) => Ok(v) }
  }
}

-- SOURCE src/core/journal.ail L696-699 B31125-31331 sha256:4ffe9f948889c61ea759b148dbbb2485655fa2ceff1279e423d693a4e2d24271 symbol=opt_int
pure func ev_opt_int(j: Json, key: string, seq: int) -> Result[Option[int], EvRefusal] {
  if not has(j, key) then Ok(None)
  else match getInt(j, key) { None => Err(EvEntry(seq, key)), Some(n) => Ok(Some(n)) }
}

-- SOURCE src/core/journal.ail L701-703 B31332-31441 sha256:83da5658f85fe24bccbdca4ac2ad243fde98df06de9577094bc03d220249af99 symbol=opt_json
pure func ev_opt_json(j: Json, key: string) -> Option[Json] {
  if not has(j, key) then None else get(j, key)
}

-- SOURCE src/core/journal.ail L705-708 B31442-31657 sha256:6735028f937d82bfffb9ff3e23a59a9cdde418a18a8a922204786f75048c2b56 symbol=opt_string
pure func ev_opt_string(j: Json, key: string, seq: int) -> Result[Option[string], EvRefusal] {
  if not has(j, key) then Ok(None)
  else match getString(j, key) { None => Err(EvEntry(seq, key)), Some(s) => Ok(Some(s)) }
}

-- SOURCE src/core/journal.ail L714-734 B31905-32575 sha256:c3c1d59af93bb2f6ee62495bac03103046e4690bcf4bd72e85dade9674c6e444 symbol=journal_entry_of_json
pure func ev_journal_entry_of_json(j: Json) -> Result[EvJournalEntry, EvRefusal] {
  match ev_at_int(j, "seq", -1) {
    Err(e) => Err(e),
    Ok(seq) => match ev_at_string(j, "id", seq) {
      Err(e) => Err(e),
      Ok(id) => match ev_at_int(j, "at_ms", seq) {
        Err(e) => Err(e),
        Ok(at_ms) => match ev_at_string(j, "type", seq) {
          Err(e) => Err(e),
          Ok(kind) => {
            let parent = match getString(j, "parent_id") { None => "", Some(p) => p };
            let e: EvJournalEntry = {
              id: id, parent_id: parent, seq: seq, at_ms: at_ms, kind: kind, raw: j
            };
            Ok(e)
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L737-746 B32620-32827 sha256:b2a5795200e1e0684542a9ce9a704dc3c42f43bee157614532e4258dab232723 symbol=HeaderEntry
export type EvHeaderEntry = {
  schema_version: int,
  session_id: string,
  workdir: string,
  profile: string,
  ext_set_digest: string,
  model: string,
  system_prefix_digest: string,
  boot: EvBootInputs
}

-- SOURCE src/core/journal.ail L748-807 B32828-35845 sha256:16c9a877b02dfc1cad717145f18f95b6532fa5ccd8ca5f885a4c5b569f49e437 symbol=boot_of_json
pure func ev_boot_of_json(j: Json, seq: int) -> Result[EvBootInputs, EvRefusal] {
  match ev_at_object(j, "boot", seq) {
    Err(e) => Err(e),
    Ok(b) => match ev_at_string(b, "task", seq) {
      Err(_) => Err(EvEntry(seq, "boot.task")),
      Ok(task) => match ev_at_string(b, "env_url", seq) {
        Err(_) => Err(EvEntry(seq, "boot.env_url")),
        Ok(env_url) => match ev_at_bool(b, "hybrid_tools", seq) {
          Err(_) => Err(EvEntry(seq, "boot.hybrid_tools")),
          Ok(hybrid) => match ev_at_object(b, "budget", seq) {
            Err(_) => Err(EvEntry(seq, "boot.budget")),
            Ok(bp) => match ev_at_int(bp, "total", seq) {
              Err(_) => Err(EvEntry(seq, "boot.budget.total")),
              Ok(total) => match ev_at_int(bp, "solver", seq) {
                Err(_) => Err(EvEntry(seq, "boot.budget.solver")),
                Ok(solver) => match ev_at_int(bp, "verifier", seq) {
                  Err(_) => Err(EvEntry(seq, "boot.budget.verifier")),
                  Ok(verifier) => match ev_at_int(b, "step_budget", seq) {
                    Err(_) => Err(EvEntry(seq, "boot.step_budget")),
                    Ok(step_budget) => match ev_at_bool(b, "ohmy_pi", seq) {
                      Err(_) => Err(EvEntry(seq, "boot.ohmy_pi")),
                      Ok(ohmy) => match ev_at_int(b, "max_cost_millicents", seq) {
                        Err(_) => Err(EvEntry(seq, "boot.max_cost_millicents")),
                        Ok(max_cost) => match ev_at_object(b, "cost_rates", seq) {
                          Err(_) => Err(EvEntry(seq, "boot.cost_rates")),
                          Ok(cr) => match ev_at_int(cr, "input_per_1m_millicents", seq) {
                            Err(_) => Err(EvEntry(seq, "boot.cost_rates.input_per_1m_millicents")),
                            Ok(in_rate) => match ev_at_int(cr, "output_per_1m_millicents", seq) {
                              Err(_) => Err(EvEntry(seq, "boot.cost_rates.output_per_1m_millicents")),
                              Ok(out_rate) => {
                                let boot: EvBootInputs = {
                                  task: task,
                                  env_url: env_url,
                                  hybrid_tools: hybrid,
                                  budget: { total: total, solver: solver, verifier: verifier },
                                  step_budget: step_budget,
                                  ohmy_pi: ohmy,
                                  max_cost_millicents: max_cost,
                                  cost_rates: {
                                    input_per_1m_millicents: in_rate,
                                    output_per_1m_millicents: out_rate
                                  }
                                };
                                Ok(boot)
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L813-854 B36133-37734 sha256:38b787dda6d5c01e77fd9722480f75927a6a77289a4e08352042495048bf63de symbol=header_of_entry
pure func ev_header_of_entry(e: EvJournalEntry) -> Result[EvHeaderEntry, EvRefusal] {
  if e.kind != "header" then Err(EvHeader)
  else match ev_at_int(e.raw, "schema_version", e.seq) {
    Err(err) => Err(err),
    Ok(v) =>
      if v != 1 then Err(EvSchema)
      else match ev_at_string(e.raw, "session_id", e.seq) {
        Err(err) => Err(err),
        Ok(session_id) => match ev_at_string(e.raw, "workdir", e.seq) {
          Err(err) => Err(err),
          Ok(workdir) => match ev_at_string(e.raw, "profile", e.seq) {
            Err(err) => Err(err),
            Ok(profile) => match ev_at_string(e.raw, "ext_set_digest", e.seq) {
              Err(err) => Err(err),
              Ok(ext_set) => match ev_at_string(e.raw, "model", e.seq) {
                Err(err) => Err(err),
                Ok(model) => match ev_at_string(e.raw, "system_prefix_digest", e.seq) {
                  Err(err) => Err(err),
                  Ok(sysd) => match ev_boot_of_json(e.raw, e.seq) {
                    Err(err) => Err(err),
                    Ok(boot) => {
                      let h: EvHeaderEntry = {
                        schema_version: v,
                        session_id: session_id,
                        workdir: workdir,
                        profile: profile,
                        ext_set_digest: ext_set,
                        model: model,
                        system_prefix_digest: sysd,
                        boot: boot
                      };
                      Ok(h)
                    }
                  }
                }
              }
            }
          }
        }
      }
  }
}

-- SOURCE src/core/journal.ail L856-862 B37735-37868 sha256:6707fa5052fe7f67a36372f0c7f10538af4e1ad471df3287dbd7acaab39e8836 symbol=AppendedEntry
export type EvAppendedEntry = {
  run_id: string,
  step: int,
  message: Message,
  replaces_previous: bool,
  digest_after: string
}

-- SOURCE src/core/journal.ail L864-890 B37869-38819 sha256:18ab8607be2377799d6a568afe19a3bb4a663e9966c805138c0bcebd735deff4 symbol=appended_of_entry
pure func ev_appended_of_entry(e: EvJournalEntry) -> Result[EvAppendedEntry, EvRefusal] {
  match ev_at_string(e.raw, "run_id", e.seq) {
    Err(err) => Err(err),
    Ok(run_id) => match ev_at_int(e.raw, "step", e.seq) {
      Err(err) => Err(err),
      Ok(step) => match ev_at_object(e.raw, "message", e.seq) {
        Err(err) => Err(err),
        Ok(mj) => match ev_message_of_json_at(mj, "message") {
          Err(detail) => Err(EvEntry(e.seq, detail)),
          Ok(m) => match ev_at_bool(e.raw, "replaces_previous", e.seq) {
            Err(err) => Err(err),
            Ok(rep) => match ev_at_string(e.raw, "digest_after", e.seq) {
              Err(err) => Err(err),
              Ok(d) => {
                let a: EvAppendedEntry = {
                  run_id: run_id, step: step, message: m,
                  replaces_previous: rep, digest_after: d
                };
                Ok(a)
              }
            }
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L892-899 B38820-38974 sha256:efb0a214d75de2374eeccfa562479b4bde9356a6392318336495b3ed5bbc4708 symbol=ReplacedEntry
export type EvReplacedEntry = {
  run_id: string,
  step: int,
  reason: string,
  first_kept: Option[int],
  messages: [Message],
  digest_after: string
}

-- SOURCE src/core/journal.ail L901-930 B38975-40087 sha256:90a53ebe0a9237773f46324f576e7a32a22fb62f46d0aa15b0521b66d8a985db symbol=replaced_of_entry
pure func ev_replaced_of_entry(e: EvJournalEntry) -> Result[EvReplacedEntry, EvRefusal] {
  match ev_at_string(e.raw, "run_id", e.seq) {
    Err(err) => Err(err),
    Ok(run_id) => match ev_at_int(e.raw, "step", e.seq) {
      Err(err) => Err(err),
      Ok(step) => match ev_at_string(e.raw, "reason", e.seq) {
        Err(err) => Err(err),
        Ok(reason) => match ev_opt_int(e.raw, "first_kept", e.seq) {
          Err(err) => Err(err),
          Ok(first_kept) => match ev_at_array(e.raw, "messages", e.seq) {
            Err(err) => Err(err),
            Ok(_) => match ev_messages_of_json(ev_getOr_messages(e.raw)) {
              Err(detail) => Err(EvEntry(e.seq, detail)),
              Ok(ms) => match ev_at_string(e.raw, "digest_after", e.seq) {
                Err(err) => Err(err),
                Ok(d) => {
                  let r: EvReplacedEntry = {
                    run_id: run_id, step: step, reason: reason,
                    first_kept: first_kept, messages: ms, digest_after: d
                  };
                  Ok(r)
                }
              }
            }
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L932-934 B40088-40194 sha256:7c06b205b3d6c00293c0e3f2b95df0c1506262edef9533176e82b53749301332 symbol=getOr_messages
pure func ev_getOr_messages(j: Json) -> Json {
  match get(j, "messages") { None => ja([]), Some(v) => v }
}

-- SOURCE src/core/journal.ail L936-943 B40195-40386 sha256:f50f0ec3259e8c792a6f231e407a2e07a23d18059a3b4ffa8606b091726e09a4 symbol=StateDeltaEntry
export type EvStateDeltaEntry = {
  run_id: string,
  step: int,
  cumulative: EvRuntimeStatusCounts,
  telemetry: TokenTelemetry,
  ext_artifacts_digest: string,
  ext_artifacts: Option[Json]
}

-- SOURCE src/core/journal.ail L945-974 B40387-41684 sha256:93ceb68c0a9c90f8a011b3fc661d6208fb2a7b8fe9ffbc838a21108025b0a936 symbol=counts_of_json
pure func ev_counts_of_json(j: Json, key: string, seq: int) -> Result[EvRuntimeStatusCounts, EvRefusal] {
  match ev_at_object(j, key, seq) {
    Err(e) => Err(e),
    Ok(c) => match ev_at_int(c, "provider_calls_started", seq) {
      Err(_) => Err(EvEntry(seq, "${key}.provider_calls_started")),
      Ok(started) => match ev_at_int(c, "provider_calls_completed", seq) {
        Err(_) => Err(EvEntry(seq, "${key}.provider_calls_completed")),
        Ok(completed) => match ev_at_int(c, "stage_applied_total", seq) {
          Err(_) => Err(EvEntry(seq, "${key}.stage_applied_total")),
          Ok(applied) => match ev_at_int(c, "stage_rejected_total", seq) {
            Err(_) => Err(EvEntry(seq, "${key}.stage_rejected_total")),
            Ok(rejected) => match ev_at_int(c, "compaction_ai_applied", seq) {
              Err(_) => Err(EvEntry(seq, "${key}.compaction_ai_applied")),
              Ok(ai) => {
                let counts: EvRuntimeStatusCounts = {
                  provider_calls_started: started,
                  provider_calls_completed: completed,
                  stage_applied_total: applied,
                  stage_rejected_total: rejected,
                  compaction_ai_applied: ai
                };
                Ok(counts)
              }
            }
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L976-997 B41685-42487 sha256:1cd6d57da9d2a15e506d024712bcf3f942cc1cd0f8ba95d1b8af74dce614a3eb symbol=telemetry_of_json
pure func ev_telemetry_of_json(j: Json, key: string, seq: int) -> Result[TokenTelemetry, EvRefusal] {
  match ev_at_object(j, key, seq) {
    Err(e) => Err(e),
    Ok(t) => match ev_at_int(t, "last_input_tokens", seq) {
      Err(_) => Err(EvEntry(seq, "${key}.last_input_tokens")),
      Ok(li) => match ev_at_int(t, "last_output_tokens", seq) {
        Err(_) => Err(EvEntry(seq, "${key}.last_output_tokens")),
        Ok(lo) => match ev_at_int(t, "last_estimated_input_tokens", seq) {
          Err(_) => Err(EvEntry(seq, "${key}.last_estimated_input_tokens")),
          Ok(le) => {
            let tel: TokenTelemetry = {
              last_input_tokens: li,
              last_output_tokens: lo,
              last_estimated_input_tokens: le
            };
            Ok(tel)
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L999-1022 B42488-43381 sha256:dd4d9c821c7a21ce600f5b0fca363b662929264f30cd0f53f0af04cd4eb95b59 symbol=state_delta_of_entry
pure func ev_state_delta_of_entry(e: EvJournalEntry) -> Result[EvStateDeltaEntry, EvRefusal] {
  match ev_at_string(e.raw, "run_id", e.seq) {
    Err(err) => Err(err),
    Ok(run_id) => match ev_at_int(e.raw, "step", e.seq) {
      Err(err) => Err(err),
      Ok(step) => match ev_counts_of_json(e.raw, "cumulative", e.seq) {
        Err(err) => Err(err),
        Ok(counts) => match ev_telemetry_of_json(e.raw, "telemetry", e.seq) {
          Err(err) => Err(err),
          Ok(tel) => match ev_at_string(e.raw, "ext_artifacts_digest", e.seq) {
            Err(err) => Err(err),
            Ok(dig) => {
              let d: EvStateDeltaEntry = {
                run_id: run_id, step: step, cumulative: counts, telemetry: tel,
                ext_artifacts_digest: dig, ext_artifacts: ev_opt_json(e.raw, "ext_artifacts")
              };
              Ok(d)
            }
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1024-1024 B43382-43431 sha256:cd4d058c889fc7a0ff160658f89cda9b97c0ff8b33fcb09c1872d308327bc1c9 symbol=RunStartedEntry
export type EvRunStartedEntry = { run_id: string }

-- SOURCE src/core/journal.ail L1026-1031 B43432-43674 sha256:20294a659afcf5e016cb8d21aa31cbc7e0673609659f357977444447aab444ba symbol=run_started_of_entry
pure func ev_run_started_of_entry(e: EvJournalEntry) -> Result[EvRunStartedEntry, EvRefusal] {
  match ev_at_string(e.raw, "run_id", e.seq) {
    Err(err) => Err(err),
    Ok(run_id) => { let r: EvRunStartedEntry = { run_id: run_id }; Ok(r) }
  }
}

-- SOURCE src/core/journal.ail L1036-1041 B43879-44013 sha256:03a070b76a8475e28a458104c75a80c9a10f3de758a38833c8b9be98c6af95fb symbol=RunFinishedEntry
export type EvRunFinishedEntry = {
  run_id: string,
  cumulative: EvRuntimeStatusCounts,
  world_ordinal: int,
  finish_reason: string
}

-- SOURCE src/core/journal.ail L1043-1062 B44014-44705 sha256:5140d67a5f5137159644a465e4789d0947911e5fdd003385a9836987ee1c4517 symbol=run_finished_of_entry
pure func ev_run_finished_of_entry(e: EvJournalEntry) -> Result[EvRunFinishedEntry, EvRefusal] {
  match ev_at_string(e.raw, "run_id", e.seq) {
    Err(err) => Err(err),
    Ok(run_id) => match ev_counts_of_json(e.raw, "cumulative", e.seq) {
      Err(err) => Err(err),
      Ok(counts) => match ev_at_int(e.raw, "world_ordinal", e.seq) {
        Err(err) => Err(err),
        Ok(ord) => match ev_at_string(e.raw, "finish_reason", e.seq) {
          Err(err) => Err(err),
          Ok(reason) => {
            let r: EvRunFinishedEntry = {
              run_id: run_id, cumulative: counts, world_ordinal: ord, finish_reason: reason
            };
            Ok(r)
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1068-1068 B44982-45061 sha256:7694d1c52c28c34e0d3ebd17858db781db119e53dfa09f739cbc92271400d4d6 symbol=SettingsEntry
export type EvSettingsEntry = { model: Option[string], profile: Option[string] }

-- SOURCE src/core/journal.ail L1070-1078 B45062-45411 sha256:40aafe0f3445f23e5b378d586c32ea4e0ef665d44427a90e614536ce2cca8036 symbol=settings_of_entry
pure func ev_settings_of_entry(e: EvJournalEntry) -> Result[EvSettingsEntry, EvRefusal] {
  match ev_opt_string(e.raw, "model", e.seq) {
    Err(err) => Err(err),
    Ok(model) => match ev_opt_string(e.raw, "profile", e.seq) {
      Err(err) => Err(err),
      Ok(profile) => { let s: EvSettingsEntry = { model: model, profile: profile }; Ok(s) }
    }
  }
}

-- SOURCE src/core/journal.ail L1080-1080 B45412-45487 sha256:e5a193af6b0b0b6accee240273e40fdc29e798212fc4fb39d857e559abe5e214 symbol=SuspendedEntry
export type EvSuspendedEntry = { run_id: string, reason: string, step: int }

-- SOURCE src/core/journal.ail L1082-1096 B45488-45973 sha256:92a11ce80512fc32902014083032c188370cb487b43df59bd36ee32df036e313 symbol=suspended_of_entry
pure func ev_suspended_of_entry(e: EvJournalEntry) -> Result[EvSuspendedEntry, EvRefusal] {
  match ev_at_string(e.raw, "run_id", e.seq) {
    Err(err) => Err(err),
    Ok(run_id) => match ev_at_string(e.raw, "reason", e.seq) {
      Err(err) => Err(err),
      Ok(reason) => match ev_at_int(e.raw, "step", e.seq) {
        Err(err) => Err(err),
        Ok(step) => {
          let s: EvSuspendedEntry = { run_id: run_id, reason: reason, step: step };
          Ok(s)
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1098-1107 B45974-46185 sha256:83d204f98ec2b92c2a1cb11923701b997123e264af08b0133b1f8b31fbcc143e symbol=ResumedEntry
export type EvResumedEntry = {
  resume_count: int,
  from_id: string,
  from_ordinal: int,
  profile_from: string,
  profile_to: string,
  prompt_digest_from: string,
  prompt_digest_to: string,
  forced: bool
}

-- SOURCE src/core/journal.ail L1109-1142 B46186-47520 sha256:218052cc7a4f17f4b05f5f8627ddd44583fcc982ff5d2c738c8d17f9893a7273 symbol=resumed_of_entry
pure func ev_resumed_of_entry(e: EvJournalEntry) -> Result[EvResumedEntry, EvRefusal] {
  match ev_at_int(e.raw, "resume_count", e.seq) {
    Err(err) => Err(err),
    Ok(rc) => match ev_at_string(e.raw, "from_id", e.seq) {
      Err(err) => Err(err),
      Ok(from_id) => match ev_at_int(e.raw, "from_ordinal", e.seq) {
        Err(err) => Err(err),
        Ok(from_ord) => match ev_at_string(e.raw, "profile_from", e.seq) {
          Err(err) => Err(err),
          Ok(pf) => match ev_at_string(e.raw, "profile_to", e.seq) {
            Err(err) => Err(err),
            Ok(pt) => match ev_at_string(e.raw, "prompt_digest_from", e.seq) {
              Err(err) => Err(err),
              Ok(df) => match ev_at_string(e.raw, "prompt_digest_to", e.seq) {
                Err(err) => Err(err),
                Ok(dt) => match ev_at_bool(e.raw, "forced", e.seq) {
                  Err(err) => Err(err),
                  Ok(forced) => {
                    let r: EvResumedEntry = {
                      resume_count: rc, from_id: from_id, from_ordinal: from_ord,
                      profile_from: pf, profile_to: pt,
                      prompt_digest_from: df, prompt_digest_to: dt, forced: forced
                    };
                    Ok(r)
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1144-1144 B47521-47594 sha256:c87b046ec2861b96332316b418894ddab5b24981b220e295340d44181d198456 symbol=ExitEntry
export type EvExitEntry = { reason: string, pending_tool_calls: [string] }

-- SOURCE src/core/journal.ail L1147-1158 B47744-48079 sha256:86ae1add3705d53d853a1aa185e56f7df78238cd29165d25eb5470d125a33513 symbol=strings_of_json
@allow_empty_ok("an `exit` entry with no pending tool calls is the ordinary case — a clean exit strips nothing, and `[]` is its correct decoding")
pure func ev_strings_of_json(xs: [Json], seq: int, field: string) -> Result[[string], EvRefusal] {
  match xs {
    [] => Ok([]),
    j :: rest => match asString(j) {
      None => Err(EvEntry(seq, field)),
      Some(s) => match ev_strings_of_json(rest, seq, field) {
        Err(e) => Err(e),
        Ok(ss) => Ok(s :: ss)
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1160-1171 B48080-48545 sha256:4253c16d7a7cb59408cbe7eaf2eb1edf98714973c2d9629fcede6613e3a8477f symbol=exit_of_entry
pure func ev_exit_of_entry(e: EvJournalEntry) -> Result[EvExitEntry, EvRefusal] {
  match ev_at_string(e.raw, "reason", e.seq) {
    Err(err) => Err(err),
    Ok(reason) => match ev_at_array(e.raw, "pending_tool_calls", e.seq) {
      Err(err) => Err(err),
      Ok(xs) => match ev_strings_of_json(xs, e.seq, "pending_tool_calls") {
        Err(err) => Err(err),
        Ok(ids) => { let x: EvExitEntry = { reason: reason, pending_tool_calls: ids }; Ok(x) }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1179-1179 B49022-49105 sha256:4b38e91354542fec0225cc6eca838c6d4f96ed4a7b8be03c873d0cbbb94cf12d symbol=ParkEntry
export type EvParkEntry = { request_id: string, step: int, waits: [EvWaitDescriptor] }

-- SOURCE src/core/journal.ail L1180-1180 B49105-49202 sha256:16e58fcbe42e17df20c9cb4496a7dcf77de061ca25f566a0c0cd9f77ac021997 symbol=WakeEntry
export type EvWakeEntry = { request_id: string, wait_id: string, outcome: string, detail: string }

-- SOURCE src/core/journal.ail L1187-1189 B49596-49727 sha256:f058bc5c58c28f7b1cff03cfa80712ae49e494da52c46466d36d063dd0199cc7 symbol=all_wake_outcomes
pure func ev_all_wake_outcomes() -> [string] {
  ["settled", "lost", "operator_input", "timed_out", "host_error", "aborted"]
}

-- SOURCE src/core/journal.ail L1195-1206 B50150-50486 sha256:b7042306086e58f56c26194c4050d52b546aeec6d70674151392a263bee1e2c7 symbol=waits_of_json
@allow_empty_ok("the recursion's base case only — a park with no waits is refused at `waits` by `park_of_entry` before the list is walked, so `[]` here is the end of a non-empty list")
pure func ev_waits_of_json(xs: [Json], seq: int) -> Result[[EvWaitDescriptor], EvRefusal] {
  match xs {
    [] => Ok([]),
    j :: rest => match ev_wait_descriptor_from_json(j) {
      Err(_) => Err(EvEntry(seq, "waits")),
      Ok(w) => match ev_waits_of_json(rest, seq) {
        Err(e) => Err(e),
        Ok(ws) => Ok(w :: ws)
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1211-1227 B50718-51353 sha256:50b9fc3ab232b96f47e8c7186ff602c4c153a27cafdac02e754b6a3dc3fffe02 symbol=park_of_entry
pure func ev_park_of_entry(e: EvJournalEntry) -> Result[EvParkEntry, EvRefusal] {
  match ev_at_string(e.raw, "request_id", e.seq) {
    Err(err) => Err(err),
    Ok(request_id) => match ev_at_int(e.raw, "step", e.seq) {
      Err(err) => Err(err),
      Ok(step) => match ev_at_array(e.raw, "waits", e.seq) {
        Err(err) => Err(err),
        Ok(xs) =>
          if List.length(xs) == 0 then Err(EvEntry(e.seq, "waits"))
          else match ev_waits_of_json(xs, e.seq) {
            Err(err) => Err(err),
            Ok(waits) => { let p: EvParkEntry = { request_id: request_id, step: step, waits: waits }; Ok(p) }
          }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1229-1248 B51354-52105 sha256:7b9a5e7e1d0e648b38ccb2aa8632a81e14fb0d7490b7869666609438f62683e0 symbol=wake_of_entry
pure func ev_wake_of_entry(e: EvJournalEntry) -> Result[EvWakeEntry, EvRefusal] {
  match ev_at_string(e.raw, "request_id", e.seq) {
    Err(err) => Err(err),
    Ok(request_id) => match ev_at_string(e.raw, "wait_id", e.seq) {
      Err(err) => Err(err),
      Ok(wid) => match ev_at_string(e.raw, "outcome", e.seq) {
        Err(err) => Err(err),
        Ok(outcome) =>
          if not ev_contains_string(ev_all_wake_outcomes(), outcome) then Err(EvEntry(e.seq, "outcome"))
          else match ev_at_string(e.raw, "detail", e.seq) {
            Err(err) => Err(err),
            Ok(detail) => {
              let w: EvWakeEntry = { request_id: request_id, wait_id: wid, outcome: outcome, detail: detail };
              Ok(w)
            }
          }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1253-1257 B52344-52560 sha256:1a53efabf95d904737514ef8d85c7061e00ad84e5d2a951fa4640ba9f5fd5869 symbol=all_entry_types
pure func ev_all_entry_types() -> [string] {
  ["header", "history_appended", "history_replaced", "state_delta",
   "run_started", "run_finished", "settings", "suspended", "resumed", "exit",
   "park", "wake"]
}


-- ============================================================================
-- Copies: The fold (journal, D4).
-- ============================================================================

-- SOURCE src/core/journal.ail L1311-1316 B55890-56082 sha256:8e180655d81106108cdb9627f2d03eb1c721442153d261c1db2002f6f183e7e5 symbol=Boundary
export type EvBoundary
  = EvBoundaryRunFinished(string, int)
  | EvBoundarySuspended(string, int)
  | EvBoundaryExit(string)
  | EvBoundaryOpen(string)
  | EvBoundaryParked(EvParkEntry, Option[EvWakeEntry])

-- SOURCE src/core/journal.ail L1318-1326 B56083-56358 sha256:8d1da36e8e96b576023e92b99563200436ceb39669bcf201a080e14212e899e6 symbol=boundary_id
pure func ev_boundary_id(b: EvBoundary) -> string {
  match b {
    EvBoundaryRunFinished(_, _) => "run_finished",
    EvBoundarySuspended(_, _) => "suspended",
    EvBoundaryExit(_) => "exit",
    EvBoundaryOpen(kind) => "open:${kind}",
    EvBoundaryParked(_, _) => "parked"
  }
}

-- SOURCE src/core/journal.ail L1328-1344 B56359-56953 sha256:27473752993c2b1082efce2f520319faa074b0996866da911e5c74e8e95d6f81 symbol=SessionState
export type EvSessionState = {
  header: EvHeaderEntry,
  history: [Message],
  dangling: [string],
  cumulative: EvRuntimeStatusCounts,
  telemetry: TokenTelemetry,
  ext_artifacts: Json,
  model: string,
  profile: string,
  last: EvBoundary,
  -- The last `run_finished.world_ordinal` on the path: D5's `from_ordinal`, which
  -- is the previous frame's `final` itself (`RunSummary.world_ordinal`, P3ORD),
  -- and carried here rather than read
  -- off `last` because the last BOUNDARY is usually not a `run_finished` — a
  -- restart ends in `exit`, a crash ends mid-run.
  world_ordinal: int
}

-- SOURCE src/core/journal.ail L1349-1349 B57189-57229 sha256:c0985ef27661355b6df95b457579266cc3d6d0954349fb6b798ae3aa8a0aa3d2 symbol=HistMsg
type EvHistMsg = { seq: int, m: Message }

