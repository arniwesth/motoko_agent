-- SOURCE src/core/journal.ail L1364-1364 B57822-57876 sha256:250d1cae32ab38b44635d82b13ade18eea54065f9d25aeb7e1243536d088d148 symbol=hist_message
pure func ev_hist_message(h: EvHistMsg) -> Message { h.m }

-- SOURCE src/core/journal.ail L1366-1368 B57877-58031 sha256:8b56ed4894a09a411e4d5ff4e8fe107d07dae14ad20efda35b736477984ba638 symbol=contains_string
pure func ev_contains_string(xs: [string], t: string) -> bool {
  match xs { [] => false, x :: rest => if x == t then true else ev_contains_string(rest, t) }
}

-- SOURCE src/core/journal.ail L1370-1372 B58032-58209 sha256:163648bbf6b19307d1fde973c73d13f724d678c6c05aa18f5f5b1ac0036a8530 symbol=without_string
pure func ev_without_string(xs: [string], t: string) -> [string] {
  match xs { [] => [], x :: rest => if x == t then ev_without_string(rest, t) else x :: ev_without_string(rest, t) }
}

-- SOURCE src/core/journal.ail L1374-1376 B58210-58322 sha256:3b2300706a75077efbc15143560c3eb94e3dcd9df3440c7620085929452c0276 symbol=call_ids
pure func ev_call_ids(cs: [ToolCall]) -> [string] {
  match cs { [] => [], c :: rest => c.id :: ev_call_ids(rest) }
}

-- SOURCE src/core/journal.ail L1378-1381 B58323-58469 sha256:2aa86d577704cef6d0c1ec5009709464f52fbcc4431dd469dceb991ccb308c95 symbol=drop_hist
pure func ev_drop_hist(n: int, xs: [EvHistMsg]) -> [EvHistMsg] {
  if n <= 0 then xs
  else match xs { [] => [], _ :: rest => ev_drop_hist(n - 1, rest) }
}

-- SOURCE src/core/journal.ail L1383-1388 B58470-58642 sha256:5bcfc9e9544369b9d44753846c8ac369f15cb63a475ca45bd62d966728832ea8 symbol=take_system_hist
pure func ev_take_system_hist(xs: [EvHistMsg]) -> [EvHistMsg] {
  match xs {
    [] => [],
    h :: rest => if h.m.role == "system" then h :: ev_take_system_hist(rest) else []
  }
}

-- SOURCE src/core/journal.ail L1394-1399 B58825-59009 sha256:404f6f117c8d496489db37c70b86c273728af7fa402f503ed06b1002f1183069 symbol=find_entry
pure func ev_find_entry(es: [EvJournalEntry], id: string) -> Option[EvJournalEntry] {
  match es {
    [] => None,
    e :: rest => if e.id == id then Some(e) else ev_find_entry(rest, id)
  }
}

-- SOURCE src/core/journal.ail L1405-1412 B59326-59620 sha256:db222e4cc4cb242276a0e9bd8d54ad215f6c1775d5f8a12f7efad01f707a9ffa symbol=path_up
pure func ev_path_up(es: [EvJournalEntry], id: string, seen: [string], acc: [EvJournalEntry]) -> [EvJournalEntry] {
  if id == "" then acc
  else if ev_contains_string(seen, id) then acc
  else match ev_find_entry(es, id) {
    None => acc,
    Some(e) => ev_path_up(es, e.parent_id, id :: seen, e :: acc)
  }
}

-- SOURCE src/core/journal.ail L1414-1414 B59621-59681 sha256:20197f12669f4071d558e1deceecc07d7c1f0e597f0edc93499b9938c0fd7723 symbol=EnvAcc
type EvEnvAcc = { out: [EvJournalEntry], err: Option[EvRefusal] }

-- SOURCE src/core/journal.ail L1416-1424 B59682-59938 sha256:dcacecff0b3093179e29353656c63438a5c090973961f28182aeffb1bf2e0ced symbol=decode_envelope_step
pure func ev_decode_envelope_step(acc: EvEnvAcc, j: Json) -> EvEnvAcc {
  match acc.err {
    Some(_) => acc,
    None => match ev_journal_entry_of_json(j) {
      Err(r) => { out: acc.out, err: Some(r) },
      Ok(e) => { out: e :: acc.out, err: None }
    }
  }
}

-- SOURCE src/core/journal.ail L1441-1453 B60862-61131 sha256:872394d4f39168d1c85c6b9b159b0a4561a257d0929519541f7cfbd65295936f symbol=FoldAcc
type EvFoldAcc = {
  err: Option[EvRefusal],
  rev_msgs: [EvHistMsg],
  digest: string,
  digest_prev: string,
  cumulative: EvRuntimeStatusCounts,
  telemetry: TokenTelemetry,
  ext_artifacts: Json,
  model: string,
  profile: string,
  last: EvBoundary,
  world_ordinal: int
}

-- SOURCE src/core/journal.ail L1455-1473 B61132-61854 sha256:85c79010376bc036f2c0e82cba5e69a9aefda2b2055cc6cbbcc446ef9b26f04e symbol=fold_append
pure func ev_fold_append(acc: EvFoldAcc, e: EvJournalEntry) -> EvFoldAcc {
  match ev_appended_of_entry(e) {
    Err(r) => { acc | err: Some(r) },
    Ok(a) => {
      let base = if a.replaces_previous then acc.digest_prev else acc.digest;
      let kept = if a.replaces_previous
                 then match acc.rev_msgs { [] => [], _ :: rest => rest }
                 else acc.rev_msgs;
      let expected = eval_chain_digest_after(base, a.message);
      if a.digest_after != expected then { acc | err: Some(EvDigest(e.seq)) }
      else {
        acc | rev_msgs: ev_hist_msg(e.seq, a.message) :: kept,
              digest: expected,
              digest_prev: base,
              last: EvBoundaryOpen("history_appended")
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1492-1517 B62915-64260 sha256:396876c5955325b2720bd0a3254159e7f4427fc4769628c4bb36b11edc6a8b46 symbol=fold_replace
pure func ev_fold_replace(acc: EvFoldAcc, e: EvJournalEntry) -> EvFoldAcc {
  match ev_replaced_of_entry(e) {
    Err(r) => { acc | err: Some(r) },
    Ok(rep) => {
      -- `resume` is the same whole-history replacement (P3 Part 5's kill -9 gate):
      -- the seed of a resume whose folded history is not the journal's chain — open
      -- calls stripped, or a checkpoint-rebased chain — written by the host from the
      -- seed and carrying its digest, exactly as a switch's is.
      let switch = rep.reason == "profile_switch" || rep.reason == "resume";
      let forward = ev_reverse_hist(acc.rev_msgs);
      let prefix = if switch then [] else ev_take_system_hist(forward);
      let kept = if switch then [] else match rep.first_kept { None => [], Some(i) => ev_drop_hist(i, forward) };
      let replacement = ev_tag_messages(e.seq, rep.messages);
      let emitted = prefix ++ replacement ++ kept;
      let expected = if switch then eval_chain_digest_over(eval_chain_empty_base(), rep.messages)
                     else eval_chain_digest_base(ev_hist_messages(prefix ++ replacement));
      if rep.digest_after != expected then { acc | err: Some(EvDigest(e.seq)) }
      else {
        acc | rev_msgs: ev_reverse_hist(emitted),
              digest: expected,
              digest_prev: acc.digest,
              last: EvBoundaryOpen("history_replaced")
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1519-1519 B64261-64336 sha256:c7f089d09f3816954f0edb7fc6288e39c0f477507baa933f82dc0c66a7509be6 symbol=hist_msg
pure func ev_hist_msg(seq: int, m: Message) -> EvHistMsg { { seq: seq, m: m } }

-- SOURCE src/core/journal.ail L1521-1523 B64337-64484 sha256:bd1ae31a76150fda08d4b1d4cdfd7d1795601447b9446dd4d3cc0a89d48f23de symbol=tag_messages
pure func ev_tag_messages(seq: int, ms: [Message]) -> [EvHistMsg] {
  match ms { [] => [], m :: rest => ev_hist_msg(seq, m) :: ev_tag_messages(seq, rest) }
}

-- SOURCE src/core/journal.ail L1525-1623 B64485-69775 sha256:570b540ff61ea36b15935607d7f3f2283d4790511795e89bc44e67fb03f534b6 symbol=fold_entry
pure func ev_fold_entry(acc: EvFoldAcc, e: EvJournalEntry) -> EvFoldAcc {
  match acc.err {
    Some(_) => acc,
    None =>
      if e.kind == "history_appended" then ev_fold_append(acc, e)
      else if e.kind == "history_replaced" then ev_fold_replace(acc, e)
      else if e.kind == "state_delta" then match ev_state_delta_of_entry(e) {
        Err(r) => { acc | err: Some(r) },
        Ok(d) => {
          acc | cumulative: d.cumulative,
                telemetry: d.telemetry,
                ext_artifacts: match d.ext_artifacts { None => acc.ext_artifacts, Some(v) => v },
                last: EvBoundaryOpen("state_delta")
        }
      }
      else if e.kind == "settings" then match ev_settings_of_entry(e) {
        Err(r) => { acc | err: Some(r) },
        Ok(s) => {
          acc | model: match s.model { None => acc.model, Some(m) => m },
                profile: match s.profile { None => acc.profile, Some(p) => p },
                last: EvBoundaryOpen("settings")
        }
      }
      else if e.kind == "run_started" then match ev_run_started_of_entry(e) {
        Err(r) => { acc | err: Some(r) },
        Ok(_) => { acc | last: EvBoundaryOpen("run_started") }
      }
      -- A `run_finished` THAT CLOSES THE RUN WHICH JUST SUSPENDED KEEPS THE
      -- SUSPENSION AS THE BOUNDARY. Found by P3 Part 5's resume gate, not
      -- anticipated: D2 puts `run_suspended` IMMEDIATELY BEFORE `run_summary` on
      -- the wire (the P1 Part 1 fixture pins that order), so every suspended run's
      -- journal ends `suspended, run_finished`, and D4 rule 6 read literally ("the
      -- last entry's type") folds EVERY suspension to "between turns" — the held
      -- continuation D6 step 5 routes `Suspended` to would be unreachable from any
      -- journal a host or the twin can write. The summary is the frame closing, the
      -- suspension is how it closed; the ordinal is still the summary's.
      else if e.kind == "run_finished" then match ev_run_finished_of_entry(e) {
        Err(r) => { acc | err: Some(r) },
        Ok(f) => match acc.last {
          EvBoundarySuspended(rid, _) =>
            if rid == f.run_id then { acc | world_ordinal: f.world_ordinal }
            else { acc | last: EvBoundaryRunFinished(f.run_id, f.world_ordinal), world_ordinal: f.world_ordinal },
          _ => { acc | last: EvBoundaryRunFinished(f.run_id, f.world_ordinal), world_ordinal: f.world_ordinal }
        }
      }
      else if e.kind == "suspended" then match ev_suspended_of_entry(e) {
        Err(r) => { acc | err: Some(r) },
        Ok(s) => { acc | last: EvBoundarySuspended(s.run_id, s.step) }
      }
      else if e.kind == "resumed" then match ev_resumed_of_entry(e) {
        Err(r) => { acc | err: Some(r) },
        Ok(_) => { acc | last: EvBoundaryOpen("resumed") }
      }
      -- AN `exit` AFTER A PARK KEEPS THE PARK (P4-Q4: ADR-002 D4 over the literal
      -- text of ADR-003 D4 rule 6). The host writes `exit` when it quits or dies
      -- during a durable park, and the park — with its wake, when one arrived and
      -- no run consumed it — is what the resume re-observes.
      else if e.kind == "exit" then match ev_exit_of_entry(e) {
        Err(r) => { acc | err: Some(r) },
        Ok(x) => match acc.last {
          EvBoundaryParked(_, _) => acc,
          _ => { acc | last: EvBoundaryExit(x.reason) }
        }
      }
      -- D7's park (PLAN-003 P4 Part 1). It is the boundary until an entry of the
      -- running kind follows — `run_started`, a history entry, `state_delta`,
      -- `run_finished`, `suspended` — and every one of those arms already moves
      -- `last` off it. That is D7's exactly-once rule inside the fold: a consumed
      -- wake is followed by the `run_started` of the run it opened, so no later
      -- fold offers it again.
      else if e.kind == "park" then match ev_park_of_entry(e) {
        Err(r) => { acc | err: Some(r) },
        Ok(p) => { acc | last: EvBoundaryParked(p, None) }
      }
      -- A wake answers THE open park and nothing else: no park before it, a park
      -- already answered, or a park for another request refuse at `request_id`.
      -- An `aborted` wake CLOSES the park (P4-Q4): the request was cancelled, and
      -- a resume that opens no run must not re-offer it.
      else if e.kind == "wake" then match ev_wake_of_entry(e) {
        Err(r) => { acc | err: Some(r) },
        Ok(w) => match acc.last {
          EvBoundaryParked(p, answered) => match answered {
            Some(_) => { acc | err: Some(EvEntry(e.seq, "request_id")) },
            None =>
              if p.request_id != w.request_id then { acc | err: Some(EvEntry(e.seq, "request_id")) }
              else if w.outcome == "aborted" then { acc | last: EvBoundaryOpen("wake:aborted") }
              else { acc | last: EvBoundaryParked(p, Some(w)) }
          },
          _ => { acc | err: Some(EvEntry(e.seq, "request_id")) }
        }
      }
      else if e.kind == "header" then { acc | err: Some(EvHeader) }
      -- AN UNKNOWN TYPE IS A REFUSAL, not a skip: a fold that ignored what it did
      -- not recognise would resume a session as though the entry it skipped had
      -- never been written — which is what the fold before P4 Part 1 would have
      -- done to a `park`.
      else { acc | err: Some(EvEntry(e.seq, "type=${e.kind}")) }
  }
}

-- SOURCE src/core/journal.ail L1629-1634 B69989-70090 sha256:933fa5458f8f8cea1453d8eebdb9f941a0e1453368e905c4a463609449f4e14c symbol=PairAcc
type EvPairAcc = {
  err: Option[EvRefusal],
  open_ids: [string],
  cur_ids: [string],
  cur_seq: int
}

-- SOURCE src/core/journal.ail L1636-1653 B70091-70936 sha256:7fefcfe57665874fa7e1e19c29f81f47a8cd9400c767205693cd63d4d19dee8a symbol=pair_step
pure func ev_pair_step(acc: EvPairAcc, h: EvHistMsg) -> EvPairAcc {
  match acc.err {
    Some(_) => acc,
    None =>
      if h.m.role == "tool" then
        if ev_contains_string(acc.cur_ids, h.m.tool_call_id)
        then { acc | open_ids: ev_without_string(acc.open_ids, h.m.tool_call_id) }
        else { acc | err: Some(EvPairing(h.seq)) }
      else if List.length(acc.open_ids) > 0 then
        -- Something that is not a result for the open batch arrived while calls
        -- were still open: D4's "every call except a trailing one is answered".
        -- The refusal names the ASSISTANT that made them, not the interloper.
        { acc | err: Some(EvPairing(acc.cur_seq)) }
      else if List.length(h.m.tool_calls) > 0 then
        { acc | open_ids: ev_call_ids(h.m.tool_calls), cur_ids: ev_call_ids(h.m.tool_calls), cur_seq: h.seq }
      else acc
  }
}

-- SOURCE src/core/journal.ail L1655-1664 B70937-71336 sha256:25f660ec423fb5cba312feb5d46a1b09892c02df0d7ccdec11930f9d41aeb672 symbol=strip_dangling
pure func ev_strip_dangling(dangling: [string], cur_seq: int, xs: [EvHistMsg]) -> [EvHistMsg] {
  match xs {
    [] => [],
    h :: rest =>
      if h.seq == cur_seq && List.length(h.m.tool_calls) > 0
      then ev_hist_msg(h.seq, { h.m | tool_calls: ev_keep_calls(dangling, h.m.tool_calls) })
             :: ev_strip_dangling(dangling, cur_seq, rest)
      else h :: ev_strip_dangling(dangling, cur_seq, rest)
  }
}

-- SOURCE src/core/journal.ail L1666-1673 B71337-71576 sha256:9eb2cbf933e204b9462436b55f6e20642d42e6d3baed0b4072171dd1216081d6 symbol=keep_calls
pure func ev_keep_calls(dangling: [string], cs: [ToolCall]) -> [ToolCall] {
  match cs {
    [] => [],
    c :: rest =>
      if ev_contains_string(dangling, c.id) then ev_keep_calls(dangling, rest)
      else c :: ev_keep_calls(dangling, rest)
  }
}

-- SOURCE src/core/journal.ail L1679-1715 B71758-72999 sha256:04d2c175ef421f547340687d83da3993779d5b9dd438afc2cabb41528760986d symbol=fold_journal
pure func ev_fold_journal(entries: [Json], leaf: string) -> Result[EvSessionState, EvRefusal] {
  let env0: EvEnvAcc = { out: [], err: None };
  let decoded = List.foldl(ev_decode_envelope_step, env0, entries);
  match decoded.err {
    Some(r) => Err(r),
    None => {
      let all = ev_reverse_entries(decoded.out);
      let path = ev_path_up(all, leaf, [], []);
      match path {
        [] => Err(EvHeader),
        head_entry :: rest => match ev_header_of_entry(head_entry) {
          Err(r) => Err(r),
          Ok(header) => {
            let acc0: EvFoldAcc = {
              err: None,
              rev_msgs: [],
              digest: eval_chain_empty_base(),
              digest_prev: eval_chain_empty_base(),
              cumulative: ev_zero_runtime_status_counts(),
              telemetry: ev_zero_token_telemetry(),
              ext_artifacts: ev_empty_ext_artifacts(),
              model: header.model,
              profile: header.profile,
              last: EvBoundaryOpen("header"),
              world_ordinal: 0
            };
            let acc = List.foldl(ev_fold_entry, acc0, rest);
            match acc.err {
              Some(r) => Err(r),
              None => ev_finish_fold(header, acc)
            }
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L1717-1752 B73000-74339 sha256:446465b10146e5eb4720a9704cc8453ab876310b9ecaa7ad34ed6bc31667f8b5 symbol=finish_fold
pure func ev_finish_fold(header: EvHeaderEntry, acc: EvFoldAcc) -> Result[EvSessionState, EvRefusal] {
  let forward = ev_reverse_hist(acc.rev_msgs);
  let pair0: EvPairAcc = { err: None, open_ids: [], cur_ids: [], cur_seq: -1 };
  let pairs = List.foldl(ev_pair_step, pair0, forward);
  match pairs.err {
    Some(r) => Err(r),
    None => {
      let dangling = pairs.open_ids;
      let stripped = if List.length(dangling) == 0 then forward
                     else ev_strip_dangling(dangling, pairs.cur_seq, forward);
      let msgs = ev_hist_messages(stripped);
      if not ev_system_is_head_prefix(msgs, true) then Err(EvHeadPrefix)
      else match ev_history_from_seed(msgs) {
        Err(e) => Err(EvTranscript(e)),
        Ok(h) =>
          if not ev_history_valid_transcript(h)
          then Err(EvTranscript("a tool message with no tool_call_id, or a tool call with no id"))
          else {
            let st: EvSessionState = {
              header: header,
              history: msgs,
              dangling: dangling,
              cumulative: acc.cumulative,
              telemetry: acc.telemetry,
              ext_artifacts: acc.ext_artifacts,
              model: acc.model,
              profile: acc.profile,
              last: acc.last,
              world_ordinal: acc.world_ordinal
            };
            Ok(st)
          }
      }
    }
  }
}

-- ============================================================================
-- The reader (ADR-004 D1): selector, refusals, output.
-- ============================================================================

export type SegmentEnd = EndAt(string) | CutoffBefore(string)

export type RunSelector = { leaf: string, run_id: string, start: string, end: SegmentEnd }

-- Where a refusal is: an entry by `seq`, a line by index (an envelope with no
-- `seq`), or the path as a whole (a property of the folded history).
export type SourcePosition = AtEntry(int) | AtLine(int) | AtPath

export type SourceRefusal
  = ChainBreak(SourcePosition, string)
  | MalformedEntry(SourcePosition, string)
  | UnknownEntryType(SourcePosition, string)
  | UnknownSchema(SourcePosition, string)
  | BadSelector(string)

export pure func position_label(p: SourcePosition) -> string {
  match p {
    AtEntry(s) => "entry:${show(s)}",
    AtLine(i) => "line:${show(i)}",
    AtPath => "path"
  }
}

export pure func source_refusal_family(r: SourceRefusal) -> string {
  match r {
    ChainBreak(_, _) => "ChainBreak",
    MalformedEntry(_, _) => "MalformedEntry",
    UnknownEntryType(_, _) => "UnknownEntryType",
    UnknownSchema(_, _) => "UnknownSchema",
    BadSelector(_) => "BadSelector"
  }
}

export pure func source_refusal_position(r: SourceRefusal) -> string {
  match r {
    ChainBreak(p, _) => position_label(p),
    MalformedEntry(p, _) => position_label(p),
    UnknownEntryType(p, _) => position_label(p),
    UnknownSchema(p, _) => position_label(p),
    BadSelector(_) => "path"
  }
}

-- The field, the detail or the unknown type — never content.
export pure func source_refusal_field(r: SourceRefusal) -> string {
  match r {
    ChainBreak(_, f) => f,
    MalformedEntry(_, f) => f,
    UnknownEntryType(_, f) => f,
    UnknownSchema(_, f) => f,
    BadSelector(f) => f
  }
}

-- One segment entry, typed, with its `seq`. No `header`: the path's only
-- header is its root, which is never inside a segment.
export type SegmentEntry
  = SegAppended(int, EvAppendedEntry)
  | SegReplaced(int, EvReplacedEntry)
  | SegStateDelta(int, EvStateDeltaEntry)
  | SegRunStarted(int, EvRunStartedEntry)
  | SegRunFinished(int, EvRunFinishedEntry)
  | SegSettings(int, EvSettingsEntry)
  | SegSuspended(int, EvSuspendedEntry)
  | SegResumed(int, EvResumedEntry)
  | SegExit(int, EvExitEntry)
  | SegPark(int, EvParkEntry)
  | SegWake(int, EvWakeEntry)

export type ReaderSource = {
  header: EvHeaderEntry,
  selector: RunSelector,
  path_length: int,
  run_started_seq: int,
  start_seq: int,
  -- the fold of the path up to the entry before `start`, repaired
  seed: [Message],
  seed_digest: string,
  seed_state: EvSessionState,
  -- P1.2b's ContinuationStart input
  opened_by_wake: bool,
  segment: [SegmentEntry],
  -- the strict fold of the whole path (a validation; not the segment)
  leaf_state: EvSessionState
}

-- ----------------------------------------------------------------------------
-- The fold's refusals as D1's families.
-- ----------------------------------------------------------------------------

pure func type_prefix() -> string { "type=" }

pure func from_fold(r: EvRefusal, root_seq: int) -> SourceRefusal {
  match r {
    EvHeader => ChainBreak(AtPath, "header"),
    EvEntry(seq, field) =>
      if startsWith(field, type_prefix())
      then UnknownEntryType(AtEntry(seq), substring(field, Str.length(type_prefix()), Str.length(field)))
      else if seq < 0 then MalformedEntry(AtPath, field)
      else MalformedEntry(AtEntry(seq), field),
    EvDigest(seq) => ChainBreak(AtEntry(seq), "digest_after"),
    EvHeadPrefix => MalformedEntry(AtPath, "head-prefix"),
    EvTranscript(_) => MalformedEntry(AtPath, "transcript"),
    EvPairing(seq) => MalformedEntry(AtEntry(seq), "pairing"),
    EvSchema => UnknownSchema(AtEntry(root_seq), "schema_version"),
    _ => MalformedEntry(AtPath, ev_refusal_id(r))
  }
}

-- ----------------------------------------------------------------------------
-- Step 1: every envelope, located.
-- ----------------------------------------------------------------------------

type LineAcc = { idx: int, bad: Option[SourceRefusal], out: [EvJournalEntry] }

pure func envelope_refusal(r: EvRefusal, idx: int) -> SourceRefusal {
  match r {
    EvEntry(seq, field) =>
      if seq < 0 then MalformedEntry(AtLine(idx), field) else MalformedEntry(AtEntry(seq), field),
    _ => MalformedEntry(AtLine(idx), ev_refusal_id(r))
  }
}

pure func envelope_step(acc: LineAcc, j: Json) -> LineAcc {
  match acc.bad {
    Some(_) => acc,
    None => match ev_journal_entry_of_json(j) {
      Err(r) => { acc | bad: Some(envelope_refusal(r, acc.idx)) },
      Ok(e) => { idx: acc.idx + 1, bad: None, out: e :: acc.out }
    }
  }
}

pure func envelopes(lines: [Json]) -> Result[[EvJournalEntry], SourceRefusal] {
  let acc = List.foldl(envelope_step, { idx: 0, bad: None, out: [] }, lines);
  match acc.bad {
    Some(r) => Err(r),
    None => Ok(ev_reverse_entries(acc.out))
  }
}

-- ----------------------------------------------------------------------------
-- Step 2: the strict path, root first.
-- ----------------------------------------------------------------------------

pure func climb(es: [EvJournalEntry], e: EvJournalEntry, seen: [string], acc: [EvJournalEntry]) -> Result[[EvJournalEntry], SourceRefusal] {
  let seen2 = e.id :: seen;
  let acc2 = e :: acc;
  if e.parent_id == "" then Ok(acc2)
  else if ev_contains_string(seen2, e.parent_id) then Err(ChainBreak(AtEntry(e.seq), "parent_id"))
  else match ev_find_entry(es, e.parent_id) {
    None => Err(ChainBreak(AtEntry(e.seq), "parent_id")),
    Some(p) => climb(es, p, seen2, acc2)
  }
}

pure func first_header_seq(acc: int, e: EvJournalEntry) -> int {
  if acc >= 0 then acc else if e.kind == "header" then e.seq else -1
}

export pure func strict_path(es: [EvJournalEntry], leaf: string) -> Result[[EvJournalEntry], SourceRefusal] {
  match ev_find_entry(es, leaf) {
    None => Err(ChainBreak(AtPath, "leaf")),
    Some(e) => match climb(es, e, [], []) {
      Err(r) => Err(r),
      Ok(path) => match path {
        [] => Err(ChainBreak(AtPath, "leaf")),
        root :: rest =>
          if root.kind != "header" then Err(ChainBreak(AtEntry(root.seq), "root"))
          else {
            let extra = List.foldl(first_header_seq, -1, rest);
            if extra >= 0 then Err(ChainBreak(AtEntry(extra), "header")) else Ok(path)
          }
      }
    }
  }
}

-- ----------------------------------------------------------------------------
-- Indexing the path.
-- ----------------------------------------------------------------------------

type IndexAcc = { i: int, found: int }

pure func index_of(path: [EvJournalEntry], id: string) -> int {
  let acc = List.foldl(\a e. if a.found >= 0 then a else if e.id == id then { i: a.i + 1, found: a.i } else { a | i: a.i + 1 }, { i: 0, found: -1 }, path);
  acc.found
}

pure func drop_entries(n: int, xs: [EvJournalEntry]) -> [EvJournalEntry] {
  if n <= 0 then xs
  else match xs { [] => [], _ :: rest => drop_entries(n - 1, rest) }
}

pure func nth_entry(path: [EvJournalEntry], i: int) -> Option[EvJournalEntry] {
  if i < 0 then None
  else match drop_entries(i, path) { [] => None, e :: _ => Some(e) }
}

type TakeAcc = { left: int, out: [EvJournalEntry] }

pure func take_entries(n: int, xs: [EvJournalEntry]) -> [EvJournalEntry] {
  let acc = List.foldl(\a e. if a.left <= 0 then a else { left: a.left - 1, out: e :: a.out }, { left: n, out: [] }, xs);
  ev_reverse_entries(acc.out)
}

pure func slice_entries(path: [EvJournalEntry], from: int, until: int) -> [EvJournalEntry] {
  take_entries(until - from, drop_entries(from, path))
}

-- ----------------------------------------------------------------------------
-- Step 5: the selector.
-- ----------------------------------------------------------------------------

pure func assistant_of(e: EvJournalEntry) -> Option[EvAppendedEntry] {
  if e.kind != "history_appended" then None
  else match ev_appended_of_entry(e) {
    Err(_) => None,
    Ok(a) => if a.message.role == "assistant" then Some(a) else None
  }
}

pure func is_assistant(e: EvJournalEntry) -> bool {
  match assistant_of(e) { Some(_) => true, None => false }
}

pure func run_started_id(e: EvJournalEntry) -> string {
  if e.kind != "run_started" then ""
  else match ev_run_started_of_entry(e) { Err(_) => "", Ok(r) => r.run_id }
}

-- Before `start`: the last `run_started` of the run, and whether an assistant
-- follows it.
type RunAcc = { i: int, ri: int, asst_after: bool }

pure func run_step(run_id: string, si: int, a: RunAcc, e: EvJournalEntry) -> RunAcc {
  if a.i >= si then { a | i: a.i + 1 }
  else if run_started_id(e) == run_id && run_id != "" then { i: a.i + 1, ri: a.i, asst_after: false }
  else if is_assistant(e) then { a | i: a.i + 1, asst_after: true }
  else { a | i: a.i + 1 }
}

type StartOk = { si: int, ri: int, start: EvJournalEntry, run_started: EvJournalEntry }

pure func check_start(path: [EvJournalEntry], sel: RunSelector) -> Result[StartOk, SourceRefusal] {
  let si = index_of(path, sel.start);
  match nth_entry(path, si) {
    None => Err(BadSelector("start")),
    Some(s) => match assistant_of(s) {
      None => Err(BadSelector("start")),
      Some(a) =>
        if a.run_id != sel.run_id || a.replaces_previous then Err(BadSelector("start"))
        else {
          let r = List.foldl(\acc e. run_step(sel.run_id, si, acc, e), { i: 0, ri: -1, asst_after: false }, path);
          if r.ri < 0 then Err(BadSelector("run_id"))
          else if r.asst_after then Err(BadSelector("start"))
          else match nth_entry(path, r.ri) {
            None => Err(BadSelector("run_id")),
            Some(rs) => Ok({ si: si, ri: r.ri, start: s, run_started: rs })
          }
        }
    }
  }
}

pure func is_turn_tail(e: EvJournalEntry) -> bool {
  if e.kind == "state_delta" then true
  else if e.kind != "history_appended" then false
  else match ev_appended_of_entry(e) { Err(_) => false, Ok(a) => a.message.role == "tool" }
}

type TailAcc = { n: int, going: bool }

pure func tail_length(xs: [EvJournalEntry]) -> int {
  let acc = List.foldl(\a e. if a.going && is_turn_tail(e) then { n: a.n + 1, going: true } else { a | going: false }, { n: 0, going: true }, xs);
  acc.n
}

-- The exclusive end index of the segment.
pure func segment_stop(path: [EvJournalEntry], si: int, sel: RunSelector) -> Result[int, SourceRefusal] {
  match sel.end {
    EndAt(id) => {
      let ei = index_of(path, id);
      if ei < si then Err(BadSelector("end"))
      else match nth_entry(path, ei) {
        None => Err(BadSelector("end")),
        Some(e) => match assistant_of(e) {
          None => Err(BadSelector("end")),
          Some(a) =>
            if a.run_id != sel.run_id then Err(BadSelector("end"))
            else Ok(ei + 1 + tail_length(drop_entries(ei + 1, path)))
        }
      }
    },
    CutoffBefore(id) => {
      let ei = index_of(path, id);
      if ei <= si then Err(BadSelector("end")) else Ok(ei)
    }
  }
}

-- ----------------------------------------------------------------------------
-- Step 7: the typed segment.
-- ----------------------------------------------------------------------------

pure func seg_of(root_seq: int, e: EvJournalEntry) -> Result[SegmentEntry, SourceRefusal] {
  let s = e.seq;
  if e.kind == "history_appended" then match ev_appended_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegAppended(s, x)) }
  else if e.kind == "history_replaced" then match ev_replaced_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegReplaced(s, x)) }
  else if e.kind == "state_delta" then match ev_state_delta_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegStateDelta(s, x)) }
  else if e.kind == "run_started" then match ev_run_started_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegRunStarted(s, x)) }
  else if e.kind == "run_finished" then match ev_run_finished_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegRunFinished(s, x)) }
  else if e.kind == "settings" then match ev_settings_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegSettings(s, x)) }
  else if e.kind == "suspended" then match ev_suspended_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegSuspended(s, x)) }
  else if e.kind == "resumed" then match ev_resumed_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegResumed(s, x)) }
  else if e.kind == "exit" then match ev_exit_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegExit(s, x)) }
  else if e.kind == "park" then match ev_park_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegPark(s, x)) }
  else if e.kind == "wake" then match ev_wake_of_entry(e) { Err(r) => Err(from_fold(r, root_seq)), Ok(x) => Ok(SegWake(s, x)) }
  else if e.kind == "header" then Err(ChainBreak(AtEntry(s), "header"))
  else Err(UnknownEntryType(AtEntry(s), e.kind))
}

type SegAcc = { bad: Option[SourceRefusal], out: [SegmentEntry] }

pure func segment_of(root_seq: int, es: [EvJournalEntry]) -> Result[[SegmentEntry], SourceRefusal] {
  let acc = List.foldl(\a e. match a.bad {
    Some(_) => a,
    None => match seg_of(root_seq, e) { Err(r) => { a | bad: Some(r) }, Ok(x) => { a | out: x :: a.out } }
  }, { bad: None, out: [] }, es);
  match acc.bad {
    Some(r) => Err(r),
    None => Ok(List.foldl(\xs x. x :: xs, [], acc.out))
  }
}

export pure func segment_entry_seq(x: SegmentEntry) -> int {
  match x {
    SegAppended(s, _) => s, SegReplaced(s, _) => s, SegStateDelta(s, _) => s,
    SegRunStarted(s, _) => s, SegRunFinished(s, _) => s, SegSettings(s, _) => s,
    SegSuspended(s, _) => s, SegResumed(s, _) => s, SegExit(s, _) => s,
    SegPark(s, _) => s, SegWake(s, _) => s
  }
}

export pure func segment_entry_kind(x: SegmentEntry) -> string {
  match x {
    SegAppended(_, _) => "history_appended", SegReplaced(_, _) => "history_replaced",
    SegStateDelta(_, _) => "state_delta", SegRunStarted(_, _) => "run_started",
    SegRunFinished(_, _) => "run_finished", SegSettings(_, _) => "settings",
    SegSuspended(_, _) => "suspended", SegResumed(_, _) => "resumed", SegExit(_, _) => "exit",
    SegPark(_, _) => "park", SegWake(_, _) => "wake"
  }
}

-- The `seq` of every `park` inside the segment: P1.3's `Parked` cutoff input.
export pure func segment_parks(seg: [SegmentEntry]) -> [int] {
  List.foldl(\acc x. match x { SegPark(s, _) => acc ++ [s], _ => acc }, [], seg)
}

-- The call count of every assistant append in the segment, in order.
export pure func segment_call_counts(seg: [SegmentEntry]) -> [int] {
  List.foldl(\acc x. match x {
    SegAppended(_, a) => if a.message.role == "assistant" then acc ++ [List.length(a.message.tool_calls)] else acc,
    _ => acc
  }, [], seg)
}

-- ----------------------------------------------------------------------------
-- Steps 3, 4 and 6: the folds.
-- ----------------------------------------------------------------------------

export pure func eval_fold_journal(lines: [Json], leaf: string) -> Result[EvSessionState, EvRefusal] {
  ev_fold_journal(lines, leaf)
}

-- `<refusal_id>:<seq>:<field>`, `seq` -1 where the refusal names none. The
-- generator writes the same label.
export pure func eval_refusal_label(r: EvRefusal) -> string {
  match r {
    EvEntry(seq, field) => "entry:${show(seq)}:${field}",
    EvDigest(seq) => "digest:${show(seq)}:",
    EvPairing(seq) => "pairing:${show(seq)}:",
    _ => "${ev_refusal_id(r)}:-1:"
  }
}

export pure func eval_boundary_id(b: EvBoundary) -> string {
  ev_boundary_id(b)
}

pure func wake_answered(st: EvSessionState) -> bool {
  match st.last {
    EvBoundaryParked(_, w) => match w { Some(_) => true, None => false },
    _ => false
  }
}

pure func fold_at(lines: [Json], leaf: string, root_seq: int) -> Result[EvSessionState, SourceRefusal] {
  match ev_fold_journal(lines, leaf) {
    Err(r) => Err(from_fold(r, root_seq)),
    Ok(st) => Ok(st)
  }
}

-- ----------------------------------------------------------------------------
-- The reader.
-- ----------------------------------------------------------------------------

export pure func read_source(lines: [Json], sel: RunSelector) -> Result[ReaderSource, SourceRefusal] {
  match envelopes(lines) {
    Err(r) => Err(r),
    Ok(all) => match strict_path(all, sel.leaf) {
      Err(r) => Err(r),
      Ok(path) => match path {
        [] => Err(ChainBreak(AtPath, "leaf")),
        root :: _ => match ev_header_of_entry(root) {
          Err(r) => Err(from_fold(r, root.seq)),
          Ok(header) => match fold_at(lines, sel.leaf, root.seq) {
            Err(r) => Err(r),
            Ok(leaf_state) => match check_start(path, sel) {
              Err(r) => Err(r),
              Ok(st) => match segment_stop(path, st.si, sel) {
                Err(r) => Err(r),
                Ok(stop) => match fold_at(lines, st.start.parent_id, root.seq) {
                  Err(r) => Err(r),
                  Ok(seed_state) => match fold_at(lines, st.run_started.parent_id, root.seq) {
                    Err(r) => Err(r),
                    Ok(before_run) => match segment_of(root.seq, slice_entries(path, st.si, stop)) {
                      Err(r) => Err(r),
                      Ok(segment) => Ok({
                        header: header,
                        selector: sel,
                        path_length: List.length(path),
                        run_started_seq: st.run_started.seq,
                        start_seq: st.start.seq,
                        seed: seed_state.history,
                        seed_digest: eval_payload_digest(seed_state.history),
                        seed_state: seed_state,
                        opened_by_wake: wake_answered(before_run),
                        segment: segment,
                        leaf_state: leaf_state
                      })
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

-- The snapshot's lines, each decoded as JSON; the first that does not decode
-- is named by index.
type ParseAcc = { idx: int, err: string, out: [Json] }

export pure func parse_lines(xs: [string]) -> Result[[Json], string] {
  let acc = List.foldl(\a s. if a.err != "" then a else match decode(s) {
    Err(_) => { a | err: "line ${show(a.idx)}: not JSON" },
    Ok(j) => { idx: a.idx + 1, err: "", out: j :: a.out }
  }, { idx: 0, err: "", out: [] }, xs);
  if acc.err != "" then Err(acc.err) else Ok(List.foldl(\ys y. y :: ys, [], acc.out))
}

-- ============================================================================
-- Tests (M1, and M15's M1 near-misses: the family's half).
--
-- Every fixture is synthetic and generated (`testdata/gen_fixtures.py`); each
-- expectation below is asserted twice: literally in the test, and against the
-- generator's independent fold and reader.
-- ============================================================================

pure func fx_selector(f: JournalFixture) -> RunSelector {
  let end = if f.end_kind == "EndAt" then EndAt(f.end_id) else CutoffBefore(f.end_id);
  { leaf: f.leaf, run_id: f.run_id, start: f.start, end: end }
}

pure func fx_lines(f: JournalFixture) -> [Json] {
  match parse_lines(f.lines) { Ok(ls) => ls, Err(_) => [] }
}

pure func fx_read(f: JournalFixture) -> Result[ReaderSource, SourceRefusal] {
  read_source(fx_lines(f), fx_selector(f))
}

pure func strings_eq(a: [string], b: [string]) -> bool {
  match a {
    [] => (match b { [] => true, _ => false }),
    x :: xs => match b { [] => false, y :: ys => x == y && strings_eq(xs, ys) }
  }
}

pure func ints_eq(a: [int], b: [int]) -> bool {
  match a {
    [] => (match b { [] => true, _ => false }),
    x :: xs => match b { [] => false, y :: ys => x == y && ints_eq(xs, ys) }
  }
}

-- The reader against the generator, field for field.
pure func reader_agrees(f: JournalFixture) -> bool {
  List.length(fx_lines(f)) == List.length(f.lines) && (match fx_read(f) {
    Err(r) =>
      not f.reader_ok
        && source_refusal_family(r) == f.reader_family
        && source_refusal_position(r) == f.reader_position
        && source_refusal_field(r) == f.reader_field,
    Ok(src) =>
      f.reader_ok
        && List.length(src.seed) == f.seed_count
        && src.seed_digest == f.seed_payload
        && strings_eq(src.seed_state.dangling, f.seed_dangling)
        && src.seed_state.model == f.seed_model
        && strings_eq(List.map(segment_entry_kind, src.segment), f.segment_kinds)
        && ints_eq(segment_call_counts(src.segment), f.segment_calls)
        && ints_eq(segment_parks(src.segment), f.parks)
        && src.opened_by_wake == f.opened_by_wake
        && src.start_seq == f.start_seq
        && src.run_started_seq == f.run_started_seq
  })
}

-- The fold copy against the generator's fold, at the leaf.
pure func fold_agrees(f: JournalFixture) -> bool {
  match eval_fold_journal(fx_lines(f), f.leaf) {
    Err(r) => not f.fold_ok && eval_refusal_label(r) == f.fold_refusal,
    Ok(st) =>
      f.fold_ok
        && List.length(st.history) == f.history_count
        && eval_payload_digest(st.history) == f.history_payload
        && eval_raw_frame_digest(st.history) == f.history_raw
        && strings_eq(st.dangling, f.dangling)
        && eval_boundary_id(st.last) == f.boundary
        && st.model == f.model
        && st.profile == f.profile
        && st.world_ordinal == f.world_ordinal
  }
}

-- A refused fixture: the literal family, position and field, and the generator.
pure func refused_as(f: JournalFixture, family: string, position: string, field: string) -> bool {
  reader_agrees(f) && (match fx_read(f) {
    Ok(_) => false,
    Err(r) =>
      source_refusal_family(r) == family
        && source_refusal_position(r) == position
        && source_refusal_field(r) == field
  })
}

pure func reads(f: JournalFixture) -> bool {
  reader_agrees(f) && (match fx_read(f) { Ok(_) => true, Err(_) => false })
}

