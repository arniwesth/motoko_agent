-- src/eval/journal/reader.ail
--
-- ADR-004 D1, PLAN-004 §3 P1.2a (graph id P1.2a-v2): reader I — the path, the
-- strict decoding and the seed.
--
--   RunSelector = { leaf, run_id, start, end: EndAt(id) | CutoffBefore(id) }
--   read_source(lines, selector) -> Result[ReaderSource, SourceRefusal]
--
-- WHAT IT DOES, in this order (each step's refusal is the first one found):
--   1. ENVELOPES. Every line of the snapshot is decoded as an entry envelope
--      (journal.ail decodes the whole file before it walks a path). A line
--      without a `seq` is located by its line index (`line:<i>`); every other
--      refusal names the entry's `seq` (`entry:<seq>`).
--   2. PATH. Leaf to root by `parent_id` under ADR-003 D4. D4 rule 1 stops
--      silently at a repeated or unknown id and then refuses `Header`; the
--      reader is stricter and names the entry: a leaf that is not in the file,
--      a `parent_id` that names no entry, or a cycle is `ChainBreak` at the
--      entry that names it; a root that is not the `header`, or a `header`
--      anywhere else on the path, is `ChainBreak` at that entry.
--   3. HEADER. The copy of `header_of_entry`: an unknown `schema_version` is
--      `UnknownSchema` at the header; a missing field is `MalformedEntry`.
--   4. STRICT FOLD OF THE WHOLE PATH. The copy of `fold_journal` at the leaf
--      (D4 rules 2–6): every entry decoded strictly, every `digest_after`
--      recomputed, the head prefix, the transcript and the pairing rule. Its
--      refusals map to D1's families:
--        Entry(seq, "type=<k>")  -> UnknownEntryType(entry:seq)
--        Entry(seq, field)       -> MalformedEntry(entry:seq, field)
--          -- this includes the fold's refusal of a stray `wake` at
--          -- `request_id` (no open park, an answered park, another request's
--          -- id; journal.ail:1603–1614), which v5 D1 names MalformedEntry
--        Digest(seq)             -> ChainBreak(entry:seq, "digest_after")
--        Pairing(seq)            -> MalformedEntry(entry:seq, "pairing")
--        HeadPrefix, Transcript  -> MalformedEntry(path, …)
--        Schema                  -> UnknownSchema(entry:<header seq>)
--      The fold's dangling-call repair is NOT used for the segment: the
--      whole-path fold is a validation and its repaired history is only
--      reported (`leaf_state`).
--   5. SELECTOR. `start` must be on the path, a `history_appended` assistant of
--      `run_id` that replaces nothing, after that run's `run_started`, with no
--      assistant of any run between the two: `start` is the run's first call.
--      `EndAt(e)` names an assistant of the run at or after `start`, whose turn
--      (the tool results and `state_delta`s that directly follow it) is kept;
--      `CutoffBefore(e)` names the first entry outside, strictly after `start`.
--      A selector that fails is `BadSelector` — the entry author's input error,
--      a precondition of the reader and NOT one of D1's refusal families.
--   6. SEED. The copy of `fold_journal` at `start`'s parent: the fold of the
--      path up to the entry before `start`, so every leading user entry after
--      `run_started` is in it (r2.1: run_started 1054, user 1055, start 1056).
--      The fold's dangling-call repair applies here and only here.
--   7. SEGMENT. The path from `start` to the end, each entry decoded into a
--      typed `SegmentEntry` with its `seq`, calls untouched.
--
-- WHAT IT LEAVES TO LATER PARTS, and the inputs it hands them:
--   * `park` is P1.3's `Parked` cutoff: a park inside the segment is reported
--     (`segment_parks`) and decoded, never refused here.
--   * a run opened by a consumed wake is P1.2b's `ContinuationStart`:
--     `opened_by_wake` is true when the path up to the run's `run_started`
--     folds to a park answered by a wake (`BoundaryParked(p, Some(w))`).
--   * the excerpt, association, attribution and argument refusals (P1.2b),
--     every cutoff and the configuration (P1.3). The fold's `Pairing` is
--     reported as `MalformedEntry(…, "pairing")` here; P1.2b owns attribution.
--
-- WHY COPIES AND NOT IMPORTS (v5 D5, "The evaluator"). The fold runs inside
-- the measured process as common overhead for parent, control and candidate.
-- Importing `src/core/journal.ail` would pull it into the protected closure and
-- exclude exactly the fold and decoder changes D3's class admits. So every
-- declaration the fold reaches in a candidate file — `journal.ail`, and what it
-- imports from `phase_vocab.ail`, `config.ail` and `ext/ctx_defaults.ail` — is
-- copied below. Nothing here imports `src/core`.
--   * The digest steps (`chain_digest_after`, `chain_digest_base`,
--     `chain_digest_over`, `chain_empty_base`) are NOT copied again: they are
--     P1.4a's pinned copies, imported from `src/eval/journal/digests.ail`.
--   * `BudgetPlan` and `TokenTelemetry` are imported from the ABI package,
--     which the entry pins by lock and D5 refuses a candidate to touch.
--
-- THE PINS. Every copied declaration carries a `SOURCE` comment in P1.4a's
-- format: file, line span and half-open 0-based byte span at A, and the SHA-256
-- of those original bytes (first byte of the declaration line through the
-- newline after its closing brace; a non-braced union through its last
-- indented line), read with `git show A:<file>`. A is P1.1's commit
-- 65003110ff5a15e2ae5b1f0e205e0ffa705d18dc. P1.4b's tool REPORTS drift between
-- a copy and the candidate's source; it does not refuse on it. A copy's body is
-- the source body with every copied name renamed — functions `ev_<name>`,
-- types and constructors `Ev<Name>`, the four digest steps `eval_<name>` — and
-- `export` dropped from functions; nothing else changed. An `@allow_empty_ok`
-- line above a declaration is copied with it and is outside the pinned span.
--
-- The copy's equality with `journal.ail`'s `fold_journal` (:1679) at A is
-- tested in `reader_at_a_test.ail`, the only reader module that imports
-- src/core; its equality with the independent Python fold and reader in
-- `testdata/gen_fixtures.py` is tested here.

module src/eval/journal/reader

import std/ai (Message, ToolCall, ImagePart)
import std/json (Json, jo, ja, encode, decode, get, has, asString, asArray, asObject, asNumber, getString, getInt, getBool, getArray)
import std/list as List (length, map, foldl)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/string (startsWith, substring)
import std/string as Str (length)
import pkg/sunholo/motoko_ext_abi/types (BudgetPlan, TokenTelemetry)
import src/eval/journal/digests (eval_payload_digest, eval_raw_frame_digest, eval_chain_digest_base, eval_chain_digest_after, eval_chain_digest_over, eval_chain_empty_base)
import src/eval/journal/testdata/journal_fixtures (JournalFixture, fxj_all, fxj_clean, fxj_clean_cutoff_before, fxj_incomplete_tail, fxj_park_wake, fxj_park_in_segment, fxj_wake_opened_run, fxj_near_miss_chain_break, fxj_near_miss_malformed_entry, fxj_chain_break_digest, fxj_chain_break_parent, fxj_chain_break_cycle, fxj_chain_break_root, fxj_malformed_field, fxj_malformed_message, fxj_malformed_envelope, fxj_malformed_seq, fxj_malformed_pairing, fxj_stray_wake_no_park, fxj_stray_wake_answered, fxj_stray_wake_other_request, fxj_unknown_entry_type, fxj_unknown_schema, fxj_bad_selector_start, fxj_bad_selector_not_first_call)

