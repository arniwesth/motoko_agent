}


-- ============================================================================
-- Copies: The sealed history and its checks (phase_vocab).
-- ============================================================================

-- SOURCE src/core/phase_vocab.ail L29-29 B1623-1659 sha256:5f0462c1a5699912f2314bb463db883fb9986caedab9cb3d6dd967b2d94ed967 symbol=History
type EvHistory = EvMkHistory([Message])

-- SOURCE src/core/phase_vocab.ail L31-35 B1660-1872 sha256:e02fc292128f617a7bf152e7c0de7fe62c442d327781c7691001db8250bf40d3 symbol=history_from_seed
func ev_history_from_seed(msgs: [Message]) -> Result[EvHistory, string] {
  if ev_system_is_head_prefix(msgs, true)
  then Ok(EvMkHistory(msgs))
  else Err("history seed: system messages must form a head prefix")
}

-- SOURCE src/core/phase_vocab.ail L74-76 B2937-3063 sha256:f5196673d8aef666551d65e2b7edb0c80d52db322227ca85022b19fe3427ac6b symbol=history_valid_transcript
pure func ev_history_valid_transcript(h: EvHistory) -> bool {
  match h { EvMkHistory(xs) => ev_valid_message_transcript(xs) }
}

-- SOURCE src/core/phase_vocab.ail L84-92 B3518-3789 sha256:2d53d862be91ce7b7b75a11110a993ffb723a6e161081ae6c64c5dbe92dbda07 symbol=system_is_head_prefix
pure func ev_system_is_head_prefix(msgs: [Message], still_head: bool) -> bool {
  match msgs {
    [] => true,
    m :: rest =>
      if m.role == "system"
      then still_head && ev_system_is_head_prefix(rest, true)
      else ev_system_is_head_prefix(rest, false)
  }
}

-- SOURCE src/core/phase_vocab.ail L108-113 B4175-4323 sha256:c56ed78dcbeb15a037b67cb2ac410b769bf3f6c18cdc60fceb74b4a49ed7f853 symbol=valid_tool_calls
pure func ev_valid_tool_calls(calls: [ToolCall]) -> bool {
  match calls {
    [] => true,
    c :: rest => c.id != "" && ev_valid_tool_calls(rest)
  }
}

-- SOURCE src/core/phase_vocab.ail L115-122 B4324-4602 sha256:4785eadcd80f735e7e6c8488005f28463882de04b3836dedf759cc92669c8982 symbol=valid_message_transcript
pure func ev_valid_message_transcript(msgs: [Message]) -> bool {
  match msgs {
    [] => true,
    m :: rest =>
      if m.role == "tool" then m.tool_call_id != "" && ev_valid_message_transcript(rest)
      else ev_valid_tool_calls(m.tool_calls) && ev_valid_message_transcript(rest)
  }
}


-- ============================================================================
-- Copies: The wait decoder (phase_vocab).
-- ============================================================================

-- SOURCE src/core/phase_vocab.ail L442-445 B18343-18572 sha256:9ede7568550e55b7d96bb7cd5c31623db2affe53e06119377b9a674b04a9f5ea symbol=WaitDescriptor
export type EvWaitDescriptor
  = EvDelegateWait({ id: string, delegate_kind: string, locator: { pane: string }, answer_path: string, run_key: string })
  | EvOperatorWait({ id: string })
  | EvTimerWait({ id: string, deadline_ms: int })

-- SOURCE src/core/phase_vocab.ail L455-460 B18731-18896 sha256:d9583305b7b26240383665a3bcad80dd2d1f38b6f276c33c793f25567ea8f2d1 symbol=json_field_names
pure func ev_json_field_names(fields: [{key: string, value: Json}]) -> [string] {
  match fields {
    [] => [],
    f :: rest => f.key :: ev_json_field_names(rest)
  }
}

-- SOURCE src/core/phase_vocab.ail L462-467 B18897-19046 sha256:3b465787a8934d56ec3fb7be1bb0ad7ddcb1be1e59fadb24adae27d0a918e3b2 symbol=string_list_has
pure func ev_string_list_has(xs: [string], x: string) -> bool {
  match xs {
    [] => false,
    y :: rest => y == x || ev_string_list_has(rest, x)
  }
}

-- SOURCE src/core/phase_vocab.ail L469-474 B19047-19231 sha256:9425873ad25caf51755c19936d13b76c775710387972f9eb6fe760f314609016 symbol=string_list_covers
pure func ev_string_list_covers(have: [string], want: [string]) -> bool {
  match want {
    [] => true,
    w :: rest => ev_string_list_has(have, w) && ev_string_list_covers(have, rest)
  }
}

-- SOURCE src/core/phase_vocab.ail L478-480 B19377-19580 sha256:bec18979ff078140747ca8f9880f97075763bafccc7a70ba798b3756f5f2f02d symbol=json_keys_exactly
pure func ev_json_keys_exactly(fields: [{key: string, value: Json}], expected: [string]) -> bool {
  List.length(fields) == List.length(expected) && ev_string_list_covers(ev_json_field_names(fields), expected)
}

-- SOURCE src/core/phase_vocab.ail L482-490 B19581-19906 sha256:2140ad91b78607d694cc95813f98e9318b9b84cd22b85e3b9e5a32ad57b61d1c symbol=wait_required_string
pure func ev_wait_required_string(obj: Json, key: string) -> Result[string, string] {
  match get(obj, key) {
    None => Err("wait: missing `${key}`"),
    Some(v) => match asString(v) {
      None => Err("wait: `${key}` is not a string"),
      Some(s) => if s == "" then Err("wait: `${key}` is empty") else Ok(s)
    }
  }
}

-- SOURCE src/core/phase_vocab.ail L492-517 B19907-21029 sha256:813ce8bc30334bc9d73b9faad88a117ebd45dfd502659fb5e2fd07e74608504b symbol=delegate_wait_from_json
pure func ev_delegate_wait_from_json(obj: Json) -> Result[EvWaitDescriptor, string] {
  match ev_wait_required_string(obj, "id") {
    Err(e) => Err(e),
    Ok(id) => match ev_wait_required_string(obj, "delegate_kind") {
      Err(e) => Err(e),
      Ok(kind) => match ev_wait_required_string(obj, "answer_path") {
        Err(e) => Err(e),
        Ok(answer_path) => match ev_wait_required_string(obj, "run_key") {
          Err(e) => Err(e),
          Ok(run_key) => match get(obj, "locator") {
            None => Err("wait: missing `locator`"),
            Some(loc) => match asObject(loc) {
              None => Err("wait: `locator` is not an object"),
              Some(loc_fields) =>
                if not ev_json_keys_exactly(loc_fields, ["pane"]) then Err("wait: `locator` must have exactly the key `pane`")
                else match ev_wait_required_string(loc, "pane") {
                  Err(e) => Err(e),
                  Ok(pane) => Ok(EvDelegateWait({ id: id, delegate_kind: kind, locator: { pane: pane }, answer_path: answer_path, run_key: run_key }))
                }
            }
          }
        }
      }
    }
  }
}

-- SOURCE src/core/phase_vocab.ail L519-535 B21030-21659 sha256:5fb8f190936fa2fda197ff811af19e9227c17ac1847bb8431d222b9779418bee symbol=timer_wait_from_json
pure func ev_timer_wait_from_json(obj: Json) -> Result[EvWaitDescriptor, string] {
  match ev_wait_required_string(obj, "id") {
    Err(e) => Err(e),
    Ok(id) => match get(obj, "deadline_ms") {
      None => Err("wait: missing `deadline_ms`"),
      Some(v) => match asNumber(v) {
        None => Err("wait: `deadline_ms` is not a number"),
        Some(f) => {
          let n = floatToInt(f);
          if _int_to_float(n) != f then Err("wait: `deadline_ms` is not an integer")
          else if n < 0 then Err("wait: `deadline_ms` is negative")
          else Ok(EvTimerWait({ id: id, deadline_ms: n }))
        }
      }
    }
  }
}

-- SOURCE src/core/phase_vocab.ail L539-549 B21815-22445 sha256:b57f782dbe949888972215c2be807ccec99f2edf5ccb50662cec27eb11b096c8 symbol=wait_descriptor_from_json
pure func ev_wait_descriptor_from_json(j: Json) -> Result[EvWaitDescriptor, string] {
  match asObject(j) {
    None => Err("wait: not an object"),
    Some(fields) =>
      if ev_json_keys_exactly(fields, ["id", "delegate_kind", "locator", "answer_path", "run_key"]) then ev_delegate_wait_from_json(j)
      else if ev_json_keys_exactly(fields, ["id", "deadline_ms"]) then ev_timer_wait_from_json(j)
      else if ev_json_keys_exactly(fields, ["id"]) then
        match ev_wait_required_string(j, "id") { Err(e) => Err(e), Ok(id) => Ok(EvOperatorWait({ id: id })) }
      else Err("wait: key set matches no variant (${encode(jo(fields))})")
  }
}


-- ============================================================================
-- Copies: The message codec (journal).
-- ============================================================================

-- SOURCE src/core/journal.ail L383-391 B17848-18123 sha256:d0ea2e14fe5d55437fe21e305379e436ec60e18ef9506d55f4270a8f065a3d1d symbol=req_string
pure func ev_req_string(j: Json, key: string, where: string) -> Result[string, string] {
  match get(j, key) {
    None => Err("${where}.${key}: missing"),
    Some(v) => match asString(v) {
      None => Err("${where}.${key}: not a string"),
      Some(s) => Ok(s)
    }
  }
}

-- SOURCE src/core/journal.ail L393-401 B18124-18399 sha256:93bc5dd70f2d96d2d60f0833653efd2fc4eb77b730caeb1e90ec007dc7b5c93f symbol=req_array
pure func ev_req_array(j: Json, key: string, where: string) -> Result[[Json], string] {
  match get(j, key) {
    None => Err("${where}.${key}: missing"),
    Some(v) => match asArray(v) {
      None => Err("${where}.${key}: not an array"),
      Some(xs) => Ok(xs)
    }
  }
}

-- SOURCE src/core/journal.ail L403-417 B18400-18839 sha256:6be8763c26d9fdea96159173edab7365855db269bfa03a026f4bb8a07a7c1c42 symbol=tool_call_of_json
pure func ev_tool_call_of_json(j: Json, where: string) -> Result[ToolCall, string] {
  match ev_req_string(j, "id", where) {
    Err(e) => Err(e),
    Ok(id) => match ev_req_string(j, "name", where) {
      Err(e) => Err(e),
      Ok(name) => match ev_req_string(j, "arguments", where) {
        Err(e) => Err(e),
        Ok(args) => {
          let c: ToolCall = { id: id, name: name, arguments: args };
          Ok(c)
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L426-437 B19433-19760 sha256:3b5e26cd912bfe8c74ceae40f72a7a69c1f290a4d98d7672e9160ec2164ff7e5 symbol=tool_calls_of_json
@allow_empty_ok("a message with no tool calls is the common case, not a decode failure — an assistant without calls and a user message both carry []")
pure func ev_tool_calls_of_json(xs: [Json], where: string) -> Result[[ToolCall], string] {
  match xs {
    [] => Ok([]),
    j :: rest => match ev_tool_call_of_json(j, where) {
      Err(e) => Err(e),
      Ok(c) => match ev_tool_calls_of_json(rest, where) {
        Err(e) => Err(e),
        Ok(cs) => Ok(c :: cs)
      }
    }
  }
}

-- SOURCE src/core/journal.ail L439-450 B19761-20095 sha256:351415c33650b95c4130278aa7f90ba66a2d5d217a248373d4fd972a91280809 symbol=image_of_json
pure func ev_image_of_json(j: Json, where: string) -> Result[ImagePart, string] {
  match ev_req_string(j, "source", where) {
    Err(e) => Err(e),
    Ok(source) => match ev_req_string(j, "mime", where) {
      Err(e) => Err(e),
      Ok(mime) => {
        let i: ImagePart = { source: source, mime: mime };
        Ok(i)
      }
    }
  }
}

-- SOURCE src/core/journal.ail L453-464 B20228-20544 sha256:e1d2a7c03034e4dcbc45a85c23b932c170a693542ff0380ac8e4f90d73c2296e symbol=images_of_json
@allow_empty_ok("a text-only message carries no images — [] is what every message in a history without vision inputs decodes to")
pure func ev_images_of_json(xs: [Json], where: string) -> Result[[ImagePart], string] {
  match xs {
    [] => Ok([]),
    j :: rest => match ev_image_of_json(j, where) {
      Err(e) => Err(e),
      Ok(i) => match ev_images_of_json(rest, where) {
        Err(e) => Err(e),
        Ok(is) => Ok(i :: is)
      }
    }
  }
}

-- SOURCE src/core/journal.ail L466-498 B20545-21694 sha256:506361f0197d8d41accf7eb4119e84ff07762377d1a9596acd35e4d3660e9dbc symbol=message_of_json_at
pure func ev_message_of_json_at(j: Json, where: string) -> Result[Message, string] {
  match ev_req_string(j, "role", where) {
    Err(e) => Err(e),
    Ok(role) => match ev_req_string(j, "content", where) {
      Err(e) => Err(e),
      Ok(content) => match ev_req_string(j, "tool_call_id", where) {
        Err(e) => Err(e),
        Ok(tool_call_id) => match ev_req_array(j, "tool_calls", where) {
          Err(e) => Err(e),
          Ok(raw_calls) => match ev_tool_calls_of_json(raw_calls, "${where}.tool_calls") {
            Err(e) => Err(e),
            Ok(calls) => match ev_req_array(j, "images", where) {
              Err(e) => Err(e),
              Ok(raw_images) => match ev_images_of_json(raw_images, "${where}.images") {
                Err(e) => Err(e),
                Ok(images) => {
                  let m: Message = {
                    role: role,
                    content: content,
                    tool_calls: calls,
                    tool_call_id: tool_call_id,
                    images: images
                  };
                  Ok(m)
                }
              }
            }
          }
        }
      }
    }
  }
}

-- SOURCE src/core/journal.ail L507-511 B22000-22072 sha256:6bee45d9015d74a8edd6714d23aa204f948a0d958f5f3ef86e516cb9b0b87a3c symbol=MessageDecodeAcc
type EvMessageDecodeAcc = {
  idx: int,
  out: [Message],
  err: string
}

-- SOURCE src/core/journal.ail L513-515 B22073-22152 sha256:a0fb14e101b5290a9d6852ba232e306b400742da7e1f241b30d44b7507d04583 symbol=cons_message
pure func ev_cons_message(acc: [Message], m: Message) -> [Message] {
  m :: acc
}

-- SOURCE src/core/journal.ail L537-539 B23381-23475 sha256:c9151dfeb27eae8726a9871eb447a8dead0f69160ca0492cb1fc88dd66cfd7e2 symbol=reverse_messages
pure func ev_reverse_messages(ms: [Message]) -> [Message] {
  List.foldl(ev_cons_message, [], ms)
}

-- SOURCE src/core/journal.ail L541-548 B23476-23828 sha256:de7271e3dc9bee0a4507459399a058f8b9c156202af9034cf565552842173af8 symbol=message_decode_step
pure func ev_message_decode_step(acc: EvMessageDecodeAcc, j: Json) -> EvMessageDecodeAcc {
  if acc.err != ""
  then { idx: acc.idx + 1, out: acc.out, err: acc.err }
  else match ev_message_of_json_at(j, "messages[${show(acc.idx)}]") {
    Err(e) => { idx: acc.idx + 1, out: acc.out, err: e },
    Ok(m) => { idx: acc.idx + 1, out: m :: acc.out, err: "" }
  }
}

-- SOURCE src/core/journal.ail L552-560 B23988-24315 sha256:14514329cd3a204039d55967e52a323b00f4d540acecddc02874bb699e69a44b symbol=messages_of_json
pure func ev_messages_of_json(j: Json) -> Result[[Message], string] {
  match asArray(j) {
    None => Err("messages: not an array"),
    Some(xs) => {
      let acc = List.foldl(ev_message_decode_step, { idx: 0, out: [], err: "" }, xs);
      if acc.err != "" then Err(acc.err) else Ok(ev_reverse_messages(acc.out))
    }
  }
}


-- ============================================================================
-- Copies: The refusal (journal).
-- ============================================================================

-- SOURCE src/core/journal.ail L581-592 B25494-25675 sha256:ed08c64b5215bc625e176492efad1c6adaffa22e2da8879ea580340061205ae2 symbol=Refusal
export type EvRefusal
  = EvHeader
  | EvEntry(int, string)
  | EvDigest(int)
  | EvHeadPrefix
  | EvTranscript(string)
  | EvPairing(int)
  | EvWorkdir
  | EvExtSet
  | EvPrompt
  | EvLeased
  | EvSchema

-- SOURCE src/core/journal.ail L594-608 B25676-26044 sha256:078101cddca22da9c85aeaf1fe151d1004bc57893f52942b30207cc4fc2f1768 symbol=refusal_id
pure func ev_refusal_id(r: EvRefusal) -> string {
  match r {
    EvHeader => "header",
    EvEntry(_, _) => "entry",
    EvDigest(_) => "digest",
    EvHeadPrefix => "head-prefix",
    EvTranscript(_) => "transcript",
    EvPairing(_) => "pairing",
    EvWorkdir => "workdir",
    EvExtSet => "ext-set",
    EvPrompt => "prompt",
    EvLeased => "leased",
    EvSchema => "schema"
  }
}


