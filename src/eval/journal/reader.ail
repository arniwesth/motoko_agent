-- ---- M1: the clean twins ----------------------------------------------------

-- The twin of every refused fixture above: the same journal, unbroken.
pure func test_m1_clean_twin_reads() -> bool
  tests [((), true)]
  {
    reads(fxj_clean()) && (match fx_read(fxj_clean()) {
      Err(_) => false,
      Ok(src) =>
        src.path_length == 24 && src.header.schema_version == 1
          && List.length(src.leaf_state.dangling) == 0
          && eval_boundary_id(src.leaf_state.last) == "suspended"
    })
  }

-- The stray wakes' twin: a park answered once, by its own request, decodes and
-- is not refused; the park lies after the segment's cut.
pure func test_m1_clean_twin_park_and_wake() -> bool
  tests [((), true)]
  {
    reads(fxj_park_wake()) && (match fx_read(fxj_park_wake()) {
      Err(_) => false,
      Ok(src) => List.length(segment_parks(src.segment)) == 0 && not src.opened_by_wake
    })
  }

pure func test_m1_twelve_entry_types_decode() -> bool
  tests [((), true)]
  {
    List.length(ev_all_entry_types()) == 12
      && ev_contains_string(ev_all_entry_types(), "park")
      && ev_contains_string(ev_all_entry_types(), "wake")
  }

-- ---- D1: the seed, the segment, the inputs to later parts -------------------

-- r2.1's shape: run_started (e11), a leading user entry (e12), the first
-- assistant (e13) is `start`. The seed is the fold through e12: six messages,
-- the user message last, the model from the `settings` entry before the run.
pure func test_seed_r21_leading_user() -> bool
  tests [((), true)]
  {
    reads(fxj_clean()) && (match fx_read(fxj_clean()) {
      Err(_) => false,
      Ok(src) =>
        src.run_started_seq == 11 && src.start_seq == 13
          && List.length(src.seed) == 6
          && src.seed_digest == eval_payload_digest(src.seed)
          && src.seed_state.model == "fx/model-b"
          && eval_boundary_id(src.seed_state.last) == "open:history_appended"
          && (match List.foldl(\acc m. Some(m), None, src.seed) {
                None => false,
                Some(m) => m.role == "user" && m.content == "now count the lines"
              })
    })
  }

-- `EndAt` keeps the named call's turn; `CutoffBefore` keeps nothing from the
-- named entry on.
pure func test_segment_end_forms() -> bool
  tests [((), true)]
  {
    reads(fxj_clean()) && reads(fxj_clean_cutoff_before())
      && (match fx_read(fxj_clean()) {
            Err(_) => false,
            Ok(src) => List.length(src.segment) == 9 && ints_eq(segment_call_counts(src.segment), [1, 1, 1])
          })
      && (match fx_read(fxj_clean_cutoff_before()) {
            Err(_) => false,
            Ok(src) => List.length(src.segment) == 3 && ints_eq(segment_call_counts(src.segment), [1])
          })
  }

pure func last_assistant_calls(seg: [SegmentEntry]) -> int {
  List.foldl(\acc x. match x {
    SegAppended(_, a) => if a.message.role == "assistant" then List.length(a.message.tool_calls) else acc,
    _ => acc
  }, -1, seg)
}

-- The dangling-call repair is the seed's only: the leaf ends in an unanswered
-- call, the whole-path fold strips and reports it, the segment keeps it.
pure func test_repair_is_the_seeds_only() -> bool
  tests [((), true)]
  {
    reads(fxj_incomplete_tail()) && (match fx_read(fxj_incomplete_tail()) {
      Err(_) => false,
      Ok(src) =>
        strings_eq(src.leaf_state.dangling, ["c4"])
          && List.length(src.seed_state.dangling) == 0
          && last_assistant_calls(src.segment) == 1
    })
  }

-- A `park` inside the segment is decoded and reported (P1.3's `Parked`
-- cutoff), not refused.
pure func test_park_in_segment_is_reported() -> bool
  tests [((), true)]
  {
    reads(fxj_park_in_segment()) && (match fx_read(fxj_park_in_segment()) {
      Err(_) => false,
      Ok(src) => ints_eq(segment_parks(src.segment), [22])
    })
  }

-- A run opened by a consumed wake is flagged (P1.2b's `ContinuationStart`);
-- a run opened after a `run_finished` is not.
pure func test_wake_opened_run_is_flagged() -> bool
  tests [((), true)]
  {
    reads(fxj_wake_opened_run()) && (match fx_read(fxj_wake_opened_run()) {
      Err(_) => false,
      Ok(src) => src.opened_by_wake && src.run_started_seq == 24
    }) && (match fx_read(fxj_clean()) {
      Err(_) => false,
      Ok(src) => not src.opened_by_wake
    })
  }

pure func test_bad_selector_is_the_readers_precondition() -> bool
  tests [((), true)]
  {
    refused_as(fxj_bad_selector_start(), "BadSelector", "path", "start")
      && refused_as(fxj_bad_selector_not_first_call(), "BadSelector", "path", "start")
  }

-- ---- Equality with the independent generator --------------------------------

pure func test_fold_equals_generator() -> bool
  tests [((), true)]
  {
    List.length(fxj_all()) == 24 && List.foldl(\acc f. acc && fold_agrees(f), true, fxj_all())
  }

pure func test_reader_equals_generator() -> bool
  tests [((), true)]
  {
    List.length(fxj_all()) == 24 && List.foldl(\acc f. acc && reader_agrees(f), true, fxj_all())
  }

-- ---- M15: the near-misses pass M1's refusals ---------------------------------

pure func nth_tool_content(seg: [SegmentEntry], k: int) -> string {
  let acc = List.foldl(\a x. match x {
    SegAppended(_, e) => if e.message.role == "tool" then { n: a.n + 1, out: if a.n + 1 == k then e.message.content else a.out } else a,
    _ => a
  }, { n: 0, out: "" }, seg);
  acc.out
}

pure func nth_assistant_content(seg: [SegmentEntry], k: int) -> string {
  let acc = List.foldl(\a x. match x {
    SegAppended(_, e) => if e.message.role == "assistant" then { n: a.n + 1, out: if a.n + 1 == k then e.message.content else a.out } else a,
    _ => a
  }, { n: 0, out: "" }, seg);
  acc.out
}

-- ChainBreak's near-miss: the tool result at call 1 changed and the chain
-- re-computed. M1 passes; call 2 exists, is a continuation (one call, one
-- result) and is not the terminal call (three calls). The catching check's
-- half — AdmissionCheck(A3) at Call(2) — is P1.7a-v2's.
pure func test_m15_near_miss_chain_break_passes_m1() -> bool
  tests [((), true)]
  {
    reads(fxj_near_miss_chain_break()) && (match fx_read(fxj_near_miss_chain_break()) {
      Err(_) => false,
      Ok(nm) => match fx_read(fxj_clean()) {
        Err(_) => false,
        Ok(clean) =>
          nth_tool_content(nm.segment, 1) != nth_tool_content(clean.segment, 1)
            && nth_tool_content(nm.segment, 2) == nth_tool_content(clean.segment, 2)
            && ints_eq(segment_call_counts(nm.segment), [1, 1, 1])
            && nth_tool_content(nm.segment, 2) != ""
            && nm.seed_digest == clean.seed_digest
      }
    })
  }

-- MalformedEntry's near-miss: call 1's assistant append with changed content,
-- same type, chain re-computed. M1 passes; the next evaluated call (call 2)
-- exists. The catching check's half — AdmissionCheck(A3) at Call(2) — is
-- P1.7a-v2's.
pure func test_m15_near_miss_malformed_entry_passes_m1() -> bool
  tests [((), true)]
  {
    reads(fxj_near_miss_malformed_entry()) && (match fx_read(fxj_near_miss_malformed_entry()) {
      Err(_) => false,
      Ok(nm) => match fx_read(fxj_clean()) {
        Err(_) => false,
        Ok(clean) =>
          nth_assistant_content(nm.segment, 1) != nth_assistant_content(clean.segment, 1)
            && nth_assistant_content(nm.segment, 2) == nth_assistant_content(clean.segment, 2)
            && ints_eq(segment_call_counts(nm.segment), [1, 1, 1])
            && nm.seed_digest == clean.seed_digest
      }
    })
  }
