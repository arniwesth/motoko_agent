-- ---- M2: MalformedToolArguments -----------------------------------------------

pure func test_m2_malformed_tool_arguments() -> bool
  tests [((), true)]
  { run_refused_as(fxr_m2_malformed_tool_arguments(), "MalformedToolArguments", "entry:13", "tool_calls[1].arguments") }

pure func test_arguments_json_equality() -> bool
  tests [((), true)]
  {
    match decode_arguments("{ \"b\" : 1, \"a\" : [1, 2.5], \"c\": {\"z\": null, \"y\": true} }") {
      Err(_) => false,
      Ok(x) => match decode_arguments("{\"c\":{\"y\":true,\"z\":null},\"a\":[1.0,2.5],\"b\":1}") {
        Err(_) => false,
        Ok(reordered) => match decode_arguments("{\"b\":1,\"a\":[2.5,1],\"c\":{\"z\":null,\"y\":true}}") {
          Err(_) => false,
          Ok(swapped) => match decode_arguments("{\"b\":2,\"a\":[1,2.5],\"c\":{\"z\":null,\"y\":true}}") {
            Err(_) => false,
            Ok(changed) =>
              arguments_equal(x.arguments, reordered.arguments)
                && x.canonical != reordered.canonical
                && x.canonical == "{\"b\":1,\"a\":[1,2.5],\"c\":{\"z\":null,\"y\":true}}"
                && not arguments_equal(x.arguments, swapped.arguments)
                && not arguments_equal(x.arguments, changed.arguments)
                && (match decode_arguments("{bad") { Err(_) => true, Ok(_) => false })
          }
        }
      }
    }
  }

