-- ---- M2: UnexpectedToolResult --------------------------------------------------

-- The fold's pairing refusal at a TOOL result is D1's UnexpectedToolResult at
-- this layer; P1.2a's layer still reports MalformedEntry(pairing) for it.
pure func test_m2_unexpected_tool_result_pairing() -> bool
