pure func test_m2_unexpected_tool_result_stale() -> bool
  tests [((), true)]
  { run_refused_as(fxr_m2_unexpected_result_stale(), "UnexpectedToolResult", "entry:18", "tool_call_id") }

-- A pairing refusal at an ASSISTANT is not attribution: it stays P1.2a's.
pure func test_m2_pairing_at_assistant_stays_malformed_entry() -> bool
  tests [((), true)]
