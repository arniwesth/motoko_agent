-- ---- M2: EmptySegment ----------------------------------------------------------

-- The retry at call 1 leaves no evaluated call.
pure func test_m2_empty_segment() -> bool
  tests [((), true)]
  { run_refused_as(fxr_m2_empty_segment(), "EmptySegment", "entry:13", "ProviderRetry") }

-- ---- M15: the near-misses pass M2's refusals ---------------------------------

pure func nth_call(rr: RunRead, k: int) -> Option[AssociatedCall] {
  List.foldl(\acc c. if c.k == k then Some(c) else acc, None, rr.calls)
}

pure func first_tool_content(c: Option[AssociatedCall]) -> string {
  match c {
    None => "",
    Some(x) => match x.tools { [] => "", t :: _ => t.content }
  }
}

pure func both(f: RunFixture) -> Option[{ nm: RunRead, clean: RunRead }] {
  match fx_run(f) {
    Err(_) => None,
    Ok(nm) => match fx_run(fxr_m2_clean()) {
      Err(_) => None,
      Ok(clean) => Some({ nm: nm, clean: clean })
    }
  }
}

-- A correctly attributed result at call 1 with one content byte changed; call
-- 2 exists. The catching check's half — AdmissionCheck(A3) at Call(2) — is
-- P1.7a-v2's.
pure func test_m15_near_miss_unexpected_tool_result_passes_m2() -> bool
  tests [((), true)]
  {
    run_reads(fxr_m15_unexpected_tool_result()) && (match both(fxr_m15_unexpected_tool_result()) {
      None => false,
      Some(p) =>
        first_tool_content(nth_call(p.nm, 1)) != first_tool_content(nth_call(p.clean, 1))
          && first_tool_content(nth_call(p.nm, 2)) == first_tool_content(nth_call(p.clean, 2))
          && List.length(p.nm.calls) == 3
          && as_strings_eq(concat_strings(List.map(tool_ids, p.nm.calls)), concat_strings(List.map(tool_ids, p.clean.calls)))
    })
  }

-- Decodable arguments at call 1 with one value changed (JSON-inequal); call 2
-- exists. P1.7a-v2: AdmissionCheck(A3) at Call(2).
pure func test_m15_near_miss_malformed_tool_arguments_passes_m2() -> bool
  tests [((), true)]
  {
    run_reads(fxr_m15_malformed_tool_arguments()) && (match both(fxr_m15_malformed_tool_arguments()) {
      None => false,
      Some(p) => match nth_call(p.nm, 1) {
        None => false,
        Some(c1) => match nth_call(p.clean, 1) {
          None => false,
          Some(d1) => match c1.calls {
            [] => false,
            a :: _ => match d1.calls {
              [] => false,
              b :: _ =>
                not arguments_equal(a.arguments, b.arguments) && a.call_id == b.call_id
                  && List.length(p.nm.calls) == 3
          }
          }
        }
      }
    })
  }

-- Unique ids with call 1's two results swapped. What D1's ordered association
-- does with it, asserted first: it ACCEPTS, attributing each result by id and
-- keeping the journal order (c2b before c2a) — so the M15 row is applicable:
-- P1.7a-v2 pins the seam's ToolCorrelationMismatch as AdmissionCheck(A2) at the
-- first swapped result (entry:14).
pure func test_m15_near_miss_duplicate_call_id_swap_is_accepted() -> bool
  tests [((), true)]
  {
    run_reads(fxr_m15_duplicate_call_id_swap()) && (match fx_run(fxr_m15_duplicate_call_id_swap()) {
      Err(_) => false,
      Ok(rr) => match nth_call(rr, 1) {
        None => false,
        Some(c) =>
          as_strings_eq(tool_ids(c), ["c2b", "c2a"]) && as_ints_eq(tool_seqs(c), [14, 15])
            && as_strings_eq(List.map(\a. a.call_id, c.calls), ["c2a", "c2b"])
            && List.length(c.unanswered) == 0
      }
    })
  }

-- A same-run, correctly associated excerpt whose `payload_digest` at call 1 is
-- altered. P1.7a-v2: AdmissionCheck(A3) at Call(1).
pure func test_m15_near_miss_association_passes_m2() -> bool
  tests [((), true)]
  {
    run_reads(fxr_m15_association()) && (match both(fxr_m15_association()) {
      None => false,
      Some(p) => match nth_call(p.nm, 1) {
        None => false,
        Some(c1) => match nth_call(p.clean, 1) {
          None => false,
          Some(d1) =>
            c1.prepared.payload_digest != d1.prepared.payload_digest
              && c1.prepared.payload_digest == "sha256:fx-altered"
              && c1.prepared.index == d1.prepared.index
              && as_ints_eq(List.map(\c. c.assistant_seq, p.nm.calls), [13, 17, 20])
        }
      }
    })
  }
