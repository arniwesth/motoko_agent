    let f = fxj_malformed_pairing();
    let sel = { leaf: f.leaf, run_id: f.run_id, start: f.start, end: EndAt(f.end_id) };
    f.end_kind == "EndAt" && (match parse_lines(f.lines) {
      Err(_) => false,
      Ok(ls) => match read_run(ls, fxr_m2_clean().log, sel) {
        Ok(_) => false,
        Err(r) => run_refusal_family(r) == "UnexpectedToolResult" && run_refusal_position(r) == "entry:14"
      }
    })
  }

-- A result after a call-free assistant naming the batch before it: the fold
