  Ports, ProviderExchange, WorldState, ClockReading, ApprovalInput, EnvRead,
  ScriptedStep, empty_world_state, ports_shape_probe, virtual_clock,
  ambient_env, ambient_file, ambient_file_write, ambient_file_remove, ambient_path_stat, ambient_dir_list, ambient_dir_make, -- WI-D18's directory trio, widened onto THIS line rather than a new one: stub_step.ail:203 is an A5 attribution anchor (S18)
  record_interaction, recording_clock, recording_approval, recording_env, recording_tool, recording_ext_effect, recording_file_write, recording_file_remove, recording_dir_make, encode_provider_outcome, encode_exhausted_provider_outcome, generated_provider_entry, generating_tool, generating_approval, scripted_step_ai_error, scripted_step_faults, provider_outcome_record
)
