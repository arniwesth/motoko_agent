-- src/core/test/scripted_ports.ail
--
-- State-threaded scripted fakes for Phase C ports. These helpers are pure
-- where possible; full-loop parity entrypoints pass a port-backed provider.

module src/core/test/scripted_ports

import std/ai (Message, StepResult, ToolCall, AIError, StreamChunk)
import std/json (jo)
import std/list as List (length)
import std/result (Result, Ok, Err)
import std/trace as Trace
import src/core/ports (ScriptedStep, ApprovalResolution, ApprovalAllowed, ApprovalDenied, Ports, ProviderExchange, WorldState, ports_shape_probe, virtual_clock)
import src/core/phase_vocab (ApprovalRequest, ExecNative)
import src/core/test/stub_step (StepProvider, Scripted, LiveAI, Ported, scripted_to_step_result)
import src/core/config (CostRates, VerificationConfig)
import pkg/sunholo/motoko_ext_abi/types (BudgetPlan, ExtRuntime)
import src/core/session as Session

export type ScriptedPortsState = {
  model_steps: [ScriptedStep],
  approvals: [ApprovalResolution],
  clock_values: [int]
}

export pure func scripted_state(model_steps: [ScriptedStep], approvals: [ApprovalResolution], clock_values: [int]) -> ScriptedPortsState {
  { model_steps: model_steps, approvals: approvals, clock_values: clock_values }
}

export pure func state_from_step_provider(provider: StepProvider) -> ScriptedPortsState {
  match provider {
    Scripted(steps) => scripted_state(steps, [], []),
    LiveAI => scripted_state([], [], []),
    Ported(_) => scripted_state([], [], [])
  }
}

export pure func scripted_model_next(state: ScriptedPortsState) -> { result: Result[StepResult, AIError], next: ScriptedPortsState } {
  match state.model_steps {
    [] => {
      let err: AIError = { code: "ScriptExhausted", message: "scripted model exhausted", retryable: false };
      { result: Err(err), next: state }
    },
    s :: rest => {
      { result: Ok(scripted_to_step_result(s)), next: { model_steps: rest, approvals: state.approvals, clock_values: state.clock_values } }
    }
  }
}

export pure func scripted_approval_next(state: ScriptedPortsState, default_allow: bool) -> { resolution: ApprovalResolution, next: ScriptedPortsState } {
  match state.approvals {
    [] => {
      let res = if default_allow then ApprovalAllowed else ApprovalDenied("default deny");
      { resolution: res, next: state }
    },
    x :: rest => {
      { resolution: x, next: { model_steps: state.model_steps, approvals: rest, clock_values: state.clock_values } }
    }
  }
}

export pure func scripted_clock_next(state: ScriptedPortsState) -> { value: int, next: ScriptedPortsState } {
  match state.clock_values {
    [] => { value: 0, next: state },
    x :: rest => { value: x, next: { model_steps: state.model_steps, approvals: state.approvals, clock_values: rest } }
  }
}

func fake_model(state: WorldState, _model: string, _msgs: [Message], _on_chunk: (StreamChunk) -> () ! {IO}) -> ProviderExchange ! {AI, IO, Trace} {
  let err: AIError = { code: "ScriptedPorts", message: "use scripted_model_next for state-threaded tests", retryable: false };
  { emissions: [], result: Err(err), next_state: state }
}

export func fake_ports() -> Ports {
  ports_shape_probe(fake_model)
}

export func run_v2_with_scripted_ports(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  script: [ScriptedStep]
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  -- WI-A2: the script rides in WorldState now, so wrapping a Ports in
  -- Ported() here would strand it. Hand the entry point Scripted(script) and
  -- let `ported_provider` build the (ports, initial state) pair.
  Session.run_v2_from_messages(rt, task, env_url, hybrid_tools, budget, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, Scripted(script))
}

pure func tool_call() -> ToolCall {
  { id: "tc", name: "ReadFile", arguments: "{}" }
}

pure func scripted_step() -> ScriptedStep {
  { prose: "", tool_calls: [tool_call()], input_tokens: 3, output_tokens: 4, finish_reason: "tool_calls", chunks: [], error_code: "", error_message: "", advance_ms: 0 }
}

pure func test_scripted_model_threads_state() -> bool
  tests [((), true)]
  {
    let s0 = scripted_state([scripted_step()], [], []);
    let s1 = scripted_model_next(s0);
    match s1.result {
      Ok(r) => List.length(r.tool_calls) == 1 && List.length(s1.next.model_steps) == 0,
      Err(_) => false
    }
  }

pure func test_state_from_step_provider_preserves_script() -> bool
  tests [((), true)]
  {
    let state = state_from_step_provider(Scripted([scripted_step()]));
    List.length(state.model_steps) == 1
  }

pure func test_scripted_approval_defaults_on_exhaustion() -> bool
  tests [((), true)]
  {
    let s0 = scripted_state([], [], []);
    match scripted_approval_next(s0, true).resolution {
      ApprovalAllowed => true,
      _ => false
    }
  }

pure func test_scripted_approval_consumes_script() -> bool
  tests [((), true)]
  {
    let s0 = scripted_state([], [ApprovalDenied("no")], []);
    let s1 = scripted_approval_next(s0, true);
    match s1.resolution {
      ApprovalDenied(r) => r == "no" && List.length(s1.next.approvals) == 0,
      _ => false
    }
  }

pure func test_scripted_clock_threads_state() -> bool
  tests [((), true)]
  {
    let s0 = scripted_state([], [], [10, 11]);
    let s1 = scripted_clock_next(s0);
    let s2 = scripted_clock_next(s1.next);
    s1.value == 10 && s2.value == 11 && List.length(s2.next.clock_values) == 0
  }

pure func test_fake_ports_constructs_record() -> bool
  tests [((), true)]
  {
    let _ = jo([]);
    true
  }
