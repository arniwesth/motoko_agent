-- D2's STRICT REPLAY: consume an exact execution program, reconstitute the
-- world from it, and require causal identity and recorded projections to match.
--
-- WI-A13, stage 3. This module holds the ASSERTION and the RECONSTITUTION.
-- Written before the replay loop that consumes it (standing rule S1), and the
-- loop lives in `scripts/dst/strict_replay_dst.ail` where a real driver run is
-- in scope.
--
-- ---------------------------------------------------------------------------
-- THE WEAKNESS THIS MODULE IS BUILT AGAINST, STATED BEFORE THE CODE
-- ---------------------------------------------------------------------------
--
-- D2's strict-replay contract is *"the exact program reproduces the same
-- interaction log, terminal outcome and trace"*. That is a DETERMINISM
-- contract, and determinism is 0-for-18 across eight clusters in this project:
-- it caught neither cluster 1's frozen cursor, nor cluster 4's dropped record,
-- nor A12's four, nor stage 1's over-strict validator, nor stage 2's three.
--
-- The specific way it fails HERE is worth naming precisely, because everything
-- below is shaped by it:
--
--   STRICT REPLAY COMPARES RECORDED AGAINST ACTUAL, AND IF BOTH SIDES DERIVE
--   FROM THE SAME DEFECTIVE PROJECTION THEY AGREE.
--
-- Three concrete instances:
--
--   * A `world_state_of` that drops a class reconstitutes a world that never
--     serves it, the replay makes no requests of that class, and the comparison
--     passes.
--   * A replayed run whose recorder has the same gap as the discovery recorder
--     produces a log that matches the program BECAUSE BOTH ARE WRONG IN THE
--     SAME WAY — and this one is structural, not hypothetical: strict replay
--     re-uses `recording_ports`, the very recorder that produced the program.
--   * A world missing a queue serves defaults CONSISTENTLY, and consistently is
--     all this contract asks.
--
-- Program-versus-log agreement is therefore the recorder grading itself, one
-- level up. Two things answer that, and both are executable:
--
--   1. `reconstitution_balance` below. `world_state_of` is the one projection
--      strict replay adds, so it gets its own two-sided count check against the
--      program it was built from — the same shape `dst_discovery.class_balance`
--      uses, for the same reason.
--   2. THE REPLAYED RUN IS GRADED BY STAGE 2'S INDEPENDENT WITNESSES, not only
--      by this comparison. A replayed run is a run: it has a ledger trace
--      written by production code, world cursors moved by the response-producing
--      adapters, and a clock. `dst_discovery.check_discovery` grades it exactly
--      as it grades discovery, and a replay that drops a class then fails the
--      WITNESS balance even when it matches the program perfectly. That call is
--      in the acceptance script, and the script carries a fixture which matches
--      the program and fails the witness, so the distinction is asserted rather
--      than claimed.
--
-- ---------------------------------------------------------------------------
-- WHAT THE PROGRAM CARRIES, AND WHAT IT DELIBERATELY DOES NOT
-- ---------------------------------------------------------------------------
--
-- `dst_program`'s design note 3: the program does NOT carry the provider
-- script, the approval queue or the tool queue, because "if the program carried
-- both, a program could serve a response that no interaction records, which is
-- the exact shape of the completeness defect this item exists to prevent."
--
-- `world_state_of` therefore DERIVES those three queues from the interaction
-- list. That constraint is what makes the invariant structural rather than
-- asserted: a served response necessarily has a recorded interaction behind it,
-- because the response IS the recorded interaction, read back.
--
-- The constraint has a cost, and stage 3 paid it rather than routing around it:
-- a recorded outcome must be SUFFICIENT TO RE-SERVE THE RESPONSE. Stage 2's
-- provider recorder wrote only the prose, so a program discovered from a run
-- with tool calls reconstituted a script that made none, and the replay
-- terminated at step 0. That is not a replay defect; it is an under-recording
-- of the provider outcome relative to D2, which says a provider timed outcome
-- ends in "a final StepResult or AIError". The fix is in the RECORDED OUTCOME
-- (`ports.encode_provider_outcome`), not in the program's shape — adding a
-- script field to `ExecutionProgram` is the defect design note 3 exists to
-- prevent, and it is not done here.

module src/core/dst_replay

import std/list as List (length)
import std/string as Str (contains)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import src/core/dst_interaction (
  Interaction,
  IdentityBody,
  ProviderIdentity, ToolIdentity, ApprovalIdentity, ExtensionEffectIdentity,
  ClockAdvanceIdentity,
  StreamChunkRecord,
  OutcomeStatus, OutcomeOk, OutcomeFault, OutcomeMissing,
  TimedOutcome,
  identity_kind,
  identity_origin,
  identity_body_eq,
  identity_projection,
  interaction_kind,
  outcome_status_id,
  count_kind,
  approvals_served
)
import src/core/dst_program (ExecutionProgram, validate_program, program_rule, program_schema_version)
-- WI-D22: `InitialWorld.files` is kinded, so the fixtures here construct nodes.
import src/core/fs_node (FsNode, FsFile, FsDir)
import src/core/dst_result (
  DstResult, RunFailed,
  HarnessFailure,
  HarnessFailureKind, ProgramMismatch, InvalidProgram, InteractionsExhausted,
  ReplayMetadata
)
import src/core/phase_vocab (LedgerTrace)
import src/core/dst_profile (ExecutionManifest)
import src/core/ports (
  WorldState, ScriptedStep, ScriptedTool, empty_world_state,
  ProviderOutcome, ProviderServed, ProviderScriptExhausted, ProviderUndecodable,
  ToolOutcome, ToolCompleted,
  ToolOutcomeRecord, ToolRecordDecoded, ToolRecordUndecodable,
  decode_provider_outcome, decode_tool_outcome,
  encode_provider_outcome, encode_exhausted_provider_outcome, encode_tool_outcome
)

-- ---------------------------------------------------------------------------
-- Divergence between the program and the run that replayed it
-- ---------------------------------------------------------------------------

-- D2 names four things that are a `HarnessFailure` "and not a simulated system
-- fault": a wrong kind/origin, an unsafe identity mismatch, an exhausted
-- program, and an unused interaction. All four are here, plus the two
-- projection comparisons the same sentence requires ("recorded projections to
-- match").
--
-- `UnusedInteraction` is the one most easily forgotten, because NOTHING FAILS
-- WITHOUT IT: a replay that stops early produces a log that agrees with every
-- position it did reach. It is the mirror of `ProgramExhausted` and the two are
-- the two arms of one walk, so neither can be deleted without the other staring
-- back — the discipline `dst_discovery.class_balance` established.
export type ReplayMismatch
  = WrongKind(int, string, string)          -- position, expected kind, actual kind
  | WrongOrigin(int, string, string)        -- position, expected origin, actual origin
  | UnsafeIdentity(int, string, string)     -- position, expected identity, actual identity
  | ProjectionDiffers(int, string, string)  -- position, expected projection, actual
  | OutcomeDiffers(int, string, string)     -- position, expected outcome, actual
  | ProgramExhausted(int, string)           -- position, the actual request that had no interaction
  | UnusedInteraction(int, string)          -- position, the interaction nothing requested

export pure func replay_rule(m: ReplayMismatch) -> string {
  match m {
    WrongKind(_, _, _) => "replay-wrong-kind",
    WrongOrigin(_, _, _) => "replay-wrong-origin",
    UnsafeIdentity(_, _, _) => "replay-unsafe-identity-mismatch",
    ProjectionDiffers(_, _, _) => "replay-projection-differs",
    OutcomeDiffers(_, _, _) => "replay-outcome-differs",
    ProgramExhausted(_, _) => "replay-program-exhausted",
    UnusedInteraction(_, _) => "replay-unused-interaction"
  }
}

export pure func replay_message(m: ReplayMismatch) -> string {
  match m {
    WrongKind(p, e, a) =>
      "[replay-wrong-kind] at interaction position ${p} the program records a '${e}' and the driver requested a '${a}'; D2 makes a wrong kind a HarnessFailure and not a simulated system fault, because delivering one class's recorded outcome to another class's request is not a reproduction of anything",
    WrongOrigin(p, e, a) =>
      "[replay-wrong-origin] at interaction position ${p} the program records origin '${e}' and the driver requested from '${a}'; the origin names the producer, so a match on kind alone would deliver an extension's recorded outcome to the driver's own request",
    UnsafeIdentity(p, e, a) =>
      "[replay-unsafe-identity-mismatch] at interaction position ${p} the program records ${e} and the driver requested ${a}; strict replay requires causal identity to MATCH, and D2 forbids delivering an outcome to a different logical request even when the kind and origin agree — a repeated call id at a different ordinal is exactly the shape stage 1's validator keeps representable so this check, and not the decoder, reports it",
    ProjectionDiffers(p, e, a) =>
      "[replay-projection-differs] at interaction position ${p} the program records request projection '${e}' and the driver produced '${a}'; strict replay requires the recorded projections to match, and the projection is what carries the arguments and message digests D2 says are recorded rather than silently discarded",
    OutcomeDiffers(p, e, a) =>
      "[replay-outcome-differs] at interaction position ${p} the program records outcome ${e} and the replay served ${a}; the world is reconstituted FROM the program, so a differing outcome means the reconstitution lost something the recording carried — which is the one projection strict replay adds and therefore the one it must check",
    ProgramExhausted(p, a) =>
      "[replay-program-exhausted] the driver made request ${a} at position ${p} and the program holds no interaction there; D2 makes an exhausted program a HarnessFailure, because a replay that runs past the end of its program is reproducing something the program never described",
    UnusedInteraction(p, e) =>
      "[replay-unused-interaction] the program records ${e} at position ${p} and the driver never requested it; D2 makes an unused interaction a HarnessFailure, and it is the mismatch that fails SILENTLY without this rule — a replay which stops early agrees with the program at every position it did reach"
  }
}

-- ---------------------------------------------------------------------------
-- THE DEMOTION SET — D2's SECOND REPLAY MODE, AND ITS ONE IRREVOCABLE LINE
-- ---------------------------------------------------------------------------
--
-- D2 permits regression replay to "require compatible causal identity, record
-- projection differences, and continue", and binds it in the same sentence:
-- it "never weakens tool-call/result correlation or delivers an outcome to a
-- different logical request".
--
-- That second clause is not a comment here, it is this function. EXACTLY TWO
-- variants are demoted, and the temptation is to demote a third:
--
--   WrongKind          FATAL. Another class's outcome is not this request's.
--   WrongOrigin        FATAL. The origin names the producer.
--   UnsafeIdentity     FATAL, AND IT IS THE CORRELATION GUARANTEE ITSELF. A
--                      regression mode that demotes this runs further, reports
--                      more, looks more useful, and has given up the one thing
--                      D2 says it may never give up. It type-checks.
--   ProjectionDiffers  demoted — a recorded difference. D2 names it by name.
--   OutcomeDiffers     demoted — a recorded difference.
--   ProgramExhausted   FATAL. A replay past the end of its program reproduces
--                      nothing.
--   UnusedInteraction  FATAL, AND IT IS THE ONE MOST EASILY FORGOTTEN, because
--                      NOTHING FAILS WITHOUT IT (see :129). A regression mode
--                      that stops early agrees with the program at every
--                      position it reached and reports a clean, short, entirely
--                      fictitious "no differences".
--
-- The set is asserted executably below
-- (`test_the_demotion_set_is_exactly_the_two_projection_rules`), because a
-- future edit that demotes a third variant is a one-token change that no type
-- checker and no other test in this suite can see.
export pure func regression_fatal(m: ReplayMismatch) -> bool {
  match m {
    WrongKind(_, _, _) => true,
    WrongOrigin(_, _, _) => true,
    UnsafeIdentity(_, _, _) => true,
    ProjectionDiffers(_, _, _) => false,
    OutcomeDiffers(_, _, _) => false,
    ProgramExhausted(_, _) => true,
    UnusedInteraction(_, _) => true
  }
}

-- Which of A9's failure kinds each divergence is.
--
-- A DECIDED BINDING, recorded because S6's second term says that is where an
-- item's risk lives. A9's `HarnessFailureKind` has no `UnusedInteraction`
-- variant, and adding one is an A9-owned change that would ripple into the
-- event vocabulary and its goldens. `ProgramMismatch` is taken — "the driver
-- asked for something the program did not anticipate" reads awkwardly for a
-- surplus, so the DISTINCTION is carried by `replay_rule` and by the projection
-- text, both of which name it exactly. The alternative, folding it into
-- `InteractionsExhausted`, would conflate the two directions of the walk into
-- one kind, which is the one thing this module refuses to do anywhere else.
export pure func harness_failure_kind_of(m: ReplayMismatch) -> HarnessFailureKind {
  match m {
    ProgramExhausted(_, _) => InteractionsExhausted,
    WrongKind(_, _, _) => ProgramMismatch,
    WrongOrigin(_, _, _) => ProgramMismatch,
    UnsafeIdentity(_, _, _) => ProgramMismatch,
    ProjectionDiffers(_, _, _) => ProgramMismatch,
    OutcomeDiffers(_, _, _) => ProgramMismatch,
    UnusedInteraction(_, _) => ProgramMismatch
  }
}

export pure func mismatch_position(m: ReplayMismatch) -> int {
  match m {
    WrongKind(p, _, _) => p,
    WrongOrigin(p, _, _) => p,
    UnsafeIdentity(p, _, _) => p,
    ProjectionDiffers(p, _, _) => p,
    OutcomeDiffers(p, _, _) => p,
    ProgramExhausted(p, _) => p,
    UnusedInteraction(p, _) => p
  }
}

-- The typed failure D2 requires: "a HarnessFailure, not a simulated system
-- fault". The partial ledger trace and the replay metadata are ARGUMENTS: the
-- trace belongs to the run and the metadata is projected from the program's own
-- manifest by `dst_profile.replay_metadata_of`, so a result cannot carry a
-- profile id that disagrees with the manifest it replayed under.
export pure func replay_failure(m: ReplayMismatch, partial: LedgerTrace, meta: ReplayMetadata) -> DstResult {
  RunFailed({
    kind: harness_failure_kind_of(m),
    interaction_position: mismatch_position(m),
    actual_request_projection: replay_message(m),
    partial_ledger_trace: partial,
    replay_metadata: meta
  })
}

-- ---------------------------------------------------------------------------
-- The outcome projection
-- ---------------------------------------------------------------------------

pure func chunk_projection(cs: [StreamChunkRecord]) -> string {
  match cs {
    [] => "",
    c :: [] => "${c.offset_ms}:${c.text}",
    c :: rest => "${c.offset_ms}:${c.text};${chunk_projection(rest)}"
  }
}

-- Every field of `TimedOutcome`, plus the interaction's deadline. TOTAL BY
-- CONSTRUCTION is the property that matters and it is asserted below
-- (`test_the_outcome_projection_reads_every_field`): a projection that silently
-- ignored a field would make `OutcomeDiffers` blind to exactly the
-- reconstitution loss it exists to catch, and would do so while every count in
-- the suite still balanced.
export pure func outcome_projection(i: Interaction) -> string {
  "advance=${i.outcome.advance_ms} deadline=${i.deadline_ms} status=${outcome_status_id(i.outcome.status)} fault=${i.outcome.fault_class_id} payload=${i.outcome.payload} chunks=[${chunk_projection(i.outcome.chunks)}]"
}

-- ---------------------------------------------------------------------------
-- The walk
-- ---------------------------------------------------------------------------

-- D2's two replay modes. The mode reaches exactly ONE decision — whether a
-- position that agrees on causal identity may report more than one difference —
-- and it reaches nothing else. In particular it does NOT reach
-- `correlation_mismatch_at` below, and that is the structural form of D2's
-- "never weakens tool-call/result correlation".
export type ReplayMode
  = StrictMode
  | RegressionMode

-- THE CORRELATION CHAIN. Coarsest first, at most one finding, and SHARED BY
-- BOTH MODES BY CONSTRUCTION — regression replay does not get its own copy.
--
-- That sharing is deliberate and it is the point. The alternative arrangement,
-- a second comparison function for regression mode, is one in which weakening
-- the identity check in the regression copy leaves strict mode green and every
-- test in this file passing. Here there is one chain: an edit that lets a
-- differing identity through reddens strict replay's mutation rows immediately.
--
-- The ordering is not cosmetic either. A wrong kind also differs in origin and
-- identity; emitting all three would make every mutation row trip three rules
-- at once, and a mutant that trips three rules proves none of them — the same
-- care `discovery_dst.renumber` takes when it re-densifies after a drop.
pure func correlation_mismatch_at(pos: int, e: Interaction, a: Interaction) -> [ReplayMismatch] {
  let ek = interaction_kind(e);
  let ak = interaction_kind(a);
  if ek != ak then [WrongKind(pos, ek, ak)]
  else {
    let eo = identity_origin(e.identity.body);
    let ao = identity_origin(a.identity.body);
    if eo != ao then [WrongOrigin(pos, eo, ao)]
    else if not identity_body_eq(e.identity.body, a.identity.body)
            || e.identity.ordinal != a.identity.ordinal then
      [UnsafeIdentity(pos, identity_projection(e.identity), identity_projection(a.identity))]
    else []
  }
}

pure func projection_mismatch_at(pos: int, e: Interaction, a: Interaction) -> [ReplayMismatch] {
  if e.request_projection != a.request_projection then
    [ProjectionDiffers(pos, e.request_projection, a.request_projection)]
  else []
}

pure func outcome_mismatch_at(pos: int, e: Interaction, a: Interaction) -> [ReplayMismatch] {
  if outcome_projection(e) != outcome_projection(a) then
    [OutcomeDiffers(pos, outcome_projection(e), outcome_projection(a))]
  else []
}

-- One position, under a mode.
--
-- A DECIDED BINDING, and it is the only behavioural difference between the two
-- modes. Strict mode keeps exactly one finding per position, coarsest first,
-- because its findings are FAILURES and a mutant that trips two rules proves
-- neither. Regression mode reports BOTH demoted differences when both hold,
-- because its findings are a RECORD and D2 requires the differences to be
-- recorded rather than discarded — a position whose request and outcome both
-- changed, reported as "the request changed", is a report that understates
-- what it was built to report. The coarsest-first discipline is preserved
-- exactly where it earns its keep: the fatal chain above, in both modes.
pure func compare_at(mode: ReplayMode, pos: int, e: Interaction, a: Interaction) -> [ReplayMismatch] {
  match correlation_mismatch_at(pos, e, a) {
    m :: _ => [m],
    [] => {
      let pd = projection_mismatch_at(pos, e, a);
      let od = outcome_mismatch_at(pos, e, a);
      match mode {
        StrictMode => match pd { m :: _ => [m], [] => od },
        RegressionMode => pd ++ od
      }
    }
  }
}

-- The two arms of the walk are MODE-INDEPENDENT, and that is D2's demotion set
-- read exactly: `ProgramExhausted` and `UnusedInteraction` are fatal in both
-- modes, so neither arm consults `mode` at all.
pure func walk(mode: ReplayMode, pos: int, expected: [Interaction], actual: [Interaction]) -> [ReplayMismatch] {
  match expected {
    [] => match actual {
      [] => [],
      -- The driver asked for more than the program holds.
      a :: _ => [ProgramExhausted(pos, "${identity_projection(a.identity)} | ${a.request_projection}")]
    },
    e :: e_rest => match actual {
      -- The program holds more than the driver asked for. Same walk, other arm.
      [] => [UnusedInteraction(pos, "${identity_projection(e.identity)} | ${e.request_projection}")],
      -- NOT `a :: as`: `as` is the import-alias keyword on this pin and a
      -- binder of that name is a parse error at the `=>`, not at the pattern.
      a :: a_rest => compare_at(mode, pos, e, a) ++ walk(mode, pos + 1, e_rest, a_rest)
    }
  }
}

-- The whole strict-replay comparison, in one call. Stage 3's contract, byte for
-- byte: every one of stage 3's rows still runs against this entry point, and
-- `test_regression_mode_did_not_change_strict_mode` asserts the two modes
-- disagree only where they are supposed to.
export pure func strict_replay_findings(program: [Interaction], actual: [Interaction]) -> [ReplayMismatch] {
  walk(StrictMode, 0, program, actual)
}

-- ---------------------------------------------------------------------------
-- REGRESSION REPLAY (WI-A13, stage 5)
-- ---------------------------------------------------------------------------
--
-- D2's second mode: "require compatible causal identity, record projection
-- differences, and continue". The two halves of that sentence are two fields.
--
-- `fatal` is not "the important ones" and `differences` is not "the rest" —
-- the split IS the specification, and `regression_fatal` is where it is
-- written down.
export type RegressionReplay = {
  -- Compatible causal identity was NOT established, or the walk did not
  -- balance. D2 makes each of these a HarnessFailure in both modes.
  fatal: [ReplayMismatch],
  -- Recorded and reported, and the run continued past every one of them.
  differences: [ReplayMismatch]
}

pure func keep_fatal(ms: [ReplayMismatch]) -> [ReplayMismatch] {
  match ms {
    [] => [],
    m :: rest => (if regression_fatal(m) then [m] else []) ++ keep_fatal(rest)
  }
}

pure func keep_demoted(ms: [ReplayMismatch]) -> [ReplayMismatch] {
  match ms {
    [] => [],
    m :: rest => (if regression_fatal(m) then [] else [m]) ++ keep_demoted(rest)
  }
}

-- The whole regression comparison, in one call.
--
-- Note what this does NOT do: it does not stop at the first difference, and it
-- does not stop at the first FATAL either. The walk is complete, and the
-- partition happens after — so a fatal at position 2 does not hide a recorded
-- difference at position 9, and the report a reviewer reads is the whole
-- comparison rather than its first line.
export pure func regression_replay_findings(
  program: [Interaction], actual: [Interaction]
) -> RegressionReplay {
  let ms = walk(RegressionMode, 0, program, actual);
  { fatal: keep_fatal(ms), differences: keep_demoted(ms) }
}

-- Regression replay PASSES with recorded differences. It fails only on the five
-- fatal rules — which is the whole difference between this mode and strict, and
-- the reason the demotion set is asserted rather than trusted.
export pure func regression_replay_ok(program: [Interaction], actual: [Interaction]) -> bool {
  List.length(regression_replay_findings(program, actual).fatal) == 0
}

export pure func regression_difference_count(r: RegressionReplay) -> int {
  List.length(r.differences)
}

pure func difference_lines(ms: [ReplayMismatch]) -> string {
  match ms {
    [] => "",
    m :: rest => "\n    - ${replay_message(m)}${difference_lines(rest)}"
  }
}

-- The RECORD half of "record projection differences and continue". A mode that
-- computed the differences and then dropped them on the floor would satisfy
-- every count in this file and report nothing to anybody, so the projection
-- that makes them readable is part of the mode rather than a convenience.
export pure func regression_report(r: RegressionReplay) -> string {
  "regression replay: ${List.length(r.fatal)} fatal, ${List.length(r.differences)} recorded difference(s)${difference_lines(r.differences)}"
}

export pure func strict_replay_ok(program: [Interaction], actual: [Interaction]) -> bool {
  List.length(strict_replay_findings(program, actual)) == 0
}

export pure func has_replay_rule(ms: [ReplayMismatch], rule: string) -> bool {
  match ms {
    [] => false,
    m :: rest => if replay_rule(m) == rule then true else has_replay_rule(rest, rule)
  }
}

export pure func first_replay_message(ms: [ReplayMismatch]) -> string {
  match ms {
    [] => "(no mismatches)",
    m :: _ => replay_message(m)
  }
}

export pure func first_replay_failure(
  ms: [ReplayMismatch], partial: LedgerTrace, meta: ReplayMetadata
) -> Option[DstResult] {
  match ms {
    [] => None,
    m :: _ => Some(replay_failure(m, partial, meta))
  }
}

-- ---------------------------------------------------------------------------
-- Reconstitution: the balance FIRST, the projection second (S1)
-- ---------------------------------------------------------------------------

-- `world_state_of` is the one projection strict replay adds, and it has the
-- exact exposure `dst_discovery`'s header describes for a recorder, in both
-- directions:
--
--   UNDERFILLED  a queue shorter than the class it was derived from. The world
--                runs dry early and serves defaults — CONSISTENTLY, which is
--                all the determinism contract asks.
--   OVERFILLED   a queue longer than the class. The world serves a response no
--                interaction records, which is precisely what `dst_program`'s
--                design note 3 exists to make unrepresentable.
export type ReconstitutionFinding
  = QueueUnderfilled(string, int, int)   -- queue, from the program, in the world
  | QueueOverfilled(string, int, int)
  | EpochNotCarried(int, int)            -- program's clock epoch, world's clock
  | EnvironmentNotCarried(int, int)      -- program's env size, world's env size
  -- WI-D22, and it is the environment's rule rather than a queue rule. The two
  -- tables the program carries DIRECTLY are the ones a projection can drop
  -- without any count going out of balance, because nothing derives them from
  -- the interaction list; the three queues are graded against the classes they
  -- come from and this pair has to be graded against the program.
  | FilesNotCarried(int, int)            -- program's file count, world's file count

export pure func reconstitution_rule(f: ReconstitutionFinding) -> string {
  match f {
    QueueUnderfilled(_, _, _) => "reconstitution-queue-underfilled",
    QueueOverfilled(_, _, _) => "reconstitution-queue-overfilled",
    EpochNotCarried(_, _) => "reconstitution-epoch-not-carried",
    EnvironmentNotCarried(_, _) => "reconstitution-environment-not-carried",
    FilesNotCarried(_, _) => "reconstitution-files-not-carried"
  }
}

export pure func reconstitution_message(f: ReconstitutionFinding) -> string {
  match f {
    QueueUnderfilled(q, from_program, in_world) =>
      "[reconstitution-queue-underfilled] the program records ${from_program} interaction(s) the '${q}' queue must serve and the reconstituted world holds ${in_world}; the world will run dry mid-replay and serve a default, which is perfectly reproducible and therefore invisible to the determinism half of D2's strict-replay contract",
    QueueOverfilled(q, from_program, in_world) =>
      "[reconstitution-queue-overfilled] the reconstituted world's '${q}' queue holds ${in_world} entries and the program records ${from_program}; a world that can serve a response no interaction records is the exact defect dst_program's design note 3 keeps unrepresentable by refusing to carry the queues at all",
    EpochNotCarried(epoch, clock) =>
      "[reconstitution-epoch-not-carried] the program's initial world declares clock epoch ${epoch} and the reconstituted world starts at ${clock}; D4 makes the explicit clock the only clock, so a replay starting at a different epoch stamps every recorded offset against a different origin",
    EnvironmentNotCarried(from_program, in_world) =>
      "[reconstitution-environment-not-carried] the program's initial world declares ${from_program} synthetic environment entr(ies) and the reconstituted world holds ${in_world}; the environment is the ONE queue the program carries directly (design note 3), so losing it is a copy that failed rather than a projection that was lossy",
    FilesNotCarried(from_program, in_world) =>
      "[reconstitution-files-not-carried] the program's initial world seeds ${from_program} file table entr(ies) and the reconstituted world holds ${in_world}; WI-D22 added this field at execution-program/2 precisely because world_state_of reconstituted an empty table, so a projection that drops it again puts the replay back in the state the schema bump was cut to leave — every read of a seeded path answers 'absent' and the run diverges at the first branch that guards on it"
  }
}

-- One comparison, two findings — `dst_discovery.class_balance`'s shape, for the
-- reason stated there: two separate predicates is the arrangement in which one
-- of them is deleted, forgotten, or never written.
pure func queue_balance(queue: string, from_program: int, in_world: int) -> [ReconstitutionFinding] {
  if in_world < from_program then [QueueUnderfilled(queue, from_program, in_world)]
  else if in_world > from_program then [QueueOverfilled(queue, from_program, in_world)]
  else []
}

-- How many provider interactions actually SERVED a scripted step. A provider
-- call that found the script exhausted is a recorded interaction with no script
-- entry behind it, so it must not be counted into the script queue's expected
-- length — the same distinction `approvals_served` draws for an end-of-input
-- approval read, and for the same reason.
export pure func provider_steps_served(xs: [Interaction]) -> int {
  match xs {
    [] => 0,
    i :: rest =>
      (match i.identity.body {
         ProviderIdentity(_, _, _) =>
           match decode_provider_outcome(i.outcome.payload, i.outcome.advance_ms) {
             ProviderServed(_) => 1,
             ProviderScriptExhausted => 0,
             ProviderUndecodable(_) => 0
           },
         _ => 0
       }) + provider_steps_served(rest)
  }
}

-- The two-sided check on `world_state_of`'s own projection.
export pure func reconstitution_balance(p: ExecutionProgram, w: WorldState) -> [ReconstitutionFinding] {
  queue_balance("script", provider_steps_served(p.interactions), List.length(w.script))
    ++ queue_balance("approvals", approvals_served(p.interactions), List.length(w.approvals))
    ++ queue_balance("tools", count_kind(p.interactions, identity_kind(ToolIdentity("", "", ""))),
                     List.length(w.tools))
    -- WI-D24. The extension-effect queue, on the tool queue's shape and for a
    -- sharper reason: a `world_state_of` that dropped this class would leave the
    -- replay's `ext_effects` empty, and an empty queue is not a quiet failure at
    -- this seam — the adapter delegates to the real dispatcher, so the replay
    -- performs a REAL SUBPROCESS. The recorded interaction then goes unconsumed
    -- and `UnusedInteraction` fires, which is loud, but only after the effect has
    -- happened. This balance is the check that fires first and without a run.
    ++ queue_balance("extension_effects",
                     count_kind(p.interactions, identity_kind(ExtensionEffectIdentity("", "", ""))),
                     List.length(w.ext_effects))
    ++ (if w.clock_ms == p.initial_world.clock_epoch then []
        else [EpochNotCarried(p.initial_world.clock_epoch, w.clock_ms)])
    ++ (if List.length(w.env) == List.length(p.initial_world.synthetic_environment) then []
        else [EnvironmentNotCarried(List.length(p.initial_world.synthetic_environment), List.length(w.env))])
    ++ (if List.length(w.files) == List.length(p.initial_world.files) then []
        else [FilesNotCarried(List.length(p.initial_world.files), List.length(w.files))])
}

export pure func reconstitution_ok(p: ExecutionProgram, w: WorldState) -> bool {
  List.length(reconstitution_balance(p, w)) == 0
}

export pure func has_reconstitution_rule(fs: [ReconstitutionFinding], rule: string) -> bool {
  match fs {
    [] => false,
    f :: rest => if reconstitution_rule(f) == rule then true else has_reconstitution_rule(rest, rule)
  }
}

export pure func first_reconstitution_message(fs: [ReconstitutionFinding]) -> string {
  match fs {
    [] => "(no findings)",
    f :: _ => reconstitution_message(f)
  }
}

-- ---------------------------------------------------------------------------
-- Reconstituting the world FROM the program
-- ---------------------------------------------------------------------------

-- Why replay could not START at all. Distinct from `ReplayMismatch`, which is a
-- divergence DURING replay: a program that cannot be decoded has produced no
-- position to name, so D6.7's `-1` applies and A9's `InvalidProgram` is the
-- kind. The two are kept apart because merging them would let a decode failure
-- be reported as a system mismatch at position 0.
export type ReplayRefusal
  = ProgramStructurallyInvalid(string)   -- the first structural rule that fired
  | ProviderOutcomeUndecodable(int, string)  -- ordinal, why
  | ToolOutcomeUndecodable(int, string)      -- ordinal, why

export pure func refusal_rule(r: ReplayRefusal) -> string {
  match r {
    ProgramStructurallyInvalid(_) => "replay-refused-invalid-program",
    ProviderOutcomeUndecodable(_, _) => "replay-refused-provider-outcome-undecodable",
    ToolOutcomeUndecodable(_, _) => "replay-refused-tool-outcome-undecodable"
  }
}

export pure func refusal_message(r: ReplayRefusal) -> string {
  match r {
    ProgramStructurallyInvalid(rule) =>
      "[replay-refused-invalid-program] the program fails the structural validator with '${rule}'; D2 requires decoding and the pure structural validator to run BEFORE replay, so this is a refusal to start and not a mismatch at a position",
    ProviderOutcomeUndecodable(ord, why) =>
      "[replay-refused-provider-outcome-undecodable] interaction #${ord} records a provider outcome this build cannot read back (${why}); the provider script is a PROJECTION of the interaction list (dst_program design note 3), so an outcome that cannot be re-served is a program that cannot be replayed — failing closed here is what stops it becoming a silently shorter run",
    ToolOutcomeUndecodable(ord, why) =>
      "[replay-refused-tool-outcome-undecodable] interaction #${ord} records a tool outcome this build cannot read back (${why}); the tool queue is a projection of the interaction list, so the same rule applies as for the provider outcome"
  }
}

export pure func refusal_failure(r: ReplayRefusal, meta: ReplayMetadata, trace: LedgerTrace) -> DstResult {
  RunFailed({
    kind: InvalidProgram,
    interaction_position: -1,
    actual_request_projection: refusal_message(r),
    partial_ledger_trace: trace,
    replay_metadata: meta
  })
}

-- Declared BEFORE `script_of` rather than after it: a forward reference from
-- inside a recursive function is `undefined variable` on this pin, even though
-- a forward reference from a non-recursive one resolves fine.
pure func chunk_texts(cs: [StreamChunkRecord]) -> [string] {
  match cs {
    [] => [],
    c :: rest => c.text :: chunk_texts(rest)
  }
}

-- The provider script, derived from the provider interactions in encounter
-- order. `ProviderScriptExhausted` contributes NO entry: it records a request
-- the driver made after the script ran out, and re-queueing something for it
-- would manufacture a response the discovery run never served.
pure func script_of(xs: [Interaction]) -> Result[[ScriptedStep], ReplayRefusal] {
  match xs {
    [] => Ok([]),
    i :: rest =>
      match i.identity.body {
        ProviderIdentity(_, _, _) =>
          match decode_provider_outcome(i.outcome.payload, i.outcome.advance_ms) {
            ProviderUndecodable(why) => Err(ProviderOutcomeUndecodable(i.identity.ordinal, why)),
            ProviderScriptExhausted => script_of(rest),
            ProviderServed(s) =>
              match script_of(rest) {
                Err(e) => Err(e),
                -- The recorded stream chunks are the step's chunks, read back
                -- from the outcome rather than duplicated into the payload.
                -- That keeps ONE representation of the chunk list and makes
                -- `TimedOutcome.chunks` load-bearing instead of decorative.
                Ok(tail) => Ok(({ s | chunks: chunk_texts(i.outcome.chunks) }) :: tail)
              }
          },
        _ => script_of(rest)
      }
  }
}

-- The approval queue: the raw lines the world served, in order. An end-of-input
-- read (`OutcomeMissing`) queues NOTHING, so a replay drains at the same
-- position the discovery run did — which is what makes the `eof` shape
-- replayable at all rather than silently becoming a served empty line.
pure func approvals_of(xs: [Interaction]) -> [string] {
  match xs {
    [] => [],
    i :: rest =>
      match i.identity.body {
        ApprovalIdentity(_, _, _) =>
          match i.outcome.status {
            OutcomeMissing => approvals_of(rest),
            _ => i.outcome.payload :: approvals_of(rest)
          },
        _ => approvals_of(rest)
      }
  }
}

pure func tools_of(xs: [Interaction]) -> Result[[ScriptedTool], ReplayRefusal] {
  match xs {
    [] => Ok([]),
    i :: rest =>
      match i.identity.body {
        ToolIdentity(_, _, _) =>
          match decode_tool_outcome(i.outcome.payload, i.outcome.advance_ms) {
            ToolRecordUndecodable(why) => Err(ToolOutcomeUndecodable(i.identity.ordinal, why)),
            ToolRecordDecoded(t) =>
              match tools_of(rest) {
                Err(e) => Err(e),
                Ok(tail) => Ok(t :: tail)
              }
          },
        _ => tools_of(rest)
      }
  }
}

-- WI-D24. The SAME projection over the OTHER class, and it is a separate
-- function for the same reason `WorldState.ext_effects` is a separate queue: an
-- extension effect's call id is legitimately blank, so an entry of this class in
-- the driver's queue is consumable by a driver dispatch with no correlation
-- mismatch reported. Collecting both classes into `tools` would reconstitute a
-- world that answers the wrong request correctly.
--
-- THE PAYLOAD CODEC IS SHARED AND MUST BE. `recording_ext_effect` records
-- through `tool_outcome_record`, exactly as `recording_tool` does, so the bytes
-- are the same bytes; a second decoder here would be a second reading of one
-- format, which is the drift `decode_tool_outcome` was centralised to remove.
pure func ext_effects_of(xs: [Interaction]) -> Result[[ScriptedTool], ReplayRefusal] {
  match xs {
    [] => Ok([]),
    i :: rest =>
      match i.identity.body {
        ExtensionEffectIdentity(_, _, _) =>
          match decode_tool_outcome(i.outcome.payload, i.outcome.advance_ms) {
            ToolRecordUndecodable(why) => Err(ToolOutcomeUndecodable(i.identity.ordinal, why)),
            ToolRecordDecoded(t) =>
              match ext_effects_of(rest) {
                Err(e) => Err(e),
                Ok(tail) => Ok(t :: tail)
              }
          },
        _ => ext_effects_of(rest)
      }
  }
}

pure func first_structural_rule(p: ExecutionProgram, known_class_ids: [string]) -> Option[string] {
  match validate_program(p, known_class_ids) {
    [] => None,
    r :: _ => Some(program_rule(r))
  }
}

-- D2's `initial_world` reconstitution.
--
-- The environment comes from the program DIRECTLY — it is the one initial value
-- design note 3 keeps on the program, because a synthetic environment is an
-- INPUT to the run and not a projection of what the run requested. The env
-- INTERACTIONS are the record of the reads, and they are what the two-sided
-- env balance in `dst_discovery` grades; they are not the source of the map.
--
-- `log: []` — the reconstituted world starts with an EMPTY log. It has to: the
-- replay's log is what the comparison reads, and seeding it with the program's
-- own interactions would make `strict_replay_findings` compare the program
-- against itself. That is the tautology this module's header names, in its most
-- literal form, and it is one field away at all times.
export pure func world_state_of(
  p: ExecutionProgram, known_class_ids: [string]
) -> Result[WorldState, ReplayRefusal] {
  match first_structural_rule(p, known_class_ids) {
    Some(rule) => Err(ProgramStructurallyInvalid(rule)),
    None =>
      match script_of(p.interactions) {
        Err(e) => Err(e),
        Ok(script) =>
          match tools_of(p.interactions) {
            Err(e) => Err(e),
            Ok(tools) =>
              match ext_effects_of(p.interactions) {
                Err(e) => Err(e),
                Ok(ext_effects) =>
              Ok({ empty_world_state() |
                   script: script,
                   clock_ms: p.initial_world.clock_epoch,
                   approvals: approvals_of(p.interactions),
                   env: p.initial_world.synthetic_environment,
                   -- WI-D22. This read `files: []` by omission through WI-D21 —
                   -- `empty_world_state()`'s table, because `InitialWorld` had
                   -- no counterpart to copy. `execution-program/2` gives it one,
                   -- and it comes from the program DIRECTLY for the environment's
                   -- reason: a seeded filesystem is an INPUT to the run, not a
                   -- projection of what the run requested. The `file_write`,
                   -- `file_remove` and `dir_make` interactions remain the record
                   -- of the run's own mutations and are still not the source of
                   -- this table — a replayed driver performs those again through
                   -- the same adapters, on top of this seed.
                   files: p.initial_world.files,
                   tools: tools,
                   -- WI-D24. The extension-effect queue, derived from the log
                   -- exactly as `tools` is. `holder_ext_id` is deliberately NOT
                   -- restored and comes from `empty_world_state()`: the holder is
                   -- a property of a call in flight, and a replayed run's hooks
                   -- are stamped by the same fold that stamped the recorded run's.
                   -- Seeding it here would put one fact in two homes, and the
                   -- reconstituted one would be whichever extension happened to
                   -- go last.
                   ext_effects: ext_effects })
              }
          }
      }
  }
}

-- ---------------------------------------------------------------------------
-- Inline tests. The PROGRAM-scale fixtures live in
-- scripts/dst/strict_replay_dst.ail, where a real driver run is in scope. What
-- is tested here is the part with no run: the walk, the projection, and the
-- balance — each of which must be shown to fire AND to stay quiet.
-- ---------------------------------------------------------------------------

-- THE DEMOTION SET, ASSERTED. This is the first test in the section because it
-- is the substance of regression mode: everything else in that mode is a walk
-- that already existed. Demoting a third variant is a one-token edit, it type
-- checks, and the resulting mode runs further and reports more — so nothing but
-- this row can see it.
--
-- If a `ReplayMismatch` variant is ever added, `regression_fatal`'s match is
-- exhaustive and forces the decision; the list below must be widened to 8 or
-- this row's count goes stale, which is why the length is asserted too.
pure func every_mismatch_variant() -> [ReplayMismatch] {
  [WrongKind(0, "e", "a"),
   WrongOrigin(0, "e", "a"),
   UnsafeIdentity(0, "e", "a"),
   ProjectionDiffers(0, "e", "a"),
   OutcomeDiffers(0, "e", "a"),
   ProgramExhausted(0, "a"),
   UnusedInteraction(0, "e")]
}

pure func count_demoted(ms: [ReplayMismatch]) -> int {
  match ms {
    [] => 0,
    m :: rest => (if regression_fatal(m) then 0 else 1) + count_demoted(rest)
  }
}

pure func test_the_demotion_set_is_exactly_the_two_projection_rules() -> bool
  tests [((), true)]
  {
    List.length(every_mismatch_variant()) == 7
      && count_demoted(every_mismatch_variant()) == 2
      -- The two D2 names, and only these two.
      && not regression_fatal(ProjectionDiffers(0, "e", "a"))
      && not regression_fatal(OutcomeDiffers(0, "e", "a"))
      -- The correlation guarantee, spelled out rather than implied by the count:
      -- a count of two is also satisfied by demoting UnsafeIdentity and
      -- promoting OutcomeDiffers, which is the exact wrong answer.
      && regression_fatal(UnsafeIdentity(0, "e", "a"))
      && regression_fatal(WrongKind(0, "e", "a"))
      && regression_fatal(WrongOrigin(0, "e", "a"))
      && regression_fatal(ProgramExhausted(0, "a"))
      && regression_fatal(UnusedInteraction(0, "e"))
  }

pure func mk(b: IdentityBody, ord: int, out: TimedOutcome) -> Interaction {
  { identity: { ordinal: ord, body: b },
    request_projection: "p${ord}",
    deadline_ms: match b {
      ToolIdentity(_, _, _) => 0,
      ApprovalIdentity(_, _, _) => 0,
      ExtensionEffectIdentity(_, _, _) => 0,
      _ => -1
    },
    outcome: out }
}

pure func ok_out(advance: int, payload: string) -> TimedOutcome {
  { advance_ms: advance, chunks: [], payload: payload, status: OutcomeOk, fault_class_id: "" }
}

-- A three-interaction reference run: provider, tool, approval. Small enough to
-- mutate one field at a time and wide enough that a rule which fires on the
-- wrong class shows up.
pure func reference() -> [Interaction] {
  [mk(ProviderIdentity("loop_v2", 0, "m"), 0, ok_out(0, "{}")),
   mk(ToolIdentity("loop_v2", "c1", "T"), 1, ok_out(7, "OK")),
   mk(ApprovalIdentity("loop_v2", "c1", "T"), 2, ok_out(0, "yes"))]
}

-- THE NEGATIVE CONTROL, and for a comparison it is the load-bearing assertion:
-- a checker that reports a mismatch unconditionally passes every mutation row
-- below. Cluster 7 measured that being the difference between a correct and a
-- silently wrong reading of D2, and S7 promotes it.
pure func test_an_exact_replay_produces_no_mismatch() -> bool
  tests [((), true)]
  {
    strict_replay_ok(reference(), reference())
  }

-- A replay one interaction short. NOTHING ELSE SEES THIS: every position the
-- replay did reach agrees exactly, so the walk's other arm is the only rule
-- that can fire.
pure func test_a_short_replay_leaves_an_unused_interaction() -> bool
  tests [((), true)]
  {
    let short = [mk(ProviderIdentity("loop_v2", 0, "m"), 0, ok_out(0, "{}")),
                 mk(ToolIdentity("loop_v2", "c1", "T"), 1, ok_out(7, "OK"))];
    let ms = strict_replay_findings(reference(), short);
    has_replay_rule(ms, "replay-unused-interaction")
      && List.length(ms) == 1
  }

-- The mirror arm: the driver ran past the end of the program.
pure func test_a_long_replay_exhausts_the_program() -> bool
  tests [((), true)]
  {
    let long = reference() ++ [mk(ClockAdvanceIdentity, 3, ok_out(1, "1"))];
    let ms = strict_replay_findings(reference(), long);
    has_replay_rule(ms, "replay-program-exhausted") && List.length(ms) == 1
  }

-- Kind, origin and identity are three separate rules and the coarsest wins, so
-- each mutant trips exactly one. A mutant that trips several proves none.
pure func test_each_identity_divergence_trips_exactly_its_own_rule() -> bool
  tests [((), true)]
  {
    let wrong_kind = [mk(ToolIdentity("loop_v2", "c1", "T"), 0, ok_out(0, "{}")),
                      mk(ToolIdentity("loop_v2", "c1", "T"), 1, ok_out(7, "OK")),
                      mk(ApprovalIdentity("loop_v2", "c1", "T"), 2, ok_out(0, "yes"))];
    let wrong_origin = [mk(ProviderIdentity("other", 0, "m"), 0, ok_out(0, "{}")),
                        mk(ToolIdentity("loop_v2", "c1", "T"), 1, ok_out(7, "OK")),
                        mk(ApprovalIdentity("loop_v2", "c1", "T"), 2, ok_out(0, "yes"))];
    let wrong_call_id = [mk(ProviderIdentity("loop_v2", 0, "m"), 0, ok_out(0, "{}")),
                         mk(ToolIdentity("loop_v2", "c2", "T"), 1, ok_out(7, "OK")),
                         mk(ApprovalIdentity("loop_v2", "c1", "T"), 2, ok_out(0, "yes"))];
    let a = strict_replay_findings(reference(), wrong_kind);
    let b = strict_replay_findings(reference(), wrong_origin);
    let c = strict_replay_findings(reference(), wrong_call_id);
    has_replay_rule(a, "replay-wrong-kind") && List.length(a) == 1
      && has_replay_rule(b, "replay-wrong-origin") && List.length(b) == 1
      && has_replay_rule(c, "replay-unsafe-identity-mismatch") && List.length(c) == 1
  }

-- D2 keeps a repeated production call id REPRESENTABLE so an invariant reports
-- it rather than the decoder rejecting the artifact (stage 1, design note 2).
-- This is that invariant: two interactions with a byte-identical identity body
-- at different ordinals are DIFFERENT logical requests, and delivering one's
-- outcome to the other is the mismatch D2 forbids by name.
pure func test_a_repeated_call_id_at_a_different_ordinal_is_a_mismatch() -> bool
  tests [((), true)]
  {
    let retry = [mk(ToolIdentity("loop_v2", "c1", "T"), 0, ok_out(7, "OK")),
                 mk(ToolIdentity("loop_v2", "c1", "T"), 1, ok_out(9, "OK2"))];
    let swapped = [mk(ToolIdentity("loop_v2", "c1", "T"), 1, ok_out(9, "OK2")),
                   mk(ToolIdentity("loop_v2", "c1", "T"), 0, ok_out(7, "OK"))];
    strict_replay_ok(retry, retry)
      && has_replay_rule(strict_replay_findings(retry, swapped), "replay-unsafe-identity-mismatch")
  }

-- The outcome projection must read EVERY field. A projection that dropped one
-- would leave `OutcomeDiffers` blind to a reconstitution that lost exactly that
-- field, while every count in the suite still balanced — which is the failure
-- mode this whole module is shaped against, expressed in one function.
pure func test_the_outcome_projection_reads_every_field() -> bool
  tests [((), true)]
  {
    let base = mk(ToolIdentity("loop_v2", "c1", "T"), 0, ok_out(7, "OK"));
    let p = outcome_projection(base);
    p != outcome_projection({ base | outcome: { base.outcome | advance_ms: 8 } })
      && p != outcome_projection({ base | deadline_ms: 1 })
      && p != outcome_projection({ base | outcome: { base.outcome | payload: "NO" } })
      && p != outcome_projection({ base | outcome: { base.outcome | status: OutcomeFault, fault_class_id: "x" } })
      && p != outcome_projection({ base | outcome: { base.outcome | fault_class_id: "x" } })
      && p != outcome_projection({ base | outcome: { base.outcome | chunks: [{ offset_ms: 0, text: "c" }] } })
  }

-- An outcome that differs only in a field the identity does not carry is still
-- a strict-replay failure. This is the row that catches a lossy reconstitution:
-- the world served the right request and the wrong answer.
pure func test_a_differing_outcome_is_a_mismatch_even_when_the_identity_matches() -> bool
  tests [((), true)]
  {
    let lossy = [mk(ProviderIdentity("loop_v2", 0, "m"), 0, ok_out(0, "{}")),
                 mk(ToolIdentity("loop_v2", "c1", "T"), 1, ok_out(7, "")),
                 mk(ApprovalIdentity("loop_v2", "c1", "T"), 2, ok_out(0, "yes"))];
    let ms = strict_replay_findings(reference(), lossy);
    has_replay_rule(ms, "replay-outcome-differs") && List.length(ms) == 1
  }

-- ---------------------------------------------------------------------------
-- Reconstitution fixtures
-- ---------------------------------------------------------------------------

-- A program whose three derived queues have PAIRWISE DISTINCT lengths, per S7:
-- two provider steps served (plus one served after exhaustion, which queues
-- nothing), three approval reads of which ONE was served, and four tool
-- interactions. script=2, approvals=1, tools=4 — so a balance that reads the
-- wrong queue's count cannot come out right by coincidence, which is exactly
-- how stage 2's sites 17 and 18 stayed hidden.
pure func provider_i(ord: int, prose: string) -> Interaction {
  mk(ProviderIdentity("loop_v2", ord, "m"), ord,
     ok_out(0, encode_provider_outcome({ prose: prose, tool_calls: [], input_tokens: 1,
                                         output_tokens: 2, finish_reason: "stop", chunks: [], error_code: "", error_message: "", advance_ms: 0 })))
}

pure func exhausted_i(ord: int) -> Interaction {
  mk(ProviderIdentity("loop_v2", ord, "m"), ord, ok_out(0, encode_exhausted_provider_outcome()))
}

pure func tool_i(ord: int, call_id: string) -> Interaction {
  mk(ToolIdentity("loop_v2", call_id, "T"), ord,
     -- WI-D22: `exit_code: -1`, matching `fixture_tool()` below. The fixture is
     -- machinery rather than a subprocess, and a value here would assert a
     -- process ran.
     ok_out(3, encode_tool_outcome(ToolCompleted({ tool_call_id: call_id, content: "OUT", exit_code: -1 }))))
}

pure func approval_i(ord: int, call_id: string, served: bool) -> Interaction {
  mk(ApprovalIdentity("loop_v2", call_id, "T"), ord,
     if served then ok_out(0, "yes")
     else { advance_ms: 0, chunks: [], payload: "", status: OutcomeMissing, fault_class_id: "" })
}

pure func fixture_interactions() -> [Interaction] {
  [provider_i(0, "s0"), tool_i(1, "c1"), approval_i(2, "c1", true),
   provider_i(3, "s1"), tool_i(4, "c2"), approval_i(5, "c2", false),
   tool_i(6, "c3"), approval_i(7, "c3", false), tool_i(8, "c4"),
   exhausted_i(9)]
}

-- A manifest for the fixture PROGRAM only. It is deliberately NOT
-- `driver_only_manifest(...)`: the machinery's own tests must not pass or fail
-- with a profile's content, which is the discipline `dst_profile.fixture_base`
-- states for the same reason. The real manifest is consumed in
-- `scripts/dst/strict_replay_dst.ail`, where the profile is the subject.
pure func fixture_manifest() -> ExecutionManifest {
  { source_revision: "HEAD",
    toolchain: "ailang 0.33.0",
    extension_packages: [],
    abi_version: "4.0",
    profile_id: "fixture_only",
    profile_version: "1",
    event_vocabulary_version: "1",
    normalized_configuration: "{}",
    classifier_2_set: [],
    unrouted_fields: [],
    scan_roots: [],
    scan_root_commit: "HEAD",
    profile_rules_version: "1",
    coverage_rules_version: "1",
    attribution_rules_version: "1",
    fault_catalogue_version: "1" }
}

-- WI-D22 DERIVED THE SCHEMA VERSION HERE, and the site is S23's own shape: the
-- literal `"execution-program/1"` sat in this record and was, when measured, the
-- ONLY live transcription of the version outside its producer — the two other
-- occurrences in the tree are comments. WI-D14 paid for exactly this pattern.
--
-- It is DERIVED and not pinned, because the question a transcribed constant
-- forces is "is this a value deliberately held at v1, or the current value
-- copied?", and here it is the second: this is the machinery's own fixture, it
-- exercises no compatibility path, and nothing about it is v1-specific. The
-- fixtures that ARE deliberately pinned live in
-- `scripts/dst/program_persistence_dst.ail`, say so at the site, and are
-- compared against frozen bytes.
pure func fixture_program() -> ExecutionProgram {
  { schema_version: program_schema_version(),
    generator_id: "g", generator_version: "1", seed: 0,
    initial_world: { messages_and_policy: "{}",
                     synthetic_environment: [{ key: "K1", value: "v" }, { key: "K2", value: "w" }],
                     -- WI-D22. TWO entries and one of them a directory, so the
                     -- balance rule below is graded against a table that a
                     -- projection returning `[]` cannot accidentally match, and
                     -- so the kinded seed is exercised by the machinery's own
                     -- fixture rather than only by the persistence specimen.
                     files: [{ path: "/w/seed.json", node: FsFile("{\"seeded\":true}") },
                             { path: "/w/seed-dir", node: FsDir }],
                     clock_epoch: 5,
                     extension_profile: "driver_only/1" },
    bounds: { max_interactions: 64, max_chunks_per_interaction: 4, max_payload_bytes: 4096,
              max_resource_size: 4096, max_clock_advance_ms: 1000, chunk_draw_hi: 3 },
    manifest: fixture_manifest(),
    interactions: fixture_interactions() }
}

-- One reconstituted tool queue entry. WI-D22 factored this out of the four
-- copies below rather than adding `exit_code` to each: four literals of one
-- record is where the next field addition edits three of them.
--
-- `exit_code: -1` matches what `tool_i`'s `encode_tool_outcome(ToolCompleted{…})`
-- above records, so the queue this fixture builds is the queue `world_state_of`
-- actually derives from the same program.
pure func fixture_tool() -> ScriptedTool {
  { tool_call_id: "", duration_ms: 3, code: "", message: "", content: "OUT", exit_code: -1 }
}

-- THE SURVIVE FIXTURE (S7). The three queues, the epoch and the environment all
-- reconstituted correctly must produce NO findings. Without this, every row
-- below is satisfied by a balance that reports a finding unconditionally, and
-- an over-strict reconstitution check would ship exactly as stage 1's
-- over-strict validator nearly did.
pure func test_a_faithful_reconstitution_produces_no_findings() -> bool
  tests [((), true)]
  {
    let p = fixture_program();
    let w = { empty_world_state() |
              script: [{ prose: "s0", tool_calls: [], input_tokens: 1, output_tokens: 2, finish_reason: "stop", chunks: [], error_code: "", error_message: "", advance_ms: 0 },
                       { prose: "s1", tool_calls: [], input_tokens: 1, output_tokens: 2, finish_reason: "stop", chunks: [], error_code: "", error_message: "", advance_ms: 0 }],
              clock_ms: 5,
              approvals: ["yes"],
              env: p.initial_world.synthetic_environment,
              files: p.initial_world.files,
              tools: [fixture_tool(), fixture_tool(), fixture_tool(), fixture_tool()] };
    reconstitution_ok(p, w)
      -- The three quantities are pairwise distinct, which is what makes the row
      -- above able to tell WHICH queue each balance is reading. WI-D22's file
      -- table is 2, which collides with the script's 2 — so it is asserted by
      -- IDENTITY with the program's own table rather than by count, which is
      -- what `FilesNotCarried` compares anyway.
      && List.length(w.script) == 2 && List.length(w.approvals) == 1 && List.length(w.tools) == 4
      && List.length(w.files) == List.length(p.initial_world.files)
  }

-- The exhausted provider interaction must contribute NO script entry. A
-- reconstitution that counted it would over-fill the script by one and serve a
-- response the discovery run never served.
pure func test_an_exhausted_provider_interaction_queues_no_script_entry() -> bool
  tests [((), true)]
  {
    provider_steps_served(fixture_interactions()) == 2
      && count_kind(fixture_interactions(), "expect_provider") == 3
  }

-- Both directions, for each of the three derived queues, from the fixture that
-- otherwise survives. Each mutation moves ONE queue.
pure func test_every_queue_is_balanced_in_both_directions() -> bool
  tests [((), true)]
  {
    let p = fixture_program();
    let good: ScriptedStep = { prose: "s", tool_calls: [], input_tokens: 0, output_tokens: 0, finish_reason: "stop", chunks: [], error_code: "", error_message: "", advance_ms: 0 };
    let tool: ScriptedTool = fixture_tool();
    let base = { empty_world_state() |
                 script: [good, good], clock_ms: 5, approvals: ["yes"],
                 env: p.initial_world.synthetic_environment,
                 files: p.initial_world.files,
                 tools: [tool, tool, tool, tool] };
    has_reconstitution_rule(reconstitution_balance(p, { base | script: [good] }), "reconstitution-queue-underfilled")
      && has_reconstitution_rule(reconstitution_balance(p, { base | script: [good, good, good] }), "reconstitution-queue-overfilled")
      && has_reconstitution_rule(reconstitution_balance(p, { base | approvals: [] }), "reconstitution-queue-underfilled")
      && has_reconstitution_rule(reconstitution_balance(p, { base | approvals: ["yes", "no"] }), "reconstitution-queue-overfilled")
      && has_reconstitution_rule(reconstitution_balance(p, { base | tools: [tool, tool, tool] }), "reconstitution-queue-underfilled")
      && has_reconstitution_rule(reconstitution_balance(p, { base | tools: [tool, tool, tool, tool, tool] }), "reconstitution-queue-overfilled")
      && has_reconstitution_rule(reconstitution_balance(p, { base | clock_ms: 0 }), "reconstitution-epoch-not-carried")
      && has_reconstitution_rule(reconstitution_balance(p, { base | env: [] }), "reconstitution-environment-not-carried")
      -- WI-D22, in BOTH directions like the queues rather than only the dropping
      -- one. A projection that seeded a file the program does not carry serves
      -- the replay a path the discovery run never had, which is design note 3's
      -- objection to carrying the queues, one table over.
      && has_reconstitution_rule(reconstitution_balance(p, { base | files: [] }), "reconstitution-files-not-carried")
      && has_reconstitution_rule(
           reconstitution_balance(p, { base | files: [{ path: "/w/extra", node: FsDir }] ++ p.initial_world.files }),
           "reconstitution-files-not-carried")
  }

-- `world_state_of` against the same fixture: the projection and its own balance
-- agree. This is the join between the two — a reconstitution that satisfies the
-- balance it was written beside proves nothing unless the balance was written to
-- be failable, which the row above establishes.
pure func test_world_state_of_reconstitutes_the_fixture_program() -> bool
  tests [((), true)]
  {
    let p = fixture_program();
    match world_state_of(p, []) {
      Err(_) => false,
      Ok(w) =>
        reconstitution_ok(p, w)
          && List.length(w.script) == 2
          && List.length(w.approvals) == 1
          && List.length(w.tools) == 4
          && w.clock_ms == 5
          -- The log MUST start empty: seeding it with the program's own
          -- interactions would make strict replay compare the program with
          -- itself, which is the tautology this module exists to refuse.
          && List.length(w.log) == 0
    }
  }

-- A program carrying a stage-2 provider payload (the bare prose) is REFUSED,
-- not silently replayed as a step with no tool calls. Failing closed here is
-- what turns an unreplayable program into a named refusal instead of a run that
-- terminates early and agrees with the program at every position it reached.
pure func test_an_unreadable_provider_outcome_refuses_replay() -> bool
  tests [((), true)]
  {
    let p = { fixture_program() |
              interactions: [mk(ProviderIdentity("loop_v2", 0, "m"), 0, ok_out(0, "s0"))] };
    match world_state_of(p, []) {
      Ok(_) => false,
      Err(r) => refusal_rule(r) == "replay-refused-provider-outcome-undecodable"
    }
  }

-- The structural validator runs BEFORE reconstitution (D2: "program decoding
-- and a pure structural validator run before replay"). A malformed program is
-- an `InvalidProgram` refusal at position -1, never a mismatch at position 0.
pure func test_an_invalid_program_refuses_replay_before_reconstitution() -> bool
  tests [((), true)]
  {
    let p = { fixture_program() | schema_version: "" };
    match world_state_of(p, []) {
      Ok(_) => false,
      Err(r) => refusal_rule(r) == "replay-refused-invalid-program"
    }
  }

-- ---------------------------------------------------------------------------
-- Regression replay (stage 5). Every fatal rule shown to STAY fatal, every
-- demoted rule shown to be RECORDED, and strict mode shown to be unmoved.
-- ---------------------------------------------------------------------------

-- `reference()` with one interaction swapped at position 1. Position 1 is the
-- middle: a rule that fires on the wrong position, or a walk that stops at the
-- first difference, is visible from both sides.
pure func at1(i: Interaction) -> [Interaction] {
  [mk(ProviderIdentity("loop_v2", 0, "m"), 0, ok_out(0, "{}")),
   i,
   mk(ApprovalIdentity("loop_v2", "c1", "T"), 2, ok_out(0, "yes"))]
}

pure func tool_at1(payload: string) -> Interaction {
  mk(ToolIdentity("loop_v2", "c1", "T"), 1, ok_out(7, payload))
}

pure func projection_drift() -> [Interaction] {
  at1({ tool_at1("OK") | request_projection: "p1-CHANGED" })
}

pure func outcome_drift() -> [Interaction] {
  at1(tool_at1("DIFFERENT"))
}

-- THE NEGATIVE CONTROL FOR THE WHOLE MODE (S7), and for a mode whose output is
-- a RECORD it is load-bearing twice over: a regression replay that reported a
-- difference unconditionally would pass every recorded-difference row below,
-- and one that reported a fatal unconditionally would pass every fatal row.
pure func test_an_exact_replay_is_regression_clean_with_nothing_recorded() -> bool
  tests [((), true)]
  {
    let r = regression_replay_findings(reference(), reference());
    regression_replay_ok(reference(), reference())
      && List.length(r.fatal) == 0
      && List.length(r.differences) == 0
  }

-- THE CORRELATION GUARANTEE. Five rules, five fixtures, each still FATAL under
-- the mode whose entire purpose is to continue. `UnsafeIdentity` is the row
-- this stage exists to protect: demoting it produces a mode that runs further,
-- reports more, looks more useful, and has delivered one logical request's
-- outcome to another.
pure func test_every_fatal_rule_stays_fatal_in_regression_mode() -> bool
  tests [((), true)]
  {
    let wrong_kind = at1(mk(ProviderIdentity("loop_v2", 1, "m"), 1, ok_out(7, "OK")));
    let wrong_origin = [mk(ProviderIdentity("other", 0, "m"), 0, ok_out(0, "{}")),
                        tool_at1("OK"),
                        mk(ApprovalIdentity("loop_v2", "c1", "T"), 2, ok_out(0, "yes"))];
    let wrong_call_id = at1(mk(ToolIdentity("loop_v2", "c2", "T"), 1, ok_out(7, "OK")));
    let short = [mk(ProviderIdentity("loop_v2", 0, "m"), 0, ok_out(0, "{}")), tool_at1("OK")];
    let long = reference() ++ [mk(ClockAdvanceIdentity, 3, ok_out(1, "1"))];
    let k = regression_replay_findings(reference(), wrong_kind);
    let o = regression_replay_findings(reference(), wrong_origin);
    let u = regression_replay_findings(reference(), wrong_call_id);
    let s = regression_replay_findings(reference(), short);
    let l = regression_replay_findings(reference(), long);
    has_replay_rule(k.fatal, "replay-wrong-kind") && not regression_replay_ok(reference(), wrong_kind)
      && has_replay_rule(o.fatal, "replay-wrong-origin") && not regression_replay_ok(reference(), wrong_origin)
      -- THE line. D2: never delivers an outcome to a different logical request.
      && has_replay_rule(u.fatal, "replay-unsafe-identity-mismatch") && not regression_replay_ok(reference(), wrong_call_id)
      -- And the one that fails silently without its rule: a regression replay
      -- which stops early otherwise reports "no differences" and is believed.
      && has_replay_rule(s.fatal, "replay-unused-interaction") && not regression_replay_ok(reference(), short)
      && has_replay_rule(l.fatal, "replay-program-exhausted") && not regression_replay_ok(reference(), long)
      -- None of the five is quietly filed as a recorded difference instead.
      && List.length(k.differences) == 0 && List.length(o.differences) == 0
      && List.length(u.differences) == 0 && List.length(s.differences) == 0
      && List.length(l.differences) == 0
  }

-- The two demoted rules, one fixture each: RECORDED, and the replay passes.
pure func test_each_demoted_rule_is_recorded_rather_than_fatal() -> bool
  tests [((), true)]
  {
    let p = regression_replay_findings(reference(), projection_drift());
    let o = regression_replay_findings(reference(), outcome_drift());
    regression_replay_ok(reference(), projection_drift())
      && List.length(p.fatal) == 0
      && has_replay_rule(p.differences, "replay-projection-differs")
      && List.length(p.differences) == 1
      && regression_replay_ok(reference(), outcome_drift())
      && List.length(o.fatal) == 0
      && has_replay_rule(o.differences, "replay-outcome-differs")
      && List.length(o.differences) == 1
  }

-- "...and CONTINUE". Two differences at two positions, both recorded, so the
-- walk demonstrably did not stop at the first — and a fatal at a LATER position
-- than a recorded difference is still found, which is the arrangement in which
-- an early `return` would have been invisible.
pure func test_regression_replay_continues_past_a_recorded_difference() -> bool
  tests [((), true)]
  {
    let two = [{ mk(ProviderIdentity("loop_v2", 0, "m"), 0, ok_out(0, "{}")) | request_projection: "p0-CHANGED" },
               tool_at1("OK"),
               mk(ApprovalIdentity("loop_v2", "c1", "T"), 2, ok_out(0, "DENIED"))];
    let then_fatal = [{ mk(ProviderIdentity("loop_v2", 0, "m"), 0, ok_out(0, "{}")) | request_projection: "p0-CHANGED" },
                      tool_at1("OK"),
                      mk(ToolIdentity("loop_v2", "c1", "T"), 2, ok_out(0, "yes"))];
    let a = regression_replay_findings(reference(), two);
    let b = regression_replay_findings(reference(), then_fatal);
    List.length(a.fatal) == 0
      && List.length(a.differences) == 2
      && has_replay_rule(a.differences, "replay-projection-differs")
      && has_replay_rule(a.differences, "replay-outcome-differs")
      -- The fatal is at position 2, behind a recorded difference at position 0.
      && has_replay_rule(b.fatal, "replay-wrong-kind")
      && List.length(b.fatal) == 1
      && has_replay_rule(b.differences, "replay-projection-differs")
  }

-- The decided binding, asserted. At a position whose causal identity matches
-- and whose request AND outcome both changed, regression mode records BOTH —
-- while strict mode still reports exactly one, coarsest first. A regression
-- report that said only "the request changed" would understate the very thing
-- the mode exists to report.
pure func test_both_demoted_differences_at_one_position_are_recorded() -> bool
  tests [((), true)]
  {
    let both = at1({ tool_at1("DIFFERENT") | request_projection: "p1-CHANGED" });
    let r = regression_replay_findings(reference(), both);
    let strict = strict_replay_findings(reference(), both);
    List.length(r.fatal) == 0
      && List.length(r.differences) == 2
      && has_replay_rule(r.differences, "replay-projection-differs")
      && has_replay_rule(r.differences, "replay-outcome-differs")
      -- Strict mode is unmoved: still exactly one, still the coarser of the two.
      && List.length(strict) == 1
      && has_replay_rule(strict, "replay-projection-differs")
  }

-- STRICT MODE IS UNCHANGED, asserted against the shared machinery rather than
-- assumed from it. `compare_at` and `walk` are now parameterised, and a
-- regression-mode edit that reached the shared chain would weaken strict replay
-- silently — every strict row above would keep passing on the fixtures it was
-- written for while some other input diverged. This row pins the property that
-- matters: on every regression fixture in this file, strict mode still reports
-- exactly one finding per position, and it is the one stage 3 specified.
pure func test_regression_mode_did_not_change_strict_mode() -> bool
  tests [((), true)]
  {
    let short = [mk(ProviderIdentity("loop_v2", 0, "m"), 0, ok_out(0, "{}")), tool_at1("OK")];
    let long = reference() ++ [mk(ClockAdvanceIdentity, 3, ok_out(1, "1"))];
    -- The demoted rules are FAILURES in strict mode. This is the direction the
    -- demotion must not leak in.
    let p = strict_replay_findings(reference(), projection_drift());
    let o = strict_replay_findings(reference(), outcome_drift());
    not strict_replay_ok(reference(), projection_drift())
      && has_replay_rule(p, "replay-projection-differs") && List.length(p) == 1
      && not strict_replay_ok(reference(), outcome_drift())
      && has_replay_rule(o, "replay-outcome-differs") && List.length(o) == 1
      -- And the fatal rules are still exactly one finding each, unchanged.
      && List.length(strict_replay_findings(reference(), short)) == 1
      && List.length(strict_replay_findings(reference(), long)) == 1
      && strict_replay_ok(reference(), reference())
  }

-- The RECORD half. Differences that are computed and then dropped satisfy every
-- count above and tell nobody anything, so the report is asserted to name each
-- one by its rule.
pure func test_the_regression_report_names_every_recorded_difference() -> bool
  tests [((), true)]
  {
    let both = at1({ tool_at1("DIFFERENT") | request_projection: "p1-CHANGED" });
    let r = regression_replay_findings(reference(), both);
    let text = regression_report(r);
    regression_difference_count(r) == 2
      && Str.contains(text, "2 recorded difference")
      && Str.contains(text, "[replay-projection-differs]")
      && Str.contains(text, "[replay-outcome-differs]")
      && Str.contains(regression_report(regression_replay_findings(reference(), reference())),
                      "0 recorded difference")
  }
