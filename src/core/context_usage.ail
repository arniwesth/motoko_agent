module src/core/context_usage

import std/string (length, startsWith, substring)
import std/list (foldl)
import std/fs (fileExists, readFile)
import std/env (getEnvOr)
import std/json (Json, decode, get, getInt)
import std/option (Option, Some, None)
import std/result (Ok, Err)
import src/core/types (Msg)

export pure func estimate_tokens(msgs: [Msg], system: string) -> int =
  let total = length(system) + foldl(\acc m. acc + length(m.content), 0, msgs) in
  (total + 3) / 4

pure func est0(system: string) -> int
  tests [
    ("",      0),
    ("abcd",  1),
    ("abcde", 2)
  ]
  { estimate_tokens([], system) }

func catalog_path() -> string ! {Env, FS} {
  let explicit = getEnvOr("MOTOKO_MODELS_FILE", "");
  if explicit != "" then explicit
  else if fileExists(".motoko/model-catalog.json") then ".motoko/model-catalog.json"
  else {
    let repo = getEnvOr("MOTOKO_REPO", "");
    if repo != "" then "${repo}/.motoko/model-catalog.json"
    else ".motoko/model-catalog.json"
  }
}

func lookup_context_limit(limits: Json, model: string) -> Option[int] {
  match getInt(limits, model) {
    Some(n) => if n > 0 then Some(n) else None,
    None => {
      if startsWith(model, "openrouter/") then {
        let stripped = substring(model, length("openrouter/"), length(model));
        match getInt(limits, stripped) {
          Some(n) => if n > 0 then Some(n) else None,
          None => None
        }
      } else None
    }
  }
}

export func catalog_context_limit_for(model: string) -> int ! {Env, FS} {
  let path = catalog_path();
  if not fileExists(path) then 0
  else {
    match decode(readFile(path)) {
      Err(_) => 0,
      Ok(root) => match get(root, "context_limits") {
        Some(limits) => match lookup_context_limit(limits, model) {
          Some(n) => n,
          None => 0
        },
        None => 0
      }
    }
  }
}

-- Active profile directory, mirroring the launcher's convention: an explicit
-- MOTOKO_PROFILE_DIR wins (set by verify_extensions and the live launcher),
-- else `.motoko/config/<MOTOKO_CONFIG|default>` under an optional MOTOKO_REPO.
func profile_dir_path() -> string ! {Env} {
  let explicit = getEnvOr("MOTOKO_PROFILE_DIR", "");
  if explicit != "" then explicit
  else {
    let profile = getEnvOr("MOTOKO_CONFIG", "default");
    let repo = getEnvOr("MOTOKO_REPO", "");
    if repo != "" then "${repo}/.motoko/config/${profile}"
    else ".motoko/config/${profile}"
  }
}

-- Deployment-scoped context-limit override from the active profile's
-- `agent.context_limit`. Context size is a property of the *endpoint* (a local
-- server may serve 100K while the same model on a cloud provider serves 1M), so
-- a profile can declare its serving context here instead of overloading the
-- model identifier in the shared catalog. Returns 0 (no override) when absent.
func config_context_limit_override() -> int ! {Env, FS} {
  let path = "${profile_dir_path()}/config.json";
  if not fileExists(path) then 0
  else match decode(readFile(path)) {
    Err(_) => 0,
    Ok(root) => match get(root, "agent") {
      Some(agent) => match getInt(agent, "context_limit") {
        Some(n) => if n > 0 then n else 0,
        None => 0
      },
      None => 0
    }
  }
}

-- Effective context limit for a model in the current deployment: the profile's
-- `agent.context_limit` override wins, else the per-model catalog value, else 0
-- ("unknown" — compaction extensions skip context-aware behaviour).
export func resolve_context_limit(model: string) -> int ! {Env, FS} {
  let override = config_context_limit_override();
  if override > 0 then override else catalog_context_limit_for(model)
}
