-- src/core/agent_loop_v2.ail
--
-- Phase C compatibility facade. The live v2 driver is owned by
-- src/core/session.ail; this module keeps the historical import surface
-- stable for RPC, smoke tests, and external callers.

module src/core/agent_loop_v2

import std/ai (Message, AIError)
import std/result (Result)
import src/core/config (CostRates)
import src/core/types (Msg)
import src/core/test/stub_step (StepProvider, Scripted)
import src/core/ports (ScriptedStep)
import pkg/sunholo/motoko_ext_abi/types (BudgetPlan, ExtRuntime)
import src/core/session as Session

export func run_v2(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  initial_msgs: [Msg],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2(rt, task, env_url, hybrid_tools, budget, model, initial_msgs, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider)
}

export func run_v2_from_messages(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_from_messages(rt, task, env_url, hybrid_tools, budget, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider)
}

export func conversation_loop_v2(
  rt: ExtRuntime,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider,
  session_id: string
) -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.conversation_loop_v2(rt, env_url, hybrid_tools, budget, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider, session_id)
}

export func run_v2_with_conversation(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  initial_msgs: [Msg],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider
) -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_with_conversation(rt, task, env_url, hybrid_tools, budget, model, initial_msgs, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider)
}

export func run_v2_with_stub(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  script: [ScriptedStep]
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_from_messages(rt, task, env_url, hybrid_tools, budget, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, Scripted(script))
}

export func run_v2_with_stub_port_adapter(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  script: [ScriptedStep]
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_from_messages(rt, task, env_url, hybrid_tools, budget, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, Scripted(script))
}
