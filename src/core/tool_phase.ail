-- src/core/tool_phase.ail
--
-- Phase C approval-planning surface. Full native/delegated execution moves
-- here later; WI-C4 only inverts the pending-approval protocol into data.

module src/core/tool_phase

import std/ai (Message, ToolCall)
import std/json (Json, jo, kv, js, jb, encode, decode, get, asString)
import std/list as List (length)
import std/option (Option, Some, None)
import std/string (startsWith)
import std/trace as Trace
import pkg/sunholo/motoko_ext_abi/types (ExtCtx, ExtRuntime, PolicyDefault, ToolPolicyDecision, ToolHandleDecision, ExtensionHooks)
import src/core/ext/runtime (dispatch_tool_policy, dispatch_tool_handle)
import src/core/phase_vocab (
  ApprovalRequest,
  ToolPlan,
  ToolPlanEntry,
  ToolPending,
  NativeToolDenied,
  ExtToolHandled,
  DelegatedToolDeferred,
  V2ToolDispatchStart,
  V2ToolDispatchComplete,
  ScratchpadResult,
  ToolDeniedInfo,
  LedgerEvent,
  ExecNative,
  handled_tool_message,
  tool_result_message
)
import src/core/ports (ApprovalResolution, ApprovalAllowed, ApprovalDenied)
import src/core/tool_contract (ToolResultEnvelope)
import src/core/tool_dispatch_adapter (dispatch_one, tool_call_to_envelope)
import src/core/tool_runtime (backend_for_v2)
import src/core/types (ToolBackend)
import pkg/sunholo/motoko_ext_scratchpad/ws_loopback (exec_scratchpad_cell_ws)

export type PendingApprovalPlan = {
  event: LedgerEvent,
  request: ApprovalRequest
}

export type ApprovalCommand = ParsedApprove | ParsedDeny(string) | ParsedUnknown | ParsedUnparseable

export pure func tool_pending_event(step: int, stream_id: string, call: ToolCall, reason: string) -> LedgerEvent {
  ToolPending({ step: step, stream_id: stream_id, tool: call.name, id: call.id, reason: reason })
}

export pure func plan_pending_approval(step: int, stream_id: string, plan: ToolPlan, default_allow: bool, reason: string) -> Option[PendingApprovalPlan] {
  match plan.entries {
    [] => None,
    first :: rest => Some({
      event: tool_pending_event(step, stream_id, first.call, reason),
      request: {
        call: first.call,
        default_allow: default_allow,
        reason: reason,
        stream_id: stream_id,
        remaining: rest
      }
    })
  }
}

export pure func plan_pending_approval_from_calls(step: int, stream_id: string, calls: [ToolCall], default_allow: bool, reason: string) -> Option[PendingApprovalPlan] {
  plan_pending_approval(step, stream_id, native_plan(calls), default_allow, reason)
}

export pure func parse_approval_command(raw: string) -> ApprovalCommand {
  match decode(raw) {
    Err(_) => ParsedUnparseable,
    Ok(obj) => {
      let cmd_type = msg_get_str(obj, "type");
      if cmd_type == "approve" then ParsedApprove
      else if cmd_type == "deny" then {
        let r = msg_get_str(obj, "reason");
        ParsedDeny(if r == "" then "denied by operator" else r)
      }
      else ParsedUnknown
    }
  }
}

export pure func resolve_approval(raw: string, default_allow: bool, eof: bool) -> ApprovalResolution {
  if eof then {
    if default_allow then ApprovalAllowed else ApprovalDenied("timeout — no approval received")
  } else match parse_approval_command(raw) {
    ParsedApprove => ApprovalAllowed,
    ParsedDeny(reason) => ApprovalDenied(reason),
    ParsedUnparseable => if default_allow then ApprovalAllowed else ApprovalDenied("unparseable response — default deny applied"),
    ParsedUnknown => if default_allow then ApprovalAllowed else ApprovalDenied("unknown approval command — default deny applied")
  }
}

export pure func denial_message(call: ToolCall, reason: string) -> Message {
  let payload = encode(jo([
    kv("error", jb(true)),
    kv("denied_by_policy", jb(true)),
    kv("tool", js(call.name)),
    kv("reason", js(reason))
  ]));
  {
    role: "tool",
    content: payload,
    tool_calls: [],
    tool_call_id: call.id,
    images: []
  }
}

pure func msg_get_str(obj: Json, key: string) -> string {
  match get(obj, key) {
    None => "",
    Some(j) => match asString(j) { None => "", Some(s) => s }
  }
}

export pure func approval_resume_plan(req: ApprovalRequest) -> ToolPlan {
  { entries: req.remaining }
}

export pure func execution_order_after_approval(req: ApprovalRequest) -> [string] {
  req.call.id :: plan_entry_ids(req.remaining)
}

pure func plan_entry_ids(entries: [ToolPlanEntry]) -> [string] {
  match entries {
    [] => [],
    e :: rest => e.call.id :: plan_entry_ids(rest)
  }
}

export pure func native_plan_entry(call: ToolCall) -> ToolPlanEntry {
  { call: call, executor: ExecNative }
}

export pure func native_plan(calls: [ToolCall]) -> ToolPlan {
  match calls {
    [] => { entries: [] },
    c :: rest => {
      let tail = native_plan(rest);
      { entries: native_plan_entry(c) :: tail.entries }
    }
  }
}

export type ToolDispatchOutcome
  = ToolDispatchDone([Message])
  | ToolDispatchPending({ request: ApprovalRequest, accumulated: [Message] })

pure func policy_default_allow(default: PolicyDefault) -> bool {
  match default {
    AllowAfterTimeout => true,
    DenyAfterTimeout => false
  }
}

func is_scratchpad_tool_name(name: string) -> bool {
  name == "scratchpad" || name == "Scratchpad"
}

func scratchpad_extension_active(rt: ExtRuntime) -> bool {
  scratchpad_extension_active_rec(rt.registry.hooks)
}

func scratchpad_extension_active_rec(hooks: [ExtensionHooks]) -> bool {
  match hooks {
    [] => false,
    h :: rest => startsWith(h.id, "scratchpad#") || h.id == "scratchpad" || scratchpad_extension_active_rec(rest)
  }
}

func scratchpad_cells_arg(args: Json) -> Json {
  match get(args, "cells") {
    Some(j) => j,
    None => jo([])
  }
}

func delegated_deferred_message(call: ToolCall) -> Message {
  let payload = encode(jo([
    kv("error", jb(true)),
    kv("delegated_backend_not_wired", jb(true)),
    kv("tool", js(call.name)),
    kv("note", js("v2 split_by_backend selected Delegated; the inbox-based ohmy_pi wait is deferred to a follow-up milestone. Re-run with settings.ohmy_pi=false or use a tool that resolves to the Native backend."))
  ]));
  {
    role: "tool",
    content: payload,
    tool_calls: [],
    tool_call_id: call.id,
    images: []
  }
}

func emit_scratchpad_result_if_present(emit: (LedgerEvent) -> () ! {IO, Trace}, request_id: string, step_idx: int, tool_call_id: string, result_env: ToolResultEnvelope) -> () ! {IO, Trace} {
  if is_scratchpad_tool_name(result_env.tool) then
    match get(result_env.metadata, "cells") {
      None => (),
      Some(cells) =>
        emit(ScratchpadResult({
          tool_call_id: tool_call_id,
          request_id: request_id,
          step: step_idx,
          cells_json: encode(cells)
        }))
    }
  else ()
}

export func execute_allowed_tool_call(
  rt: ExtRuntime,
  ctx: ExtCtx,
  call: ToolCall,
  workdir: string,
  step_idx: int,
  stream_id: string,
  ohmy_pi: bool,
  emit: (LedgerEvent) -> () ! {IO, Trace}
) -> Message ! {FS, Process, IO, Clock, AI, Env, Net, SharedMem, Stream, Trace} {
  let envelope = tool_call_to_envelope(call);
  if is_scratchpad_tool_name(envelope.tool) && scratchpad_extension_active(rt) then {
    let result_cell = exec_scratchpad_cell_ws(rt, ctx, envelope, scratchpad_cells_arg(envelope.arguments), 30);
    let result_env: ToolResultEnvelope = {
      tool_call_id: envelope.id,
      tool: "scratchpad",
      exit_code: result_cell.exit_code,
      stdout: result_cell.stdout,
      stderr: result_cell.stderr,
      metadata: result_cell.metadata
    };
    let _ = emit(ExtToolHandled({
      step: step_idx,
      stream_id: stream_id,
      tool: call.name,
      id: call.id,
      exit_code: result_env.exit_code
    }));
    let _ = emit_scratchpad_result_if_present(emit, "step-${show(step_idx)}", step_idx, call.id, result_env);
    handled_tool_message(call.id, result_env)
  } else {
    let handle_decision = dispatch_tool_handle(rt, ctx, envelope);
    match handle_decision {
      Handled(result_env) => {
        let _ = emit(ExtToolHandled({
          step: step_idx,
          stream_id: stream_id,
          tool: call.name,
          id: call.id,
          exit_code: result_env.exit_code
        }));
        let _ = emit_scratchpad_result_if_present(emit, "step-${show(step_idx)}", step_idx, call.id, result_env);
        handled_tool_message(call.id, result_env)
      },
      Delegate => {
        let backend = if ohmy_pi then backend_for_v2(envelope, true) else Native;
        match backend {
          Delegated => {
            let _ = emit(DelegatedToolDeferred({
              step: step_idx,
              stream_id: stream_id,
              tool: call.name,
              id: call.id
            }));
            delegated_deferred_message(call)
          },
          Native => {
            let _ = emit(V2ToolDispatchStart({
              step: step_idx,
              stream_id: stream_id,
              tool: call.name,
              id: call.id
            }));
            let result_content = dispatch_one(workdir, call);
            let _ = emit(V2ToolDispatchComplete({
              step: step_idx,
              stream_id: stream_id,
              id: call.id
            }));
            tool_result_message(call, result_content)
          }
        }
      }
    }
  }
}

export func dispatch_tool_entries(
  rt: ExtRuntime,
  ctx: ExtCtx,
  entries: [ToolPlanEntry],
  workdir: string,
  step_idx: int,
  stream_id: string,
  ohmy_pi: bool,
  accumulated: [Message],
  emit: (LedgerEvent) -> () ! {IO, Trace}
) -> ToolDispatchOutcome ! {FS, Process, IO, Clock, AI, Env, Net, SharedMem, Stream, Trace} {
  dispatch_tool_entries_with_builtin(rt, ctx, entries, workdir, step_idx, stream_id, ohmy_pi, accumulated, emit, \_ . None)
}

export func dispatch_tool_entries_with_builtin(
  rt: ExtRuntime,
  ctx: ExtCtx,
  entries: [ToolPlanEntry],
  workdir: string,
  step_idx: int,
  stream_id: string,
  ohmy_pi: bool,
  accumulated: [Message],
  emit: (LedgerEvent) -> () ! {IO, Trace},
  builtin: (ToolCall) -> Option[Message]
) -> ToolDispatchOutcome ! {FS, Process, IO, Clock, AI, Env, Net, SharedMem, Stream, Trace} {
  match entries {
    [] => ToolDispatchDone(accumulated),
    entry :: rest => {
      let call = entry.call;
      match builtin(call) {
        Some(msg) =>
          dispatch_tool_entries_with_builtin(rt, ctx, rest, workdir, step_idx, stream_id, ohmy_pi, accumulated ++ [msg], emit, builtin),
        None => {
          let envelope = tool_call_to_envelope(call);
          let policy = dispatch_tool_policy(rt, ctx, envelope);
          match policy {
            Deny(reason) => {
              let _ = emit(NativeToolDenied({
                step: step_idx,
                stream_id: stream_id,
                tool: call.name,
                id: call.id,
                reason: reason
              }));
              let denial_msg = denial_message(call, reason);
              dispatch_tool_entries_with_builtin(rt, ctx, rest, workdir, step_idx, stream_id, ohmy_pi, accumulated ++ [denial_msg], emit, builtin)
            },
            Pending(reason, default) => {
              let _ = emit(ToolPending({
                step: step_idx,
                stream_id: stream_id,
                tool: call.name,
                id: call.id,
                reason: reason
              }));
              ToolDispatchPending({
                request: {
                  call: call,
                  default_allow: policy_default_allow(default),
                  reason: reason,
                  stream_id: stream_id,
                  remaining: rest
                },
                accumulated: accumulated
              })
            },
            _ => {
              let msg = execute_allowed_tool_call(rt, ctx, call, workdir, step_idx, stream_id, ohmy_pi, emit);
              dispatch_tool_entries_with_builtin(rt, ctx, rest, workdir, step_idx, stream_id, ohmy_pi, accumulated ++ [msg], emit, builtin)
            }
          }
        }
      }
    }
  }
}

pure func call(id: string, name: string) -> ToolCall {
  { id: id, name: name, arguments: "{}" }
}

pure func entry(id: string) -> ToolPlanEntry {
  native_plan_entry(call(id, "BashExec"))
}

pure func test_plan_pending_approval_preserves_tail() -> bool
  tests [((), true)]
  {
    let plan: ToolPlan = { entries: [entry("a"), entry("b")] };
    match plan_pending_approval(1, "s", plan, false, "why") {
      Some(p) => p.request.call.id == "a" && List.length(p.request.remaining) == 1,
      None => false
    }
  }

pure func test_native_plan_builds_entries() -> bool
  tests [((), true)]
  {
    List.length(native_plan([call("a", "BashExec"), call("b", "BashExec")]).entries) == 2
  }

pure func test_plan_pending_approval_from_calls() -> bool
  tests [((), true)]
  {
    match plan_pending_approval_from_calls(1, "s", [call("a", "BashExec"), call("b", "BashExec")], true, "why") {
      Some(p) => p.request.call.id == "a" && List.length(p.request.remaining) == 1,
      None => false
    }
  }

pure func test_resolve_approval_defaults() -> bool
  tests [((), true)]
  {
    match resolve_approval("", true, true) {
      ApprovalAllowed =>
        match resolve_approval("not-json", false, false) {
          ApprovalDenied(r) => r == "unparseable response — default deny applied",
          _ => false
        },
      _ => false
    }
  }

pure func test_denial_message_uses_tool_role_and_call_id() -> bool
  tests [((), true)]
  {
    let m = denial_message(call("tc", "BashExec"), "no");
    m.role == "tool"
      && m.tool_call_id == "tc"
      && List.length(m.tool_calls) == 0
      && m.content == "{\"error\":true,\"denied_by_policy\":true,\"tool\":\"BashExec\",\"reason\":\"no\"}"
  }

pure func test_resolve_approval_live_protocol() -> bool
  tests [((), true)]
  {
    match resolve_approval("{\"type\":\"approve\"}", false, false) {
      ApprovalAllowed =>
        match resolve_approval("{\"type\":\"deny\",\"reason\":\"blocked\"}", true, false) {
          ApprovalDenied(r1) =>
            match resolve_approval("{\"type\":\"deny\"}", true, false) {
              ApprovalDenied(r2) =>
                match resolve_approval("{\"type\":\"later\"}", false, false) {
                  ApprovalDenied(r3) =>
                    match resolve_approval("", false, true) {
                      ApprovalDenied(r4) =>
                        r1 == "blocked"
                          && r2 == "denied by operator"
                          && r3 == "unknown approval command — default deny applied"
                          && r4 == "timeout — no approval received",
                      _ => false
                    },
                  _ => false
                },
              _ => false
            },
          _ => false
        },
      _ => false
    }
  }

pure func test_execution_order_after_approval() -> bool
  tests [((), true)]
  {
    let plan: ToolPlan = { entries: [entry("a"), entry("b"), entry("c")] };
    match plan_pending_approval(1, "s", plan, true, "why") {
      Some(p) =>
        match execution_order_after_approval(p.request) {
          "a" :: "b" :: "c" :: [] => true,
          _ => false
        },
      None => false
    }
  }
