import std/json (Json, jo, kv, js, jb, jnum, encode, decode, get, asString)
import std/list as List (length)
import std/option (Option, Some, None)
import std/string (startsWith, trim)
import std/trace as Trace
import pkg/sunholo/motoko_ext_abi/types (ExtCtx, ExtRuntime, PolicyDefault, ToolPolicyDecision, ToolHandleDecision, ExtensionHooks)
import src/core/ext/runtime (dispatch_tool_policy, dispatch_tool_handle)
import src/core/phase_vocab (
  ApprovalRequest,
  ToolPlan,
  ToolPlanEntry,
  ToolPending,
  NativeToolDenied,
  ExtToolHandled,
  DelegatedToolDeferred,
  V2ToolDispatchStart,
  V2ToolDispatchComplete,
  ScratchpadResult,
  ToolDeniedInfo,
  LedgerEvent,
  ExecNative,
  handled_tool_message,
  tool_result_message
)
import src/core/ports (ApprovalResolution, ApprovalAllowed, ApprovalDenied, Ports, WorldState, ToolInvocation, ToolExecution, ToolOutcome, ToolCompleted, ToolFailed, ToolCorrelationMismatch, ToolDeadlineExceeded)
import src/core/dst_fault_catalogue (
  fault_class_tool_failed,
  fault_class_tool_correlation_mismatch,
