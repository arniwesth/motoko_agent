-- src/core/tool_catalog.ail
-- ToolSchema definitions for motoko_agent's 6 native tools, in the
-- shape upstream `std/ai.runTools` expects (M-AI-TOOL-LOOP, target
-- AILANG v0.17.0):
--
--   ToolSchema = { name: string, description: string, parameters: string }
--
-- `parameters` is a JSON Schema string — same shape as the existing
-- non-streaming AI providers' tool definitions. The model uses these to
-- decide which tool to call and with what arguments; runTools wraps each
-- emitted ToolCall and forwards it to the dispatch callback (provided by
-- src/core/tool_dispatch_adapter).
--
-- These schemas mirror the fork's existing tool argument shapes (look at
-- src/core/tool_runtime.ail's `arg_string`/`arg_number`/`arg_bool` calls
-- per-tool to see the field names). Keeping them aligned means the
-- adapter's argument-decoding layer doesn't need a translation step.

module src/core/tool_catalog

import std/ai (ToolSchema)
import std/list as List (length)
import std/string (contains)
import std/json (Json, jo, kv, js, getString)
import std/option (Some, None)
import src/core/config (VerificationConfig)
import pkg/sunholo/motoko_ext_abi/types (ExtRuntime, ExtEntry, Capability, DescribeTools, ToolProvider, ProviderCtx, ToolCallEnvelope, ToolHandleOutcome, Delegate)

-- Each schema's `parameters` field is a JSON-Schema-shaped string. To keep
-- the strings readable AILANG-side, we build them in helper functions
-- rather than inline. Strings carry no escape problems at this size, but
-- if a schema grows past ~30 lines, factor it into its own pure func.

pure func read_file_schema() -> ToolSchema = {
  name: "ReadFile",
  description: "Read a file from the workdir. Use start/end to read a line range; default reads up to 200 lines.",
  parameters: "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Relative path within the workdir.\"},\"start\":{\"type\":\"integer\",\"description\":\"1-indexed first line (default 1)\"},\"end\":{\"type\":\"integer\",\"description\":\"1-indexed last line (default 200)\"}},\"required\":[\"path\"]}"
}

pure func write_file_schema() -> ToolSchema = {
  name: "WriteFile",
  description: "Write the given content to a file in the workdir. Creates parent directories if needed.",
  parameters: "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"path\",\"content\"]}"
}

pure func edit_file_schema() -> ToolSchema = {
  name: "EditFile",
  description: "Apply a sequence of substring edits to a file. Supports dry-run mode and SHA-256 guard for optimistic concurrency.",
  parameters: "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"edits\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"old\":{\"type\":\"string\"},\"new\":{\"type\":\"string\"}},\"required\":[\"old\",\"new\"]}},\"dry_run\":{\"type\":\"boolean\"},\"expected_sha256\":{\"type\":\"string\"}},\"required\":[\"path\",\"edits\"]}"
}

pure func bash_exec_schema() -> ToolSchema = {
  name: "BashExec",
  description: "Run a shell command in the workdir with capability gating. Output is captured to stdout/stderr with truncation past a configured byte cap.",
  parameters: "{\"type\":\"object\",\"properties\":{\"cmd\":{\"type\":\"string\"},\"args\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"timeout_secs\":{\"type\":\"integer\"}},\"required\":[\"cmd\"]}"
}

pure func run_tests_schema() -> ToolSchema = {
  name: "RunTests",
  description: "Run the project's test suite (e.g. make test, pytest). Returns exit code, stdout, stderr.",
  parameters: "{\"type\":\"object\",\"properties\":{\"cmd\":{\"type\":\"string\",\"description\":\"Test command, defaults to 'make test'\"},\"args\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[]}"
}

pure func search_schema() -> ToolSchema = {
  name: "Search",
  description: "Search files in the workdir for a regex pattern. Returns line-level matches with file path + line number.",
  parameters: "{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\"},\"dir\":{\"type\":\"string\",\"description\":\"Subdirectory to scope the search (default '.')\"}},\"required\":[\"pattern\"]}"
}

pure func motoko_runtime_status_schema() -> ToolSchema = {
  name: "MotokoRuntimeStatus",
  description: "Get exact Motoko runtime status for the current session, including current step, step budget, compaction counts, system-prefix digest, cumulative usage, and the current context-window size (both the provider-reported actual_input_tokens and the char/4 estimated_input_tokens, each as a percent of context_limit). context_window.context_limit_source names how the limit was resolved: its arm is bounded, disabled or unknown, and for unknown it names both the profile miss and the catalogue miss. When the arm is not bounded the percentages are UNMEASURED and reported as 0, which does not mean the window is empty. Use this when asked about how many steps have run, how full the context window is, whether compaction happened, or whether the system prefix stayed stable.",
  parameters: "{\"type\":\"object\",\"properties\":{},\"required\":[]}"
}

-- The full tool catalog motoko_agent advertises to the model. Pass this
-- to upstream `runTools(model, msgs, tools(), dispatch, budget)`.
export pure func tools() -> [ToolSchema] {
  [
    read_file_schema(),
    write_file_schema(),
    edit_file_schema(),
    bash_exec_schema(),
    run_tests_schema(),
    search_schema(),
    motoko_runtime_status_schema()
  ]
}

-- Minimal ToolSchema for an extension-provided tool. Extensions supply only
-- a name string; we synthesise a description and an empty JSON Schema so the
-- model can emit the call and the dispatcher can route it.
pure func ext_tool_schema(name: string) -> ToolSchema {
  {
    name: name,
    description: "Extension tool: ${name}",
    parameters: "{\"type\":\"object\",\"properties\":{},\"required\":[]}"
  }
}

pure func collect_hook_schemas(names: [string]) -> [ToolSchema] {
  match names {
    [] => [],
    n :: rest => ext_tool_schema(n) :: collect_hook_schemas(rest)
  }
}

-- B8: an entry's DescribeTools atoms, concatenated in list order.
-- 8.0 (031 ADR-001 D2, N49): each catalog receives the ENTRY'S `config` -- the
-- registration's disclosed configuration -- where it was called with `()`. A
-- catalog whose schemas are fixed ignores the argument; the four in-tree
-- catalogs that used to capture discovered schemas or a provider list at
-- registration read them from here instead.
pure func declared_schemas(config: Json, caps: [Capability]) -> [ToolSchema] {
  match caps {
    [] => [],
    DescribeTools(f) :: rest => f(config) ++ declared_schemas(config, rest),
    _ :: rest => declared_schemas(config, rest)
  }
}

-- B8: the names every ToolProvider atom of an entry advertises, in list order.
pure func provided_names(caps: [Capability]) -> [string] {
  match caps {
    [] => [],
    ToolProvider(names, _) :: rest => names ++ provided_names(rest),
    _ :: rest => provided_names(rest)
  }
}

-- Prefer hook-declared schemas when available; fall back to name-only synthesis.
pure func hook_schemas(e: ExtEntry) -> [ToolSchema] {
  let declared = declared_schemas(e.config, e.caps);
  match declared {
    [] => collect_hook_schemas(provided_names(e.caps)),
    _ => declared
  }
}

pure func collect_ext_schemas(entries: [ExtEntry]) -> [ToolSchema] {
  match entries {
    [] => [],
    e :: rest => hook_schemas(e) ++ collect_ext_schemas(rest)
  }
}

pure func contains_name(names: [string], name: string) -> bool {
  match names {
    [] => false,
    n :: rest => if n == name then true else contains_name(rest, name)
  }
}

-- One schema per tool name, in input order; the FIRST schema for a name is kept.
pure func unique_by_name(xs: [ToolSchema], seen: [string]) -> [ToolSchema] {
  match xs {
    [] => [],
    x :: rest =>
      if contains_name(seen, x.name) then unique_by_name(rest, seen)
      else x :: unique_by_name(rest, x.name :: seen)
  }
}

-- Full tool catalog including any tools registered by active extensions.
-- Use this instead of `tools()` when an ExtRuntime is available so that
-- extension-provided tools appear in the LLM's tool list.
--
-- EVERY NAME APPEARS ONCE (#204). An extension may claim a native tool's name
-- to wrap it -- `ToolProvider(["WriteFile"], ...)`, as microrag and
-- ailang_tools do -- and `hook_schemas` then yields a schema under that name,
-- the name-only one when the extension declares none. Appended as it was, the
-- request carried the name twice. Anthropic, Gemini and xAI reject such a
-- request outright (400, "Tool names must be unique"); measured 2026-10-04 with
-- the request `live_ports` sends for the shipped `microrag` profile.
--
-- The first schema for a name is kept and native schemas come first, so a
-- wrapped native tool keeps the native schema. That is right for a wrapper that
-- takes the native arguments, which every in-tree one does. Between two
-- extensions the earlier registry entry wins, and that is also the entry
-- `first_handle` consults first. Whether an extension may REPLACE a native
-- schema with its own is not decided here.
export pure func tools_with_extensions(rt: ExtRuntime) -> [ToolSchema] {
  unique_by_name(tools() ++ collect_ext_schemas(rt.registry.entries), [])
}

-- Inline tests

pure func test_base_tools_count() -> bool
  tests [((), true)]
  { List.length(tools()) == 7 }

pure func test_no_extensions_returns_base_tools() -> bool
  tests [((), true)]
  {
    let v: VerificationConfig = { enabled: false, command: "make check_core" };
    let rt: ExtRuntime = { registry: { entries: [] }, strict_mode: false, verification: v };
    List.length(tools_with_extensions(rt)) == 7
  }

-- 8.0: a catalog that differs between a configured and an empty tool set,
-- read through the entry's `config`. NAMED, as the registration boundary
-- requires of a payload.
pure func configured_catalog(cfg: Json) -> [ToolSchema] {
  match getString(cfg, "tool") {
    Some(name) => [ext_tool_schema(name)],
    None => []
  }
}

pure func catalog_rt(config: Json) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "make check_core" };
  { registry: { entries: [{ id: "cat#0", config: config, caps: [DescribeTools(configured_catalog)] }] }, strict_mode: false, verification: v }
}

pure func last_name(xs: [ToolSchema]) -> string {
  match xs {
    [] => "",
    x :: [] => x.name,
    _ :: rest => last_name(rest)
  }
}

pure func test_describe_tools_receives_the_entry_config() -> bool
  tests [((), true)]
  {
    let configured = tools_with_extensions(catalog_rt(jo([kv("tool", js("Configured"))])));
    let empty = tools_with_extensions(catalog_rt(jo([])));
    List.length(configured) == 8 && last_name(configured) == "Configured" && List.length(empty) == 7
  }

pure func test_ext_schema_synthesised_name() -> bool
  tests [((), true)]
  {
    let s = ext_tool_schema("MyTool");
    s.name == "MyTool"
  }

pure func test_runtime_status_schema() -> bool
  tests [((), true)]
  {
    let s = motoko_runtime_status_schema();
    s.name == "MotokoRuntimeStatus"
      && contains(s.description, "how many steps have run")
      && contains(s.description, "system prefix stayed stable")
      && s.parameters == "{\"type\":\"object\",\"properties\":{},\"required\":[]}"
  }

-- #204: the registration shapes that used to put a native name in the catalog
-- twice. `wrapper_handle` is never called here; the catalog reads only the
-- name list beside it.
pure func wrapper_handle(ctx: ProviderCtx, _call: ToolCallEnvelope)
  -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand, Trace} {
  { decision: Delegate, next_state: ctx.world }
}

pure func rt_of(entries: [ExtEntry]) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "make check_core" };
  { registry: { entries: entries }, strict_mode: false, verification: v }
}

-- ailang_tools' shape: native names claimed, no `DescribeTools` atom.
pure func undeclared_wrapper() -> ExtEntry {
  { id: "wrap#0", config: jo([]), caps: [ToolProvider(["WriteFile", "EditFile", "ReadFile"], wrapper_handle)] }
}

-- microrag's shape: a native name claimed beside a `DescribeTools` that
-- declares nothing.
pure func empty_catalog(_cfg: Json) -> [ToolSchema] { [] }

pure func empty_catalog_wrapper() -> ExtEntry {
  { id: "wrap#1", config: jo([]), caps: [DescribeTools(empty_catalog), ToolProvider(["WriteFile"], wrapper_handle)] }
}

pure func declared_write_file(_cfg: Json) -> [ToolSchema] {
  [{ name: "WriteFile", description: "an extension's own WriteFile", parameters: "{\"type\":\"object\"}" }]
}

pure func shared_first(_cfg: Json) -> [ToolSchema] {
  [{ name: "Shared", description: "first", parameters: "{}" }, ext_tool_schema("OnlyFirst")]
}

pure func shared_second(_cfg: Json) -> [ToolSchema] {
  [{ name: "Shared", description: "second", parameters: "{}" }, ext_tool_schema("OnlySecond")]
}

pure func count_named(xs: [ToolSchema], name: string) -> int {
  match xs {
    [] => 0,
    x :: rest => (if x.name == name then 1 else 0) + count_named(rest, name)
  }
}

pure func each_name_once(all: [ToolSchema], xs: [ToolSchema]) -> bool {
  match xs {
    [] => true,
    x :: rest => count_named(all, x.name) == 1 && each_name_once(all, rest)
  }
}

pure func description_of(xs: [ToolSchema], name: string) -> string {
  match xs {
    [] => "",
    x :: rest => if x.name == name then x.description else description_of(rest, name)
  }
}

pure func parameters_of(xs: [ToolSchema], name: string) -> string {
  match xs {
    [] => "",
    x :: rest => if x.name == name then x.parameters else parameters_of(rest, name)
  }
}

pure func names_csv(xs: [ToolSchema]) -> string {
  match xs {
    [] => "",
    x :: [] => x.name,
    x :: rest => "${x.name},${names_csv(rest)}"
  }
}

pure func native_names_csv() -> string {
  "ReadFile,WriteFile,EditFile,BashExec,RunTests,Search,MotokoRuntimeStatus"
}

pure func test_wrapped_native_names_appear_once() -> bool
  tests [((), true)]
  {
    let undeclared = tools_with_extensions(rt_of([undeclared_wrapper()]));
    let empty = tools_with_extensions(rt_of([empty_catalog_wrapper()]));
    let both = tools_with_extensions(rt_of([undeclared_wrapper(), empty_catalog_wrapper()]));
    names_csv(undeclared) == native_names_csv() && each_name_once(undeclared, undeclared)
      && names_csv(empty) == native_names_csv() && each_name_once(empty, empty)
      && names_csv(both) == native_names_csv() && each_name_once(both, both)
  }

pure func test_wrapped_native_tool_keeps_the_native_schema() -> bool
  tests [((), true)]
  {
    let both = tools_with_extensions(rt_of([undeclared_wrapper(), empty_catalog_wrapper()]));
    let declared = tools_with_extensions(rt_of([{ id: "decl#0", config: jo([]), caps: [DescribeTools(declared_write_file), ToolProvider(["WriteFile"], wrapper_handle)] }]));
    let native = write_file_schema();
    description_of(both, "WriteFile") == native.description && parameters_of(both, "WriteFile") == native.parameters
      && names_csv(declared) == native_names_csv()
      && description_of(declared, "WriteFile") == native.description && parameters_of(declared, "WriteFile") == native.parameters
  }

pure func test_two_extensions_one_name_keeps_the_earlier_entry() -> bool
  tests [((), true)]
  {
    let first: ExtEntry = { id: "first#0", config: jo([]), caps: [DescribeTools(shared_first)] };
    let second: ExtEntry = { id: "second#1", config: jo([]), caps: [DescribeTools(shared_second)] };
    let forward = tools_with_extensions(rt_of([first, second]));
    let backward = tools_with_extensions(rt_of([second, first]));
    names_csv(forward) == "${native_names_csv()},Shared,OnlyFirst,OnlySecond" && description_of(forward, "Shared") == "first"
      && names_csv(backward) == "${native_names_csv()},Shared,OnlySecond,OnlyFirst" && description_of(backward, "Shared") == "second"
  }
