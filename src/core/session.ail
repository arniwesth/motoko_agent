-- Convert Motoko's UI/profile model identifier to the provider API model id
-- expected by upstream stepWithStream(). The --ai flag already selected the
-- handler/provider; the model argument passed to step is forwarded to the
-- upstream API body.
--
-- Important: OpenRouter's API model ids are themselves vendor/model strings
-- such as "anthropic/claude-sonnet-4-6" and "openai/gpt-4o". Strip the
-- explicit Motoko/OpenRouter routing prefix only for pinned vendor/model ids;
-- keep "openrouter/auto" intact because AILANG/OpenRouter use it as the
-- routing-policy model.
--
-- Direct provider prefixes are Motoko routing syntax and are stripped before
-- the provider request. AILANG itself treats vendor/model strings such as
-- "openai/..." and "anthropic/..." as OpenRouter, so the TS launcher also
-- strips those prefixes for --ai provider selection.
pure func provider_api_model(model: string, openai_base_url: string) -> string {
  if model == "openrouter/auto" then
    model
  else if startsWith(model, "openrouter/") then
    let prefix_len = Str.length("openrouter/") in
    let total = Str.length(model) in
    substring(model, prefix_len, total)
  else if startsWith(model, "openai/") then
    let prefix_len = Str.length("openai/") in
    let total = Str.length(model) in
    substring(model, prefix_len, total)
  else if startsWith(model, "anthropic/") then
    let prefix_len = Str.length("anthropic/") in
    let total = Str.length(model) in
    substring(model, prefix_len, total)
  else if startsWith(model, "google/") then
    let prefix_len = Str.length("google/") in
    let total = Str.length(model) in
    substring(model, prefix_len, total)
  else
    model
}

-- emit a JSON line to stdout for the TS env-server to forward to the TUI.
-- Same protocol as src/core/ai_compat (M-AI-CALL-STREAM-HELPER side).
func emit_json(payload: Json) -> () ! {IO} {
  println(encode(payload))
}

pure func trace_event_enabled(event_type: string) -> bool {
  event_type == "session_start" || event_type == "run_summary"
}

pure func trace_sensitive_key(key: string) -> bool {
  key == "task"
    || key == "text"
    || key == "text_delta"
    || key == "output"
    || key == "content"
    || key == "cmd"
    || key == "feedback"
    || key == "errors"
    || key == "message"
}

pure func trace_string_value(s: string) -> Json {
  if Str.length(s) > 256 then
    js("${substring(s, 0, 256)}...[truncated]")
  else
    js(s)
}

pure func trace_value_for_key(key: string, value: Json) -> Json {
  if trace_sensitive_key(key) then js("[redacted]")
  else match value {
    JString(s) => trace_string_value(s),
    JArray(_) => js("[array]"),
    JObject(_) => js("[object]"),
    _ => value
  }
}

pure func trace_extra_kvs(extra: [{key: string, value: Json}]) -> [{key: string, value: Json}] {
  match extra {
    [] => [],
    item :: rest => kv(item.key, trace_value_for_key(item.key, item.value)) :: trace_extra_kvs(rest)
  }
}

func emit_trace_event(session_id: string, event_type: string, extra: [{key: string, value: Json}]) -> () ! {Trace} {
  if trace_event_enabled(event_type) then
    Trace.event(event_type, encode(jo([
      kv("schema_version", js(schema_version())),
      kv("session_id",     js(session_id)),
      kv("type",           js(event_type))
    ] ++ trace_extra_kvs(extra))))
  else
    ()
}

-- M-MOTOKO-EVAL-INSTRUMENTATION (schema v1):
-- The session JSONL is the single structured-output surface for downstream
-- consumers (TUI replay, AILANG eval-harness adapter, post-run analysis).
-- Schema v1 = additive metadata on every event (schema_version + session_id)
-- + per-step token/cost telemetry + a terminal `run_summary` event with
-- cumulative totals. Documented at:
--   design_docs/planned/m-motoko-eval-instrumentation.md
-- Bumping this string is a breaking change for downstream parsers.
pure func schema_version() -> string { "1" }

-- Build-time constant injected by `make build` (Makefile sets -ldflags or
-- equivalent). Falls back to "dev" for local-source runs. Surfaced in
-- session_start + run_summary so the AILANG eval harness can correlate
-- benchmark results with the exact motoko commit that produced them
-- (mitigates "self-referential masking" — see eval-instrumentation design
-- doc Risk #4).
pure func motoko_commit() -> string { "dev" }

-- Convert millicents (integer arithmetic, used internally by the cost
-- tracker) to USD float. 100000 millicents = $1.00.
pure func millicents_to_usd(mc: int) -> float {
  _int_to_float(mc) / 100000.0
}

pure func event_type_from_projected(kvs: [{key: string, value: Json}]) -> string {
  match kvs {
    [] => "",
    x :: _ =>
      if x.key == "type" then
        match x.value {
          JString(s) => s,
          _ => ""
        }
      else ""
  }
}

pure func event_extra_from_projected(kvs: [{key: string, value: Json}]) -> [{key: string, value: Json}] {
  match kvs {
    [] => [],
    _ :: rest => rest
  }
}

func ledger_emit(session_id: string, e: LedgerEvent) -> () ! {IO, Trace} {
  let projected = to_schema_v1_kvs(e);
  let event_type = event_type_from_projected(projected);
  emit_json(jo([
    kv("schema_version", js(schema_version())),
    kv("session_id",     js(session_id))
  ] ++ projected));
  emit_trace_event(session_id, event_type, event_extra_from_projected(projected))
}

func emit_pre_step_stages(session_id: string, step_idx: int, stages: [PreStepStage]) -> () ! {IO, Trace} {
  match stages {
    [] => (),
    s :: rest => {
      let _ = match s.outcome {
        StageApplied(note) => ledger_emit(session_id, CompactionApplied({
          step: step_idx,
          note: note
        })),
        StageRejected(reason) => ledger_emit(session_id, ExtCompactionRejected({
          step: step_idx,
          note: reason
        })),
        StageObserved(code, fields) => ledger_emit(session_id, ExtensionDiagnostic({
          step: step_idx,
          extension: s.ext_id,
          code: code,
          fields: fields
        })),
        StagePassed => ()
      };
      emit_pre_step_stages(session_id, step_idx, rest)
    }
  }
}

-- Cumulative token/cost totals threaded through loop_v2 recursion. Bundled
-- into a single record (vs 6 extra params) so adding new totals later (e.g.
-- reasoning tokens) doesn't require touching every call site again.
type RuntimeLoopTotals = {
  input_tokens: int,
  output_tokens: int,
  cache_read: int,
  cache_creation: int,
  cost_millicents: int,
  cost_warned_pct: int
}

type C2LoopState = {
  msgs: [Message],
  step_idx: int,
  totals: RuntimeLoopTotals,
  ext_artifacts: Json,
  telemetry: { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int },
  provider: Ports,
  -- D1's `world_state`: ONE explicit field, threaded by the driver, the sole
  -- home for every effect cursor in the run. Not a closure captured inside the
  -- Ports value, not a provider ADT payload, and never re-derived from message
  -- history. WI-A12 landed this by renaming WI-A2's interim `provider_state`
  -- field, which is how D1's "subsumed and deleted in the same change" reads in
  -- practice: there is no moment where two homes exist.
  --
  -- Every subsequent effect class A12 threads — the clock, approval, env reads,
  -- runtime randomness, the typed tool contract — adds a field to WorldState
  -- and consumes it through a port. None of them adds a field HERE.
  world_state: WorldState,
  pending_tool_calls: [ToolCall],
  pending_tool_context: [Message],
  pending_tool_prefix: [Message],
  pending_tool_batched: bool,
  accumulated_tool_msgs: [Message],
  pending_approval: Option[ApprovalRequest],
  last_finish_reason: string,
  last_response_text: string,
  nudges_used: int,
  finalize_source: string,
  prior_counts: RuntimeStatusCounts,
  trace: LedgerTrace
}

type RuntimeStatusCounts = {
  provider_calls_started: int,
  provider_calls_completed: int,
  stage_applied_total: int,
  stage_rejected_total: int,
  compaction_ai_applied: int
}

pure func zero_totals() -> RuntimeLoopTotals {
  { input_tokens: 0, output_tokens: 0, cache_read: 0, cache_creation: 0, cost_millicents: 0, cost_warned_pct: 0 }
}

pure func zero_runtime_status_counts() -> RuntimeStatusCounts {
  {
    provider_calls_started: 0,
    provider_calls_completed: 0,
    stage_applied_total: 0,
    stage_rejected_total: 0,
    compaction_ai_applied: 0
  }
}

pure func runtime_status_counts_rec(records: [LedgerRecord], counts: RuntimeStatusCounts) -> RuntimeStatusCounts {
  match records {
    [] => counts,
    r :: rest => {
      let next = match r {
        WireRecord(event) => match event {
          ProviderCallPrepared(_) => {
            provider_calls_started: counts.provider_calls_started + 1,
            provider_calls_completed: counts.provider_calls_completed,
            stage_applied_total: counts.stage_applied_total,
            stage_rejected_total: counts.stage_rejected_total,
            compaction_ai_applied: counts.compaction_ai_applied
          },
          ProviderResult(_) => {
            provider_calls_started: counts.provider_calls_started,
            provider_calls_completed: counts.provider_calls_completed + 1,
            stage_applied_total: counts.stage_applied_total,
            stage_rejected_total: counts.stage_rejected_total,
            compaction_ai_applied: counts.compaction_ai_applied
          },
          _ => counts
        },
        CompactionStageRecord(stage) => match stage.outcome {
          TraceStageApplied(_) => {
            provider_calls_started: counts.provider_calls_started,
            provider_calls_completed: counts.provider_calls_completed,
            stage_applied_total: counts.stage_applied_total + 1,
            stage_rejected_total: counts.stage_rejected_total,
            compaction_ai_applied: counts.compaction_ai_applied + (if is_compaction_ai_ext_id(stage.ext_id) then 1 else 0)
          },
          TraceStageRejected(_) => {
            provider_calls_started: counts.provider_calls_started,
            provider_calls_completed: counts.provider_calls_completed,
            stage_applied_total: counts.stage_applied_total,
            stage_rejected_total: counts.stage_rejected_total + 1,
            compaction_ai_applied: counts.compaction_ai_applied
          },
          TraceStageObserved(_, _) => counts,
          _ => counts
        },
        _ => counts
      };
      runtime_status_counts_rec(rest, next)
    }
  }
}

pure func is_compaction_ai_ext_id(ext_id: string) -> bool {
  ext_id == "compaction_ai" || startsWith(ext_id, "compaction_ai#")
}

pure func runtime_status_counts(trace: LedgerTrace) -> RuntimeStatusCounts {
  runtime_status_counts_rec(trace.records, zero_runtime_status_counts())
}

pure func runtime_status_counts_add(a: RuntimeStatusCounts, b: RuntimeStatusCounts) -> RuntimeStatusCounts {
  {
    provider_calls_started: a.provider_calls_started + b.provider_calls_started,
    provider_calls_completed: a.provider_calls_completed + b.provider_calls_completed,
    stage_applied_total: a.stage_applied_total + b.stage_applied_total,
    stage_rejected_total: a.stage_rejected_total + b.stage_rejected_total,
    compaction_ai_applied: a.compaction_ai_applied + b.compaction_ai_applied
  }
}

pure func runtime_status_json(
  st: C2LoopState,
  policy: SessionPolicy,
  tool_step_idx: int
) -> Json {
  let counts = runtime_status_counts_add(st.prior_counts, runtime_status_counts(st.trace));
  let context_msgs = c2_pending_context(st);
  let split = split_for_compaction(context_msgs);
  let pinned = split.pinned;
  let limit = policy.step.compaction.context_limit;
  let actual_input_tokens = st.telemetry.last_input_tokens;
  let actual_pct = if limit == 0 then 0 else (actual_input_tokens * 100) / limit;
  let estimated_input_tokens = estimate_tokens_messages(context_msgs);
  let estimated_pct = usage_percent_with_limit(context_msgs, limit);
  let calibrated_input_tokens = calibrated_tokens_messages(context_msgs, st.telemetry);
  let calibrated_pct = calibrated_usage_percent(context_msgs, limit, st.telemetry);
  jo([
    kv("tool", js("MotokoRuntimeStatus")),
    kv("current_step", jnum(_int_to_float(tool_step_idx))),
    kv("provider_calls_started", jnum(_int_to_float(counts.provider_calls_started))),
    kv("provider_calls_completed", jnum(_int_to_float(counts.provider_calls_completed))),
    kv("steps_executed_so_far", jnum(_int_to_float(counts.provider_calls_completed))),
    kv("step_budget", jnum(_int_to_float(policy.step.step_budget))),
    kv("finish_reason_so_far", js(st.last_finish_reason)),
    kv("compaction", jo([
      kv("stage_applied_total", jnum(_int_to_float(counts.stage_applied_total))),
      kv("stage_rejected_total", jnum(_int_to_float(counts.stage_rejected_total))),
      kv("compaction_ai_applied", jnum(_int_to_float(counts.compaction_ai_applied)))
    ])),
    kv("system_prefix", jo([
      kv("count", jnum(_int_to_float(count_system_prefix(pinned)))),
      kv("chars", jnum(_int_to_float(system_prefix_chars(pinned)))),
      kv("digest", js(system_prefix_digest_for(pinned)))
    ])),
    kv("context_window", jo([
      kv("context_limit", jnum(_int_to_float(limit))),
      kv("last_sent", jo([
        kv("input_tokens", jnum(_int_to_float(actual_input_tokens))),
        kv("usage_pct", jnum(_int_to_float(actual_pct)))
      ])),
      kv("uncompacted_pending", jo([
        kv("estimated_tokens", jnum(_int_to_float(estimated_input_tokens))),
        kv("estimated_pct", jnum(_int_to_float(estimated_pct))),
        kv("calibrated_tokens", jnum(_int_to_float(calibrated_input_tokens))),
        kv("calibrated_pct", jnum(_int_to_float(calibrated_pct)))
      ])),
      kv("note", js("last_sent = real provider tokens of the previous compacted request; uncompacted_pending = the full retained history before this step's ephemeral compaction. They measure different windows by design."))
    ])),
    kv("usage", jo([
      kv("input_tokens", jnum(_int_to_float(st.totals.input_tokens))),
      kv("output_tokens", jnum(_int_to_float(st.totals.output_tokens))),
      kv("cache_read_input_tokens", jnum(_int_to_float(st.totals.cache_read))),
      kv("cache_creation_input_tokens", jnum(_int_to_float(st.totals.cache_creation))),
      kv("total_cost_millicents", jnum(_int_to_float(st.totals.cost_millicents)))
    ]))
  ])
}

pure func runtime_status_tool_message(call: ToolCall, content: string) -> Option[Message] {
  if call.name == "MotokoRuntimeStatus" then Some({
    role: "tool",
    content: content,
    tool_calls: [],
    tool_call_id: call.id
  }) else None
}

pure func c2_decision_name(d: StepDecision) -> string {
  match d {
    CallModel(_) => "CallModel",
    RunTools(_) => "RunTools",
    AwaitApproval(_) => "AwaitApproval",
    InjectUserMessage(_) => "InjectUserMessage",
    TakeCheckpoint(_) => "TakeCheckpoint",
    Finalize(_) => "Finalize",
    Fail(_) => "Fail"
  }
}

pure func c2_append_decision(trace: LedgerTrace, step_idx: int, decision: StepDecision) -> LedgerTrace {
  ledger_append(trace, DecisionRecord({ step: step_idx, decision: c2_decision_name(decision) }))
}

pure func c2_trace_stage_records(trace: LedgerTrace, step_idx: int, stages: [PreStepStage]) -> LedgerTrace {
  match stages {
    [] => trace,
    s :: rest => c2_trace_stage_records(ledger_append(trace, stage_record(step_idx, s)), step_idx, rest)
  }
}

pure func c2_trace_wire_events(trace: LedgerTrace, events: [LedgerEvent]) -> LedgerTrace {
  match events {
    [] => trace,
    e :: rest => c2_trace_wire_events(ledger_append(trace, WireRecord(e)), rest)
  }
}

func c2_emit_events(session_id: string, events: [LedgerEvent]) -> () ! {IO, Trace} {
  match events {
    [] => (),
    e :: rest => {
      let _ = ledger_emit(session_id, e);
      c2_emit_events(session_id, rest)
    }
  }
}

pure func c2_tool_plan_calls(entries: [ToolPlanEntry]) -> [ToolCall] {
  match entries {
    [] => [],
    e :: rest => e.call :: c2_tool_plan_calls(rest)
  }
}

pure func c2_step_totals(totals: RuntimeLoopTotals) -> {
  input_tokens: int,
  output_tokens: int,
  cost_millicents: int,
  cost_warned_pct: int
} {
  {
    input_tokens: totals.input_tokens,
    output_tokens: totals.output_tokens,
    cost_millicents: totals.cost_millicents,
    cost_warned_pct: totals.cost_warned_pct
  }
}

func c2_step_state(st: C2LoopState) -> Result[StepState, string] {
  match history_from_seed(st.msgs) {
    Err(e) => Err(e),
    Ok(h) => Ok({
      step_idx: st.step_idx,
      history: h,
      telemetry: st.telemetry,
      totals: c2_step_totals(st.totals),
      nudges_used: st.nudges_used,
      ext_artifacts: st.ext_artifacts,
      pending_tool_calls: st.pending_tool_calls,
      last_finish_reason: st.last_finish_reason,
      last_response_text: st.last_response_text
    })
  }
}

func c2_initial_state_with_counts(history: [Message], provider: PortedProvider, prior_counts: RuntimeStatusCounts) -> C2LoopState {
  {
    msgs: history,
    step_idx: 0,
    totals: zero_totals(),
    ext_artifacts: jo([]),
    telemetry: { last_input_tokens: 0, last_output_tokens: 0, last_estimated_input_tokens: 0 },
    provider: provider.ports,
    world_state: provider.world,
    pending_tool_calls: [],
    pending_tool_context: [],
    pending_tool_prefix: [],
    pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
    last_finish_reason: "",
    last_response_text: "",
    nudges_used: count_persist_nudges(history),
    finalize_source: "",
    prior_counts: prior_counts,
    trace: empty_ledger_trace()
  }
}

func c2_initial_state(history: [Message], provider: PortedProvider) -> C2LoopState {
  c2_initial_state_with_counts(history, provider, zero_runtime_status_counts())
}

-- Serialize the exact [Message] payload a provider rejected, so a
-- non-retryable ProtocolError (e.g. hy3:free/Novita "invalid request error")
-- can be inspected/replayed offline. Off by default; enabled by setting
-- MOTOKO_CAPTURE_FAILED_PAYLOAD (writes .motoko/failing_payload.json). Useful
-- for diagnosing the intermittent Novita rejections during hy3:free runs.
func dbg_toolcall_json(c: ToolCall) -> Json {
  jo([kv("id", js(c.id)), kv("name", js(c.name)), kv("arguments", js(c.arguments))])
}

func dbg_toolcalls_json(cs: [ToolCall]) -> [Json] {
  match cs { [] => [], c :: rest => dbg_toolcall_json(c) :: dbg_toolcalls_json(rest) }
}

func dbg_message_json(m: Message) -> Json {
  jo([
    kv("role", js(m.role)),
    kv("content", js(m.content)),
    kv("tool_calls", ja(dbg_toolcalls_json(m.tool_calls))),
    kv("tool_call_id", js(m.tool_call_id))
  ])
}

func dbg_messages_json(msgs: [Message]) -> [Json] {
  match msgs { [] => [], m :: rest => dbg_message_json(m) :: dbg_messages_json(rest) }
}

func capture_failing_payload(e: AIError, msgs: [Message]) -> () ! {FS} {
  let payload = encode(jo([
    kv("error_code", js(e.code)),
    kv("error_message", js(e.message)),
    kv("retryable", jb(e.retryable)),
    kv("messages", ja(dbg_messages_json(msgs)))
  ]));
  match writeFileResult(".motoko/failing_payload.json", payload) { Ok(_) => (), Err(_) => () }
}

func ext_ai_step(p: Ports, model: string, base_url: string, msgs: [Msg]) -> Result[string, string] ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream} {
  let on_chunk = func(_chunk: StreamChunk) -> () ! {IO} { () };
  -- Resolve the provider API model the same way the main step loop does
  -- (dispatch_step calls provider_api_model at src/core/session.ail:1695).
  -- Extensions (e.g. compaction_ai) pass their configured model verbatim,
  -- which for OpenRouter still carries the "openrouter/" routing prefix; sent
  -- raw the provider rejects it with 400 "not a valid model ID", surfacing as
  -- compaction_ai.summarizer_failed / provider_error. Strip it here.
  -- Both the emission log and the successor cursor are dropped here, and that
  -- is an ABI limit rather than an oversight: ExtPorts.ai_step returns
  -- Result[string, string] (packages/motoko-ext-abi/types.ail:63) and the hook
  -- results above it are decision-only, so a successor has no way back to
  -- C2LoopState. Threading the driver's live cursor in and discarding the
  -- successor would recreate F6; capturing it in this closure would create the
  -- second home D1 prohibits. So the extension model path is EXCLUDED rather
  -- than hand-waved: it is handed a fresh empty state, and WI-A2 is a partial
  -- cursor fix that says so. Any conformant interim profile must exclude every
  -- hook registered by an extension that calls this. Widening ExtPorts.ai_step
  -- belongs to the ABI major the repin forces (ADR-001 D1, Milestone B).
  match p.model_step(empty_world_state(), provider_api_model(model, base_url), msgs_to_messages(msgs), on_chunk).result {
    Ok(result) => Ok(result.message.content),
    Err(e) => Err("${e.code}: ${e.message}")
  }
}

func ext_ports_of(p: Ports, base_url: string) -> ExtPorts ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream} {
  let ai_step = func(model: string, msgs: [Msg]) -> Result[string, string] ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream} {
    ext_ai_step(p, model, base_url, msgs)
  };
  {
    ai_step: ai_step,
    proc_exec: p.tool_exec,
    clock_now: p.clock_now,
    env_get: p.env_get
  }
}



pure func ext_token_telemetry(t: { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int }) -> TokenTelemetry {
  { last_input_tokens: t.last_input_tokens, last_output_tokens: t.last_output_tokens, last_estimated_input_tokens: t.last_estimated_input_tokens }
}

-- Normalise the caller-supplied StepProvider into the Ports seam, once, before
-- the loop starts. This is the completion of WI-C13c ("Wire model dispatch
-- through ports"): that commit introduced the normalisation but left
-- StepProvider in C2LoopState, so `dispatch_step` and `ext_ports_for_provider`
-- kept LiveAI/Scripted branches that no entry point could reach. Returning
-- Ports makes the invariant structural instead of conventional.
--
-- StepProvider remains the *entry-point argument* type — callers still pass
-- LiveAI or Scripted(script); it just does not survive into loop state.
--
-- WI-A2: it now returns the initial world alongside the Ports. The script rides
-- in that world rather than being baked into a closure, which is what lets the
-- driver own the cursor.
--
-- WI-A12 deleted the `history` parameter. It existed solely to compute the
-- `base_assistant_count` that A2 retired — the derived index that WAS the F6
-- defect — and A2 kept it only because D1 holds this seam stable until
-- `world_state` replaces it. This is that replacement, so the parameter goes
-- with it (cluster 1, C5). Six call sites, all of which were passing a message
-- list nothing read.
func ported_provider(rt: ExtRuntime, provider: StepProvider) -> PortedProvider {
  match provider {
    Ported(p) => { ports: p, world: empty_world_state() },
    LiveAI => { ports: live_ports(rt), world: empty_world_state() },
    Scripted(script) => { ports: scripted_ports(), world: scripted_world_state(script) }
  }
}

pure func c2_add_step_totals(totals: RuntimeLoopTotals, result: StepResult, step_cost: int, warned_pct: int) -> RuntimeLoopTotals {
  {
    input_tokens: totals.input_tokens + result.input_tokens,
    output_tokens: totals.output_tokens + result.output_tokens,
    cache_read: totals.cache_read + result.cache_read_input_tokens,
    cache_creation: totals.cache_creation + result.cache_creation_input_tokens,
    cost_millicents: totals.cost_millicents + step_cost,
    cost_warned_pct: warned_pct
  }
}

func c2_emit_cost_warning(
  session_id: string,
  step_idx: int,
  total_cost_millicents: int,
  max_cost_millicents: int,
  already_warned_pct: int
) -> int ! {IO, Trace} {
  if max_cost_millicents > 0 then {
    let pct = (total_cost_millicents * 100) / max_cost_millicents;
    if pct >= 90 && already_warned_pct < 90 then {
      let _ = ledger_emit(session_id, CostWarning({ threshold: "90pct", step: step_idx, pct: pct, total_cost_millicents: total_cost_millicents, total_cost_usd: millicents_to_usd(total_cost_millicents), cap_millicents: max_cost_millicents }));
      90
    } else if pct >= 75 && already_warned_pct < 75 then {
      let _ = ledger_emit(session_id, CostWarning({ threshold: "75pct", step: step_idx, pct: pct, total_cost_millicents: total_cost_millicents, total_cost_usd: millicents_to_usd(total_cost_millicents), cap_millicents: max_cost_millicents }));
      75
    } else if pct >= 50 && already_warned_pct < 50 then {
      let _ = ledger_emit(session_id, CostWarning({ threshold: "50pct", step: step_idx, pct: pct, total_cost_millicents: total_cost_millicents, total_cost_usd: millicents_to_usd(total_cost_millicents), cap_millicents: max_cost_millicents }));
      50
    } else already_warned_pct
  } else already_warned_pct
}

pure func c2_done_step(step_idx: int) -> int {
  if step_idx <= 0 then 0 else step_idx - 1
}

-- append_stream_delta: dispatch one StreamChunk variant to the ledger.
-- protocol.
--
-- ContentDelta(text) → thinking_delta event (TUI appends to per-stream_id
--                       buffer in arrival order; this is the assistant's
--                       visible content as it streams).
-- ThinkingDelta(text) → reasoning_delta event (NEW v0.18.8; AILANG-side
--                       API-level thinking from claude-opus-4.5+,
--                       OpenAI o1/o3, Gemini 2.5+ thinking models). TUI
--                       renders in a separate panel; never mixed with
--                       content stream.
-- Usage(_)            → dropped here (final usage telemetry comes from
--                       the StepResult.{input,output,cache}_*_input_tokens
--                       fields after the call returns).
--
-- Tag-convention reasoning (glm-5, deepseek-r1: <thinking>...</thinking>
-- inside ContentDelta) is NOT split here — that belongs in the TUI's
-- streaming-render path which already strips think-tag bodies for live
-- render via stripThinkBlocksForLive().
--
-- Extracted from agent_loop_v2 because match inside lambda hits a known
-- AILANG parser bug.
func append_stream_delta(session_id: string, step_idx: int, stream_id: string, chunk: StreamChunk) -> () ! {IO, Trace} {
  match chunk {
    ContentDelta(text) =>
      ledger_emit(session_id, StreamDelta({
        step: step_idx,
        stream_id: stream_id,
        seq: 0,
        kind: "thinking",
        text: text
      })),
    ThinkingDelta(text) =>
      ledger_emit(session_id, StreamDelta({
        step: step_idx,
        stream_id: stream_id,
        seq: 0,
        kind: "reasoning",
        text: text
      })),
    Usage(_) => ()
  }
}

-- Derive a session_id from MOTOKO_SESSION_ID env var (set by the TS wrapper
-- to match the JSONL filename) or fall back to a now()-derived id. The
-- wrapper-set form is preferred so the JSONL session_id matches the
-- filename consumers grep for.
func derive_session_id() -> string ! {Env, Clock} {
  let env_id = getEnvOr("MOTOKO_SESSION_ID", "");
  if env_id != "" then env_id
  else "session_${show(now())}"
}

-- Build the standard kv-list emitted on every per-step event that has
-- StepResult tokens in scope. `cost_step_mc` is the per-step millicents
-- (computed from result.input_tokens/output_tokens × cost_rates).
--
-- Cache token fields (cache_read_input_tokens / cache_creation_input_tokens)
-- are emitted ONLY when non-zero — omit-when-absent semantics so consumers
-- can distinguish "provider doesn't surface caching" from "this turn had
-- zero cache hits". Anthropic populates both; OpenAI + Gemini populate
-- cache_read only; other providers omit both.
func per_step_usage_kvs(result: StepResult, cost_step_mc: int) -> [{key: string, value: Json}] {
  let base = [
    kv("input_tokens",  jnum(_int_to_float(result.input_tokens))),
    kv("output_tokens", jnum(_int_to_float(result.output_tokens))),
    kv("cost_usd",      jnum(millicents_to_usd(cost_step_mc)))
  ];
  let with_read = if result.cache_read_input_tokens > 0 then
    base ++ [kv("cache_read_input_tokens", jnum(_int_to_float(result.cache_read_input_tokens)))]
    else base;
  if result.cache_creation_input_tokens > 0 then
    with_read ++ [kv("cache_creation_input_tokens", jnum(_int_to_float(result.cache_creation_input_tokens)))]
    else with_read
}

-- finish_reason_str(r: int) lived here. It is gone: D6.2 requires a typed
-- termination reason derived from the reachable terminal returns, and the wire
-- mapping now lives beside RunSummaryInfo as phase_vocab.finish_reason_wire.
-- No integer termination code survives at any terminal call site.

-- Build the schema-v1 run_summary event. Split out from the finalizer so the
-- record that is projected and the record that is appended are provably the
-- same value, not two constructions that could drift.
pure func mk_run_summary(
  model: string,
  totals: RuntimeLoopTotals,
  steps_executed: int,
  reason: TerminationReason,
  error_msg: string,
  duration_ms: int,
  commit: string
) -> LedgerEvent {
  RunSummary({
    model: model,
    motoko_commit: commit,
    finish_reason: finish_reason_wire(reason),
    steps_executed: steps_executed,
    input_tokens: totals.input_tokens,
    output_tokens: totals.output_tokens,
    cache_read_input_tokens: totals.cache_read,
    cache_creation_input_tokens: totals.cache_creation,
    total_cost_usd: millicents_to_usd(totals.cost_millicents),
    total_cost_millicents: totals.cost_millicents,
    duration_ms: duration_ms,
    error: error_msg
  })
}

-- THE finalizer (D6.1). Every terminal return in the driver goes through here.
--
-- It does both halves of the contract in one place: it emits the run_summary
-- projection (what downstream eval harnesses consume) AND appends the same
-- record to the returned LedgerTrace (what the invariant oracle consumes).
-- Before this, only the projection existed — emit_run_summary's sole ledger
-- operation was ledger_emit, so the returned trace contained no RunSummary on
-- any path, and the returned trace is what D6 makes authoritative.
--
-- Centralizing it is the point: a new terminal path cannot update one channel
-- and silently miss the other, because there is only one channel to call.
-- The RunSummary is appended last, so it is the final record of the trace.
func c2_finalize(
  session_id: string,
  model: string,
  totals: RuntimeLoopTotals,
  steps_executed: int,
  reason: TerminationReason,
  error_msg: string,
  started_at_ms: int,
  trace: LedgerTrace,
  result: Result[[Message], AIError]
) -> TracedSessionResult ! {IO, Clock, Trace} {
  let now_ms = now();
  let summary = mk_run_summary(model, totals, steps_executed, reason, error_msg, now_ms - started_at_ms, motoko_commit());
  let _ = ledger_emit(session_id, summary);
  { result: result, trace: ledger_append(trace, WireRecord(summary)) }
}

