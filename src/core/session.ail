-- Build the per-turn ExtCtx that motoko's extension hooks receive. Mirrors
-- mk_ext_ctx in rpc.ail but constructs from v2's typed-loop state instead
-- of the legacy AgentState shape. history_slice converts upstream Message
-- to motoko's Msg (text-only) since extensions inspect text not tool_calls.
func mk_v2_ext_ctx(
  task: string,
  step_idx: int,
  model: string,
  cwd: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  history: [Message],
  context_limit: int,
  -- ABI 7.2. The PROVIDER's reason, "" where this context does not follow a
  -- provider result -- see `ExtCtx.finish_reason`. Passed rather than read off
  -- `st.last_finish_reason`, which by then also carries the driver's own
  -- pseudo-reasons.
  finish_reason: string,
  -- ABI 7.3. The host's aggregate of every `WorkInFlight` declaration, or []
  -- where none has been gathered — see the call sites.
  work_in_flight: [WorkItem],
  -- ABI 7.4 (PLAN-002 W2 Part 1). `wait_descriptors_json` of the loop's
  -- `open_waits` at the call site; no hook reads it until W4.
  open_waits: Json,
  ports: ExtPorts,
  artifacts: Json,
  telemetry: { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int },
  -- WI-B2b. The driver's CURRENT world, tokenised. Every caller passes
  -- `world_to_token(st.world_state)` — the live cursor, not a fresh one — which
  -- is what makes the hook's successor meaningful when it comes back.
  world: ExtWorld
) -> ExtCtx {
  let remaining = if budget.total - step_idx < 0 then 0 else budget.total - step_idx;
  {
    task: task,
    step: step_idx,
    model: model,
    cwd: cwd,
    hybrid_tools: hybrid_tools,
    budget: budget,
    mode: "v2",
    workdir: cwd,
    env_server_url: env_url,
    budget_remaining: remaining,
    history_slice: messages_to_msgs(history),
    state_key: "core:ext:v2",
    finish_reason: finish_reason,
    work_in_flight: work_in_flight,
    open_waits: open_waits,
    context_limit: context_limit,
    ports: ports,
    artifacts: artifacts,
    telemetry: ext_token_telemetry(telemetry), world: world
  }
}

-- Convert upstream [Message] to motoko's [Msg] for ExtCtx.history_slice
-- and on_pre_step. Since motoko_ext_abi 2.1.0 (M-ABI-MSG-WIRE-PARITY),
-- Msg carries tool_calls + tool_call_id, so copy them verbatim. The
-- compaction round-trip is now lossless: any extension that returns
-- Compacted([Msg]) preserves wire-format correlation IDs.
func messages_to_msgs(msgs: [Message]) -> [Msg] {
  match msgs {
    [] => [],
    m :: rest => ({
      role: m.role,
      content: m.content,
      tool_calls: m.tool_calls,
      tool_call_id: m.tool_call_id
    } :: messages_to_msgs(rest))
  }
}

func count_system_prefix(msgs: [Message]) -> int {
  match msgs {
    [] => 0,
    m :: rest => if m.role == "system" then 1 + count_system_prefix(rest) else 0
  }
}

-- TUI wire-format helpers (M-MOTOKO-RPC-LOOP M10 follow-up): the legacy
-- TUI renderer (src/tui/src/ui.ts) expects BATCHED native_tool_calls /
-- native_tool_results events with `request_id` and `tool_calls` /
-- `results` array fields, not the per-call events v2 originally emitted.
-- These helpers convert v2's typed [ToolCall] and tool-role [Message]
-- into the array shape the TUI renders. See loop_v2 for the emit calls.

func tool_calls_to_envelope_jsons(calls: [ToolCall]) -> [Json] {
  match calls {
    [] => [],
    c :: rest => call_to_json(tool_call_to_envelope(c)) :: tool_calls_to_envelope_jsons(rest)
  }
}

-- Helper: pull a string field from a decoded JSON object with a fallback.
func json_field_str(obj: Json, key: string, fallback: string) -> string {
  match get(obj, key) {
    None    => fallback,
    Some(j) => match asString(j) { None => fallback, Some(s) => s }
  }
}

-- Helper: detect whether a JSON object has a boolean field set to true.
-- Used to detect policy_denied_message / delegated_deferred_message
-- payloads (both flag themselves with `error: true`).
func json_field_bool_true(obj: Json, key: string) -> bool {
  match get(obj, key) {
    None    => false,
    Some(j) => match j {
      JBool(true) => true,
      _           => false
    }
  }
}

-- Each tool-role Message produced by dispatch_calls has a JSON-encoded
-- payload in its content (either dispatch_one's tool_result_item JSON,
-- a policy_denied_message JSON, or a delegated_deferred_message JSON).
-- The TUI's applyNativeToolResults reads `tool_call_id`, `exit_code`,
-- `stdout`, `stderr`, `truncated` from each result entry — so we
-- normalise to that shape, lifting tool_call_id from the Message and
-- forwarding the inner payload's known fields with safe defaults.
func tool_messages_to_result_jsons(msgs: [Message]) -> [Json] {
  match msgs {
    [] => [],
    m :: rest => {
      let inner = match decode(m.content) {
        Ok(j) => j,
        Err(_) => jo([])
      };
      let stdout_str = json_field_str(inner, "stdout", "");
      let stderr_str = json_field_str(inner, "stderr", "");
      -- If the payload flags itself as an error (policy_denied_message
      -- or delegated_deferred_message both set `error: true`), drive
      -- the TUI's "failed" rendering by emitting exit_code: 1; otherwise
      -- treat as success (exit_code: 0). dispatch_one's payloads always
      -- include exit_code on the wire but parsing JSON numbers from
      -- typed Json values requires a different accessor than we use here;
      -- the boolean error gate is a simpler proxy that gets the TUI
      -- coloring right for the v2-emitted shapes.
      let is_error = json_field_bool_true(inner, "error");
      let normalized = jo([
        kv("tool_call_id", js(m.tool_call_id)),
        kv("exit_code", jnum(if is_error then 1.0 else 0.0)),
        kv("stdout", js(stdout_str)),
        kv("stderr", js(stderr_str)),
        kv("truncated", jb(false)),
        kv("payload", inner)
      ]);
      normalized :: tool_messages_to_result_jsons(rest)
    }
  }
}

-- M7: Synthesize a BashExec ToolCall from a hybrid-mode shell command
-- extracted from the assistant's prose. The model emitted no typed
-- tool_calls (finish_reason != "tool_calls") but its content contained
-- a fenced shell block (```bash / ```sh / ```shell / ```), so we treat
-- that block as the canonical hybrid shorthand and pass it through the
-- M3-M6 dispatch pipeline as if it were a typed BashExec call.
--
-- This preserves the full M4 policy gate + M5 tool-handle routing + M6
-- backend split for hybrid commands (e.g. an extension can still Deny
-- a hybrid `rm -rf /` just as it would deny a typed call). The
-- synthetic call uses a "hybrid-step-N" id so it doesn't collide with
-- model-emitted tool_call_ids on the wire.
func synthesize_hybrid_bash_call(cmd: string, step_idx: int) -> ToolCall {
  {
    id: "hybrid-step-${show(step_idx)}",
    name: "BashExec",
    arguments: encode(jo([kv("cmd", js(cmd))]))
  }
}

-- ---------------------------------------------------------------------------
-- ONCE A SESSION HAS EMITTED A NATIVE TOOL CALL, ITS PROSE IS PROSE
-- ---------------------------------------------------------------------------
--
-- Hybrid extraction exists for models that CANNOT emit typed tool calls: with
-- `tools.hybrid` on, any response carrying no native call is scanned for a
-- fenced shell block and the first one is run. A model that has just emitted
-- several hundred typed calls and then writes prose is not using shorthand.
--
-- MEASURED, in the PLAN-001 live run (2026-09-05). The user asked "how do we use
-- the herdr extension to actually start the tasks?", the model answered in prose
-- with copy-paste ```bash examples, and the runtime ran the first fence of each
-- answer: three stray panes, then `herdr agent start d6-worker --kind motoko
-- --pane w3:pX` with the PLACEHOLDER pane id straight out of the example text.
-- The model then reported that failure in its next answer as a finding, and by
-- the fourth answer had rewritten its examples with a `text:` prefix to stop the
-- harness executing them — a model routing around its own runtime.
-- (`.agent/issues/hybrid-bash-extracts-prose-examples-in-native-tool-mode.md`,
-- option 1, which that file calls the smallest of the three.)
--
-- THE SIGNAL IS THE TRANSCRIPT, NOT A NEW STATE FIELD. "Has this session ever
-- emitted a native call" is already written down: an assistant message carrying
-- `tool_calls` (`phase_vocab.step_result_to_message` copies them through). A
-- `C2LoopState` field would be a second home for a fact the history already
-- holds, and D1's rule about re-deriving state from message history cuts the
-- other way here — this is not an effect cursor, it is a property OF the
-- transcript being read off the transcript.
--
-- COMPACTION DEGRADES THIS TO TODAY'S BEHAVIOUR, not to a wrong answer: if the
-- assistant turns carrying tool_calls are folded away, extraction switches back
-- on. That is the safe direction and it is why the read is cheap enough to do
-- per step rather than latched.
--
-- THE `hybrid-step-` FILTER IS LOAD-BEARING AND IS THE WHOLE REASON THIS IS NOT
-- A ONE-LINE `m.tool_calls != []`. The hybrid branch below builds its own
-- assistant message carrying the SYNTHESISED call, and that message enters
-- `msgs` through `pending_tool_prefix`. Counting it would mean one hybrid
-- extraction disables hybrid extraction for the rest of the run — a latch that
-- looks like this fix working and is the opposite of it. The id prefix is
-- `synthesize_hybrid_bash_call`'s, which exists so the synthetic call cannot
-- collide with a model-emitted id on the wire; `any_native_call` is its second
-- reader.
--
-- ADR-001 §4. Recursive over a list, so a synthesised `ensures { true }` cannot
-- be encoded at all rather than failing to prove. The property worth stating —
-- `exists c in calls. not is_hybrid(c.id)` — is exactly the shape the fragment
-- rejects.
-- contracts: BLOCKED — RECURSIVE; a synthesised `ensures { true }` fails to
-- encode rather than failing to prove.
pure func any_native_call(calls: [ToolCall]) -> bool {
  match calls {
    [] => false,
    c :: rest => if startsWith(c.id, "hybrid-step-") then any_native_call(rest) else true
  }
}

-- contracts: BLOCKED — RECURSIVE; see `any_native_call`.
pure func session_emitted_native_tool_call(msgs: [Message]) -> bool {
  match msgs {
    [] => false,
    m :: rest =>
      if m.role == "assistant" && any_native_call(m.tool_calls) then true
      else session_emitted_native_tool_call(rest)
  }
}

-- THE DETERMINISTIC PIN the issue asks for, at the gate rather than through the
-- loop: "a v2 session whose step N emitted a native call and whose step N+1 is
-- prose with a ```bash fence must produce no `hybrid_bash_extracted` event".
--
-- The first conjunct is what stops this passing for the wrong reason. The prose
-- fixture is the live-run shape — placeholder pane id and all — and
-- `extract_bash` DOES extract from it, so the case is closed by the gate and not
-- by the fence having quietly stopped matching.
--
-- The last conjunct is the one that fails against the naive implementation: a
-- session whose only tool call is the SYNTHESISED hybrid one must still have
-- extraction available.
-- contracts: SKIPPED — calls `extract_bash` and builds `Message` records, neither
-- of which the SMT fragment can encode.
pure func test_hybrid_extraction_stops_after_a_native_tool_call() -> bool
  tests [((), true)]
  {
    let prose_text = "Start it like this:\n\n```bash\nherdr agent start d6-worker --kind motoko --pane w3:pX\n```\n\nThat is the shape.";
    let native: Message = { role: "assistant", content: "", tool_calls: [{ id: "call_abc", name: "WriteFile", arguments: "{}" }], tool_call_id: "", images: [] };
    let synthetic: Message = { role: "assistant", content: "prose", tool_calls: [synthesize_hybrid_bash_call("ls", 4)], tool_call_id: "", images: [] };
    let prose: Message = { role: "assistant", content: prose_text, tool_calls: [], tool_call_id: "", images: [] };
    (match extract_bash(prose_text) { Some(_) => true, None => false })
      && session_emitted_native_tool_call([native, prose])
      && session_emitted_native_tool_call([prose]) == false
      && session_emitted_native_tool_call([synthetic, prose]) == false
  }

-- Build a structured tool-role Message indicating the ohmy_pi delegation
-- pathway is not yet wired in v2. M6 plumbs split_by_backend through but
-- defers the inbox-based wait_for_tool_results to a follow-up — for now
-- delegated calls return this clear, recoverable error so the model can
-- adapt (e.g. retry with a non-delegated argument shape, or surface that
-- ohmy_pi was selected but unavailable).
-- Build a denial tool-role Message for a ToolCall the policy gate rejected.
-- The model sees a structured `{denied_by_policy, reason, tool}` JSON in the
-- tool result, correlated by tool_call_id, so it can correct course on the
-- next turn without ambiguity.
func policy_denied_message(call: ToolCall, reason: string) -> Message {
  let denial_payload = encode(jo([
    kv("error", jb(true)),
    kv("denied_by_policy", jb(true)),
    kv("tool", js(call.name)),
    kv("reason", js(reason))
  ]));
  {
    role: "tool",
    content: denial_payload,
    tool_calls: [],
    tool_call_id: call.id,
    images: []
  }
}

-- Compute per-step cost in millicents from token counts and provider rates.
-- Integer division truncates toward zero (conservative — never over-counts).
-- Returns 0 when rates are zero (unmetered/unknown provider).
pure func step_cost_millicents(input_tokens: int, output_tokens: int, rates: CostRates) -> int {
  (input_tokens * rates.input_per_1m_millicents +
   output_tokens * rates.output_per_1m_millicents) / 1000000
}

-- The v2 loop. Iterates until the model returns finish_reason != "tool_calls"
-- (and any solver-candidate hooks accept the result) or step_budget hits zero.
-- Returns the final messages list.
--
-- DP0 (pre-step compaction): before each LLM call, extension compactors
-- transform the provider payload, with the structural compactor registered
-- last. Core refuses only if the post-chain payload remains critically full.
--
-- M3 wiring: between step() and tool dispatch, fires extension hooks at the
-- two existing decision points motoko's rpc_loop uses (DP1 from the design
-- doc). NoIntercept / NoDecision are no-ops; the typed-step protocol means
-- prose-only responses unambiguously stop the loop (no continuation-intent
-- heuristic needed).

-- DP7: pre-finalize AILANG type-check gate.
-- Runs make check_core in the project workdir before any done emission.
-- Fail-open: if check infrastructure is missing (no workdir, no Makefile, or
-- no check_core target), returns Approve so projects without DP7 setup are not
-- blocked. Only genuine type errors (exit non-zero with substantive output)
-- produce Reject.
type FinalizeVerification
  = Approve
  | Reject(string)

-- Detect "infrastructure missing" — the verification command failed because the
-- project lacks a Makefile/target or the workdir doesn't exist, NOT because the
-- code under verification has type errors. These cases must fail-open.
pure func is_missing_infrastructure(output: string) -> bool {
  let lower = toLower(output);
  contains(lower, "no rule to make target")
    || contains(lower, "no targets specified and no makefile found")
    || contains(lower, "no makefile found")
    || contains(lower, "make: *** no")
    || contains(lower, "no such file or directory")
    || contains(lower, "command not found")
}

func run_dp7_verifier(rt: ExtRuntime, workdir: string) -> FinalizeVerification ! {Process} {
  if not rt.verification.enabled then Approve
  else
    match exec("bash", ["-c", "cd \"$1\" && ${rt.verification.command} 2>&1", "_dp7", workdir]) {
      Err(_) => Approve,
      Ok(out) => {
        if out.exitCode == 0 then Approve
        else {
          let output = toString(out.stdout);
          if is_missing_infrastructure(output) then Approve
          else Reject(output)
        }
      }
    }
}

func dp7_gate(rt: ExtRuntime, workdir: string, step_idx: int, session_id: string) -> Option[Message] ! {Process, IO, Trace} {
  match run_dp7_verifier(rt, workdir) {
    Approve => None,
    Reject(errors) => {
      let _ = ledger_emit(session_id, Dp7VerifierRejected({
        step: step_idx,
        errors: errors
      }));
      Some({
        role: "user",
        content: "The code you just wrote does not type-check. Fix all errors before declaring done:\n\n${errors}",
        tool_calls: [],
        tool_call_id: "",
        images: []
      })
    }
  }
}

-- WI-D2 WIDENED THE RETURN, and it is the same move `ToolDispatchOutcome` took
-- one file over: this returned the rejection text and dropped the event it had
-- just projected, so `Dp7VerifierRejected` reached the wire and nothing else.
-- The caller has the trace; giving it the event is what lets the driver stay the
-- sole appender.
--
-- The re-injection path is NOT terminal — the run continues and terminates later
-- via max-steps or the budget — so D6.1's ordering constraint does not bind this
-- append, unlike `CostExhausted` above.
export type Dp7Rejection = { errors: string, event: LedgerEvent }

func dp7_rejection_errors(rt: ExtRuntime, workdir: string, step_idx: int, session_id: string) -> Option[Dp7Rejection] ! {Process, IO, Trace} {
  match run_dp7_verifier(rt, workdir) {
    Approve => None,
    Reject(errors) => {
      let event = Dp7VerifierRejected({
        step: step_idx,
        errors: errors
      });
      let _ = ledger_emit(session_id, event);
      Some({ errors: errors, event: event })
    }
  }
}

-- M-MOTOKO-PERSIST-NUDGE: bounded loop-persistence at the NoDecision boundary.
-- Root cause (2026-06-18 A/B transcripts): on local models the agent often
-- DISENGAGES after 0–1 tool calls WITHOUT writing a solution — either answering
-- in prose (0 tool calls) or making one inspect call (e.g. `cat solution.ail`)
-- and stopping. The loop then finalizes at NoDecision. These helpers let the loop
-- inject a bounded nudge to keep going instead. Off by default (MOTOKO_PERSIST_
-- RETRIES=0); opt-in for A/B so the rotation is unchanged until validated.

-- Marker embedded in injected nudges so we can count them from history alone
-- (no new loop_v2 state to thread through its 16 recursive call sites).
func persist_nudge_marker() -> string { "[motoko-persist-nudge]" }

-- How many persistence nudges are allowed this run (MOTOKO_PERSIST_RETRIES,
-- default 0 = feature off).
pure func parse_persist_retries_budget(raw: string) -> int {
  match _stringToInt(trim(raw)) {
    Some(n) => if n > 0 then n else 0,
    None => 0
  }
}

-- WI-A12's env class. Four of the driver's env reads are here, and they are
-- threaded rather than ambient.
--
-- The count this comment used to carry — "four of the driver's SEVEN" — was true
-- from WI-A12 until WI-D3, which routed `context_usage`'s four keys through the
-- same port and took the driver's key set from seven to ELEVEN. The authoritative
-- list is `dst_discovery.driver_env_keys()`, which `make discovery` re-derives
-- from the call sites rather than trusting; a second count restated here is the
-- stale-literal class this project has now carried five items running, so this
-- one names the derivation instead of repeating its answer.
--
-- WI-A13 stage 2 CHANGED THE RETURN. A12 discarded the successor at the end,
-- reasoning that policy init happens once and `scripted_env` returns the world
-- unchanged, and it noted that each read still takes the previous read's
-- successor "so that when A13 starts recording reads the order is already
-- right and nothing has to be re-threaded". The ordering was right; the DISCARD
-- was not. Once a read appends to the world's interaction log the successor is
-- no longer the same world, and dropping it dropped all four reads — a quarter
-- of the driver's env surface, silently, on a path the recorder had no way to
-- report. The completeness assertion is what found it; nothing else could,
-- because the log was internally consistent and perfectly reproducible without
-- them.
--
-- The successor is therefore returned and threaded by every caller. Behaviour
-- is unchanged for every non-recording world, where `scripted_env` and
-- `live_ports`' env closure both return their input.
export type SessionPolicyInit = { policy: SessionPolicy, next_state: WorldState }

func session_policy_init(ports: Ports, world: WorldState, model: string, step_budget: int, max_cost_millicents: int, cost_rates: CostRates) -> SessionPolicyInit ! {Env, FS} {
  let budget_steps = if step_budget <= 0 then 8 else step_budget;
  let r_persist = ports.env_get(world, "MOTOKO_PERSIST_RETRIES", "0");
  let r_retry = ports.env_get(advance(r_persist.next_state, EnvRead), "MOTOKO_RETRY_STREAM_ERROR", "1");
  let r_base = ports.env_get(advance(r_retry.next_state, EnvRead), "OPENAI_BASE_URL", "");
  let r_headless = ports.env_get(advance(r_base.next_state, EnvRead), "MOTOKO_HEADLESS", "");
  -- WI-D3's filesystem class. The fifth request this function makes, threaded
  -- from the fourth's successor exactly like the four env reads above and for
  -- the same reason A13 stage 2 gave: once a read appends to the world's log,
  -- discarding the successor drops every read it carried.
  let r_limit = resolve_context_limit_sum(context_reader_of(ports), advance(r_headless.next_state, EnvRead), model);
  let persist_retries = parse_persist_retries_budget(r_persist.value);
  let retry_stream_errors = r_retry.value != "0";
  let provider_base_url = r_base.value;
  let headless = r_headless.value == "1";
  {
    policy: {
      step: {
        step_budget: budget_steps,
        max_cost_millicents: max_cost_millicents,
        cost_metered: cost_rates.input_per_1m_millicents > 0,
        persist_retries: persist_retries,
        retry_stream_errors: retry_stream_errors,
        require_system_prompt: not headless,
        model: model,
        provider_base_url: provider_base_url,
        checkpoint_enabled: false,
        checkpoint_pct: 90,
        compaction: {
          context_limit: r_limit.limit,
          elide_tier_pct: 70,
          elide_hard_tier_pct: 85,
          emergency_pct: exhaustion_pct()
        }
      },
      headless: headless
    },
    next_state: r_limit.next_state
  }
}

-- WI-D3 gave it the reader and the world, and it returns the successor for the
-- same reason `session_policy_init` does. It is no longer `pure func`: it
-- performs requests through the ports rather than reading ambiently, and the
-- successor it hands back is what its one caller is free to drop — see there.
func session_policy_with_model(ports: Ports, world: WorldState, policy: SessionPolicy, model: string) -> SessionPolicyInit ! {Env, FS} {
  let r_limit = resolve_context_limit_sum(context_reader_of(ports), world, model);
  {
    policy: {
    step: {
      step_budget: policy.step.step_budget,
      max_cost_millicents: policy.step.max_cost_millicents,
      cost_metered: policy.step.cost_metered,
      persist_retries: policy.step.persist_retries,
      retry_stream_errors: policy.step.retry_stream_errors,
      require_system_prompt: policy.step.require_system_prompt,
      model: model,
      provider_base_url: policy.step.provider_base_url,
      checkpoint_enabled: policy.step.checkpoint_enabled,
      checkpoint_pct: policy.step.checkpoint_pct,
      compaction: {
        context_limit: r_limit.limit,
        elide_tier_pct: policy.step.compaction.elide_tier_pct,
        elide_hard_tier_pct: policy.step.compaction.elide_hard_tier_pct,
        emergency_pct: policy.step.compaction.emergency_pct
      }
    },
    headless: policy.headless
    },
    next_state: r_limit.next_state
  }
}

-- Count nudges already injected (user messages carrying the marker) so we never
-- exceed the budget — the count IS the persistence state, read from history.
func count_persist_nudges(msgs: [Message]) -> int {
  match msgs {
    [] => 0,
    m :: rest => {
      let here = if m.role == "user" && contains(m.content, persist_nudge_marker()) then 1 else 0;
      here + count_persist_nudges(rest)
    }
  }
}

func tool_calls_have_writefile(calls: [ToolCall]) -> bool {
  match calls {
    [] => false,
    c :: rest => if c.name == "WriteFile" then true else tool_calls_have_writefile(rest)
  }
}

-- True once the model has attempted ANY WriteFile this run — if so it is engaged
-- with producing a solution, so we let it finalize/fail on its own (don't nudge).
-- Both disengagement modes (0 calls / 1 inspect call) have zero WriteFile, so
-- this gates the nudge precisely to the premature-stop case.
func any_writefile_attempt(msgs: [Message]) -> bool {
  match msgs {
    [] => false,
    m :: rest =>
      if tool_calls_have_writefile(m.tool_calls) then true
      else any_writefile_attempt(rest)
  }
}

-- Map a Fail decision's AIError code onto the typed termination reason.
-- The four codes `decide` can produce are StepBudgetExhausted, BudgetExceeded,
-- ContextExhausted and Internal (src/core/step_machine.ail:101,103,107,58).
--
-- ADR-003 D2 item 1 made max steps a code. It used to be a MESSAGE match:
-- step_machine emitted `Internal` for both the step budget and the
-- approval-without-pending-call failure, so the only thing separating them
-- downstream was the text, held once as a shared catalogue constant
-- (`max_steps_discriminator_message()`, now deleted). That removed the
-- desynchronisation risk but not the misclassification one — a third
-- `Internal` failure carrying the same message read as max steps. The
-- discrimination is by code now, and the message is not load-bearing.
pure func decision_fail_reason(code: string) -> TerminationReason {
  if code == "StepBudgetExhausted" then TermMaxSteps
  else if code == "BudgetExceeded" then TermBudgetExhausted
  else if code == "ContextExhausted" then TermCompactionExhausted
  else TermInternalFailure
}

-- ADR-003 v6.1 D4's comparand, derived from the loop state ONCE so that all
-- seven terminal arms agree on what "what the run ended holding" means.
--
-- `cumulative` is `prior_counts + counts(st.trace)`, which is the SAME
-- expression `runtime_status_json` computes for the model's judging number
-- (`:539` before this commit) and the same one the ADR writes for `c2_suspend`.
-- Two derivations of a cumulative count is how a resumed run and the tool that
-- reports its progress end up disagreeing about how many steps happened.
--
-- It reads `st.trace` and NOT the trace the arm is about to append to. That is
-- deliberate and it costs nothing: `runtime_status_count_one` counts only
-- `ProviderCallPrepared`, `ProviderResult` and compaction stage records, and no
-- terminal arm appends one of those between `st.trace` and its `c2_finalize`
-- call — the records they add are the decision, the terminal event and the
-- RunSummary. Reading `st` alone keeps this a projection of the STATE, which is
-- what a resumed run is rebuilt from.
pure func c2_final_state(st: C2LoopState) -> FinalState {
  {
    history: st.msgs,
    cumulative: runtime_status_counts_add(st.prior_counts, runtime_status_counts(st.trace)),
    telemetry: ext_token_telemetry(st.telemetry),
    ext_artifacts: st.ext_artifacts
  }
}

-- ADR-003 v6.1 D1's `Continuation`, built from the live loop state. Everything
-- it carries is `st`'s except `model`, which is the loop's parameter, and
-- `profile`, which is the run's identity — neither lives in `C2LoopState`.
--
-- `boot` is the loop's own entry arguments, and `step_budget` comes from
-- `policy.step.step_budget` rather than from `budget`: they are different
-- numbers that `default_budget_plan` happens to seed from the same profile
-- setting (`rpc.ail:88–94`), and a resume that took the ABI's token budget for
-- the step ceiling would resume with the wrong one.
pure func c2_continuation(
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  identity: RunIdentity,
  st: C2LoopState
) -> Continuation {
  let boot: BootInputs = {
    task: task,
    env_url: env_url,
    hybrid_tools: hybrid_tools,
    budget: budget,
    step_budget: policy.step.step_budget,
    ohmy_pi: ohmy_pi,
    max_cost_millicents: max_cost_millicents,
    cost_rates: cost_rates
  };
  {
    history: st.msgs,
    step_idx: st.step_idx,
    cumulative: runtime_status_counts_add(st.prior_counts, runtime_status_counts(st.trace)),
    telemetry: ext_token_telemetry(st.telemetry),
    ext_artifacts: st.ext_artifacts,
    nudges_used: st.nudges_used,
    model: model,
    profile: identity.profile,
    boot: boot
  }
}

-- ============================================================================
-- ADR-003 v6.1 D6, the in-process resume's CONSTRUCTOR half.
-- ============================================================================

-- The RESET half of D6's rule as ONE pure value, and the reason it is factored
-- out rather than written inline in the constructor below: `C2LoopState` holds
-- a `Ports` and a `WorldState`, so `c2_state_from_continuation` cannot be
-- called from a `pure` test at all, and P1 Part 1 pinned its rule over a
-- PROJECTION instead (`c2_state_from_continuation_shape`, at the tests below).
-- A projection that re-states the reset values as its own literals pins
-- nothing. Both the constructor and that projection read THIS record, so the
-- two cannot drift apart.
type C2ResumeReset = {
  step_idx: int,
  totals: RuntimeLoopTotals,
  pending_tool_calls: [ToolCall],
  pending_tool_context: [Message],
  pending_tool_prefix: [Message],
  pending_tool_batched: bool,
  accumulated_tool_msgs: [Message],
  pending_approval: Option[ApprovalRequest],
  last_finish_reason: string,
  last_response_text: string,
  finalize_source: string,
  trace: LedgerTrace,
  emissions: [LedgerEvent],
  -- PLAN-002 W4 Part 2 (review change 18): D3's "run ends (… suspend) →
  -- cleared" row, read by `c2_state_from_continuation` from HERE so the shape
  -- projection below pins it.
  open_waits: [WaitDescriptor],
  park_ordinal: int,
  park_attempt: int
}

pure func c2_resume_reset() -> C2ResumeReset {
  {
    step_idx: 0,
    totals: zero_totals(),
    pending_tool_calls: [],
    pending_tool_context: [],
    pending_tool_prefix: [],
    pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
    last_finish_reason: "",
    last_response_text: "",
    finalize_source: "",
    trace: empty_ledger_trace(),
    emissions: [],
    open_waits: [],
    park_ordinal: initial_park_ordinal(false),
    park_attempt: 0
  }
}

-- `ext_token_telemetry`'s inverse. The two records carry the same three fields
-- and the conversion is written out rather than assumed, so a field added to
-- `TokenTelemetry` fails to compile here instead of silently not crossing back
-- into a resumed run.
pure func loop_token_telemetry(t: TokenTelemetry) -> { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int } {
  { last_input_tokens: t.last_input_tokens, last_output_tokens: t.last_output_tokens, last_estimated_input_tokens: t.last_estimated_input_tokens }
}

-- D6's constructor: the `C2LoopState` a suspended run's `Continuation` is
-- rebuilt into, and the SECOND constructor of that type — the only one beside
-- `c2_initial_state_with_counts`.
--
-- IT SITS BESIDE `c2_continuation`, ITS INVERSE, rather than beside the other
-- constructor. These two are the pair that has to agree: everything
-- `c2_continuation` carries OUT of a run is something this function has to put
-- BACK, and a field dropped from one is only visible when they are read
-- together.
--
-- THE RULE, and it splits in two.
--
--   CARRIED, because a resumed run is the same conversation: `history` — which
--   is the whole of the repair, since today's path recurses with the PRE-TURN
--   history and the exhausted turn's messages die on the floor; `cumulative`
--   as the new run's `prior_counts`, so the judging number keeps counting
--   across the boundary; `telemetry` and `ext_artifacts`; and `nudges_used`,
--   which is NOT re-derived from the history the way
--   `c2_initial_state_with_counts` re-derives it (`count_persist_nudges`): a
--   nudge the previous run spent is spent, and re-deriving it from a history a
--   compaction stage may have rewritten would silently refund it.
--
--   RESET, because a resumed run is its own run: `step_idx` (the step budget
--   is per run — that is what the suspension was about), `totals`
--   (`RuntimeLoopTotals` is per-run by construction, and carrying it would
--   turn the per-turn cost cap into a cumulative one), every pending-tool
--   field (a suspension happens at the TOP of a step, where they are all
--   empty), `trace` and `emissions` (a resumed run's frame is its own; P3's
--   journal is what makes the earlier one durable).
--
-- `world` IS A PARAMETER for exactly the reason `c2_initial_state_with_counts`
-- takes one: the traced entry performs two clock reads BEFORE the loop begins
-- and both successors must reach it, so taking `provider.world` here would
-- type-check and silently start the resumed loop on an un-advanced clock.
-- PLAN-003 writes this signature as `(c, provider)`; the third argument is the
-- one its sibling already has, for the same reason, and it is reported as
-- drift rather than left implicit.
pure func c2_state_from_continuation(c: Continuation, provider: PortedProvider, world: WorldState) -> C2LoopState {
  let reset = c2_resume_reset();
  {
    msgs: c.history,
    step_idx: reset.step_idx,
    totals: reset.totals,
    ext_artifacts: c.ext_artifacts,
    telemetry: loop_token_telemetry(c.telemetry),
    provider: provider.ports,
    world_state: world,
    pending_tool_calls: reset.pending_tool_calls,
    pending_tool_context: reset.pending_tool_context,
    pending_tool_prefix: reset.pending_tool_prefix,
    pending_tool_batched: reset.pending_tool_batched,
    accumulated_tool_msgs: reset.accumulated_tool_msgs,
    pending_approval: reset.pending_approval,
    last_finish_reason: reset.last_finish_reason,
    last_response_text: reset.last_response_text,
    nudges_used: c.nudges_used,
    finalize_source: reset.finalize_source,
    prior_counts: c.cumulative,
    trace: reset.trace,
    emissions: reset.emissions,
    -- CARRIED IN SPIRIT AND RE-DERIVED IN FACT, which is the one place this
    -- constructor cannot be its inverse's mirror: `Continuation` has no chain
    -- field (ADR-003 D1 gives it none) so the resumed run re-bases its chain on
    -- the history it was handed. That is exact for every session whose journal
    -- holds no `history_replaced`, and it is the same limitation the traced
    -- entry's seed has; both are stated at the conversation loop's emit site,
    -- with the shape of the fix and who owns it.
    history_digest: c2_seed_digest(c.history),
    -- RESET, and not for want of a field: D3's "run ends → cleared" row.
    -- `Continuation` carries no waits, and a resumed run is its own run.
    -- PLAN-002 W4 Part 2 (review change 18): the delegate keeps running and
    -- the resumed run's model is NOT told. A stated limit, not a gap closed
    -- here; ADR-003 D7's `park` entry is what carries waits across a durable
    -- park. The park counters reset with the waits.
    open_waits: reset.open_waits,
    park_ordinal: reset.park_ordinal,
    park_attempt: reset.park_attempt
  }
}

func c2_fail(
  ports: Ports,
  world: WorldState,
  session_id: string,
  model: string,
  totals: RuntimeLoopTotals,
  step_idx: int,
  max_cost_millicents: int,
  started_at_ms: int,
  code: string,
  message: string,
  retryable: bool,
  trace: LedgerTrace,
  emissions: [LedgerEvent],
  final: FinalState
) -> TracedSessionResult ! {IO, Clock, Trace} {
  let cost_event = CostExhausted({
    step: step_idx,
    total_cost_millicents: totals.cost_millicents,
    total_cost_usd: millicents_to_usd(totals.cost_millicents),
    cap_millicents: max_cost_millicents
  });
  let _ = if code == "BudgetExceeded" then ledger_emit(session_id, cost_event) else ();
  -- WI-D2, AND IT IS `DoneEvent`'S EXACT PRECEDENT (WI-A14). This is a terminal
  -- path, so the append must land BEFORE `c2_finalize` writes the RunSummary or
  -- D6.1's "the summary is the FINAL record" breaks — which is also row 7's
  -- first conjunct, and `terminal_summary_findings`' `after_summary` half is
  -- what says so. Appending after the finalizer type-checks and reddens
  -- `record-after-terminal` on every capped run.
  --
  -- The wire is untouched: `cost_exhausted` still precedes `run_summary` there,
  -- exactly as it did, so no compatibility surface moves (D8).
  let trace_with_cost =
    if code == "BudgetExceeded" then ledger_append(trace, WireRecord(cost_event))
    else trace;
  let result: Result[[Message], AIError] = Err({ code: code, message: message, retryable: retryable });
  c2_finalize(ports, world, session_id, model, totals, step_idx, decision_fail_reason(code), message, started_at_ms, trace_with_cost, emissions, result, final)
}

-- ADR-003 v6.1 D2 items 2–4. THE SUSPENSION, and it is `c2_fail`'s sibling
-- rather than a branch inside it: the two paths differ in what they RETURN, not
-- in how they finalise, and a flag inside `c2_fail` would have put the
-- continuation's construction behind a boolean that six other codes also pass
-- through.
--
-- WHAT IT DOES, in the order the ADR states it:
--   1. builds the `Continuation` from `st` — every field is in scope here
--      because the `Fail` arm is lexically inside `c2_loop`, which owns `st`
--      (`REVIEW-adr003-verdicts-fable.md` §3 checked this);
--   2. GATES it on `continuation_history_ok`, D4 rule 3's two conditions
--      asserted at the point of production;
--   3. appends AND emits `RunSuspended` — appended before `c2_finalize` writes
--      the RunSummary, which is `DoneEvent`'s and `CostExhausted`'s precedent
--      and what keeps D6.1's "the summary is the final record" true;
--   4. finalises with `TermMaxSteps` and `result: Err`, so `RunSummary.error`
--      is non-empty and `outcome_agreement_findings` holds unchanged;
--   5. sets `suspended: Some(c)` and projects `final` from the SAME `c`.
--
-- THE GATE FAILS CLOSED, to `c2_fail`. `c2_step_state` only checks
-- `history_from_seed`; `continuation_history_ok` also requires
-- `history_valid_transcript`, so a history this loop was willing to step on can
-- still be one no resume should be offered. A run whose history cannot be
-- resumed is not a suspension — it is the internal failure it was before
-- ADR-003, and it says so on the wire.
--
-- NO PENDING TOOL CALLS CAN BE LOST HERE: `decide` handles `pending_tool_calls`
-- before anything else (`step_machine.ail:114–121`) and only reaches the budget
-- check on the finish-reason arms (`:93–94`), so the suspension always happens
-- at the TOP of a step with every pending field empty. That is why
-- `Continuation` has none of them.
--
-- The effect row is `c2_fail`'s, not the loop's: this function appends, emits
-- and finalises, and does none of the loop's work.
func c2_suspend(
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  session_id: string,
  identity: RunIdentity,
  started_at_ms: int,
  info: FailInfo,
  st: C2LoopState,
  trace: LedgerTrace
) -> TracedSessionResult ! {IO, Clock, Trace} {
  let cont = c2_continuation(task, env_url, hybrid_tools, budget, policy, model, ohmy_pi, max_cost_millicents, cost_rates, identity, st);
  if not continuation_history_ok(cont) then
    c2_fail(st.provider, st.world_state, session_id, model, st.totals, st.step_idx, max_cost_millicents, started_at_ms, info.code, info.message, info.retryable, trace, st.emissions, c2_final_state(st))
  else {
    let event = RunSuspended({
      session_id: identity.session_id,
      run_id: identity.run_id,
      reason: "budget_exhausted",
      step: st.step_idx
    });
    let _ = ledger_emit(session_id, event);
    let result: Result[[Message], AIError] = Err({ code: info.code, message: info.message, retryable: info.retryable });
    let finalized = c2_finalize(st.provider, st.world_state, session_id, model, st.totals, st.step_idx, TermMaxSteps, info.message, started_at_ms, ledger_append(trace, WireRecord(event)), st.emissions, result, final_of_continuation(cont));
    -- The ONE record update on a finalized result in this file, and it is why
    -- `c2_finalize` writes `suspended: None` unconditionally: the structural
    -- guard behind `make terminal_trace` counts terminal record LITERALS, and
    -- there is still exactly one.
    { finalized | suspended: Some(cont) }
  }
}

pure func c2_pending_context(st: C2LoopState) -> [Message] {
  if List.length(st.pending_tool_context) > 0 then st.pending_tool_context else st.msgs
}

pure func c2_pending_prefix(st: C2LoopState) -> [Message] {
  if List.length(st.pending_tool_prefix) > 0 then st.pending_tool_prefix else st.msgs
}

-- The last message of a list, as a list, so a caller can concatenate it without
-- an `Option` unwrap. `foldl` and not recursion, per the file's rule; the
-- history it is handed is unbounded.
pure func c2_last_step(_acc: [Message], m: Message) -> [Message] { [m] }

pure func last_msg(xs: [Message]) -> [Message] { List.foldl(c2_last_step, [], xs) }

func c2_finish_tool_batch(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  session_id: string,
  identity: RunIdentity,
  started_at_ms: int,
  st: C2LoopState,
  trace: LedgerTrace,
  tool_step_idx: int,
  stream_id: string,
  tool_msgs: [Message]
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let request_id = "step-${show(tool_step_idx)}";
  let results_event = NativeToolResults({
    request_id: request_id,
    step: tool_step_idx,
    stream_id: stream_id,
    payload: ja(tool_messages_to_result_jsons(tool_msgs))
  });
  let _ = if st.pending_tool_batched then ledger_emit(session_id, results_event) else ();
  -- WI-D2, and the condition is shared with the emission for the reason the
  -- announcement site gives.
  let trace_with_results =
    if st.pending_tool_batched then ledger_append(trace, WireRecord(results_event))
    else trace;
  -- ADR-003 D2's `:2251`: ONE `HistoryAppended` PER TOOL RESULT, and on the
  -- hybrid path one more in front of them. `c2_pending_prefix(st)` is `st.msgs`
  -- on the batched path and `st.msgs ++ [augmented_assistant]` on the hybrid one
  -- (set at the extraction site), so `entering` is the messages this site adds
  -- to the history and nothing else — never `next_msgs`, which would re-journal
  -- the whole conversation every batch.
  --
  -- `replaces_previous` IS EXACTLY `not st.pending_tool_batched`, which is the
  -- same discriminator the results announcement above uses. On that path the
  -- first entry's augmented assistant supersedes the plain one the extraction
  -- step journaled, and it chains from the digest BEFORE it — D4's "what makes
  -- the replacement unfakeable": a fold that appended instead breaks the chain
  -- at that entry and nowhere else.
  let prefix = c2_pending_prefix(st);
  let next_msgs = prefix ++ tool_msgs;
  let hybrid_replacement = not st.pending_tool_batched;
  let entering = if hybrid_replacement then last_msg(prefix) ++ tool_msgs else tool_msgs;
  let appended = c2_history_appended(identity.run_id, tool_step_idx, st.history_digest, hybrid_replacement, entering);
  let trace_with_history = c2_journal(session_id, trace_with_results, appended.events);
  let next_state: C2LoopState = {
    msgs: next_msgs,
	    step_idx: st.step_idx,
	    totals: st.totals,
	    ext_artifacts: st.ext_artifacts,
	    telemetry: st.telemetry,
	    provider: st.provider,
	    world_state: st.world_state,
    pending_tool_calls: [],
    pending_tool_context: [],
    pending_tool_prefix: [],
    pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
    last_finish_reason: "tools_complete",
    last_response_text: "",
    nudges_used: st.nudges_used,
    finalize_source: "",
    prior_counts: st.prior_counts,
    trace: trace_with_history,
    emissions: st.emissions,
    history_digest: appended.digest,
    open_waits: st.open_waits,
    park_ordinal: st.park_ordinal,
    park_attempt: st.park_attempt
  };
  c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
}

func c2_continue_tool_batch(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  session_id: string,
  identity: RunIdentity,
  started_at_ms: int,
  st: C2LoopState,
  trace: LedgerTrace,
  req: ApprovalRequest,
  accumulated: [Message]
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  match req.remaining {
    [] => c2_finish_tool_batch(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, st, trace, c2_done_step(st.step_idx), req.stream_id, accumulated),
    _ => {
      let next_state: C2LoopState = {
        msgs: st.msgs,
	        step_idx: st.step_idx,
	        totals: st.totals,
	        ext_artifacts: st.ext_artifacts,
	        telemetry: st.telemetry,
	        provider: st.provider,
	        world_state: st.world_state,
        pending_tool_calls: c2_tool_plan_calls(req.remaining),
        pending_tool_context: st.pending_tool_context,
        pending_tool_prefix: st.pending_tool_prefix,
        pending_tool_batched: st.pending_tool_batched,
        accumulated_tool_msgs: accumulated,
        pending_approval: None,
        last_finish_reason: "approval_resolved",
        last_response_text: "",
        nudges_used: st.nudges_used,
        finalize_source: "",
        prior_counts: st.prior_counts,
        trace: trace,
        emissions: st.emissions,
        -- ADR-003 D2: this site carries `st.msgs` UNCHANGED and therefore emits
        -- nothing. The digest is carried for the same reason the messages are.
        history_digest: st.history_digest,
        open_waits: st.open_waits,
        park_ordinal: st.park_ordinal,
        park_attempt: st.park_attempt
      };
      c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
    }
  }
}

-- PLAN-002 W2 Part 4: `c2_after_dp7`, SPLIT. It was the verifier call and the
-- two states it chose between; the verifier call now lives in
-- `classify_candidate` (stage 2 for a non-blank candidate, stage 5 for a blank
-- one) and these are the two states, shared by both stages. Content is the old
-- arms' byte for byte: the same journal events in the same order, the same
-- `nudges_used` recount, and the old call sites' `st.provider`,
-- `st.prior_counts` and `st.history_digest`, which is why they take `st`
-- rather than those fields one by one.
--
-- ADR-003 D2's `:2356`/`:2381` still hold here: ONE `HistoryAppended` for the
-- one message (the assistant) that entered the history on this path, and
-- `artifacts_changed` computed at the call site, where both artifact values are
-- in scope.
func c2_dp7_rejected_state(
  session_id: string,
  identity: RunIdentity,
  st: C2LoopState,
  msgs_with_assistant: [Message],
  totals: RuntimeLoopTotals,
  ext_artifacts: Json,
  telemetry: { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int },
  world: WorldState,
  trace: LedgerTrace,
  emissions: [LedgerEvent],
  artifacts_changed: bool,
  step_idx: int,
  rejection: Dp7Rejection
) -> C2LoopState ! {IO, Trace} {
  let appended = c2_history_appended(identity.run_id, step_idx, st.history_digest, false, last_msg(msgs_with_assistant));
  let trace_with_history = c2_journal(session_id, ledger_append(trace, WireRecord(rejection.event)), appended.events);
  let trace_with_delta = c2_journal(session_id, trace_with_history,
    [c2_state_delta_event(identity.run_id, step_idx, st.prior_counts, trace_with_history, telemetry, ext_artifacts, artifacts_changed)]);
  {
    msgs: msgs_with_assistant,
    step_idx: step_idx + 1,
    totals: totals,
    ext_artifacts: ext_artifacts,
    telemetry: telemetry,
    provider: st.provider,
    world_state: world,
    pending_tool_calls: [],
    pending_tool_context: [],
    pending_tool_prefix: [],
    pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
    last_finish_reason: "dp7_rejected",
    last_response_text: rejection.errors,
    nudges_used: count_persist_nudges(msgs_with_assistant),
    finalize_source: "",
    prior_counts: st.prior_counts,
    trace: trace_with_delta,
    emissions: emissions,
    history_digest: appended.digest,
    open_waits: st.open_waits,
    park_ordinal: st.park_ordinal,
    park_attempt: st.park_attempt
  }
}

func c2_dp7_approved_state(
  session_id: string,
  identity: RunIdentity,
  st: C2LoopState,
  msgs_with_assistant: [Message],
  totals: RuntimeLoopTotals,
  ext_artifacts: Json,
  telemetry: { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int },
  world: WorldState,
  trace: LedgerTrace,
  emissions: [LedgerEvent],
  artifacts_changed: bool,
  step_idx: int,
  output: string,
  source: string
) -> C2LoopState ! {IO, Trace} {
  let appended = c2_history_appended(identity.run_id, step_idx, st.history_digest, false, last_msg(msgs_with_assistant));
  let trace_with_history = c2_journal(session_id, trace, appended.events);
  let trace_with_delta = c2_journal(session_id, trace_with_history,
    [c2_state_delta_event(identity.run_id, step_idx, st.prior_counts, trace_with_history, telemetry, ext_artifacts, artifacts_changed)]);
  {
    msgs: msgs_with_assistant,
    step_idx: step_idx + 1,
    totals: totals,
    ext_artifacts: ext_artifacts,
    telemetry: telemetry,
    provider: st.provider,
    world_state: world,
    pending_tool_calls: [],
    pending_tool_context: [],
    pending_tool_prefix: [],
    pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
    last_finish_reason: "dp7_approved",
    last_response_text: output,
    nudges_used: count_persist_nudges(msgs_with_assistant),
    finalize_source: source,
    prior_counts: st.prior_counts,
    trace: trace_with_delta,
    emissions: emissions,
    history_digest: appended.digest,
    open_waits: st.open_waits,
    park_ordinal: st.park_ordinal,
    park_attempt: st.park_attempt
  }
}

-- PLAN-002 W4 Part 1: stage 3's state. The approved candidate's journaling,
-- with the reason `decide`'s `Park` arm accepts and no finalize source: the
-- candidate enters the history exactly as an approved one would, and nothing
-- finalizes it while the waits are open.
func c2_await_wake_state(
  session_id: string,
  identity: RunIdentity,
  st: C2LoopState,
  msgs_with_assistant: [Message],
  totals: RuntimeLoopTotals,
  ext_artifacts: Json,
  telemetry: { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int },
  world: WorldState,
  trace: LedgerTrace,
  emissions: [LedgerEvent],
  artifacts_changed: bool,
  step_idx: int,
  candidate: string
) -> C2LoopState ! {IO, Trace} {
  { c2_dp7_approved_state(session_id, identity, st, msgs_with_assistant, totals, ext_artifacts, telemetry, world, trace, emissions, artifacts_changed, step_idx, candidate, "") |
    last_finish_reason: "await_wake" }
}

-- ADR-002 D2, PLAN-002 W2 Part 4: what the no-tool-calls branch decided about
-- the model's candidate. The events it emitted ride along so the caller appends
-- exactly what was projected.
-- ============================================================================
-- PLAN-002 W4 Parts 1-2 (ADR-002 D2/D3): the park's pure half.
-- ============================================================================

-- `<run_id>.p<park_ordinal>` (§1 row 3). Unique per run because the ordinal
-- increments only when a matching wake is applied.
pure func park_request_id(run_id: string, park_ordinal: int) -> string {
  "${run_id}.p${show(park_ordinal)}"
}

pure func wait_ids_of(ws: [WaitDescriptor]) -> [string] {
  match ws {
    [] => [],
    w :: rest => wait_id(w) :: wait_ids_of(rest)
  }
}

pure func has_wait_id(ws: [WaitDescriptor], id: string) -> bool {
  match ws {
    [] => false,
    w :: rest => wait_id(w) == id || has_wait_id(rest, id)
  }
}

pure func join_wait_ids(ids: [string]) -> string {
  match ids {
    [] => "",
    x :: [] => x,
    x :: rest => "${x}, ${join_wait_ids(rest)}"
  }
}

-- THE MATCH (review change 12). `request_id` always. `wait_id` only for the
-- three outcomes that name a wait: the unbound default replies `wait_id: ""`
-- with a `HostError`, and `OperatorInput`/`Aborted` name none (`Aborted`
-- carries the cancelling command in that free field, §8.7).
pure func wake_matches(req: ParkRequest, wake: WakeInput) -> bool {
  wake.request_id == req.request_id
    && (match wake.outcome {
          Settled(_) => has_wait_id(req.waits, wake.wait_id),
          Lost(_) => has_wait_id(req.waits, wake.wait_id),
          TimedOut => has_wait_id(req.waits, wake.wait_id),
          _ => true
        })
}

pure func remove_wait_id(ws: [WaitDescriptor], id: string) -> [WaitDescriptor] {
  match ws {
    [] => [],
    w :: rest => if wait_id(w) == id then remove_wait_id(rest, id) else w :: remove_wait_id(rest, id)
  }
}

pure func remove_timer_id(ws: [WaitDescriptor], id: string) -> [WaitDescriptor] {
  match ws {
    [] => [],
    w :: rest => match w {
      TimerWait(t) => if t.id == id then remove_timer_id(rest, id) else w :: remove_timer_id(rest, id),
      _ => w :: remove_timer_id(rest, id)
    }
  }
}

-- ADR-002 D2's outcome table, the wait's column.
pure func apply_wake(open_waits: [WaitDescriptor], wake: WakeInput) -> [WaitDescriptor] {
  match wake.outcome {
    Settled(_) => remove_wait_id(open_waits, wake.wait_id),
    Lost(_) => remove_wait_id(open_waits, wake.wait_id),
    OperatorInput(_) => open_waits,
    TimedOut => remove_timer_id(open_waits, wake.wait_id),
    HostError(_) => open_waits,
    -- The abort path: cleared with the run.
    Aborted => []
  }
}

-- The tag every loop-authored message carries, so it is never mistaken for an
-- operator's message (ADR-002 D2 "After the wake").
pure func loop_authored_tag() -> string { "[motoko loop]" }

-- ADR-002 D2's outcome table, the message's column. `Settled` directs the model
-- to `DelegateCheck`, the only settlement path (D3), and does not carry the
-- answer itself.
pure func wake_message(wake: WakeInput) -> Message {
  let tag = loop_authored_tag();
  let content = match wake.outcome {
    Settled(_) => "${tag} Wake: delegate wait `${wake.wait_id}` settled: the answer is available; call `DelegateCheck` once.",
    Lost(reason) => "${tag} Wake: delegate wait `${wake.wait_id}` was lost (${reason}). Call `DelegateCheck` once to settle it.",
    OperatorInput(text) => "${tag} Wake: the operator wrote while the run was parked; every wait stays open. The operator's message:\n${text}",
    TimedOut => "${tag} Wake: timer `${wake.wait_id}` expired.",
    HostError(m) => "${tag} Wake: the host could not observe the open waits (${m}). They stay open.",
    Aborted => "${tag} Wake: the park was cancelled (${wake.wait_id})."
  };
  { role: "user", content: content, tool_calls: [], tool_call_id: "", images: [] }
}

-- R2: the dropped reply's `warning`, naming both sides of the mismatch. Not a
-- `LedgerEvent`: a dropped reply appends nothing.
pure func park_drop_warning(req: ParkRequest, wake: WakeInput) -> Json {
  jo([kv("type", js("warning")),
      kv("message", js("park dropped a wake reply: expected request_id=${req.request_id} wait_id in [${join_wait_ids(wait_ids_of(req.waits))}], received request_id=${wake.request_id} wait_id=${wake.wait_id} outcome=${wake_outcome_id(wake.outcome)} attempt=${show(req.attempt)}"))])
}

-- ADR-002 D3's re-delegation row, "the model is told both are open" (review
-- change 18, R5). Applied in the LOOP'S tool fold, where the fold's `open_waits`
-- is in scope: when this batch registered a new wait and left two or more open,
-- each `Delegate` result message of the batch gains one loop-authored sentence
-- naming every open wait. The message was capped and the wait extracted before
-- this (W2 Part 2); the sentence is appended after both.
pure func both_open_sentence(open_waits: [WaitDescriptor]) -> string {
  "\n\n${loop_authored_tag()} ${show(List.length(open_waits))} waits are open: ${join_wait_ids(wait_ids_of(open_waits))}. Each stays open until it is settled or lost."
}

pure func registered_new_wait(before: [WaitDescriptor], after: [WaitDescriptor]) -> bool {
  match after {
    [] => false,
    w :: rest => not has_wait_id(before, wait_id(w)) || registered_new_wait(before, rest)
  }
}

pure func is_delegate_call_id(calls: [ToolCall], id: string) -> bool {
  match calls {
    [] => false,
    c :: rest => (c.id == id && c.name == "Delegate") || is_delegate_call_id(rest, id)
  }
}

pure func both_open_msgs(calls: [ToolCall], before: [WaitDescriptor], after: [WaitDescriptor], msgs: [Message]) -> [Message] {
  if List.length(after) >= 2 && registered_new_wait(before, after)
  then List.map(\m. if m.role == "tool" && is_delegate_call_id(calls, m.tool_call_id) then { m | content: "${m.content}${both_open_sentence(after)}" } else m, msgs)
  else msgs
}

type CandidateClass
  = CandidateRejected({ rejection: Dp7Rejection, world: WorldState })
  | CandidateFeedback({ event: LedgerEvent, feedback: string, world: WorldState })
  | CandidateNudge({ event: LedgerEvent, world: WorldState })
  | CandidateApproved({ output: string, source: string, world: WorldState })
  -- PLAN-002 W4 Part 1: stage 3. The world is stage 2's rejection world, for
  -- the same reason: no completion hook ran.
  | CandidateAwaitWake({ world: WorldState })

-- The candidate's classification, in D2's stage order and no other:
--
--   1. pending      upstream: tool calls or a pending approval never reach here.
--   2. DP7          a NON-BLANK candidate (`trim(candidate) != ""`, PLAN-002
--                   §0.2 rule 6) is verified FIRST; a rejection returns before
--                   any completion policy runs, so a solver that would have
--                   bounced the same candidate never sees it.
--   3. waits        LIVE from PLAN-002 W4 Part 1: any open wait classifies the
--                   candidate `await_wake`, whatever it says, blank included,
--                   before any solver, nudge or blank verification runs.
--   4. completion   `dispatch_solver_candidate`, then the persist nudge, as at
--                   HEAD.
--   5. finalize     a non-blank candidate is approved without a second verifier
--                   run (stage 2 judged it); a BLANK one is verified here, as
--                   HEAD's `c2_after_dp7` did (§1 row 7). So the verifier runs
--                   at most once per candidate.
--
-- THE STAGE-2 WORLD IS `token_to_world(clear_holder(ctx.world))`. HEAD's
-- rejection arm carried `token_to_world(finalized.next_state)`, and with no
-- finalize hook registered that is `clear_holder(collected.next_state)` over an
-- empty fold, i.e. `clear_holder(ctx.world)` (`ext/runtime.ail:722`, `:727`).
-- Under stage 2 no hook has run, so this is that same expression with the fold
-- removed. `ctx.world` is the intercept's successor, already holder-cleared by
-- `dispatch_response_intercept`, and `clear_holder` is idempotent on it; it is
-- written out so the equivalence with HEAD does not rest on that.
--
-- The row is the union of `dispatch_solver_candidate`'s and
-- `dp7_rejection_errors`': nothing here recurses into the loop.
func classify_candidate(
  rt: ExtRuntime,
  ctx: ExtCtx,
  candidate: string,
  msgs_with_assistant: [Message],
  workdir: string,
  step_idx: int,
  session_id: string,
  persist_retries: int,
  nudges_used: int,
  open_waits: [WaitDescriptor]
) -> CandidateClass ! {Process, IO, Clock, Trace} {
  let blank = trim(candidate) == "";
  -- Stage 2.
  let stage2 = if blank then None else dp7_rejection_errors(rt, workdir, step_idx, session_id);
  match stage2 {
    Some(rejection) => CandidateRejected({ rejection: rejection, world: token_to_world(clear_holder(ctx.world)) }),
    None =>
      -- Stage 3 (PLAN-002 W4 Part 1).
      if List.length(open_waits) > 0 then CandidateAwaitWake({ world: token_to_world(clear_holder(ctx.world)) })
      else {
      -- Stage 4. The solver's successor is the world from here on, whichever
      -- decision won (WI-B2b).
      let finalized = dispatch_solver_candidate(rt, ctx, candidate);
      let world = token_to_world(finalized.next_state);
      let completion = match finalized.decision {
        Accept(output) => CandidateApproved({ output: output, source: "ext_solver_accept", world: world }),
        ContinueWithFeedback(feedback) => {
          let event = ExtSolverFeedback({ step: step_idx, feedback: feedback });
          let _ = ledger_emit(session_id, event);
          CandidateFeedback({ event: event, feedback: feedback, world: world })
        },
        NoDecision =>
          if should_inject_persist_nudge(persist_retries, nudges_used, any_writefile_attempt(msgs_with_assistant)) then {
            let event = PersistNudge({
              step: step_idx,
              nudge_num: nudges_used + 1,
              budget: persist_retries
            });
            let _ = ledger_emit(session_id, event);
            CandidateNudge({ event: event, world: world })
          } else CandidateApproved({ output: candidate, source: "", world: world })
      };
      -- Stage 5.
      match completion {
        CandidateApproved(approved) =>
          if not blank then completion
          else match dp7_rejection_errors(rt, workdir, step_idx, session_id) {
            Some(rejection) => CandidateRejected({ rejection: rejection, world: approved.world }),
            None => completion
          },
        _ => completion
      }
      }
  }
}

func c2_loop(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  session_id: string,
  identity: RunIdentity,
  started_at_ms: int,
  st: C2LoopState
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  match c2_step_state(st) {
    -- Terminal: invalid history. This path emitted no run_summary at all
    -- before A9 — it is one of the two terminal returns the ADR's five-call-site
    -- enumeration missed. It now finalizes like every other.
    Err(reason) => {
      let result: Result[[Message], AIError] = Err({ code: "InvalidHistory", message: reason, retryable: false });
      c2_finalize(st.provider, st.world_state, session_id, model, st.totals, st.step_idx, TermInvalidHistory, reason, started_at_ms, st.trace, st.emissions, result, c2_final_state(st))
    },
    Ok(step_state) => {
      let decision = decide(step_state, policy.step);
      let trace_with_decision = c2_append_decision(st.trace, st.step_idx, decision);
      match decision {
        -- Terminal: budget, compaction exhaustion or internal, discriminated by
        -- decision_fail_reason — EXCEPT the step budget, which ADR-003 v6.1 D2
        -- makes a typed suspension rather than a failure. P1 Part 2 gave it a
        -- code of its own precisely so this split could be a match on the code
        -- and not on a message string; this is the arm that split needed.
        --
        -- `c2_suspend` may still route BACK to `c2_fail` when the history it
        -- would carry out is not resumable. Every other code goes to `c2_fail`
        -- as it did before.
        Fail(info) =>
          if info.code == "StepBudgetExhausted" then
            c2_suspend(task, env_url, hybrid_tools, budget, policy, model, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, info, st, trace_with_decision)
          else c2_fail(st.provider, st.world_state, session_id, model, st.totals, st.step_idx, max_cost_millicents, started_at_ms, info.code, info.message, info.retryable, trace_with_decision, st.emissions, c2_final_state(st)),
        Finalize(info) => {
          let done_step = c2_done_step(st.step_idx);
          -- WI-D4. READ, not re-resolved. `session_policy_init` already resolved
          -- this model's limit and stored it here; WI-D3 re-resolved it at this
          -- and three sibling sites, which put the driver's config reads into
          -- the recorded interaction log on every loop arm.
          --
          -- SAFE BECAUSE IT WAS MEASURED, not because the two look equal: a
          -- temporary assertion at all four sites, comparing the stored value
          -- against a fresh resolution and the loop's `model` against
          -- `policy.step.model`, ran over the WHOLE of `make dst` and reported
          -- 657 executions and ZERO mismatches — 282 here at `CallModel`, 205 at
          -- `RunTools`, 75 at this site and 95 at the approval site. The
          -- structural reason is that `model` and `policy.step.model` move
          -- together: every `session_policy_init` caller passes the same model it
          -- passes the loop, and the one model SWITCH,
          -- `conversation_loop_v2_with_policy`'s `model_change`, rebuilds the
          -- policy through `session_policy_with_model` and passes BOTH.
          --
          -- SUCCESSOR: none is lost. `r_limit.next_state` descended from
          -- `st.world_state` with nothing between them, so `st.world_state` is
          -- both the predecessor and — with no read performed — the successor.
          -- This is NOT the shape WI-D1 found in production, where the discarded
          -- state was the successor of work that had actually happened.
          let empty_event = EmptyStopFinalize({
            step: done_step,
            input_tokens: st.telemetry.last_input_tokens,
            estimated_input_tokens: st.telemetry.last_estimated_input_tokens,
            context_limit: raw_window_of(policy.step.compaction.context_limit)
          });
          let trace_after_empty_floor =
            if trim(info.output) == "" then {
              let _ = ledger_emit(session_id, empty_event);
              ledger_append(trace_with_decision, WireRecord(empty_event))
            } else trace_with_decision;
          -- WI-A14 (D6.4 / D7's parity family). The DoneEvent is APPENDED here,
          -- before c2_finalize appends the RunSummary, and PROJECTED after it.
          -- Three obligations that could not all hold while it was
          -- projected-only now do: D6.4 (a Logical event reaches the returned
          -- trace), D6.1 (the RunSummary is STILL the final record) and D6.3
          -- (agreement, now decidable over the returned trace alone). The wire
          -- order is untouched: D6.4 asks for PARITY, not one transition.
          let done_event = DoneEvent({ step: done_step, output: info.output, source: st.finalize_source });
          let trace_with_done = ledger_append(trace_after_empty_floor, WireRecord(done_event));
          let published = publish_turn_exit_manifest(rt, task, model, workdir, env_url, hybrid_tools, budget, st.provider, session_id, trace_with_done, st.world_state);
          -- BEFORE `c2_finalize` (PLAN-001 P2 Part 5(a)): its env read is witnessed and its successor is the world the finalize clock reads, so RunSummary stays last. BEFORE `done`, DELIBERATELY:
          -- the TUI exits on `done` without waiting for this process, so a manifest published after it is a race this
          -- code lost under measurement. See `publish_turn_exit_manifest`.
          let finalized = c2_finalize(st.provider, published.world, session_id, model, st.totals, st.step_idx, TermSuccess, "", started_at_ms, published.trace, st.emissions, Ok(st.msgs), c2_final_state(st));
          let _ = ledger_emit(session_id, done_event);
          finalized
        },
        InjectUserMessage(msg) => {
          let next_msgs = st.msgs ++ [msg];
          let next_nudges = if st.last_finish_reason == "persist_nudge" then st.nudges_used + 1 else st.nudges_used;
          -- ADR-003 D2's `:2494`. The injected message is a `user` message the
          -- OPERATOR never sent, and it is journaled exactly like one that was:
          -- the provider sees it, so a resume that did not would send a
          -- different conversation than the one this run held. NOT a step end —
          -- `step_idx` does not move here — so no `StateDelta`.
          let appended = c2_history_appended(identity.run_id, st.step_idx, st.history_digest, false, [msg]);
          let next_state: C2LoopState = {
            msgs: next_msgs,
	            step_idx: st.step_idx,
	            totals: st.totals,
	            ext_artifacts: st.ext_artifacts,
	            telemetry: st.telemetry,
	            provider: st.provider,
	            world_state: st.world_state,
            pending_tool_calls: [],
            pending_tool_context: [],
            pending_tool_prefix: [],
            pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
            last_finish_reason: "user_injected",
            last_response_text: "",
            nudges_used: next_nudges,
            finalize_source: "",
            prior_counts: st.prior_counts,
            trace: c2_journal(session_id, trace_with_decision, appended.events),
            emissions: st.emissions,
            history_digest: appended.digest,
            open_waits: st.open_waits,
            park_ordinal: st.park_ordinal,
            park_attempt: st.park_attempt
          };
          c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
        },
        TakeCheckpoint(plan) => {
          let cp = apply_checkpoint(step_state, plan);
          let _ = ledger_emit(session_id, cp.event);
          -- ADR-003 D2's `:2521`, and `first_kept: None` is a FACT about
          -- `apply_checkpoint` rather than a placeholder: `checkpoint` rebuilds
          -- the history as the pinned system prefix plus ONE summary message and
          -- keeps no tail, so there is no pre-checkpoint index to report. The
          -- field exists for a checkpoint that later keeps one, and the fold's
          -- rule is written for both.
          --
          -- `messages` IS THE SUMMARY ALONE, not the rebuilt history: D4 says the
          -- fold emits the head system prefix, then this entry's `messages`, then
          -- the entries after it, so a `messages` that repeated the prefix would
          -- fold to two copies of it. The summary is the last message of the
          -- rebuilt list by construction.
          --
          -- `digest_after` RE-BASES THE CHAIN to `chain_digest_base(prefix ++
          -- messages)` — P3 Part 2's second chain decision, and the fold
          -- recomputes exactly this over the post-replacement history it holds.
          -- It is `digest_messages`, a whole-list hash of the canonical form, and
          -- NOT the incremental `chain_digest_after`: after a replacement there
          -- is no previous entry to chain from.
          let cp_msgs = history_messages(cp.state.history);
          let replaced_event = HistoryReplaced({
            run_id: identity.run_id,
            step: st.step_idx,
            reason: "checkpoint",
            first_kept: None,
            messages: messages_json(last_msg(cp_msgs)),
            digest_after: digest_messages(cp_msgs)
          });
          let cp_artifacts_changed = encode(cp.state.ext_artifacts) != encode(st.ext_artifacts);
          let trace_with_cp = c2_journal(session_id, ledger_append(trace_with_decision, WireRecord(cp.event)), [replaced_event]);
          let trace_with_delta = c2_journal(session_id, trace_with_cp,
            [c2_state_delta_event(identity.run_id, st.step_idx, st.prior_counts, trace_with_cp, cp.state.telemetry, cp.state.ext_artifacts, cp_artifacts_changed)]);
          let next_state: C2LoopState = {
            msgs: cp_msgs,
	            step_idx: st.step_idx,
	            totals: st.totals,
	            ext_artifacts: cp.state.ext_artifacts,
	            telemetry: cp.state.telemetry,
	            provider: st.provider,
	            world_state: st.world_state,
            pending_tool_calls: st.pending_tool_calls,
            pending_tool_context: st.pending_tool_context,
            pending_tool_prefix: st.pending_tool_prefix,
            pending_tool_batched: st.pending_tool_batched,
            accumulated_tool_msgs: st.accumulated_tool_msgs,
            pending_approval: st.pending_approval,
            last_finish_reason: st.last_finish_reason,
            last_response_text: st.last_response_text,
            nudges_used: st.nudges_used,
            finalize_source: st.finalize_source,
            prior_counts: st.prior_counts,
            trace: trace_with_delta,
            emissions: st.emissions,
            history_digest: { at: digest_messages(cp_msgs), prev: st.history_digest.at },
            open_waits: st.open_waits,
            park_ordinal: st.park_ordinal,
            park_attempt: st.park_attempt
          };
          c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
        },
        -- PLAN-002 W4 Part 2 (ADR-002 D2): THE PARK. `decide` returned the open
        -- waits; the request is built here from `RunIdentity` and the park
        -- counters (§1 row 3). ONE `wake_read` call site serves the first issue
        -- and every re-issue (review change 17), so the inventory rises by one.
        --
        --   - `ParkEntered` is appended AND emitted before the port is called,
        --     on the first issue only (`park_attempt == 0`).
        --   - The successor is WITNESSED for every reply, a dropped one
        --     included: the port has advanced the world either way.
        --   - A reply that does not match (`request_id` always; `wait_id` only
        --     for Settled/Lost/TimedOut, review change 12) is dropped: a
        --     `warning`, NOTHING appended (R2), and the same request re-issued
        --     with `step_idx + 1` and `park_attempt + 1` through `decide`, whose
        --     `Park` arm carries the step budget (R1). `request.step` stays the
        --     park's original step on every re-issue.
        --   - A matching reply appends and emits `WakeReceived`. `Aborted` (every
        --     mid-park cancel command, §8.7) clears the waits and ends the run
        --     `Fail(ParkCancelled)` through `c2_fail`, the `Fail` arm's own
        --     terminal, so `RunSummary` is written as for any failure. Every
        --     other outcome injects `wake_message` as `user_injected` with the
        --     next ordinal, so the accepted wake reaches `call_model_or_fail`.
        Park(waits) => {
          let request: ParkRequest = { request_id: park_request_id(identity.run_id, st.park_ordinal), step: st.step_idx - st.park_attempt, waits: waits, attempt: st.park_attempt };
          let entered = ParkEntered({ request_id: request.request_id, step: request.step, waits: waits });
          let trace_entered = if st.park_attempt == 0 then { let _ = ledger_emit(session_id, entered); ledger_append(trace_with_decision, WireRecord(entered)) } else trace_with_decision;
          let wake = st.provider.wake_read(st.world_state, request);
          let woke = witness(session_id, trace_entered, wake.next_state);
          if not wake_matches(request, wake) then {
            let _ = emit_json(park_drop_warning(request, wake));
            c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, { st | step_idx: st.step_idx + 1, park_attempt: st.park_attempt + 1, world_state: woke.world, trace: woke.trace })
          } else {
            let received = WakeReceived({ request_id: wake.request_id, wait_id: wake.wait_id, outcome: wake_outcome_id(wake.outcome), detail: wake_outcome_detail(wake.outcome) });
            let _ = ledger_emit(session_id, received);
            let trace_woken = ledger_append(woke.trace, WireRecord(received));
            match wake.outcome {
              Aborted => {
                let cancelled: C2LoopState = { st | world_state: woke.world, open_waits: apply_wake(st.open_waits, wake) };
                c2_fail(cancelled.provider, cancelled.world_state, session_id, model, cancelled.totals, cancelled.step_idx, max_cost_millicents, started_at_ms, "ParkCancelled", wake.wait_id, false, trace_woken, cancelled.emissions, c2_final_state(cancelled))
              },
              _ => {
                let wake_msg = wake_message(wake);
                let appended = c2_history_appended(identity.run_id, st.step_idx, st.history_digest, false, [wake_msg]);
                let next_state: C2LoopState = { st |
                  msgs: st.msgs ++ [wake_msg],
                  world_state: woke.world,
                  last_finish_reason: "user_injected",
                  last_response_text: "",
                  finalize_source: "",
                  trace: c2_journal(session_id, trace_woken, appended.events),
                  history_digest: appended.digest,
                  open_waits: apply_wake(st.open_waits, wake),
                  park_ordinal: st.park_ordinal + 1,
                  park_attempt: 0
                };
                c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
              }
            }
          }
        },
        AwaitApproval(_) => {
          match st.pending_approval {
            -- Terminal: internal driver failure. The second of the two terminal
            -- returns that emitted no run_summary before A9.
            None => {
              let msg = "approval requested without pending approval state";
              let result: Result[[Message], AIError] = Err({ code: "Internal", message: msg, retryable: false });
              c2_finalize(st.provider, st.world_state, session_id, model, st.totals, st.step_idx, TermInternalFailure, msg, started_at_ms, trace_with_decision, st.emissions, result, c2_final_state(st))
            },
            Some(req) => {
              -- WI-A12's approval class. The operator's input comes from the
              -- world through the port; `resolve_approval` stays here because
              -- it is pure policy, not an effect. `input.eof` replaces the old
              -- `raw == ""` inference — behaviour-identical for the live
              -- adapter, which reports eof exactly when readLine returns "".
              let input = st.provider.approval_read(st.world_state, req);
              let resolution = resolve_approval(input.raw, req.default_allow, input.eof);
              -- `post` carries the advanced approval cursor and is what every
              -- continuation below uses. Deliberately NOT written as a shadowing
              -- `let st = ...`: that compiles, but it makes "which `st`" a
              -- question of line order, and a later edit adding a use above this
              -- point would silently read the pre-approval world. Passing `st`
              -- here instead of `post` is the freeze this class's assertion
              -- catches — the queue would never advance.
              let approved = witness(session_id, trace_with_decision, advance(input.next_state, ToolExec)); let post: C2LoopState = { st | world_state: approved.world };
              let tool_step_idx = c2_done_step(post.step_idx);
              -- WI-D4 removed WI-D3's `post_ctx` here, and THIS is the site
              -- where doing it carelessly would have cost something. `post_ctx`
              -- was `post` advanced past the resolution's requests; `post` is
              -- `st` advanced past the APPROVAL READ. Collapsing to `st` — the
              -- edit the type checker accepts just as readily — would have
              -- thrown the approval cursor away and frozen the queue, which is
              -- WI-D1's production defect in miniature and exactly what the
              -- comment above says this arm is prone to. The successor that
              -- disappears with the resolution is the resolution's own; the one
              -- that must survive is `input.next_state`, and it does, in `post`.
              let ctx = mk_v2_ext_ctx(task, tool_step_idx, model, workdir, env_url, hybrid_tools, budget, c2_pending_context(post), raw_window_of(policy.step.compaction.context_limit), "", [], wait_descriptors_json(post.open_waits), ext_ports_of(post.provider, post.world_state, policy.step.provider_base_url), post.ext_artifacts, post.telemetry, world_to_token(post.world_state));
              match resolution {
                ApprovalDenied(reason) => {
                  let denied_event = NativeToolDenied({
                    step: tool_step_idx,
                    stream_id: req.stream_id,
                    tool: req.call.name,
                    id: req.call.id,
                    reason: reason
                  });
                  let _ = ledger_emit(session_id, denied_event);
                  let denial_msg = policy_denied_message(req.call, reason);
                  c2_continue_tool_batch(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, post, ledger_append(approved.trace, WireRecord(denied_event)), req, post.accumulated_tool_msgs ++ [denial_msg])
                },
                ApprovalAllowed => {
                  let executed = execute_allowed_tool_call(post.provider, post.world_state, rt, ctx, req.call, workdir, tool_step_idx, req.stream_id, ohmy_pi, post.open_waits, \event. ledger_emit(session_id, event));
                  -- `after` carries BOTH advanced cursors: the approval queue
                  -- (from `post`) and the tool queue (from this execution).
                  -- WI-D2 adds a third thing to carry — `executed.emitted` — and
                  -- this is the site where forgetting it is least visible,
                  -- because the batch continues and the events would simply
                  -- never appear.
                  let executed_w = witness(session_id, c2_trace_wire_events(approved.trace, executed.emitted), executed.next_state); let after: C2LoopState = { post | world_state: executed_w.world, open_waits: executed.open_waits };
                  c2_continue_tool_batch(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, after, executed_w.trace, req, after.accumulated_tool_msgs ++ [executed.msg])
                }
              }
            }
          }
        },
        RunTools(plan) => {
          let tool_step_idx = c2_done_step(st.step_idx);
          let stream_id = "step-${show(tool_step_idx)}";
          let calls = c2_tool_plan_calls(plan.entries);
          let request_id = "step-${show(tool_step_idx)}";
          let ctx_msgs = c2_pending_context(st);
          -- WI-D4. The stored limit, and WI-D3's `st_ctx` goes with the
          -- resolution that produced it.
          --
          -- SUCCESSOR: nothing is lost. Between `st` and the deleted resolution
          -- stood only `c2_done_step` and `c2_pending_context`, both pure, so
          -- `r_limit.next_state` was `st.world_state` plus this resolution's own
          -- requests and nothing else. The dispatcher below therefore starts
          -- from the same world it would have started from, and `done.world` —
          -- the successor that IS load-bearing here — is untouched.
          let ctx = mk_v2_ext_ctx(task, tool_step_idx, model, workdir, env_url, hybrid_tools, budget, ctx_msgs, raw_window_of(policy.step.compaction.context_limit), "", [], wait_descriptors_json(st.open_waits), ext_ports_of(st.provider, st.world_state, policy.step.provider_base_url), st.ext_artifacts, st.telemetry, world_to_token(st.world_state));
          let emit_calls = st.pending_tool_batched && List.length(st.accumulated_tool_msgs) == 0 && st.last_finish_reason != "approval_resolved";
          let calls_event = NativeToolCalls({
            request_id: request_id,
            step: tool_step_idx,
            stream_id: stream_id,
            payload: ja(tool_calls_to_envelope_jsons(calls))
          });
          let _ = if emit_calls then ledger_emit(session_id, calls_event) else ();
          -- WI-D2. Appended under the SAME condition it is emitted under. An
          -- unconditional append here type-checks and puts a record in the trace
          -- for a batch that announced nothing on the wire — which the wire gate
          -- reads as trace > wire, and is why the condition is shared rather
          -- than restated.
          let trace_with_calls =
            if emit_calls then ledger_append(trace_with_decision, WireRecord(calls_event))
            else trace_with_decision;
          -- COMPUTED INSIDE THE LAMBDA, AND UNDER THE NAME GUARD. This was a
          -- `let` above the dispatch, so every tool batch in every session paid
          -- a full `runtime_status_json` — an O(|trace|) fold and a JSON encode
          -- — and then discarded it, because the value is only ever read when
          -- the batch contains a `MotokoRuntimeStatus` call. It was the second
          -- half of motoko_agent#160: the fold's DEPTH is fixed at its
          -- definition, this fixes who pays for it.
          --
          -- THE PREDICATE IS DUPLICATED ON PURPOSE. `runtime_status_tool_message`
          -- keeps its own `call.name` check so it stays correct called from
          -- anywhere; this one exists to keep the ARGUMENT from being evaluated,
          -- which AILANG's strict application would otherwise do at every call
          -- in the batch. Deleting either one is a silent regression: dropping
          -- this guard restores the cost, dropping the inner one makes the
          -- helper wrong for every other caller.
          let runtime_builtin = \call.
            if call.name == "MotokoRuntimeStatus" then
              runtime_status_tool_message(call, encode(runtime_status_json(st, policy, tool_step_idx)))
            else None;
          match dispatch_tool_entries_with_builtin(st.provider, st.world_state, rt, ctx, plan.entries, workdir, tool_step_idx, stream_id, ohmy_pi, st.accumulated_tool_msgs, [], st.open_waits, \event. ledger_emit(session_id, event), runtime_builtin) {
            -- `done.world`, not `st.world_state`. The batch may have executed
            -- several tools and each one advanced the cursor; taking it off `st`
            -- type-checks and rewinds the world to before the batch.
            --
            -- WI-D2: `done.emitted` is the same rule on the second channel the
            -- fold now returns. The tool-dispatch events land BETWEEN the batch
            -- announcement and whatever the batch produces, which is when they
            -- happened — the same positioning the stream deltas get at the
            -- provider call, and for the same reason: a block appended in the
            -- wrong place satisfies a count and fails order.
            ToolDispatchDone(done) => { let tooled = witness(session_id, c2_trace_wire_events(trace_with_calls, done.emitted), done.world);
              c2_finish_tool_batch(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, { st | world_state: tooled.world, open_waits: done.open_waits }, tooled.trace, tool_step_idx, stream_id, both_open_msgs(calls, st.open_waits, done.open_waits, done.msgs)) },
            ToolDispatchPending(pending) => { let paused = witness(session_id, c2_trace_wire_events(trace_with_calls, pending.emitted), pending.world);
              let next_state: C2LoopState = {
                msgs: st.msgs,
	                step_idx: st.step_idx,
	                totals: st.totals,
	                ext_artifacts: st.ext_artifacts,
	                telemetry: st.telemetry,
	                provider: st.provider,
	                -- `pending.world`: tools already executed in this batch
	                -- before the approval interrupted it, and their cursor
	                -- advances must survive the suspension.
	                world_state: paused.world,
                pending_tool_calls: [pending.request.call],
                pending_tool_context: st.pending_tool_context,
                pending_tool_prefix: st.pending_tool_prefix,
                pending_tool_batched: st.pending_tool_batched,
                accumulated_tool_msgs: pending.accumulated,
                pending_approval: Some(pending.request),
                last_finish_reason: "await_approval",
                last_response_text: pending.request.reason,
                nudges_used: st.nudges_used,
                finalize_source: "",
                prior_counts: st.prior_counts,
                -- WI-D2: `pending.emitted`, and the suspension is exactly where
                -- this is easy to drop — the branch already had to remember
                -- `pending.world` and `pending.accumulated` for the same reason.
                trace: paused.trace,
                emissions: st.emissions,
                -- ADR-003 D2: `st.msgs` unchanged, so nothing is journaled and
                -- the chain is carried.
                history_digest: st.history_digest,
                open_waits: pending.open_waits,
                park_ordinal: st.park_ordinal,
                park_attempt: st.park_attempt
              };
              c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
            }
          }
        },
        CallModel(_) => {
          let step_idx = st.step_idx;
          -- WI-D4. The stored limit, and WI-D3's `st_ctx` goes with it.
          --
          -- SUCCESSOR: nothing is lost — the deleted resolution was the first
          -- thing this arm did to the world, so its successor was `st`'s own.
          -- The two `SealSystemPrompt`/`SealExhausted` finalize sites below
          -- therefore returned to `st.world_state`, which is where they stood
          -- before WI-D3 and was NOT a narrowing: WI-D3 pointed them at `st_ctx`
          -- only so that item did not newly widen them, and with no resolution
          -- here there was no widening to preserve.
          --
          -- WI-D4's LAST SENTENCE HAS EXPIRED, and the history is kept two-part
          -- per S15 because a documented deferral is only legible against the
          -- scope that deferred it. It read: "They still ignore
          -- `chain.next_state`, the pre-step chain's successor, which remains a
          -- separate un-threaded seam and is out of this item's scope." WI-D25
          -- is the item whose scope it is. Both sites now take
          -- `token_to_world(chain.next_state)`, and the deferral's ground did
          -- not survive re-measurement: it was about WI-D3's deleted
          -- resolution, which says nothing about the chain.
          --
          -- WHY — the `Ok` arm's reason, met on the two failing arms. The chain
          -- is dispatched BELOW this comment and ABOVE the match, so a pre-step
          -- hook's `ai_step` calls have already happened on ALL THREE arms.
          -- Sealing failed; the effects did not. Returning `st.world_state`
          -- here un-happens whatever the chain consumed, and the run's terminal
          -- world reports a cursor that never advanced.
          --
          -- IT WAS INVISIBLE FOR THE REASON S29 GIVES: every `on_pre_step`
          -- binding in the tree returned `ctx.world` unchanged, so the drop and
          -- the thread produced identical worlds. `world_state_probe`'s
          -- `consuming_pre_step_2`/`_3` are the first bindings that do not, and their
          -- two seal-terminal rows go red against the reverted argument.
          let context_limit = raw_window_of(policy.step.compaction.context_limit);
          let split = split_for_compaction(st.msgs);
          let compactable_msgs = segment_messages(split.segment);
          let pinned_tokens = estimate_tokens_messages(split.pinned);
          let ext_context_limit = working_budget_for_ext(policy.step.compaction.context_limit, pinned_tokens);
          let pre_ctx = mk_v2_ext_ctx(task, step_idx, model, workdir, env_url, hybrid_tools, budget, st.msgs, ext_context_limit, "", [], wait_descriptors_json(st.open_waits), ext_ports_of(st.provider, st.world_state, policy.step.provider_base_url), st.ext_artifacts, st.telemetry, world_to_token(st.world_state));
          let chain = dispatch_pre_step_chain(rt, pre_ctx, messages_to_msgs(compactable_msgs));
          -- ADR-003 D1's `state_delta`: the artifacts go inline ONLY when they
          -- moved. Computed ONCE here, where both the old value (`st`) and the
          -- new one (`chain.artifacts`) are in scope — every step-end literal
          -- below carries `chain.artifacts`, and the `c2_dp7_*_state` builders
          -- receive only the new one, so a per-site comparison would have to re-derive an old
          -- value it does not hold.
          let artifacts_changed = encode(chain.artifacts) != encode(st.ext_artifacts);
          let _ = emit_pre_step_stages(session_id, step_idx, chain.stages);
          let trace_after_stages = c2_trace_stage_records(trace_with_decision, step_idx, chain.stages);
          match seal_compacted_payload(split, msgs_to_messages(chain.msgs), model, context_limit, policy.step.require_system_prompt) {
            -- Terminal: the seal could not produce a usable system prompt.
            -- Reachable, and absent from the ADR's enumeration of termination
            -- reasons; it maps to the "error" wire string like the other
            -- non-specific failures.
            Err(SealSystemPromptEmpty(reason)) => {
              let event = ErrorEvent({ source: "system_prompt", code: "SystemPromptEmpty", message: reason });
              let _ = ledger_emit(session_id, event);
              let result: Result[[Message], AIError] = Err({ code: "SystemPromptEmpty", message: reason, retryable: false });
              c2_finalize(st.provider, token_to_world(chain.next_state), session_id, model, st.totals, step_idx, TermSystemPromptEmpty, reason, started_at_ms, ledger_append(trace_after_stages, WireRecord(event)), st.emissions, result, c2_final_state(st))
            },
            -- Terminal: compaction exhausted.
            Err(SealExhausted(compaction_reason)) => {
              let event = CompactionExhausted({ step: step_idx, model: model, reason: compaction_reason });
              let _ = ledger_emit(session_id, event);
              let result: Result[[Message], AIError] = Err({ code: "ContextExhausted", message: compaction_reason, retryable: false });
              c2_finalize(st.provider, token_to_world(chain.next_state), session_id, model, st.totals, step_idx, TermCompactionExhausted, compaction_reason, started_at_ms, ledger_append(trace_after_stages, WireRecord(event)), st.emissions, result, c2_final_state(st))
            },
            Ok(payload) => {
              let compacted_msgs = payload_messages(payload);
              let stream_id = "step-${show(step_idx)}";
              let start_event = ThinkingStreamStart({ step: step_idx, stream_id: stream_id, model: model });
              let _ = ledger_emit(session_id, start_event);
              let on_chunk: (StreamChunk) -> () ! {IO, Trace} = \chunk. append_stream_delta(session_id, step_idx, stream_id, chunk);
              let prepared_event = ProviderCallPrepared({
                step: step_idx,
                msg_count: List.length(compacted_msgs),
                estimated_input_tokens: estimate_tokens_messages(compacted_msgs),
                system_prefix_count: count_system_prefix(compacted_msgs),
                system_prefix_chars: system_prefix_chars(compacted_msgs),
                system_prefix_digest: system_prefix_digest_for(split.pinned),
                payload_digest: payload_digest(compacted_msgs),
                model: model
              });
              let _ = ledger_emit(session_id, prepared_event);
              -- WI-B2b: `chain.next_state`, not `st.world_state`. The pre-step
              -- chain runs BEFORE this call and a compaction hook may have made
              -- provider calls of its own; starting the model step from the
              -- world the chain was entered with would re-serve whatever the
              -- chain already consumed. This is the pre-step half of the same
              -- threading the intercept and solver hooks do below.
              let exchange = dispatch_step(st.provider, token_to_world(chain.next_state), provider_api_model(model, policy.step.provider_base_url), compacted_msgs, on_chunk);
              -- WI-C3: THE READER. `exchange.emissions` had no consumer until
              -- this line; WI-A1 built the channel, WI-C1 made it non-empty on a
              -- live exchange, and this is where it is spent.
              --
              -- Two channels come out of one conversion, and they are threaded
              -- SEPARATELY on purpose (see `C2LoopState.emissions`):
              --
              --   * the returned trace gets these events appended, which closes
              --     `StreamDelta` in `d64_gap_register` — the driver used to
              --     ledger_emit every delta and append none, so the returned
              --     trace held zero StreamDelta records on every path and D6.4's
              --     parity had no second side to compare against at all;
              --   * `C2LoopState.emissions` carries the same events forward as
              --     the run's emission witness, which is what an
              --     `ExecutionUnderTest` needs and what `emissions: []` could
              --     never be.
              --
              -- WHAT THIS PAIR DOES AND DOES NOT TEST, because a green
              -- `stream_parity_findings` on a real run must not be over-read.
              -- Both sides are derived from `exchange.emissions` here, and that
              -- is not a shortcut — it is the only observation of the stream
              -- that exists in this process. The callback's own projections go
              -- to `ledger_emit`, which returns `()`, and the callback's row is
              -- closed `{IO}` so it cannot accumulate them; D1 rejected the
              -- scoped recorder and SharedMem explicitly. So in-process parity
              -- tests that every branch below carries BOTH channels forward —
              -- the trace has one junction (`trace_after_call`), the witness is
              -- set in six branch literals, and a branch that keeps one and
              -- drops the other goes red. It does NOT test that the callback
              -- projected what the provider returned. That comparison needs the
              -- WIRE, which is out of process, and it is what
              -- `make stream_parity` does.
              let stream_events = stream_chunk_events(step_idx, stream_id, exchange.emissions);
              let emissions_after_call = st.emissions ++ stream_events;
              -- The stream deltas sit between the prepared event and whatever
              -- the outcome produces, which is when they actually happened.
              let stepped = witness(session_id, c2_trace_wire_events(ledger_append(ledger_append(trace_after_stages, WireRecord(start_event)), WireRecord(prepared_event)), stream_events), exchange.next_state); let trace_after_call = stepped.trace;
              match exchange.result {
                Err(e) => {
                  let end_event = ThinkingStreamEnd({ step: step_idx, stream_id: stream_id, status: "errored" });
                  let _ = ledger_emit(session_id, end_event);
                  -- WI-D2 CLOSES THE BRACKET. `ThinkingStreamStart` has been in
                  -- the returned trace since A8 and its closing half was
                  -- `ledger_emit`-only — the same code path appending one
                  -- bracket and projecting the other, which was the sharpest
                  -- single statement of D6.4's gap. Appended AFTER the deltas
                  -- and before whatever the outcome produces, because that is
                  -- when the stream ended.
                  let trace_after_end = ledger_append(trace_after_call, WireRecord(end_event));
                  -- WI-A12's env class. This was "the sixth and last driver env
                  -- read" from WI-A12 until WI-D3; it is the last one IN
                  -- session.ail and it is no longer the last in the driver —
                  -- `context_usage` reads four more through the same port.
                  let capt = if not e.retryable then { let capture = st.provider.env_get(stepped.world, "MOTOKO_CAPTURE_FAILED_PAYLOAD", ""); let _ = if capture.value != "" then capture_failing_payload(e, compacted_msgs) else (); witness(session_id, trace_after_end, advance(capture.next_state, EnvRead)) } else { trace: trace_after_end, world: stepped.world }; -- PLAN-001 P2 Part 5(b): read from the step's successor, advanced and witnessed; `capt` (not `exchange.next_state`) feeds both arms below. On a retryable error it is exactly `trace_after_end`/`stepped.world`
                  if should_retry_stream_error(e.retryable, policy.step.retry_stream_errors, policy.step.step_budget - step_idx) then {
                    let retry_event = StreamErrorRetry({ step: step_idx, error: e.message });
                    let _ = ledger_emit(session_id, retry_event);
                    let trace_with_retry = ledger_append(capt.trace, WireRecord(retry_event));
                    let trace_with_delta = c2_journal(session_id, trace_with_retry,
                      [c2_state_delta_event(identity.run_id, step_idx, st.prior_counts, trace_with_retry, st.telemetry, chain.artifacts, artifacts_changed)]);
                    let next_state: C2LoopState = {
                      msgs: st.msgs,
	                      step_idx: step_idx + 1,
	                      totals: st.totals,
	                      ext_artifacts: chain.artifacts,
	                      telemetry: st.telemetry,
	                      provider: st.provider,
	                      world_state: capt.world,
                      pending_tool_calls: [],
                      pending_tool_context: [],
                      pending_tool_prefix: [],
                      pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
                      last_finish_reason: "stream_error",
                      last_response_text: e.message,
                      nudges_used: st.nudges_used,
                      finalize_source: "",
                      prior_counts: st.prior_counts,
                      -- A STEP END WITH NO MESSAGE. `st.msgs` is unchanged — the
                      -- provider never answered — so nothing is journaled as
                      -- history; `step_idx` advances and the trace has gained
                      -- this step's `ProviderCallPrepared`, which IS counted, so
                      -- the delta is what keeps the fold's `cumulative` equal to
                      -- a terminal arm's after a retried stream error.
                      trace: trace_with_delta,
                      emissions: emissions_after_call,
                      history_digest: st.history_digest,
                      open_waits: st.open_waits,
                      park_ordinal: st.park_ordinal,
                      park_attempt: st.park_attempt
                    };
                    c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
                  } else {
                    -- Terminal: unretried provider/stream failure. WI-D1 made this `exchange.next_state` rather than `st.world_state`; PLAN-001 P2 Part 5(b) makes it `capt.world`, the capture read's witnessed successor — plan rule S12, and the measurement is recorded at `ports.provider_outcome_record`. This edit is deliberately line-count-neutral (S18): the four routed clock anchors below it must not move.
                    c2_finalize(st.provider, capt.world, session_id, model, st.totals, step_idx, TermProviderFailure, e.message, started_at_ms, capt.trace, emissions_after_call, Err(e), c2_final_state(st))
                  }
                },
                Ok(result) => {
                  let n_calls = List.length(result.tool_calls);
                  let step_cost = step_cost_millicents(result.input_tokens, result.output_tokens, cost_rates);
                  let phase = phase_from_result(result, step_idx, n_calls, millicents_to_usd(step_cost), step_cost, estimate_tokens_messages(compacted_msgs));
                  let end_event = ThinkingStreamEnd({ step: step_idx, stream_id: stream_id, status: "completed" });
                  let _ = ledger_emit(session_id, end_event);
                  let _ = c2_emit_events(session_id, phase.events);
                  let new_warned_pct = c2_emit_cost_warning(session_id, step_idx, st.totals.cost_millicents + step_cost, max_cost_millicents, st.totals.cost_warned_pct);
                  let new_totals = c2_add_step_totals(st.totals, result, step_cost, new_warned_pct);
                  let applied = apply_state_delta(step_state, phase.delta);
                  let assistant_msg = step_result_to_message(result);
                  let msgs_with_assistant = st.msgs ++ [assistant_msg];
                  -- ABI 7.3. BUILT TWICE, and the first one is not waste. A
                  -- `WorkInFlight` render takes an `ExtCtx`, so there has to be
                  -- a context before there is an aggregate; the bootstrap
                  -- carries `[]` and the dispatcher re-empties it per atom, so
                  -- no declarer can read a half-built list whose contents would
                  -- depend on registry order.
                  --
                  -- DISPATCHED HERE AND NOWHERE ELSE, once per step. This is
                  -- the context `dispatch_solver_candidate` receives, which is
                  -- where the only consumer runs. The pre-step and tool-phase
                  -- contexts keep `[]` — not because the answer would be
                  -- uninteresting there, but because gathering it would put an
                  -- FS round-trip into three more dispatches per step to
                  -- answer a question nothing currently asks. Widening it later
                  -- is this same three-line shape at those sites.
                  let boot_ctx = mk_v2_ext_ctx(task, step_idx, model, workdir, env_url, hybrid_tools, budget, msgs_with_assistant, context_limit, result.finish_reason, [], wait_descriptors_json(st.open_waits), ext_ports_of(st.provider, st.world_state, policy.step.provider_base_url), chain.artifacts, applied.telemetry, world_to_token(stepped.world));
                  let work = dispatch_work_in_flight(rt, boot_ctx);
                  let post_ctx = mk_v2_ext_ctx(task, step_idx, model, workdir, env_url, hybrid_tools, budget, msgs_with_assistant, context_limit, result.finish_reason, work.items, wait_descriptors_json(st.open_waits), ext_ports_of(st.provider, st.world_state, policy.step.provider_base_url), chain.artifacts, applied.telemetry, work.next_state);
                  let trace_after_model = c2_trace_wire_events(ledger_append(trace_after_call, WireRecord(end_event)), phase.events);
                  -- WI-B2b. Bound rather than matched inline, because the
                  -- successor has to outlive the match: `intercepted.next_state`
                  -- is what the loop carries forward on EVERY arm, and
                  -- `exchange.next_state` is stale by what the hook performed.
                  let intercepted = dispatch_response_intercept(rt, post_ctx, result.message.content);
                  match intercepted.decision {
                    InterceptHandled(envelope) => {
                      let event = ExtInterceptHandled({
                        step: step_idx,
                        stream_id: "",
                        tool: envelope.tool,
                        id: "",
                        exit_code: envelope.exit_code
                      });
                      let _ = ledger_emit(session_id, event);
                      let tool_msg = envelope_to_tool_message(envelope);
                      -- ADR-003 D2's `:2907`, THE ONE SITE THAT IS TWO EVENTS.
                      -- The assistant and the tool message it was intercepted
                      -- into both enter the history here, and D1 is one message
                      -- per entry — a single event carrying both would make
                      -- `first_kept` an index into a sequence that no longer has
                      -- one entry per message.
                      let appended = c2_history_appended(identity.run_id, step_idx, st.history_digest, false, last_msg(msgs_with_assistant) ++ [tool_msg]);
                      let trace_with_history = c2_journal(session_id, ledger_append(trace_after_model, WireRecord(event)), appended.events);
                      let trace_with_delta = c2_journal(session_id, trace_with_history,
                        [c2_state_delta_event(identity.run_id, step_idx, st.prior_counts, trace_with_history, applied.telemetry, chain.artifacts, artifacts_changed)]);
                      let next_state: C2LoopState = {
                        msgs: msgs_with_assistant ++ [tool_msg],
	                        step_idx: step_idx + 1,
	                        totals: new_totals,
	                        ext_artifacts: chain.artifacts,
	                        telemetry: applied.telemetry,
	                        provider: st.provider,
	                        -- WI-B2b: the INTERCEPT's successor, not the model
	                        -- step's. The hook ran after the exchange, so
	                        -- `exchange.next_state` is stale by whatever it did.
	                        world_state: token_to_world(intercepted.next_state),
                        pending_tool_calls: [],
                        pending_tool_context: [],
                        pending_tool_prefix: [],
                        pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
                        last_finish_reason: "intercept_handled",
                        last_response_text: result.message.content,
                        nudges_used: applied.nudges_used,
                        finalize_source: "",
                        prior_counts: st.prior_counts,
                        trace: trace_with_delta,
                        emissions: emissions_after_call,
                        history_digest: appended.digest,
                        open_waits: st.open_waits,
                        park_ordinal: st.park_ordinal,
                        park_attempt: st.park_attempt
                      };
                      c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
                    },
                    NoIntercept => {
                      -- Execute tool calls whenever the model emitted any, not
                      -- only when finish_reason=="tool_calls". Some providers
                      -- (e.g. hy3:free/Novita) return tool_calls with a
                      -- different finish_reason; gating on the string alone
                      -- drops the call and runs the finalize/guard path, which
                      -- injects a nudge after an unanswered tool_call and ships
                      -- a malformed [assistant(tool_calls) -> user] payload the
                      -- provider then rejects (400 invalid_request_error).
                      if result.finish_reason == "tool_calls" || n_calls > 0 then {
                        -- ADR-003 D2's model-call assistant, the tool-calling
                        -- branch. THE ASSISTANT IS JOURNALED BEFORE THE TOOL
                        -- PHASE RUNS, which is what D4 rule 4's dangling-call
                        -- rule is written for: a crash here leaves an entry whose
                        -- `tool_calls` have no results, and the fold strips them
                        -- rather than refusing.
                        let appended = c2_history_appended(identity.run_id, step_idx, st.history_digest, false, last_msg(msgs_with_assistant));
                        let trace_with_history = c2_journal(session_id, trace_after_model, appended.events);
                        let trace_with_delta = c2_journal(session_id, trace_with_history,
                          [c2_state_delta_event(identity.run_id, step_idx, st.prior_counts, trace_with_history, applied.telemetry, chain.artifacts, artifacts_changed)]);
                        let next_state: C2LoopState = {
                          msgs: msgs_with_assistant,
	                          step_idx: step_idx + 1,
	                          totals: new_totals,
	                          ext_artifacts: chain.artifacts,
	                          telemetry: applied.telemetry,
	                          provider: st.provider,
	                          world_state: token_to_world(intercepted.next_state), -- WI-D19
                          pending_tool_calls: applied.pending_tool_calls,
                          pending_tool_context: msgs_with_assistant,
                          pending_tool_prefix: msgs_with_assistant,
                          pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
                          last_finish_reason: "tool_calls",
                          last_response_text: applied.last_response_text,
                          nudges_used: applied.nudges_used,
                          finalize_source: "",
                          prior_counts: st.prior_counts,
                          trace: trace_with_delta,
                          emissions: emissions_after_call,
                          history_digest: appended.digest,
                          open_waits: st.open_waits,
                          park_ordinal: st.park_ordinal,
                          park_attempt: st.park_attempt
                        };
                        c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
                      } else {
                        -- `session_emitted_native_tool_call` is the 2026-09-06
                        -- gate; see its declaration for the measurement. It reads
                        -- `msgs_with_assistant`, which includes THIS step's
                        -- assistant message — harmless, because this branch is
                        -- reached only when that message carried no calls.
                        let hybrid_attempt: Option[string] =
                          if hybrid_tools && session_emitted_native_tool_call(msgs_with_assistant) == false then
                            extract_bash(result.message.content)
                          else None;
                        match hybrid_attempt {
                          Some(cmd) => {
                            let event = HybridBashExtracted({ step: step_idx, cmd: cmd });
                            let _ = ledger_emit(session_id, event);
                            let synth_call = synthesize_hybrid_bash_call(cmd, step_idx);
                            let augmented_assistant_msg: Message = {
                              role: "assistant",
                              content: result.message.content,
                              tool_calls: [synth_call],
                              tool_call_id: "",
                              images: []
                            };
                            -- THE PLAIN ASSISTANT IS JOURNALED HERE, and the
                            -- augmented one is NOT: `msgs` carries the plain one
                            -- and `pending_tool_prefix` carries the augmented
                            -- one, and the batch finish replaces the first with
                            -- the second under `replaces_previous`. Journaling
                            -- the augmented message here instead would put a
                            -- synthesized tool call into the journal for a step
                            -- that may never reach the tool phase, and D4 rule
                            -- 4's "on the hybrid path the journaled assistant
                            -- carries no calls until `:2251` replaces it, so a
                            -- crash there strips nothing" would stop being true.
                            let appended = c2_history_appended(identity.run_id, step_idx, st.history_digest, false, last_msg(msgs_with_assistant));
                            let trace_with_history = c2_journal(session_id, ledger_append(trace_after_model, WireRecord(event)), appended.events);
                            let trace_with_delta = c2_journal(session_id, trace_with_history,
                              [c2_state_delta_event(identity.run_id, step_idx, st.prior_counts, trace_with_history, applied.telemetry, chain.artifacts, artifacts_changed)]);
                            let next_state: C2LoopState = {
                              msgs: msgs_with_assistant,
	                              step_idx: step_idx + 1,
	                              totals: new_totals,
	                              ext_artifacts: chain.artifacts,
	                              telemetry: applied.telemetry,
	                              provider: st.provider,
	                              world_state: token_to_world(intercepted.next_state), -- WI-D19
                              pending_tool_calls: [synth_call],
                              pending_tool_context: msgs_with_assistant,
                              pending_tool_prefix: st.msgs ++ [augmented_assistant_msg],
                              pending_tool_batched: false,
    accumulated_tool_msgs: [],
    pending_approval: None,
                              last_finish_reason: "hybrid_bash",
                              last_response_text: result.message.content,
                              nudges_used: applied.nudges_used,
                              finalize_source: "",
                              prior_counts: st.prior_counts,
                              trace: trace_with_delta,
                              emissions: emissions_after_call,
                              history_digest: appended.digest,
                              open_waits: st.open_waits,
                              park_ordinal: st.park_ordinal,
                              park_attempt: st.park_attempt
                            };
                            c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
                          },
                          None => {
                            -- WI-B2b. Bound, for the same reason the intercept
                            -- above is: every branch below carries the world
                            -- forward, and the solver hook's successor is the
                            -- current one from here on.
                            -- PLAN-002 W2 Part 4 (ADR-002 D2). ONE classification, in stage
                            -- order: DP7 before the completion policy for a non-blank
                            -- candidate. See `classify_candidate`.
                            let classified = classify_candidate(rt, { post_ctx | world: intercepted.next_state }, result.message.content, msgs_with_assistant, workdir, step_idx, session_id, policy.step.persist_retries, st.nudges_used, st.open_waits); -- WI-D19
                            match classified {
                              CandidateRejected(rejected) =>
                                c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, c2_dp7_rejected_state(session_id, identity, st, msgs_with_assistant, new_totals, chain.artifacts, applied.telemetry, rejected.world, trace_after_model, emissions_after_call, artifacts_changed, step_idx, rejected.rejection)),
                              CandidateApproved(approved) =>
                                c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, c2_dp7_approved_state(session_id, identity, st, msgs_with_assistant, new_totals, chain.artifacts, applied.telemetry, approved.world, trace_after_model, emissions_after_call, artifacts_changed, step_idx, approved.output, approved.source)),
                              CandidateAwaitWake(waiting) =>
                                c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, c2_await_wake_state(session_id, identity, st, msgs_with_assistant, new_totals, chain.artifacts, applied.telemetry, waiting.world, trace_after_model, emissions_after_call, artifacts_changed, step_idx, result.message.content)),
                              CandidateFeedback(fed) => {
                                let appended = c2_history_appended(identity.run_id, step_idx, st.history_digest, false, last_msg(msgs_with_assistant));
                                let trace_with_history = c2_journal(session_id, ledger_append(trace_after_model, WireRecord(fed.event)), appended.events);
                                let trace_with_delta = c2_journal(session_id, trace_with_history,
                                  [c2_state_delta_event(identity.run_id, step_idx, st.prior_counts, trace_with_history, applied.telemetry, chain.artifacts, artifacts_changed)]);
                                let next_state: C2LoopState = {
                                  msgs: msgs_with_assistant,
	                                  step_idx: step_idx + 1,
	                                  totals: new_totals,
	                                  ext_artifacts: chain.artifacts,
	                                  telemetry: applied.telemetry,
	                                  provider: st.provider,
	                                  world_state: fed.world,
                                  pending_tool_calls: [],
                                  pending_tool_context: [],
                                  pending_tool_prefix: [],
                                  pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
                                  last_finish_reason: "solver_feedback",
                                  last_response_text: fed.feedback,
                                  nudges_used: applied.nudges_used,
                                  finalize_source: "",
                                  prior_counts: st.prior_counts,
                                  trace: trace_with_delta,
                                  emissions: emissions_after_call,
                                  history_digest: appended.digest,
                                  open_waits: st.open_waits,
                                  park_ordinal: st.park_ordinal,
                                  park_attempt: st.park_attempt
                                };
                                c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
                              },
                              CandidateNudge(nudged) => {
                                let appended = c2_history_appended(identity.run_id, step_idx, st.history_digest, false, last_msg(msgs_with_assistant));
                                let trace_with_history = c2_journal(session_id, ledger_append(trace_after_model, WireRecord(nudged.event)), appended.events);
                                let trace_with_delta = c2_journal(session_id, trace_with_history,
                                  [c2_state_delta_event(identity.run_id, step_idx, st.prior_counts, trace_with_history, applied.telemetry, chain.artifacts, artifacts_changed)]);
                                let next_state: C2LoopState = {
                                  msgs: msgs_with_assistant,
	                                  step_idx: step_idx + 1,
	                                  totals: new_totals,
	                                  ext_artifacts: chain.artifacts,
	                                  telemetry: applied.telemetry,
	                                  provider: st.provider,
	                                  world_state: nudged.world,
                                  pending_tool_calls: [],
                                  pending_tool_context: [],
                                  pending_tool_prefix: [],
                                  pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
                                  last_finish_reason: "persist_nudge",
                                  last_response_text: result.message.content,
                                  nudges_used: st.nudges_used,
                                  finalize_source: "",
                                  prior_counts: st.prior_counts,
                                  trace: trace_with_delta,
                                  emissions: emissions_after_call,
                                  history_digest: appended.digest,
                                  open_waits: st.open_waits,
                                  park_ordinal: st.park_ordinal,
                                  park_attempt: st.park_attempt
                                };
                                c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, next_state)
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

func run_v2_from_messages_traced_with_policy(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_from_messages_traced_with_policy_and_counts(rt, task, env_url, hybrid_tools, budget, policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, provider, zero_runtime_status_counts())
}

func run_v2_from_messages_traced_with_policy_and_counts(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider,
  prior_counts: RuntimeStatusCounts
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_from_messages_traced_with_identity(rt, task, env_url, hybrid_tools, budget, policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, provider, prior_counts, None)
}

-- ADR-003 v6.1 D6: the two ways a traced run's loop state is seeded, as ONE
-- argument rather than as two half-used parameter sets. A run starts either
-- from a message list and a counts baseline (every path before P1 Part 5) or
-- from a suspended run's `Continuation` (the in-process resume). The variants
-- are exclusive, and a sum type is what says so — the alternative, an
-- `Option[Continuation]` beside a `history` and a `prior_counts` that the
-- resume path fills with copies of the continuation's own fields, is two
-- sources of truth for the same two values.
type C2MessageSeed = {
  history: [Message],
  prior_counts: RuntimeStatusCounts
}

type C2Seed = SeedMessages(C2MessageSeed) | SeedContinuation(Continuation) | SeedParked({ continuation: Continuation, open_waits: [WaitDescriptor] }) -- SeedParked: PLAN-003 P4 Part 3, `c2_state_from_parked` below the resume block

-- EVERYTHING AFTER THE CONSTRUCTOR, shared by both traced entries, and the
-- sharing is not tidiness: the prelude below holds one of this file's routed
-- core clock reads, and the `make anchors` D4 judgement is made by comparing
-- that exact set of call sites commit over commit. A resume entry that COPIED
-- the prelude instead of sharing it would add a site to that set and turn a
-- threading change into an attribution change.
--
-- WI-A12's clock class. Two of the four driver clock sites are here, both
-- BEFORE the loop starts, and both successors must reach the loop's world:
-- `started.next_state` is what the seed's constructor receives, not
-- `provider.world`. Taking the latter type-checks and silently discards both
-- reads, leaving the loop on an un-advanced clock.
func run_v2_traced_from_seed(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider,
  requested_identity: Option[RunIdentity],
  seed: C2Seed
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let derived = derive_session_id(provider.ports, provider.world);
  let started = provider.ports.clock_now(derived.next_state);
  let session_id = derived.id; let booted = witness(session_id, empty_ledger_trace(), advance(started.next_state, ClockRead)); let started_world = booted.world;
  let started_at_ms = started.now_ms;
  let identity = match requested_identity {
    Some(i) => i,
    None => default_run_identity(session_id)
  };
  let seeded = match seed {
    SeedMessages(m) => c2_initial_state_with_counts(m.history, provider, started_world, m.prior_counts),
    SeedContinuation(c) => c2_state_from_continuation(c, provider, started_world), SeedParked(s) => c2_state_from_parked(s, provider, started_world)
  };
  -- ADR-003 v6.1 D2: `HistorySeeded`, ONCE PER TRACED RUN, HERE — after the
  -- constructor and before `c2_loop`, so it is the FIRST journal-class record of
  -- every run's trace and the invariant that folds that trace has a seed to
  -- start from. The three arms D1 names are the same value from three sources
  -- and this line does not distinguish them: `[system, task]` for a fresh
  -- session, the loop's history for a follow-up turn, the folded history for a
  -- resumed run — all of them are `seeded.msgs`, and the host is where the three
  -- become three different entries.
  --
  -- IT CARRIES THE WHOLE STARTING HISTORY (PLAN-003 open question 3, decided
  -- "always carry"). The trace MUST hold the messages or the invariant has
  -- nothing to fold; carrying them on stdout as well is new pipe traffic of the
  -- same order the step's own provider payload already sends, and the host drops
  -- the event after one digest comparison. The env-gated digest-only variant is
  -- not this part's and is not needed by anything here.
  --
  -- `digest` IS THE CHAIN QUANTITY, not `digest_messages(history)`. P3 Part 2
  -- recorded the gap: D1's third arm compares it with the last history entry's
  -- `digest_after`, and a whole-list hash of another canonical form is not
  -- comparable with an incremental chain. Both are now `chain_digest_after`
  -- folded from `chain_empty_base()`. `digests` (P3 Part 4) is that fold's
  -- INTERMEDIATE values, one per message: the TypeScript host writes N of them
  -- into N entries and cannot recompute one without a second frame function.
  let seed_event = HistorySeeded({
    run_id: identity.run_id,
    messages: messages_json(seeded.msgs),
    digest: seeded.history_digest.at, digests: chain_digests_json(chain_digests_over(chain_empty_base(), seeded.msgs))
  });
  let _ = ledger_emit(session_id, seed_event);
  -- PLAN-001 P1 step 4: `ContextLimitResolved`, ONCE PER RUN, HERE — the shared
  -- per-run entry every live turn, follow-up turn, resume and traced entry
  -- reaches, so it is never a follow-up-only record (cF8). It reports the limit
  -- the run's policy CARRIES (stored by `session_policy_init` /
  -- `session_policy_with_model`); it performs no request, so no successor moves.
  -- Emitted AND appended, AFTER `HistorySeeded`, so the seed stays the first
  -- journal-class record and every existing record keeps its relative order.
  let limit_event = ContextLimitResolved({ run_id: identity.run_id, limit: policy.step.compaction.context_limit });
  let _ = ledger_emit(session_id, limit_event);
  let st = { seeded | trace: ledger_append(ledger_append({ records: booted.trace.records ++ seeded.trace.records }, WireRecord(seed_event)), WireRecord(limit_event)) };
  let session_span = "motoko.session.${session_id}";
  Trace.spanStart(session_span);
  let result = c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, st);
  Trace.spanEnd(session_span);
  result
}

-- ADR-003 v6.1 D6's resume, the ENTRY half: the sibling PLAN-003 P1 Part 5
-- names, beside `run_v2_from_messages_traced_with_identity` and sharing
-- everything after the constructor.
--
-- IT TAKES ITS RUN INPUTS FROM `c.boot` RATHER THAN FROM PARAMETERS, which is
-- what D1's `BootInputs` exists for: the task, the env url, the hybrid flag,
-- the ABI budget, `ohmy_pi`, the cost cap and the rates all crossed the
-- suspension inside the continuation, and re-supplying them from the
-- conversation loop would be a second source for values the journal will have
-- to reproduce byte-for-byte in P3. `model` likewise comes from `c` — D6's
-- `model_change` while suspended rewrites exactly that field.
--
-- WHAT IT DOES TAKE: `rt` (built per process, not a session value), `workdir`
-- (session-scoped, D1 puts it on the header and not on the continuation),
-- `provider` (a `Ports` is a bundle of closures; a resumed run opens its own),
-- `policy` (derived from the boot inputs and kept current by the loop's
-- `model_change` arm) and the `identity` D5 stamps the run with. The
-- identity is always `Some` here: a resumed run that fell back to the default
-- `r0.0` would be indistinguishable from the run it is resuming.
func run_v2_from_continuation_traced(
  rt: ExtRuntime,
  policy: SessionPolicy,
  workdir: string,
  provider: PortedProvider,
  identity: RunIdentity,
  c: Continuation
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_traced_from_seed(rt, continuation_task(c), c.boot.env_url, c.boot.hybrid_tools, c.boot.budget, policy, c.model, workdir, c.boot.ohmy_pi, c.boot.max_cost_millicents, c.boot.cost_rates, provider, Some(identity), SeedContinuation(c))
}

-- ADR-003 v6.1 D5's identity, arriving at the loop. THE SIBLING PLAN-003 §0.7
-- NAMES, and the reason it takes an `Option` rather than a `RunIdentity`: the
-- default identity is built from the run's OWN `session_id`, which
-- `derive_session_id` mints inside the shared worker above and no caller can
-- see. `None` therefore does not mean "no identity" — it means "the default
-- one, from this run's derived id", which is exactly §0.7's rule and what keeps
-- the twenty DST call sites of the three exported entries from moving.
--
-- P1 Part 5 IS the first `Some` caller: the conversation loop passes
-- `RunIdentity { session_id, run_id: "<session_id>.r<resume_count>.<ordinal>",
-- profile }` so every run of a session is attributable to the turn that
-- produced it. `derive_session_id` STAYS on both paths: the DST fixtures pin
-- the exact env-read set the policy init performs, and removing the derivation
-- would change it.
func run_v2_from_messages_traced_with_identity(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider,
  prior_counts: RuntimeStatusCounts,
  requested_identity: Option[RunIdentity]
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_traced_from_seed(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, provider, requested_identity, SeedMessages({ history: history, prior_counts: prior_counts }))
}

export func run_v2_session_traced(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  -- WI-A12: the provider is normalised FIRST so policy init can read the env
  -- through its ports instead of ambiently.
  let pp = ported_provider(rt, provider);
  let init = session_policy_init(pp.ports, pp.world, model, step_budget, max_cost_millicents, cost_rates);
  run_v2_from_messages_traced_with_policy(rt, task, env_url, hybrid_tools, budget, init.policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, { pp | world: init.next_state })
}

export func run_v2_session_traced_with_persist_retries(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  persist_retries: int,
  provider: StepProvider
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let pp = ported_provider(rt, provider);
  let init = session_policy_init(pp.ports, pp.world, model, step_budget, max_cost_millicents, cost_rates);
  let base = init.policy;
  let policy: SessionPolicy = {
    step: {
      step_budget: base.step.step_budget,
      max_cost_millicents: base.step.max_cost_millicents,
      cost_metered: base.step.cost_metered,
      persist_retries: persist_retries,
      retry_stream_errors: base.step.retry_stream_errors,
      require_system_prompt: base.step.require_system_prompt,
      model: base.step.model,
      provider_base_url: base.step.provider_base_url,
      checkpoint_enabled: base.step.checkpoint_enabled,
      checkpoint_pct: base.step.checkpoint_pct,
      compaction: base.step.compaction
    },
    headless: base.headless
  };
  run_v2_from_messages_traced_with_policy(rt, task, env_url, hybrid_tools, budget, policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, pp)
}

func run_v2_from_messages_with_policy(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_from_messages_with_policy_and_counts(rt, task, env_url, hybrid_tools, budget, policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, provider, zero_runtime_status_counts())
}

func run_v2_from_messages_with_policy_and_counts(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider,
  prior_counts: RuntimeStatusCounts
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  -- WI-A12's clock class. Two of the four driver clock sites are here, both
  -- BEFORE the loop starts, and both successors must reach the loop's world:
  -- `started.next_state` is what `c2_initial_state_with_counts` receives, not
  -- `provider.world`. Taking the latter type-checks and silently discards both
  -- reads, leaving the loop on an un-advanced clock.
  let derived = derive_session_id(provider.ports, provider.world);
  let started = provider.ports.clock_now(derived.next_state);
  let session_id = derived.id; let booted = witness(session_id, empty_ledger_trace(), advance(started.next_state, ClockRead)); let started_world = booted.world;
  let started_at_ms = started.now_ms;
  -- The untraced entry has no caller that can hold an identity — it discards
  -- the whole `TracedSessionResult` but its `.result` — so it takes the default
  -- unconditionally rather than an Option nothing would ever fill.
  let identity = default_run_identity(session_id);
  -- PLAN-001 P1 step 4, the one entry that does not reach
  -- `run_v2_traced_from_seed` (the untraced `run_v2`): the same one record.
  let limit_event = ContextLimitResolved({ run_id: identity.run_id, limit: policy.step.compaction.context_limit });
  let _ = ledger_emit(session_id, limit_event);
  let initial = c2_initial_state_with_counts(history, provider, started_world, prior_counts);
  let session_span = "motoko.session.${session_id}";
  Trace.spanStart(session_span);
  let result = c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, identity, started_at_ms, { initial | trace: ledger_append({ records: booted.trace.records ++ initial.trace.records }, WireRecord(limit_event)) }).result;
  Trace.spanEnd(session_span);
  result
}

-- ============================================================================
-- PLAN-001 P2 Part 2 (ADR-001 D2 part 2): THE ONE EFFECTFUL WITNESS.
--
-- `world_ordinal.advance` pushes a `RequestWitness` onto `pending` at every
-- helped leaf; this drains it. For each witness, HEAD FIRST (request order), it
-- EMITS `WorldRequest` on the wire and APPENDS the same event to the returned
-- trace, then clears `pending`. It lives here because `ledger_emit` is private
-- to this module and stays so.
--
-- THE ORDERING IS THE MECHANISM. It is called wherever a successor ARRIVES in
-- this file, before that successor enters any driver record:
--
--   * bootstrap: both entries, after the session id and the start clock, with
--     `empty_ledger_trace()`; the result's trace heads the seeded state's, so
--     `session_policy_init`'s and `derive_session_id`'s reads are witnessed too;
--   * `dispatch_step`'s exchange, at the `trace_after_call` junction (nothing
--     between the call and it is a record, and the wire already holds the deltas);
--   * the approval read, hoisted out of the `post` literal;
--   * `execute_allowed_tool_call` and both `dispatch_tool_entries_with_builtin`
--     outcomes (the `RunTools` arm);
--   * `c2_finalize`'s clock, before `RunSummary` (which stays last) and before
--     the terminal literal.
--
-- A world dropped AFTER its witness is what the frame gate (Part 3) sees as
-- `final` behind the last `world_request`; a world dropped BEFORE it is the
-- shape the wire cannot see, which is why no call site builds a record first.
--
-- NOT CALLED at the two production drops Part 5 owns (the provider-error env
-- read and the exit manifest's): both successors are still discarded, and
-- neither site holds a trace to return into until Part 5 reshapes them.
func witness(session_id: string, trace: LedgerTrace, w: WorldState) -> { trace: LedgerTrace, world: WorldState } ! {IO, Trace} {
  { trace: witness_drain(session_id, trace, w.pending), world: { w | pending: [] } }
}

func witness_drain(session_id: string, trace: LedgerTrace, pending: [RequestWitness]) -> LedgerTrace ! {IO, Trace} {
  match pending {
    [] => trace,
    r :: rest => {
      let e = WorldRequest({ ordinal: r.ordinal, request_class: request_class_id(r.request_class) });
      let _ = ledger_emit(session_id, e);
      witness_drain(session_id, ledger_append(trace, WireRecord(e)), rest)
    }
  }
}

export func run_v2(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  initial_msgs: [Msg],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let messages = msgs_to_messages(initial_msgs);
  let pp = ported_provider(rt, provider);
  let init = session_policy_init(pp.ports, pp.world, model, step_budget, max_cost_millicents, cost_rates);
  run_v2_from_messages_with_policy(rt, task, env_url, hybrid_tools, budget, init.policy, model, messages, workdir, ohmy_pi, max_cost_millicents, cost_rates, { pp | world: init.next_state })
}

-- Run loop_v2 starting from an existing [Message] history (instead of the
-- legacy [Msg] shape). Used by conversation_loop_v2 to resume after each
-- user_message arrives — preserves the assistant/tool history accumulated
-- across the prior task so the model retains context.
export func run_v2_from_messages(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let pp = ported_provider(rt, provider);
  let init = session_policy_init(pp.ports, pp.world, model, step_budget, max_cost_millicents, cost_rates);
  run_v2_from_messages_with_policy(rt, task, env_url, hybrid_tools, budget, init.policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, { pp | world: init.next_state })
}

-- Read a JSON-shaped string field from a decoded Json object, returning
-- "" when the key is absent or has the wrong type. Mirrors rpc.ail's
-- get_str helper (kept inline to avoid an import-time circular reference
-- between rpc.ail and agent_loop_v2.ail).
func msg_get_str(obj: Json, key: string) -> string {
  match get(obj, key) {
    None    => "",
    Some(j) => match asString(j) { None => "", Some(s) => s }
  }
}

-- M8 multi-turn driver: after a v2 task returns, drain stdin for the next
-- user command and resume. Mirrors rpc.ail's conversation_loop in command
-- handling (abort/exit/model_change/user_message) but operates on
-- [Message] history instead of [Msg] + AgentState.
--
-- Commands recognized:
--   abort | exit              → return () (TUI session ends)
--   model_change { model }    → update model, recurse with same history
--   user_message { content }  → append user msg, run_v2_from_messages,
--                                 recurse with returned [Message]
--   anything else (unparseable
--     or unknown type)        → discard line, recurse (matches legacy
--                                 conversation_loop fall-through)
--
-- EOF (readLine returns "") cleanly terminates the loop — the env-server
-- closes stdin when the user exits the TUI.
-- ADR-003 v6.1 D5's identity rule, both halves, and the ONLY definitions of
-- them: the conversation loop below calls these and so do the two pure unit
-- tests at the bottom of this file (P1 Part 1's `test_run_ordinal_rule`). One
-- definition read from both sides is what makes the test a test of the loop
-- rather than a restatement of an arithmetic fact.

-- The ordinal advances by ONE per traced run in this process, in both the `Ok`
-- and the `Err` arm of both outer loops. There is NO reset rule: v4.1's reset
-- keyed on a snapshot write, and P1 writes nothing (ADR-003 v6.1 D5, "no
-- write, no reset"). The `model_change`, `restart` and discard arms recurse
-- with the ordinal unchanged, because no run happened.
pure func next_run_ordinal(run_ordinal: int) -> int { run_ordinal + 1 }

-- The run id the next traced run is stamped with. `session_id` is the loop's
-- own derived id (`derive_session_id`) until P3 forwards the host-minted one;
-- `resume_count` is read ambiently from MOTOKO_RESUME_COUNT in
-- `rpc.run_with_config` (PLAN-003 §0.8 — NOT through `ports.env_get`, which
-- would be a new helped `EnvRead` and re-pin five DST fixtures) and is 0 for
-- every run before P3.
pure func run_id_for(session_id: string, resume_count: int, run_ordinal: int) -> string {
  "${session_id}.r${show(resume_count)}.${show(run_ordinal)}"
}

-- D5's identity, assembled where all three inputs are in scope: the loop.
pure func loop_run_identity(session_id: string, profile: string, resume_count: int, run_ordinal: int) -> RunIdentity {
  {
    session_id: session_id,
    run_id: run_id_for(session_id, resume_count, run_ordinal),
    profile: profile
  }
}

-- ============================================================================
-- PLAN-002 W5 (ADR-002 D4's framing and identity subset; D5 step 5).
--
-- (a) THE BETWEEN-TURN FRAME. Between one `user_message` run and the next, the
-- loop is not in a run, but it still makes requests: the exit manifest's
-- witnessed `env_read` (`publish_turn_exit_manifest`) runs AFTER turn N's run
-- has returned, i.e. after its `RunSummary`. Those requests live in a frame of
-- their own, and its rules are:
--   * it OPENS at turn N's `final` (`run_summary.world_ordinal`), because the
--     manifest is handed `traced.world` — the rule ADR-003 D5 uses for a
--     resumed frame and P3ORD implements on the resume path
--     (`BEGIN₂.ordinal₀ == END₁.final`). Its first request carries `final + 1`;
--   * it is SEPARATE from `done`/`RunSummary`: no record is appended to the
--     finished run's trace, so `RecordAfterTerminal` is not tripped;
--   * the cross-turn ordinal, and any between-turn `ParkEntered`/`WakeReceived`
--     (none today: the blocking read as a park is §3's, unscheduled), live in it;
--   * it has NO WIRE RECORD. `WORLD_RUN_BEGIN/END` are DST-script printlns; live
--     stdout shows the frame only as the `world_request`s after turn N's
--     `run_summary` and before turn N+1's `session_start` (R10's delimiter).
-- The NEXT turn opens at this frame's LAST ordinal, not at turn N's `final`:
-- that is (c), `next_turn_world` below.

-- (b) The between-turn request's id (§8.4, review change 21). A frame that is
-- not a run borrows the identity of the run the operator's input WILL open, so
-- its park is `<next run_id>.p0`, and a run opened by a consumed between-turn
-- wake starts at `initial_park_ordinal(true)` (its first in-turn park is `.p1`).
-- `next_ordinal` is the loop's `run_ordinal` parameter at the blocking read —
-- the value the `user_message` arm passes to `loop_run_identity` for the run
-- that input opens. W5 lands the function and gate 1's test ONLY: nothing calls
-- it until §3's "blocking read as a park". Every site that opens a run from a
-- consumed wake — P4's resumer and §3's in-process park, neither in W5 — applies
-- `{ st | park_ordinal: initial_park_ordinal(true) }` before the first decision.
pure func between_turn_request_id(session_id: string, profile: string, resume_count: int, next_ordinal: int) -> string {
  "${loop_run_identity(session_id, profile, resume_count, next_ordinal).run_id}.p0"
}

-- (c) THE WORLD THE NEXT TURN STARTS FROM, given the turn's traced result and
-- its published exit manifest: the manifest's successor, on every arm (`Ok`,
-- `Err`, suspended). NOT `traced.world` — that is turn N's `final`, and a next
-- turn opened there would re-issue the between-turn frame's ordinals — and NOT
-- the loop's entry `provider.world`, which restarted every turn from the world
-- the loop was entered with. The initial turn's drop
-- (`run_v2_with_conversation`) and `model_change`'s stay §3's. It takes no
-- traced result: the successor does not depend on the arm, so every arm is
-- covered by construction.
pure func next_turn_world(published: { world: WorldState, trace: LedgerTrace }) -> WorldState {
  published.world
}

-- D6's `model_change` while suspended: the switch rewrites the HELD
-- continuation's model, so the resume that follows runs under the model the
-- operator chose rather than the one the exhausted run was using. When nothing
-- is held this is the identity, which is why the loop's `model_change` arm has
-- one shape and not two.
pure func continuation_with_model(suspended: Option[Continuation], new_model: string) -> Option[Continuation] {
  match suspended {
    None => None,
    Some(c) => Some({ c | model: new_model })
  }
}

func conversation_loop_v2_with_policy(
  rt: ExtRuntime,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider,
  session_id: string,
  prior_counts: RuntimeStatusCounts,
  -- ADR-003 v6.1 D6, the in-process half. `suspended` is the continuation the
  -- last traced run carried out; while it is `Some` the loop is holding a live
  -- run's state between turns and the operator is NOT locked out — the whole
  -- point of D2's typed suspension.
  suspended: Option[Continuation],
  -- D5. The ordinal the NEXT traced run in this process will be stamped with.
  run_ordinal: int,
  -- The session's originating task. Threaded and not read in P1: it is D1's
  -- `header.boot.task` and the journal header P3 writes is its consumer. It is
  -- added HERE because Part 5 is the part that gives this loop its parameters,
  -- and adding it later would re-touch every recursion site below for a
  -- one-word change.
  task: string,
  -- The profile the session was invoked under (`cfg.profile`), D5's third
  -- identity field. A resume may switch it; in P1 it is constant for the
  -- process.
  profile: string,
  -- D5's `resume_count`, read ambiently in `rpc.run_with_config`. 0 for every
  -- run before P3's `--resume` exists.
  resume_count: int
) -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  -- Headless mode (M-MOTOKO-HEADLESS, 2026-05-08): skip the stdin-polling
  -- conversation loop entirely when MOTOKO_HEADLESS=1. The TS TUI layer
  -- (src/tui/src/index.ts) sets this env var when stdin is not a TTY
  -- (CLI subprocess, eval-harness adapter, MCP-mediated invocation) so
  -- the agent loop runs the initial task to completion and then exits 0
  -- instead of hanging on readLine() forever (the AILANG readLine builtin
  -- blocks on non-TTY stdin instead of returning EOF). This is the
  -- M-BENCH-MOTOKO Day-1 design that originally got skipped — restored
  -- after the AILANG eval-harness adapter smoke test surfaced the hang
  -- on 2026-05-08 (msg_20260508_102147_4f9aa71d).
  if policy.headless then ()
  else {
  -- NOT routed by WI-A12, deliberately. This read is the interactive
  -- conversation REPL asking for the next USER TURN — it is not approval input,
  -- and it sits ABOVE `run_v2_session_traced`, outside the traced driver surface
  -- D1 scopes `world_state` to. A deterministic run drives the traced entry
  -- point directly and never reaches this loop, which is why withholding a
  -- capability here changes nothing the poison pair observes. Routing the
  -- conversation turn belongs with whatever makes multi-turn sessions
  -- replayable, not with A12.
  let raw = readLine();
  if raw == "" then ()
  else match decode(raw) {
    Err(_) => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider, session_id, prior_counts, suspended, run_ordinal, task, profile, resume_count),
    Ok(obj) => {
      let cmd_type = msg_get_str(obj, "type");
      if cmd_type == "abort" || cmd_type == "exit" then ()
      else if cmd_type == "model_change" then {
        let new_model = msg_get_str(obj, "model");
        -- WI-D3. The ports are the loop's own `PortedProvider`, so the model
        -- switch resolves its new context limit through whatever seams this run
        -- bound rather than through an ambient read.
        --
        -- The SUCCESSOR IS DROPPED HERE, and that is the same decision the
        -- comment above this loop already records for the conversation channel:
        -- this loop threads no world at all, a deterministic run drives the
        -- traced entry point directly and never reaches it, and world-threading
        -- the multi-turn session belongs with whatever makes it replayable. The
        -- successor has nowhere to go until that exists — which is the thing
        -- that would have to change, not a property of this line.
        let switched = session_policy_with_model(provider.ports, provider.world, policy, new_model);
        let next_policy = switched.policy;
        -- ADR-003 D6: the HELD continuation's model is rewritten too, so a
        -- `continue` after a `/model` runs under the model the operator just
        -- chose. The run ordinal does NOT advance: no traced run happened.
        conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, next_policy, new_model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider, session_id, prior_counts, continuation_with_model(suspended, new_model), run_ordinal, task, profile, resume_count)
      }
      else if cmd_type == "restart" then {
        -- Emit session_suspend event and exit cleanly; TUI will respawn.
        -- ADR-003 D6: `restart` while suspended returns exactly as it does
        -- otherwise. The continuation dies with the process in P1 — carrying it
        -- across a respawn is the JOURNAL's job (D6's cross-process half, P3),
        -- and nothing in this process can hand it over.
        let target_profile = msg_get_str(obj, "profile");
        let _ = ledger_emit(session_id, SessionSuspend({
          session_id: session_id,
          target_profile: target_profile
        }));
        ()
      }
      else if cmd_type == "user_message" then {
        let content = msg_get_str(obj, "content");
        let user_msg: Message = {
          role: "user",
          content: content,
          tool_calls: [],
          tool_call_id: "",
          images: []
        };
        -- ADR-003 D1/D5: `run_started` names the run it opens. The identity is
        -- built BEFORE the banner rather than after it — same value, same
        -- arguments, one line earlier — so the event and the run it announces
        -- carry one `run_id` instead of two constructions that could drift.
        let identity = loop_run_identity(session_id, profile, resume_count, run_ordinal);
        let _ = ledger_emit(session_id, SessionStart({
          task: content,
          model: model,
          mode: "v2",
          run_id: identity.run_id
        }));
        -- ADR-003 D2's `:3409`: THE OPERATOR'S MESSAGE, one `HistoryAppended`,
        -- emitted by this loop. It is the one journal-class emit in this file
        -- that is NOT also appended, and that is not an omission — this loop
        -- holds no `LedgerTrace` at all. It sits above the traced driver surface,
        -- a deterministic run never reaches it (the traced entry is driven
        -- directly), and the wire gate that demands projected == appended reads
        -- the traced entry's trace, not this one.
        --
        -- WHY IT IS HERE AT ALL, given that the run's own `HistorySeeded` below
        -- carries this message inside its starting history: the two are D1's
        -- design, not a duplication. The host journals THIS as one entry and
        -- then meets the seed with arm 3 — compare the seed's `digest` with the
        -- last history entry's `digest_after`, both child-computed, and drop —
        -- which is a comparison that can only succeed because both are now the
        -- same chain quantity.
        --
        -- THE CHAIN IS RECOMPUTED FROM THE TURN'S HISTORY, and the exact
        -- condition under which that is right is stated rather than assumed: it
        -- is the journal's chain for every session whose journal holds no
        -- `history_replaced`. A checkpoint re-bases the chain to
        -- `chain_digest_base(prefix ++ summary)` (D4, and `journal.fold_replace`
        -- recomputes exactly that), and this loop cannot know that happened —
        -- `Continuation` and `FinalState` carry no chain field, so the run's
        -- `st.history_digest` dies with the run. The failure is CLOSED, not
        -- silent: a fold of such a journal refuses at this entry with
        -- `Digest(seq)` rather than resuming a history it cannot verify.
        -- CLOSING IT is a field on ADR-003 D1's `Continuation` and D4's
        -- `SessionState`/`FinalState`, which is an ADR-level widening and
        -- therefore the owner's call, not a part's; P3 Part 4 is where the host's
        -- writer meets it.
        let turn_history = match suspended { Some(c) => c.history, None => history };
        let _ = ledger_emit(session_id, HistoryAppended({
          run_id: identity.run_id,
          step: 0,
          message: message_json(user_msg),
          replaces_previous: false,
          digest_after: chain_digest_after(c2_seed_digest(turn_history).at, user_msg)
        }));
        -- ADR-003 v6.1 D6, THE RESUME. When a continuation is held, the
        -- operator's message is appended to ITS history — the exhausted run's,
        -- carried out of the suspension — and the run restarts from
        -- `c2_state_from_continuation`. When none is held this is the
        -- pre-ADR-003 path: append to the loop's `history` and start a fresh
        -- run from a message seed.
        --
        -- THE TWO ARMS DIFFER IN THEIR SEED AND IN NOTHING ELSE. Both stamp the
        -- run with D5's identity, both publish the turn's exit manifest, and
        -- both fold the run's counts into the loop's running total.
        let traced = match suspended {
          Some(c) => run_v2_from_continuation_traced(rt, policy, workdir, provider, identity, { c | history: c.history ++ [user_msg] }),
          None => run_v2_from_messages_traced_with_identity(rt, content, env_url, hybrid_tools, budget, policy, model, history ++ [user_msg], workdir, ohmy_pi, max_cost_millicents, cost_rates, provider, prior_counts, Some(identity))
        };
        -- PLAN-002 W5(a)/(c): the manifest's witnessed `env_read` opens the
        -- between-turn frame at `traced.world`'s ordinal (turn N's `final`), and
        -- its successor is KEPT: the next turn starts from it on all three
        -- recursions below (`next_turn_world`), so turn N+1 opens at the frame's
        -- last ordinal. The published trace is not kept: this loop holds no
        -- `LedgerTrace`, and the witness has already put the requests on the wire.
        let published = publish_turn_exit_manifest(rt, content, model, workdir, env_url, hybrid_tools, budget, provider.ports, session_id, traced.trace, traced.world);
        let next_provider = { provider | world: next_turn_world(published) };
        let next_counts = runtime_status_counts_add(prior_counts, runtime_status_counts(traced.trace));
        -- D5's rule: one traced run happened on BOTH arms below, so the ordinal
        -- advances on all three outcomes.
        let next_ordinal = next_run_ordinal(run_ordinal);
        -- ADR-003 v6.1 D2: `suspended` is matched BEFORE `result`. A
        -- suspension is an `Err` — it has to be, or thirty match sites and
        -- `outcome_agreement_findings` would need a third outcome class — so a
        -- loop that matched `result` first would emit an `error` for a run that
        -- did not fail, and the TUI would lock the operator out of the very
        -- turn the suspension exists to let them take.
        --
        -- NO HEADLESS CONDITIONAL HERE, unlike the initial-turn arm below: this
        -- loop returns immediately under `policy.headless` (the guard at its
        -- top), so a headless run never reaches this arm at all. A conditional
        -- would be a branch nothing can execute.
        match traced.suspended {
          -- The NEW continuation replaces the old one. `history` stays the
          -- loop's: while a continuation is held it is the authority on what
          -- the conversation contains, and copying its history back into the
          -- loop's parameter would make two homes for one fact.
          Some(next_c) => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, next_provider, session_id, next_counts, Some(next_c), next_ordinal, task, profile, resume_count),
          None =>
            match traced.result {
              -- The run completed, so the suspension is CONSUMED and the loop's
              -- history becomes the finished run's — which, on the resume arm,
              -- is the exhausted turn's messages plus everything the resumed
              -- run added. That is the repair, observable.
              Ok(updated_history) => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, updated_history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, next_provider, session_id, next_counts, None, next_ordinal, task, profile, resume_count),
              -- PLAN-002 W4 Part 5 (§8.7): a mid-park cancel is matched BEFORE the
              -- generic error. The run already recorded `WakeReceived(Aborted)`;
              -- the loop now takes today's exit for the command that cancelled
              -- it, and emits no `error`.
              Err(e) => if e.code == "ParkCancelled" then park_cancelled_exit(session_id, e.message) else {
                let _ = ledger_emit(session_id, ErrorEvent({
                  source: "agent_loop_v2",
                  code: e.code,
                  message: e.message
                }));
                conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, next_provider, session_id, next_counts, None, next_ordinal, task, profile, resume_count)
              }
            }
        }
      }
      else conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider, session_id, prior_counts, suspended, run_ordinal, task, profile, resume_count)
    }
  }
  }
}

-- PLAN-002 W4 Part 5, the table's last column (§8.7). A run ended by a mid-park
-- cancel carries the command in `e.message` (the `Aborted` wake's `wait_id`):
-- `abort`, `exit` and EOF (`eof`) return `()`, exactly as the between-turn
-- `abort`/`exit`/EOF reads do; `restart:<p>` emits `SessionSuspend { p }` and
-- returns, as the between-turn `restart` does. No `error` event on any row.
export func park_cancelled_exit(session_id: string, command: string) -> () ! {IO, Trace} {
  if startsWith(command, "restart:") then {
    let _ = ledger_emit(session_id, SessionSuspend({
      session_id: session_id,
      target_profile: substring(command, 8, Str.length(command))
    }));
    ()
  } else ()
}

-- ============================================================================
-- 7.0: the turn-end exit-manifest publish.
--
-- THE SEAM IS THE TURN, not the step and not the session. Per step would
-- re-render on every tool call for a list that only changes when a delegate is
-- spawned or closed; per session would never run at all, because a session
-- ends by the process dying. A turn is the coarsest boundary at which the
-- runtime is reliably still alive, and every intent this publishes was
-- computed from state that boundary can see.
--
-- CALLED FROM TWO PLACES, AND THE ORDERING IS WHY.
--
-- The load-bearing call is inside `c2_loop`'s success arm, immediately BEFORE
-- `ledger_emit(session_id, done_event)`. That position is not tidiness: the TUI
-- treats `done` as "the turn is over", drains its logger and calls
-- `process.exit`, WITHOUT waiting for this process. Publishing after `done` was
-- therefore two comparable few-millisecond paths with no ordering between them,
-- and it lost. MEASURED 2026-09-05 by injecting a 2s delay into
-- `publish_exit_manifest` and running a real headless delegation: the TUI
-- exited with `.motoko/exit/` still empty, the manifest landed a second later
-- naming exactly the right pane with the right proof, and the delegate survived
-- with HERDR_REAP_ON_EXIT=1. Two earlier live runs had passed; they won a race
-- rather than being safe. Emitting `done` only after this returns makes the
-- ordering a property instead of a timing assumption.
--
-- The turn-boundary calls are the BACKSTOP, and they stay because not every
-- terminal path emits `DoneEvent` -- an errored turn, an exhausted step budget
-- and a cost cap all finalize without one, and an errored turn is exactly the
-- one whose delegates are most likely to have been abandoned. Publishing twice
-- on the common path costs one render, one small write and one `mv` against a
-- turn that just made a model call; every publish rewrites the whole document,
-- so the second is idempotent rather than additive.
--
-- THE CTX CARRIES LIVE PORTS, and the first draft did not — which is the whole
-- reason this comment is long. `ExitIntent`'s row is `! {FS}` and its render
-- reads through `ExtPorts.file_read`, so `noop_ext_ports()` looked defensible
-- ("a render cannot reach a port it should not need") and was wrong in the one
-- way nothing caught: the no-op `file_read` answers `present: false` to every
-- path, so every render read an absent run file and published an empty action
-- list. Both sides were green — the gate injects a scripted `file_read`, and
-- the host dispatcher was handed hand-written manifests — and the seam between
-- them was dead. Found by running it live: a real delegate on a real pane,
-- a correct run file on disk, and `"actions": []` in the manifest.
--
-- `mode` says "exit" rather than "v2" so that anything reading the ctx knows
-- which boundary it is standing on, and the world is the provider's own cursor
-- rather than a fresh one, so the render's read descends from the run's state
-- instead of from nothing.
func publish_turn_exit_manifest(
  rt: ExtRuntime,
  task: string,
  model: string,
  cwd: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  ports: Ports,
  session_id: string,
  trace: LedgerTrace,
  -- THE TURN'S SUCCESSOR WORLD, not the provider's pre-turn one. `TracedSessionResult` carries
  -- `world` precisely so the state the turn produced can be handed on; passing `provider.world`
  -- rewinds the render to before the turn it is supposed to be summarising, which under scripted
  -- or recording ports means files written DURING the turn are invisible to it and replay cursors
  -- restart from stale state. Live ambient reads hide this by consulting the disk instead, and the
  -- extension fixture hides it by answering from canned content regardless of the world it is
  -- given — the same both-sides-mocked shape that hid the no-op ports bug.
  world: WorldState
) -> { world: WorldState, trace: LedgerTrace } ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace} {
  -- ROUTED, NOT AMBIENT. The manifest's name is read through `Ports.env_get`
  -- rather than `std/env`, because this now runs INSIDE the deterministic
  -- driver: `make world_state` rejects an un-routed env read on that path, and
  -- it is right to -- a replayed run must see the same name the recorded one
  -- did. The successor is threaded into the ctx the render receives.
  let named = ports.env_get(world, manifest_path_var(), ""); let named_world = advance(named.next_state, EnvRead);
  let seen = witness(session_id, trace, named_world);
  let ctx: ExtCtx = {
    task: task,
    step: 0,
    model: model,
    cwd: cwd,
    hybrid_tools: hybrid_tools,
    budget: budget,
    mode: "exit",
    workdir: cwd,
    env_server_url: env_url,
    budget_remaining: budget.total,
    history_slice: [],
    state_key: "core:ext:exit",
    finish_reason: "",
    work_in_flight: [],
    open_waits: ja([]),
    -- PLAN-001 P1 step 5: NO WINDOW IS SUPPLIED TO THE EXIT CONTEXT. This 0 is a
    -- literal, not a projection of the run's limit, and it is not `Disabled`.
    context_limit: 0,
    ports: ext_ports_of(ports, seen.world, env_url),
    artifacts: empty_ext_artifacts(),
    telemetry: zero_token_telemetry(),
    world: world_to_token(seen.world)
  };
  -- The result says whether the live file was replaced. Discarded on purpose:
  -- a manifest that could not be published leaves the previous one standing,
  -- and failing a completed turn over a best-effort courtesy would be the
  -- wrong trade in the one direction that matters.
  let rendered = publish_exit_manifest(rt, ctx, named.value);
  { world: token_to_world(rendered), trace: seen.trace }
}

export func conversation_loop_v2(
  rt: ExtRuntime,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider,
  session_id: string
) -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let live_provider = ported_provider(rt, provider);
  let init = session_policy_init(live_provider.ports, live_provider.world, model, step_budget, max_cost_millicents, cost_rates);
  -- This entry keeps its signature (it is re-exported by `agent_loop_v2` and
  -- driven by `scripts/smoke_v2_conversation.ail`), so it seeds the ADR-003 D5
  -- parameters with what a caller that knows nothing about a session means:
  -- nothing held, ordinal 0, no task, no profile, resume count 0. The live
  -- launcher does not come through here — `run_v2_with_conversation` below is
  -- the one `rpc.run_with_config` calls, and it has all five.
  conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, init.policy, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, { live_provider | world: init.next_state }, session_id, zero_runtime_status_counts(), None, 0, "", "", 0)
}

-- M8 combined entry point: runs the initial task via run_v2, then enters
-- conversation_loop_v2 for follow-up turns. On error from the initial run,
-- emits a structured error event and still enters conversation_loop_v2
-- with the original [Msg] history (translated) so the TUI session stays
-- responsive — matching the legacy behavior where run_with_config falls
-- through to conversation_loop after rpc_loop returns.
export func run_v2_with_conversation(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  initial_msgs: [Msg],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider,
  -- ADR-003 v6.1 D5, arriving from `rpc.run_with_config` one level up: the
  -- profile the session was invoked under (`cfg.profile`) and the host's
  -- `resume_count`, read there AMBIENTLY from MOTOKO_RESUME_COUNT on the
  -- `headless_mode()` pattern (PLAN-003 §0.8 — a `ports.env_get` here would be
  -- a new helped `EnvRead` and re-pin the five fixtures that name the policy
  -- init's exact key set). Both are 0/"" for every run before P3.
  profile: string,
  resume_count: int
) -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let initial_messages = msgs_to_messages(initial_msgs);
  let live_provider = ported_provider(rt, provider);
  let init = session_policy_init(live_provider.ports, live_provider.world, model, step_budget, max_cost_millicents, cost_rates);
  let policy = init.policy;
  let started_provider = { live_provider | world: init.next_state };
  -- Ordered after `ported_provider` because WI-A12 made `derive_session_id`
  -- read the world clock through the port instead of ambient `now()`, so it
  -- needs the normalised provider. The successor is discarded: this id labels
  -- the outer conversation loop, and each traced run below derives its own from
  -- its own world. That is pre-existing behaviour, not a cursor being dropped.
  let session_id = derive_session_id(started_provider.ports, started_provider.world).id;
  -- ADR-003 v6.1 D5. The FIRST traced run of the process is ordinal 0 — the
  -- path table's first row (`REVIEW-adr003-v4-verdicts-fable.md` §3, minus its
  -- write-dependent rows) — and the loop below is entered with the ordinal the
  -- NEXT run will take.
  let initial_ordinal = 0;
  -- An empty task means there is no opening turn to run. Go straight to the
  -- conversation loop rather than letting the empty task reach the provider as
  -- a real model call on an empty user message -- which is what `/restart` did
  -- before this guard existed.
  --
  -- The live launcher no longer reaches this branch: `rpc.run_with_config`
  -- waits in `await_first_task` for the first real task before it builds
  -- anything, precisely because the system prompt and the budget plan are both
  -- task-conditional and both built exactly once. This stays as the guard for
  -- direct callers (tests, harnesses) that hand an empty task straight in.
  if task == "" then
    conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, initial_messages, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, started_provider, session_id, zero_runtime_status_counts(), None, initial_ordinal, task, profile, resume_count)
  else {
  -- THE FIRST `Some` CALLER (PLAN-003 §0.7). It goes through
  -- `run_v2_from_messages_traced_with_identity` rather than
  -- `..._with_policy` because the default identity that arm would build is
  -- `<run's own derived id>.r0.0` with an empty profile — right for a DST
  -- fixture driving an exported entry, wrong for a live session, where
  -- `resume_count` may not be 0 and the id every event of this loop is stamped
  -- with is the loop's own.
  let initial_identity = loop_run_identity(session_id, profile, resume_count, initial_ordinal);
  -- PLAN-003 P3 Part 5, DECIDING P3 Part 4's first open item: `run_started.run_id`
  -- was EMPTY for a session's first run, because the only `session_start` that run
  -- ever produced was `rpc.ail`'s startup banner — emitted before a task exists,
  -- and on a pre-warm spawn before any run exists at all. Every FOLLOW-UP turn has
  -- always opened with a `SessionStart` carrying its `run_id` (the loop below), so
  -- the first run now does the same and the wire is uniform: every traced run of
  -- the conversation loop opens with the `SessionStart` that names it. The host
  -- journals a `run_started` only from a `session_start` that carries one, so the
  -- banner stops producing an entry for a run that may never happen.
  let _ = ledger_emit(session_id, SessionStart({
    task: task,
    model: model,
    mode: "v2",
    run_id: initial_identity.run_id
  }));
  let initial_traced = run_v2_from_messages_traced_with_identity(rt, task, env_url, hybrid_tools, budget, policy, model, initial_messages, workdir, ohmy_pi, max_cost_millicents, cost_rates, started_provider, zero_runtime_status_counts(), Some(initial_identity));
  let _ = publish_turn_exit_manifest(rt, task, model, workdir, env_url, hybrid_tools, budget, started_provider.ports, session_id, initial_traced.trace, initial_traced.world);
  let initial_counts = runtime_status_counts(initial_traced.trace);
  let next_ordinal = next_run_ordinal(initial_ordinal);
  -- ADR-003 v6.1 D2, and this is the arm that DOES need the headless
  -- conditional. Under `MOTOKO_HEADLESS=1` the conversation loop below returns
  -- without reading anything, so there is no operator to unlock. The plain and
  -- JSON loggers exit non-zero on `run_suspended` itself since P3 Part 6, but
  -- THIS EMIT STAYS: the eval harness (`benchmarks/motoko_rpc.py`) ends its
  -- drain on `error` and nothing else, so dropping it would classify a
  -- budget-exhausted benchmark run as neither done nor error (PLAN-003 §5).
  --
  -- The error is emitted AFTER `run_suspended` and after the RunSummary the
  -- traced run already wrote, so the headless wire order is `run_suspended`,
  -- `run_summary`, `error` — a compatibility surface now, not a stopgap: keep
  -- it until every `terminal_event == "error"` consumer reads `run_suspended`.
  match initial_traced.suspended {
    Some(c) => {
      let _ = if policy.headless then
        ledger_emit(session_id, ErrorEvent({
          source: "agent_loop_v2",
          code: "StepBudgetExhausted",
          message: "step budget exhausted"
        }))
      else ();
      -- `live_provider`, byte-for-byte what the `Err` arm below passes today.
      -- This arm used to BE that arm; the only thing P1 Part 4 changed about it
      -- is the error emit, and swapping the provider here would be an unrelated
      -- fix hiding inside a decision's commit.
      --
      -- P1 Part 5: the loop now HOLDS `c`. The operator's next `user_message`
      -- appends to the exhausted run's history and resumes from it, which is
      -- the whole of ADR-003 D6's in-process half.
      conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, initial_messages, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, live_provider, session_id, initial_counts, Some(c), next_ordinal, task, profile, resume_count)
    },
    None =>
      match initial_traced.result {
        Ok(final_history) => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, final_history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, started_provider, session_id, initial_counts, None, next_ordinal, task, profile, resume_count),
        -- PLAN-002 W4 Part 5 (§8.7): as in the loop's `user_message` arm.
        Err(e) => if e.code == "ParkCancelled" then park_cancelled_exit(session_id, e.message) else {
          let _ = ledger_emit(session_id, ErrorEvent({
            source: "agent_loop_v2",
            code: e.code,
            message: e.message
          }));
          conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, initial_messages, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, live_provider, session_id, initial_counts, None, next_ordinal, task, profile, resume_count)
        }
      }
  }
  }
}


-- ============================================================================
-- ADR-003 v6.1 D6, THE CROSS-PROCESS RESUME'S SESSION HALF (PLAN-003 P3 Part 5).
--
-- `rpc.run_with_config` has read the journal (ambient `readFile`, §0.8), folded
-- it, built the runtime for the invoked profile and `journal.plan_resume` has
-- decided. What is left is D6 step 5: emit `SessionResumed`, then enter the
-- conversation loop — holding the continuation when the boundary was
-- `Suspended`, between turns with the folded history otherwise. There is no
-- `await_first_task`: the loop's own `readLine` is the wait, exactly as the
-- empty-task path's.
--
-- BELOW EVERY ANCHOR ON PURPOSE (`make anchors` pins five routed clock sites, the
-- last at the traced entry's prelude); nothing above this block moves a line.
-- ============================================================================

-- THE LIVE ENTRY. Two wire records and one display line, in this order, and the
-- order is the point:
--
--   1. `SessionResumed` — D5: "emitted first by the resumed child". The host's
--      `resumed` entry, plus a `settings` entry on a switch.
--   2. `HistorySeeded` carrying the RESUMED history — the resume seed. PLAN-003
--      puts this on "the resumed run's" seed; it is emitted HERE, before the loop,
--      and that is drift with a reason that cannot be argued around: the loop's
--      first act on the operator's message is its own `HistoryAppended`
--      (`:3409`'s site), which the host journals BEFORE the traced run's seed ever
--      arrives. After a profile switch that append's `digest_after` chains from
--      the NEW head, so a replacement written only when the run's seed arrived
--      would follow an entry the fold must refuse. Seeding here puts D1's second
--      arm (`history_replaced`, re-basing the chain) ahead of every entry that
--      depends on it. On a same-profile resume the same seed meets D1's THIRD arm
--      and is a host-side check, before the operator types anything, that the
--      child's resumed chain continues the journal's. The traced run's own seed
--      then meets arm 3 as every follow-up turn's does.
--   3. `session_resume_view` — not journal-class, no messages: the marker line the
--      TUI prints under the resume seed's history (`journal.resume_view_json`).
--
-- The seed's `run_id` is the identity the resumed process's FIRST traced run
-- will carry (`r<resume_count>.0`), so the entries it produces are attributed to
-- the run that continues them.
export func run_v2_resume_with_conversation(
  rt: ExtRuntime,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  plan: ResumePlan,
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider,
  profile: string,
  resume_count: int
) -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let live_provider = ported_provider(rt, provider);
  let init = session_policy_init(live_provider.ports, live_provider.world, plan.model, step_budget, max_cost_millicents, cost_rates);
  let started_provider = { live_provider | world: init.next_state };
  let session_id = derive_session_id(started_provider.ports, started_provider.world).id;
  let initial_ordinal = 0;
  let identity = loop_run_identity(session_id, profile, resume_count, initial_ordinal);
  let _ = ledger_emit(session_id, SessionResumed(plan.info));
  let _ = ledger_emit(session_id, HistorySeeded({
    run_id: identity.run_id,
    messages: messages_json(plan.history),
    digest: c2_seed_digest(plan.history).at,
    digests: chain_digests_json(chain_digests_over(chain_empty_base(), plan.history))
  }));
  let _ = emit_json(resume_view_json(plan));
  -- `prior_counts` is the folded `cumulative` on BOTH arms, which is the judging
  -- number crossing the process boundary: the held continuation carries it as
  -- its own `cumulative` too, and the between-turns arm seeds the next run's
  -- `prior_counts` with it, so the step count continues either way.
  match plan.last {
    -- ADR-003 v6.1 D7 (PLAN-003 P4 Part 3, P4-Q2 option (a)): a journal that
    -- ends in a park is consumed FIRST, in this frame, before any run — the
    -- block below the harness entry says how. The seed above already carried
    -- the folded history; the wake message and the run's own seed follow it on
    -- the operator message's pattern.
    BoundaryParked(p, answered) => {
      let consumed = consume_parked_wake(session_id, profile, resume_count, initial_ordinal, started_provider.ports, started_provider.world, p, answered, empty_ledger_trace());
      let woken = { started_provider | world: consumed.world };
      match consumed.wake {
        -- A dropped reply: between turns with the folded history, the re-issued
        -- park journaled and open for the next resume to re-observe. No
        -- re-issue loop — no step budget exists outside a run to bound one.
        None => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, init.policy, plan.model, plan.history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, woken, session_id, plan.cumulative, None, initial_ordinal, plan.boot.task, profile, resume_count),
        Some(wake) => match wake.outcome {
          -- `Aborted` opens no run: the park was cancelled, the journal closed
          -- it (`open:wake:aborted`), and the host is idle between turns. No
          -- traced run happened, so the ordinal does not advance (D5).
          Aborted => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, init.policy, plan.model, plan.history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, woken, session_id, plan.cumulative, None, initial_ordinal, plan.boot.task, profile, resume_count),
          -- Every other outcome opens the run, and what follows it is the
          -- `user_message` arm's tail: the exit manifest, the next world, the
          -- counts, the ordinal, and `suspended` matched before `result`.
          _ => {
            let traced = run_v2_from_parked_traced(rt, init.policy, workdir, woken, identity, plan, p.waits, wake, consumed.trace, consumed.emissions);
            let published = publish_turn_exit_manifest(rt, plan.boot.task, plan.model, workdir, env_url, hybrid_tools, budget, woken.ports, session_id, traced.trace, traced.world);
            let next_provider = { woken | world: next_turn_world(published) };
            let next_counts = runtime_status_counts_add(plan.cumulative, runtime_status_counts(traced.trace));
            let next_ordinal = next_run_ordinal(initial_ordinal);
            match traced.suspended {
              Some(c) => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, init.policy, plan.model, plan.history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, next_provider, session_id, next_counts, Some(c), next_ordinal, plan.boot.task, profile, resume_count),
              None =>
                match traced.result {
                  Ok(updated_history) => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, init.policy, plan.model, updated_history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, next_provider, session_id, next_counts, None, next_ordinal, plan.boot.task, profile, resume_count),
                  Err(e) => if e.code == "ParkCancelled" then park_cancelled_exit(session_id, e.message) else {
                    let _ = ledger_emit(session_id, ErrorEvent({
                      source: "agent_loop_v2",
                      code: e.code,
                      message: e.message
                    }));
                    conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, init.policy, plan.model, plan.history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, next_provider, session_id, next_counts, None, next_ordinal, plan.boot.task, profile, resume_count)
                  }
                }
            }
          }
        }
      }
    },
    _ => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, init.policy, plan.model, plan.history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, started_provider, session_id, plan.cumulative, plan.suspended, initial_ordinal, plan.boot.task, profile, resume_count)
  }
}

-- THE HARNESS ENTRY, for `scripts/dst/journal_resume_dst.ail`: one traced run
-- resumed from a continuation through `c2_state_from_continuation` (via
-- `run_v2_from_continuation_traced`, unchanged), with `SessionResumed` emitted and
-- APPENDED as the first record of the resumed frame (D5), ahead of the frame's
-- `HistorySeeded`. The live path above cannot append it — the conversation loop
-- holds no trace, the same reason its operator `HistoryAppended` is emitted and
-- not appended — so this entry is where the variant reaches a returned trace and
-- leaves D6.4's gap register.
--
-- A NEW EXPORT, not a changed one (§0.7): the policy is initialised exactly as
-- `run_v2_session_traced` does it, from the continuation's own model and boot.
export func run_v2_session_resumed_traced(
  rt: ExtRuntime,
  workdir: string,
  step_budget: int,
  provider: StepProvider,
  identity: RunIdentity,
  resumed: SessionResumedInfo,
  c: Continuation
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let pp = ported_provider(rt, provider);
  let init = session_policy_init(pp.ports, pp.world, c.model, step_budget, c.boot.max_cost_millicents, c.boot.cost_rates);
  let opening = SessionResumed(resumed);
  let _ = ledger_emit(identity.session_id, opening);
  let r = run_v2_from_continuation_traced(rt, init.policy, workdir, { pp | world: init.next_state }, identity, c);
  { r | trace: { records: WireRecord(opening) :: r.trace.records }, emissions: opening :: r.emissions }
}

-- ============================================================================
-- ADR-003 v6.1 D7, THE RESUMER (PLAN-003 P4 Part 3; P4-Q2 option (a)).
--
-- A journal whose fold ends in `Parked(p, wake?)` is resumed by consuming the
-- park BEFORE any run opens, in the resumed frame — PLAN-002 §8.4, R9 and
-- W5(b), the site those rules were written for:
--
--   1. THE RE-ISSUED REQUEST `<R'>.p0`: `between_turn_request_id(session_id,
--      profile, resume_count, run_ordinal)`, which is the identity the resumed
--      frame's first run WILL carry plus `.p0` (`loop_run_identity` over the
--      same four inputs, W5's test pins the pairing), so the request and the run
--      it opens are one construction. `step` 0, `attempt` 0, the park's own
--      `waits`.
--   2. THE CURSOR. With a `wake` child, ONE observation goes to the head of
--      `WorldState.wakes`: the child's `wait_id` and outcome, its `request_id`
--      rewritten to `<R'>.p0` and nothing else. Without one, nothing is seeded:
--      the live read (Part 2) asks the host, whose waiter performs ADR-002 D2's
--      initial read — the re-observation — and a gone pane wakes `Lost`. In DST
--      the world's own cursor plays the host, and an empty one falls through to
--      `wake_read_unbound`'s `HostError`, waits kept.
--   3. THE CONSUMPTION: `ParkEntered(req)` — the RESUMED frame's; the prior
--      frame journaled its own `park` — then the one `.wake_read(` call outside
--      `c2_loop`, its successor witnessed into this frame, and `wake_matches`
--      exactly as the `Park` arm checks it. A dropped reply is
--      `park_drop_warning` and the loop is entered between turns with the
--      folded history; there is no re-issue loop here, because no step budget
--      exists outside a run to bound one. A match is `WakeReceived`.
--   4. THE RUN. `Aborted` opens none: the host is idle, between turns. Any other
--      outcome opens one from the folded history plus `wake_message`, emitted
--      as `HistoryAppended` on the operator message's pattern, with
--      `SessionStart(R')` FIRST — so `run_started` follows the consumed wake in
--      the journal, which is D7's exactly-once order: the fold offers no wake
--      that a `run_started` follows. The run's state is
--      `c2_state_from_continuation`'s plus the three fields W5(b) names:
--      `open_waits: apply_wake(p.waits, wake)`, `park_ordinal:
--      initial_park_ordinal(true)` — its own parks begin at `.p1` — and
--      `last_finish_reason: "user_injected"`, the `Park` arm's own route to the
--      model call.
--
-- Two callers share every step: the live entry above and the harness entry
-- `run_v2_session_park_resumed_traced`, which is where the frame reaches a
-- returned trace (§0.6) — the live path holds no `LedgerTrace`, as its operator
-- `HistoryAppended` does not, and discards the one it threads.
-- ============================================================================

-- What consuming `<R'>.p0` produced, before any run opens. `wake` is `None`
-- when the reply was dropped; `trace` holds the resumed frame's `ParkEntered`,
-- the witness and (on a match) `WakeReceived`, appended in emit order, over the
-- trace the caller handed in; `emissions` are the same events for
-- `TracedSessionResult.emissions`, on `run_v2_session_resumed_traced`'s pattern.
type ParkedConsumed = {
  request: ParkRequest,
  wake: Option[WakeInput],
  trace: LedgerTrace,
  emissions: [LedgerEvent],
  world: WorldState
}

-- Step 2. The rewritten observation goes at the HEAD of the cursor: a live
-- world's cursor is empty, so there this is `{ world | wakes: [obs] }` as the
-- plan writes it, and a DST world keeps the observations it holds for the
-- resumed run's own parks. `wake_outcome_of` is total over the six ids the fold
-- accepted (`journal.wake_of_entry` refuses any other at `outcome`), so its
-- `None` arm is unreachable past the fold; it seeds nothing — the
-- re-observation path — never a fabricated outcome.
pure func parked_cursor(world: WorldState, request_id: string, answered: Option[WakeEntry]) -> WorldState {
  match answered {
    None => world,
    Some(w) => match wake_outcome_of(w.outcome, w.detail) {
      None => world,
      Some(outcome) => {
        let seeded: WakeObservation = { request_id: request_id, wait_id: w.wait_id, outcome: outcome };
        { world | wakes: seeded :: world.wakes }
      }
    }
  }
}

-- Steps 1 and 3. The request is built from the four identity inputs, and the
-- run that consumes it is stamped with `loop_run_identity` over the same four,
-- which is what keeps `<R'>.p0` and `R'` one construction (W5(b)).
--
-- THE SECOND WITNESSED `.wake_read(` SITE (P4-Q2's accepted cost): the port
-- advances the world (`cursor_wake` / `wake_read_unbound` / the live await),
-- the caller owes the witness, and the successor enters no record before it —
-- `make driver_leaf_inventory` reads this leaf as `ports.wake_read`, clean, and
-- its self-test's tree mutant removes the witness on the line below.
func consume_parked_wake(
  session_id: string,
  profile: string,
  resume_count: int,
  run_ordinal: int,
  ports: Ports,
  world: WorldState,
  p: ParkEntry,
  answered: Option[WakeEntry],
  trace: LedgerTrace
) -> ParkedConsumed ! {IO, Trace} {
  let req: ParkRequest = { request_id: between_turn_request_id(session_id, profile, resume_count, run_ordinal), step: 0, waits: p.waits, attempt: 0 };
  let seeded = parked_cursor(world, req.request_id, answered);
  let entered = ParkEntered({ request_id: req.request_id, step: req.step, waits: req.waits });
  let _ = ledger_emit(session_id, entered);
  let trace_entered = ledger_append(trace, WireRecord(entered));
  let reply = ports.wake_read(seeded, req);
  let observed = witness(session_id, trace_entered, reply.next_state);
  if not wake_matches(req, reply) then {
    let _ = emit_json(park_drop_warning(req, reply));
    { request: req, wake: None, trace: observed.trace, emissions: [entered], world: observed.world }
  } else {
    let received = WakeReceived({ request_id: reply.request_id, wait_id: reply.wait_id, outcome: wake_outcome_id(reply.outcome), detail: wake_outcome_detail(reply.outcome) });
    let _ = ledger_emit(session_id, received);
    { request: req, wake: Some(reply), trace: ledger_append(observed.trace, WireRecord(received)), emissions: [entered, received], world: observed.world }
  }
}

-- Step 4's constructor: `c2_state_from_continuation` plus the three fields
-- W5(b) names for a run opened by a consumed between-turn wake. A seed of its
-- own because `Continuation` carries no waits (ADR-003 D1), and applied HERE —
-- inside `run_v2_traced_from_seed`, before `c2_loop`'s first decision — which is
-- where §8.4 says the resumer applies it.
pure func c2_state_from_parked(seed: { continuation: Continuation, open_waits: [WaitDescriptor] }, provider: PortedProvider, world: WorldState) -> C2LoopState {
  { c2_state_from_continuation(seed.continuation, provider, world) |
    open_waits: seed.open_waits,
    park_ordinal: initial_park_ordinal(true),
    last_finish_reason: "user_injected" }
}

-- The traced sibling of `run_v2_from_continuation_traced` for a run opened by
-- a consumed wake (step 4). `provider.world` is the witnessed successor of the
-- wake read. Before the run: `SessionStart(R')` — the `run_started` that the
-- `user_message` arm emits for every other run of the conversation loop and
-- nothing else would emit here — then the wake message as `HistoryAppended`,
-- chained from the folded history. Both are appended AND emitted, so the
-- returned trace's journal is the host's: `…, park, wake, run_started,
-- history_appended, …`. The run's own `HistorySeeded` then carries the same
-- history and meets D1's third arm at the host (compare and drop).
func run_v2_from_parked_traced(
  rt: ExtRuntime,
  policy: SessionPolicy,
  workdir: string,
  provider: PortedProvider,
  identity: RunIdentity,
  plan: ResumePlan,
  waits: [WaitDescriptor],
  wake: WakeInput,
  trace: LedgerTrace,
  emissions: [LedgerEvent]
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let wake_msg = wake_message(wake);
  let started = SessionStart({ task: plan.boot.task, model: plan.model, mode: "v2", run_id: identity.run_id });
  let _ = ledger_emit(identity.session_id, started);
  let appended = c2_history_appended(identity.run_id, 0, c2_seed_digest(plan.history), false, [wake_msg]);
  let prefix = c2_journal(identity.session_id, ledger_append(trace, WireRecord(started)), appended.events);
  let c: Continuation = {
    history: plan.history ++ [wake_msg],
    step_idx: 0,
    cumulative: plan.cumulative,
    telemetry: plan.telemetry,
    ext_artifacts: plan.ext_artifacts,
    -- RE-DERIVED, as `plan_resume` re-derives it for a suspended boundary: the
    -- journal carries no nudge count.
    nudges_used: count_persist_nudges(plan.history),
    model: plan.model,
    profile: plan.profile,
    boot: plan.boot
  };
  let r = run_v2_traced_from_seed(rt, continuation_task(c), c.boot.env_url, c.boot.hybrid_tools, c.boot.budget, policy, c.model, workdir, c.boot.ohmy_pi, c.boot.max_cost_millicents, c.boot.cost_rates, provider, Some(identity), SeedParked({ continuation: c, open_waits: apply_wake(waits, wake) }));
  { r | trace: { records: prefix.records ++ r.trace.records }, emissions: (emissions ++ (started :: appended.events)) ++ r.emissions }
}

-- The no-run result: the resumed frame alone — `Ok` on the folded history, no
-- continuation, `final` the folded state — which is what "between turns with
-- the folded history" is as a returned value.
pure func parked_frame_only(plan: ResumePlan, trace: LedgerTrace, emissions: [LedgerEvent], world: WorldState) -> TracedSessionResult {
  {
    result: Ok(plan.history),
    trace: trace,
    world: world,
    emissions: emissions,
    suspended: None,
    final: { history: plan.history, cumulative: plan.cumulative, telemetry: plan.telemetry, ext_artifacts: plan.ext_artifacts }
  }
}

-- THE HARNESS ENTRY (§0.7, a new export), for `scripts/dst/park_resume_dst.ail`:
-- steps 1–4 over a `ResumePlan`, with `SessionResumed` first (D5) and the
-- frame's records — `ParkEntered`, the witness, `WakeReceived`, then
-- `SessionStart(R')` and the wake message when a run opens — prepended to the
-- run's trace. Beside `run_v2_session_resumed_traced` and on its pattern, with
-- one difference stated: it takes the SESSION ID and not a `RunIdentity`,
-- because `<R'>.p0` and the run's `run_id` must be one construction (W5(b)),
-- so both are built here from `(session_id, plan.profile,
-- plan.info.resume_count, 0)`. A `last` that is not `Parked` is the frame alone,
-- as the live entry enters the loop between turns for it.
export func run_v2_session_park_resumed_traced(
  rt: ExtRuntime,
  workdir: string,
  step_budget: int,
  provider: StepProvider,
  session_id: string,
  plan: ResumePlan
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let pp = ported_provider(rt, provider);
  let init = session_policy_init(pp.ports, pp.world, plan.model, step_budget, plan.boot.max_cost_millicents, plan.boot.cost_rates);
  let started: PortedProvider = { pp | world: init.next_state };
  let initial_ordinal = 0;
  let identity = loop_run_identity(session_id, plan.profile, plan.info.resume_count, initial_ordinal);
  let opening = SessionResumed(plan.info);
  let _ = ledger_emit(session_id, opening);
  let trace0 = ledger_append(empty_ledger_trace(), WireRecord(opening));
  match plan.last {
    BoundaryParked(p, answered) => {
      let consumed = consume_parked_wake(session_id, plan.profile, plan.info.resume_count, initial_ordinal, started.ports, started.world, p, answered, trace0);
      let woken: PortedProvider = { started | world: consumed.world };
      match consumed.wake {
        None => parked_frame_only(plan, consumed.trace, opening :: consumed.emissions, consumed.world),
        Some(wake) => match wake.outcome {
          Aborted => parked_frame_only(plan, consumed.trace, opening :: consumed.emissions, consumed.world),
          _ => run_v2_from_parked_traced(rt, init.policy, workdir, woken, identity, plan, p.waits, wake, consumed.trace, opening :: consumed.emissions)
        }
      }
    },
    _ => parked_frame_only(plan, trace0, [opening], started.world)
  }
}

-- Run loop_v2 with a scripted provider. No real LLM call made.
-- Intended for integration tests only; not exported from rpc.ail.
export func run_v2_with_stub(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  script: [ScriptedStep]
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_from_messages(rt, task, env_url, hybrid_tools, budget, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, Scripted(script))
}

-- Phase C compatibility adapter. WI-C6 moves the parity fleet to
-- scripted-port imports; keep this entry for external callers until they are
-- audited.
export func run_v2_with_stub_port_adapter(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  script: [ScriptedStep]
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_with_stub(rt, task, env_url, hybrid_tools, budget, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, script)
}

-- M-MOTOKO-EVAL-INSTRUMENTATION inline tests (pure-only). Validates the
-- schema-v1 contract surface that downstream eval harnesses depend on.

pure func test_schema_version_is_one() -> bool
  tests [((), true)]
  {
    schema_version() == "1"
  }

pure func test_millicents_to_usd_zero() -> bool
  tests [((), true)]
  {
    millicents_to_usd(0) == 0.0
  }

pure func test_millicents_to_usd_one_dollar() -> bool
  tests [((), true)]
  {
    millicents_to_usd(100000) == 1.0
  }

pure func test_millicents_to_usd_fraction() -> bool
  tests [((), true)]
  {
    -- 12345678 millicents = $123.45678
    millicents_to_usd(12345678) == 123.45678
  }

-- Replaces test_finish_reason_str_table. The integer helper is gone, so the
-- table is pinned over the typed reason instead. The wire strings are a
-- compatibility surface and must not change: every string on the right here is
-- byte-identical to what the integer table produced for the code that reached
-- that path. "dp7_rejected" is absent because no call site ever produced it.
pure func test_finish_reason_wire_table() -> bool
  tests [((), true)]
  {
    finish_reason_wire(TermSuccess) == "stop"
      && finish_reason_wire(TermBudgetExhausted) == "cost_exhausted"
      && finish_reason_wire(TermCompactionExhausted) == "compaction_exhausted"
      && finish_reason_wire(TermMaxSteps) == "max_steps"
      && finish_reason_wire(TermProviderFailure) == "error"
      && finish_reason_wire(TermSystemPromptEmpty) == "error"
      && finish_reason_wire(TermInvalidHistory) == "error"
      && finish_reason_wire(TermInternalFailure) == "error"
  }

-- The reachable Fail codes map to the reasons the integer helper produced.
-- The last row is the one ADR-003 D2 bought: an `Internal` failure whose
-- message happens to read like the budget one is an internal failure, because
-- nothing reads the message any more.
pure func test_decision_fail_reason_mapping() -> bool
  tests [((), true)]
  {
    finish_reason_wire(decision_fail_reason("BudgetExceeded")) == "cost_exhausted"
      && finish_reason_wire(decision_fail_reason("ContextExhausted")) == "compaction_exhausted"
      && finish_reason_wire(decision_fail_reason("StepBudgetExhausted")) == "max_steps"
      && finish_reason_wire(decision_fail_reason("Internal")) == "error"
  }

pure func test_zero_totals_initializes_clean() -> bool
  tests [((), true)]
  {
    let z = zero_totals();
    z.input_tokens == 0
      && z.output_tokens == 0
      && z.cache_read == 0
      && z.cache_creation == 0
      && z.cost_millicents == 0
      && z.cost_warned_pct == 0
  }

-- Cache-token plumbing helpers (M4 from M-MOTOKO-EVAL-INSTRUMENTATION):
-- shape sanity for a list-of-kv length given a hypothetical StepResult.

pure func kv_len(xs: [{key: string, value: Json}]) -> int {
  match xs { [] => 0, _ :: rest => 1 + kv_len(rest) }
}

pure func mk_test_step_result(input: int, output: int, cr: int, cc: int) -> StepResult {
  {
    message: { role: "assistant", content: "", tool_calls: [], tool_call_id: "", images: [] },
    tool_calls: [],
    finish_reason: "stop",
    input_tokens: input,
    output_tokens: output,
    cache_read_input_tokens: cr,
    cache_creation_input_tokens: cc
  }
}

pure func test_per_step_usage_kvs_no_cache() -> bool
  tests [((), true)]
  {
    -- No cache fields → exactly 3 kv entries (input, output, cost_usd)
    let r = mk_test_step_result(100, 50, 0, 0);
    kv_len(per_step_usage_kvs(r, 1500)) == 3
  }

pure func test_per_step_usage_kvs_cache_read_only() -> bool
  tests [((), true)]
  {
    -- OpenAI / Gemini case: only cache_read populated → 4 kv entries
    let r = mk_test_step_result(100, 50, 25, 0);
    kv_len(per_step_usage_kvs(r, 1500)) == 4
  }

pure func test_per_step_usage_kvs_full_cache() -> bool
  tests [((), true)]
  {
    -- Anthropic case: both cache_read + cache_creation → 5 kv entries
    let r = mk_test_step_result(100, 50, 25, 12);
    kv_len(per_step_usage_kvs(r, 1500)) == 5
  }

func test_runtime_status_includes_prior_conversation_counts() -> bool ! {IO, Trace}
  tests [((), true)]
  {
    let prior: RuntimeStatusCounts = {
      provider_calls_started: 26,
      provider_calls_completed: 26,
      stage_applied_total: 0,
      stage_rejected_total: 0,
      compaction_ai_applied: 0
    };
    let trace: LedgerTrace = {
      records: [
        WireRecord(ProviderCallPrepared({
          step: 0,
          msg_count: 2,
          estimated_input_tokens: 3,
          system_prefix_count: 1,
          system_prefix_chars: 3,
          system_prefix_digest: "sha256:sys",
          payload_digest: "sha256:payload",
          model: "m"
        })),
        WireRecord(ProviderResult({
          step: 0,
          text: "",
          finish_reason: "tool_calls",
          tool_calls: 1,
          input_tokens: 10,
          output_tokens: 5,
          cost_usd: 0.0,
          cache_read_input_tokens: 0,
          cache_creation_input_tokens: 0
        }))
      ]
    };
    let st: C2LoopState = {
      msgs: [{ role: "system", content: "sys", tool_calls: [], tool_call_id: "", images: [] }],
      step_idx: 1,
      totals: zero_totals(),
      ext_artifacts: jo([]),
      telemetry: { last_input_tokens: 0, last_output_tokens: 0, last_estimated_input_tokens: 0 },
      provider: scripted_ports(),
      world_state: empty_world_state(),
      pending_tool_calls: [],
      pending_tool_context: [],
      pending_tool_prefix: [],
      pending_tool_batched: true,
      accumulated_tool_msgs: [],
      pending_approval: None,
      last_finish_reason: "tool_calls",
      last_response_text: "",
      nudges_used: 0,
      finalize_source: "",
      prior_counts: prior,
      trace: trace,
      emissions: [],
      history_digest: c2_seed_digest([]),
      open_waits: [],
      park_ordinal: initial_park_ordinal(false),
      park_attempt: 0
    };
    let policy: SessionPolicy = {
      step: {
        step_budget: 100,
        max_cost_millicents: 0,
        cost_metered: false,
        persist_retries: 0,
        retry_stream_errors: false,
        require_system_prompt: true,
        model: "m",
        provider_base_url: "",
        checkpoint_enabled: false,
        checkpoint_pct: 90,
        compaction: {
          context_limit: Bounded({ raw_window: 1000, source: Catalogue }),
          elide_tier_pct: 70,
          elide_hard_tier_pct: 85,
          emergency_pct: 95
        }
      },
      headless: false
    };
    let encoded = encode(runtime_status_json(st, policy, 0));
    contains(encoded, "\"provider_calls_started\":27")
      && contains(encoded, "\"provider_calls_completed\":27")
      && contains(encoded, "\"steps_executed_so_far\":27")
  }

func test_runtime_status_reports_actual_context_window() -> bool ! {IO, Trace}
  tests [((), true)]
  {
    let st: C2LoopState = {
      msgs: [{ role: "system", content: "sys", tool_calls: [], tool_call_id: "", images: [] }],
      step_idx: 1,
      totals: zero_totals(),
      ext_artifacts: jo([]),
      telemetry: { last_input_tokens: 500, last_output_tokens: 20, last_estimated_input_tokens: 0 },
      provider: scripted_ports(),
      world_state: empty_world_state(),
      pending_tool_calls: [],
      pending_tool_context: [],
      pending_tool_prefix: [],
      pending_tool_batched: true,
      accumulated_tool_msgs: [],
      pending_approval: None,
      last_finish_reason: "tool_calls",
      last_response_text: "",
      nudges_used: 0,
      finalize_source: "",
      prior_counts: zero_runtime_status_counts(),
      trace: { records: [] },
      emissions: [],
      history_digest: c2_seed_digest([]),
      open_waits: [],
      park_ordinal: initial_park_ordinal(false),
      park_attempt: 0
    };
    let policy: SessionPolicy = {
      step: {
        step_budget: 100,
        max_cost_millicents: 0,
        cost_metered: false,
        persist_retries: 0,
        retry_stream_errors: false,
        require_system_prompt: true,
        model: "m",
        provider_base_url: "",
        checkpoint_enabled: false,
        checkpoint_pct: 90,
        compaction: {
          context_limit: Bounded({ raw_window: 1000, source: Catalogue }),
          elide_tier_pct: 70,
          elide_hard_tier_pct: 85,
          emergency_pct: 95
        }
      },
      headless: false
    };
    let encoded = encode(runtime_status_json(st, policy, 0));
    -- actual = 500 provider tokens against a 1000 limit => 50%
    contains(encoded, "\"context_limit\":1000")
      && contains(encoded, "\"last_sent\"")
      && contains(encoded, "\"input_tokens\":500")
      && contains(encoded, "\"usage_pct\":50")
      && contains(encoded, "\"uncompacted_pending\"")
      && contains(encoded, "\"note\"")
  }

pure func test_runtime_status_counts_generated_compaction_ai_id() -> bool
  tests [((), true)]
  {
    let trace: LedgerTrace = {
      records: [
        CompactionStageRecord({
          step: 3,
          ext_id: "compaction_ai#0",
          outcome: TraceStageApplied("AI-summarized 1 turns")
        }),
        CompactionStageRecord({
          step: 3,
          ext_id: "compaction_structural#3",
          outcome: TraceStageApplied("structural: tier=emergency keep_last=3")
        }),
        CompactionStageRecord({
          step: 3,
          ext_id: "compaction_ai#0",
          outcome: TraceStageObserved("compaction_ai.summarizer_failed", [{ key: "attempts", value: "2" }])
        })
      ]
    };
    let counts = runtime_status_counts(trace);
    counts.stage_applied_total == 2
      && counts.stage_rejected_total == 0
      && counts.compaction_ai_applied == 1
  }

-- ============================================================================
-- PLAN-003 P1 Part 1 — THE TWO PURE UNIT TESTS, RED FIRST (ADR-003 D5, D6).
--
-- WHY THEY ARE HERE AND NOT IN A DST FIXTURE. §0.6: a deterministic run drives
-- the traced entry directly and never reaches the conversation loop
-- (`:3359–3366`), so the in-process `continue` has no deterministic fixture and
-- cannot get one. It is verified three ways instead — the DST fixture for the
-- suspension INSIDE the traced run (`phase_c2_wiring_scenarios.ail`), these two
-- pure tests for the loop's rule and the resume constructor, and one live probe
-- (`scripts/probe_budget_continue.sh`). This file is where the second one goes,
-- following `test_decision_fail_reason_mapping` above.
--
-- BOTH ARE RED AT THIS COMMIT, ON PURPOSE. P1 Part 5 lands
-- `c2_state_from_continuation` and the loop's `run_ordinal` rule; neither
-- exists here, and the plan puts the acceptance test first. The three stub
-- bodies below are the unimplemented halves — each names the exact expression
-- Part 5 replaces it with, and each returns the value the runtime produces
-- TODAY, which is nothing: there is no run identity in the loop at all, and the
-- resume path recurses with the pre-turn history (`:3418–3427`), dropping the
-- exhausted run's messages, counts and nudge tally on the floor. That drop is
-- what the assertions below describe the repair of.
--
-- WHAT MUST NOT HAPPEN TO THEM: filling a stub in with the assertion's own
-- literals rather than with Part 5's rule. The rule is stated in the comment
-- above each stub, and the assertion is the table it has to satisfy.
-- ============================================================================

-- P1 PART 5 LANDED THE TWO STUBS THAT WERE HERE, and it landed them beside
-- `conversation_loop_v2_with_policy` — the one caller of the rule they state —
-- rather than filling their bodies in place. `next_run_ordinal` and
-- `run_id_for` are the driver's, not the test's; what P1 Part 1 required is
-- that ONE definition answer to both, and the assertion below now reads the
-- same function the loop calls. A body filled in here, under the test that
-- pins it, would have been the second definition the stub comment warned
-- against.
--
-- The rule as a table: the ordinal advances by one per traced run, and the id
-- is the three fields joined in that order. The second row is the one the ADR
-- is about — a second run in the same process is `.2`, not a fresh session.
pure func test_run_ordinal_rule() -> bool
  tests [((), true)]
  {
    next_run_ordinal(0) == 1
      && next_run_ordinal(1) == 2
      && next_run_ordinal(7) == 8
      && run_id_for("session_42", 0, 1) == "session_42.r0.1"
      && run_id_for("session_42", 0, 2) == "session_42.r0.2"
      && run_id_for("session_42", 3, 1) == "session_42.r3.1"
  }

-- The observable half of D6's `c2_state_from_continuation(c, provider)`: what
-- the resumed run's `C2LoopState` carries from the continuation and what it
-- resets. The state itself cannot be built in a `pure` test — `C2LoopState`
-- holds a `Ports` and a `WorldState`, and every constructor of those is
-- effectful — so the rule is pinned over the projection instead, which is
-- exactly the seven decisions D6 makes and nothing else.
type ResumeStateShape = {
  msgs_len: int,
  step_idx: int,
  totals_cost_millicents: int,
  prior_calls_completed: int,
  nudges_used: int,
  pending_tool_calls: int,
  trace_len: int,
  emissions_len: int,
  open_waits_len: int,
  park_ordinal: int,
  park_attempt: int
}

-- P1 Part 5: THE PROJECTION, and every reset field below is read from the same
-- `c2_resume_reset()` value the real `c2_state_from_continuation` constructs
-- its state from — not re-stated as a literal here. That is what makes this a
-- projection rather than a second opinion: change the constructor's reset half
-- and this function changes with it, and the assertion below is what notices.
--
-- The three arguments ARE the continuation's carried fields — `List.length(
-- c.history)`, `c.cumulative.provider_calls_completed`, `c.nudges_used` —
-- because a `C2LoopState` cannot be built in a `pure` test at all: it holds a
-- `Ports` and a `WorldState` and every constructor of those is effectful.
-- `ext_artifacts` and `telemetry` are carried too; they are not integers and
-- `journal.ail`'s round-trip test pins them instead.
pure func c2_state_from_continuation_shape(history_len: int, cumulative_calls_completed: int, nudges_used: int) -> ResumeStateShape {
  let reset = c2_resume_reset();
  {
    msgs_len: history_len,
    step_idx: reset.step_idx,
    totals_cost_millicents: reset.totals.cost_millicents,
    prior_calls_completed: cumulative_calls_completed,
    nudges_used: nudges_used,
    pending_tool_calls: List.length(reset.pending_tool_calls),
    trace_len: List.length(reset.trace.records),
    emissions_len: List.length(reset.emissions),
    open_waits_len: List.length(reset.open_waits),
    park_ordinal: reset.park_ordinal,
    park_attempt: reset.park_attempt
  }
}

-- The continuation of the DST fixture's run, read as a resume: eight messages,
-- three completed provider calls, no nudges. The step index and the totals
-- RESET (the next run counts its own steps and its own cost); the history and
-- the cumulative counts CARRY (that is the whole of the repair); the pending
-- fields, the trace and the emissions start empty (a resumed run's trace is its
-- own, and P3's journal is what makes the earlier one durable).
pure func test_c2_state_from_continuation_resets_and_carries() -> bool
  tests [((), true)]
  {
    let st = c2_state_from_continuation_shape(8, 3, 0);
    st.msgs_len == 8
      && st.prior_calls_completed == 3
      && st.nudges_used == 0
      && st.step_idx == 0
      && st.totals_cost_millicents == 0
      && st.pending_tool_calls == 0
      && st.trace_len == 0
      && st.emissions_len == 0
      -- PLAN-002 W4 gate 1: the waits and the park counters clear.
      && st.open_waits_len == 0
      && st.park_ordinal == 0
      && st.park_attempt == 0
  }

-- PLAN-002 §8.4 (R9): the one exception, named. A wake-opened run starts at
-- ordinal 1; every constructor in W4 passes `false`.
pure func test_initial_park_ordinal_is_one_only_for_a_wake_opened_run() -> bool
  tests [((), true)]
  {
    initial_park_ordinal(false) == 0 && initial_park_ordinal(true) == 1
  }

-- ============================================================================
-- PLAN-002 W5 gate 1 (ADR-002 D4 subset, D5 step 5): the between-turn frame's
-- pure half. The loop itself is gated live (`scripts/probe_between_turn_frame.sh`).
-- ============================================================================

pure func w5_world(ordinal: int) -> WorldState {
  let w = empty_world_state();
  { w | ordinal: ordinal }
}

pure func w5_continuation() -> Continuation {
  { history: [], step_idx: 2, cumulative: zero_runtime_status_counts(), telemetry: zero_token_telemetry(), ext_artifacts: jo([]), nudges_used: 0, model: "m", profile: "p", boot: empty_boot() }
}

-- W5(c): the next turn starts from the PUBLISHED successor, never from the
-- turn's own final world. `next_turn_world` takes no traced result, so the
-- `Ok`/`Err`/suspended arms cannot diverge; this pins the successor itself.
pure func test_w5_next_turn_world_is_the_published_successor_on_every_arm() -> bool
  tests [((), true)]
  {
    let final_world = w5_world(7);
    let published = { world: w5_world(8), trace: empty_ledger_trace() };
    next_turn_world(published).ordinal == 8
      && next_turn_world(published).ordinal != final_world.ordinal
  }

-- W5(a): the frame opens at the previous run's `final`. The manifest is handed
-- `traced.world`, so its witnessed `env_read` carries `final + 1`, and the next
-- turn's world is that successor — the frame's last ordinal, not `final`.
pure func test_w5_between_turn_frame_opens_at_the_previous_final() -> bool
  tests [((), true)]
  {
    let final_world = w5_world(7);
    let env_read = advance(final_world, EnvRead);
    let published = { world: { env_read | pending: [] }, trace: empty_ledger_trace() };
    (match env_read.pending { r :: [] => r.ordinal == final_world.ordinal + 1, _ => false })
      && next_turn_world(published).ordinal == final_world.ordinal + 1
  }

-- W5(b), §8.4 (R9): a run seeded from a consumed between-turn wake starts at
-- park ordinal 1, so its first in-turn park is `<run_id>.p1`, and `.p0` stays
-- the between-turn request's.
pure func test_w5_a_wake_opened_run_first_parks_at_p1() -> bool
  tests [((), true)]
  {
    let identity = loop_run_identity("s", "p", 0, 3);
    let resumed = c2_state_from_continuation_shape(8, 3, 0);
    let seeded = { resumed | park_ordinal: initial_park_ordinal(true) };
    resumed.park_ordinal == 0
      && seeded.park_ordinal == 1
      && park_request_id(identity.run_id, seeded.park_ordinal) == "s.r0.3.p1"
      && park_request_id(identity.run_id, resumed.park_ordinal) == between_turn_request_id("s", "p", 0, 3)
  }

-- W5(b): the REAL constructors, not the projection. `scripted_ports` is
-- effectful, so this test is too (as `test_runtime_status_includes_prior_conversation_counts`).
func test_w5_constructors_start_at_zero_and_a_seeded_state_parks_at_p1() -> bool ! {IO, Trace}
  tests [((), true)]
  {
    let provider: PortedProvider = { ports: scripted_ports(), world: empty_world_state() };
    let fresh = c2_initial_state_with_counts([], provider, provider.world, zero_runtime_status_counts());
    let resumed = c2_state_from_continuation(w5_continuation(), provider, provider.world);
    let seeded = { resumed | park_ordinal: initial_park_ordinal(true) };
    let identity = loop_run_identity("s", "p", 0, 3);
    fresh.park_ordinal == 0
      && resumed.park_ordinal == 0
      && seeded.park_ordinal == 1
      && park_request_id(identity.run_id, seeded.park_ordinal) == "s.r0.3.p1"
  }

-- W5(b), review change 21: `<next run_id>.p0`, built from the arguments the
-- `user_message` arm passes to `loop_run_identity`.
pure func test_w5_between_turn_request_id_is_the_next_run_id_dot_p0() -> bool
  tests [((), true)]
  {
    between_turn_request_id("s", "p", 0, 3) == "s.r0.3.p0"
      && between_turn_request_id("session_42", "prof", 2, 7) == "${loop_run_identity("session_42", "prof", 2, 7).run_id}.p0"
      && between_turn_request_id("s", "", 1, 0) == "${loop_run_identity("s", "", 1, 0).run_id}.p0"
      && between_turn_request_id("s", "p", 0, 3) != loop_run_identity("s", "p", 0, 3).run_id
  }

-- ============================================================================
-- PLAN-002 W4 Parts 1-2: the park's pure half (gate 1).
-- ============================================================================

pure func w4_delegate(id: string) -> WaitDescriptor {
  DelegateWait({ id: id, delegate_kind: "claude", locator: { pane: "p" }, answer_path: "/tmp/a.md", run_key: "rk" })
}

pure func w4_wake(rid: string, wid: string, outcome: WakeOutcome) -> WakeInput {
  { request_id: rid, wait_id: wid, outcome: outcome, next_state: empty_world_state() }
}

pure func w4_req(waits: [WaitDescriptor]) -> ParkRequest {
  { request_id: park_request_id("sid.r0.0", 0), step: 3, waits: waits, attempt: 0 }
}

pure func w4_ids(ws: [WaitDescriptor]) -> string {
  join_wait_ids(wait_ids_of(ws))
}

-- `<run_id>.p<ordinal>`, the id `ParkRequest` and `park_entered` carry.
pure func test_park_request_id_is_run_id_dot_p_ordinal() -> bool
  tests [((), true)]
  {
    park_request_id("s.r0.0", 0) == "s.r0.0.p0" && park_request_id("s.r1.2", 7) == "s.r1.2.p7"
  }

-- Review change 12: `request_id` always, `wait_id` only for Settled/Lost/TimedOut.
pure func test_wake_matches_request_id_always_and_wait_id_only_where_named() -> bool
  tests [((), true)]
  {
    let req = w4_req([w4_delegate("h1"), TimerWait({ id: "t1", deadline_ms: 5 })]);
    let rid = req.request_id;
    wake_matches(req, w4_wake(rid, "h1", Settled("a")))
      && wake_matches(req, w4_wake(rid, "h1", Lost("gone")))
      && wake_matches(req, w4_wake(rid, "t1", TimedOut))
      && not wake_matches(req, w4_wake(rid, "h9", Settled("a")))
      && not wake_matches(req, w4_wake(rid, "", Lost("gone")))
      -- the unbound default's own reply names no wait and still matches
      && wake_matches(req, w4_wake(rid, "", HostError("wake_read unbound")))
      && wake_matches(req, w4_wake(rid, "", OperatorInput("hi")))
      && wake_matches(req, w4_wake(rid, "abort", Aborted))
      && not wake_matches(req, w4_wake("sid.r0.0.p1", "h1", Settled("a")))
      && not wake_matches(req, w4_wake("other", "", HostError("x")))
  }

-- ADR-002 D2's outcome table, the wait column, row by row.
pure func test_apply_wake_follows_the_outcome_table() -> bool
  tests [((), true)]
  {
    let ws = [w4_delegate("h1"), w4_delegate("h2"), TimerWait({ id: "t1", deadline_ms: 5 })];
    w4_ids(apply_wake(ws, w4_wake("r", "h1", Settled("a")))) == "h2, t1"
      && w4_ids(apply_wake(ws, w4_wake("r", "h2", Lost("gone")))) == "h1, t1"
      && w4_ids(apply_wake(ws, w4_wake("r", "", OperatorInput("hi")))) == "h1, h2, t1"
      && w4_ids(apply_wake(ws, w4_wake("r", "t1", TimedOut))) == "h1, h2"
      -- TimedOut removes the TIMER only: a delegate id named by it stays
      && w4_ids(apply_wake(ws, w4_wake("r", "h1", TimedOut))) == "h1, h2, t1"
      && w4_ids(apply_wake(ws, w4_wake("r", "", HostError("down")))) == "h1, h2, t1"
      && List.length(apply_wake(ws, w4_wake("r", "abort", Aborted))) == 0
  }

-- The wake message is loop-authored and `Settled` directs the model to
-- `DelegateCheck` once.
pure func test_wake_message_is_loop_authored_and_settled_says_delegate_check_once() -> bool
  tests [((), true)]
  {
    let settled = wake_message(w4_wake("r", "h1", Settled("the answer")));
    let op = wake_message(w4_wake("r", "", OperatorInput("hello")));
    settled.role == "user"
      && startsWith(settled.content, loop_authored_tag())
      && contains(settled.content, "the answer is available; call `DelegateCheck` once")
      && not contains(settled.content, "the answer.")
      && startsWith(op.content, loop_authored_tag())
      && contains(op.content, "hello")
      && startsWith(wake_message(w4_wake("r", "", HostError("down"))).content, loop_authored_tag())
  }

-- ADR-002 D3's re-delegation row: two or more open after a batch that
-- registered one, and only the `Delegate` result messages gain the sentence.
pure func test_both_open_sentence_names_every_open_wait_on_the_delegate_result() -> bool
  tests [((), true)]
  {
    let calls: [ToolCall] = [{ id: "c2", name: "Delegate", arguments: "{}" }, { id: "c3", name: "ReadFile", arguments: "{}" }];
    let msgs: [Message] = [
      { role: "tool", content: "launched", tool_calls: [], tool_call_id: "c2", images: [] },
      { role: "tool", content: "file", tool_calls: [], tool_call_id: "c3", images: [] }
    ];
    let before = [w4_delegate("h1")];
    let after = [w4_delegate("h1"), w4_delegate("h2")];
    let told = both_open_msgs(calls, before, after, msgs);
    let untouched_one = both_open_msgs(calls, [], [w4_delegate("h1")], msgs);
    let untouched_no_new = both_open_msgs(calls, after, after, msgs);
    (match told {
       d :: f :: [] => contains(d.content, "2 waits are open: h1, h2") && startsWith(d.content, "launched") && f.content == "file",
       _ => false
     })
      && (match untouched_one { d :: _ => d.content == "launched", _ => false })
      && (match untouched_no_new { d :: _ => d.content == "launched", _ => false })
  }

-- PLAN-003 P4 Part 3 (ADR-003 v6.1 D7): the resumer's cursor seed rewrites ONLY
-- the request id, goes to the HEAD of the cursor, leaves the world's ordinal
-- alone, and seeds nothing without a wake child (the re-observation path).
pure func test_p4_parked_cursor_rewrites_only_the_request_id_at_the_head() -> bool
  tests [((), true)]
  {
    let later: WakeObservation = { request_id: "s.r1.0.p1", wait_id: "h2", outcome: Settled("a2") };
    let world = { empty_world_state() | wakes: [later] };
    let child: WakeEntry = { request_id: "s.r0.0.p0", wait_id: "h1", outcome: "settled", detail: "the answer" };
    let seeded = parked_cursor(world, "s.r1.0.p0", Some(child));
    let unseeded = parked_cursor(world, "s.r1.0.p0", None);
    (match seeded.wakes {
       w :: rest => w.request_id == "s.r1.0.p0" && w.wait_id == "h1"
         && (match w.outcome { Settled(d) => d == "the answer", _ => false })
         && (match rest { r :: [] => r.request_id == "s.r1.0.p1", _ => false }),
       [] => false
     })
      && List.length(unseeded.wakes) == 1
      && seeded.ordinal == world.ordinal
  }

-- W5(b) at the resumer, on the REAL constructors: the parked seed is the
-- continuation's state with the wake applied to the park's waits, the first
-- in-turn park at `<R'>.p1` while `<R'>.p0` stays the between-turn request's,
-- and the wake message routed as `user_injected`.
func test_p4_state_from_parked_applies_the_wake_and_parks_at_p1() -> bool ! {IO, Trace}
  tests [((), true)]
  {
    let provider: PortedProvider = { ports: scripted_ports(), world: empty_world_state() };
    let waits = [w4_delegate("h1"), w4_delegate("h2")];
    let wake = w4_wake("s.r1.0.p0", "h1", Settled("a1"));
    let st = c2_state_from_parked({ continuation: w5_continuation(), open_waits: apply_wake(waits, wake) }, provider, provider.world);
    let plain = c2_state_from_continuation(w5_continuation(), provider, provider.world);
    let identity = loop_run_identity("s", "p", 1, 0);
    st.park_ordinal == initial_park_ordinal(true) && plain.park_ordinal == 0
      && w4_ids(st.open_waits) == "h2" && List.length(plain.open_waits) == 0
      && st.last_finish_reason == "user_injected" && plain.last_finish_reason == ""
      && park_request_id(identity.run_id, st.park_ordinal) == "s.r1.0.p1"
      && between_turn_request_id("s", "p", 1, 0) == "s.r1.0.p0"
      && List.length(st.msgs) == List.length(plain.msgs)
  }
