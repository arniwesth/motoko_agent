-- ADR-003 v6.1 D1/D2/D4. THE EDGE THE PLAN SAYS TO ADD, and the direction is
-- the whole of why `journal.ail` is a leaf: it imports no `session`, so this
-- import closes no cycle. P1 Part 3 landed the shapes with no producer; this
-- part gives every one of them one.
import src/core/journal (
  RunIdentity,
  default_run_identity,
  BootInputs,
  Continuation,
  FinalState,
  final_of_continuation, empty_final_state, empty_boot,
  continuation_history_ok, continuation_task,
  -- P3 Part 3. THE CHAIN, AND IT IS IMPORTED RATHER THAN RESTATED. ADR-003 D4
  -- makes the fold recompute exactly what the child computed, so the child must
  -- call the fold's own function: `chain_digest_after` is
  -- `phase_vocab.canonical_message_frame`'s only caller and the chain digest has
  -- exactly one definition (P3 Part 2's note at its declaration). `message_json`
  -- / `messages_json` are the same argument for the message ENCODER — ADR-003 D1
  -- refuses a second one, and the journal's payloads cross pre-encoded. P3 Part 4
  -- adds `chain_digests_over`/`_json` for the same reason again: the seed's
  -- PREFIX chain, which the TypeScript host must write into N entries the fold
  -- checks one by one and cannot recompute without a second frame function.
  chain_digest_after, chain_digests_over, chain_digests_json,
  chain_empty_base, message_json, messages_json, ResumePlan, resume_view_json, BoundaryParked, ParkEntry, WakeEntry
)
