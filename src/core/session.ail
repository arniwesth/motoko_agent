type SessionPolicy = {
  step: StepPolicy,
  headless: bool
}

-- WI-A13 stage 2 added `world`. A12 gave the world a way IN (`ScriptedWorld`,
-- so an assertion could seed a cursor); discovery needs the way OUT, because
-- the interaction log the ports record rides in the world and nothing else in
-- this result carries it. Without this field stage 2 is not merely harder, it
-- is impossible: the recorder would have no reader.
--
-- It alters nothing the driver requests. `c2_finalize` is the sole construction
-- site — the structural guard in `make terminal_trace` counts exactly one
-- terminal record literal — so this is one field at one place, and every
-- existing consumer reads `.result` and `.trace` and is untouched.
-- WI-C3 adds the third channel, and it is a D6-level widening rather than a
-- convenience: `ExecutionUnderTest` needs the returned outcome, the complete
-- trace AND D6.4's emission witness, and before this the triple carried the
-- first two. A bridge from a run to an `ExecutionUnderTest` could not be built
-- without it — `emissions: []` was the only value available, and an empty
-- witness reads identically to a run that emitted nothing.
export type TracedSessionResult = {
  result: Result[[Message], AIError],
  trace: LedgerTrace,
  world: WorldState,
  emissions: [LedgerEvent]
}

-- Convert Motoko's UI/profile model identifier to the provider API model id
-- expected by upstream stepWithStream(). The --ai flag already selected the
-- handler/provider; the model argument passed to step is forwarded to the
-- upstream API body.
--
-- Important: OpenRouter's API model ids are themselves vendor/model strings
-- such as "anthropic/claude-sonnet-4-6" and "openai/gpt-4o". Strip the
-- explicit Motoko/OpenRouter routing prefix only for pinned vendor/model ids;
-- keep "openrouter/auto" intact because AILANG/OpenRouter use it as the
-- routing-policy model.
--
-- Direct provider prefixes are Motoko routing syntax and are stripped before
-- the provider request. AILANG itself treats vendor/model strings such as
-- "openai/..." and "anthropic/..." as OpenRouter, so the TS launcher also
-- strips those prefixes for --ai provider selection.
pure func provider_api_model(model: string, openai_base_url: string) -> string {
  if model == "openrouter/auto" then
    model
  else if startsWith(model, "openrouter/") then
    let prefix_len = Str.length("openrouter/") in
    let total = Str.length(model) in
    substring(model, prefix_len, total)
  else if startsWith(model, "openai/") then
    let prefix_len = Str.length("openai/") in
    let total = Str.length(model) in
    substring(model, prefix_len, total)
  else if startsWith(model, "anthropic/") then
    let prefix_len = Str.length("anthropic/") in
    let total = Str.length(model) in
    substring(model, prefix_len, total)
  else if startsWith(model, "google/") then
    let prefix_len = Str.length("google/") in
    let total = Str.length(model) in
    substring(model, prefix_len, total)
  else
    model
}

-- emit a JSON line to stdout for the TS env-server to forward to the TUI.
-- Same protocol as src/core/ai_compat (M-AI-CALL-STREAM-HELPER side).
func emit_json(payload: Json) -> () ! {IO} {
  println(encode(payload))
}

pure func trace_event_enabled(event_type: string) -> bool {
  event_type == "session_start" || event_type == "run_summary"
}

pure func trace_sensitive_key(key: string) -> bool {
  key == "task"
    || key == "text"
    || key == "text_delta"
    || key == "output"
    || key == "content"
    || key == "cmd"
    || key == "feedback"
    || key == "errors"
    || key == "message"
}

pure func trace_string_value(s: string) -> Json {
  if Str.length(s) > 256 then
    js("${substring(s, 0, 256)}...[truncated]")
  else
    js(s)
}

pure func trace_value_for_key(key: string, value: Json) -> Json {
  if trace_sensitive_key(key) then js("[redacted]")
  else match value {
    JString(s) => trace_string_value(s),
    JArray(_) => js("[array]"),
    JObject(_) => js("[object]"),
    _ => value
  }
}

pure func trace_extra_kvs(extra: [{key: string, value: Json}]) -> [{key: string, value: Json}] {
  match extra {
    [] => [],
    item :: rest => kv(item.key, trace_value_for_key(item.key, item.value)) :: trace_extra_kvs(rest)
  }
}

func emit_trace_event(session_id: string, event_type: string, extra: [{key: string, value: Json}]) -> () ! {Trace} {
  if trace_event_enabled(event_type) then
    Trace.event(event_type, encode(jo([
      kv("schema_version", js(schema_version())),
      kv("session_id",     js(session_id)),
      kv("type",           js(event_type))
    ] ++ trace_extra_kvs(extra))))
  else
    ()
}

-- M-MOTOKO-EVAL-INSTRUMENTATION (schema v1):
-- The session JSONL is the single structured-output surface for downstream
-- consumers (TUI replay, AILANG eval-harness adapter, post-run analysis).
-- Schema v1 = additive metadata on every event (schema_version + session_id)
-- + per-step token/cost telemetry + a terminal `run_summary` event with
-- cumulative totals. Documented at:
--   design_docs/planned/m-motoko-eval-instrumentation.md
-- Bumping this string is a breaking change for downstream parsers.
pure func schema_version() -> string { "1" }

-- Build-time constant injected by `make build` (Makefile sets -ldflags or
-- equivalent). Falls back to "dev" for local-source runs. Surfaced in
-- session_start + run_summary so the AILANG eval harness can correlate
-- benchmark results with the exact motoko commit that produced them
-- (mitigates "self-referential masking" — see eval-instrumentation design
-- doc Risk #4).
pure func motoko_commit() -> string { "dev" }

-- Convert millicents (integer arithmetic, used internally by the cost
-- tracker) to USD float. 100000 millicents = $1.00.
pure func millicents_to_usd(mc: int) -> float {
  _int_to_float(mc) / 100000.0
}

pure func event_type_from_projected(kvs: [{key: string, value: Json}]) -> string {
  match kvs {
    [] => "",
    x :: _ =>
      if x.key == "type" then
        match x.value {
          JString(s) => s,
          _ => ""
        }
      else ""
  }
}

pure func event_extra_from_projected(kvs: [{key: string, value: Json}]) -> [{key: string, value: Json}] {
  match kvs {
    [] => [],
    _ :: rest => rest
  }
}

func ledger_emit(session_id: string, e: LedgerEvent) -> () ! {IO, Trace} {
  let projected = to_schema_v1_kvs(e);
  let event_type = event_type_from_projected(projected);
  emit_json(jo([
    kv("schema_version", js(schema_version())),
    kv("session_id",     js(session_id))
  ] ++ projected));
  emit_trace_event(session_id, event_type, event_extra_from_projected(projected))
}

func emit_pre_step_stages(session_id: string, step_idx: int, stages: [PreStepStage]) -> () ! {IO, Trace} {
  match stages {
    [] => (),
    s :: rest => {
      let _ = match s.outcome {
        StageApplied(note) => ledger_emit(session_id, CompactionApplied({
          step: step_idx,
          note: note
        })),
        StageRejected(reason) => ledger_emit(session_id, ExtCompactionRejected({
          step: step_idx,
          note: reason
        })),
        StageObserved(code, fields) => ledger_emit(session_id, ExtensionDiagnostic({
          step: step_idx,
          extension: s.ext_id,
          code: code,
          fields: fields
        })),
        StagePassed => ()
      };
      emit_pre_step_stages(session_id, step_idx, rest)
    }
  }
}

-- Cumulative token/cost totals threaded through loop_v2 recursion. Bundled
-- into a single record (vs 6 extra params) so adding new totals later (e.g.
-- reasoning tokens) doesn't require touching every call site again.
type RuntimeLoopTotals = {
  input_tokens: int,
  output_tokens: int,
  cache_read: int,
  cache_creation: int,
  cost_millicents: int,
  cost_warned_pct: int
}

type C2LoopState = {
  msgs: [Message],
  step_idx: int,
  totals: RuntimeLoopTotals,
  ext_artifacts: Json,
  telemetry: { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int },
  provider: Ports,
  -- D1's `world_state`: ONE explicit field, threaded by the driver, the sole
  -- home for every effect cursor in the run. Not a closure captured inside the
  -- Ports value, not a provider ADT payload, and never re-derived from message
  -- history. WI-A12 landed this by renaming WI-A2's interim `provider_state`
  -- field, which is how D1's "subsumed and deleted in the same change" reads in
  -- practice: there is no moment where two homes exist.
  --
  -- Every subsequent effect class A12 threads — the clock, approval, env reads,
  -- runtime randomness, the typed tool contract — adds a field to WorldState
  -- and consumes it through a port. None of them adds a field HERE.
  world_state: WorldState,
  pending_tool_calls: [ToolCall],
  pending_tool_context: [Message],
  pending_tool_prefix: [Message],
  pending_tool_batched: bool,
  accumulated_tool_msgs: [Message],
  pending_approval: Option[ApprovalRequest],
  last_finish_reason: string,
  last_response_text: string,
  nudges_used: int,
  finalize_source: string,
  prior_counts: RuntimeStatusCounts,
  trace: LedgerTrace,

  -- WI-C3. D6.4's emission witness: every logical StreamDelta the driver
  -- projected during a provider callback, in order, across every step of the
  -- run. `ledger_emit` is `-> () ! {IO, Trace}` and keeps no in-memory log, and
  -- the callback's row is closed `{IO}` so it cannot accumulate one either —
  -- this field is where the log the PROVIDER returned is carried instead, which
  -- is the only in-process observation of the stream that exists (see
  -- `stream_chunk_events` and the note at the model-step site).
  --
  -- It is threaded ALONGSIDE `trace` and deliberately not derived from it. The
  -- trace has ONE junction after the call (`trace_after_call`); the witness is
  -- set in each of the branch literals below. That asymmetry is the point: a
  -- branch that carries one channel forward and drops the other goes red as
  -- StreamParityCount, which is S12's identity-transition class arriving on a
  -- pair of channels rather than on a world token.
  emissions: [LedgerEvent]
}

type RuntimeStatusCounts = {
  provider_calls_started: int,
  provider_calls_completed: int,
  stage_applied_total: int,
  stage_rejected_total: int,
  compaction_ai_applied: int
}

pure func zero_totals() -> RuntimeLoopTotals {
  { input_tokens: 0, output_tokens: 0, cache_read: 0, cache_creation: 0, cost_millicents: 0, cost_warned_pct: 0 }
}

pure func zero_runtime_status_counts() -> RuntimeStatusCounts {
  {
    provider_calls_started: 0,
    provider_calls_completed: 0,
    stage_applied_total: 0,
    stage_rejected_total: 0,
    compaction_ai_applied: 0
  }
}

-- THE FOLD IS `foldl` AND NOT HAND-WRITTEN RECURSION, and that is the whole of
-- the fix for motoko_agent#160. The hand-written version cost ONE INTERPRETER
-- FRAME PER TRACE RECORD, and `runtime_status_json` calls it once per tool
-- batch over a trace that only grows — so a long session died at
-- `RT_REC_003: max recursion depth 10000 exceeded` mid-run, at ~9 865 records,
-- in code containing no unbounded recursion.
--
-- WHY A FRAME AT ALL: AILANG v0.33.0 does not eliminate tail calls, so depth
-- over a list is the list's length whether the call is in tail position or not.
-- Measured, and recorded with the upstream half in
-- `.agent/issues/ailang-no-tail-call-optimization.md`.
--
-- WHY `foldl` FIXES IT rather than merely moving the cost: stdlib traversals
-- are frame-FREE. Measured the same way — a 300-frame descent followed by a
-- `foldl` over 300 elements completes at a ceiling of 350, as do `++`,
-- `List.map`, `Str.join` and `std/json.encode`. Depth in this codebase comes
-- only from recursion we write ourselves.
--
-- WHAT THIS DOES NOT DO, stated so the next reader does not assume it: the
-- traversal is still O(|trace|) in TIME on every batch that reaches it. That is
-- microseconds at the scale that killed the run, and it is not the fault. The
-- call site is now lazy as well (see `runtime_builtin` below), so the common
-- batch does not pay it at all.
--
-- REJECTED: threading an incremental `RuntimeStatusCounts` through
-- `C2LoopState`. It removes the time cost too, but it adds a field to a record
-- every arm of `c2_loop` constructs, and a counter maintained at the three
-- sites that append counted records drifts silently the first time a fourth
-- site appends one. This keeps the count derived from the trace — correct by
-- construction, which is the property that was never in question.
pure func runtime_status_count_one(counts: RuntimeStatusCounts, r: LedgerRecord) -> RuntimeStatusCounts {
  match r {
        WireRecord(event) => match event {
          ProviderCallPrepared(_) => {
            provider_calls_started: counts.provider_calls_started + 1,
            provider_calls_completed: counts.provider_calls_completed,
            stage_applied_total: counts.stage_applied_total,
            stage_rejected_total: counts.stage_rejected_total,
            compaction_ai_applied: counts.compaction_ai_applied
          },
          ProviderResult(_) => {
            provider_calls_started: counts.provider_calls_started,
            provider_calls_completed: counts.provider_calls_completed + 1,
            stage_applied_total: counts.stage_applied_total,
            stage_rejected_total: counts.stage_rejected_total,
            compaction_ai_applied: counts.compaction_ai_applied
          },
          _ => counts
        },
        CompactionStageRecord(stage) => match stage.outcome {
          TraceStageApplied(_) => {
            provider_calls_started: counts.provider_calls_started,
            provider_calls_completed: counts.provider_calls_completed,
            stage_applied_total: counts.stage_applied_total + 1,
            stage_rejected_total: counts.stage_rejected_total,
            compaction_ai_applied: counts.compaction_ai_applied + (if is_compaction_ai_ext_id(stage.ext_id) then 1 else 0)
          },
          TraceStageRejected(_) => {
            provider_calls_started: counts.provider_calls_started,
            provider_calls_completed: counts.provider_calls_completed,
            stage_applied_total: counts.stage_applied_total,
            stage_rejected_total: counts.stage_rejected_total + 1,
            compaction_ai_applied: counts.compaction_ai_applied
          },
          TraceStageObserved(_, _) => counts,
          _ => counts
        },
        _ => counts
  }
}

pure func is_compaction_ai_ext_id(ext_id: string) -> bool {
  ext_id == "compaction_ai" || startsWith(ext_id, "compaction_ai#")
}

-- contracts: SKIPPED — uses foldl (Z3 fragment requires non-higher-order), the
-- same trade `compaction.estimate_tokens_messages` makes and for the same
-- reason. Named rather than silent because §3.1 of
-- `.agent/projects/011_improve_test_axises/RESEARCH-test-axes-beyond-dst.md`
-- plans to expand contract coverage, and this is one function it can no longer
-- reach.
pure func runtime_status_counts(trace: LedgerTrace) -> RuntimeStatusCounts {
  List.foldl(runtime_status_count_one, zero_runtime_status_counts(), trace.records)
}

pure func runtime_status_counts_add(a: RuntimeStatusCounts, b: RuntimeStatusCounts) -> RuntimeStatusCounts {
  {
    provider_calls_started: a.provider_calls_started + b.provider_calls_started,
    provider_calls_completed: a.provider_calls_completed + b.provider_calls_completed,
    stage_applied_total: a.stage_applied_total + b.stage_applied_total,
    stage_rejected_total: a.stage_rejected_total + b.stage_rejected_total,
    compaction_ai_applied: a.compaction_ai_applied + b.compaction_ai_applied
  }
}

pure func runtime_status_json(
  st: C2LoopState,
  policy: SessionPolicy,
  tool_step_idx: int
) -> Json {
  let counts = runtime_status_counts_add(st.prior_counts, runtime_status_counts(st.trace));
  let context_msgs = c2_pending_context(st);
  let split = split_for_compaction(context_msgs);
  let pinned = split.pinned;
  let limit = policy.step.compaction.context_limit;
  let actual_input_tokens = st.telemetry.last_input_tokens;
  let actual_pct = if limit == 0 then 0 else (actual_input_tokens * 100) / limit;
  let estimated_input_tokens = estimate_tokens_messages(context_msgs);
  let estimated_pct = usage_percent_with_limit(context_msgs, limit);
  let calibrated_input_tokens = calibrated_tokens_messages(context_msgs, st.telemetry);
  let calibrated_pct = calibrated_usage_percent(context_msgs, limit, st.telemetry);
  jo([
    kv("tool", js("MotokoRuntimeStatus")),
    kv("current_step", jnum(_int_to_float(tool_step_idx))),
    kv("provider_calls_started", jnum(_int_to_float(counts.provider_calls_started))),
    kv("provider_calls_completed", jnum(_int_to_float(counts.provider_calls_completed))),
    kv("steps_executed_so_far", jnum(_int_to_float(counts.provider_calls_completed))),
    kv("step_budget", jnum(_int_to_float(policy.step.step_budget))),
    kv("finish_reason_so_far", js(st.last_finish_reason)),
    kv("compaction", jo([
      kv("stage_applied_total", jnum(_int_to_float(counts.stage_applied_total))),
      kv("stage_rejected_total", jnum(_int_to_float(counts.stage_rejected_total))),
      kv("compaction_ai_applied", jnum(_int_to_float(counts.compaction_ai_applied)))
    ])),
    kv("system_prefix", jo([
      kv("count", jnum(_int_to_float(count_system_prefix(pinned)))),
      kv("chars", jnum(_int_to_float(system_prefix_chars(pinned)))),
      kv("digest", js(system_prefix_digest_for(pinned)))
    ])),
    kv("context_window", jo([
      kv("context_limit", jnum(_int_to_float(limit))),
      kv("last_sent", jo([
        kv("input_tokens", jnum(_int_to_float(actual_input_tokens))),
        kv("usage_pct", jnum(_int_to_float(actual_pct)))
      ])),
      kv("uncompacted_pending", jo([
        kv("estimated_tokens", jnum(_int_to_float(estimated_input_tokens))),
        kv("estimated_pct", jnum(_int_to_float(estimated_pct))),
        kv("calibrated_tokens", jnum(_int_to_float(calibrated_input_tokens))),
        kv("calibrated_pct", jnum(_int_to_float(calibrated_pct)))
      ])),
      kv("note", js("last_sent = real provider tokens of the previous compacted request; uncompacted_pending = the full retained history before this step's ephemeral compaction. They measure different windows by design."))
    ])),
    kv("usage", jo([
      kv("input_tokens", jnum(_int_to_float(st.totals.input_tokens))),
      kv("output_tokens", jnum(_int_to_float(st.totals.output_tokens))),
      kv("cache_read_input_tokens", jnum(_int_to_float(st.totals.cache_read))),
      kv("cache_creation_input_tokens", jnum(_int_to_float(st.totals.cache_creation))),
      kv("total_cost_millicents", jnum(_int_to_float(st.totals.cost_millicents)))
    ]))
  ])
}

pure func runtime_status_tool_message(call: ToolCall, content: string) -> Option[Message] {
  if call.name == "MotokoRuntimeStatus" then Some({
    role: "tool",
    content: content,
    tool_calls: [],
    tool_call_id: call.id,
    images: []
  }) else None
}

pure func c2_decision_name(d: StepDecision) -> string {
  match d {
    CallModel(_) => "CallModel",
    RunTools(_) => "RunTools",
    AwaitApproval(_) => "AwaitApproval",
    InjectUserMessage(_) => "InjectUserMessage",
    TakeCheckpoint(_) => "TakeCheckpoint",
    Finalize(_) => "Finalize",
    Fail(_) => "Fail"
  }
}

pure func c2_append_decision(trace: LedgerTrace, step_idx: int, decision: StepDecision) -> LedgerTrace {
  ledger_append(trace, DecisionRecord({ step: step_idx, decision: c2_decision_name(decision) }))
}

pure func c2_trace_stage_records(trace: LedgerTrace, step_idx: int, stages: [PreStepStage]) -> LedgerTrace {
  match stages {
    [] => trace,
    s :: rest => c2_trace_stage_records(ledger_append(trace, stage_record(step_idx, s)), step_idx, rest)
  }
}

pure func c2_trace_wire_events(trace: LedgerTrace, events: [LedgerEvent]) -> LedgerTrace {
  match events {
    [] => trace,
    e :: rest => c2_trace_wire_events(ledger_append(trace, WireRecord(e)), rest)
  }
}

func c2_emit_events(session_id: string, events: [LedgerEvent]) -> () ! {IO, Trace} {
  match events {
    [] => (),
    e :: rest => {
      let _ = ledger_emit(session_id, e);
      c2_emit_events(session_id, rest)
    }
  }
}

pure func c2_tool_plan_calls(entries: [ToolPlanEntry]) -> [ToolCall] {
  match entries {
    [] => [],
    e :: rest => e.call :: c2_tool_plan_calls(rest)
  }
}

pure func c2_step_totals(totals: RuntimeLoopTotals) -> {
  input_tokens: int,
  output_tokens: int,
  cost_millicents: int,
  cost_warned_pct: int
} {
  {
    input_tokens: totals.input_tokens,
    output_tokens: totals.output_tokens,
    cost_millicents: totals.cost_millicents,
    cost_warned_pct: totals.cost_warned_pct
  }
}

func c2_step_state(st: C2LoopState) -> Result[StepState, string] {
  match history_from_seed(st.msgs) {
    Err(e) => Err(e),
    Ok(h) => Ok({
      step_idx: st.step_idx,
      history: h,
      telemetry: st.telemetry,
      totals: c2_step_totals(st.totals),
      nudges_used: st.nudges_used,
      ext_artifacts: st.ext_artifacts,
      pending_tool_calls: st.pending_tool_calls,
      last_finish_reason: st.last_finish_reason,
      last_response_text: st.last_response_text
    })
  }
}

-- WI-A12's clock class made `world` an explicit parameter rather than reading
-- `provider.world` here. That is not ceremony: the entry point performs two
-- clock reads (the session id and `started_at_ms`) BEFORE the loop begins, and
-- taking the initial world from `provider.world` would silently discard both
-- their successors, starting the loop from an un-advanced clock. That variant
-- type-checks cleanly and its only symptom is `duration_ms: 0` — which is why
-- `world_state_probe` asserts the clock advances rather than only that it is
-- reproducible. A frozen clock is perfectly reproducible.
func c2_initial_state_with_counts(history: [Message], provider: PortedProvider, world: WorldState, prior_counts: RuntimeStatusCounts) -> C2LoopState {
  {
    msgs: history,
    step_idx: 0,
    totals: zero_totals(),
    ext_artifacts: jo([]),
    telemetry: { last_input_tokens: 0, last_output_tokens: 0, last_estimated_input_tokens: 0 },
    provider: provider.ports,
    world_state: world,
    pending_tool_calls: [],
    pending_tool_context: [],
    pending_tool_prefix: [],
    pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
    last_finish_reason: "",
    last_response_text: "",
    nudges_used: count_persist_nudges(history),
    finalize_source: "",
    prior_counts: prior_counts,
    trace: empty_ledger_trace(),
    emissions: []
  }
}

func c2_initial_state(history: [Message], provider: PortedProvider) -> C2LoopState {
  c2_initial_state_with_counts(history, provider, provider.world, zero_runtime_status_counts())
}

-- Serialize the exact [Message] payload a provider rejected, so a
-- non-retryable ProtocolError (e.g. hy3:free/Novita "invalid request error")
-- can be inspected/replayed offline. Off by default; enabled by setting
-- MOTOKO_CAPTURE_FAILED_PAYLOAD (writes .motoko/failing_payload.json). Useful
-- for diagnosing the intermittent Novita rejections during hy3:free runs.
func dbg_toolcall_json(c: ToolCall) -> Json {
  jo([kv("id", js(c.id)), kv("name", js(c.name)), kv("arguments", js(c.arguments))])
}

func dbg_toolcalls_json(cs: [ToolCall]) -> [Json] {
  match cs { [] => [], c :: rest => dbg_toolcall_json(c) :: dbg_toolcalls_json(rest) }
}

func dbg_message_json(m: Message) -> Json {
  jo([
    kv("role", js(m.role)),
    kv("content", js(m.content)),
    kv("tool_calls", ja(dbg_toolcalls_json(m.tool_calls))),
    kv("tool_call_id", js(m.tool_call_id))
  ])
}

func dbg_messages_json(msgs: [Message]) -> [Json] {
  match msgs { [] => [], m :: rest => dbg_message_json(m) :: dbg_messages_json(rest) }
}

func capture_failing_payload(e: AIError, msgs: [Message]) -> () ! {FS} {
  let payload = encode(jo([
    kv("error_code", js(e.code)),
    kv("error_message", js(e.message)),
    kv("retryable", jb(e.retryable)),
    kv("messages", ja(dbg_messages_json(msgs)))
  ]));
  match writeFileResult(".motoko/failing_payload.json", payload) { Ok(_) => (), Err(_) => () }
}

-- WI-B2b. THIS IS THE SITE D1's EXTENSION-MODEL EXCLUSION WAS ABOUT, and the
-- exclusion is lifted here.
--
-- What it used to do, and why: it passed `empty_world_state()` and threw the
-- successor away. Not an oversight — `ExtPorts.ai_step` returned
-- `Result[string, string]` and the hook results above it were decision-only, so
-- a successor had no way back to `C2LoopState`. Threading the driver's live
-- cursor IN and discarding the successor would have recreated F6 (a cursor that
-- serves the same answer forever while nothing crashes); capturing it in this
-- closure would have created the second home D1 prohibits. Handing over a fresh
-- empty world was the only honest option, and the cost was recorded rather than
-- hidden: against a Scripted provider the empty script served `terminal_step()`
-- and the extension was told the model had answered.
--
-- What it does now: takes the world in and returns the successor out, so the
-- caller — `ext_ports_of`'s bridge, and through it the hook and the dispatch
-- fold — can thread it back to `C2LoopState`. The world still has exactly one
-- home; this function neither captures nor stores it.
--
-- STILL DROPPED ON THIS PATH, and named rather than left for a reader to
-- discover: `exchange.emissions`. WI-C3 gave the DRIVER's own model-step site a
-- consumer, but this is the EXTENSION bridge and it is unchanged — closing it
-- means widening `ExtPorts.ai_step` again to carry a chunk log the ABI has no
-- type for. So an extension's provider call streams into the wire and
-- contributes nothing to the run's emission witness, which is a narrower gap
-- than WI-A1's and is still a separate change from this one.
-- NAMED, not an inline `{ result: ..., next_state: ... }`. Two reasons, and the
-- second is the one that bites: `derive.py` finds a function's body by taking
-- the first `{` after its signature that is not an effect row — so an anonymous
-- RECORD RETURN TYPE is mistaken for the body, no `p.model_step(` is found in
-- it, and `ai_step` is reported **unrouted**, the tool's fail-open answer. A
-- named type keeps the signature brace-free up to the body.
type ExtAiStepResult = { result: Result[string, string], next_state: WorldState }

func ext_ai_step(p: Ports, world: WorldState, model: string, base_url: string, msgs: [Msg]) -> ExtAiStepResult ! {AI, IO, Trace} {
  let on_chunk = func(_chunk: StreamChunk) -> () ! {IO} { () };
  -- Resolve the provider API model the same way the main step loop does
  -- (dispatch_step calls provider_api_model). Extensions (e.g. compaction_ai)
  -- pass their configured model verbatim, which for OpenRouter still carries
  -- the "openrouter/" routing prefix; sent raw the provider rejects it with 400
  -- "not a valid model ID", surfacing as compaction_ai.summarizer_failed /
  -- provider_error. Strip it here.
  let exchange = p.model_step(world, provider_api_model(model, base_url), msgs_to_messages(msgs), on_chunk);
  {
    result: match exchange.result {
      Ok(result) => Ok(result.message.content),
      Err(e) => Err("${e.code}: ${e.message}")
    },
    next_state: exchange.next_state
  }
}

-- The extension-side clock stays UN-ROUTED, deliberately, and this comment is
-- the whole reason why.
--
-- HISTORY, KEPT DELIBERATELY, AND IN THE PAST TENSE (plan rule S15). Everything
-- below describes the state between WI-A12 and WI-C5. **WI-C5 widened
-- `ExtPorts.clock_now` to `(ExtWorld) -> ExtClockReading` and the seam is now
-- ROUTED — see `ext_ports_of` above.** The block is kept rather than deleted
-- because the measurement in it (what does and does not parse on the pin) is
-- the evidence for a language limitation that is still true, and a future item
-- reaching for a zero-argument port will want it. The CONCLUSION it reaches —
-- "the ambient read is chosen" — is retired.
--
-- WI-A12 widened `Ports.clock_now` to be state-threaded. `ExtPorts.clock_now`
-- WAS `() -> int`, and widening it was the Milestone B ABI major (D1), out of
-- A12's scope by the plan's own boundary — the eight `motoko-ext-compose` clock
-- sites and this seam belonged to WI-C5. The seam half is done; the eight
-- compose sites are NOT, and are reported unrouted at WI-C5 rather than
-- silently carried.
--
-- Bridging the two WOULD HAVE NEEDED a `() -> int` closure capturing the world, and on
-- pinned AILANG v0.26.0 that CANNOT BE WRITTEN: zero-argument lambdas do not
-- parse in expression position (`func() ->` lexes `()` as the unit token, and
-- `func ( ) ->` builds a one-parameter function of unit — "arity mismatch:
-- 0 vs 1"), and partial application is not supported either ("cannot unify
-- type constructor int with TFunc2"). Only the top-level declaration form
-- `func f() -> T` is zero-arity, and a top-level function captures nothing.
-- Both were measured on the pin, not assumed.
--
-- So the choice was between two un-routed options, and the deciding question is
-- which one FAILS LOUDLY if someone adds the first caller before C5:
--
--   * a frozen constant / world snapshot — silently wrong, the exact shape of
--     cluster 1's pinned cursor, and invisible to every gate; or
--   * the ambient read below — which makes a deterministic run with `Clock`
--     withheld DIE the moment a caller appears, turning the world_state poison
--     probe red and naming the problem.
--
-- The ambient read WAS chosen for that reason, and WI-C5 REMOVED IT — the
-- prediction in the last sentence of this paragraph is the one that came true.
-- The widening it was waiting on is the one thing that could retire it, because
-- the obstacle was the port's SHAPE and not its call sites: a two-argument port
-- could always have been bridged, which is the whole of plan rule S3.
-- Project a typed tool outcome onto the un-widened `ExtPorts.proc_exec` string
-- return. Faults are RENDERED rather than dropped: an extension handed "" when
-- a tool actually failed is the silent-wrong shape this whole item exists to
-- remove, even on a seam A12 does not own.
pure func tool_outcome_text(o: ToolOutcome) -> string {
  match o {
    ToolCompleted(c) => c.content,
    ToolFailed(f) => encode(jo([kv("error", jb(true)), kv("code", js(f.code)), kv("message", js(f.message)), kv("tool_call_id", js(f.tool_call_id))])),
    ToolCorrelationMismatch(m) => encode(jo([kv("error", jb(true)), kv("code", js("ToolCorrelationMismatch")), kv("expected_id", js(m.expected_id)), kv("got_id", js(m.got_id))])),
    ToolDeadlineExceeded(d) => encode(jo([kv("error", jb(true)), kv("code", js("ToolDeadlineExceeded")), kv("tool_call_id", js(d.tool_call_id)), kv("elapsed_ms", jnum(_int_to_float(d.elapsed_ms))), kv("timeout_ms", jnum(_int_to_float(d.timeout_ms)))]))
  }
}

-- The exit-code projection beside the text one (WI-D23), deliberately NOT
-- folded into `tool_outcome_text`: the string is the model-facing message and
-- is unchanged; this is the typed half `ExtProcOutcome.exit_code` carries.
-- `ToolCompleted` hands through the code the dispatcher stated — since WI-D23
-- that is the real subprocess code on the live arm and the script's on the
-- scripted one — and the three fault variants project to -1, because none of
-- them is a process that exited and their discrimination already travels,
-- rendered, in the text projection above. Without this function the field
-- WI-D22 put on `ToolCompleted` would die one seam short of the only caller
-- the seam exists for.
pure func tool_outcome_exit_code(o: ToolOutcome) -> int {
  match o {
    ToolCompleted(c) => c.exit_code,
    ToolFailed(_) => -1,
    ToolCorrelationMismatch(_) => -1,
    ToolDeadlineExceeded(_) => -1
  }
}

pure func decode_or_empty(raw: string) -> Json {
  match decode(raw) { Ok(j) => j, Err(_) => jo([]) }
}

-- EXPORTED AT WI-D23, for one consumer: `world_state_probe`'s adoption row,
-- which per S14 must exercise THIS bridge's `proc_exec` closure against a
-- scripted world — a substrate probe that rebuilds the closure's shape would
-- measure its own fidelity, not the bridge. Production still has exactly the
-- four `mk_v2_ext_ctx` call sites below; nothing else should construct an
-- `ExtPorts` from a driver world.
export func ext_ports_of(p: Ports, world: WorldState, base_url: string) -> ExtPorts ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace} {
  -- WI-B2b. The bridge takes the token IN and returns the successor OUT, so
  -- this closure captures no world at all — which is the point.
  --
  -- UPDATED AT WI-D16. This note used to read "`world` below is still captured
  -- by `env_get` and `proc_exec`, and those two remain classifier-2 members
  -- precisely because they cannot return a successor." `proc_exec` no longer
  -- does either: it takes the token now, so `env_get` is the LAST closure in
  -- this bridge that captures `world`, and it is the last classifier-2 member.
  -- That is deliberate and its reason is on the ABI row — its problematic
  -- callers are in `register_with_config`, which has no `ExtCtx` to reach any
  -- of this through.
  --
  -- THE `let w0` IS LOad-BEARING FOR A TOOL, not for the compiler.
  -- `tools/ext_call_inventory/derive.py` decides whether this field reaches a
  -- core `Ports` seam by following ONE level of named call that forwards the
  -- port — and its matcher for that call is `\b(IDENT)\s*\(([^()]*)\)`, which
  -- cannot match an argument list containing nested parentheses. Written
  -- inline as `ext_ai_step(p, token_to_world(w), ...)` the tool fails to follow
  -- the call, reports `ai_step` as **unrouted**, and that is its documented
  -- FAIL-OPEN answer — "the single most expensive bug in this tool's history",
  -- in its own words. It looks like a clean result. Keep the conversion in its
  -- own `let`, and if you must inline it, fix the tool first.
  let ai_step = func(w: ExtWorld, model: string, msgs: [Msg]) -> AiStepOutcome ! {AI, IO, Trace} {
    let w0 = token_to_world(w);
    let out = ext_ai_step(p, w0, model, base_url, msgs);
    { result: out.result, next_state: world_to_token(out.next_state) }
  };
  let env_get = func(key: string, fallback: string) -> string ! {Env} {
    p.env_get(world, key, fallback).value
  };
  -- WI-D16 widens this seam. HISTORY, in the past tense per plan rule S15: it
  -- WAS `(string, string) -> string`, and it captured `world` from this bridge's
  -- parameter rather than taking one — which it could, because two-argument
  -- fields can capture (plan rule S3). Capturing was never the problem. The
  -- problem was the RETURN: `p.tool_exec` hands back a `ToolExecution` whose
  -- `next_state` this closure read and then threw away, so a scripted tool call
  -- that consumed a `state.tools` entry and advanced the clock advanced a world
  -- no caller could see. That is the drop classifier 2 selected it for.
  --
  -- Written with the SAME `let w0` shape as `ai_step` and `clock_now`, and for
  -- the same tool reason rather than for symmetry — see `ai_step`'s note above.
  --
  -- The typed outcome is PROJECTED TWICE (WI-D23): `tool_outcome_text` renders
  -- it onto `output` — the model-facing string, unchanged since WI-D16 — and
  -- `tool_outcome_exit_code` carries the one quantity a caller branches on
  -- into the typed field WI-D23 added to `ExtProcOutcome`. The four-variant
  -- fault DISCRIMINATION still does not cross the ABI; faults stay RENDERED
  -- rather than dropped, so an extension is not handed "" when a tool actually
  -- failed, and which fault class it was is still a string fact — that residue
  -- is the catalogue's `extension_effect_fault` coverage-gap entry.
  --
  -- =========================================================================
  -- WI-D21: WHAT THIS SEAM ACTUALLY DOES, MEASURED END TO END AT THE SEAM.
  -- =========================================================================
  --
  -- WI-D19 and WI-D20 both concluded "the seam does not front subprocesses; it
  -- fronts Motoko's own tool names". That is TRUE ABOUT WHAT IT FRONTS and it
  -- produced the wrong menu for both of them, so the capability is recorded
  -- here — at the seam — rather than in two extension packages' comments.
  --
  -- The two strings are a MOTOKO TOOL NAME and that tool's JSON ARGUMENTS. The
  -- parameters were called `name` and `args`, which is why three `noop_proc_exec`
  -- bindings in the tree call them `_cmd` and `_cwd` instead: the field is named
  -- `proc_exec`, the ABI row types them `(ExtWorld, string, string)` and
  -- documented neither, so five sites in the tree read two positional strings two
  -- INCOMPATIBLE ways and nothing type-checks the difference. Renamed at WI-D21.
  --
  -- AND `BashExec` REACHES A REAL SUBPROCESS WITH A REAL EXIT CODE. Followed
  -- down rather than grepped:
  --
  --   `p.tool_exec` -> `world_tool` (`ports.ail:1264`), which on an empty
  --   `state.tools` delegates to `dispatch_one` -> `run_native_batch` ->
  --   `run_native_call` (`tool_runtime.ail:165`). That if-chain's `BashExec` arm
  --   calls `run_process_result`, which `exec`s the command and builds
  --   `BashExecResult { cmd, stdout, stderr, exit_code, meta }`
  --   (`tool_runtime.ail:842`). `dispatch_one` then encodes that record to JSON
  --   (`tool_dispatch_adapter.ail:178`) and it arrives here as
  --   `ToolCompleted.content`.
  --
  -- SO THE EXIT CODE WAS NEVER LOST; THE TYPE WAS — AND WI-D23 CLOSED THAT,
  -- with the history kept two-part per S15. Through WI-D22 this paragraph
  -- read: "a caller wanting to branch on it must decode a string and pull
  -- `exit_code` — the string-parsing path WI-D19 correctly refused... it
  -- cannot reach `ScriptedTool` without a program-schema version bump, so it
  -- is scheduled rather than absorbed." WI-D22 shipped the bump and WI-D23
  -- shipped the remaining live-side links: `dispatch_one_typed` returns the
  -- code beside the content, `world_tool`'s live arm binds both, and this
  -- closure projects `ToolCompleted.exit_code` into
  -- `ExtProcOutcome.exit_code`. A caller branches on a typed field; nothing
  -- on this path parses `content`'s JSON.
  --
  -- TWO FIELDS ARE CONSTANTS AND BOTH ARE CLAIMS. `workdir` is "." and not
  -- `ctx.workdir` — this bridge is built by `ext_ports_of`, which takes no
  -- workdir — so a routed subprocess runs where the process was started, not
  -- where the extension thinks it is. `timeout_ms` is 0, which
  -- `ToolInvocation.timeout_ms` defines as "no deadline", so this seam can never
  -- produce `ToolDeadlineExceeded`. Both are stated rather than left for the
  -- first caller.
  --
  -- THE CALL ID IS BLANK, AND WI-D24 MADE THAT LEGITIMATE INSTEAD OF FATAL. The
  -- history is kept two-part per S15 because the defect is what decided the
  -- design, and the fix is only legible against it.
  --
  -- WHAT THIS BLOCK SAID THROUGH WI-D23, and it was measured and true: "THE CALL
  -- ID IS BLANK AND THAT IS A REJECTED PROGRAM, NOT A COSMETIC GAP.
  -- `recording_tool` records `ToolIdentity("loop_v2", inv.call.id, inv.call.tool)`,
  -- and `dst_program.validate_identity` rejects a blank `ToolIdentity` call id
  -- with `IdentityComponentMissing(o, "tool call_id")`. So the FIRST extension to
  -- call this seam in a recorded run makes the recorder emit a program its own
  -- validator refuses." Nothing called the seam, so the defect was latent; WI-D21
  -- asserted it rather than describing it.
  --
  -- WHAT IS TRUE AT HEAD: this closure no longer calls `tool_exec` at all. It
  -- calls `Ports.ext_effect_exec`, whose recording adapter is
  -- `ports.recording_ext_effect` — the EIGHTH — and which writes
  -- `ExtensionEffectIdentity(holder, extension_effect_fault, "")`. The blank call
  -- id is now in the one class D2 exempts, the origin names the EXTENSION rather
  -- than the driver's loop, and the recorded interaction VALIDATES. The defect
  -- WI-D21 §4 found is closed by measurement, not by argument: the round-trip row
  -- in `scripts/dst/ext_effect_dst.ail` records through this closure, validates
  -- the program with zero rejections, and replays it with the dispatch SERVED
  -- from the world.
  --
  -- The blank was never a slip a better `id` would fix. This seam has no call id
  -- BECAUSE THE EFFECT HAS NONE — the extension is not answering a model tool
  -- call — and D2 names exactly one class where that is legitimate:
  -- `ExtensionEffectIdentity`, whose own comment says the call id is "" "where
  -- the effect has none — the only place a blank component is legitimate rather
  -- than a missing required value".
  --
  -- THE TWO HALVES THE CLASS NEEDED, AND WHERE THEY CAME FROM:
  --
  --   THE CLASS ID ALREADY EXISTED. `validate_static_references` requires a
  --   non-blank `class_id` to be a catalogue row, and A7 declares ELEVEN — five
  --   provider, three tool, two approval, and `extension_effect_fault`
  --   (`dst_fault_catalogue.ail`, in `required_class_ids()`). That row's own
  --   coverage-gap entry has named THIS SEAM since WI-C5. WI-D24 reads it through
  --   `fault_class_extension_effect()` rather than copying the literal.
  --
  --   THE EXT ID CAME FROM THE FOLD, NOT FROM HERE. WI-D21 wrote that "per-extension
  --   ports, or an `ext_id` on `ExtCtx`, closes it"; measured, neither did. This
  --   closure is built once per step from a registry it cannot index, and the ONE
  --   place that knows which extension is about to run is `ext/runtime`'s fold —
  --   which cannot call back into this module without closing an import cycle
  --   (`session.ail:52`). An `ExtCtx.ext_id` would tell the hook something it
  --   already knows and would still not reach this closure, whose ABI signature
  --   `(ExtWorld, string, string)` is fixed below 6.0. So the fold stamps the id
  --   into the world token it ALREADY re-seats per hook, and the adapter reads it
  --   off `WorldState.holder_ext_id`. See that field for the full argument.
  --
  -- AND WI-D19'S PIN IN `dst_discovery.absent_classes` MOVED, at last, the way
  -- D19's three filesystem classes did. Through WI-D23 this block ended: "the pin
  -- is right and the reason on record is wrong. Reported rather than re-worded in
  -- place; see WI-D21 §5." WI-D21 declined to re-word it so that the measured
  -- refutation of D19's "structural" ground stayed visible, and WI-D24 is the item
  -- that earns the re-wording: the class now has an adapter, so `absent_classes`
  -- takes a WITNESS instead of a literal zero and the pin survives for every run
  -- that routes nothing. `RandomDrawIdentity` stays pinned at literal zero — its
  -- ground is unchanged, and it is still true that no adapter constructs it.
  let proc_exec = func(w: ExtWorld, tool: string, args_json: string) -> ExtProcOutcome ! {IO, Process, FS} {
    let w0 = token_to_world(w);
    let inv: ToolInvocation = {
      call: { id: "", tool: tool, arguments: decode_or_empty(args_json) },
      workdir: ".",
      timeout_ms: 0,
      started_at_ms: 0
    };
    -- `ext_effect_exec` AND NOT `tool_exec` SINCE WI-D24. Same shape, different
    -- class: this dispatch is the extension's, it is served from
    -- `WorldState.ext_effects`, and it is recorded as
    -- `ExtensionEffectIdentity(w0.holder_ext_id, extension_effect_fault, "")`.
    -- The id comes off the world because this closure is built once per step and
    -- cannot name its caller; `ext/runtime`'s fold stamps it on the re-seat.
    let execution = p.ext_effect_exec(w0, inv);
    { output: tool_outcome_text(execution.outcome),
      exit_code: tool_outcome_exit_code(execution.outcome),
      next_state: world_to_token(execution.next_state) }
  };
  -- WI-D16's file read seam, bridged to WI-D3's `Ports.file_read`. Same `let w0`
  -- shape, same tool reason.
  --
  -- `present` is FORWARDED rather than re-derived from `content`. The core seam
  -- already carries the distinction explicitly and collapsing it here would
  -- reintroduce, at the bridge, exactly the empty-file-versus-missing-file
  -- confusion `FileRead` was shaped to prevent — one layer below where anyone
  -- would look for it.
  let file_read = func(w: ExtWorld, path: string) -> ExtFileRead ! {FS} {
    let w0 = token_to_world(w);
    let read = p.file_read(w0, path);
    { present: read.present, content: read.content, next_state: world_to_token(read.next_state) }
  };
  -- WI-D17's two filesystem MUTATOR seams, bridged to `Ports.file_write` and
  -- `Ports.file_remove`. Same `let w0` shape, same tool reason as every seam
  -- above: `derive.py`'s call matcher cannot follow an argument list with nested
  -- parentheses, so the conversion stays in its own `let` (S3, and WI-B2b paid
  -- for discovering it).
  --
  -- `ok` and `error` are FORWARDED rather than collapsed, for the reason
  -- `file_read`'s `present` is: the core seam carries the distinction and
  -- re-deriving it here — say, `ok: error == ""` — would put the same fact in two
  -- homes at the bridge, one layer below where anyone would look for it.
  let file_write = func(w: ExtWorld, path: string, content: string) -> ExtFileMutation ! {FS} {
    let w0 = token_to_world(w);
    let done = p.file_write(w0, path, content);
    { ok: done.ok, error: done.error, next_state: world_to_token(done.next_state) }
  };
  let file_remove = func(w: ExtWorld, path: string) -> ExtFileMutation ! {FS} {
    let w0 = token_to_world(w);
    let done = p.file_remove(w0, path);
    { ok: done.ok, error: done.error, next_state: world_to_token(done.next_state) }
  };
  -- WI-D18's three DIRECTORY seams. Same `let w0` shape and the same S3 tool
  -- reason as every seam above.
  --
  -- THE KIND IS TRANSLATED BY AN EXHAUSTIVE MATCH AND NOT BY A STRING. `PathKind`
  -- and `ExtPathKind` are two three-valued sums, and this is the one place they
  -- meet; a `path_kind_label` round trip through a string would type-check, would
  -- collapse an unrecognised label onto some default, and would put the
  -- vocabulary in two homes on either side of the boundary. The match is what
  -- makes a fourth constructor on either sum a compile error here.
  let path_stat = func(w: ExtWorld, path: string) -> ExtPathStat ! {FS} {
    let w0 = token_to_world(w);
    let stat = p.path_stat(w0, path);
    let k = match stat.kind {
      PathMissing => ExtPathMissing,
      PathFile => ExtPathFile,
      PathDir => ExtPathDir
    };
    { kind: k, next_state: world_to_token(stat.next_state) }
  };
  -- `present` and `entries` are FORWARDED rather than re-derived. Deriving
  -- `present: List.length(entries) > 0` here would type-check and would erase the
  -- empty-directory-versus-absent-path distinction that the core class was built
  -- to carry — one expression away from a silent wrong answer, at the boundary
  -- rather than in the world.
  let dir_list = func(w: ExtWorld, path: string) -> ExtDirListing ! {FS} {
    let w0 = token_to_world(w);
    let listing = p.dir_list(w0, path);
    { present: listing.present, entries: listing.entries, next_state: world_to_token(listing.next_state) }
  };
  let dir_make = func(w: ExtWorld, path: string) -> ExtFileMutation ! {FS} {
    let w0 = token_to_world(w);
    let done = p.dir_make(w0, path);
    { ok: done.ok, error: done.error, next_state: world_to_token(done.next_state) }
  };
  -- WI-C5 routes the clock. It is written with the SAME `let w0` shape as
  -- `ai_step` above and for the same tool reason, not for symmetry: the
  -- inventory's call matcher cannot follow an argument list with nested
  -- parentheses, so `p.clock_now(token_to_world(w))` written inline would be
  -- reported UNROUTED — and that is the tool's fail-open answer, which looks
  -- like a clean result. Keep the conversion in its own `let`.
  let clock_now = func(w: ExtWorld) -> ExtClockReading ! {Clock} {
    let w0 = token_to_world(w);
    let reading = p.clock_now(w0);
    { now_ms: reading.now_ms, next_state: world_to_token(reading.next_state) }
  };
  {
    ai_step: ai_step,
    proc_exec: proc_exec,
    -- WI-D16. Nothing calls it yet — this item ships the seam and routes no
    -- extension (that is part 2). A seam with no callers is the situation WI-D3
    -- hit with `clock_now`; it is reported rather than presented as coverage.
    file_read: file_read,
    -- WI-D17. Nothing calls these either, and the reason they are here anyway is
    -- the ordering `derive.py` measures: the core class exists, so they derive
    -- `returns-it` rather than `unrouted`.
    file_write: file_write,
    file_remove: file_remove,
    -- WI-D18. Nothing calls these three either; they are here because the core
    -- classes exist, which is what makes them derive `returns-it`.
    path_stat: path_stat,
    dir_list: dir_list,
    dir_make: dir_make,
    -- WI-C5. Was `ext_unrouted_clock` — an ambient `now()` that plan rule S2
    -- chose deliberately, because `ExtPorts.clock_now`'s `() -> int` shape
    -- admitted no world capture and the alternative was a frozen snapshot that
    -- no gate could see. The ABI widening removed the shape obstacle, so the
    -- seam is now routed through the world like every other, and the S2
    -- exception it justified is retired rather than merely unused.
    clock_now: clock_now,
    -- `env_get` was routed even before that, because it is two-argument and a
    -- closure capturing the world could always be written for it. That
    -- difference — parameter count, nothing else — is the whole of what plan
    -- rule S3 is about.
    env_get: env_get
  }
}



pure func ext_token_telemetry(t: { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int }) -> TokenTelemetry {
  { last_input_tokens: t.last_input_tokens, last_output_tokens: t.last_output_tokens, last_estimated_input_tokens: t.last_estimated_input_tokens }
}

-- Normalise the caller-supplied StepProvider into the Ports seam, once, before
-- the loop starts. This is the completion of WI-C13c ("Wire model dispatch
-- through ports"): that commit introduced the normalisation but left
-- StepProvider in C2LoopState, so `dispatch_step` and `ext_ports_for_provider`
-- kept LiveAI/Scripted branches that no entry point could reach. Returning
-- Ports makes the invariant structural instead of conventional.
--
-- StepProvider remains the *entry-point argument* type — callers still pass
-- LiveAI or Scripted(script); it just does not survive into loop state.
--
-- WI-A2: it now returns the initial world alongside the Ports. The script rides
-- in that world rather than being baked into a closure, which is what lets the
-- driver own the cursor.
--
-- WI-A12 deleted the `history` parameter. It existed solely to compute the
-- `base_assistant_count` that A2 retired — the derived index that WAS the F6
-- defect — and A2 kept it only because D1 holds this seam stable until
-- `world_state` replaces it. This is that replacement, so the parameter goes
-- with it (cluster 1, C5). Six call sites, all of which were passing a message
-- list nothing read.
func ported_provider(rt: ExtRuntime, provider: StepProvider) -> PortedProvider ! {AI, Clock, Env, FS, IO, Process, Trace}{
  match provider {
    Ported(p) => { ports: p, world: empty_world_state() },
    LiveAI => { ports: live_ports(rt), world: empty_world_state() },
    Scripted(script) => { ports: scripted_ports(), world: scripted_world_state(script) },
    ScriptedWorld(world) => { ports: scripted_ports(), world: world },
    -- WI-A13 stage 2. Same world, recording adapters. `driver_only` discovery
    -- is the only caller.
    RecordingWorld(world) => { ports: recording_ports(rt), world: world },
    -- WI-A13 stage 4. The recording adapters with D2's seeded generator on top:
    -- the world's script, approval and tool cursors start EMPTY and each
    -- response is chosen at the request that asks for it. `make seeded_generator`
    -- is the only caller.
    GeneratedWorld(world) => { ports: generating_ports(rt), world: world }
  }
}

pure func c2_add_step_totals(totals: RuntimeLoopTotals, result: StepResult, step_cost: int, warned_pct: int) -> RuntimeLoopTotals {
  {
    input_tokens: totals.input_tokens + result.input_tokens,
    output_tokens: totals.output_tokens + result.output_tokens,
    cache_read: totals.cache_read + result.cache_read_input_tokens,
    cache_creation: totals.cache_creation + result.cache_creation_input_tokens,
    cost_millicents: totals.cost_millicents + step_cost,
    cost_warned_pct: warned_pct
  }
}

func c2_emit_cost_warning(
  session_id: string,
  step_idx: int,
  total_cost_millicents: int,
  max_cost_millicents: int,
  already_warned_pct: int
) -> int ! {IO, Trace} {
  if max_cost_millicents > 0 then {
    let pct = (total_cost_millicents * 100) / max_cost_millicents;
    if pct >= 90 && already_warned_pct < 90 then {
      let _ = ledger_emit(session_id, CostWarning({ threshold: "90pct", step: step_idx, pct: pct, total_cost_millicents: total_cost_millicents, total_cost_usd: millicents_to_usd(total_cost_millicents), cap_millicents: max_cost_millicents }));
      90
    } else if pct >= 75 && already_warned_pct < 75 then {
      let _ = ledger_emit(session_id, CostWarning({ threshold: "75pct", step: step_idx, pct: pct, total_cost_millicents: total_cost_millicents, total_cost_usd: millicents_to_usd(total_cost_millicents), cap_millicents: max_cost_millicents }));
      75
    } else if pct >= 50 && already_warned_pct < 50 then {
      let _ = ledger_emit(session_id, CostWarning({ threshold: "50pct", step: step_idx, pct: pct, total_cost_millicents: total_cost_millicents, total_cost_usd: millicents_to_usd(total_cost_millicents), cap_millicents: max_cost_millicents }));
      50
    } else already_warned_pct
  } else already_warned_pct
}

pure func c2_done_step(step_idx: int) -> int {
  if step_idx <= 0 then 0 else step_idx - 1
}

-- append_stream_delta: dispatch one StreamChunk variant to the ledger.
-- protocol.
--
-- ContentDelta(text) → thinking_delta event (TUI appends to per-stream_id
--                       buffer in arrival order; this is the assistant's
--                       visible content as it streams).
-- ThinkingDelta(text) → reasoning_delta event (NEW v0.18.8; AILANG-side
--                       API-level thinking from claude-opus-4.5+,
--                       OpenAI o1/o3, Gemini 2.5+ thinking models). TUI
--                       renders in a separate panel; never mixed with
--                       content stream.
-- Usage(_)            → dropped here (final usage telemetry comes from
--                       the StepResult.{input,output,cache}_*_input_tokens
--                       fields after the call returns).
--
-- Tag-convention reasoning (glm-5, deepseek-r1: <thinking>...</thinking>
-- inside ContentDelta) is NOT split here — that belongs in the TUI's
-- streaming-render path which already strips think-tag bodies for live
-- render via stripThinkBlocksForLive().
--
-- Extracted from agent_loop_v2 because match inside lambda hits a known
-- AILANG parser bug.
--
-- WI-C3: THE MAPPING ITSELF NOW LIVES IN ONE PLACE, `stream_chunk_event`, and
-- that is load-bearing rather than tidy. D6.4's parity check compares a witness
-- built from the returned chunk log against the StreamDelta records that reach
-- the returned trace. Two converters would be two notions of one quantity, and
-- the disagreement would show up as a parity finding blaming the driver for a
-- difference the CHECK introduced. In particular `Usage` is RETURNED by
-- `stepWithStreamRecorded` and is NOT projected, so a witness built by mapping
-- every chunk to a StreamDelta is off by one on every real run — the naive
-- version reports StreamParityCount(N+1, N) forever, and the two-line repairs
-- for that (skip the check when the witness is empty; loosen count to a subset
-- test) both make the invariant vacuous while looking like fixes.
func append_stream_delta(session_id: string, step_idx: int, stream_id: string, chunk: StreamChunk) -> () ! {IO, Trace} {
  match stream_chunk_event(step_idx, stream_id, chunk) {
    Some(e) => ledger_emit(session_id, e),
    None => ()
  }
}

-- The single StreamChunk -> Option[LedgerEvent] core. `None` is "this chunk is
-- not a logical emission", which today is exactly `Usage`.
export pure func stream_chunk_event(step_idx: int, stream_id: string, chunk: StreamChunk) -> Option[LedgerEvent] {
  match chunk {
    ContentDelta(text) =>
      Some(StreamDelta({
        step: step_idx,
        stream_id: stream_id,
        seq: 0,
        kind: "thinking",
        text: text
      })),
    ThinkingDelta(text) =>
      Some(StreamDelta({
        step: step_idx,
        stream_id: stream_id,
        seq: 0,
        kind: "reasoning",
        text: text
      })),
    Usage(_) => None
  }
}

-- The same core over a returned chunk log, preserving order and dropping the
-- non-projected variants. This is what the driver appends to the returned trace
-- AND what it accumulates as D6.4's emission witness — one function, so the
-- `Usage` exclusion and the thinking/reasoning selection cannot drift apart.
--
-- What parity therefore does NOT test, stated so the green is not over-read:
-- whether this mapping is RIGHT. Both sides use it, so a wrong `kind` is
-- invisible here. That is A8's event-vocabulary contract, not D6.4's.
export pure func stream_chunk_events(step_idx: int, stream_id: string, chunks: [StreamChunk]) -> [LedgerEvent] {
  match chunks {
    [] => [],
    c :: rest =>
      match stream_chunk_event(step_idx, stream_id, c) {
        Some(e) => e :: stream_chunk_events(step_idx, stream_id, rest),
        None => stream_chunk_events(step_idx, stream_id, rest)
      }
  }
}

-- THE OFF-BY-ONE, pinned. `--ai-stub` returns TWO chunks — a ContentDelta and a
-- Usage — and a live provider's returned log carries Usage too, so a witness
-- built by mapping every returned chunk yields N+1 against the trace's N and
-- `stream_parity_findings` reports StreamParityCount on every real run. No
-- scripted world in this tree plays a Usage chunk, so no acceptance script can
-- reach this and it would be caught only on a live provider. It is a unit test
-- for that reason, and the value is the DIFFERENCE rather than the count: a row
-- asserting `== 2` is also green on an implementation that drops the first
-- ContentDelta instead.
pure func test_usage_chunks_are_not_projected() -> bool
  tests [((), true)]
  {
    let with_usage = [ContentDelta("a"), Usage({ input_tokens: 0, output_tokens: 0, cache_read_input_tokens: 0, cache_creation_input_tokens: 0 }), ContentDelta("b")];
    let without = [ContentDelta("a"), ContentDelta("b")];
    List.length(stream_chunk_events(0, "s", with_usage)) + 1 == List.length(with_usage)
      && List.length(stream_chunk_events(0, "s", with_usage)) == List.length(stream_chunk_events(0, "s", without))
  }

-- The kind selection, pinned separately from the exclusion. Both live in
-- `stream_chunk_event` and a single row over a mixed list cannot say which of
-- the two it read.
pure func test_thinking_and_reasoning_kinds_are_distinguished() -> bool
  tests [((), true)]
  {
    match stream_chunk_events(3, "sid", [ContentDelta("c"), ThinkingDelta("t")]) {
      a :: rest =>
        match rest {
          b :: [] =>
            match a {
              StreamDelta(ia) =>
                match b {
                  StreamDelta(ib) =>
                    ia.kind == "thinking" && ia.text == "c"
                      && ib.kind == "reasoning" && ib.text == "t"
                      && ia.step == 3 && ib.stream_id == "sid",
                  _ => false
                },
              _ => false
            },
          _ => false
        },
      [] => false
    }
  }

-- Derive a session_id from MOTOKO_SESSION_ID env var (set by the TS wrapper
-- to match the JSONL filename) or fall back to a clock-derived id. The
-- wrapper-set form is preferred so the JSONL session_id matches the
-- filename consumers grep for.
--
-- WI-A12's clock class: the fallback reads the world clock through the port
-- rather than ambient `now()`, and returns its successor. Returning the
-- successor matters even though the env-var branch never advances the clock —
-- the two branches must be interchangeable from the caller's side, and a
-- read-shaped function that sometimes swallows its successor is how a cursor
-- silently stops advancing.
func derive_session_id(ports: Ports, world: WorldState) -> { id: string, next_state: WorldState } ! {Env, Clock} {
  let env_id = ports.env_get(world, "MOTOKO_SESSION_ID", "");
  if env_id.value != "" then { id: env_id.value, next_state: env_id.next_state }
  else {
    let reading = ports.clock_now(env_id.next_state);
    { id: "session_${show(reading.now_ms)}", next_state: reading.next_state }
  }
}

-- Build the standard kv-list emitted on every per-step event that has
-- StepResult tokens in scope. `cost_step_mc` is the per-step millicents
-- (computed from result.input_tokens/output_tokens × cost_rates).
--
-- Cache token fields (cache_read_input_tokens / cache_creation_input_tokens)
-- are emitted ONLY when non-zero — omit-when-absent semantics so consumers
-- can distinguish "provider doesn't surface caching" from "this turn had
-- zero cache hits". Anthropic populates both; OpenAI + Gemini populate
-- cache_read only; other providers omit both.
func per_step_usage_kvs(result: StepResult, cost_step_mc: int) -> [{key: string, value: Json}] {
  let base = [
    kv("input_tokens",  jnum(_int_to_float(result.input_tokens))),
    kv("output_tokens", jnum(_int_to_float(result.output_tokens))),
    kv("cost_usd",      jnum(millicents_to_usd(cost_step_mc)))
  ];
  let with_read = if result.cache_read_input_tokens > 0 then
    base ++ [kv("cache_read_input_tokens", jnum(_int_to_float(result.cache_read_input_tokens)))]
    else base;
  if result.cache_creation_input_tokens > 0 then
    with_read ++ [kv("cache_creation_input_tokens", jnum(_int_to_float(result.cache_creation_input_tokens)))]
    else with_read
}

-- finish_reason_str(r: int) lived here. It is gone: D6.2 requires a typed
-- termination reason derived from the reachable terminal returns, and the wire
-- mapping now lives beside RunSummaryInfo as phase_vocab.finish_reason_wire.
-- No integer termination code survives at any terminal call site.

-- Build the schema-v1 run_summary event. Split out from the finalizer so the
-- record that is projected and the record that is appended are provably the
-- same value, not two constructions that could drift.
pure func mk_run_summary(
  model: string,
  totals: RuntimeLoopTotals,
  steps_executed: int,
  reason: TerminationReason,
  error_msg: string,
  duration_ms: int,
  commit: string
) -> LedgerEvent {
  RunSummary({
    model: model,
    motoko_commit: commit,
    finish_reason: finish_reason_wire(reason),
    steps_executed: steps_executed,
    input_tokens: totals.input_tokens,
    output_tokens: totals.output_tokens,
    cache_read_input_tokens: totals.cache_read,
    cache_creation_input_tokens: totals.cache_creation,
    total_cost_usd: millicents_to_usd(totals.cost_millicents),
    total_cost_millicents: totals.cost_millicents,
    duration_ms: duration_ms,
    error: error_msg
  })
}

-- THE finalizer (D6.1). Every terminal return in the driver goes through here.
--
-- It does both halves of the contract in one place: it emits the run_summary
-- projection (what downstream eval harnesses consume) AND appends the same
-- record to the returned LedgerTrace (what the invariant oracle consumes).
-- Before this, only the projection existed — emit_run_summary's sole ledger
-- operation was ledger_emit, so the returned trace contained no RunSummary on
-- any path, and the returned trace is what D6 makes authoritative.
--
-- Centralizing it is the point: a new terminal path cannot update one channel
-- and silently miss the other, because there is only one channel to call.
-- The RunSummary is appended last, so it is the final record of the trace.
-- WI-A12's clock class: `ports`/`world` replace the ambient `now()` below. This
-- is the fourth and last driver clock site, and the only one inside the loop.
--
-- The successor world is DISCARDED here, uniquely in the driver. That is sound
-- only because this is the terminal read — nothing observes the world after a
-- terminal return, since c2_finalize holds the sole terminal record literal
-- (the structural guard `make terminal_trace` enforces). Any future read added
-- BEFORE this one must thread its successor rather than copy this pattern.
--
-- The guard is a `grep -c` over this file. WI-A13 stage 2 anchored it so that a
-- comment line cannot satisfy it, which retired the standing obligation to
-- circumlocute around the pattern in prose here — see `make terminal_trace`.
func c2_finalize(
  ports: Ports,
  world: WorldState,
  session_id: string,
  model: string,
  totals: RuntimeLoopTotals,
  steps_executed: int,
  reason: TerminationReason,
  error_msg: string,
  started_at_ms: int,
  trace: LedgerTrace,
  emissions: [LedgerEvent],
  result: Result[[Message], AIError]
) -> TracedSessionResult ! {IO, Clock, Trace} {
  -- The successor of this read is now THREADED into the returned world rather
  -- than discarded. Under the recording adapters this final clock read is an
  -- interaction like any other, and dropping its successor would drop the log
  -- entry with it — the run would end having recorded one fewer request than it
  -- made, which is precisely the under-recording defect discovery exists to
  -- detect. The comment above this function already required a future read to
  -- thread its successor; this makes the existing one do so too.
  let reading = ports.clock_now(world);
  let now_ms = reading.now_ms;
  let summary = mk_run_summary(model, totals, steps_executed, reason, error_msg, now_ms - started_at_ms, motoko_commit());
  let _ = ledger_emit(session_id, summary);
  { result: result, trace: ledger_append(trace, WireRecord(summary)), world: reading.next_state, emissions: emissions }
}

