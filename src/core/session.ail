-- Build the per-turn ExtCtx that motoko's extension hooks receive. Mirrors
-- mk_ext_ctx in rpc.ail but constructs from v2's typed-loop state instead
-- of the legacy AgentState shape. history_slice converts upstream Message
-- to motoko's Msg (text-only) since extensions inspect text not tool_calls.
func mk_v2_ext_ctx(
  task: string,
  step_idx: int,
  model: string,
  cwd: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  history: [Message],
  context_limit: int,
  ports: ExtPorts,
  artifacts: Json,
  telemetry: { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int },
  -- WI-B2b. The driver's CURRENT world, tokenised. Every caller passes
  -- `world_to_token(st.world_state)` — the live cursor, not a fresh one — which
  -- is what makes the hook's successor meaningful when it comes back.
  world: ExtWorld
) -> ExtCtx {
  let remaining = if budget.total - step_idx < 0 then 0 else budget.total - step_idx;
  {
    task: task,
    step: step_idx,
    model: model,
    cwd: cwd,
    hybrid_tools: hybrid_tools,
    budget: budget,
    mode: "v2",
    workdir: cwd,
    env_server_url: env_url,
    budget_remaining: remaining,
    history_slice: messages_to_msgs(history),
    state_key: "core:ext:v2",
    context_limit: context_limit,
    ports: ports,
    artifacts: artifacts,
    telemetry: ext_token_telemetry(telemetry), world: world
  }
}

-- Convert upstream [Message] to motoko's [Msg] for ExtCtx.history_slice
-- and on_pre_step. Since motoko_ext_abi 2.1.0 (M-ABI-MSG-WIRE-PARITY),
-- Msg carries tool_calls + tool_call_id, so copy them verbatim. The
-- compaction round-trip is now lossless: any extension that returns
-- Compacted([Msg]) preserves wire-format correlation IDs.
func messages_to_msgs(msgs: [Message]) -> [Msg] {
  match msgs {
    [] => [],
    m :: rest => ({
      role: m.role,
      content: m.content,
      tool_calls: m.tool_calls,
      tool_call_id: m.tool_call_id
    } :: messages_to_msgs(rest))
  }
}

func count_system_prefix(msgs: [Message]) -> int {
  match msgs {
    [] => 0,
    m :: rest => if m.role == "system" then 1 + count_system_prefix(rest) else 0
  }
}

-- TUI wire-format helpers (M-MOTOKO-RPC-LOOP M10 follow-up): the legacy
-- TUI renderer (src/tui/src/ui.ts) expects BATCHED native_tool_calls /
-- native_tool_results events with `request_id` and `tool_calls` /
-- `results` array fields, not the per-call events v2 originally emitted.
-- These helpers convert v2's typed [ToolCall] and tool-role [Message]
-- into the array shape the TUI renders. See loop_v2 for the emit calls.

func tool_calls_to_envelope_jsons(calls: [ToolCall]) -> [Json] {
  match calls {
    [] => [],
    c :: rest => call_to_json(tool_call_to_envelope(c)) :: tool_calls_to_envelope_jsons(rest)
  }
}

-- Helper: pull a string field from a decoded JSON object with a fallback.
func json_field_str(obj: Json, key: string, fallback: string) -> string {
  match get(obj, key) {
    None    => fallback,
    Some(j) => match asString(j) { None => fallback, Some(s) => s }
  }
}

-- Helper: detect whether a JSON object has a boolean field set to true.
-- Used to detect policy_denied_message / delegated_deferred_message
-- payloads (both flag themselves with `error: true`).
func json_field_bool_true(obj: Json, key: string) -> bool {
  match get(obj, key) {
    None    => false,
    Some(j) => match j {
      JBool(true) => true,
      _           => false
    }
  }
}

-- Each tool-role Message produced by dispatch_calls has a JSON-encoded
-- payload in its content (either dispatch_one's tool_result_item JSON,
-- a policy_denied_message JSON, or a delegated_deferred_message JSON).
-- The TUI's applyNativeToolResults reads `tool_call_id`, `exit_code`,
-- `stdout`, `stderr`, `truncated` from each result entry — so we
-- normalise to that shape, lifting tool_call_id from the Message and
-- forwarding the inner payload's known fields with safe defaults.
func tool_messages_to_result_jsons(msgs: [Message]) -> [Json] {
  match msgs {
    [] => [],
    m :: rest => {
      let inner = match decode(m.content) {
        Ok(j) => j,
        Err(_) => jo([])
      };
      let stdout_str = json_field_str(inner, "stdout", "");
      let stderr_str = json_field_str(inner, "stderr", "");
      -- If the payload flags itself as an error (policy_denied_message
      -- or delegated_deferred_message both set `error: true`), drive
      -- the TUI's "failed" rendering by emitting exit_code: 1; otherwise
      -- treat as success (exit_code: 0). dispatch_one's payloads always
      -- include exit_code on the wire but parsing JSON numbers from
      -- typed Json values requires a different accessor than we use here;
      -- the boolean error gate is a simpler proxy that gets the TUI
      -- coloring right for the v2-emitted shapes.
      let is_error = json_field_bool_true(inner, "error");
      let normalized = jo([
        kv("tool_call_id", js(m.tool_call_id)),
        kv("exit_code", jnum(if is_error then 1.0 else 0.0)),
        kv("stdout", js(stdout_str)),
        kv("stderr", js(stderr_str)),
        kv("truncated", jb(false)),
        kv("payload", inner)
      ]);
      normalized :: tool_messages_to_result_jsons(rest)
    }
  }
}

-- M7: Synthesize a BashExec ToolCall from a hybrid-mode shell command
-- extracted from the assistant's prose. The model emitted no typed
-- tool_calls (finish_reason != "tool_calls") but its content contained
-- a fenced shell block (```bash / ```sh / ```shell / ```), so we treat
-- that block as the canonical hybrid shorthand and pass it through the
-- M3-M6 dispatch pipeline as if it were a typed BashExec call.
--
-- This preserves the full M4 policy gate + M5 tool-handle routing + M6
-- backend split for hybrid commands (e.g. an extension can still Deny
-- a hybrid `rm -rf /` just as it would deny a typed call). The
-- synthetic call uses a "hybrid-step-N" id so it doesn't collide with
-- model-emitted tool_call_ids on the wire.
func synthesize_hybrid_bash_call(cmd: string, step_idx: int) -> ToolCall {
  {
    id: "hybrid-step-${show(step_idx)}",
    name: "BashExec",
    arguments: encode(jo([kv("cmd", js(cmd))]))
  }
}

-- Build a structured tool-role Message indicating the ohmy_pi delegation
-- pathway is not yet wired in v2. M6 plumbs split_by_backend through but
-- defers the inbox-based wait_for_tool_results to a follow-up — for now
-- delegated calls return this clear, recoverable error so the model can
-- adapt (e.g. retry with a non-delegated argument shape, or surface that
-- ohmy_pi was selected but unavailable).
-- Build a denial tool-role Message for a ToolCall the policy gate rejected.
-- The model sees a structured `{denied_by_policy, reason, tool}` JSON in the
-- tool result, correlated by tool_call_id, so it can correct course on the
-- next turn without ambiguity.
func policy_denied_message(call: ToolCall, reason: string) -> Message {
  let denial_payload = encode(jo([
    kv("error", jb(true)),
    kv("denied_by_policy", jb(true)),
    kv("tool", js(call.name)),
    kv("reason", js(reason))
  ]));
  {
    role: "tool",
    content: denial_payload,
    tool_calls: [],
    tool_call_id: call.id,
    images: []
  }
}

-- Compute per-step cost in millicents from token counts and provider rates.
-- Integer division truncates toward zero (conservative — never over-counts).
-- Returns 0 when rates are zero (unmetered/unknown provider).
pure func step_cost_millicents(input_tokens: int, output_tokens: int, rates: CostRates) -> int {
  (input_tokens * rates.input_per_1m_millicents +
   output_tokens * rates.output_per_1m_millicents) / 1000000
}

-- The v2 loop. Iterates until the model returns finish_reason != "tool_calls"
-- (and any solver-candidate hooks accept the result) or step_budget hits zero.
-- Returns the final messages list.
--
-- DP0 (pre-step compaction): before each LLM call, extension compactors
-- transform the provider payload, with the structural compactor registered
-- last. Core refuses only if the post-chain payload remains critically full.
--
-- M3 wiring: between step() and tool dispatch, fires extension hooks at the
-- two existing decision points motoko's rpc_loop uses (DP1 from the design
-- doc). NoIntercept / NoDecision are no-ops; the typed-step protocol means
-- prose-only responses unambiguously stop the loop (no continuation-intent
-- heuristic needed).

-- DP7: pre-finalize AILANG type-check gate.
-- Runs make check_core in the project workdir before any done emission.
-- Fail-open: if check infrastructure is missing (no workdir, no Makefile, or
-- no check_core target), returns Approve so projects without DP7 setup are not
-- blocked. Only genuine type errors (exit non-zero with substantive output)
-- produce Reject.
type FinalizeVerification
  = Approve
  | Reject(string)

-- Detect "infrastructure missing" — the verification command failed because the
-- project lacks a Makefile/target or the workdir doesn't exist, NOT because the
-- code under verification has type errors. These cases must fail-open.
pure func is_missing_infrastructure(output: string) -> bool {
  let lower = toLower(output);
  contains(lower, "no rule to make target")
    || contains(lower, "no targets specified and no makefile found")
    || contains(lower, "no makefile found")
    || contains(lower, "make: *** no")
    || contains(lower, "no such file or directory")
    || contains(lower, "command not found")
}

func run_dp7_verifier(rt: ExtRuntime, workdir: string) -> FinalizeVerification ! {Process} {
  if not rt.verification.enabled then Approve
  else
    match exec("bash", ["-c", "cd \"$1\" && ${rt.verification.command} 2>&1", "_dp7", workdir]) {
      Err(_) => Approve,
      Ok(out) => {
        if out.exitCode == 0 then Approve
        else {
          let output = toString(out.stdout);
          if is_missing_infrastructure(output) then Approve
          else Reject(output)
        }
      }
    }
}

func dp7_gate(rt: ExtRuntime, workdir: string, step_idx: int, session_id: string) -> Option[Message] ! {Process, IO, Trace} {
  match run_dp7_verifier(rt, workdir) {
    Approve => None,
    Reject(errors) => {
      let _ = ledger_emit(session_id, Dp7VerifierRejected({
        step: step_idx,
        errors: errors
      }));
      Some({
        role: "user",
        content: "The code you just wrote does not type-check. Fix all errors before declaring done:\n\n${errors}",
        tool_calls: [],
        tool_call_id: "",
        images: []
      })
    }
  }
}

-- WI-D2 WIDENED THE RETURN, and it is the same move `ToolDispatchOutcome` took
-- one file over: this returned the rejection text and dropped the event it had
-- just projected, so `Dp7VerifierRejected` reached the wire and nothing else.
-- The caller has the trace; giving it the event is what lets the driver stay the
-- sole appender.
--
-- The re-injection path is NOT terminal — the run continues and terminates later
-- via max-steps or the budget — so D6.1's ordering constraint does not bind this
-- append, unlike `CostExhausted` above.
export type Dp7Rejection = { errors: string, event: LedgerEvent }

func dp7_rejection_errors(rt: ExtRuntime, workdir: string, step_idx: int, session_id: string) -> Option[Dp7Rejection] ! {Process, IO, Trace} {
  match run_dp7_verifier(rt, workdir) {
    Approve => None,
    Reject(errors) => {
      let event = Dp7VerifierRejected({
        step: step_idx,
        errors: errors
      });
      let _ = ledger_emit(session_id, event);
      Some({ errors: errors, event: event })
    }
  }
}

-- M-MOTOKO-PERSIST-NUDGE: bounded loop-persistence at the NoDecision boundary.
-- Root cause (2026-06-18 A/B transcripts): on local models the agent often
-- DISENGAGES after 0–1 tool calls WITHOUT writing a solution — either answering
-- in prose (0 tool calls) or making one inspect call (e.g. `cat solution.ail`)
-- and stopping. The loop then finalizes at NoDecision. These helpers let the loop
-- inject a bounded nudge to keep going instead. Off by default (MOTOKO_PERSIST_
-- RETRIES=0); opt-in for A/B so the rotation is unchanged until validated.

-- Marker embedded in injected nudges so we can count them from history alone
-- (no new loop_v2 state to thread through its 16 recursive call sites).
func persist_nudge_marker() -> string { "[motoko-persist-nudge]" }

-- How many persistence nudges are allowed this run (MOTOKO_PERSIST_RETRIES,
-- default 0 = feature off).
pure func parse_persist_retries_budget(raw: string) -> int {
  match _stringToInt(trim(raw)) {
    Some(n) => if n > 0 then n else 0,
    None => 0
  }
}

-- WI-A12's env class. Four of the driver's env reads are here, and they are
-- threaded rather than ambient.
--
-- The count this comment used to carry — "four of the driver's SEVEN" — was true
-- from WI-A12 until WI-D3, which routed `context_usage`'s four keys through the
-- same port and took the driver's key set from seven to ELEVEN. The authoritative
-- list is `dst_discovery.driver_env_keys()`, which `make discovery` re-derives
-- from the call sites rather than trusting; a second count restated here is the
-- stale-literal class this project has now carried five items running, so this
-- one names the derivation instead of repeating its answer.
--
-- WI-A13 stage 2 CHANGED THE RETURN. A12 discarded the successor at the end,
-- reasoning that policy init happens once and `scripted_env` returns the world
-- unchanged, and it noted that each read still takes the previous read's
-- successor "so that when A13 starts recording reads the order is already
-- right and nothing has to be re-threaded". The ordering was right; the DISCARD
-- was not. Once a read appends to the world's interaction log the successor is
-- no longer the same world, and dropping it dropped all four reads — a quarter
-- of the driver's env surface, silently, on a path the recorder had no way to
-- report. The completeness assertion is what found it; nothing else could,
-- because the log was internally consistent and perfectly reproducible without
-- them.
--
-- The successor is therefore returned and threaded by every caller. Behaviour
-- is unchanged for every non-recording world, where `scripted_env` and
-- `live_ports`' env closure both return their input.
export type SessionPolicyInit = { policy: SessionPolicy, next_state: WorldState }

func session_policy_init(ports: Ports, world: WorldState, model: string, step_budget: int, max_cost_millicents: int, cost_rates: CostRates) -> SessionPolicyInit ! {Env, FS} {
  let budget_steps = if step_budget <= 0 then 8 else step_budget;
  let r_persist = ports.env_get(world, "MOTOKO_PERSIST_RETRIES", "0");
  let r_retry = ports.env_get(r_persist.next_state, "MOTOKO_RETRY_STREAM_ERROR", "1");
  let r_base = ports.env_get(r_retry.next_state, "OPENAI_BASE_URL", "");
  let r_headless = ports.env_get(r_base.next_state, "MOTOKO_HEADLESS", "");
  -- WI-D3's filesystem class. The fifth request this function makes, threaded
  -- from the fourth's successor exactly like the four env reads above and for
  -- the same reason A13 stage 2 gave: once a read appends to the world's log,
  -- discarding the successor drops every read it carried.
  let r_limit = resolve_context_limit(context_reader_of(ports), r_headless.next_state, model);
  let persist_retries = parse_persist_retries_budget(r_persist.value);
  let retry_stream_errors = r_retry.value != "0";
  let provider_base_url = r_base.value;
  let headless = r_headless.value == "1";
  {
    policy: {
      step: {
        step_budget: budget_steps,
        max_cost_millicents: max_cost_millicents,
        cost_metered: cost_rates.input_per_1m_millicents > 0,
        persist_retries: persist_retries,
        retry_stream_errors: retry_stream_errors,
        require_system_prompt: not headless,
        model: model,
        provider_base_url: provider_base_url,
        checkpoint_enabled: false,
        checkpoint_pct: 90,
        compaction: {
          context_limit: r_limit.value,
          elide_tier_pct: 70,
          elide_hard_tier_pct: 85,
          emergency_pct: exhaustion_pct()
        }
      },
      headless: headless
    },
    next_state: r_limit.next_state
  }
}

-- WI-D3 gave it the reader and the world, and it returns the successor for the
-- same reason `session_policy_init` does. It is no longer `pure func`: it
-- performs requests through the ports rather than reading ambiently, and the
-- successor it hands back is what its one caller is free to drop — see there.
func session_policy_with_model(ports: Ports, world: WorldState, policy: SessionPolicy, model: string) -> SessionPolicyInit ! {Env, FS} {
  let r_limit = resolve_context_limit(context_reader_of(ports), world, model);
  {
    policy: {
    step: {
      step_budget: policy.step.step_budget,
      max_cost_millicents: policy.step.max_cost_millicents,
      cost_metered: policy.step.cost_metered,
      persist_retries: policy.step.persist_retries,
      retry_stream_errors: policy.step.retry_stream_errors,
      require_system_prompt: policy.step.require_system_prompt,
      model: model,
      provider_base_url: policy.step.provider_base_url,
      checkpoint_enabled: policy.step.checkpoint_enabled,
      checkpoint_pct: policy.step.checkpoint_pct,
      compaction: {
        context_limit: r_limit.value,
        elide_tier_pct: policy.step.compaction.elide_tier_pct,
        elide_hard_tier_pct: policy.step.compaction.elide_hard_tier_pct,
        emergency_pct: policy.step.compaction.emergency_pct
      }
    },
    headless: policy.headless
    },
    next_state: r_limit.next_state
  }
}

-- Count nudges already injected (user messages carrying the marker) so we never
-- exceed the budget — the count IS the persistence state, read from history.
func count_persist_nudges(msgs: [Message]) -> int {
  match msgs {
    [] => 0,
    m :: rest => {
      let here = if m.role == "user" && contains(m.content, persist_nudge_marker()) then 1 else 0;
      here + count_persist_nudges(rest)
    }
  }
}

func tool_calls_have_writefile(calls: [ToolCall]) -> bool {
  match calls {
    [] => false,
    c :: rest => if c.name == "WriteFile" then true else tool_calls_have_writefile(rest)
  }
}

-- True once the model has attempted ANY WriteFile this run — if so it is engaged
-- with producing a solution, so we let it finalize/fail on its own (don't nudge).
-- Both disengagement modes (0 calls / 1 inspect call) have zero WriteFile, so
-- this gates the nudge precisely to the premature-stop case.
func any_writefile_attempt(msgs: [Message]) -> bool {
  match msgs {
    [] => false,
    m :: rest =>
      if tool_calls_have_writefile(m.tool_calls) then true
      else any_writefile_attempt(rest)
  }
}

-- Map a Fail decision's AIError code onto the typed termination reason.
-- The three codes `decide` can produce are Internal, BudgetExceeded and
-- ContextExhausted (src/core/step_machine.ail:57,93,95,99).
--
-- The MaxSteps discrimination matches on the message text because that is the
-- only thing distinguishing the two Internal failures step_machine emits: the
-- step-budget one and the approval-without-pending-call one share a code.
--
-- WI-A7 DECIDED this rather than leaving it as A9's noted fragility. The
-- message is no longer a literal on either side: both this matcher and the
-- `Fail` in step_machine reference `max_steps_discriminator_message()` from the
-- D3 fault catalogue, so an edit to it is a single edit that cannot
-- desynchronise the two. The `Internal` CODE is deliberately unchanged — A9
-- declined the code change because it is caller-visible, and grounding it for
-- A7 found the consequence is larger than that: the code is emitted as an
-- `error` wire event (`ErrorEvent { code: e.code }`, :2506 and :2576) that the
-- TUI consumes, so a new code would change a wire event on every max-steps run.
-- What remains open, stated rather than implied: the discrimination is still by
-- message rather than by type, so a THIRD Internal failure sharing this message
-- would be misclassified. Closing that needs the compatibility decision above.
pure func decision_fail_reason(code: string, message: string) -> TerminationReason {
  if code == "BudgetExceeded" then TermBudgetExhausted
  else if code == "ContextExhausted" then TermCompactionExhausted
  else if code == "Internal" && message == max_steps_discriminator_message() then TermMaxSteps
  else TermInternalFailure
}

func c2_fail(
  ports: Ports,
  world: WorldState,
  session_id: string,
  model: string,
  totals: RuntimeLoopTotals,
  step_idx: int,
  max_cost_millicents: int,
  started_at_ms: int,
  code: string,
  message: string,
  retryable: bool,
  trace: LedgerTrace,
  emissions: [LedgerEvent]
) -> TracedSessionResult ! {IO, Clock, Trace} {
  let cost_event = CostExhausted({
    step: step_idx,
    total_cost_millicents: totals.cost_millicents,
    total_cost_usd: millicents_to_usd(totals.cost_millicents),
    cap_millicents: max_cost_millicents
  });
  let _ = if code == "BudgetExceeded" then ledger_emit(session_id, cost_event) else ();
  -- WI-D2, AND IT IS `DoneEvent`'S EXACT PRECEDENT (WI-A14). This is a terminal
  -- path, so the append must land BEFORE `c2_finalize` writes the RunSummary or
  -- D6.1's "the summary is the FINAL record" breaks — which is also row 7's
  -- first conjunct, and `terminal_summary_findings`' `after_summary` half is
  -- what says so. Appending after the finalizer type-checks and reddens
  -- `record-after-terminal` on every capped run.
  --
  -- The wire is untouched: `cost_exhausted` still precedes `run_summary` there,
  -- exactly as it did, so no compatibility surface moves (D8).
  let trace_with_cost =
    if code == "BudgetExceeded" then ledger_append(trace, WireRecord(cost_event))
    else trace;
  let result: Result[[Message], AIError] = Err({ code: code, message: message, retryable: retryable });
  c2_finalize(ports, world, session_id, model, totals, step_idx, decision_fail_reason(code, message), message, started_at_ms, trace_with_cost, emissions, result)
}

pure func c2_pending_context(st: C2LoopState) -> [Message] {
  if List.length(st.pending_tool_context) > 0 then st.pending_tool_context else st.msgs
}

pure func c2_pending_prefix(st: C2LoopState) -> [Message] {
  if List.length(st.pending_tool_prefix) > 0 then st.pending_tool_prefix else st.msgs
}

func c2_finish_tool_batch(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  session_id: string,
  started_at_ms: int,
  st: C2LoopState,
  trace: LedgerTrace,
  tool_step_idx: int,
  stream_id: string,
  tool_msgs: [Message]
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let request_id = "step-${show(tool_step_idx)}";
  let results_event = NativeToolResults({
    request_id: request_id,
    step: tool_step_idx,
    stream_id: stream_id,
    payload: ja(tool_messages_to_result_jsons(tool_msgs))
  });
  let _ = if st.pending_tool_batched then ledger_emit(session_id, results_event) else ();
  -- WI-D2, and the condition is shared with the emission for the reason the
  -- announcement site gives.
  let trace_with_results =
    if st.pending_tool_batched then ledger_append(trace, WireRecord(results_event))
    else trace;
  let next_state: C2LoopState = {
    msgs: c2_pending_prefix(st) ++ tool_msgs,
	    step_idx: st.step_idx,
	    totals: st.totals,
	    ext_artifacts: st.ext_artifacts,
	    telemetry: st.telemetry,
	    provider: st.provider,
	    world_state: st.world_state,
    pending_tool_calls: [],
    pending_tool_context: [],
    pending_tool_prefix: [],
    pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
    last_finish_reason: "tools_complete",
    last_response_text: "",
    nudges_used: st.nudges_used,
    finalize_source: "",
    prior_counts: st.prior_counts,
    trace: trace_with_results,
    emissions: st.emissions
  };
  c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
}

func c2_continue_tool_batch(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  session_id: string,
  started_at_ms: int,
  st: C2LoopState,
  trace: LedgerTrace,
  req: ApprovalRequest,
  accumulated: [Message]
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  match req.remaining {
    [] => c2_finish_tool_batch(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, st, trace, c2_done_step(st.step_idx), req.stream_id, accumulated),
    _ => {
      let next_state: C2LoopState = {
        msgs: st.msgs,
	        step_idx: st.step_idx,
	        totals: st.totals,
	        ext_artifacts: st.ext_artifacts,
	        telemetry: st.telemetry,
	        provider: st.provider,
	        world_state: st.world_state,
        pending_tool_calls: c2_tool_plan_calls(req.remaining),
        pending_tool_context: st.pending_tool_context,
        pending_tool_prefix: st.pending_tool_prefix,
        pending_tool_batched: st.pending_tool_batched,
        accumulated_tool_msgs: accumulated,
        pending_approval: None,
        last_finish_reason: "approval_resolved",
        last_response_text: "",
        nudges_used: st.nudges_used,
        finalize_source: "",
        prior_counts: st.prior_counts,
        trace: trace,
        emissions: st.emissions
      };
      c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
    }
  }
}

func c2_after_dp7(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  msgs_with_assistant: [Message],
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
	  cost_rates: CostRates,
	  totals: RuntimeLoopTotals,
	  ext_artifacts: Json,
	  telemetry: { last_input_tokens: int, last_output_tokens: int, last_estimated_input_tokens: int },
	  st_provider: Ports,
	  st_world_state: WorldState,
  prior_counts: RuntimeStatusCounts,
  session_id: string,
  started_at_ms: int,
  trace: LedgerTrace,
  emissions: [LedgerEvent],
  next_step_idx: int,
  done_step_idx: int,
  output: string,
  source: string
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  match dp7_rejection_errors(rt, workdir, done_step_idx, session_id) {
    Some(rejection) => {
      let errors = rejection.errors;
      let next_state: C2LoopState = {
        msgs: msgs_with_assistant,
	        step_idx: next_step_idx,
	        totals: totals,
	        ext_artifacts: ext_artifacts,
	        telemetry: telemetry,
	        provider: st_provider,
	        world_state: st_world_state,
        pending_tool_calls: [],
        pending_tool_context: [],
        pending_tool_prefix: [],
        pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
        last_finish_reason: "dp7_rejected",
        last_response_text: errors,
        nudges_used: count_persist_nudges(msgs_with_assistant),
        finalize_source: "",
        prior_counts: prior_counts,
        trace: ledger_append(trace, WireRecord(rejection.event)),
        emissions: emissions
      };
      c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
    },
    None => {
      let next_state: C2LoopState = {
        msgs: msgs_with_assistant,
	        step_idx: next_step_idx,
	        totals: totals,
	        ext_artifacts: ext_artifacts,
	        telemetry: telemetry,
	        provider: st_provider,
	        world_state: st_world_state,
        pending_tool_calls: [],
        pending_tool_context: [],
        pending_tool_prefix: [],
        pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
        last_finish_reason: "dp7_approved",
        last_response_text: output,
        nudges_used: count_persist_nudges(msgs_with_assistant),
        finalize_source: source,
        prior_counts: prior_counts,
        trace: trace,
        emissions: emissions
      };
      c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
    }
  }
}

func c2_loop(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  session_id: string,
  started_at_ms: int,
  st: C2LoopState
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  match c2_step_state(st) {
    -- Terminal: invalid history. This path emitted no run_summary at all
    -- before A9 — it is one of the two terminal returns the ADR's five-call-site
    -- enumeration missed. It now finalizes like every other.
    Err(reason) => {
      let result: Result[[Message], AIError] = Err({ code: "InvalidHistory", message: reason, retryable: false });
      c2_finalize(st.provider, st.world_state, session_id, model, st.totals, st.step_idx, TermInvalidHistory, reason, started_at_ms, st.trace, st.emissions, result)
    },
    Ok(step_state) => {
      let decision = decide(step_state, policy.step);
      let trace_with_decision = c2_append_decision(st.trace, st.step_idx, decision);
      match decision {
        -- Terminal: budget, max steps, compaction exhaustion or internal,
        -- discriminated by decision_fail_reason.
        Fail(info) => c2_fail(st.provider, st.world_state, session_id, model, st.totals, st.step_idx, max_cost_millicents, started_at_ms, info.code, info.message, info.retryable, trace_with_decision, st.emissions),
        Finalize(info) => {
          let done_step = c2_done_step(st.step_idx);
          -- WI-D4. READ, not re-resolved. `session_policy_init` already resolved
          -- this model's limit and stored it here; WI-D3 re-resolved it at this
          -- and three sibling sites, which put the driver's config reads into
          -- the recorded interaction log on every loop arm.
          --
          -- SAFE BECAUSE IT WAS MEASURED, not because the two look equal: a
          -- temporary assertion at all four sites, comparing the stored value
          -- against a fresh resolution and the loop's `model` against
          -- `policy.step.model`, ran over the WHOLE of `make dst` and reported
          -- 657 executions and ZERO mismatches — 282 here at `CallModel`, 205 at
          -- `RunTools`, 75 at this site and 95 at the approval site. The
          -- structural reason is that `model` and `policy.step.model` move
          -- together: every `session_policy_init` caller passes the same model it
          -- passes the loop, and the one model SWITCH,
          -- `conversation_loop_v2_with_policy`'s `model_change`, rebuilds the
          -- policy through `session_policy_with_model` and passes BOTH.
          --
          -- SUCCESSOR: none is lost. `r_limit.next_state` descended from
          -- `st.world_state` with nothing between them, so `st.world_state` is
          -- both the predecessor and — with no read performed — the successor.
          -- This is NOT the shape WI-D1 found in production, where the discarded
          -- state was the successor of work that had actually happened.
          let empty_event = EmptyStopFinalize({
            step: done_step,
            input_tokens: st.telemetry.last_input_tokens,
            estimated_input_tokens: st.telemetry.last_estimated_input_tokens,
            context_limit: policy.step.compaction.context_limit
          });
          let trace_after_empty_floor =
            if trim(info.output) == "" then {
              let _ = ledger_emit(session_id, empty_event);
              ledger_append(trace_with_decision, WireRecord(empty_event))
            } else trace_with_decision;
          -- WI-A14 (D6.4 / D7's parity family). The DoneEvent is APPENDED here,
          -- before c2_finalize appends the RunSummary, and PROJECTED after it.
          -- Three obligations that could not all hold while it was
          -- projected-only now do: D6.4 (a Logical event reaches the returned
          -- trace), D6.1 (the RunSummary is STILL the final record) and D6.3
          -- (agreement, now decidable over the returned trace alone). The wire
          -- order is untouched: D6.4 asks for PARITY, not one transition.
          let done_event = DoneEvent({ step: done_step, output: info.output, source: st.finalize_source });
          let trace_with_done = ledger_append(trace_after_empty_floor, WireRecord(done_event));
          let finalized = c2_finalize(st.provider, st.world_state, session_id, model, st.totals, st.step_idx, TermSuccess, "", started_at_ms, trace_with_done, st.emissions, Ok(st.msgs));
          let _ = ledger_emit(session_id, done_event);
          finalized
        },
        InjectUserMessage(msg) => {
          let next_msgs = st.msgs ++ [msg];
          let next_nudges = if st.last_finish_reason == "persist_nudge" then st.nudges_used + 1 else st.nudges_used;
          let next_state: C2LoopState = {
            msgs: next_msgs,
	            step_idx: st.step_idx,
	            totals: st.totals,
	            ext_artifacts: st.ext_artifacts,
	            telemetry: st.telemetry,
	            provider: st.provider,
	            world_state: st.world_state,
            pending_tool_calls: [],
            pending_tool_context: [],
            pending_tool_prefix: [],
            pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
            last_finish_reason: "user_injected",
            last_response_text: "",
            nudges_used: next_nudges,
            finalize_source: "",
            prior_counts: st.prior_counts,
            trace: trace_with_decision,
            emissions: st.emissions
          };
          c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
        },
        TakeCheckpoint(plan) => {
          let cp = apply_checkpoint(step_state, plan);
          let _ = ledger_emit(session_id, cp.event);
          let next_state: C2LoopState = {
            msgs: history_messages(cp.state.history),
	            step_idx: st.step_idx,
	            totals: st.totals,
	            ext_artifacts: cp.state.ext_artifacts,
	            telemetry: cp.state.telemetry,
	            provider: st.provider,
	            world_state: st.world_state,
            pending_tool_calls: st.pending_tool_calls,
            pending_tool_context: st.pending_tool_context,
            pending_tool_prefix: st.pending_tool_prefix,
            pending_tool_batched: st.pending_tool_batched,
            accumulated_tool_msgs: st.accumulated_tool_msgs,
            pending_approval: st.pending_approval,
            last_finish_reason: st.last_finish_reason,
            last_response_text: st.last_response_text,
            nudges_used: st.nudges_used,
            finalize_source: st.finalize_source,
            prior_counts: st.prior_counts,
            trace: ledger_append(trace_with_decision, WireRecord(cp.event)),
            emissions: st.emissions
          };
          c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
        },
        AwaitApproval(_) => {
          match st.pending_approval {
            -- Terminal: internal driver failure. The second of the two terminal
            -- returns that emitted no run_summary before A9.
            None => {
              let msg = "approval requested without pending approval state";
              let result: Result[[Message], AIError] = Err({ code: "Internal", message: msg, retryable: false });
              c2_finalize(st.provider, st.world_state, session_id, model, st.totals, st.step_idx, TermInternalFailure, msg, started_at_ms, trace_with_decision, st.emissions, result)
            },
            Some(req) => {
              -- WI-A12's approval class. The operator's input comes from the
              -- world through the port; `resolve_approval` stays here because
              -- it is pure policy, not an effect. `input.eof` replaces the old
              -- `raw == ""` inference — behaviour-identical for the live
              -- adapter, which reports eof exactly when readLine returns "".
              let input = st.provider.approval_read(st.world_state, req);
              let resolution = resolve_approval(input.raw, req.default_allow, input.eof);
              -- `post` carries the advanced approval cursor and is what every
              -- continuation below uses. Deliberately NOT written as a shadowing
              -- `let st = ...`: that compiles, but it makes "which `st`" a
              -- question of line order, and a later edit adding a use above this
              -- point would silently read the pre-approval world. Passing `st`
              -- here instead of `post` is the freeze this class's assertion
              -- catches — the queue would never advance.
              let post: C2LoopState = { st | world_state: input.next_state };
              let tool_step_idx = c2_done_step(post.step_idx);
              -- WI-D4 removed WI-D3's `post_ctx` here, and THIS is the site
              -- where doing it carelessly would have cost something. `post_ctx`
              -- was `post` advanced past the resolution's requests; `post` is
              -- `st` advanced past the APPROVAL READ. Collapsing to `st` — the
              -- edit the type checker accepts just as readily — would have
              -- thrown the approval cursor away and frozen the queue, which is
              -- WI-D1's production defect in miniature and exactly what the
              -- comment above says this arm is prone to. The successor that
              -- disappears with the resolution is the resolution's own; the one
              -- that must survive is `input.next_state`, and it does, in `post`.
              let ctx = mk_v2_ext_ctx(task, tool_step_idx, model, workdir, env_url, hybrid_tools, budget, c2_pending_context(post), policy.step.compaction.context_limit, ext_ports_of(post.provider, post.world_state, policy.step.provider_base_url), post.ext_artifacts, post.telemetry, world_to_token(post.world_state));
              match resolution {
                ApprovalDenied(reason) => {
                  let denied_event = NativeToolDenied({
                    step: tool_step_idx,
                    stream_id: req.stream_id,
                    tool: req.call.name,
                    id: req.call.id,
                    reason: reason
                  });
                  let _ = ledger_emit(session_id, denied_event);
                  let denial_msg = policy_denied_message(req.call, reason);
                  c2_continue_tool_batch(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, post, ledger_append(trace_with_decision, WireRecord(denied_event)), req, post.accumulated_tool_msgs ++ [denial_msg])
                },
                ApprovalAllowed => {
                  let executed = execute_allowed_tool_call(post.provider, post.world_state, rt, ctx, req.call, workdir, tool_step_idx, req.stream_id, ohmy_pi, \event. ledger_emit(session_id, event));
                  -- `after` carries BOTH advanced cursors: the approval queue
                  -- (from `post`) and the tool queue (from this execution).
                  -- WI-D2 adds a third thing to carry — `executed.emitted` — and
                  -- this is the site where forgetting it is least visible,
                  -- because the batch continues and the events would simply
                  -- never appear.
                  let after: C2LoopState = { post | world_state: executed.next_state };
                  c2_continue_tool_batch(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, after, c2_trace_wire_events(trace_with_decision, executed.emitted), req, after.accumulated_tool_msgs ++ [executed.msg])
                }
              }
            }
          }
        },
        RunTools(plan) => {
          let tool_step_idx = c2_done_step(st.step_idx);
          let stream_id = "step-${show(tool_step_idx)}";
          let calls = c2_tool_plan_calls(plan.entries);
          let request_id = "step-${show(tool_step_idx)}";
          let ctx_msgs = c2_pending_context(st);
          -- WI-D4. The stored limit, and WI-D3's `st_ctx` goes with the
          -- resolution that produced it.
          --
          -- SUCCESSOR: nothing is lost. Between `st` and the deleted resolution
          -- stood only `c2_done_step` and `c2_pending_context`, both pure, so
          -- `r_limit.next_state` was `st.world_state` plus this resolution's own
          -- requests and nothing else. The dispatcher below therefore starts
          -- from the same world it would have started from, and `done.world` —
          -- the successor that IS load-bearing here — is untouched.
          let ctx = mk_v2_ext_ctx(task, tool_step_idx, model, workdir, env_url, hybrid_tools, budget, ctx_msgs, policy.step.compaction.context_limit, ext_ports_of(st.provider, st.world_state, policy.step.provider_base_url), st.ext_artifacts, st.telemetry, world_to_token(st.world_state));
          let emit_calls = st.pending_tool_batched && List.length(st.accumulated_tool_msgs) == 0 && st.last_finish_reason != "approval_resolved";
          let calls_event = NativeToolCalls({
            request_id: request_id,
            step: tool_step_idx,
            stream_id: stream_id,
            payload: ja(tool_calls_to_envelope_jsons(calls))
          });
          let _ = if emit_calls then ledger_emit(session_id, calls_event) else ();
          -- WI-D2. Appended under the SAME condition it is emitted under. An
          -- unconditional append here type-checks and puts a record in the trace
          -- for a batch that announced nothing on the wire — which the wire gate
          -- reads as trace > wire, and is why the condition is shared rather
          -- than restated.
          let trace_with_calls =
            if emit_calls then ledger_append(trace_with_decision, WireRecord(calls_event))
            else trace_with_decision;
          -- COMPUTED INSIDE THE LAMBDA, AND UNDER THE NAME GUARD. This was a
          -- `let` above the dispatch, so every tool batch in every session paid
          -- a full `runtime_status_json` — an O(|trace|) fold and a JSON encode
          -- — and then discarded it, because the value is only ever read when
          -- the batch contains a `MotokoRuntimeStatus` call. It was the second
          -- half of motoko_agent#160: the fold's DEPTH is fixed at its
          -- definition, this fixes who pays for it.
          --
          -- THE PREDICATE IS DUPLICATED ON PURPOSE. `runtime_status_tool_message`
          -- keeps its own `call.name` check so it stays correct called from
          -- anywhere; this one exists to keep the ARGUMENT from being evaluated,
          -- which AILANG's strict application would otherwise do at every call
          -- in the batch. Deleting either one is a silent regression: dropping
          -- this guard restores the cost, dropping the inner one makes the
          -- helper wrong for every other caller.
          let runtime_builtin = \call.
            if call.name == "MotokoRuntimeStatus" then
              runtime_status_tool_message(call, encode(runtime_status_json(st, policy, tool_step_idx)))
            else None;
          match dispatch_tool_entries_with_builtin(st.provider, st.world_state, rt, ctx, plan.entries, workdir, tool_step_idx, stream_id, ohmy_pi, st.accumulated_tool_msgs, [], \event. ledger_emit(session_id, event), runtime_builtin) {
            -- `done.world`, not `st.world_state`. The batch may have executed
            -- several tools and each one advanced the cursor; taking it off `st`
            -- type-checks and rewinds the world to before the batch.
            --
            -- WI-D2: `done.emitted` is the same rule on the second channel the
            -- fold now returns. The tool-dispatch events land BETWEEN the batch
            -- announcement and whatever the batch produces, which is when they
            -- happened — the same positioning the stream deltas get at the
            -- provider call, and for the same reason: a block appended in the
            -- wrong place satisfies a count and fails order.
            ToolDispatchDone(done) =>
              c2_finish_tool_batch(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, { st | world_state: done.world }, c2_trace_wire_events(trace_with_calls, done.emitted), tool_step_idx, stream_id, done.msgs),
            ToolDispatchPending(pending) => {
              let next_state: C2LoopState = {
                msgs: st.msgs,
	                step_idx: st.step_idx,
	                totals: st.totals,
	                ext_artifacts: st.ext_artifacts,
	                telemetry: st.telemetry,
	                provider: st.provider,
	                -- `pending.world`: tools already executed in this batch
	                -- before the approval interrupted it, and their cursor
	                -- advances must survive the suspension.
	                world_state: pending.world,
                pending_tool_calls: [pending.request.call],
                pending_tool_context: st.pending_tool_context,
                pending_tool_prefix: st.pending_tool_prefix,
                pending_tool_batched: st.pending_tool_batched,
                accumulated_tool_msgs: pending.accumulated,
                pending_approval: Some(pending.request),
                last_finish_reason: "await_approval",
                last_response_text: pending.request.reason,
                nudges_used: st.nudges_used,
                finalize_source: "",
                prior_counts: st.prior_counts,
                -- WI-D2: `pending.emitted`, and the suspension is exactly where
                -- this is easy to drop — the branch already had to remember
                -- `pending.world` and `pending.accumulated` for the same reason.
                trace: c2_trace_wire_events(trace_with_calls, pending.emitted),
                emissions: st.emissions
              };
              c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
            }
          }
        },
        CallModel(_) => {
          let step_idx = st.step_idx;
          -- WI-D4. The stored limit, and WI-D3's `st_ctx` goes with it.
          --
          -- SUCCESSOR: nothing is lost — the deleted resolution was the first
          -- thing this arm did to the world, so its successor was `st`'s own.
          -- The two `SealSystemPrompt`/`SealExhausted` finalize sites below
          -- therefore returned to `st.world_state`, which is where they stood
          -- before WI-D3 and was NOT a narrowing: WI-D3 pointed them at `st_ctx`
          -- only so that item did not newly widen them, and with no resolution
          -- here there was no widening to preserve.
          --
          -- WI-D4's LAST SENTENCE HAS EXPIRED, and the history is kept two-part
          -- per S15 because a documented deferral is only legible against the
          -- scope that deferred it. It read: "They still ignore
          -- `chain.next_state`, the pre-step chain's successor, which remains a
          -- separate un-threaded seam and is out of this item's scope." WI-D25
          -- is the item whose scope it is. Both sites now take
          -- `token_to_world(chain.next_state)`, and the deferral's ground did
          -- not survive re-measurement: it was about WI-D3's deleted
          -- resolution, which says nothing about the chain.
          --
          -- WHY — the `Ok` arm's reason, met on the two failing arms. The chain
          -- is dispatched BELOW this comment and ABOVE the match, so a pre-step
          -- hook's `ai_step` calls have already happened on ALL THREE arms.
          -- Sealing failed; the effects did not. Returning `st.world_state`
          -- here un-happens whatever the chain consumed, and the run's terminal
          -- world reports a cursor that never advanced.
          --
          -- IT WAS INVISIBLE FOR THE REASON S29 GIVES: every `on_pre_step`
          -- binding in the tree returned `ctx.world` unchanged, so the drop and
          -- the thread produced identical worlds. `world_state_probe`'s
          -- `consuming_pre_step_2`/`_3` are the first bindings that do not, and their
          -- two seal-terminal rows go red against the reverted argument.
          let context_limit = policy.step.compaction.context_limit;
          let split = split_for_compaction(st.msgs);
          let compactable_msgs = segment_messages(split.segment);
          let pinned_tokens = estimate_tokens_messages(split.pinned);
          let ext_context_limit = if context_limit - pinned_tokens < 0 then 0 else context_limit - pinned_tokens;
          let pre_ctx = mk_v2_ext_ctx(task, step_idx, model, workdir, env_url, hybrid_tools, budget, st.msgs, ext_context_limit, ext_ports_of(st.provider, st.world_state, policy.step.provider_base_url), st.ext_artifacts, st.telemetry, world_to_token(st.world_state));
          let chain = dispatch_pre_step_chain(rt, pre_ctx, messages_to_msgs(compactable_msgs));
          let _ = emit_pre_step_stages(session_id, step_idx, chain.stages);
          let trace_after_stages = c2_trace_stage_records(trace_with_decision, step_idx, chain.stages);
          match seal_compacted_payload(split, msgs_to_messages(chain.msgs), model, context_limit, policy.step.require_system_prompt) {
            -- Terminal: the seal could not produce a usable system prompt.
            -- Reachable, and absent from the ADR's enumeration of termination
            -- reasons; it maps to the "error" wire string like the other
            -- non-specific failures.
            Err(SealSystemPromptEmpty(reason)) => {
              let event = ErrorEvent({ source: "system_prompt", code: "SystemPromptEmpty", message: reason });
              let _ = ledger_emit(session_id, event);
              let result: Result[[Message], AIError] = Err({ code: "SystemPromptEmpty", message: reason, retryable: false });
              c2_finalize(st.provider, token_to_world(chain.next_state), session_id, model, st.totals, step_idx, TermSystemPromptEmpty, reason, started_at_ms, ledger_append(trace_after_stages, WireRecord(event)), st.emissions, result)
            },
            -- Terminal: compaction exhausted.
            Err(SealExhausted(compaction_reason)) => {
              let event = CompactionExhausted({ step: step_idx, model: model, reason: compaction_reason });
              let _ = ledger_emit(session_id, event);
              let result: Result[[Message], AIError] = Err({ code: "ContextExhausted", message: compaction_reason, retryable: false });
              c2_finalize(st.provider, token_to_world(chain.next_state), session_id, model, st.totals, step_idx, TermCompactionExhausted, compaction_reason, started_at_ms, ledger_append(trace_after_stages, WireRecord(event)), st.emissions, result)
            },
            Ok(payload) => {
              let compacted_msgs = payload_messages(payload);
              let stream_id = "step-${show(step_idx)}";
              let start_event = ThinkingStreamStart({ step: step_idx, stream_id: stream_id, model: model });
              let _ = ledger_emit(session_id, start_event);
              let on_chunk: (StreamChunk) -> () ! {IO, Trace} = \chunk. append_stream_delta(session_id, step_idx, stream_id, chunk);
              let prepared_event = ProviderCallPrepared({
                step: step_idx,
                msg_count: List.length(compacted_msgs),
                estimated_input_tokens: estimate_tokens_messages(compacted_msgs),
                system_prefix_count: count_system_prefix(compacted_msgs),
                system_prefix_chars: system_prefix_chars(compacted_msgs),
                system_prefix_digest: system_prefix_digest_for(split.pinned),
                payload_digest: payload_digest(compacted_msgs),
                model: model
              });
              let _ = ledger_emit(session_id, prepared_event);
              -- WI-B2b: `chain.next_state`, not `st.world_state`. The pre-step
              -- chain runs BEFORE this call and a compaction hook may have made
              -- provider calls of its own; starting the model step from the
              -- world the chain was entered with would re-serve whatever the
              -- chain already consumed. This is the pre-step half of the same
              -- threading the intercept and solver hooks do below.
              let exchange = dispatch_step(st.provider, token_to_world(chain.next_state), provider_api_model(model, policy.step.provider_base_url), compacted_msgs, on_chunk);
              -- WI-C3: THE READER. `exchange.emissions` had no consumer until
              -- this line; WI-A1 built the channel, WI-C1 made it non-empty on a
              -- live exchange, and this is where it is spent.
              --
              -- Two channels come out of one conversion, and they are threaded
              -- SEPARATELY on purpose (see `C2LoopState.emissions`):
              --
              --   * the returned trace gets these events appended, which closes
              --     `StreamDelta` in `d64_gap_register` — the driver used to
              --     ledger_emit every delta and append none, so the returned
              --     trace held zero StreamDelta records on every path and D6.4's
              --     parity had no second side to compare against at all;
              --   * `C2LoopState.emissions` carries the same events forward as
              --     the run's emission witness, which is what an
              --     `ExecutionUnderTest` needs and what `emissions: []` could
              --     never be.
              --
              -- WHAT THIS PAIR DOES AND DOES NOT TEST, because a green
              -- `stream_parity_findings` on a real run must not be over-read.
              -- Both sides are derived from `exchange.emissions` here, and that
              -- is not a shortcut — it is the only observation of the stream
              -- that exists in this process. The callback's own projections go
              -- to `ledger_emit`, which returns `()`, and the callback's row is
              -- closed `{IO}` so it cannot accumulate them; D1 rejected the
              -- scoped recorder and SharedMem explicitly. So in-process parity
              -- tests that every branch below carries BOTH channels forward —
              -- the trace has one junction (`trace_after_call`), the witness is
              -- set in six branch literals, and a branch that keeps one and
              -- drops the other goes red. It does NOT test that the callback
              -- projected what the provider returned. That comparison needs the
              -- WIRE, which is out of process, and it is what
              -- `make stream_parity` does.
              let stream_events = stream_chunk_events(step_idx, stream_id, exchange.emissions);
              let emissions_after_call = st.emissions ++ stream_events;
              -- The stream deltas sit between the prepared event and whatever
              -- the outcome produces, which is when they actually happened.
              let trace_after_call = c2_trace_wire_events(ledger_append(ledger_append(trace_after_stages, WireRecord(start_event)), WireRecord(prepared_event)), stream_events);
              match exchange.result {
                Err(e) => {
                  let end_event = ThinkingStreamEnd({ step: step_idx, stream_id: stream_id, status: "errored" });
                  let _ = ledger_emit(session_id, end_event);
                  -- WI-D2 CLOSES THE BRACKET. `ThinkingStreamStart` has been in
                  -- the returned trace since A8 and its closing half was
                  -- `ledger_emit`-only — the same code path appending one
                  -- bracket and projecting the other, which was the sharpest
                  -- single statement of D6.4's gap. Appended AFTER the deltas
                  -- and before whatever the outcome produces, because that is
                  -- when the stream ended.
                  let trace_after_end = ledger_append(trace_after_call, WireRecord(end_event));
                  -- WI-A12's env class. This was "the sixth and last driver env
                  -- read" from WI-A12 until WI-D3; it is the last one IN
                  -- session.ail and it is no longer the last in the driver —
                  -- `context_usage` reads four more through the same port.
                  let _ = if not e.retryable && st.provider.env_get(st.world_state, "MOTOKO_CAPTURE_FAILED_PAYLOAD", "").value != "" then capture_failing_payload(e, compacted_msgs) else ();
                  if should_retry_stream_error(e.retryable, policy.step.retry_stream_errors, policy.step.step_budget - step_idx) then {
                    let retry_event = StreamErrorRetry({ step: step_idx, error: e.message });
                    let _ = ledger_emit(session_id, retry_event);
                    let next_state: C2LoopState = {
                      msgs: st.msgs,
	                      step_idx: step_idx + 1,
	                      totals: st.totals,
	                      ext_artifacts: chain.artifacts,
	                      telemetry: st.telemetry,
	                      provider: st.provider,
	                      world_state: exchange.next_state,
                      pending_tool_calls: [],
                      pending_tool_context: [],
                      pending_tool_prefix: [],
                      pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
                      last_finish_reason: "stream_error",
                      last_response_text: e.message,
                      nudges_used: st.nudges_used,
                      finalize_source: "",
                      prior_counts: st.prior_counts,
                      trace: ledger_append(trace_after_end, WireRecord(retry_event)),
                      emissions: emissions_after_call
                    };
                    c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
                  } else {
                    -- Terminal: unretried provider/stream failure. WI-D1 made this `exchange.next_state` rather than `st.world_state` — plan rule S12, and the measurement is recorded at `ports.provider_outcome_record`. This edit is deliberately line-count-neutral (S18): the four routed clock anchors below it must not move.
                    c2_finalize(st.provider, exchange.next_state, session_id, model, st.totals, step_idx, TermProviderFailure, e.message, started_at_ms, trace_after_end, emissions_after_call, Err(e))
                  }
                },
                Ok(result) => {
                  let n_calls = List.length(result.tool_calls);
                  let step_cost = step_cost_millicents(result.input_tokens, result.output_tokens, cost_rates);
                  let phase = phase_from_result(result, step_idx, n_calls, millicents_to_usd(step_cost), step_cost, estimate_tokens_messages(compacted_msgs));
                  let end_event = ThinkingStreamEnd({ step: step_idx, stream_id: stream_id, status: "completed" });
                  let _ = ledger_emit(session_id, end_event);
                  let _ = c2_emit_events(session_id, phase.events);
                  let new_warned_pct = c2_emit_cost_warning(session_id, step_idx, st.totals.cost_millicents + step_cost, max_cost_millicents, st.totals.cost_warned_pct);
                  let new_totals = c2_add_step_totals(st.totals, result, step_cost, new_warned_pct);
                  let applied = apply_state_delta(step_state, phase.delta);
                  let assistant_msg = step_result_to_message(result);
                  let msgs_with_assistant = st.msgs ++ [assistant_msg];
                  let post_ctx = mk_v2_ext_ctx(task, step_idx, model, workdir, env_url, hybrid_tools, budget, msgs_with_assistant, context_limit, ext_ports_of(st.provider, st.world_state, policy.step.provider_base_url), chain.artifacts, applied.telemetry, world_to_token(exchange.next_state));
                  let trace_after_model = c2_trace_wire_events(ledger_append(trace_after_call, WireRecord(end_event)), phase.events);
                  -- WI-B2b. Bound rather than matched inline, because the
                  -- successor has to outlive the match: `intercepted.next_state`
                  -- is what the loop carries forward on EVERY arm, and
                  -- `exchange.next_state` is stale by what the hook performed.
                  let intercepted = dispatch_response_intercept(rt, post_ctx, result.message.content);
                  match intercepted.decision {
                    InterceptHandled(envelope) => {
                      let event = ExtInterceptHandled({
                        step: step_idx,
                        stream_id: "",
                        tool: envelope.tool,
                        id: "",
                        exit_code: envelope.exit_code
                      });
                      let _ = ledger_emit(session_id, event);
                      let tool_msg = envelope_to_tool_message(envelope);
                      let next_state: C2LoopState = {
                        msgs: msgs_with_assistant ++ [tool_msg],
	                        step_idx: step_idx + 1,
	                        totals: new_totals,
	                        ext_artifacts: chain.artifacts,
	                        telemetry: applied.telemetry,
	                        provider: st.provider,
	                        -- WI-B2b: the INTERCEPT's successor, not the model
	                        -- step's. The hook ran after the exchange, so
	                        -- `exchange.next_state` is stale by whatever it did.
	                        world_state: token_to_world(intercepted.next_state),
                        pending_tool_calls: [],
                        pending_tool_context: [],
                        pending_tool_prefix: [],
                        pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
                        last_finish_reason: "intercept_handled",
                        last_response_text: result.message.content,
                        nudges_used: applied.nudges_used,
                        finalize_source: "",
                        prior_counts: st.prior_counts,
                        trace: ledger_append(trace_after_model, WireRecord(event)),
                        emissions: emissions_after_call
                      };
                      c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
                    },
                    NoIntercept => {
                      -- Execute tool calls whenever the model emitted any, not
                      -- only when finish_reason=="tool_calls". Some providers
                      -- (e.g. hy3:free/Novita) return tool_calls with a
                      -- different finish_reason; gating on the string alone
                      -- drops the call and runs the finalize/guard path, which
                      -- injects a nudge after an unanswered tool_call and ships
                      -- a malformed [assistant(tool_calls) -> user] payload the
                      -- provider then rejects (400 invalid_request_error).
                      if result.finish_reason == "tool_calls" || n_calls > 0 then {
                        let next_state: C2LoopState = {
                          msgs: msgs_with_assistant,
	                          step_idx: step_idx + 1,
	                          totals: new_totals,
	                          ext_artifacts: chain.artifacts,
	                          telemetry: applied.telemetry,
	                          provider: st.provider,
	                          world_state: token_to_world(intercepted.next_state), -- WI-D19
                          pending_tool_calls: applied.pending_tool_calls,
                          pending_tool_context: msgs_with_assistant,
                          pending_tool_prefix: msgs_with_assistant,
                          pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
                          last_finish_reason: "tool_calls",
                          last_response_text: applied.last_response_text,
                          nudges_used: applied.nudges_used,
                          finalize_source: "",
                          prior_counts: st.prior_counts,
                          trace: trace_after_model,
                          emissions: emissions_after_call
                        };
                        c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
                      } else {
                        let hybrid_attempt: Option[string] = if hybrid_tools then extract_bash(result.message.content) else None;
                        match hybrid_attempt {
                          Some(cmd) => {
                            let event = HybridBashExtracted({ step: step_idx, cmd: cmd });
                            let _ = ledger_emit(session_id, event);
                            let synth_call = synthesize_hybrid_bash_call(cmd, step_idx);
                            let augmented_assistant_msg: Message = {
                              role: "assistant",
                              content: result.message.content,
                              tool_calls: [synth_call],
                              tool_call_id: "",
                              images: []
                            };
                            let next_state: C2LoopState = {
                              msgs: msgs_with_assistant,
	                              step_idx: step_idx + 1,
	                              totals: new_totals,
	                              ext_artifacts: chain.artifacts,
	                              telemetry: applied.telemetry,
	                              provider: st.provider,
	                              world_state: token_to_world(intercepted.next_state), -- WI-D19
                              pending_tool_calls: [synth_call],
                              pending_tool_context: msgs_with_assistant,
                              pending_tool_prefix: st.msgs ++ [augmented_assistant_msg],
                              pending_tool_batched: false,
    accumulated_tool_msgs: [],
    pending_approval: None,
                              last_finish_reason: "hybrid_bash",
                              last_response_text: result.message.content,
                              nudges_used: applied.nudges_used,
                              finalize_source: "",
                              prior_counts: st.prior_counts,
                              trace: ledger_append(trace_after_model, WireRecord(event)),
                              emissions: emissions_after_call
                            };
                            c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
                          },
                          None => {
                            -- WI-B2b. Bound, for the same reason the intercept
                            -- above is: every branch below carries the world
                            -- forward, and the solver hook's successor is the
                            -- current one from here on.
                            let finalized = dispatch_solver_candidate(rt, { post_ctx | world: intercepted.next_state }, result.message.content); -- WI-D19
                            match finalized.decision {
                              Accept(output) =>
	                                c2_after_dp7(rt, task, env_url, hybrid_tools, budget, policy, model, msgs_with_assistant, workdir, ohmy_pi, max_cost_millicents, cost_rates, new_totals, chain.artifacts, applied.telemetry, st.provider, token_to_world(finalized.next_state), st.prior_counts, session_id, started_at_ms, trace_after_model, emissions_after_call, step_idx + 1, step_idx, output, "ext_solver_accept"),
                              ContinueWithFeedback(feedback) => {
                                let event = ExtSolverFeedback({ step: step_idx, feedback: feedback });
                                let _ = ledger_emit(session_id, event);
                                let next_state: C2LoopState = {
                                  msgs: msgs_with_assistant,
	                                  step_idx: step_idx + 1,
	                                  totals: new_totals,
	                                  ext_artifacts: chain.artifacts,
	                                  telemetry: applied.telemetry,
	                                  provider: st.provider,
	                                  world_state: token_to_world(finalized.next_state),
                                  pending_tool_calls: [],
                                  pending_tool_context: [],
                                  pending_tool_prefix: [],
                                  pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
                                  last_finish_reason: "solver_feedback",
                                  last_response_text: feedback,
                                  nudges_used: applied.nudges_used,
                                  finalize_source: "",
                                  prior_counts: st.prior_counts,
                                  trace: ledger_append(trace_after_model, WireRecord(event)),
                                  emissions: emissions_after_call
                                };
                                c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
                              },
                              NoDecision => {
                                if should_inject_persist_nudge(policy.step.persist_retries, st.nudges_used, any_writefile_attempt(msgs_with_assistant)) then {
                                  let event = PersistNudge({
                                    step: step_idx,
                                    nudge_num: st.nudges_used + 1,
                                    budget: policy.step.persist_retries
                                  });
                                  let _ = ledger_emit(session_id, event);
                                  let next_state: C2LoopState = {
                                    msgs: msgs_with_assistant,
	                                    step_idx: step_idx + 1,
	                                    totals: new_totals,
	                                    ext_artifacts: chain.artifacts,
	                                    telemetry: applied.telemetry,
	                                    provider: st.provider,
	                                    world_state: token_to_world(finalized.next_state),
                                    pending_tool_calls: [],
                                    pending_tool_context: [],
                                    pending_tool_prefix: [],
                                    pending_tool_batched: true,
    accumulated_tool_msgs: [],
    pending_approval: None,
                                    last_finish_reason: "persist_nudge",
                                    last_response_text: result.message.content,
                                    nudges_used: st.nudges_used,
                                    finalize_source: "",
                                    prior_counts: st.prior_counts,
                                    trace: ledger_append(trace_after_model, WireRecord(event)),
                                    emissions: emissions_after_call
                                  };
                                  c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, next_state)
                                } else
	                                  c2_after_dp7(rt, task, env_url, hybrid_tools, budget, policy, model, msgs_with_assistant, workdir, ohmy_pi, max_cost_millicents, cost_rates, new_totals, chain.artifacts, applied.telemetry, st.provider, token_to_world(finalized.next_state), st.prior_counts, session_id, started_at_ms, trace_after_model, emissions_after_call, step_idx + 1, step_idx, result.message.content, "") -- WI-D19
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

func run_v2_from_messages_traced_with_policy(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_from_messages_traced_with_policy_and_counts(rt, task, env_url, hybrid_tools, budget, policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, provider, zero_runtime_status_counts())
}

func run_v2_from_messages_traced_with_policy_and_counts(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider,
  prior_counts: RuntimeStatusCounts
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  -- WI-A12's clock class. Two of the four driver clock sites are here, both
  -- BEFORE the loop starts, and both successors must reach the loop's world:
  -- `started.next_state` is what `c2_initial_state_with_counts` receives, not
  -- `provider.world`. Taking the latter type-checks and silently discards both
  -- reads, leaving the loop on an un-advanced clock.
  let derived = derive_session_id(provider.ports, provider.world);
  let started = provider.ports.clock_now(derived.next_state);
  let session_id = derived.id;
  let started_at_ms = started.now_ms;
  let session_span = "motoko.session.${session_id}";
  Trace.spanStart(session_span);
  let result = c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, c2_initial_state_with_counts(history, provider, started.next_state, prior_counts));
  Trace.spanEnd(session_span);
  result
}

export func run_v2_session_traced(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  -- WI-A12: the provider is normalised FIRST so policy init can read the env
  -- through its ports instead of ambiently.
  let pp = ported_provider(rt, provider);
  let init = session_policy_init(pp.ports, pp.world, model, step_budget, max_cost_millicents, cost_rates);
  run_v2_from_messages_traced_with_policy(rt, task, env_url, hybrid_tools, budget, init.policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, { pp | world: init.next_state })
}

export func run_v2_session_traced_with_persist_retries(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  persist_retries: int,
  provider: StepProvider
) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let pp = ported_provider(rt, provider);
  let init = session_policy_init(pp.ports, pp.world, model, step_budget, max_cost_millicents, cost_rates);
  let base = init.policy;
  let policy: SessionPolicy = {
    step: {
      step_budget: base.step.step_budget,
      max_cost_millicents: base.step.max_cost_millicents,
      cost_metered: base.step.cost_metered,
      persist_retries: persist_retries,
      retry_stream_errors: base.step.retry_stream_errors,
      require_system_prompt: base.step.require_system_prompt,
      model: base.step.model,
      provider_base_url: base.step.provider_base_url,
      checkpoint_enabled: base.step.checkpoint_enabled,
      checkpoint_pct: base.step.checkpoint_pct,
      compaction: base.step.compaction
    },
    headless: base.headless
  };
  run_v2_from_messages_traced_with_policy(rt, task, env_url, hybrid_tools, budget, policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, pp)
}

func run_v2_from_messages_with_policy(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_from_messages_with_policy_and_counts(rt, task, env_url, hybrid_tools, budget, policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, provider, zero_runtime_status_counts())
}

func run_v2_from_messages_with_policy_and_counts(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider,
  prior_counts: RuntimeStatusCounts
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  -- WI-A12's clock class. Two of the four driver clock sites are here, both
  -- BEFORE the loop starts, and both successors must reach the loop's world:
  -- `started.next_state` is what `c2_initial_state_with_counts` receives, not
  -- `provider.world`. Taking the latter type-checks and silently discards both
  -- reads, leaving the loop on an un-advanced clock.
  let derived = derive_session_id(provider.ports, provider.world);
  let started = provider.ports.clock_now(derived.next_state);
  let session_id = derived.id;
  let started_at_ms = started.now_ms;
  let session_span = "motoko.session.${session_id}";
  Trace.spanStart(session_span);
  let result = c2_loop(rt, task, env_url, hybrid_tools, budget, policy, model, workdir, ohmy_pi, max_cost_millicents, cost_rates, session_id, started_at_ms, c2_initial_state_with_counts(history, provider, started.next_state, prior_counts)).result;
  Trace.spanEnd(session_span);
  result
}

export func run_v2(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  initial_msgs: [Msg],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let messages = msgs_to_messages(initial_msgs);
  let pp = ported_provider(rt, provider);
  let init = session_policy_init(pp.ports, pp.world, model, step_budget, max_cost_millicents, cost_rates);
  run_v2_from_messages_with_policy(rt, task, env_url, hybrid_tools, budget, init.policy, model, messages, workdir, ohmy_pi, max_cost_millicents, cost_rates, { pp | world: init.next_state })
}

-- Run loop_v2 starting from an existing [Message] history (instead of the
-- legacy [Msg] shape). Used by conversation_loop_v2 to resume after each
-- user_message arrives — preserves the assistant/tool history accumulated
-- across the prior task so the model retains context.
export func run_v2_from_messages(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let pp = ported_provider(rt, provider);
  let init = session_policy_init(pp.ports, pp.world, model, step_budget, max_cost_millicents, cost_rates);
  run_v2_from_messages_with_policy(rt, task, env_url, hybrid_tools, budget, init.policy, model, history, workdir, ohmy_pi, max_cost_millicents, cost_rates, { pp | world: init.next_state })
}

-- Read a JSON-shaped string field from a decoded Json object, returning
-- "" when the key is absent or has the wrong type. Mirrors rpc.ail's
-- get_str helper (kept inline to avoid an import-time circular reference
-- between rpc.ail and agent_loop_v2.ail).
func msg_get_str(obj: Json, key: string) -> string {
  match get(obj, key) {
    None    => "",
    Some(j) => match asString(j) { None => "", Some(s) => s }
  }
}

-- M8 multi-turn driver: after a v2 task returns, drain stdin for the next
-- user command and resume. Mirrors rpc.ail's conversation_loop in command
-- handling (abort/exit/model_change/user_message) but operates on
-- [Message] history instead of [Msg] + AgentState.
--
-- Commands recognized:
--   abort | exit              → return () (TUI session ends)
--   model_change { model }    → update model, recurse with same history
--   user_message { content }  → append user msg, run_v2_from_messages,
--                                 recurse with returned [Message]
--   anything else (unparseable
--     or unknown type)        → discard line, recurse (matches legacy
--                                 conversation_loop fall-through)
--
-- EOF (readLine returns "") cleanly terminates the loop — the env-server
-- closes stdin when the user exits the TUI.
func conversation_loop_v2_with_policy(
  rt: ExtRuntime,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  policy: SessionPolicy,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: PortedProvider,
  session_id: string,
  prior_counts: RuntimeStatusCounts
) -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  -- Headless mode (M-MOTOKO-HEADLESS, 2026-05-08): skip the stdin-polling
  -- conversation loop entirely when MOTOKO_HEADLESS=1. The TS TUI layer
  -- (src/tui/src/index.ts) sets this env var when stdin is not a TTY
  -- (CLI subprocess, eval-harness adapter, MCP-mediated invocation) so
  -- the agent loop runs the initial task to completion and then exits 0
  -- instead of hanging on readLine() forever (the AILANG readLine builtin
  -- blocks on non-TTY stdin instead of returning EOF). This is the
  -- M-BENCH-MOTOKO Day-1 design that originally got skipped — restored
  -- after the AILANG eval-harness adapter smoke test surfaced the hang
  -- on 2026-05-08 (msg_20260508_102147_4f9aa71d).
  if policy.headless then ()
  else {
  -- NOT routed by WI-A12, deliberately. This read is the interactive
  -- conversation REPL asking for the next USER TURN — it is not approval input,
  -- and it sits ABOVE `run_v2_session_traced`, outside the traced driver surface
  -- D1 scopes `world_state` to. A deterministic run drives the traced entry
  -- point directly and never reaches this loop, which is why withholding a
  -- capability here changes nothing the poison pair observes. Routing the
  -- conversation turn belongs with whatever makes multi-turn sessions
  -- replayable, not with A12.
  let raw = readLine();
  if raw == "" then ()
  else match decode(raw) {
    Err(_) => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider, session_id, prior_counts),
    Ok(obj) => {
      let cmd_type = msg_get_str(obj, "type");
      if cmd_type == "abort" || cmd_type == "exit" then ()
      else if cmd_type == "model_change" then {
        let new_model = msg_get_str(obj, "model");
        -- WI-D3. The ports are the loop's own `PortedProvider`, so the model
        -- switch resolves its new context limit through whatever seams this run
        -- bound rather than through an ambient read.
        --
        -- The SUCCESSOR IS DROPPED HERE, and that is the same decision the
        -- comment above this loop already records for the conversation channel:
        -- this loop threads no world at all, a deterministic run drives the
        -- traced entry point directly and never reaches it, and world-threading
        -- the multi-turn session belongs with whatever makes it replayable. The
        -- successor has nowhere to go until that exists — which is the thing
        -- that would have to change, not a property of this line.
        let switched = session_policy_with_model(provider.ports, provider.world, policy, new_model);
        let next_policy = switched.policy;
        conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, next_policy, new_model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider, session_id, prior_counts)
      }
      else if cmd_type == "restart" then {
        -- Emit session_suspend event and exit cleanly; TUI will respawn
        let target_profile = msg_get_str(obj, "profile");
        let _ = ledger_emit(session_id, SessionSuspend({
          session_id: session_id,
          target_profile: target_profile
        }));
        ()
      }
      else if cmd_type == "user_message" then {
        let content = msg_get_str(obj, "content");
        let user_msg: Message = {
          role: "user",
          content: content,
          tool_calls: [],
          tool_call_id: "",
          images: []
        };
        let next_history = history ++ [user_msg];
        let _ = ledger_emit(session_id, SessionStart({
          task: content,
          model: model,
          mode: "v2"
        }));
        let traced = run_v2_from_messages_traced_with_policy_and_counts(rt, content, env_url, hybrid_tools, budget, policy, model, next_history, workdir, ohmy_pi, max_cost_millicents, cost_rates, provider, prior_counts);
        let next_counts = runtime_status_counts_add(prior_counts, runtime_status_counts(traced.trace));
        match traced.result {
          Ok(updated_history) => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, updated_history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider, session_id, next_counts),
          Err(e) => {
            let _ = ledger_emit(session_id, ErrorEvent({
              source: "agent_loop_v2",
              code: e.code,
              message: e.message
            }));
            conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider, session_id, next_counts)
          }
        }
      }
      else conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, provider, session_id, prior_counts)
    }
  }
  }
}

export func conversation_loop_v2(
  rt: ExtRuntime,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider,
  session_id: string
) -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let live_provider = ported_provider(rt, provider);
  let init = session_policy_init(live_provider.ports, live_provider.world, model, step_budget, max_cost_millicents, cost_rates);
  conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, init.policy, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, { live_provider | world: init.next_state }, session_id, zero_runtime_status_counts())
}

-- M8 combined entry point: runs the initial task via run_v2, then enters
-- conversation_loop_v2 for follow-up turns. On error from the initial run,
-- emits a structured error event and still enters conversation_loop_v2
-- with the original [Msg] history (translated) so the TUI session stays
-- responsive — matching the legacy behavior where run_with_config falls
-- through to conversation_loop after rpc_loop returns.
export func run_v2_with_conversation(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  initial_msgs: [Msg],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  provider: StepProvider
) -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let initial_messages = msgs_to_messages(initial_msgs);
  let live_provider = ported_provider(rt, provider);
  let init = session_policy_init(live_provider.ports, live_provider.world, model, step_budget, max_cost_millicents, cost_rates);
  let policy = init.policy;
  let started_provider = { live_provider | world: init.next_state };
  -- Ordered after `ported_provider` because WI-A12 made `derive_session_id`
  -- read the world clock through the port instead of ambient `now()`, so it
  -- needs the normalised provider. The successor is discarded: this id labels
  -- the outer conversation loop, and each traced run below derives its own from
  -- its own world. That is pre-existing behaviour, not a cursor being dropped.
  let session_id = derive_session_id(started_provider.ports, started_provider.world).id;
  let initial_traced = run_v2_from_messages_traced_with_policy(rt, task, env_url, hybrid_tools, budget, policy, model, initial_messages, workdir, ohmy_pi, max_cost_millicents, cost_rates, started_provider);
  let initial_counts = runtime_status_counts(initial_traced.trace);
  match initial_traced.result {
    Ok(final_history) => conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, final_history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, started_provider, session_id, initial_counts),
    Err(e) => {
      let _ = ledger_emit(session_id, ErrorEvent({
        source: "agent_loop_v2",
        code: e.code,
        message: e.message
      }));
      conversation_loop_v2_with_policy(rt, env_url, hybrid_tools, budget, policy, model, initial_messages, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, live_provider, session_id, initial_counts)
    }
  }
}

-- Run loop_v2 with a scripted provider. No real LLM call made.
-- Intended for integration tests only; not exported from rpc.ail.
export func run_v2_with_stub(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  script: [ScriptedStep]
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_from_messages(rt, task, env_url, hybrid_tools, budget, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, Scripted(script))
}

-- Phase C compatibility adapter. WI-C6 moves the parity fleet to
-- scripted-port imports; keep this entry for external callers until they are
-- audited.
export func run_v2_with_stub_port_adapter(
  rt: ExtRuntime,
  task: string,
  env_url: string,
  hybrid_tools: bool,
  budget: BudgetPlan,
  model: string,
  history: [Message],
  workdir: string,
  step_budget: int,
  ohmy_pi: bool,
  max_cost_millicents: int,
  cost_rates: CostRates,
  script: [ScriptedStep]
) -> Result[[Message], AIError] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  run_v2_with_stub(rt, task, env_url, hybrid_tools, budget, model, history, workdir, step_budget, ohmy_pi, max_cost_millicents, cost_rates, script)
}

-- M-MOTOKO-EVAL-INSTRUMENTATION inline tests (pure-only). Validates the
-- schema-v1 contract surface that downstream eval harnesses depend on.

pure func test_schema_version_is_one() -> bool
  tests [((), true)]
  {
    schema_version() == "1"
  }

pure func test_millicents_to_usd_zero() -> bool
  tests [((), true)]
  {
    millicents_to_usd(0) == 0.0
  }

pure func test_millicents_to_usd_one_dollar() -> bool
  tests [((), true)]
  {
    millicents_to_usd(100000) == 1.0
  }

pure func test_millicents_to_usd_fraction() -> bool
  tests [((), true)]
  {
    -- 12345678 millicents = $123.45678
    millicents_to_usd(12345678) == 123.45678
  }

-- Replaces test_finish_reason_str_table. The integer helper is gone, so the
-- table is pinned over the typed reason instead. The wire strings are a
-- compatibility surface and must not change: every string on the right here is
-- byte-identical to what the integer table produced for the code that reached
-- that path. "dp7_rejected" is absent because no call site ever produced it.
pure func test_finish_reason_wire_table() -> bool
  tests [((), true)]
  {
    finish_reason_wire(TermSuccess) == "stop"
      && finish_reason_wire(TermBudgetExhausted) == "cost_exhausted"
      && finish_reason_wire(TermCompactionExhausted) == "compaction_exhausted"
      && finish_reason_wire(TermMaxSteps) == "max_steps"
      && finish_reason_wire(TermProviderFailure) == "error"
      && finish_reason_wire(TermSystemPromptEmpty) == "error"
      && finish_reason_wire(TermInvalidHistory) == "error"
      && finish_reason_wire(TermInternalFailure) == "error"
  }

-- The reachable Fail codes map to the reasons the integer helper produced.
pure func test_decision_fail_reason_mapping() -> bool
  tests [((), true)]
  {
    finish_reason_wire(decision_fail_reason("BudgetExceeded", "cap")) == "cost_exhausted"
      && finish_reason_wire(decision_fail_reason("ContextExhausted", "r")) == "compaction_exhausted"
      && finish_reason_wire(decision_fail_reason("Internal", "v2 loop: step budget exhausted")) == "max_steps"
      && finish_reason_wire(decision_fail_reason("Internal", "something else")) == "error"
  }

pure func test_zero_totals_initializes_clean() -> bool
  tests [((), true)]
  {
    let z = zero_totals();
    z.input_tokens == 0
      && z.output_tokens == 0
      && z.cache_read == 0
      && z.cache_creation == 0
      && z.cost_millicents == 0
      && z.cost_warned_pct == 0
  }

-- Cache-token plumbing helpers (M4 from M-MOTOKO-EVAL-INSTRUMENTATION):
-- shape sanity for a list-of-kv length given a hypothetical StepResult.

pure func kv_len(xs: [{key: string, value: Json}]) -> int {
  match xs { [] => 0, _ :: rest => 1 + kv_len(rest) }
}

pure func mk_test_step_result(input: int, output: int, cr: int, cc: int) -> StepResult {
  {
    message: { role: "assistant", content: "", tool_calls: [], tool_call_id: "", images: [] },
    tool_calls: [],
    finish_reason: "stop",
    input_tokens: input,
    output_tokens: output,
    cache_read_input_tokens: cr,
    cache_creation_input_tokens: cc
  }
}

pure func test_per_step_usage_kvs_no_cache() -> bool
  tests [((), true)]
  {
    -- No cache fields → exactly 3 kv entries (input, output, cost_usd)
    let r = mk_test_step_result(100, 50, 0, 0);
    kv_len(per_step_usage_kvs(r, 1500)) == 3
  }

pure func test_per_step_usage_kvs_cache_read_only() -> bool
  tests [((), true)]
  {
    -- OpenAI / Gemini case: only cache_read populated → 4 kv entries
    let r = mk_test_step_result(100, 50, 25, 0);
    kv_len(per_step_usage_kvs(r, 1500)) == 4
  }

pure func test_per_step_usage_kvs_full_cache() -> bool
  tests [((), true)]
  {
    -- Anthropic case: both cache_read + cache_creation → 5 kv entries
    let r = mk_test_step_result(100, 50, 25, 12);
    kv_len(per_step_usage_kvs(r, 1500)) == 5
  }

func test_runtime_status_includes_prior_conversation_counts() -> bool ! {IO, Trace}
  tests [((), true)]
  {
    let prior: RuntimeStatusCounts = {
      provider_calls_started: 26,
      provider_calls_completed: 26,
      stage_applied_total: 0,
      stage_rejected_total: 0,
      compaction_ai_applied: 0
    };
    let trace: LedgerTrace = {
      records: [
        WireRecord(ProviderCallPrepared({
          step: 0,
          msg_count: 2,
          estimated_input_tokens: 3,
          system_prefix_count: 1,
          system_prefix_chars: 3,
          system_prefix_digest: "sha256:sys",
          payload_digest: "sha256:payload",
          model: "m"
        })),
        WireRecord(ProviderResult({
          step: 0,
          text: "",
          finish_reason: "tool_calls",
          tool_calls: 1,
          input_tokens: 10,
          output_tokens: 5,
          cost_usd: 0.0,
          cache_read_input_tokens: 0,
          cache_creation_input_tokens: 0
        }))
      ]
    };
    let st: C2LoopState = {
      msgs: [{ role: "system", content: "sys", tool_calls: [], tool_call_id: "", images: [] }],
      step_idx: 1,
      totals: zero_totals(),
      ext_artifacts: jo([]),
      telemetry: { last_input_tokens: 0, last_output_tokens: 0, last_estimated_input_tokens: 0 },
      provider: scripted_ports(),
      world_state: empty_world_state(),
      pending_tool_calls: [],
      pending_tool_context: [],
      pending_tool_prefix: [],
      pending_tool_batched: true,
      accumulated_tool_msgs: [],
      pending_approval: None,
      last_finish_reason: "tool_calls",
      last_response_text: "",
      nudges_used: 0,
      finalize_source: "",
      prior_counts: prior,
      trace: trace,
      emissions: []
    };
    let policy: SessionPolicy = {
      step: {
        step_budget: 100,
        max_cost_millicents: 0,
        cost_metered: false,
        persist_retries: 0,
        retry_stream_errors: false,
        require_system_prompt: true,
        model: "m",
        provider_base_url: "",
        checkpoint_enabled: false,
        checkpoint_pct: 90,
        compaction: {
          context_limit: 1000,
          elide_tier_pct: 70,
          elide_hard_tier_pct: 85,
          emergency_pct: 95
        }
      },
      headless: false
    };
    let encoded = encode(runtime_status_json(st, policy, 0));
    contains(encoded, "\"provider_calls_started\":27")
      && contains(encoded, "\"provider_calls_completed\":27")
      && contains(encoded, "\"steps_executed_so_far\":27")
  }

func test_runtime_status_reports_actual_context_window() -> bool ! {IO, Trace}
  tests [((), true)]
  {
    let st: C2LoopState = {
      msgs: [{ role: "system", content: "sys", tool_calls: [], tool_call_id: "", images: [] }],
      step_idx: 1,
      totals: zero_totals(),
      ext_artifacts: jo([]),
      telemetry: { last_input_tokens: 500, last_output_tokens: 20, last_estimated_input_tokens: 0 },
      provider: scripted_ports(),
      world_state: empty_world_state(),
      pending_tool_calls: [],
      pending_tool_context: [],
      pending_tool_prefix: [],
      pending_tool_batched: true,
      accumulated_tool_msgs: [],
      pending_approval: None,
      last_finish_reason: "tool_calls",
      last_response_text: "",
      nudges_used: 0,
      finalize_source: "",
      prior_counts: zero_runtime_status_counts(),
      trace: { records: [] },
      emissions: []
    };
    let policy: SessionPolicy = {
      step: {
        step_budget: 100,
        max_cost_millicents: 0,
        cost_metered: false,
        persist_retries: 0,
        retry_stream_errors: false,
        require_system_prompt: true,
        model: "m",
        provider_base_url: "",
        checkpoint_enabled: false,
        checkpoint_pct: 90,
        compaction: {
          context_limit: 1000,
          elide_tier_pct: 70,
          elide_hard_tier_pct: 85,
          emergency_pct: 95
        }
      },
      headless: false
    };
    let encoded = encode(runtime_status_json(st, policy, 0));
    -- actual = 500 provider tokens against a 1000 limit => 50%
    contains(encoded, "\"context_limit\":1000")
      && contains(encoded, "\"last_sent\"")
      && contains(encoded, "\"input_tokens\":500")
      && contains(encoded, "\"usage_pct\":50")
      && contains(encoded, "\"uncompacted_pending\"")
      && contains(encoded, "\"note\"")
  }

pure func test_runtime_status_counts_generated_compaction_ai_id() -> bool
  tests [((), true)]
  {
    let trace: LedgerTrace = {
      records: [
        CompactionStageRecord({
          step: 3,
          ext_id: "compaction_ai#0",
          outcome: TraceStageApplied("AI-summarized 1 turns")
        }),
        CompactionStageRecord({
          step: 3,
          ext_id: "compaction_structural#3",
          outcome: TraceStageApplied("structural: tier=emergency keep_last=3")
        }),
        CompactionStageRecord({
          step: 3,
          ext_id: "compaction_ai#0",
          outcome: TraceStageObserved("compaction_ai.summarizer_failed", [{ key: "attempts", value: "2" }])
        })
      ]
    };
    let counts = runtime_status_counts(trace);
    counts.stage_applied_total == 2
      && counts.stage_rejected_total == 0
      && counts.compaction_ai_applied == 1
  }
