-- src/core/ext/registry_normalize.ail
--
-- ADR-001 Phase B, B4: multiplicity validation at the REGISTRATION BOUNDARY.
--
-- At 6.0 an extension registers a list of capability atoms, and one kind may
-- appear more than once. Which repetitions are legal is a HOST policy (ADR
-- §4(b), Q2), and it is enforced ONCE, here, at the single host-owned boundary
-- that turns a package's registration result into a registry entry -- never in
-- a dispatcher. This module is HAND-WRITTEN (plan invariant 5: no hand edits to
-- `registry_generated.ail`); `parse_tokens` CALLS `normalize_registration`
-- once per resolved extension (D10, WIRED AT B8 -- see the B8 note in the
-- generated file: the upstream generator does not yet emit the call, so the
-- generated file carries the edit by hand and says so). Until B8 this module
-- was built and DST'd against a LOCAL sketch of `Capability`; B8 moved that
-- declaration into the ABI and this module imports it.
--
-- 8.0 (031 ADR-001 D2) ADDS TWO THINGS AT THIS BOUNDARY, and nothing moves
-- elsewhere:
--
--   * `register_with_config` returns `ExtRegistration = { config, caps }`, and
--     the entry keeps `config` UNCHANGED. `normalize_registration` takes it as
--     its second argument (the generated registry calls it three-argument from
--     P0.5 on) and carries it onto `ExtEntry.config`, which is the value the
--     dispatchers stamp as `ext_config` on every view they build and the value
--     `ext_config_digest` below hashes. Nothing downstream fills it in.
--   * VOTE FAMILIES. The two decision variants join the two legacy vote kinds
--     in two families -- finalize: `SolverJudge` / `DecisionSolverJudge`;
--     tool-policy: `ToolPolicy` / `DecisionToolPolicy` -- and an extension
--     registers AT MOST ONE atom per family. A legacy and a new variant in one
--     family is the `SecondVote` rejection exactly as two legacy atoms are. One
--     finalize atom and one tool-policy atom coexist.
--
-- 037 ADR-001 D2 ADDS ONE MORE, and it is not a multiplicity rule:
--
--   * THE REGISTRATION REFUSAL. `ExtRegistration` has no error channel, so an
--     extension that has found it must not be started says so in `config`,
--     under the reserved key `registration_refusal`. `normalize_registration`
--     reads that ONE value BEFORE the walk and returns `RegistrationRefused`.
--     The host learns nothing about why: it reads one string and refuses with
--     it. See `read_registration_refusal` below for the four cases.
--
-- THE RULES, and their status:
--
--   D3 (DECIDED)   a second `ToolPolicy` atom is rejected; a second
--                  `SolverJudge` atom is rejected. Both are VOTES in a priority
--                  merge, and one extension does not get two positions.
--                  8.0: the rule is per FAMILY (above), so the second position
--                  is refused whichever variant tries to take it.
--   D3 (DECIDED)   `ToolProvider` N>1 only with DISJOINT advertised names:
--                  a per-extension tool-name set is built across ALL provider
--                  atoms and a duplicate anywhere -- across two atoms or inside
--                  one atom's own list -- is rejected. First-match over
--                  overlapping names would be a hidden intra-extension
--                  precedence.
--   D4 (SIGNED OFF at B8) the fold kinds `PromptShaper`, `BudgetShaper`,
--                  `Compactor` (and the concatenation kind `DescribeTools`, the
--                  first-match kind `ResponseInterceptor`) repeat in list order
--                  = sub-order / precedence / chain order. The gate is the ONE
--                  constant `fold_kind_repeats_allowed` below (`true`); every
--                  fixture that reads it says which reading it measured.
--   7.0 (DECIDED)  `ExitIntent` N>1 is admitted -- it is a CONCATENATION kind
--                  like `DescribeTools`, and one extension may well want an
--                  intent per concern (close panes; settle the run file). What
--                  is rejected is a repeated `label` within one extension, on
--                  exactly `ToolProvider`'s reasoning: the label is how the
--                  published manifest and every diagnostic name the intent, so
--                  two atoms answering to one name is a hidden intra-extension
--                  precedence, not a configuration.
--
--   D7 (ADOPTED)   `register_with_config -> []`. The RECOMMENDED reading is
--                  implemented: the entry is OMITTED from the effective registry
--                  and NAMED in `omitted_empty`, and the profile layer rejects
--                  it as `InstalledWithNoCapabilities` (B3). The alternative --
--                  reject at registration -- is the constant
--                  `empty_registration_omits`. Nothing is dropped silently
--                  either way.
--
-- FAIL-CLOSED SHAPE. A rejection names the extension id, the variant, and the
-- list position of the offending atom. One bad extension rejects the WHOLE
-- registry build (`normalize_registry` returns the first `Err`): silently
-- omitting a mis-registered extension while the others load is the fail-open
-- shape [AR-codex "Missed"], and a host that starts with an extension missing
-- would grade a session that installed less than its profile says.
--
-- ORDER. Atoms pass through in list order. `ExtEntry.caps` is the registration
-- list unchanged when it is accepted -- this is the invariant B5's all-atoms
-- witness reads and B8's registry must preserve (per-extension lists in install
-- order, per-kind concatenation).

module src/core/ext/registry_normalize

import std/list as List (length)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/crypto (sha256Hex)
import std/string (charAt, charCode, startsWith, endsWith, length as string_length)
import std/json (Json, JObject, JArray, JString, JNull, JNumber, encode, get, jo, ja, kv, js, jb)
import pkg/sunholo/motoko_ext_abi/types (
  PureCtx,
  ProcessCtx,
  FsCtx,
  ProviderCtx,
  PromptPatch,
  ToolCallEnvelope,
  ToolPolicyDecision,
  ToolHandleOutcome,
  FinalizeOutcome,
  FinalizeDecision,
  Capability,
  ExtEntry,
  DescribeTools,
  PromptShaper,
  BudgetShaper,
  Compactor,
  ToolPolicy,
  ToolProvider,
  ResponseInterceptor,
  SolverJudge,
  ExitIntent,
  WorkInFlight,
  DecisionSolverJudge,
  DecisionToolPolicy,
  DecisionPolicyDescriptor,
  DecisionRequest,
  DecisionObservation,
  JudgePreparation,
  JudgeImmediate,
  ToolPreparation,
  ToolImmediate,
  ExitAction,
  ExitIntentOutcome,
  WorkOutcome
)

-- `Capability` (the 8.0 sum, twelve kinds) and `ExtEntry` (D5's owner-bearing
-- `{ id, config, caps }`) are the ABI's from B8; the local sketch this module
-- carried through B4..B7 was moved there verbatim.


-- ============================================================================
-- THE TWO POLICY CONSTANTS. Each is the whole of an open decision.
-- ============================================================================

-- D4. SIGNED OFF (B8): `true` = fold/concat/compactor/first-match kinds pass
-- through N>1 in list order (precedence / sub-order / chain order). The
-- `registry_multiplicity` fixtures read it and re-label themselves.
export pure func fold_kind_repeats_allowed() -> bool { true }

-- D7. `true` = the recommended reading: an empty registration is omitted from
-- the effective registry, by name. `false` = it is a registration rejection.
export pure func empty_registration_omits() -> bool { true }

-- ============================================================================
-- Rejections: id, variant, and the list position of the duplicate atom.
-- ============================================================================
export type RegistrationRejection
  = SecondVote(string, string, int)          -- id, kind of the 2nd atom in its vote family, its position
  | FoldKindRepeated(string, string, int)    -- id, kind, position (D4 off)
  | DuplicateToolName(string, string, int)   -- id, tool name, position of the atom
  | DuplicateExitLabel(string, string, int)  -- id, intent label, position of the atom
  | EmptyRegistration(string)                -- id (D7 alternative reading)
  | RegistrationRefused(string, string)      -- id, the refusal's message (037 ADR-001 D2)

export pure func rejection_rule(r: RegistrationRejection) -> string {
  match r {
    SecondVote(_, _, _) => "second-vote-atom",
    FoldKindRepeated(_, _, _) => "fold-kind-repeated",
    DuplicateToolName(_, _, _) => "duplicate-tool-name",
    DuplicateExitLabel(_, _, _) => "duplicate-exit-label",
    EmptyRegistration(_) => "empty-registration",
    RegistrationRefused(_, _) => "registration-refused"
  }
}

export pure func rejection_extension(r: RegistrationRejection) -> string {
  match r {
    SecondVote(e, _, _) => e,
    FoldKindRepeated(e, _, _) => e,
    DuplicateToolName(e, _, _) => e,
    DuplicateExitLabel(e, _, _) => e,
    EmptyRegistration(e) => e,
    RegistrationRefused(e, _) => e
  }
}

export pure func rejection_message(r: RegistrationRejection) -> string {
  match r {
    SecondVote(e, k, p) =>
      "[second-vote-atom] extension '${e}' registers a ${k} at list position ${show(p)} in a vote family that already has an atom; at most one of SolverJudge/DecisionSolverJudge and one of ToolPolicy/DecisionToolPolicy per extension (D3; 031 ADR-001 D2)",
    FoldKindRepeated(e, k, p) =>
      "[fold-kind-repeated] extension '${e}' registers a second ${k} at list position ${show(p)}; N>1 for this kind is admitted only once D4 is signed off (fold_kind_repeats_allowed)",
    DuplicateToolName(e, n, p) =>
      "[duplicate-tool-name] extension '${e}' advertises tool '${n}' twice, the second time in the ToolProvider at list position ${show(p)}; provider names must be disjoint within an extension (D3)",
    DuplicateExitLabel(e, l, p) =>
      "[duplicate-exit-label] extension '${e}' registers a second ExitIntent labelled '${l}' at list position ${show(p)}; intent labels must be disjoint within an extension (7.0)",
    EmptyRegistration(e) =>
      "[empty-registration] extension '${e}' registers no capability atom (D7, the rejecting reading; empty_registration_omits is false)",
    -- The extension's string goes LAST and unedited: it is the message (D2), and
    -- everything before the colon is the host's.
    RegistrationRefused(e, m) =>
      "[registration-refused] extension '${e}' refuses its own registration through the config key '${registration_refusal_key()}' (037 ADR-001 D2): ${m}"
  }
}

export pure func kind_name(c: Capability) -> string {
  match c {
    DescribeTools(_) => "DescribeTools",
    PromptShaper(_) => "PromptShaper",
    BudgetShaper(_) => "BudgetShaper",
    Compactor(_) => "Compactor",
    ToolPolicy(_) => "ToolPolicy",
    ToolProvider(_, _) => "ToolProvider",
    ResponseInterceptor(_) => "ResponseInterceptor",
    SolverJudge(_) => "SolverJudge",
    ExitIntent(_, _, _) => "ExitIntent",
    WorkInFlight(_, _) => "WorkInFlight",
    DecisionSolverJudge(_, _, _) => "DecisionSolverJudge",
    DecisionToolPolicy(_, _, _) => "DecisionToolPolicy"
  }
}

-- 8.0: the vote FAMILY an atom votes in, or `None` for a kind that is not a
-- vote. The two families are 031 ADR-001 D2's: at most one of
-- `SolverJudge`/`DecisionSolverJudge` and at most one of
-- `ToolPolicy`/`DecisionToolPolicy` per extension. Kind names are NOT the
-- family key -- that is exactly what let a legacy and a new variant pass as
-- "different kinds" -- so the walk below tracks families beside kinds.
-- contracts: SKIPPED — the fragment cannot declare `Capability`'s sorts: "sort
-- "Record_key_value" referenced in declaration of "Json" is not declared". The
-- property worth stating is that these four kinds fall into exactly TWO families,
-- so no vote kind is quietly its own family and D2's at-most-one is per family
-- rather than per kind; tried as
-- `result == None || result == Some("tool-policy") || result == Some("finalize")`
-- and skipped on the same unresolved sort. The rule it serves is checked by the
-- three one-family fixtures below.
export pure func vote_family(c: Capability) -> Option[string] {
  match c {
    ToolPolicy(_) => Some("tool-policy"),
    DecisionToolPolicy(_, _, _) => Some("tool-policy"),
    SolverJudge(_) => Some("finalize"),
    DecisionSolverJudge(_, _, _) => Some("finalize"),
    _ => None
  }
}


pure func contains_str(xs: [string], s: string) -> bool {
  match xs {
    [] => false,
    x :: rest => if x == s then true else contains_str(rest, s)
  }
}

-- Adds `names` to `seen` one at a time, so a name repeated INSIDE one atom's
-- own list is caught exactly like one repeated across atoms.
pure func add_names(id: string, pos: int, names: [string], seen: [string]) -> Result[[string], RegistrationRejection] {
  match names {
    [] => Ok(seen),
    n :: rest =>
      if contains_str(seen, n) then Err(DuplicateToolName(id, n, pos))
      else add_names(id, pos, rest, n :: seen)
  }
}

-- One pass, in list order. `seen_kinds` are the kind names already admitted;
-- `seen_families` the vote families already holding an atom (8.0);
-- `seen_tools` the tool-name set so far; `seen_labels` the ExitIntent labels.
-- Every atom is either admitted in place or is the FIRST rejection -- never
-- skipped.
--
-- `ExitIntent` is exempted from the fold-kind gate for the same reason
-- `ToolProvider` is: its multiplicity rule is its own (disjoint labels), so
-- flipping D4 to `false` must not silently turn a legal second intent into a
-- `fold-kind-repeated`.
pure func walk(id: string, caps: [Capability], pos: int, seen_kinds: [string], seen_families: [string], seen_tools: [string], seen_labels: [string]) -> Result[(), RegistrationRejection] {
  match caps {
    [] => Ok(()),
    c :: rest => {
      let k = kind_name(c);
      let repeated = contains_str(seen_kinds, k);
      -- 8.0: THE FAMILY GATE comes first and subsumes the 7.x "repeated vote
      -- kind" test -- a repeated vote kind is, a fortiori, a second atom in a
      -- family that already has one.
      let family = vote_family(c);
      let family_taken = match family {
        Some(f) => contains_str(seen_families, f),
        None => false
      };
      -- INLINE, and not a helper. A
      -- `pure func` taking a `Capability` VERIFIES a trivial contract, so
      -- ADR-001 §4 requires a real one; an `ensures` over an ADT parameter has
      -- no generator, so `ailang test` reports "properties never ran" and exits
      -- 1, failing `make registry_multiplicity`. The two neighbours predate that
      -- rule and are grandfathered; a new one is not, and the match is as clear.
      -- `is_provider` was deleted with this edit: inlining took its only caller,
      -- and a dead predicate sitting beside a live one is how a reader learns
      -- the wrong rule.
      let repeat_exempt = match c {
        ToolProvider(_, _) => true,
        ExitIntent(_, _, _) => true,
        -- 7.3: a CONCATENATION kind like the two above it. One extension may be
        -- waiting on several unrelated things and there is nothing to arbitrate
        -- between them, so N>1 is admitted. Labels are NOT required to be
        -- disjoint the way `ExitIntent`'s are: an exit label names an action the
        -- host will execute and must identify it, where a work label is only a
        -- word in a diagnostic.
        WorkInFlight(_, _) => true,
        _ => false
      };
      if family_taken then Err(SecondVote(id, k, pos))
      else if repeated && not repeat_exempt && not fold_kind_repeats_allowed() then Err(FoldKindRepeated(id, k, pos))
      else {
        let seen_families2 = match family {
          Some(f) => f :: seen_families,
          None => seen_families
        };
        let tools = match c {
          ToolProvider(names, _) => add_names(id, pos, names, seen_tools),
          _ => Ok(seen_tools)
        };
        match tools {
          Err(e) => Err(e),
          Ok(seen_tools2) => {
            let labels = match c {
              ExitIntent(label, _, _) =>
                if contains_str(seen_labels, label) then Err(DuplicateExitLabel(id, label, pos))
                else Ok(label :: seen_labels),
              _ => Ok(seen_labels)
            };
            match labels {
              Err(e) => Err(e),
              Ok(seen_labels2) => walk(id, rest, pos + 1, k :: seen_kinds, seen_families2, seen_tools2, seen_labels2)
            }
          }
        }
      }
    }
  }
}

-- ============================================================================
-- 037 ADR-001 D2: THE REGISTRATION REFUSAL.
--
-- The reserved `config` key. The HOST's copy of the string: an extension that
-- refuses writes the same literal, and the ABI package exports neither (a
-- shared owner would be an 8.1 minor -- D2 prices that sweep), so the two are
-- tied by a row in scripts/dst/registry_multiplicity_dst.ail instead.
-- The contract is `result != ""` rather than the literal, on
-- `exit_manifest.manifest_path_var`'s reasoning: an EMPTY key would make the
-- reader look up a key no extension sets, and the host would then start every
-- extension that refuses -- silently, since "no refusal" is the ordinary case.
-- Pinning the literal would be spec-equals-body; the `tests` clause pins it.
-- ============================================================================
export pure func registration_refusal_key() -> string
  ensures { result != "" }
  tests [((), "registration_refusal")]
  { "registration_refusal" }

-- What the host says when the key holds something that is not a string. Its
-- own message, since there is no extension string to pass on.
export pure func malformed_registration_refusal() -> string
  ensures { result != "" }
  tests [((), "the value of 'registration_refusal' is not a string; a refusal is a string, so this registration is refused as malformed")]
  { "the value of 'registration_refusal' is not a string; a refusal is a string, so this registration is refused as malformed" }

-- THE READER. `Some(message)` refuses the registration; `None` does not.
--
--   key absent, or `config` not an object   -> None
--   key present, the empty string           -> None
--   key present, a non-empty string         -> Some(that string, unedited)
--   key present, any other JSON type        -> Some(malformed_registration_refusal())
--
-- The last row is the fail-closed one: an extension that meant to refuse and
-- wrote `true`, `null` or a list of violations must not start because the host
-- found nothing it recognised. A key repeated in one object is read as its
-- FIRST occurrence -- `std/json.get`'s reading, and so the one the extension
-- gets when it reads its own `ext_config`.
-- contracts: SKIPPED — "calls "get" whose signature uses an unencodable type
-- "Option[Json]"" (and "has deeply nested patterns", which flattening would
-- clear without clearing the first). The property worth stating is that a
-- refusal never carries an EMPTY message -- tried as `result != Some("")` and
-- skipped on the same callee. The four rows above are the inline tests
-- `test_refusal_*` below, one per row.
export pure func read_registration_refusal(config: Json) -> Option[string] {
  match get(config, registration_refusal_key()) {
    None => None,
    Some(JString(s)) => if s == "" then None else Some(s),
    Some(_) => Some(malformed_registration_refusal())
  }
}

-- THE BOUNDARY. `caps` passes through UNCHANGED on acceptance -- list order is
-- the order every dispatcher sees -- and so does `config` (8.0): the entry's
-- `config` IS the registration's, byte for byte, which is what makes the
-- stamped `ext_config` and the digest below statements about what the
-- extension returned.
--
-- 037 ADR-001 D2: THE REFUSAL IS READ FIRST -- before the D7 empty-list test
-- and before the walk -- so a registration that refuses is rejected AS a
-- refusal whatever its atoms are, and the message an operator sees is the
-- extension's own rather than whichever multiplicity rule its list happened
-- to trip. An accepted entry still carries `config` unchanged, the key
-- included when it is the empty string.
export pure func normalize_registration(id: string, config: Json, caps: [Capability]) -> Result[ExtEntry, RegistrationRejection] {
  match read_registration_refusal(config) {
    Some(m) => Err(RegistrationRefused(id, m)),
    None =>
      if List.length(caps) == 0 && not empty_registration_omits() then Err(EmptyRegistration(id))
      else match walk(id, caps, 0, [], [], [], []) {
        Err(e) => Err(e),
        Ok(_) => Ok({ id: id, config: config, caps: caps })
      }
  }
}

-- The whole registry. `entries` are the accepted NON-EMPTY registrations in
-- install order; `omitted_empty` names every extension D7 omitted, so the
-- omission is disclosed rather than silent. The first rejecting extension
-- rejects the build.
export type NormalizedRegistry = { entries: [ExtEntry], omitted_empty: [string] }

@allow_empty_ok("an empty registry is a legitimate NormalizedRegistry — zero entries and zero omissions (D7); callers distinguish it from error via the Result")
export pure func normalize_registry(regs: [ExtEntry]) -> Result[NormalizedRegistry, RegistrationRejection] {
  match regs {
    [] => Ok({ entries: [], omitted_empty: [] }),
    r :: rest =>
      match normalize_registration(r.id, r.config, r.caps) {
        Err(e) => Err(e),
        Ok(entry) =>
          match normalize_registry(rest) {
            Err(e) => Err(e),
            Ok(tail) =>
              if List.length(entry.caps) == 0
              then Ok({ entries: tail.entries, omitted_empty: r.id :: tail.omitted_empty })
              else Ok({ entries: entry :: tail.entries, omitted_empty: tail.omitted_empty })
          }
      }
  }
}

-- ============================================================================
-- 8.0 (031 ADR-001 D2, N58): THE CONFIG DIGEST, per extension, per policy epoch.
--
-- WHAT IT COVERS. The entry's `config` -- what `register_with_config` returned
-- and the host stamps as `ext_config` -- PLUS the constructor DATA POSITIONS of
-- every atom, in list order: `ToolProvider`'s advertised names, `ExitIntent`'s
-- label and `enabled` flag, `WorkInFlight`'s label. Those three carry
-- registration-time state the host acts on WITHOUT invoking a callback (the
-- catalog advertises the names; the exit machinery reads the flag; the ABI
-- says `enabled` is "resolved and captured at registration"), so a change to
-- them on resume is the same event as a config change and must move the same
-- digest. Each atom is projected as one JSON object naming its kind, so a
-- position is unambiguous in the epoch snapshot the journal records beside
-- `config`; kinds carrying no data project to the bare kind object.
--
-- WHAT IT DOES NOT COVER, and why. (i) Callbacks: closures cannot be hashed
-- and are identified by the extension's version, not here. (ii) The decision
-- variants' `DecisionPolicyDescriptor`: its two config projections and limit
-- have their OWN resume row with their own refusal semantics (D6's `Descriptor`
-- row; strict replay compares "the full config epoch as well as the two
-- descriptor projections"), and N58's enumeration of data positions is the
-- three above. Folding the descriptor in here would make one edit two events.
-- (iii) Kinds and ids as a SET: that is `runtime.ext_set_digest`, which stays
-- kind-only for the `ExtSet` resume row and must not learn about `config`.
--
-- CANONICAL. `std/json.encode` preserves object key order, so two equal
-- configurations written in different key order would hash differently. The
-- material is canonicalised first: object keys sorted by byte value,
-- recursively; arrays keep their order (a tool-name list IS ordered).
-- ============================================================================

-- The data positions of one atom, as the epoch snapshot records them.
-- contracts: SKIPPED — builds `Json`: "calls user function "js" that is not
-- SMT-encodable in this context". `result != jo([])` -- every atom discloses at
-- least its kind, so no atom hashes as the empty object -- skips on the same call.
-- Which positions are disclosed is asserted by the four `test_config_digest_sees_*`
-- cases below, each of which moves one position and requires the digest to move.
export pure func capability_data(c: Capability) -> Json {
  let kind = kv("kind", js(kind_name(c)));
  match c {
    ToolProvider(names, _) => jo([kind, kv("tools", ja(strings_json(names)))]),
    ExitIntent(label, enabled, _) => jo([kind, kv("label", js(label)), kv("enabled", jb(enabled))]),
    WorkInFlight(label, _) => jo([kind, kv("label", js(label))]),
    _ => jo([kind])
  }
}

-- contracts: BLOCKED — RECURSIVE over the name list. `length(result) == length(xs)`
-- -- a provider's advertised names are neither dropped nor duplicated on the way
-- into the digest material -- ERRORS rather than skipping: "unrolling recursive
-- function: ... unsupported pattern type *core.ListPattern in SMT encoding". The
-- fragment cannot unroll a cons pattern at all, so no contract reaches the solver.
pure func strings_json(xs: [string]) -> [Json] {
  match xs {
    [] => [],
    x :: rest => js(x) :: strings_json(rest)
  }
}

-- contracts: BLOCKED — RECURSIVE; see `strings_json`. `length(result) ==
-- length(caps)` -- one data position per atom, list order preserved, which is what
-- makes the digest sensitive to atom ORDER and not just to atom content -- ERRORS on
-- the same ListPattern unrolling.
pure func atoms_data(caps: [Capability]) -> [Json] {
  match caps {
    [] => [],
    c :: rest => capability_data(c) :: atoms_data(rest)
  }
}

-- The value the digest is taken over, before canonicalisation: `config` beside
-- the atoms' data positions in list order.
-- contracts: SKIPPED — builds `Json`: "calls user function "kv" that is not
-- SMT-encodable in this context". The property is ADR-001 (031) N58's and it is the
-- reason this function exists: the material carries `config` AND the atoms' data
-- positions, so a digest cannot be blind to either half. `result != jo([])` skips on
-- the same call. `test_config_digest_covers_config` holds the atoms fixed and moves
-- the config; the four `sees` cases hold the config fixed and move a position.
export pure func config_digest_material(config: Json, caps: [Capability]) -> Json {
  jo([kv("config", config), kv("atoms", ja(atoms_data(caps)))])
}

-- Byte-order string comparison (no `<` on strings at the pin): -1, 0, 1.
-- contracts: SKIPPED — uses an unencodable builtin: std/string.charAt. Tried as
-- `result == -1 || result == 0 || result == 1`, the ordering's three-valued range,
-- and the builtin is refused before the contract is considered ("Z3 has no SMT-LIB
-- encoding for std/string.charAt"). That this is a TOTAL order -- antisymmetric, so
-- `sort_kvs` cannot depend on input order -- is what
-- `test_config_digest_ignores_callbacks_and_is_canonical` reads through the digest.
pure func compare_bytes(a: string, b: string, i: int) -> int {
  if i >= string_length(a) then (if i >= string_length(b) then 0 else -1)
  else if i >= string_length(b) then 1
  else {
    let ac = charCode(charAt(a, i));
    let bc = charCode(charAt(b, i));
    if ac < bc then -1 else if ac > bc then 1 else compare_bytes(a, b, i + 1)
  }
}

-- contracts: BLOCKED — RECURSIVE over the sorted list. `length(result) ==
-- length(sorted) + 1` -- insertion adds exactly one key and drops none, so sorting
-- cannot silently deduplicate two equal keys into one -- ERRORS: "unrolling recursive
-- function: ... unsupported pattern type *core.ListPattern in SMT encoding".
pure func insert_kv(p: { key: string, value: Json }, sorted: [{ key: string, value: Json }]) -> [{ key: string, value: Json }] {
  match sorted {
    [] => [p],
    q :: rest => if compare_bytes(p.key, q.key, 0) <= 0 then p :: sorted else q :: insert_kv(p, rest)
  }
}

-- contracts: BLOCKED — RECURSIVE; see `insert_kv`. `length(result) == length(kvs)`
-- -- the sort is a PERMUTATION and not a filter, which is what makes canonicalisation
-- order-only and the digest lossless -- ERRORS on the same ListPattern unrolling.
pure func sort_kvs(kvs: [{ key: string, value: Json }]) -> [{ key: string, value: Json }] {
  match kvs {
    [] => [],
    p :: rest => insert_kv(p, sort_kvs(rest))
  }
}

-- contracts: BLOCKED — MUTUALLY RECURSIVE with `canonical`: "circular function call
-- detected: canonical_list → canonical → canonical_list". `length(result) ==
-- length(kvs)` -- recursing into the values rewrites no key and loses no pair --
-- fails to encode for the cycle, not for want of a property.
pure func canonical_kvs(kvs: [{ key: string, value: Json }]) -> [{ key: string, value: Json }] {
  match kvs {
    [] => [],
    p :: rest => {
      let q: { key: string, value: Json } = { key: p.key, value: canonical(p.value) };
      q :: canonical_kvs(rest)
    }
  }
}

-- contracts: BLOCKED — MUTUALLY RECURSIVE; the verifier names the other arc of the
-- same cycle: "circular function call detected: canonical → canonical_kvs →
-- canonical". `length(result) == length(xs)` -- ARRAY ORDER IS PRESERVED, the half of
-- canonicalisation that must NOT sort, since a tool-name list is ordered -- ERRORS
-- there.
pure func canonical_list(xs: [Json]) -> [Json] {
  match xs {
    [] => [],
    x :: rest => canonical(x) :: canonical_list(rest)
  }
}

-- Object keys sorted by byte value at every depth; everything else unchanged.
-- contracts: SKIPPED — "calls user function "canonical_kvs" that is not
-- SMT-encodable in this context", that callee being blocked by the cycle above. The
-- property is the comment's: key ORDER is the only thing canonicalisation changes.
-- `result != JNull` skips on the same callee. Checked through the digest by
-- `test_config_digest_ignores_callbacks_and_is_canonical`, which writes one config
-- in two key orders and requires one digest.
export pure func canonical(j: Json) -> Json {
  match j {
    JObject(kvs) => JObject(sort_kvs(canonical_kvs(kvs))),
    JArray(xs) => JArray(canonical_list(xs)),
    other => other
  }
}

-- contracts: BLOCKED — the `canonical` cycle again: "circular function call
-- detected: canonical_list → canonical → canonical_kvs → canonical". Even
-- `result != ""` ERRORS. Determinism for equal inputs -- the property this function
-- exists for -- relates TWO calls, which the single-result `ensures` form cannot
-- state even where the fragment reaches; the digest fixtures below compare two calls
-- directly, which is the shape the claim actually has.
export pure func canonical_json(j: Json) -> string {
  encode(canonical(j))
}

-- The digest: `sha256:` over the canonical JSON of the material.
-- contracts: SKIPPED — uses an unencodable builtin: show, from the `"sha256:${...}"`
-- interpolation ("Z3 has no SMT-LIB encoding for show"). `result != ""` was tried and
-- skips on the same builtin. What the digest must depend on -- the config AND the
-- constructor data positions, ADR-001 (031) N58 -- is a statement about how the
-- result MOVES when an input moves, so it needs two calls: the four
-- `test_config_digest_sees_*` cases each move one position and require a different
-- digest, and `test_config_digest_ignores_callbacks_and_is_canonical` moves a
-- callback and requires the same one.
export pure func ext_config_digest(e: ExtEntry) -> string {
  "sha256:${sha256Hex(canonical_json(config_digest_material(e.config, e.caps)))}"
}

-- Every entry's digest, registry order -- the per-epoch snapshot's row list.
export type ExtConfigDigest = { id: string, digest: string }

-- contracts: BLOCKED — RECURSIVE, and through `ext_config_digest` it inherits the
-- `canonical` cycle besides: "circular function call detected: canonical_json →
-- canonical → canonical_list → canonical". `length(result) == length(entries)` --
-- one row per entry in registry order, so a snapshot cannot silently omit an
-- extension -- ERRORS for that reason.
export pure func ext_config_digests(entries: [ExtEntry]) -> [ExtConfigDigest] {
  match entries {
    [] => [],
    e :: rest => {
      -- bound first: the pin's parser reads `{ ... } :: xs` in arm position as a pattern
      let row: ExtConfigDigest = { id: e.id, digest: ext_config_digest(e) };
      row :: ext_config_digests(rest)
    }
  }
}

-- ============================================================================
-- Inline tests. The fixture REGISTRATIONS live in
-- scripts/dst/registry_multiplicity_dst.ail (`make registry_multiplicity`).
-- 8.0: every payload takes its row's VIEW; nothing here receives `ExtCtx`.
-- ============================================================================

pure func p_shape(_ctx: PureCtx) -> PromptPatch { { prepend: [], append: [] } }
pure func p_policy(_ctx: PureCtx, _call: ToolCallEnvelope) -> ToolPolicyDecision { NoOpinion }
pure func p_handle(ctx: ProviderCtx, _call: ToolCallEnvelope)
  -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand, Trace} {
  { decision: Delegate, next_state: ctx.world }
}
pure func p_judge(ctx: ProcessCtx, _c: string) -> FinalizeOutcome ! {Process} {
  { decision: NoDecision, next_state: ctx.world }
}

-- The decision variants' neutral payloads: never query, never vote.
pure func p_desc(local_id: string) -> DecisionPolicyDescriptor {
  { local_id: local_id, question_version: "1", question_config: jo([]), interpretation_version: "1", interpretation_config: jo([]), max_interventions: 0 }
}
pure func p_prepare_judge(_ctx: PureCtx, _c: string) -> JudgePreparation { JudgeImmediate(NoDecision) }
pure func p_interpret_judge(_ctx: PureCtx, _c: string, _r: DecisionRequest, _o: DecisionObservation) -> FinalizeDecision { NoDecision }
pure func p_prepare_tool(_ctx: PureCtx, _call: ToolCallEnvelope) -> ToolPreparation { ToolImmediate(NoOpinion) }
pure func p_interpret_tool(_ctx: PureCtx, _call: ToolCallEnvelope, _r: DecisionRequest, _o: DecisionObservation) -> ToolPolicyDecision { NoOpinion }

pure func no_cfg() -> Json { jo([]) }

pure func test_clean_registration_passes_in_order() -> bool
  tests [((), true)]
  {
    match normalize_registration("clean", no_cfg(), [PromptShaper(p_shape), ToolPolicy(p_policy), ToolProvider(["A", "B"], p_handle)]) {
      Ok(e) => e.id == "clean" && List.length(e.caps) == 3 && kind_name(first(e.caps)) == "PromptShaper",
      Err(_) => false
    }
  }

pure func first(cs: [Capability]) -> Capability {
  match cs {
    [] => DescribeTools(\_ . []),
    c :: _ => c
  }
}

pure func test_second_policy_is_rejected_by_position() -> bool
  tests [((), true)]
  {
    match normalize_registration("twice", no_cfg(), [ToolPolicy(p_policy), PromptShaper(p_shape), ToolPolicy(p_policy)]) {
      Err(SecondVote(e, k, p)) => e == "twice" && k == "ToolPolicy" && p == 2,
      _ => false
    }
  }

-- 8.0: a legacy and a new variant in ONE vote family is the same rejection as
-- two legacy atoms, in either order, and the rejection names the SECOND atom.
pure func test_legacy_and_new_finalize_votes_in_one_family_are_rejected() -> bool
  tests [((), true)]
  {
    let legacy_first = match normalize_registration("fam", no_cfg(), [SolverJudge(p_judge), DecisionSolverJudge(p_desc("j"), p_prepare_judge, p_interpret_judge)]) {
      Err(SecondVote(e, k, p)) => e == "fam" && k == "DecisionSolverJudge" && p == 1,
      _ => false
    };
    let new_first = match normalize_registration("fam", no_cfg(), [DecisionSolverJudge(p_desc("j"), p_prepare_judge, p_interpret_judge), PromptShaper(p_shape), SolverJudge(p_judge)]) {
      Err(SecondVote(e, k, p)) => e == "fam" && k == "SolverJudge" && p == 2,
      _ => false
    };
    legacy_first && new_first
  }

pure func test_legacy_and_new_tool_policy_votes_in_one_family_are_rejected() -> bool
  tests [((), true)]
  {
    let legacy_first = match normalize_registration("fam", no_cfg(), [ToolPolicy(p_policy), DecisionToolPolicy(p_desc("t"), p_prepare_tool, p_interpret_tool)]) {
      Err(SecondVote(e, k, p)) => e == "fam" && k == "DecisionToolPolicy" && p == 1,
      _ => false
    };
    let new_first = match normalize_registration("fam", no_cfg(), [DecisionToolPolicy(p_desc("t"), p_prepare_tool, p_interpret_tool), ToolPolicy(p_policy)]) {
      Err(SecondVote(e, k, p)) => e == "fam" && k == "ToolPolicy" && p == 1,
      _ => false
    };
    let two_new = match normalize_registration("fam", no_cfg(), [DecisionToolPolicy(p_desc("t"), p_prepare_tool, p_interpret_tool), DecisionToolPolicy(p_desc("u"), p_prepare_tool, p_interpret_tool)]) {
      Err(SecondVote(_, k, p)) => k == "DecisionToolPolicy" && p == 1,
      _ => false
    };
    legacy_first && new_first && two_new
  }

-- 8.0: the two families are independent -- one finalize atom and one
-- tool-policy atom coexist, whichever variant each is.
pure func test_one_finalize_and_one_tool_policy_atom_coexist() -> bool
  tests [((), true)]
  {
    let both_new = match normalize_registration("co", no_cfg(), [DecisionSolverJudge(p_desc("j"), p_prepare_judge, p_interpret_judge), DecisionToolPolicy(p_desc("t"), p_prepare_tool, p_interpret_tool)]) {
      Ok(e) => List.length(e.caps) == 2,
      Err(_) => false
    };
    let mixed = match normalize_registration("co", no_cfg(), [SolverJudge(p_judge), DecisionToolPolicy(p_desc("t"), p_prepare_tool, p_interpret_tool), PromptShaper(p_shape)]) {
      Ok(e) => List.length(e.caps) == 3,
      Err(_) => false
    };
    both_new && mixed
  }

pure func test_kind_name_covers_the_decision_variants() -> bool
  tests [((), true)]
  {
    kind_name(DecisionSolverJudge(p_desc("j"), p_prepare_judge, p_interpret_judge)) == "DecisionSolverJudge"
      && kind_name(DecisionToolPolicy(p_desc("t"), p_prepare_tool, p_interpret_tool)) == "DecisionToolPolicy"
      && (match vote_family(PromptShaper(p_shape)) { None => true, Some(_) => false })
      && (match vote_family(SolverJudge(p_judge)) { Some(f) => f == "finalize", None => false })
  }

-- 8.0: the entry's `config` is the registration's, unchanged.
pure func test_config_is_carried_unchanged_onto_the_entry() -> bool
  tests [((), true)]
  {
    let cfg = jo([kv("model", js("m")), kv("limit", jb(true))]);
    match normalize_registration("cfg", cfg, [PromptShaper(p_shape)]) {
      Ok(e) => encode(e.config) == encode(cfg),
      Err(_) => false
    }
  }

pure func test_overlapping_provider_names_are_rejected() -> bool
  tests [((), true)]
  {
    let across = match normalize_registration("ov", no_cfg(), [ToolProvider(["A"], p_handle), ToolProvider(["B", "A"], p_handle)]) {
      Err(DuplicateToolName(_, n, p)) => n == "A" && p == 1,
      _ => false
    };
    let within = match normalize_registration("in", no_cfg(), [ToolProvider(["A", "A"], p_handle)]) {
      Err(DuplicateToolName(_, n, p)) => n == "A" && p == 0,
      _ => false
    };
    across && within
  }

-- contracts: SKIPPED — "SMT declaration closure could not resolve a required
-- sort ... "Record_key_value" referenced in declaration of "Json" is not
-- declared". `FsCtx` reaches `Json` through its artifacts, so every fixture
-- taking one is blocked here; it is a neutral payload for the multiplicity tests
-- and carries no property worth stating anyway.
pure func p_exit(ctx: FsCtx) -> ExitIntentOutcome ! {FS}
  { { actions: [], next_state: ctx.world } }

pure func p_work(ctx: FsCtx) -> WorkOutcome ! {FS}
  { { items: [], next_state: ctx.world } }

-- 7.0. Two intents pass in list order; two intents ANSWERING TO ONE LABEL do
-- not. The second half is the rule that matters: the label is the manifest's
-- key, so a repeat would publish two lists under one name.
-- contracts: SKIPPED — "has deeply nested patterns" and "calls "add_names" whose
-- signature uses an unencodable type "Result[list[string], RegistrationRejection]"".
-- The assertion IS the test's `tests [...]` block, which runs under `ailang test`.
pure func test_exit_intents_repeat_but_labels_must_be_disjoint() -> bool
  tests [((), true)]
  {
    let two = match normalize_registration("two", no_cfg(), [ExitIntent("panes", true, p_exit), ExitIntent("run-file", false, p_exit)]) {
      Ok(e) => List.length(e.caps) == 2,
      Err(_) => false
    };
    let dup = match normalize_registration("dup", no_cfg(), [ExitIntent("panes", true, p_exit), ToolPolicy(p_policy), ExitIntent("panes", true, p_exit)]) {
      Err(DuplicateExitLabel(e, l, p)) => e == "dup" && l == "panes" && p == 2,
      _ => false
    };
    two && dup
  }

-- The D4 gate reads the constant, so this test states the SAME expectation
-- either way: repeated fold kinds are rejected exactly when the constant is
-- false.
pure func test_fold_kind_repeat_follows_the_d4_constant() -> bool
  tests [((), true)]
  {
    let r = normalize_registration("fold", no_cfg(), [PromptShaper(p_shape), PromptShaper(p_shape)]);
    match r {
      Err(FoldKindRepeated(_, k, p)) => k == "PromptShaper" && p == 1 && not fold_kind_repeats_allowed(),
      Ok(e) => List.length(e.caps) == 2 && fold_kind_repeats_allowed(),
      Err(_) => false
    }
  }

pure func test_one_bad_extension_rejects_the_build_and_empties_are_named() -> bool
  tests [((), true)]
  {
    let good: ExtEntry = { id: "good", config: no_cfg(), caps: [ToolPolicy(p_policy)] };
    let empty: ExtEntry = { id: "empty", config: no_cfg(), caps: [] };
    let bad: ExtEntry = { id: "bad", config: no_cfg(), caps: [SolverJudge(p_judge), SolverJudge(p_judge)] };
    let whole = match normalize_registry([good, empty, bad]) {
      Err(SecondVote(e, k, p)) => e == "bad" && k == "SolverJudge" && p == 1,
      _ => false
    };
    let named = match normalize_registry([good, empty]) {
      Ok(n) => List.length(n.entries) == 1 && List.length(n.omitted_empty) == 1 && empty_registration_omits(),
      Err(EmptyRegistration(e)) => e == "empty" && not empty_registration_omits(),
      Err(_) => false
    };
    whole && named
  }

-- ----------------------------------------------------------------------------
-- 037 ADR-001 D2 / A4: the registration refusal, as pure tests of
-- `normalize_registration`. One test per row of `read_registration_refusal`'s
-- table, then the ordinary registration, the order, and the whole build.
--
-- THE KEY IS WRITTEN AS A LITERAL in every fixture, the way an extension writes
-- it, and never as `registration_refusal_key()`: a test that built its config
-- from the host's own function would pass whatever that function returned.
-- ----------------------------------------------------------------------------

pure func refusal_caps() -> [Capability] {
  [PromptShaper(p_shape), ToolPolicy(p_policy), ToolProvider(["A", "B"], p_handle)]
}

-- An ordinary key beside the reserved one, so the reader is shown to pick ITS
-- key out of a config rather than to react to a config of one key.
pure func refusal_cfg(v: Json) -> Json { jo([kv("model", js("m")), kv("registration_refusal", v)]) }

pure func refuses_with(config: Json, message: string) -> bool {
  match normalize_registration("r#0", config, refusal_caps()) {
    Err(RegistrationRefused(e, m)) => e == "r#0" && m == message,
    _ => false
  }
}

pure func accepts_unchanged(config: Json) -> bool {
  match normalize_registration("r#0", config, refusal_caps()) {
    Ok(e) => e.id == "r#0" && encode(e.config) == encode(config) && List.length(e.caps) == 3,
    Err(_) => false
  }
}

-- A4, case 1. A non-empty string refuses, and that string IS the message: the
-- variant carries it unedited and the rendered line ends with it.
pure func test_refusal_non_empty_string_refuses_with_that_string() -> bool
  tests [((), true)]
  {
    let said = "two violations: a/SKILL.md V1; b/SKILL.md V4";
    let r = RegistrationRefused("r#0", said);
    refuses_with(refusal_cfg(js(said)), said)
      && rejection_rule(r) == "registration-refused"
      && rejection_extension(r) == "r#0"
      && startsWith(rejection_message(r), "[registration-refused] extension 'r#0' ")
      && endsWith(rejection_message(r), ": ${said}")
  }

-- A4, case 2. Every JSON type that is not a string refuses as malformed --
-- `null` included: the key is PRESENT, and an extension that wrote it meant
-- something by it.
pure func test_refusal_non_string_value_refuses_as_malformed() -> bool
  tests [((), true)]
  {
    let m = malformed_registration_refusal();
    refuses_with(refusal_cfg(JNull), m)
      && refuses_with(refusal_cfg(jb(true)), m)
      && refuses_with(refusal_cfg(jb(false)), m)
      && refuses_with(refusal_cfg(JNumber(0.0)), m)
      && refuses_with(refusal_cfg(ja([js("a/SKILL.md V1"), js("b/SKILL.md V4")])), m)
      && refuses_with(refusal_cfg(jo([kv("message", js("a/SKILL.md V1"))])), m)
  }

-- A4, case 3. The key absent: accepted, config unchanged. Absent means absent
-- at the TOP LEVEL of an object -- a near-miss key, the key nested one level
-- down, the key's name as a VALUE, and a config that is no object at all are
-- each no refusal.
pure func test_refusal_absent_key_is_accepted() -> bool
  tests [((), true)]
  {
    accepts_unchanged(jo([kv("model", js("m"))]))
      && accepts_unchanged(jo([kv("registration_refused", js("x")), kv("refusal", js("x"))]))
      && accepts_unchanged(jo([kv("inner", jo([kv("registration_refusal", js("x"))]))]))
      && accepts_unchanged(jo([kv("note", js("registration_refusal"))]))
      && accepts_unchanged(ja([js("registration_refusal")]))
      && accepts_unchanged(JNull)
  }

-- A4, case 4. The empty string is no refusal, and the entry still carries the
-- key: the host reads `config`, it does not edit it.
pure func test_refusal_empty_string_is_accepted() -> bool
  tests [((), true)]
  {
    accepts_unchanged(refusal_cfg(js("")))
  }

-- A4, case 5. An ordinary registration -- the empty config every in-tree
-- fixture above uses -- is accepted exactly as before.
pure func test_refusal_ordinary_registration_is_accepted() -> bool
  tests [((), true)]
  {
    accepts_unchanged(no_cfg())
  }

-- D2's ORDER. The refusal is read before the walk and before the D7 empty-list
-- test: a refusing registration is rejected AS a refusal on a list that trips a
-- multiplicity rule (the control: the same list without the key is
-- `SecondVote`) and on an EMPTY list, which D7 would otherwise omit by name.
pure func test_refusal_is_read_before_the_multiplicity_walk() -> bool
  tests [((), true)]
  {
    let said = "refused";
    let twice = [ToolPolicy(p_policy), ToolPolicy(p_policy)];
    let control = match normalize_registration("ord", no_cfg(), twice) {
      Err(SecondVote(_, _, p)) => p == 1,
      _ => false
    };
    let before_walk = match normalize_registration("ord", refusal_cfg(js(said)), twice) {
      Err(RegistrationRefused(e, m)) => e == "ord" && m == said,
      _ => false
    };
    let before_empty = match normalize_registration("ord", refusal_cfg(js(said)), []) {
      Err(RegistrationRefused(e, m)) => e == "ord" && m == said,
      _ => false
    };
    control && before_walk && before_empty
  }

-- The whole build: one refusing extension rejects it, like any other rejection
-- (FAIL-CLOSED SHAPE above) -- including one whose list is empty, which must
-- not be turned into a NAMED OMISSION and a host that starts.
pure func test_refusal_rejects_the_whole_build() -> bool
  tests [((), true)]
  {
    let good: ExtEntry = { id: "good", config: no_cfg(), caps: [ToolPolicy(p_policy)] };
    let refusing: ExtEntry = { id: "skills", config: refusal_cfg(js("refused")), caps: refusal_caps() };
    let refusing_empty: ExtEntry = { id: "skills", config: refusal_cfg(js("refused")), caps: [] };
    let whole = match normalize_registry([good, refusing]) {
      Err(RegistrationRefused(e, m)) => e == "skills" && m == "refused",
      _ => false
    };
    let not_omitted = match normalize_registry([good, refusing_empty]) {
      Err(RegistrationRefused(e, m)) => e == "skills" && m == "refused",
      _ => false
    };
    whole && not_omitted
  }

-- The reader itself, including the one reading the table does not show: a key
-- repeated in one object is read as its FIRST occurrence.
pure func reads_as(config: Json, expected: string) -> bool {
  match read_registration_refusal(config) {
    Some(m) => m == expected,
    None => expected == ""
  }
}

pure func test_refusal_reader_reads_one_top_level_key() -> bool
  tests [((), true)]
  {
    reads_as(no_cfg(), "")
      && reads_as(refusal_cfg(js("")), "")
      && reads_as(refusal_cfg(js("x")), "x")
      && reads_as(refusal_cfg(JNull), malformed_registration_refusal())
      && reads_as(jo([kv("registration_refusal", js("")), kv("registration_refusal", js("x"))]), "")
      && reads_as(jo([kv("registration_refusal", js("x")), kv("registration_refusal", js(""))]), "x")
  }

-- ----------------------------------------------------------------------------
-- The config digest. Each data position has its own test so that a projection
-- dropping ONE of them is caught by name (the mutgate rows under
-- evidence/P1.1 mutate `capability_data` one position at a time).
-- ----------------------------------------------------------------------------

pure func digest_of(config: Json, caps: [Capability]) -> string {
  ext_config_digest({ id: "d#0", config: config, caps: caps })
}

pure func data_caps(tools: [string], label: string, enabled: bool, work: string) -> [Capability] {
  [ToolProvider(tools, p_handle), ExitIntent(label, enabled, p_exit), WorkInFlight(work, p_work)]
}

pure func test_config_digest_covers_config() -> bool
  tests [((), true)]
  {
    let caps = [PromptShaper(p_shape), ToolPolicy(p_policy)];
    let a = digest_of(jo([kv("k", js("a"))]), caps);
    let b = digest_of(jo([kv("k", js("b"))]), caps);
    let a2 = digest_of(jo([kv("k", js("a"))]), caps);
    a != b && a == a2
  }

pure func test_config_digest_sees_tool_provider_names() -> bool
  tests [((), true)]
  {
    digest_of(no_cfg(), data_caps(["A"], "l", true, "w")) != digest_of(no_cfg(), data_caps(["B"], "l", true, "w"))
      && digest_of(no_cfg(), data_caps(["A", "B"], "l", true, "w")) != digest_of(no_cfg(), data_caps(["B", "A"], "l", true, "w"))
  }

pure func test_config_digest_sees_exit_intent_label() -> bool
  tests [((), true)]
  {
    digest_of(no_cfg(), data_caps(["A"], "panes", true, "w")) != digest_of(no_cfg(), data_caps(["A"], "run-file", true, "w"))
  }

pure func test_config_digest_sees_exit_intent_enabled() -> bool
  tests [((), true)]
  {
    digest_of(no_cfg(), data_caps(["A"], "l", true, "w")) != digest_of(no_cfg(), data_caps(["A"], "l", false, "w"))
  }

pure func test_config_digest_sees_work_in_flight_label() -> bool
  tests [((), true)]
  {
    digest_of(no_cfg(), data_caps(["A"], "l", true, "delegate")) != digest_of(no_cfg(), data_caps(["A"], "l", true, "review"))
  }

-- Equal data, different callback bodies: the same digest. Equal configuration
-- in a different key order, at two depths: the same digest. A kind that carries
-- no data still occupies its position.
pure func p_shape2(_ctx: PureCtx) -> PromptPatch { { prepend: ["other body"], append: [] } }

pure func test_config_digest_ignores_callbacks_and_is_canonical() -> bool
  tests [((), true)]
  {
    let bodies = digest_of(no_cfg(), [PromptShaper(p_shape)]) == digest_of(no_cfg(), [PromptShaper(p_shape2)]);
    let ordered = jo([kv("a", jo([kv("y", js("1")), kv("x", js("2"))])), kv("b", ja([js("q")]))]);
    let shuffled = jo([kv("b", ja([js("q")])), kv("a", jo([kv("x", js("2")), kv("y", js("1"))]))]);
    let keys = digest_of(ordered, []) == digest_of(shuffled, []);
    let canon = canonical_json(shuffled) == "{\"a\":{\"x\":\"2\",\"y\":\"1\"},\"b\":[\"q\"]}";
    let positions = digest_of(no_cfg(), [PromptShaper(p_shape), ToolProvider(["A"], p_handle)]) != digest_of(no_cfg(), [ToolProvider(["A"], p_handle), PromptShaper(p_shape)]);
    bodies && keys && canon && positions
  }
