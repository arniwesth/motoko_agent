func resolve(name: string, cfg: RuntimeConfig) -> Option[[Capability]] ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  if name == "test_dummy" then Some(register_test_dummy(cfg))
  else if name == "omnigraph" then Some(register_omnigraph(cfg))
  else if name == "context_mode" then Some(register_context_mode(cfg))
  else if name == "mcp" then Some(register_mcp(cfg))
  else if name == "exa_search" then Some(register_exa_search(cfg))
  else if name == "ailang_docs" then Some(register_ailang_docs(cfg))
  else if name == "compose" then Some(register_compose(cfg))
  else if name == "a2a" then Some(register_a2a(cfg))
  else if name == "decision_framework" then Some(register_decision_framework(cfg))
  else if name == "microrag" then Some(register_microrag(cfg))
  else if name == "compaction_ai" then Some(register_compaction_ai(cfg))
  else if name == "scratchpad" then Some(register_scratchpad(cfg))
  else if name == "compaction_structural" then Some(register_compaction_structural(cfg))
  else if name == "empty_stop_guard" then Some(register_empty_stop_guard(cfg))
  else if name == "progress_contract_guard" then Some(register_progress_contract_guard(cfg))
  else if name == "agentcli" then Some(register_agentcli(cfg))
  else if name == "herdr" then Some(register_herdr(cfg))
  else None
}

-- B8: the registration boundary. Every resolved list goes through
-- `normalize_registration` (D3 votes, D3 disjoint provider names, D4 fold
-- repeats, D7 empty). A rejection FAILS THE BUILD -- printed and exit 2 --
-- because silently omitting a mis-registered extension while the others load
-- is the fail-open shape [AR-codex "Missed"]. An EMPTY registration is
-- omitted by name (D7, recommended reading), never silently.
func parse_tokens(xs: [string], idx: int, acc: [ExtEntry], cfg: RuntimeConfig) -> ExtRegistry ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  match xs {
    [] => { entries: acc },
    raw :: rest => {
      let name = trim(raw);
      match resolve(name, cfg) {
        None => parse_tokens(rest, idx + 1, acc, cfg),
        Some(caps) => {
          let id = "${name}#${show(idx)}";
          match normalize_registration(id, caps) {
            Err(e) => {
              let _ = println("extension registry rejected: ${rejection_message(e)}");
              let _ = exit(2);
              { entries: acc }
            },
            Ok(entry) =>
              if List.length(entry.caps) == 0 then {
                let _ = println("extension '${id}' registers no capability atom; omitted from the registry (D7)");
                parse_tokens(rest, idx + 1, acc, cfg)
              } else parse_tokens(rest, idx + 1, acc ++ [entry], cfg)
          }
        }
      }
    }
  }
}

export func parse_core_ext_order(raw: string, cfg: RuntimeConfig) -> ExtRegistry ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  if trim(raw) == "" then { entries: [] }
  else parse_tokens(split(raw, ","), 0, [], cfg)
}
