module src/core/ext/runtime

import std/clock (now)
import std/io (println)
import std/json (Json, encode, jo, kv, js, jnum)
import std/option (Option, Some, None)
import std/result (Ok, Err)
import std/string (startsWith)
import src/core/tool_contract (ToolCallEnvelope)
import src/core/config (RuntimeConfig, VerificationConfig)
import pkg/sunholo/motoko_ext_abi/types (
  BudgetPlan,
  ExtCtx,
  PromptPatch,
  BudgetPatch,
  PolicyDefault,
  ToolPolicyDecision,
  ToolHandleDecision,
  ResponseInterceptDecision,
  FinalizeDecision,
  PreStepDecision,
  ExtensionHooks,
  ExtRuntime
)
import src/core/types (Msg)
import src/core/ext/registry_generated (parse_core_ext_order)
import src/core/phase_vocab (validate_compactor_output)
import src/core/ext/ctx_defaults (noop_ext_ports, empty_ext_artifacts, zero_token_telemetry)

export type StageOutcome = StageApplied(string) | StageRejected(string) | StagePassed
export type PreStepStage = { ext_id: string, outcome: StageOutcome }
export type PreStepChainResult = { msgs: [Msg], stages: [PreStepStage], artifacts: Json }

export func init_runtime_with_config(cfg: RuntimeConfig) -> ExtRuntime ! {Env, FS, Net} {
  {
    registry: parse_core_ext_order(join_order(cfg.extensions.order), cfg),
    strict_mode: cfg.extensions.strict,
    verification: cfg.verification
  }
}

export func init_runtime() -> ExtRuntime ! {Env, FS} {
  let v: VerificationConfig = { enabled: false, command: "make check_core" };
  { registry: { hooks: [] }, strict_mode: false, verification: v }
}

func join_order(xs: [string]) -> string {
  match xs {
    [] => "",
    x :: [] => x,
    x :: rest => "${x},${join_order(rest)}"
  }
}

func hook_names(hooks: [ExtensionHooks]) -> [string] {
  match hooks {
    [] => [],
    h :: rest => hook_name(h.id) :: hook_names(rest)
  }
}

func hash_index(id: string) -> int {
  _str_find(id, "#")
}

func hook_name(id: string) -> string {
  let i = hash_index(id);
  if i < 0 then id else _str_slice(id, 0, i)
}

export func loaded_extension_names(rt: ExtRuntime) -> [string] {
  hook_names(rt.registry.hooks)
}

func join_lines(xs: [string]) -> string {
  match xs {
    [] => "",
    x :: [] => x,
    x :: rest => "${x}\n${join_lines(rest)}"
  }
}

func apply_prompt_patch(base: string, patch: PromptPatch) -> string {
  let prefix = join_lines(patch.prepend);
  let suffix = join_lines(patch.append);
  let with_prefix = if prefix == "" then base else "${prefix}\n${base}";
  if suffix == "" then with_prefix else "${with_prefix}\n${suffix}"
}

func with_int_opt(current: int, requested: Option[int]) -> int {
  match requested {
    None => current,
    Some(n) => n
  }
}

func apply_budget_patch(plan: BudgetPlan, patch: BudgetPatch) -> BudgetPlan {
  {
    total: with_int_opt(plan.total, patch.requested_total),
    solver: with_int_opt(plan.solver, patch.requested_solver),
    verifier: with_int_opt(plan.verifier, patch.requested_verifier)
  }
}

func emit_dummy_hook(hook: string, key: string, val: string) -> () ! {IO, Clock} {
  let _ = println(encode(jo([
    kv("type", js("dummy_hook")),
    kv("ts", jnum(intToFloat(now()))),
    kv("hook", js(hook)),
    kv(key, js(val))
  ])));
  ()
}

func is_test_dummy(hook_id: string) -> bool {
  hook_id == "test_dummy" || startsWith(hook_id, "test_dummy#")
}

func fold_prompt_hooks(hooks: [ExtensionHooks], ctx: ExtCtx, base: string) -> string ! {IO, Clock} {
  match hooks {
    [] => base,
    h :: rest => {
      let patch = (h.on_build_system_prompt)(ctx);
      let _ = if is_test_dummy(h.id) then emit_dummy_hook("on_build_system_prompt", "appended", join_lines(patch.append)) else ();
      fold_prompt_hooks(rest, ctx, apply_prompt_patch(base, patch))
    }
  }
}

export func dispatch_build_system_prompt(rt: ExtRuntime, ctx: ExtCtx, base: string) -> string ! {IO, Clock} {
  fold_prompt_hooks(rt.registry.hooks, ctx, base)
}

func fold_budget_hooks(hooks: [ExtensionHooks], ctx: ExtCtx, plan: BudgetPlan) -> BudgetPlan ! {IO, Clock, Env, FS} {
  match hooks {
    [] => plan,
    h :: rest => {
      let patch = (h.on_budget_plan)(ctx, plan);
      let val = match patch.requested_total { None => "", Some(n) => show(n) };
      let _ = if is_test_dummy(h.id) then emit_dummy_hook("on_budget_plan", "requested_total", val) else ();
      fold_budget_hooks(rest, ctx, apply_budget_patch(plan, patch))
    }
  }
}

export func dispatch_budget_plan(rt: ExtRuntime, ctx: ExtCtx, plan: BudgetPlan) -> BudgetPlan ! {IO, Clock, Env, FS} {
  fold_budget_hooks(rt.registry.hooks, ctx, plan)
}

-- Fold compaction hooks in registry order. Each stage receives the previous
-- valid stage's messages; invalid output is recorded and skipped.
func fold_pre_step_chain_rec(hooks: [ExtensionHooks], ctx: ExtCtx, msgs: [Msg], artifacts: Json) -> PreStepChainResult ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  match hooks {
    [] => { msgs: msgs, stages: [], artifacts: artifacts },
    h :: rest => {
      let decision = (h.on_pre_step)(ctx, msgs);
      let _ = if is_test_dummy(h.id) then {
        let tag = match decision {
          PassThrough => "passthrough",
          Compacted(_, note, _) => "compacted:${note}"
        };
        emit_dummy_hook("on_pre_step", "decision", tag)
      } else ();
      match decision {
        PassThrough => {
          let next = fold_pre_step_chain_rec(rest, ctx, msgs, artifacts);
          { msgs: next.msgs, stages: { ext_id: h.id, outcome: StagePassed } :: next.stages, artifacts: next.artifacts }
        },
        Compacted(compacted_msgs, note, next_artifacts) => {
          match validate_compactor_output(msgs, compacted_msgs) {
            Ok(_) => {
              let next = fold_pre_step_chain_rec(rest, ctx, compacted_msgs, next_artifacts);
              { msgs: next.msgs, stages: { ext_id: h.id, outcome: StageApplied(note) } :: next.stages, artifacts: next.artifacts }
            },
            Err(reason) => {
              let next = fold_pre_step_chain_rec(rest, ctx, msgs, artifacts);
              { msgs: next.msgs, stages: { ext_id: h.id, outcome: StageRejected(reason) } :: next.stages, artifacts: next.artifacts }
            }
          }
        }
      }
    }
  }
}

export func dispatch_pre_step_chain(rt: ExtRuntime, ctx: ExtCtx, msgs: [Msg]) -> PreStepChainResult ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  fold_pre_step_chain_rec(rt.registry.hooks, ctx, msgs, ctx.artifacts)
}

func decide_one_policy(h: ExtensionHooks, ctx: ExtCtx, call: ToolCallEnvelope) -> ToolPolicyDecision ! {IO, Clock} {
  let decision = (h.on_tool_policy)(ctx, call);
  let _ = if is_test_dummy(h.id) then {
    let tag = match decision {
      Allow => "allow",
      Deny(_) => "deny",
      NoOpinion => "noop",
      Pending(_, _) => "pending"
    };
    emit_dummy_hook("on_tool_policy", "decision", tag)
  } else ();
  decision
}

-- Priority order: Deny > Pending > Allow > NoOpinion.
-- Deny short-circuits immediately; Pending is recorded and returned unless
-- a Deny is seen; Allow sets seen_allow; NoOpinion is neutral.
func merge_tool_decisions(xs: [ToolPolicyDecision], seen_allow: bool, seen_pending: Option[ToolPolicyDecision]) -> ToolPolicyDecision {
  match xs {
    [] => match seen_pending {
      Some(p) => p,
      None => if seen_allow then Allow else NoOpinion
    },
    x :: rest =>
      match x {
        Deny(msg) => Deny(msg),
        Allow => merge_tool_decisions(rest, true, seen_pending),
        NoOpinion => merge_tool_decisions(rest, seen_allow, seen_pending),
        Pending(reason, default) => merge_tool_decisions(rest, seen_allow, Some(Pending(reason, default)))
      }
  }
}

func collect_tool_decisions(hooks: [ExtensionHooks], ctx: ExtCtx, call: ToolCallEnvelope) -> [ToolPolicyDecision] ! {IO, Clock} {
  match hooks {
    [] => [],
    h :: rest => decide_one_policy(h, ctx, call) :: collect_tool_decisions(rest, ctx, call)
  }
}

export func dispatch_tool_policy(rt: ExtRuntime, ctx: ExtCtx, call: ToolCallEnvelope) -> ToolPolicyDecision ! {IO, Clock} {
  merge_tool_decisions(collect_tool_decisions(rt.registry.hooks, ctx, call), false, None)
}

func tool_name(call: ToolCallEnvelope) -> string {
  call.tool
}

func contains_tool(xs: [string], name: string) -> bool {
  match xs {
    [] => false,
    x :: rest => if x == name then true else contains_tool(rest, name)
  }
}

func first_handle(hooks: [ExtensionHooks], ctx: ExtCtx, call: ToolCallEnvelope, name: string) -> ToolHandleDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  match hooks {
    [] => Delegate,
    h :: rest => {
      if contains_tool(h.provided_tools, name) then {
        match (h.on_tool_handle)(ctx, call) {
          Delegate => first_handle(rest, ctx, call, name),
          Handled(r) => Handled(r)
        }
      } else first_handle(rest, ctx, call, name)
    }
  }
}

export func dispatch_tool_handle(rt: ExtRuntime, ctx: ExtCtx, call: ToolCallEnvelope) -> ToolHandleDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  first_handle(rt.registry.hooks, ctx, call, tool_name(call))
}

func first_intercept(hooks: [ExtensionHooks], ctx: ExtCtx, response_text: string) -> ResponseInterceptDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  match hooks {
    [] => NoIntercept,
    h :: rest =>
      match (h.on_response_intercept)(ctx, response_text) {
        InterceptHandled(r) => InterceptHandled(r),
        NoIntercept => first_intercept(rest, ctx, response_text)
      }
  }
}

export func dispatch_response_intercept(rt: ExtRuntime, ctx: ExtCtx, response_text: string) -> ResponseInterceptDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  first_intercept(rt.registry.hooks, ctx, response_text)
}

func decide_one_finalize(h: ExtensionHooks, ctx: ExtCtx, candidate: string) -> FinalizeDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  let decision = (h.on_solver_candidate)(ctx, candidate);
  let _ = if is_test_dummy(h.id) then {
    let tag = match decision {
      Accept(_) => "accept",
      ContinueWithFeedback(_) => "continue",
      NoDecision => "noop"
    };
    emit_dummy_hook("on_solver_candidate", "decision", tag)
  } else ();
  decision
}

func collect_finalize_decisions(hooks: [ExtensionHooks], ctx: ExtCtx, candidate: string) -> [FinalizeDecision] ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  match hooks {
    [] => [],
    h :: rest => decide_one_finalize(h, ctx, candidate) :: collect_finalize_decisions(rest, ctx, candidate)
  }
}

func first_accept(xs: [FinalizeDecision]) -> Option[string] {
  match xs {
    [] => None,
    Accept(out) :: _ => Some(out),
    _ :: rest => first_accept(rest)
  }
}

func first_continue(xs: [FinalizeDecision]) -> Option[string] {
  match xs {
    [] => None,
    ContinueWithFeedback(msg) :: _ => Some(msg),
    _ :: rest => first_continue(rest)
  }
}

export func merge_finalize_decisions(xs: [FinalizeDecision]) -> FinalizeDecision {
  match first_continue(xs) {
    Some(msg) => ContinueWithFeedback(msg),
    None =>
      match first_accept(xs) {
        Some(out) => Accept(out),
        None => NoDecision
      }
  }
}

export func dispatch_solver_candidate(rt: ExtRuntime, ctx: ExtCtx, candidate: string) -> FinalizeDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  merge_finalize_decisions(collect_finalize_decisions(rt.registry.hooks, ctx, candidate))
}

func smoke_ctx() -> ExtCtx {
  {
    task: "t",
    step: 0,
    model: "m",
    context_limit: 0,
    cwd: ".",
    hybrid_tools: true,
    budget: { total: 10, solver: 6, verifier: 4 },
    mode: "default",
    workdir: ".",
    env_server_url: "",
    budget_remaining: 10,
    history_slice: [],
	    state_key: "k",
	    context_limit: 0,
	    ports: noop_ext_ports(),
	    artifacts: empty_ext_artifacts(),
	    telemetry: zero_token_telemetry()
	  }
	}

func smoke_hook_a() -> ExtensionHooks {
  let handle = func(_ctx: ExtCtx, call: ToolCallEnvelope) -> ToolHandleDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
    if call.tool == "Alpha" then Handled({ tool_call_id: call.id, tool: "Alpha", exit_code: 0, stdout: "alpha", stderr: "", metadata: jo([]) })
    else Delegate
  };
  let intercept = func(_ctx: ExtCtx, response_text: string) -> ResponseInterceptDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
    if response_text == "trip" then InterceptHandled({ tool_call_id: "ri", tool: "Intercept", exit_code: 0, stdout: "ok", stderr: "", metadata: jo([]) })
    else NoIntercept
  };
  let finalize = func(_ctx: ExtCtx, _candidate: string) -> FinalizeDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
    ContinueWithFeedback("needs-fix")
  };
  let budget = func(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch ! {Env, FS} {
    { requested_total: Some(9), requested_solver: None, requested_verifier: None }
  };
  {
    id: "hook_a",
    provided_tools: ["Alpha"],
    on_describe_tools: \_ . [],
    on_build_system_prompt: \_ctx. { prepend: [], append: ["A"] },
    on_budget_plan: budget,
    on_pre_step: \_ctx _msgs. PassThrough ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream},
    on_tool_policy: \_ctx _call. Allow,
    on_tool_handle: handle,
    on_response_intercept: intercept,
    on_solver_candidate: finalize
  }
}

func smoke_hook_b() -> ExtensionHooks {
  let handle = func(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
    Delegate
  };
  let intercept = func(_ctx: ExtCtx, _response_text: string) -> ResponseInterceptDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
    NoIntercept
  };
  let finalize = func(_ctx: ExtCtx, _candidate: string) -> FinalizeDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
    Accept("accepted")
  };
  let budget = func(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch ! {Env, FS} {
    { requested_total: None, requested_solver: Some(5), requested_verifier: None }
  };
  {
    id: "hook_b",
    provided_tools: ["Beta"],
    on_describe_tools: \_ . [],
    on_build_system_prompt: \_ctx. { prepend: [], append: ["B"] },
    on_budget_plan: budget,
    on_pre_step: \_ctx _msgs. PassThrough ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream},
    on_tool_policy: \_ctx _call. Deny("blocked"),
    on_tool_handle: handle,
    on_response_intercept: intercept,
    on_solver_candidate: finalize
  }
}

func chain_msg(role: string, content: string) -> Msg {
  { role: role, content: content, tool_calls: [], tool_call_id: "" }
}

func chain_call_msg(id: string) -> Msg {
  { role: "assistant", content: "call", tool_calls: [{ id: id, name: "T", arguments: "{}" }], tool_call_id: "" }
}

func chain_tool_msg(id: string, content: string) -> Msg {
  { role: "tool", content: content, tool_calls: [], tool_call_id: id }
}

func chain_base_hook(id: string, pre: (ExtCtx, [Msg]) -> PreStepDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream}) -> ExtensionHooks {
  {
    id: id,
    provided_tools: [],
    on_describe_tools: \_ . [],
    on_build_system_prompt: \_ctx. { prepend: [], append: [] },
    on_budget_plan: func(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch ! {Env, FS} {
      { requested_total: None, requested_solver: None, requested_verifier: None }
    },
    on_pre_step: pre,
    on_tool_policy: \_ctx _call. NoOpinion,
    on_tool_handle: func(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} { Delegate },
    on_response_intercept: func(_ctx: ExtCtx, _r: string) -> ResponseInterceptDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} { NoIntercept },
    on_solver_candidate: func(_ctx: ExtCtx, _c: string) -> FinalizeDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} { NoDecision }
  }
}

func chain_hook_a() -> ExtensionHooks {
  chain_base_hook("chain_A", func(_ctx: ExtCtx, msgs: [Msg]) -> PreStepDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
    Compacted(msgs ++ [chain_msg("user", "chain-A")], "A", jo([]))
  })
}

func chain_hook_b_bad() -> ExtensionHooks {
  chain_base_hook("chain_B", func(_ctx: ExtCtx, msgs: [Msg]) -> PreStepDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
    Compacted([chain_call_msg("tc-chain")], "B", jo([]))
  })
}

func chain_hook_c() -> ExtensionHooks {
  chain_base_hook("chain_C", func(_ctx: ExtCtx, msgs: [Msg]) -> PreStepDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
    Compacted([chain_call_msg("tc-chain"), chain_tool_msg("tc-chain", "rewritten")] ++ msgs, "C", jo([]))
  })
}

func stages_are_applied_rejected_applied(stages: [PreStepStage]) -> bool {
  match stages {
    a :: b :: c :: [] =>
      a.ext_id == "chain_A"
        && b.ext_id == "chain_B"
        && c.ext_id == "chain_C"
        && match a.outcome {
          StageApplied(note_a) => note_a == "A",
          _ => false
        }
        && match b.outcome {
          StageRejected(reason) => reason != "",
          _ => false
        }
        && match c.outcome {
          StageApplied(note_c) => note_c == "C",
          _ => false
        },
    _ => false
  }
}

func dispatch_pre_step_chain_fold_test() -> bool
  tests [((), true)]
  {
    let vchain: VerificationConfig = { enabled: false, command: "make check_core" };
    let rt = { registry: { hooks: [chain_hook_a(), chain_hook_b_bad(), chain_hook_c()] }, strict_mode: false, verification: vchain };
    let result = dispatch_pre_step_chain(rt, smoke_ctx(), [chain_call_msg("tc-chain"), chain_tool_msg("tc-chain", "original")]);
    match result.msgs {
      call :: tool :: seed_call :: seed_tool :: marker :: [] =>
        call.role == "assistant"
          && tool.role == "tool"
          && tool.content == "rewritten"
          && seed_call.role == "assistant"
          && seed_tool.role == "tool"
          && marker.content == "chain-A"
          && stages_are_applied_rejected_applied(result.stages),
      _ => false
    }
  }

func dispatch_smoke_record_hooks() -> bool
  tests [((), true)]
  {
    let vsmoke: VerificationConfig = { enabled: false, command: "make check_core" };
    let rt = { registry: { hooks: [smoke_hook_a(), smoke_hook_b()] }, strict_mode: false, verification: vsmoke };
    let ctx = smoke_ctx();
    let prompt_ok = dispatch_build_system_prompt(rt, ctx, "BASE") == "BASE\nA\nB";
    let budget = dispatch_budget_plan(rt, ctx, { total: 10, solver: 6, verifier: 4 });
    let budget_ok = budget.total == 9 && budget.solver == 5 && budget.verifier == 4;
    let policy_ok =
      match dispatch_tool_policy(rt, ctx, { id: "p", tool: "ReadFile", arguments: jo([]) }) {
        Deny(msg) => msg == "blocked",
        Allow => false,
        NoOpinion => false,
        Pending(_, _) => false
      };
    let handle_ok =
      match dispatch_tool_handle(rt, ctx, { id: "h", tool: "Alpha", arguments: jo([]) }) {
        Handled(r) => r.exit_code == 0 && r.stdout == "alpha",
        Delegate => false
      };
    let intercept_ok =
      match dispatch_response_intercept(rt, ctx, "trip") {
        InterceptHandled(r) => r.tool_call_id == "ri",
        NoIntercept => false
      };
    let finalize_ok =
      match dispatch_solver_candidate(rt, ctx, "candidate") {
        ContinueWithFeedback(msg) => msg == "needs-fix",
        _ => false
      };
    prompt_ok && budget_ok && policy_ok && handle_ok && intercept_ok && finalize_ok
  }

-- Pending alone → returned as-is (takes priority over NoOpinion).
func merge_pending_alone() -> bool
  tests [((), true)]
  {
    let xs = [Pending("destructive op", DenyAfterTimeout)];
    match merge_tool_decisions(xs, false, None) {
      Pending(reason, _) => reason == "destructive op",
      _ => false
    }
  }

-- Pending + Allow → Pending wins (Pending > Allow).
func merge_pending_over_allow() -> bool
  tests [((), true)]
  {
    let xs = [Allow, Pending("needs approval", AllowAfterTimeout)];
    match merge_tool_decisions(xs, false, None) {
      Pending(_, _) => true,
      _ => false
    }
  }

-- Deny + Pending → Deny short-circuits (Deny > Pending).
func merge_deny_over_pending() -> bool
  tests [((), true)]
  {
    let xs = [Pending("needs approval", DenyAfterTimeout), Deny("blocked")];
    match merge_tool_decisions(xs, false, None) {
      Deny(msg) => msg == "blocked",
      _ => false
    }
  }

-- dispatch_tool_policy returns Pending when an extension hook returns it.
func dispatch_pending_hook() -> bool
  tests [((), true)]
  {
    let pending_hook: ExtensionHooks = {
      id: "pending_hook",
      provided_tools: [],
      on_describe_tools: \_ . [],
      on_build_system_prompt: \_ctx. { prepend: [], append: [] },
      on_budget_plan: func(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch ! {Env, FS} {
        { requested_total: None, requested_solver: None, requested_verifier: None }
      },
      on_pre_step: func(_ctx: ExtCtx, _msgs: [Msg]) -> PreStepDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} { PassThrough },
      on_tool_policy: \_ctx _call. Pending("write outside cwd", DenyAfterTimeout),
      on_tool_handle: func(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} { Delegate },
      on_response_intercept: func(_ctx: ExtCtx, _r: string) -> ResponseInterceptDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} { NoIntercept },
      on_solver_candidate: func(_ctx: ExtCtx, _c: string) -> FinalizeDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} { NoDecision }
    };
    let vpending: VerificationConfig = { enabled: false, command: "make check_core" };
    let rt = { registry: { hooks: [pending_hook] }, strict_mode: false, verification: vpending };
    let ctx = smoke_ctx();
    match dispatch_tool_policy(rt, ctx, { id: "p", tool: "WriteFile", arguments: jo([]) }) {
      Pending(reason, DenyAfterTimeout) => reason == "write outside cwd",
      _ => false
    }
  }
