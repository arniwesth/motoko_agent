-- src/core/tool_dispatch_adapter.ail
-- Bridges upstream AILANG std/ai's `(ToolCall) -> string` dispatch contract
-- (M-AI-TOOL-LOOP, target v0.17.0) to motoko_agent's existing
-- run_native_batch dispatch engine.
--
-- Why an adapter:
--   - Upstream `runTools` expects a callback `dispatch: (ToolCall) -> string`
--     where ToolCall = { id, name, arguments }, arguments is a JSON-encoded
--     string, and the return string is the tool result content fed back to
--     the model on the next turn.
--   - motoko_agent's existing dispatcher `run_native_batch` takes a list of
--     `ToolCallEnvelope { id, tool, arguments: Json }` and returns
--     `[ToolResultItem]` (an ADT with rich per-tool metadata: stdout,
--     stderr, exit_code, file diffs, search matches, etc.).
--   - This module provides the impedance match: ToolCall ↔ ToolCallEnvelope
--     and ToolResultItem → string, so callers can pass `make_dispatch(...)`
--     to upstream `runTools`.
--
-- The dispatcher closes over `workdir` (which `(ToolCall) -> string`
-- doesn't carry) by returning a closure. The closure's effect row is
-- ! {FS, Process} (inherited from run_native_batch); upstream `runTools`
-- propagates that via row polymorphism so the call site infers
-- ! {AI, FS, Process} automatically.
--
-- Companion to the streaming-side compat shim in src/core/ai_compat.ail.

module src/core/tool_dispatch_adapter

import std/ai (ToolCall)
import std/json (Json, decode, encode, jo, ja, kv, js, jnum, jb)
import std/option (Option, Some, None)
import std/result (Ok, Err)
import std/string (contains)
import std/string as Str (length)
import src/core/tool_contract (ToolCallEnvelope)
import src/core/types (ToolResultItem, SearchMatch, ReadFileResult, SearchResult, WriteFileResult, EditFileResult, BashExecResult, RunTestsResult, ToolErrorResult, ToolFault, FaultKind, FaultNotAllowed, FaultNotFound, FaultPermissionDenied, FaultSpawnFailed, FaultDeadline, FaultOutputLimit, FaultSignal, FaultRefused, FaultIoError, EffectsNone, EffectsUnknown)
import src/core/tool_fault (fault_key, fault_kind_key, fault_effects_key, fault_note_key, fault_elapsed_ms_key, fault_bytes_key, fault_signal_key, fault_signal_name_key, fault_kind_name, effects_value, effects_note, effects_note_none, effects_note_unknown, refused_fault, io_error_fault)
import src/core/tool_runtime (run_native_batch, unknown_tool_refusal)
import src/core/phase_vocab (tool_result_message)

-- Convert upstream ToolCall to motoko's ToolCallEnvelope.
-- ToolCall.name → ToolCallEnvelope.tool (rename only)
-- ToolCall.arguments (JSON-encoded string) → ToolCallEnvelope.arguments (decoded Json)
--
-- If the arguments string is malformed JSON, returns an envelope with
-- an empty object as arguments. The downstream dispatcher's argument
-- extraction (`arg_string`, `arg_number`, etc. in tool_runtime) handles
-- missing fields with fallbacks, so an empty Json is a safe degraded
-- state — produces a per-tool "missing arguments" error rather than
-- crashing the entire turn.
export func tool_call_to_envelope(call: ToolCall) -> ToolCallEnvelope {
  let args_json = match decode(call.arguments) {
    Ok(j) => j,
    Err(_) => jo([])  -- malformed args → empty object; tool will report missing fields
  } in
  {
    id: call.id,
    tool: call.name,
    arguments: args_json
  }
}

-- THE PER-VARIANT EXIT-CODE MAPPING, IN ITS ONE HOME (WI-D23). Which
-- `ToolResultItem` variant carries which exit code used to live as seven
-- literals inside `tool_result_item_to_json`; the typed dispatch path below
-- is a SECOND consumer of that mapping — S23's threshold — so it moved here
-- and both consumers read it. Two independent statements of "ToolErrorResult
-- is 1" is how the JSON a model reads and the field a caller branches on
-- drift apart.
--
-- The in-process tools (ReadFile, Search, WriteFile, EditFile) map to 0, not
-- to `ScriptedTool.exit_code`'s -1: this mapping is what the model-facing
-- JSON has asserted since the adapter was written, and it is a statement
-- about the TOOL ("it succeeded"), which a dispatch that returned a typed
-- success variant is entitled to make. -1 is for a PRODUCER that cannot
-- state a code at all; this producer holds the result item and can.
export pure func tool_result_exit_code(item: ToolResultItem) -> int {
  match item {
    ReadFileResult(_) => 0,
    SearchResult(_) => 0,
    WriteFileResult(_) => 0,
    EditFileResult(_) => 0,
    BashExecResult(r) => r.exit_code,
    RunTestsResult(r) => r.exit_code,
    ToolErrorResult(_) => 1
  }
}

-- Convert one motoko ToolResultItem (rich ADT) to a JSON object suitable
-- for feeding back to the model. Captures all fields the model would
-- realistically need to plan its next turn — file content for ReadFile,
-- diffs for WriteFile/EditFile, exit_code + stdout/stderr for shell
-- commands, search matches for Search.
--
-- Every arm's `exit_code` reads `tool_result_exit_code` — see that accessor
-- for why the mapping must not be restated here as literals.
--
-- 034 PLAN-001 W0.3, under ADR-001 D3: a faulted arm renders `fault`
-- IMMEDIATELY AFTER `tool`, ahead of every field whose size is not bounded,
-- `cmd` included. The tool message is cut from the END
-- (`phase_vocab.cap_tool_message_content`, applied by `tool_result_message`),
-- so only a field ahead of `fault` can push it out of what the model reads; a
-- long `cmd` ahead of it would. `BashExecResult` and `RunTestsResult` render it
-- when it is `Some`; `ToolErrorResult` always does. With `fault = None` an arm's
-- JSON is byte-identical to its rendering before W0 (D1: a process that ran to
-- its own exit, any exit code, carries no disclosure).
--
-- The result is a Json object; caller encode()s to string for the
-- upstream `(ToolCall) -> string` contract.
export func tool_result_item_to_json(item: ToolResultItem) -> Json {
  match item {
    ReadFileResult(r) => jo([
      kv("tool", js("ReadFile")),
      kv("path", js(r.path)),
      kv("content", js(r.content)),
      kv("line_count", jnum(_int_to_float(r.line_count))),
      kv("truncated", jb(r.truncated)),
      kv("sha256", js(r.sha256)),
      kv("exit_code", jnum(_int_to_float(tool_result_exit_code(item))))
    ]),

    SearchResult(r) => jo([
      kv("tool", js("Search")),
      kv("pattern", js(r.pattern)),
      kv("matches", ja(search_matches_to_json(r.matches))),
      kv("exit_code", jnum(_int_to_float(tool_result_exit_code(item))))
    ]),

    WriteFileResult(r) => jo([
      kv("tool", js("WriteFile")),
      kv("path", js(r.path)),
      kv("bytes_written", jnum(_int_to_float(r.bytes_written))),
      kv("sha256", js(r.sha256)),
      kv("diff", js(r.diff)),
      kv("exit_code", jnum(_int_to_float(tool_result_exit_code(item))))
    ]),

    EditFileResult(r) => jo([
      kv("tool", js("EditFile")),
      kv("path", js(r.path)),
      kv("bytes_written", jnum(_int_to_float(r.bytes_written))),
      kv("sha256", js(r.sha256)),
      kv("diff", js(r.diff)),
      kv("first_changed_line", jnum(_int_to_float(r.first_changed_line))),
      kv("applied_edits", jnum(_int_to_float(r.applied_edits))),
      kv("dry_run", jb(r.dry_run)),
      kv("match_strategy", js(r.match_strategy)),
      kv("exit_code", jnum(_int_to_float(tool_result_exit_code(item))))
    ]),

    BashExecResult(r) => jo(
      [kv("tool", js("BashExec"))]
      ++ fault_field(r.fault)
      ++ [
        kv("cmd", js(r.cmd)),
        kv("exit_code", jnum(_int_to_float(tool_result_exit_code(item)))),
        kv("stdout", js(r.stdout)),
        kv("stderr", js(r.stderr)),
        kv("truncated", jb(r.meta.truncated))
      ]),

    RunTestsResult(r) => jo(
      [kv("tool", js("RunTests"))]
      ++ fault_field(r.fault)
      ++ [
        kv("exit_code", jnum(_int_to_float(tool_result_exit_code(item)))),
        kv("stdout", js(r.stdout)),
        kv("stderr", js(r.stderr)),
        kv("truncated", jb(r.meta.truncated))
      ]),

    -- `tool` may precede `fault` because it is bounded at every construction
    -- site: a literal, or, on the unknown-tool refusal, `echoed_tool_name`'s
    -- at most 218 characters (#277 review, finding 2).
    ToolErrorResult(r) => jo([
      kv("tool", js(r.tool)),
      kv(fault_key(), fault_to_json(r.fault)),
      kv("error", jb(true)),
      kv("message", js(r.message)),
      kv("exit_code", jnum(_int_to_float(tool_result_exit_code(item))))
    ])
  }
}

-- The `fault` object (PLAN-001 C3): `kind`, `effects`, the kind's extra
-- fields, then `note`. Every key, value, kind name and sentence is read from
-- `src/core/tool_fault`, the one home every renderer imports. The match over
-- the kind has no wildcard, so a kind W1 adds is a compile error here until
-- its extra fields are stated.
export func fault_to_json(f: ToolFault) -> Json {
  jo(
    [
      kv(fault_kind_key(), js(fault_kind_name(f.kind))),
      kv(fault_effects_key(), js(effects_value(f.effects)))
    ]
    ++ fault_extra_fields(f.kind)
    ++ [kv(fault_note_key(), js(effects_note(f.effects)))])
}

func fault_extra_fields(k: FaultKind) -> [{ key: string, value: Json }] {
  match k {
    FaultNotAllowed => [],
    FaultNotFound => [],
    FaultPermissionDenied => [],
    FaultSpawnFailed => [],
    FaultDeadline(ms) => [kv(fault_elapsed_ms_key(), jnum(_int_to_float(ms)))],
    FaultOutputLimit(n) => [kv(fault_bytes_key(), jnum(_int_to_float(n)))],
    FaultSignal(sig, name) => [
      kv(fault_signal_key(), jnum(_int_to_float(sig))),
      kv(fault_signal_name_key(), js(name))
    ],
    FaultRefused => [],
    FaultIoError => []
  }
}

-- The optional `fault` entry of `BashExecResult` and `RunTestsResult`: none
-- at all on the `Ok` arm, so that arm's JSON is unchanged.
func fault_field(fault: Option[ToolFault]) -> [{ key: string, value: Json }] {
  match fault {
    Some(f) => [kv(fault_key(), fault_to_json(f))],
    None => []
  }
}

-- Convert SearchMatch list element-by-element. Inline recursion because
-- AILANG's std/list.map currently goes via row polymorphism that the
-- type-checker doesn't always pin tightly enough for ADT-element lists;
-- explicit recursion is robust and 5 LOC.
func search_matches_to_json(matches: [SearchMatch]) -> [Json] {
  match matches {
    [] => [],
    m :: rest => match_to_json(m) :: search_matches_to_json(rest)
  }
}

func match_to_json(m: SearchMatch) -> Json {
  jo([
    kv("path", js(m.path)),
    kv("line_number", jnum(_int_to_float(m.line_number))),
    kv("line_text", js(m.line_text))
  ])
}

-- WI-D23: THE TYPED SIBLING WI-D21 PRICED AS LINK 4. `dispatch_one`'s
-- `(workdir, ToolCall) -> string` contract exists to satisfy upstream
-- `runTools` and does not move; what its callers lacked was the exit code
-- the body already held — `run_native_batch` returns the typed
-- `ToolResultItem`, and the string was always its JSON rendering. This
-- sibling returns both halves, and `dispatch_one` below is a PROJECTION of
-- it, so the two cannot disagree: one dispatch, one rendering, one
-- exit-code mapping (`tool_result_exit_code` above).
--
-- Behaviour:
--   1. Convert ToolCall → ToolCallEnvelope (name → tool, decode arguments)
--   2. Run [envelope] through run_native_batch with the bound workdir
--   3. content   = the single ToolResultItem → JSON object → encoded string
--      exit_code = the same item through the one per-variant mapping
--
-- The "unexpected dispatcher result count" branch is defensive — given
-- a single-element input, run_native_batch always returns a single-element
-- output, but the type system doesn't enforce that. The branch keeps the
-- callback total: no exceptions, no nil returns. Its exit_code is 1, not 0
-- and not -1: it is an ERROR surface (the dispatcher broke its
-- single-result contract), and 1 is what the one mapping assigns an error.
-- 0 would assert a success no process produced; -1 would file an adapter
-- defect under "no subprocess ran".
--
-- 034 PLAN-001 W0.3: the branch also carries `fault`, kind `io_error` and
-- effects `unknown`. It is reached AFTER a dispatch, so nothing says the
-- tool's effect was not entered. It has no `tool` key, so `fault` leads.
export func dispatch_one_typed(workdir: string, call: ToolCall) -> { content: string, exit_code: int } ! {FS, Process} {
  let envelope = tool_call_to_envelope(call) in
  typed_dispatch_result(run_native_batch([envelope], workdir))
}

-- The pure half of `dispatch_one_typed`: the dispatcher's results for one
-- call, rendered. A function of its own so the defensive branch, which no
-- real dispatch reaches, is reachable from a test.
func typed_dispatch_result(results: [ToolResultItem]) -> { content: string, exit_code: int } {
  match results {
    [r] => { content: encode(tool_result_item_to_json(r)), exit_code: tool_result_exit_code(r) },
    _ => { content: encode(jo([
             kv(fault_key(), fault_to_json(io_error_fault(EffectsUnknown))),
             kv("error", jb(true)),
             kv("message", js("internal: dispatcher returned 0 or >1 results for single call"))
           ])),
           exit_code: 1 }
  }
}

-- The (almost) drop-in adapter that satisfies upstream `runTools`'s
-- `dispatch: (ToolCall) -> string` contract. It takes `workdir` as a
-- leading parameter; the call site partial-applies it via a one-line
-- lambda:
--
--   match runTools(model, msgs, tools, \call. dispatch_one(workdir, call), 8) { ... }
--
-- The lambda's effect row is inferred from the body's effects ({FS,
-- Process}, inherited from run_native_batch). Upstream runTools
-- propagates them via row polymorphism so the call-site effect row
-- becomes ! {AI, FS, Process} automatically.
--
-- WI-D23 made this a projection of `dispatch_one_typed` — the body IS the
-- sibling's content half, so a divergence between the string a model reads
-- and the code a typed caller branches on is not expressible from here.
export func dispatch_one(workdir: string, call: ToolCall) -> string ! {FS, Process} {
  dispatch_one_typed(workdir, call).content
}

-- ============================================================================
-- 034 PLAN-001 W0.3 tests. Each asserts the encoded string, so key order is
-- asserted with the values. They are `((), true)` functions for the reason
-- `tool_fault`'s are: on v0.52.5 a `tests [...]` row's input is evaluated
-- without the module's imports.
-- ============================================================================

pure func t_meta() -> { truncated: bool, stdout_bytes: int, stdout_total_bytes: int, stderr_bytes: int, stderr_total_bytes: int, stdout_sha256: string, stderr_sha256: string } {
  { truncated: false, stdout_bytes: 0, stdout_total_bytes: 0, stderr_bytes: 0, stderr_total_bytes: 0, stdout_sha256: "", stderr_sha256: "" }
}

func t_bash(fault: Option[ToolFault], cmd: string, stdout: string, stderr: string, exit_code: int) -> ToolResultItem {
  BashExecResult({ id: "call-1", fault: fault, cmd: cmd, stdout: stdout, stderr: stderr, exit_code: exit_code, meta: t_meta() })
}

func t_render(item: ToolResultItem) -> string {
  encode(tool_result_item_to_json(item))
}

-- The two sentences, verbatim, through the renderer. A wording change in the
-- one home is a change to these two tests.
func t_note_none_verbatim() -> bool
  tests [((), true)]
  {
    encode(fault_to_json(refused_fault()))
      == "{\"kind\":\"refused\",\"effects\":\"none\",\"note\":\"No change was made: the tool failed before it could write or change anything.\"}"
  }

func t_note_unknown_verbatim() -> bool
  tests [((), true)]
  {
    encode(fault_to_json(io_error_fault(EffectsUnknown)))
      == "{\"kind\":\"io_error\",\"effects\":\"unknown\",\"note\":\"The harness cannot confirm whether this tool's effects happened. They may have happened in full, not at all, or may still be happening. Check the current state before running it again.\"}"
  }

-- A faulted BashExecResult: `fault` straight after `tool`, before `cmd`.
func t_bash_faulted_key_order() -> bool
  tests [((), true)]
  {
    let f = { kind: FaultOutputLimit(1000), effects: EffectsUnknown };
    t_render(t_bash(Some(f), "make build", "", "output limit exceeded: 1000 bytes", 1))
      == "{\"tool\":\"BashExec\",\"fault\":{\"kind\":\"output_limit\",\"effects\":\"unknown\",\"bytes\":1000,\"note\":\"${effects_note_unknown()}\"},\"cmd\":\"make build\",\"exit_code\":1,\"stdout\":\"\",\"stderr\":\"output limit exceeded: 1000 bytes\",\"truncated\":false}"
  }

-- A faulted RunTestsResult, its own arm.
func t_run_tests_faulted_key_order() -> bool
  tests [((), true)]
  {
    let f = { kind: FaultNotFound, effects: EffectsNone };
    let item = RunTestsResult({ id: "call-2", fault: Some(f), cmd: "pytest", stdout: "", stderr: "command not found: pytest", exit_code: 1, passed: 0, failed: 1, failures: [{ test: "test-command", message: "command not found: pytest" }], meta: t_meta() });
    t_render(item)
      == "{\"tool\":\"RunTests\",\"fault\":{\"kind\":\"not_found\",\"effects\":\"none\",\"note\":\"${effects_note_none()}\"},\"exit_code\":1,\"stdout\":\"\",\"stderr\":\"command not found: pytest\",\"truncated\":false}"
  }

-- A ToolErrorResult always renders `fault`.
func t_tool_error_renders_fault() -> bool
  tests [((), true)]
  {
    let item = ToolErrorResult({ id: "call-3", tool: "ReadFile", fault: refused_fault(), message: "missing path" });
    t_render(item)
      == "{\"tool\":\"ReadFile\",\"fault\":{\"kind\":\"refused\",\"effects\":\"none\",\"note\":\"${effects_note_none()}\"},\"error\":true,\"message\":\"missing path\",\"exit_code\":1}"
  }

-- One faulted result per kind with extra fields, asserting those fields.
func t_kind_deadline_fields() -> bool
  tests [((), true)]
  {
    let f = { kind: FaultDeadline(30000), effects: EffectsUnknown };
    t_render(t_bash(Some(f), "sleep 60", "", "timeout after 30000ms", 1))
      == "{\"tool\":\"BashExec\",\"fault\":{\"kind\":\"deadline\",\"effects\":\"unknown\",\"elapsed_ms\":30000,\"note\":\"${effects_note_unknown()}\"},\"cmd\":\"sleep 60\",\"exit_code\":1,\"stdout\":\"\",\"stderr\":\"timeout after 30000ms\",\"truncated\":false}"
  }

func t_kind_output_limit_fields() -> bool
  tests [((), true)]
  {
    let f = { kind: FaultOutputLimit(4096), effects: EffectsUnknown };
    encode(fault_to_json(f))
      == "{\"kind\":\"output_limit\",\"effects\":\"unknown\",\"bytes\":4096,\"note\":\"${effects_note_unknown()}\"}"
  }

func t_kind_signal_fields() -> bool
  tests [((), true)]
  {
    let f = { kind: FaultSignal(9, "SIGKILL"), effects: EffectsUnknown };
    t_render(t_bash(Some(f), "./run.sh", "", "killed by SIGKILL", 1))
      == "{\"tool\":\"BashExec\",\"fault\":{\"kind\":\"signal\",\"effects\":\"unknown\",\"signal\":9,\"signal_name\":\"SIGKILL\",\"note\":\"${effects_note_unknown()}\"},\"cmd\":\"./run.sh\",\"exit_code\":1,\"stdout\":\"\",\"stderr\":\"killed by SIGKILL\",\"truncated\":false}"
  }

-- `Ok` arms, byte-equal to their rendering before W0 (recorded at fc7c0a13
-- by running this renderer before the change). A non-zero exit code is not a
-- fault (D1).
func t_bash_ok_unchanged() -> bool
  tests [((), true)]
  {
    t_render(t_bash(None, "make build", "ok", "", 2))
      == "{\"tool\":\"BashExec\",\"cmd\":\"make build\",\"exit_code\":2,\"stdout\":\"ok\",\"stderr\":\"\",\"truncated\":false}"
  }

func t_run_tests_ok_unchanged() -> bool
  tests [((), true)]
  {
    let item = RunTestsResult({ id: "call-4", fault: None, cmd: "pytest", stdout: "1 passed", stderr: "", exit_code: 0, passed: 1, failed: 0, failures: [], meta: t_meta() });
    t_render(item)
      == "{\"tool\":\"RunTests\",\"exit_code\":0,\"stdout\":\"1 passed\",\"stderr\":\"\",\"truncated\":false}"
  }

-- The long-command case: a `cmd` longer than the tool message cap, through
-- the exported `tool_result_message`, which applies the cap. The message is
-- cut, and the complete `fault` object survives the cut.
func t_long_cmd_keeps_fault() -> bool
  tests [((), true)]
  {
    let x1 = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyzAB";
    let x2 = "${x1}${x1}";
    let x4 = "${x2}${x2}";
    let x8 = "${x4}${x4}";
    let x16 = "${x8}${x8}";
    let x32 = "${x16}${x16}";
    let x64 = "${x32}${x32}";
    let x128 = "${x64}${x64}";
    let x256 = "${x128}${x128}";
    let x512 = "${x256}${x256}";
    let x1024 = "${x512}${x512}";
    let f = { kind: FaultOutputLimit(1000), effects: EffectsUnknown };
    let content = t_render(t_bash(Some(f), x1024, "", "output limit exceeded: 1000 bytes", 1));
    let msg = tool_result_message({ id: "call-5", name: "BashExec", arguments: "{}" }, content);
    Str.length(x1024) > 65536
      && Str.length(msg.content) == 65536
      && contains(msg.content, "\"fault\":${encode(fault_to_json(f))}")
  }

-- The unknown-tool refusal echoes the caller's name (#277 review, finding 2).
-- A 102,400-character name, through the exported `tool_result_message`, which
-- applies the cap: the message still holds the complete `fault`.
func t_long_unknown_tool_keeps_fault() -> bool
  tests [((), true)]
  {
    let x1 = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyzAB";
    let x2 = "${x1}${x1}";
    let x4 = "${x2}${x2}";
    let x8 = "${x4}${x4}";
    let x16 = "${x8}${x8}";
    let x32 = "${x16}${x16}";
    let x64 = "${x32}${x32}";
    let x128 = "${x64}${x64}";
    let x256 = "${x128}${x128}";
    let x512 = "${x256}${x256}";
    let x1024 = "${x512}${x512}";
    let content = t_render(unknown_tool_refusal("call-6", x1024));
    let msg = tool_result_message({ id: "call-6", name: x1024, arguments: "{}" }, content);
    Str.length(x1024) > 65536
      && contains(msg.content, "\"fault\":${encode(fault_to_json(refused_fault()))}")
  }

-- `dispatch_one_typed`'s defensive branch, for 0 and for >1 results: kind
-- `io_error`, effects `unknown`, exit code 1.
func t_defensive_arm_no_results() -> bool
  tests [((), true)]
  {
    let out = typed_dispatch_result([]);
    out.exit_code == 1
      && out.content == "{\"fault\":{\"kind\":\"io_error\",\"effects\":\"unknown\",\"note\":\"${effects_note_unknown()}\"},\"error\":true,\"message\":\"internal: dispatcher returned 0 or >1 results for single call\"}"
  }

func t_defensive_arm_two_results() -> bool
  tests [((), true)]
  {
    let a = t_bash(None, "true", "", "", 0);
    let out = typed_dispatch_result([a, a]);
    out.exit_code == 1
      && out.content == "{\"fault\":{\"kind\":\"io_error\",\"effects\":\"unknown\",\"note\":\"${effects_note_unknown()}\"},\"error\":true,\"message\":\"internal: dispatcher returned 0 or >1 results for single call\"}"
  }

-- The single-result branch is the item's own rendering and exit code.
func t_single_result_passthrough() -> bool
  tests [((), true)]
  {
    let a = t_bash(None, "make build", "ok", "", 2);
    let out = typed_dispatch_result([a]);
    out.exit_code == 2 && out.content == t_render(a)
  }
