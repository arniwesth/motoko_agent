-- src/core/recovery.ail
--
-- Pure recovery policy for stream retries. WI-C5 routes live entrypoints
-- through session.ail; later WIs wire these helpers deeper.

module src/core/recovery

import std/ai (Message)
import std/string (contains)

-- Retry a failed model stream only when the provider marked the error
-- retryable (transient: timeout / connection / rate-limit / 5xx). A
-- non-retryable error (ProtocolError, ContextLength, SchemaValidation,
-- AuthFailed, ...) means the exact same request will fail again, so retrying
-- just burns the step budget resending a doomed payload — fail fast instead.
-- Precision, and it is what bounds the retry loop: a retry may only be approved
-- when there is budget left to spend on it AND the provider marked the error
-- retryable. Strictly weaker than the body -- dropping `retry_enabled` still
-- satisfies it -- so it does not restate the policy, it fences the two ways the
-- policy could become unsafe. The tests below fix two points; this fixes every
-- budget, which is the property an example cannot state.
export pure func should_retry_stream_error(retryable: bool, retry_enabled: bool, remaining_step_budget: int) -> bool
  ensures { not result || (remaining_step_budget > 1 && retryable) }
  {
  retryable
    && retry_enabled
    && remaining_step_budget > 1
}

-- What is left of the persist nudge. 005 W2-2 removed the policy; the marker
-- and the count below are what `nudges_used` is re-derived from, and they go
-- with that counter (W2-3).
export pure func persist_nudge_marker() -> string { "[motoko-persist-nudge]" }

export pure func count_persist_nudges(msgs: [Message]) -> int {
  match msgs {
    [] => 0,
    m :: rest => {
      let here = if m.role == "user" && contains(m.content, persist_nudge_marker()) then 1 else 0;
      here + count_persist_nudges(rest)
    }
  }
}

pure func test_stream_retry_policy() -> bool
  tests [((), true)]
  {
    should_retry_stream_error(true, true, 2)
      && not should_retry_stream_error(true, true, 1)
      && not should_retry_stream_error(true, false, 4)
      && not should_retry_stream_error(false, true, 4)
  }
