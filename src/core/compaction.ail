-- src/core/compaction.ail
-- Shared context-usage measurement for phase-B compaction.
--
-- The structural elision ladder lives in
-- pkg/sunholo/motoko_ext_compaction_structural. Core keeps only the
-- measurement surface needed to size extension compaction windows and to
-- reject a still-overfull provider payload after the compactor chain.

module src/core/compaction

import std/ai (Message)
import std/string (length)
import std/list (foldl)

-- Token estimate for [Message]: sum all content-field lengths, divide by 4.
-- contracts: SKIPPED — uses foldl (Z3 fragment requires non-higher-order)
export pure func estimate_tokens_messages(msgs: [Message]) -> int {
  let total = foldl(\acc m. acc + length(m.content), 0, msgs);
  (total + 3) / 4
}

-- Context usage as integer percent (0-100). Returns 0 for unknown/disabled
-- limits so callers fail open instead of guessing provider windows.
-- contracts: SKIPPED — depends on foldl-based estimate_tokens_messages
export pure func usage_percent_with_limit(msgs: [Message], limit: int) -> int {
  if limit == 0 then 0
  else (estimate_tokens_messages(msgs) * 100) / limit
}

export pure func exhaustion_pct() -> int { 95 }

func estimate_tokens_rounds_up() -> bool
  tests [((), true)]
  {
    estimate_tokens_messages([
      { role: "user", content: "abcde", tool_calls: [], tool_call_id: "" }
    ]) == 2
  }

func usage_percent_unknown_limit_is_zero() -> bool
  tests [((), true)]
  {
    usage_percent_with_limit([
      { role: "user", content: "abcd", tool_calls: [], tool_call_id: "" }
    ], 0) == 0
  }

func usage_percent_with_explicit_limit() -> bool
  tests [((), true)]
  {
    usage_percent_with_limit([
      { role: "user", content: "abcd", tool_calls: [], tool_call_id: "" }
    ], 10) == 10
  }
