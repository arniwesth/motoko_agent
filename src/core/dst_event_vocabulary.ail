-- src/core/dst_event_vocabulary.ail
--
-- WI-A8, under ADR-001 D6: the event vocabulary — the FIFTH recorded axis,
-- alongside the program schema, generator version, profile version and
-- execution manifest. Project 007, now accepted, records the terminal trace and
-- its wire projection as a maintained compatibility surface, and this artifact
-- carries that obligation.
--
-- One artifact binds, for every one of the 34 `LedgerEvent` variants:
--
--   the variant itself; its wire name; its payload schema; and its
--   classification as LOGICAL or DISPLAY-ONLY.
--
-- This is new construction. `phase_vocab.ledger_record_name` is not a seed and
-- is not grown here: it names three of the 34 and collapses the rest to the
-- literal "wire", which is a different thing that happens to share a subject.
--
-- ============================================================================
-- The schema is `wire name = f(variant, payload)`, and that is settled
-- ============================================================================
--
-- One variant of the 34 is payload-dependent: `StreamDelta` projects to
-- `reasoning_delta` or `thinking_delta` selected from `i.kind`. A
-- one-name-per-variant artifact cannot represent that, so the shape is:
--
--   `event_wire_name`   a TOTAL projection over the value. Adding a variant is
--                       a compile error here, so drift in the 33 single-name
--                       cases stays a compile error, which D6 names as the
--                       preferred form.
--   `wire_names`        an ALLOWED-NAME SET per row — one entry for 33 rows,
--                       two for StreamDelta.
--
-- Both, not either. The total function makes the projection derivable; the
-- allowed set makes the artifact readable without executing it, which is what
-- a versioned compatibility surface has to be.
--
-- ============================================================================
-- Classification: what LOGICAL and DISPLAY-ONLY mean here
-- ============================================================================
--
-- D6.5 gives the criterion by example — display-only fields "cannot change
-- invariant results" — and D6.4 gives the obligation: every LOGICAL event
-- produced by the driver reaches the returned trace, while "display-only
-- telemetry excluded from the ledger is classified separately, by the
-- event-vocabulary artifact". So:
--
--   Logical      its presence, order or content can change an invariant result,
--                and D6.4 therefore requires it to reach the returned trace.
--   DisplayOnly  it cannot, because the fact it reports is either recorded
--                authoritatively by a different record, or is an input rather
--                than an outcome.
--
-- THE CLASSIFICATION IS SEMANTIC, NOT A SURVEY OF WHAT IS APPENDED TODAY, and
-- that is deliberate. Only 13 of the 34 currently reach the returned trace; the
-- other 21 are projected through `ledger_emit` alone. Classifying by current
-- behaviour would declare 21 events display-only and make D6.4's parity
-- obligation vacuous — it would bless the exact gap D6.4 exists to close. The
-- artifact says which events BELONG in the ledger; WI-A14's invariant then
-- measures the distance. `reaches_trace_today` records the survey separately so
-- the two are never confused.
--
-- Six rows are display-only, and three of those six share one reason: the
-- compaction wire events are the display face of a `CompactionStageRecord`,
-- which IS a `LedgerRecord` in the returned trace and carries the same content
-- (`TraceStageApplied` / `TraceStageRejected` / `TraceStageObserved`, the last
-- carrying the same `[DiagnosticField]`). The logical fact is recorded; the
-- wire event is its projection.
--
-- ONE ROW RESISTED THE BINARY AND IS REPORTED RATHER THAN QUIETLY DECIDED.
-- See `classification_findings()` for `DoneEvent`.

module src/core/dst_event_vocabulary

import std/list as List (length)
import std/option (Option, Some, None)
import src/core/phase_vocab (
  LedgerEvent,
  ProviderCallPrepared, ScratchpadResult, RunSummary, NativeToolDenied, ToolPending,
  ExtToolHandled, DelegatedToolDeferred, V2ToolDispatchStart, V2ToolDispatchComplete,
  Dp7VerifierRejected, CostExhausted, CompactionApplied, CompactionExhausted,
  ExtCompactionRejected, ExtensionDiagnostic, ThinkingStreamStart, ThinkingStreamEnd,
  StreamErrorRetry, ProviderResult, CostWarning, ExtInterceptHandled, HybridBashExtracted,
  DoneEvent, EmptyStopFinalize, ExtSolverFeedback, PersistNudge, NativeToolCalls,
  NativeToolResults, SessionSuspend, SessionStart, ErrorEvent, TotalsUpdated,
  CheckpointTaken, StreamDelta
)

-- D8's compatibility rule applies to this artifact: a change to any variant,
-- wire name, payload schema or classification is a version change, and old
-- traces are decoded or a runner is pinned, never silently reinterpreted. The
-- version lands in the execution manifest (WI-A10) and the failure record (D8).
export pure func event_vocabulary_version() -> string { "event-vocabulary/1" }

export type EventClassification = Logical | DisplayOnly

export pure func classification_id(c: EventClassification) -> string {
  match c {
    Logical => "logical",
    DisplayOnly => "display_only"
  }
}

-- One payload field of the wire projection. `required` is false for a key the
-- projection emits conditionally — `usage`'s cache counters, `thinking`'s cache
-- counters and `done`'s `source` are the only such keys today.
export type PayloadField = { key: string, required: bool }

export type EventRow = {
  variant: string,
  wire_names: [string],
  payload: [PayloadField],
  classification: EventClassification,
  -- The survey, kept strictly apart from the classification. True where the
  -- driver appends this variant to the returned LedgerTrace today. A Logical
  -- row with `false` here is a D6.4 gap for WI-A14 to measure, NOT a
  -- misclassification.
  reaches_trace_today: bool
}

-- ============================================================================
-- The total variant tag. A new LedgerEvent constructor is a compile error here.
-- ============================================================================
export pure func event_variant_id(e: LedgerEvent) -> string {
  match e {
    ProviderCallPrepared(_) => "ProviderCallPrepared",
    ScratchpadResult(_) => "ScratchpadResult",
    RunSummary(_) => "RunSummary",
    NativeToolDenied(_) => "NativeToolDenied",
    ToolPending(_) => "ToolPending",
    ExtToolHandled(_) => "ExtToolHandled",
    DelegatedToolDeferred(_) => "DelegatedToolDeferred",
    V2ToolDispatchStart(_) => "V2ToolDispatchStart",
    V2ToolDispatchComplete(_) => "V2ToolDispatchComplete",
    Dp7VerifierRejected(_) => "Dp7VerifierRejected",
    CostExhausted(_) => "CostExhausted",
    CompactionApplied(_) => "CompactionApplied",
    CompactionExhausted(_) => "CompactionExhausted",
    ExtCompactionRejected(_) => "ExtCompactionRejected",
    ExtensionDiagnostic(_) => "ExtensionDiagnostic",
    ThinkingStreamStart(_) => "ThinkingStreamStart",
    ThinkingStreamEnd(_) => "ThinkingStreamEnd",
    StreamErrorRetry(_) => "StreamErrorRetry",
    ProviderResult(_) => "ProviderResult",
    CostWarning(_) => "CostWarning",
    ExtInterceptHandled(_) => "ExtInterceptHandled",
    HybridBashExtracted(_) => "HybridBashExtracted",
    DoneEvent(_) => "DoneEvent",
    EmptyStopFinalize(_) => "EmptyStopFinalize",
    ExtSolverFeedback(_) => "ExtSolverFeedback",
    PersistNudge(_) => "PersistNudge",
    NativeToolCalls(_) => "NativeToolCalls",
    NativeToolResults(_) => "NativeToolResults",
    SessionSuspend(_) => "SessionSuspend",
    SessionStart(_) => "SessionStart",
    ErrorEvent(_) => "ErrorEvent",
    TotalsUpdated(_) => "TotalsUpdated",
    CheckpointTaken(_) => "CheckpointTaken",
    StreamDelta(_) => "StreamDelta"
  }
}

-- ============================================================================
-- The total wire-name projection: `wire name = f(variant, payload)`.
--
-- 33 arms ignore the payload. The `StreamDelta` arm does not, and it is the
-- whole reason this is a function over the VALUE rather than a lookup by
-- variant. Its branch condition is copied from the live projection
-- (`phase_vocab.to_schema_v1_kvs`, StreamDelta arm) and the round-trip in
-- scripts/dst/event_vocabulary_dst.ail drives BOTH branches, so a change to
-- either side that is not made to the other turns that script red.
-- ============================================================================
export pure func event_wire_name(e: LedgerEvent) -> string {
  match e {
    ProviderCallPrepared(_) => "provider_call_prepared",
    ScratchpadResult(_) => "scratchpad_result",
    RunSummary(_) => "run_summary",
    NativeToolDenied(_) => "native_tool_denied",
    ToolPending(_) => "tool_pending",
    ExtToolHandled(_) => "ext_tool_handled",
    DelegatedToolDeferred(_) => "delegated_tool_deferred",
    V2ToolDispatchStart(_) => "v2_tool_dispatch_start",
    V2ToolDispatchComplete(_) => "v2_tool_dispatch_complete",
    Dp7VerifierRejected(_) => "dp7_verifier_rejected",
    CostExhausted(_) => "cost_exhausted",
    CompactionApplied(_) => "compaction_extension",
    CompactionExhausted(_) => "compaction_exhausted",
    ExtCompactionRejected(_) => "ext_compaction_rejected",
    ExtensionDiagnostic(_) => "extension_diagnostic",
    ThinkingStreamStart(_) => "thinking_stream_start",
    ThinkingStreamEnd(_) => "thinking_stream_end",
    StreamErrorRetry(_) => "stream_error_retry",
    ProviderResult(_) => "thinking",
    CostWarning(_) => "cost_warning",
    ExtInterceptHandled(_) => "ext_intercept_handled",
    HybridBashExtracted(_) => "hybrid_bash_extracted",
    DoneEvent(_) => "done",
    EmptyStopFinalize(_) => "empty_stop_finalize",
    ExtSolverFeedback(_) => "ext_solver_feedback",
    PersistNudge(_) => "persist_nudge",
    NativeToolCalls(_) => "native_tool_calls",
    NativeToolResults(_) => "native_tool_results",
    SessionSuspend(_) => "session_suspend",
    SessionStart(_) => "session_start",
    ErrorEvent(_) => "error",
    TotalsUpdated(_) => "loop_totals_updated",
    CheckpointTaken(_) => "history_checkpoint",
    -- THE ONE PAYLOAD-DEPENDENT ARM
    StreamDelta(i) => if i.kind == "reasoning" then "reasoning_delta" else "thinking_delta"
  }
}

pure func req(k: string) -> PayloadField { { key: k, required: true } }
pure func opt(k: string) -> PayloadField { { key: k, required: false } }

-- ============================================================================
-- The vocabulary
-- ============================================================================

export pure func event_vocabulary() -> [EventRow] {
  [
    { variant: "ProviderCallPrepared", wire_names: ["provider_call_prepared"],
      payload: [req("step"), req("msg_count"), req("estimated_input_tokens"),
                req("system_prefix_count"), req("system_prefix_chars"),
                req("system_prefix_digest"), req("payload_digest"), req("model")],
      -- The exact payload identity a replay must reproduce (D8).
      classification: Logical, reaches_trace_today: true },

    { variant: "ScratchpadResult", wire_names: ["scratchpad_result"],
      payload: [req("tool_call_id"), req("request_id"), req("step"), req("cells_json")],
      classification: Logical, reaches_trace_today: false },

    { variant: "RunSummary", wire_names: ["run_summary"],
      payload: [req("model"), req("motoko_commit"), req("finish_reason"),
                req("steps_executed"), req("usage"), req("total_cost_usd"),
                req("total_cost_millicents"), req("duration_ms"), req("error")],
      -- D6.1's terminal record. `duration_ms` is a display-only FIELD of a
      -- logical event (D6.5) — the distinction is per event, not per field.
      classification: Logical, reaches_trace_today: true },

    { variant: "NativeToolDenied", wire_names: ["native_tool_denied"],
      payload: [req("step"), req("stream_id"), req("tool"), req("id"), req("reason")],
      -- D3's approval_denied class records its transition here.
      classification: Logical, reaches_trace_today: false },

    { variant: "ToolPending", wire_names: ["tool_pending"],
      payload: [req("step"), req("stream_id"), req("tool"), req("id"), req("reason")],
      classification: Logical, reaches_trace_today: false },

    { variant: "ExtToolHandled", wire_names: ["ext_tool_handled"],
      payload: [req("step"), req("stream_id"), req("tool"), req("id"), req("exit_code")],
      -- Which extension served a tool is D5 coverage evidence.
      classification: Logical, reaches_trace_today: false },

    { variant: "DelegatedToolDeferred", wire_names: ["delegated_tool_deferred"],
      payload: [req("step"), req("stream_id"), req("tool"), req("id")],
      -- Records that the tool did NOT execute — a logical non-transition.
      classification: Logical, reaches_trace_today: false },

    { variant: "V2ToolDispatchStart", wire_names: ["v2_tool_dispatch_start"],
      payload: [req("step"), req("stream_id"), req("tool"), req("id")],
      classification: Logical, reaches_trace_today: false },

    { variant: "V2ToolDispatchComplete", wire_names: ["v2_tool_dispatch_complete"],
      payload: [req("step"), req("stream_id"), req("id")],
      classification: Logical, reaches_trace_today: false },

    { variant: "Dp7VerifierRejected", wire_names: ["dp7_verifier_rejected"],
      payload: [req("step"), req("errors")],
      -- Drives a user-message re-injection, so it changes history.
      classification: Logical, reaches_trace_today: false },

    { variant: "CostExhausted", wire_names: ["cost_exhausted"],
      payload: [req("step"), req("total_cost_millicents"), req("total_cost_usd"),
                req("cap_millicents")],
      classification: Logical, reaches_trace_today: false },

    { variant: "CompactionApplied", wire_names: ["compaction_extension"],
      payload: [req("step"), req("note")],
      -- DISPLAY-ONLY: the logical record of this fact is
      -- CompactionStageRecord(TraceStageApplied), which is in the returned
      -- trace and carries the same content.
      classification: DisplayOnly, reaches_trace_today: false },

    { variant: "CompactionExhausted", wire_names: ["compaction_exhausted"],
      payload: [req("step"), req("model"), req("reason")],
      -- Unlike the three stage events this is a TERMINAL cause, not a stage
      -- outcome: no CompactionStageRecord corresponds to it.
      classification: Logical, reaches_trace_today: true },

    { variant: "ExtCompactionRejected", wire_names: ["ext_compaction_rejected"],
      payload: [req("step"), req("note")],
      -- DISPLAY-ONLY: counterpart is CompactionStageRecord(TraceStageRejected).
      classification: DisplayOnly, reaches_trace_today: false },

    { variant: "ExtensionDiagnostic", wire_names: ["extension_diagnostic"],
      payload: [req("step"), req("extension"), req("code"), req("fields")],
      -- DISPLAY-ONLY: counterpart is CompactionStageRecord(TraceStageObserved),
      -- which carries the same [DiagnosticField]. D5 governs it as a permitted
      -- diagnostic projection and D6.8 makes diagnostics non-authoritative.
      classification: DisplayOnly, reaches_trace_today: false },

    { variant: "ThinkingStreamStart", wire_names: ["thinking_stream_start"],
      payload: [req("step"), req("stream_id"), req("model")],
      -- Brackets the emission sequence D6.4's parity invariant checks.
      classification: Logical, reaches_trace_today: true },

    { variant: "ThinkingStreamEnd", wire_names: ["thinking_stream_end"],
      payload: [req("step"), req("stream_id"), req("status")],
      -- `status` discriminates completed from errored, which D3's provider
      -- classes turn on.
      classification: Logical, reaches_trace_today: false },

    { variant: "StreamErrorRetry", wire_names: ["stream_error_retry"],
      payload: [req("step"), req("error")],
      -- D3's provider_error_retryable transition.
      classification: Logical, reaches_trace_today: true },

    { variant: "ProviderResult", wire_names: ["thinking"],
      payload: [req("step"), req("text"), req("finish_reason"), req("tool_calls"),
                req("input_tokens"), req("output_tokens"), req("cost_usd"),
                opt("cache_read_input_tokens"), opt("cache_creation_input_tokens")],
      classification: Logical, reaches_trace_today: true },

    { variant: "CostWarning", wire_names: ["cost_warning"],
      payload: [req("threshold"), req("step"), req("pct"),
                req("total_cost_millicents"), req("total_cost_usd"), req("cap_millicents")],
      -- DISPLAY-ONLY: a threshold-crossing notice. The authoritative figures
      -- are in CostExhausted and RunSummary; no invariant can turn on whether
      -- a warning was shown.
      classification: DisplayOnly, reaches_trace_today: false },

    { variant: "ExtInterceptHandled", wire_names: ["ext_intercept_handled"],
      -- NOTE the projection is LOSSY: ToolHandledInfo carries stream_id and id,
      -- and this arm emits neither. Recorded as the schema rather than
      -- corrected, because correcting it would change the wire.
      payload: [req("step"), req("tool"), req("exit_code")],
      classification: Logical, reaches_trace_today: true },

    { variant: "HybridBashExtracted", wire_names: ["hybrid_bash_extracted"],
      payload: [req("step"), req("cmd")],
      classification: Logical, reaches_trace_today: true },

    { variant: "DoneEvent", wire_names: ["done"],
      payload: [req("step"), req("output"), opt("source")],
      -- LOGICAL, and the one row that resisted the binary — see
      -- classification_findings().
      classification: Logical, reaches_trace_today: false },

    { variant: "EmptyStopFinalize", wire_names: ["empty_stop_finalize"],
      payload: [req("step"), req("input_tokens"), req("estimated_input_tokens"),
                req("context_limit")],
      -- D3's provider_empty_terminal_response transition.
      classification: Logical, reaches_trace_today: true },

    { variant: "ExtSolverFeedback", wire_names: ["ext_solver_feedback"],
      payload: [req("step"), req("feedback")],
      classification: Logical, reaches_trace_today: true },

    { variant: "PersistNudge", wire_names: ["persist_nudge"],
      payload: [req("step"), req("nudge_num"), req("budget")],
      classification: Logical, reaches_trace_today: true },

    { variant: "NativeToolCalls", wire_names: ["native_tool_calls"],
      payload: [req("request_id"), req("step"), req("stream_id"), req("tool_calls")],
      classification: Logical, reaches_trace_today: false },

    { variant: "NativeToolResults", wire_names: ["native_tool_results"],
      payload: [req("request_id"), req("step"), req("stream_id"), req("results")],
      classification: Logical, reaches_trace_today: false },

    { variant: "SessionSuspend", wire_names: ["session_suspend"],
      payload: [req("session_id"), req("target_profile")],
      -- A control transition naming a target profile — D5 identity.
      classification: Logical, reaches_trace_today: false },

    { variant: "SessionStart", wire_names: ["session_start"],
      payload: [req("task"), req("model"), req("mode")],
      -- DISPLAY-ONLY: task, model and mode are run INPUTS, recorded
      -- authoritatively by the execution manifest (D5) and, for the model, by
      -- RunSummary. An outcome invariant cannot turn on the banner.
      classification: DisplayOnly, reaches_trace_today: false },

    { variant: "ErrorEvent", wire_names: ["error"],
      payload: [req("source"), req("code"), req("message")],
      -- Carries the AIError code the TUI consumes, and the code is what D3's
      -- max-steps discrimination reads (WI-A7).
      classification: Logical, reaches_trace_today: true },

    { variant: "TotalsUpdated", wire_names: ["loop_totals_updated"],
      payload: [req("step"), req("input_tokens"), req("output_tokens")],
      -- DISPLAY-ONLY: running telemetry. RunSummary carries the authoritative
      -- totals, and this event is a prefix view of them.
      classification: DisplayOnly, reaches_trace_today: false },

    { variant: "CheckpointTaken", wire_names: ["history_checkpoint"],
      payload: [req("reason"), req("before_digest"), req("after_digest")],
      -- validate_checkpoint_chain reasons over exactly this digest chain.
      classification: Logical, reaches_trace_today: true },

    { variant: "StreamDelta", wire_names: ["reasoning_delta", "thinking_delta"],
      payload: [req("step"), req("stream_id"), req("seq"), req("text_delta")],
      -- D6.4's NAMED EXCEPTION: the provider callback's closed effect row means
      -- projection happens during the call and the append after it returns, so
      -- a single shared transition is impossible by construction. The
      -- obligation is discharged by an explicitly checked parity invariant
      -- instead — which is WI-A14's, not this item's.
      classification: Logical, reaches_trace_today: false }
  ]
}

-- ============================================================================
-- Findings: rows whose classification is not clean, reported rather than
-- silently decided
-- ============================================================================

export type ClassificationFinding = { variant: string, tension: string }

export pure func classification_findings() -> [ClassificationFinding] {
  [
    {
      variant: "DoneEvent",
      tension: "Classified Logical because D6.3 requires the returned outcome, the DoneEvent when present, and the RunSummary to AGREE — an invariant over its content, which is exactly what DisplayOnly denies. But D6.3 also says it is 'not a second terminal record', and D6.1 requires the RunSummary to be the FINAL record of the returned trace, while the driver projects the DoneEvent AFTER c2_finalize has appended the RunSummary. So D6.4's obligation on a Logical event ('reaches the returned trace') and D6.1's final-record invariant cannot both be satisfied by appending it where it is emitted. The resolution is available — append the DoneEvent BEFORE finalizing — but it is a change to a terminal path and therefore WI-A14's call to make against its invariant set, not this artifact's. Recorded here so the classification is not mistaken for a decision that the append is free."
    }
  ]
}

-- ============================================================================
-- The validator. Fails closed on an unclassified variant, and on set
-- completeness.
-- ============================================================================

export type VocabularyRejection
  = UnclassifiedVariant(string)
  | MissingVariantRow(string)
  | DuplicateVariantRow(string)
  | EmptyWireNameSet(string)
  | EmptyWireName(string)
  | EmptyPayloadField(string)
  | WireNameNotDeclared(string, string)
  | RowCountMismatch(int, int)

export pure func vocabulary_rule(r: VocabularyRejection) -> string {
  match r {
    UnclassifiedVariant(_) => "unclassified-variant",
    MissingVariantRow(_) => "missing-variant-row",
    DuplicateVariantRow(_) => "duplicate-variant-row",
    EmptyWireNameSet(_) => "empty-wire-name-set",
    EmptyWireName(_) => "empty-wire-name",
    EmptyPayloadField(_) => "empty-payload-field",
    WireNameNotDeclared(_, _) => "wire-name-not-declared",
    RowCountMismatch(_, _) => "row-count-mismatch"
  }
}

export pure func vocabulary_message(r: VocabularyRejection) -> string {
  match r {
    UnclassifiedVariant(v) =>
      "[unclassified-variant] variant '${v}' declares no logical/display-only classification; a new event cannot enter the ledger without declaring which side of the line it falls on (D6)",
    MissingVariantRow(v) =>
      "[missing-variant-row] variant '${v}' has no row in the vocabulary; the artifact validates while being incomplete, which is the failure this check exists for",
    DuplicateVariantRow(v) =>
      "[duplicate-variant-row] variant '${v}' has more than one row",
    EmptyWireNameSet(v) =>
      "[empty-wire-name-set] variant '${v}' declares no wire name",
    EmptyWireName(v) =>
      "[empty-wire-name] variant '${v}' declares an empty wire name",
    EmptyPayloadField(v) =>
      "[empty-payload-field] variant '${v}' declares a payload field with an empty key",
    WireNameNotDeclared(v, n) =>
      "[wire-name-not-declared] the projection produces wire name '${n}' for variant '${v}', which the row's allowed-name set does not contain",
    RowCountMismatch(rows, variants) =>
      "[row-count-mismatch] the vocabulary carries ${show(rows)} rows for ${show(variants)} variants"
  }
}

pure func contains_str(xs: [string], t: string) -> bool {
  match xs {
    [] => false,
    x :: rest => if x == t then true else contains_str(rest, t)
  }
}

pure func nonempty_names(v: string, names: [string]) -> [VocabularyRejection] {
  match names {
    [] => [],
    n :: rest =>
      (if n == "" then [EmptyWireName(v)] else []) ++ nonempty_names(v, rest)
  }
}

pure func nonempty_fields(v: string, fs: [PayloadField]) -> [VocabularyRejection] {
  match fs {
    [] => [],
    f :: rest =>
      (if f.key == "" then [EmptyPayloadField(v)] else []) ++ nonempty_fields(v, rest)
  }
}

-- Row shape. `UnclassifiedVariant` fires for a row whose variant tag is empty:
-- with `EventClassification` a two-constructor sum there is no third value a
-- row could hold, so the reachable way to have an unclassified variant is a row
-- that does not identify its variant — or, the case that actually matters, a
-- variant with no row at all, which `missing_rows` below catches.
pure func validate_row(r: EventRow) -> [VocabularyRejection] {
  let tag = if r.variant == "" then [UnclassifiedVariant("<anonymous>")] else [];
  let names = if List.length(r.wire_names) == 0 then [EmptyWireNameSet(r.variant)] else [];
  tag ++ names ++ nonempty_names(r.variant, r.wire_names) ++ nonempty_fields(r.variant, r.payload)
}

pure func validate_rows(rs: [EventRow]) -> [VocabularyRejection] {
  match rs {
    [] => [],
    r :: rest => validate_row(r) ++ validate_rows(rest)
  }
}

pure func row_variants(rs: [EventRow]) -> [string] {
  match rs {
    [] => [],
    r :: rest => r.variant :: row_variants(rest)
  }
}

pure func duplicates(seen: [string], xs: [string]) -> [VocabularyRejection] {
  match xs {
    [] => [],
    x :: rest =>
      (if contains_str(seen, x) then [DuplicateVariantRow(x)] else [])
        ++ duplicates(x :: seen, rest)
  }
}

-- SET COMPLETENESS against the type itself. The caller passes one sample value
-- per LedgerEvent constructor; every sample's variant tag must have a row, and
-- the projection's wire name for that sample must be in the row's allowed set.
--
-- This is the check that makes the artifact's completeness decidable at all.
-- `event_variant_id` is a total match, so a new constructor is a compile error
-- there — but a new constructor with a compile-forced arm and NO ROW would
-- otherwise validate cleanly, which is an artifact that validates while
-- incomplete.
pure func missing_rows(rows: [EventRow], samples: [LedgerEvent]) -> [VocabularyRejection] {
  match samples {
    [] => [],
    s :: rest => {
      let v = event_variant_id(s);
      let here = match find_row(rows, v) {
        None => [MissingVariantRow(v)],
        Some(row) =>
          if contains_str(row.wire_names, event_wire_name(s)) then []
          else [WireNameNotDeclared(v, event_wire_name(s))]
      };
      here ++ missing_rows(rows, rest)
    }
  }
}

export pure func find_row(rows: [EventRow], variant: string) -> Option[EventRow] {
  match rows {
    [] => None,
    r :: rest => if r.variant == variant then Some(r) else find_row(rest, variant)
  }
}

-- `samples` must contain one value per LedgerEvent constructor. The DST script
-- builds them and asserts the count independently.
export pure func validate_vocabulary(rows: [EventRow], samples: [LedgerEvent]) -> [VocabularyRejection] {
  let count =
    if List.length(rows) != List.length(samples)
    then [RowCountMismatch(List.length(rows), List.length(samples))]
    else [];
  validate_rows(rows)
    ++ duplicates([], row_variants(rows))
    ++ missing_rows(rows, samples)
    ++ count
}

export pure func vocabulary_ok(rows: [EventRow], samples: [LedgerEvent]) -> bool {
  List.length(validate_vocabulary(rows, samples)) == 0
}

-- ============================================================================
-- Consumers: WI-A14's parity invariant reads the logical set from here
-- ============================================================================

export pure func logical_variants(rows: [EventRow]) -> [string] {
  match rows {
    [] => [],
    r :: rest =>
      match r.classification {
        Logical => r.variant :: logical_variants(rest),
        DisplayOnly => logical_variants(rest)
      }
  }
}

export pure func display_only_variants(rows: [EventRow]) -> [string] {
  match rows {
    [] => [],
    r :: rest =>
      match r.classification {
        DisplayOnly => r.variant :: display_only_variants(rest),
        Logical => display_only_variants(rest)
      }
  }
}

-- D6.4's gap, made countable: variants classified Logical that the driver does
-- not append to the returned trace today. WI-A14's invariant closes these; this
-- function is how it knows which.
export pure func logical_variants_not_in_trace(rows: [EventRow]) -> [string] {
  match rows {
    [] => [],
    r :: rest => {
      let tail = logical_variants_not_in_trace(rest);
      match r.classification {
        Logical => if r.reaches_trace_today then tail else r.variant :: tail,
        DisplayOnly => tail
      }
    }
  }
}

export pure func is_logical(rows: [EventRow], variant: string) -> bool {
  match find_row(rows, variant) {
    None => false,
    Some(r) => match r.classification { Logical => true, DisplayOnly => false }
  }
}

-- ============================================================================
-- Inline tests. The 34-variant round trip lives in the DST script, because it
-- needs one sample value per constructor.
-- ============================================================================

pure func has_rule(rs: [VocabularyRejection], rule: string) -> bool {
  match rs {
    [] => false,
    r :: rest => if vocabulary_rule(r) == rule then true else has_rule(rest, rule)
  }
}

pure func test_vocabulary_has_thirty_four_distinct_rows() -> bool
  tests [((), true)]
  {
    List.length(event_vocabulary()) == 34
      && no_dups(row_variants(event_vocabulary()), [])
  }

pure func no_dups(xs: [string], seen: [string]) -> bool {
  match xs {
    [] => true,
    x :: rest => if contains_str(seen, x) then false else no_dups(rest, x :: seen)
  }
}

pure func test_every_row_declares_a_wire_name_and_a_payload() -> bool
  tests [((), true)]
  {
    List.length(validate_rows(event_vocabulary())) == 0
      && all_rows_have_payload(event_vocabulary())
  }

pure func all_rows_have_payload(rs: [EventRow]) -> bool {
  match rs {
    [] => true,
    r :: rest => if List.length(r.payload) == 0 then false else all_rows_have_payload(rest)
  }
}

-- Only StreamDelta may declare more than one wire name; the schema is
-- f(variant, payload) precisely because of that one variant, and a second
-- multi-name row would mean another payload-dependent projection had appeared
-- without the projection function learning about it.
pure func test_only_stream_delta_has_two_wire_names() -> bool
  tests [((), true)]
  {
    multi_name_variants(event_vocabulary()) == 1
      && match find_row(event_vocabulary(), "StreamDelta") {
           None => false,
           Some(r) => List.length(r.wire_names) == 2
             && contains_str(r.wire_names, "reasoning_delta")
             && contains_str(r.wire_names, "thinking_delta")
         }
  }

pure func multi_name_variants(rs: [EventRow]) -> int {
  match rs {
    [] => 0,
    r :: rest =>
      (if List.length(r.wire_names) > 1 then 1 else 0) + multi_name_variants(rest)
  }
}

pure func test_wire_names_are_distinct_across_variants() -> bool
  tests [((), true)]
  {
    no_dups(all_wire_names(event_vocabulary()), [])
  }

pure func all_wire_names(rs: [EventRow]) -> [string] {
  match rs {
    [] => [],
    r :: rest => r.wire_names ++ all_wire_names(rest)
  }
}

pure func test_classification_partitions_the_vocabulary() -> bool
  tests [((), true)]
  {
    let rows = event_vocabulary();
    List.length(logical_variants(rows)) + List.length(display_only_variants(rows)) == 34
      && List.length(display_only_variants(rows)) == 6
  }

pure func test_missing_row_is_rejected() -> bool
  tests [((), true)]
  {
    -- One row dropped; every remaining row is perfect, so every row-shape check
    -- passes. Only the sample-driven completeness check sees it.
    let short = drop_row(event_vocabulary(), "StreamDelta");
    has_rule(validate_vocabulary(short, [sample_stream_delta()]), "missing-variant-row")
  }

pure func drop_row(rs: [EventRow], v: string) -> [EventRow] {
  match rs {
    [] => [],
    r :: rest => if r.variant == v then drop_row(rest, v) else r :: drop_row(rest, v)
  }
}

pure func sample_stream_delta() -> LedgerEvent {
  StreamDelta({ step: 1, stream_id: "s", seq: 0, kind: "text", text: "x" })
}

pure func sample_reasoning_delta() -> LedgerEvent {
  StreamDelta({ step: 1, stream_id: "s", seq: 0, kind: "reasoning", text: "x" })
}

-- The payload-dependent projection, both branches, against the artifact.
pure func test_stream_delta_both_branches_are_declared() -> bool
  tests [((), true)]
  {
    event_wire_name(sample_stream_delta()) == "thinking_delta"
      && event_wire_name(sample_reasoning_delta()) == "reasoning_delta"
      && event_variant_id(sample_stream_delta()) == "StreamDelta"
      && List.length(validate_vocabulary(event_vocabulary(),
           [sample_stream_delta(), sample_reasoning_delta()])) == 1
  }

pure func test_undeclared_wire_name_is_rejected() -> bool
  tests [((), true)]
  {
    let narrowed = narrow_stream_delta(event_vocabulary());
    has_rule(validate_vocabulary(narrowed, [sample_reasoning_delta()]), "wire-name-not-declared")
  }

pure func narrow_stream_delta(rs: [EventRow]) -> [EventRow] {
  match rs {
    [] => [],
    r :: rest =>
      if r.variant == "StreamDelta"
      then { r | wire_names: ["thinking_delta"] } :: narrow_stream_delta(rest)
      else r :: narrow_stream_delta(rest)
  }
}

pure func test_empty_vocabulary_is_rejected() -> bool
  tests [((), true)]
  {
    let rs = validate_vocabulary([], [sample_stream_delta()]);
    has_rule(rs, "missing-variant-row") && has_rule(rs, "row-count-mismatch")
  }

pure func test_duplicate_row_is_rejected() -> bool
  tests [((), true)]
  {
    let doubled = event_vocabulary() ++ [{
      variant: "StreamDelta", wire_names: ["thinking_delta"],
      payload: [req("step")], classification: Logical, reaches_trace_today: false
    }];
    has_rule(validate_vocabulary(doubled, [sample_stream_delta()]), "duplicate-variant-row")
  }

-- The D6.4 gap this artifact makes countable. Asserting the number pins it, so
-- a row silently flipping `reaches_trace_today` shows up here rather than
-- quietly shrinking WI-A14's work list.
pure func test_logical_gap_is_recorded() -> bool
  tests [((), true)]
  {
    List.length(logical_variants_not_in_trace(event_vocabulary())) == 15
      && contains_str(logical_variants_not_in_trace(event_vocabulary()), "StreamDelta")
      && contains_str(logical_variants_not_in_trace(event_vocabulary()), "DoneEvent")
  }

pure func test_findings_reference_real_rows() -> bool
  tests [((), true)]
  {
    List.length(classification_findings()) == 1
      && findings_resolve(classification_findings())
  }

pure func findings_resolve(fs: [ClassificationFinding]) -> bool {
  match fs {
    [] => true,
    f :: rest =>
      match find_row(event_vocabulary(), f.variant) {
        None => false,
        Some(_) => if f.tension == "" then false else findings_resolve(rest)
      }
  }
}

pure func test_classification_ids_are_stable() -> bool
  tests [((), true)]
  {
    classification_id(Logical) == "logical" && classification_id(DisplayOnly) == "display_only"
      && is_logical(event_vocabulary(), "RunSummary")
      && not is_logical(event_vocabulary(), "CostWarning")
  }
