-- Decision 1, forward half: the two unrouted reachable core sites at HEAD must
-- be declared. An empty-install definition declaring neither is REJECTED, which
-- is what stops the weaker reading from being a rubber stamp.
pure func test_undeclared_unrouted_site_is_rejected() -> bool
  tests [((), true)]
  {
    has_rule(validate_routing(fixture_base()), "unrouted-site-undeclared")
  }

pure func test_declared_unrouted_site_needs_an_instrument() -> bool
  tests [((), true)]
  {
    let d: ProfileDefinition = { fixture_base() |
      unrouted_reachable_sites: [
        { site_key: "src/core/test/stub_step.ail:203", instrument: "", why_unroutable: "live adapter" }
      ] };
    has_rule(validate_routing(d), "unrouted-site-without-instrument")
  }

-- Decision 1, reverse half: a declaration for a site that is not
-- reachable-and-unrouted is itself a defect, so a site that gets routed or
-- moves cannot leave a stale declaration reading as if the gap were live.
pure func test_stale_declaration_is_rejected() -> bool
  tests [((), true)]
  {
    let d: ProfileDefinition = { fixture_base() |
      unrouted_reachable_sites: [
        { site_key: "src/core/test/stub_step.ail:203", instrument: "make world_state", why_unroutable: "live adapter" },
        { site_key: "src/core/gone.ail:1", instrument: "make world_state", why_unroutable: "moved" }
      ] };
    let rs = validate_routing(d);
    has_rule(rs, "declared-site-not-reachable")
      && not has_rule(rs, "unrouted-site-undeclared")
  }

-- Decision 2: the claim is COMPUTED. The numbers are not asserted against a
-- constant here — they are asserted to be a partition of what the table
-- returns, which is the property that survives the table changing.
pure func test_routed_set_claim_is_a_partition_of_the_table() -> bool
  tests [((), true)]
  {
    let c = routed_set_claim(fixture_base());
    c.reachable_total == c.routed + c.declared_unrouted
      && c.reachable_total == List.length(Attr.reachable_core_sites([]))
      && c.declared_unrouted > 0
  }

