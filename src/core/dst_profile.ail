-- ---------------------------------------------------------------------------
-- WI-D13: the basis check, BOTH SIDES.
--
-- A validation that only ever accepts cannot be told from one that does not
-- run, and this project has shipped that shape twice — classifier 1's
-- `agree=0 disagree=0`, and this very rule's absence, which read as enforcement
-- for eleven items because nothing ever tried to write an unbased claim. So
-- there is a rejecting fixture per arm AND a control that resolves.
--
-- The control is the load-bearing one: it is the entry the whole condition was
-- written about — a `WorldMediated` classification — and it passes only because
-- it names classifier 3 and the revision it ran at.
-- ---------------------------------------------------------------------------

-- One entry, well-formed but for the field under test. Every mutation below is
-- one field from clean, so an unrelated rule firing means the mutation did
-- something other than what it says.
pure func based(p: string, rev: string) -> [HookClassificationEntry] {
  [{ extension_id: "c", hook_id: "compactor[0]", classification: WorldMediated,
     basis: { producer: p, revision: rev },
     -- WI-D14: the clause record the entry needs to be well-formed, so that a
     -- basis fixture fails on its BASIS and not on a clause. This is the
     -- no-op shape the four cleared extensions carry.
     clauses: { ports: Vacuously, origin_tag: Vacuously, world_state: Substantively } }]
}

pure func with_classifications(cs: [HookClassificationEntry]) -> ProfileDefinition {
  { fixture_base() |
    installed_packages: [{ extension_id: "c", package_id: "p", version: "1", source_path: "packages/c/c.ail" }],
    hook_classifications: cs,
    disclosures: [{ extension_id: "c", atoms: [ai("compactor", 0)], covered: [ai("compactor", 0)], excluded: [] }] }
}

-- ARM 1. `WorldMediated` on no producer at all — precisely the entry a profile
-- author could write before WI-D13 and pass the gate.
pure func test_world_mediated_without_a_producer_is_rejected() -> bool
  tests [((), true)]
  {
    has_rule(validate_classifications(with_classifications(based("", "c3de56f"))),
             "classification-basis-not-recorded")
  }

-- ARM 2. A real producer, undated. A measurement that cannot be dated cannot be
-- told from a stale one.
pure func test_basis_without_a_revision_is_rejected() -> bool
  tests [((), true)]
  {
    has_rule(validate_classifications(with_classifications(based("ext_ambient_inventory", ""))),
             "classification-basis-not-recorded")
  }

-- ARM 3. A producer this tree does not have. Fail-closed: an id that names no
-- instrument reads as evidence and is worse than a blank.
pure func test_unrecognised_producer_is_rejected() -> bool
  tests [((), true)]
  {
    has_rule(validate_classifications(with_classifications(based("successor_detector", "c3de56f"))),
             "classification-basis-unrecognised")
  }

-- THE CONTROL. Classifier 3, dated: accepted, and by BOTH basis rules — the
-- assertion is on the rejection count and not merely on the absence of one
-- rule, so a check that stopped running would fail here rather than pass.
pure func test_measured_world_mediated_basis_resolves() -> bool
  tests [((), true)]
  {
    let d = with_classifications(based("ext_ambient_inventory", "c3de56f"));
    List.length(validate_classifications(d)) == 0
  }

-- The record can now tell a MEASURED claim from a READ one, which is the whole
-- finding: before this field both wrote the same three characters into the same
-- record. `declared_row` is recognised — Amendment A's interim rule permits it
-- — and it is recognised as an ASSUMPTION.
pure func test_the_record_distinguishes_measured_from_read() -> bool
  tests [((), true)]
  {
    let measured = match producer_kind("ext_ambient_inventory") {
      Some(k) => basis_kind_id(k),
      None => "unrecognised"
    };
    let read = match producer_kind("declared_row") {
      Some(k) => basis_kind_id(k),
      None => "unrecognised"
    };
    let absent = match producer_kind("successor_detector") { Some(_) => false, None => true };
    measured == "measured" && read == "assumed" && absent
  }

-- ---------------------------------------------------------------------------
-- WI-D14: the kind rule and the clause rule, each with a rejecting arm and a
-- resolving control. Same discipline as D13's above and for the same reason —
-- a validation that only ever accepts cannot be told from one that does not
-- run, and both of these rules bind for the FIRST time in this tree at the
-- profile WI-D14 adds.
-- ---------------------------------------------------------------------------

pure func mediated_on(p: string, cl: Criterion2Clauses) -> [HookClassificationEntry] {
  [{ extension_id: "c", hook_id: "compactor[0]", classification: WorldMediated,
     basis: { producer: p, revision: "c3de56f" }, clauses: cl }]
}

pure func no_op_clauses() -> Criterion2Clauses {
  { ports: Vacuously, origin_tag: Vacuously, world_state: Substantively }
}

-- `declared_row` is RECOGNISED — D13's rule accepts it — and it is an
-- ASSUMPTION. This is the entry that passed the gate until WI-D14: criterion 2
-- recorded off a declaration, which cannot distinguish mediation from ambience
-- at any width (ADR:1449).
pure func test_world_mediated_on_a_read_basis_is_rejected() -> bool
  tests [((), true)]
  {
    let d = with_classifications(mediated_on("declared_row", no_op_clauses()));
    has_rule(validate_classifications(d), "world-mediated-on-an-assumed-basis")
  }

-- The complement, and it is what keeps the rule scoped: the SAME assumed
-- producer on an `EffectFree` entry is accepted, because criterion 1's basis IS
-- an assumption and Amendment A withheld criterion 1 deliberately.
pure func test_effect_free_on_a_read_basis_is_accepted() -> bool
  tests [((), true)]
  {
    let d = with_classifications(
      [{ extension_id: "c", hook_id: "compactor[0]", classification: EffectFree,
         basis: { producer: "declared_row", revision: "c3de56f" },
         clauses: no_criterion_2() }]);
    List.length(validate_classifications(d)) == 0
  }

-- A criterion-2 entry that leaves a clause unrecorded has not said how the
-- conjunct holds. The rejection NAMES the clause.
pure func test_unrecorded_criterion_2_clause_is_rejected() -> bool
  tests [((), true)]
  {
    let d = with_classifications(mediated_on("ext_ambient_inventory",
      { ports: Vacuously, origin_tag: NotApplicable, world_state: Substantively }));
    let rs = validate_classifications(d);
    match rs {
      [] => false,
      r :: _ => match r {
        Criterion2ClauseUnrecorded(_, _, clause) => clause == "origin_tag",
        _ => false
      }
    }
  }

-- The other direction: an `EffectFree` entry carrying criterion-2 evidence.
pure func test_criterion_2_clauses_on_a_criterion_1_entry_are_rejected() -> bool
  tests [((), true)]
  {
    let d = with_classifications(
      [{ extension_id: "c", hook_id: "compactor[0]", classification: EffectFree,
         basis: { producer: "declared_row", revision: "c3de56f" },
         clauses: no_op_clauses() }]);
    has_rule(validate_classifications(d), "criterion-2-clauses-not-applicable")
  }

-- THE CONTROL. The exact entry WI-D14's profile records: classifier 3, dated,
-- with clauses 1 and 2 VACUOUS and clause 3 substantive. Asserted on the
-- rejection COUNT, so a rule that stopped running fails here rather than
-- passing.
pure func test_the_no_op_criterion_2_entry_resolves() -> bool
  tests [((), true)]
  {
    let d = with_classifications(mediated_on("ext_ambient_inventory", no_op_clauses()));
    List.length(validate_classifications(d)) == 0
  }

-- The record can now tell coverage of a NO-OP from coverage of a MEDIATOR,
-- which is the whole of ADR-001 row 3's "visible as such". Before this field
-- both wrote `world_mediated` into the same record.
pure func test_the_statement_distinguishes_no_ops_from_mediation() -> bool
  tests [((), true)]
  {
    let vacuous = with_classifications(mediated_on("ext_ambient_inventory", no_op_clauses()));
    let real = with_classifications(mediated_on("ext_ambient_inventory",
      { ports: Substantively, origin_tag: Substantively, world_state: Substantively }));
    let sv = coverage_substance(vacuous);
    let sr = coverage_substance(real);
    sv.covered_hooks == 1 && sv.no_op_hooks == 1 && sv.world_mediating_hooks == 0
      && sr.covered_hooks == 1 && sr.no_op_hooks == 0 && sr.world_mediating_hooks == 1
      && coverage_statement(vacuous) != coverage_statement(real)
  }

-- And an empty install list still says ZERO, so D5's mandatory caveat is
-- computed rather than deleted.
pure func test_the_statement_still_says_zero_for_an_empty_install_list() -> bool
  tests [((), true)]
  {
    let s = coverage_substance(fixture_base());
    s.installed_extensions == 0 && s.covered_hooks == 0
      && startsWith(coverage_statement(fixture_base()), "extension-model coverage is ZERO")
  }

-- The attribution reference is compared against the LIVE table identity, so a
-- table correction re-issues the profile (D4). The fixture records a made-up
-- identity and must be rejected.
pure func test_stale_attribution_identity_is_rejected() -> bool
  tests [((), true)]
  {
    has_rule(validate_attribution_ref(fixture_base()), "attribution-identity-stale")
  }

pure func test_live_attribution_identity_is_accepted() -> bool
  tests [((), true)]
  {
    let live = Attr.table_identity();
    let d: ProfileDefinition = { fixture_base() |
      attribution_ref: { source_revision: live.source_revision, content_hash: live.content_hash } };
    List.length(validate_attribution_ref(d)) == 0
  }

pure func test_conditional_class_must_be_accounted_for() -> bool
  tests [((), true)]
  {
    has_rule(validate_waivers(fixture_base(), Fault.fault_catalogue()), "conditional-class-unaccounted")
  }

-- The waiver's condition is read back from the catalogue, so a copy that drifts
-- is a rejection. This is the composition defect one field over: a waiver
-- condition is exactly the kind of prose a definition would transcribe.
pure func test_drifted_waiver_condition_is_rejected() -> bool
  tests [((), true)]
  {
    let cat = Fault.fault_catalogue();
    let ids = Fault.conditional_class_ids(cat);
    let waived = waivers_from(cat, ids);
    let drifted = drift_first(waived);
    let d: ProfileDefinition = { fixture_base() | waived_fault_classes: drifted };
    has_rule(validate_waivers(d, cat), "waiver-condition-drifted")
  }

-- Build a correct waiver list by READING each condition from the catalogue.
-- Every conditional class, so the list cannot go stale when a class is added.
export pure func waivers_from(cat: [FaultClass], ids: [string]) -> [WaivedFaultClass] {
  match ids {
    [] => [],
    id :: rest =>
      match Fault.waiving_condition(cat, id) {
        None => waivers_from(cat, rest),
        Some(c) => {
          let w: WaivedFaultClass = { class_id: id, condition: c };
          w :: waivers_from(cat, rest)
        }
      }
  }
}

pure func drift_first(ws: [WaivedFaultClass]) -> [WaivedFaultClass] {
  match ws {
    [] => [],
    w :: rest => {
      let drifted: WaivedFaultClass = { class_id: w.class_id, condition: "a paraphrase" };
      drifted :: rest
    }
  }
}

pure func test_correct_waivers_are_accepted() -> bool
  tests [((), true)]
  {
    let cat = Fault.fault_catalogue();
    let d: ProfileDefinition =
      { fixture_base() | waived_fault_classes: waivers_from(cat, Fault.conditional_class_ids(cat)) };
    List.length(validate_waivers(d, cat)) == 0
  }

pure func test_waiving_an_unconditional_class_is_rejected() -> bool
  tests [((), true)]
  {
    let d: ProfileDefinition = { fixture_base() |
      waived_fault_classes: [{ class_id: "provider_error_retryable", condition: "because" }] };
    has_rule(validate_waivers(d, Fault.fault_catalogue()), "waived-class-not-conditional")
  }

