-- ---- the runtime exclusion check ----

pure func excluding_profile() -> ProfileDefinition {
  { fixture_base() |
    installed_packages: [{ extension_id: "compose", package_id: "sunholo/motoko_ext_compose",
                           version: "0.2.4", source_path: "packages/motoko-ext-compose/compose.ail" }],
    disclosures: [{ extension_id: "compose", atoms: one_per_kind(),
                    covered: all_but(["tool_provider[0]"]),
                    excluded: [ai("tool_provider", 0)] }] }
}

pure func test_excluded_dispatch_returns_a_typed_routing_violation() -> bool
  tests [((), true)]
  {
    let meta: ReplayMetadata =
      { source_revision: "r", toolchain_version: "t", profile_id: "fixture",
        profile_version: "1", event_vocabulary_version: Vocab.event_vocabulary_version() };
    match routing_violation_at(excluding_profile(), "compose", "tool_provider[0]", 3,
                               empty_ledger_trace(), meta) {
      None => false,
      Some(RunFailed(f)) =>
        harness_failure_kind_name(f.kind) == "routing_violation"
          && f.interaction_position == 3
          && f.actual_request_projection != "",
      Some(_) => false
    }
  }

-- The complement, and the reason this is a guard rather than a predicate: a
-- COVERED hook must dispatch normally. A check that failed closed on everything
-- would pass the test above and break every run.
pure func test_covered_dispatch_proceeds() -> bool
  tests [((), true)]
  {
    let meta: ReplayMetadata =
      { source_revision: "r", toolchain_version: "t", profile_id: "fixture",
        profile_version: "1", event_vocabulary_version: Vocab.event_vocabulary_version() };
    match routing_violation_at(excluding_profile(), "compose", "tool_policy[0]", 3,
                               empty_ledger_trace(), meta) {
      None => true,
      Some(_) => false
    }
  }

-- Vacuous for driver_only's shape: nothing installed, so nothing excluded, so
-- no dispatch can violate. Stated as a test rather than as a comment because
-- "vacuous" is a claim about the code and this is what makes it falsifiable.
pure func test_empty_install_list_cannot_violate() -> bool
  tests [((), true)]
  {
    let meta: ReplayMetadata =
      { source_revision: "r", toolchain_version: "t", profile_id: "fixture",
        profile_version: "1", event_vocabulary_version: Vocab.event_vocabulary_version() };
    match routing_violation_at(fixture_base(), "anything", "tool_provider[0]", 0,
                               empty_ledger_trace(), meta) {
      None => true,
      Some(_) => false
    }
  }
