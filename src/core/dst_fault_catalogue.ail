-- src/core/dst_fault_catalogue.ail
--
-- WI-A7, under ADR-001 D3: the fault catalogue, as a versioned machine-readable
-- artifact with a validator that fails closed. D3 fixes the required classes and
-- the per-class fields; the work here is the artifact and the validator, not the
-- design.
--
-- ONE CATALOGUE IS THE SINGLE SOURCE OF TRUTH. That is the whole point of D3
-- making this an artifact rather than prose, so this module also owns the three
-- tool `fault_class` names emitted by `tool_phase.tool_fault_message`
-- (`ToolFailed`, `ToolCorrelationMismatch`, `ToolDeadlineExceeded`), which were
-- previously a second, unversioned vocabulary for the same concepts. They are
-- exported from here and referenced at their call sites.
--
-- It also used to own `max_steps_discriminator_message()`, the literal that
-- separated a max-steps run from an internal driver failure because both left
-- `step_machine.call_model_or_fail` with the same `Internal` code. ADR-003 D2
-- item 1 gave the step budget its own `StepBudgetExhausted` code, so there is
-- no message to share: the constant, its test and the rationale for keeping the
-- wire `code` unchanged are deleted with it.
--
-- ============================================================================
-- Why three class ids are PascalCase and the other eight are not
-- ============================================================================
--
-- The three tool ids are ADOPTED, not chosen. They already existed as bare
-- string literals at src/core/tool_phase.ail:234/238/242 and they reach the
-- model inside a `fault_class` JSON field, so they are a live wire surface.
-- Inventing snake_case ids beside them would have left the tree with two
-- vocabularies for one concept — the exact drift this decision exists to
-- prevent — and renaming them would have changed what reaches the model, which
-- is a compatibility decision this item does not own. So the catalogue adopts
-- them verbatim and the call sites now reference these constants. Zero wire
-- change; one vocabulary. The remaining eight classes have no pre-existing wire
-- name and are named in the repo's ordinary snake_case.
--
-- 034 W1.5 added two more snake_case ids, `tool_effect_applied_then_failed` and
-- `tool_effect_applied_then_deadline`, and their case is a statement: they are
-- WORLD-ONLY (`Visibility`), the one kind of id that must never be a wire name.
--
module src/core/dst_fault_catalogue

import std/list as List (length)
import std/option (Option, Some, None)
import std/string (contains)

-- D8's compatibility rule applies: a change to any class id, field or required
-- set is a version change, and old records are decoded or a runner is pinned,
-- never silently reinterpreted.
--
-- BUMPED TO /2 AT WI-B4. `extension_effect_fault` moved from `NoReachableBranch`
-- to a real `Branch`, and its coverage-gap row changed with it. No class id was
-- added or removed and no field changed shape, so this is a content change to
-- one row rather than a wire change — but the row is what a profile reads to
-- decide whether it may claim the class, and reinterpreting it silently is the
-- exact thing D8's rule prohibits. The class id set is unchanged and
-- `applicability` is unchanged, so `conditional_class_ids()` and every
-- profile's `waived_fault_classes` are unaffected: `driver_only`'s coverage
-- does not move.
--
-- BUMPED TO /3 AT 034 W1.5 (ADR-001 D4), and this one IS a shape change: every
-- row gains `visibility`, and two rows are added, `tool_effect_applied_then_failed`
-- and `tool_effect_applied_then_deadline`. They are WORLD-ONLY: each says the
-- tool's update DID occur and is delivered byte-identically to its wire twin
-- (`ToolFailed`, `ToolDeadlineExceeded`), so its id must never reach the model.
-- The existing rows are not edited — reading `ToolFailed`'s "did NOT occur" as
-- "may have occurred" in place is the silent reinterpretation D8 forbids — and
-- both new rows are `AlwaysApplicable`, so `conditional_class_ids()` and every
-- profile's `waived_fault_classes` are again unaffected. Eleven rows → thirteen.
export pure func fault_catalogue_version() -> string { "fault-catalogue/3" }

-- ============================================================================
-- The shared literals. These are the artifact's wire surface.
-- ============================================================================

export pure func fault_class_tool_failed() -> string { "ToolFailed" }
export pure func fault_class_tool_correlation_mismatch() -> string { "ToolCorrelationMismatch" }
export pure func fault_class_tool_deadline_exceeded() -> string { "ToolDeadlineExceeded" }

-- 034 W1.5: the two WORLD-ONLY tool classes (ADR-001 D4). Not wire names: no
-- projected tool message may contain either (standing rule 6), which
-- `dst_corpus.world_only_ids_on_wire` checks of a run's trace. They are
-- exported for the class observers and that guard, which read world truth.
export pure func fault_class_tool_effect_applied_then_failed() -> string
  ensures { result != "" }
  { "tool_effect_applied_then_failed" }
export pure func fault_class_tool_effect_applied_then_deadline() -> string
  ensures { result != "" }
  { "tool_effect_applied_then_deadline" }

-- WI-D24's row eleven, and it is the first accessor here whose consumer names
-- the class in an IDENTITY rather than in an outcome. `ports.recording_ext_effect`
-- puts it in `ExtensionEffectIdentity`'s class_id slot, where
-- `dst_program.validate_static_references` checks it against `required_class_ids()`
-- — so a drifted literal at that site produces a valid run whose program is
-- rejected for naming a class no catalogue defines. That is the exact failure
-- the three accessors above exist to prevent, one field over.
--
-- WI-D21 measured why this accessor did not exist until now: the `fault_class_*`
-- functions were a SUBSET of the catalogue's eleven rows, and reading them for
-- the catalogue's contents is what made two drafts of that item conclude the
-- class id was missing when it had been written since WI-C5.
export pure func fault_class_extension_effect() -> string { "extension_effect_fault" }

-- WI-D1's four, for the same reason the three above are here: `ports` and
-- `stub_step` name them at the moment a fault is recorded, and a copied literal
-- is where the risk lives (S6).
export pure func fault_class_provider_error_retryable() -> string { "provider_error_retryable" }
export pure func fault_class_provider_error_non_retryable() -> string { "provider_error_non_retryable" }
export pure func fault_class_provider_partial_stream_then_error() -> string { "provider_partial_stream_then_error" }
export pure func fault_class_provider_protocol_inconsistent_result() -> string { "provider_protocol_inconsistent_result" }

-- ============================================================================
-- WI-D1 — THE PROVIDER ERROR CODE VOCABULARY, AND THE RETRYABLE DERIVATION
-- ============================================================================
--
-- THE BINDING THIS ITEM EXISTED TO CHOOSE, RECORDED HERE BECAUSE IT IS THE
-- ITEM'S DURABLE OUTPUT AND NOT A DETAIL.
--
-- `std/ai`'s `AIError` is `{ code, message, retryable }`, and `retryable` is
-- the WHOLE difference between two required fault classes:
-- `session.c2_loop` branches on it through
-- `recovery.should_retry_stream_error(e.retryable, ...)`, taking the retry
-- branch or the `TermProviderFailure` finalize. A scripted provider fault that
-- cannot vary that bool produces `provider_error_retryable` and
-- `provider_error_non_retryable` as THE SAME SCENARIO TWICE, and the two
-- classes are not distinguished however the counters read.
--
-- `ScriptedStep` (WI-B2b) carries `error_code` and `error_message` and no
-- third field. Two ways to supply the bool, and the choice is DECIDED rather
-- than discovered:
--
--   A. A fifth `ScriptedStep` field, `error_retryable: bool`. Truth in one
--      place, at the cost of ~22 record-literal sites across `src/`,
--      `scripts/` and `packages/` — AND a change to `encode_provider_outcome`
--      / `decode_provider_outcome`, because a field a replay cannot restore is
--      a fault that replays as a DIFFERENT fault while every count still
--      balances (the codec failure mode S7's record rule names). That codec is
--      D8's persisted artifact surface, and widening it is a compatibility
--      change the handoff for this item reserves as a stop-and-report.
--
--   B. DERIVE it from `error_code`. CHOSEN. `error_code` already round-trips
--      through both codecs — `encode_provider_outcome` writes it,
--      `decode_provider_outcome` reads it, `ext_world`'s world token carries it
--      — so the distinction between the two classes survives replay with NO
--      codec change and no compatibility surface touched.
--
-- The objection to B is that a derivation puts the truth in a second place.
-- That objection is answered by WHERE the derivation lives rather than waved
-- away: the code vocabulary and its classification are HERE, in the fault
-- artifact, and `dst_generator` — which chooses the code — imports them rather
-- than restating them. There is exactly one list. A generator that could invent
-- its own code string is the version of B the objection is actually about, and
-- it is not the version built.
--
-- It is also the more faithful model. Retryability at a real provider boundary
-- IS a function of what went wrong: `recovery.ail` says so in as many words —
-- retryable is "transient: timeout / connection / rate-limit / 5xx" and
-- non-retryable is "ProtocolError, ContextLength, SchemaValidation". A separate
-- bool would let a scripted world serve `E_PROVIDER_CONTEXT_LENGTH` marked
-- retryable, which no provider can do, and nothing would go red.
--
-- THE FAIL-SAFE DIRECTION IS DELIBERATE. An unrecognised code classifies as
-- NON-retryable: a world that does not know whether an error is transient must
-- not manufacture a retry. That is also the direction a gate can see — an
-- unknown code silently classified retryable would reach the retry branch and
-- look like coverage, where the fail-safe direction leaves
-- `provider_error_retryable` UNREACHED and turns `make corpus_pr` red, because
-- `expected_bank_coverage()` now demands it.
export pure func provider_error_codes_retryable() -> [string] {
  ["E_PROVIDER_TIMEOUT", "E_PROVIDER_RATE_LIMIT", "E_PROVIDER_UNAVAILABLE"]
}

export pure func provider_error_codes_non_retryable() -> [string] {
  ["E_PROVIDER_PROTOCOL", "E_PROVIDER_CONTEXT_LENGTH", "E_PROVIDER_SCHEMA"]
}

export pure func provider_error_is_retryable(code: string) -> bool {
  contains_code(provider_error_codes_retryable(), code)
}

pure func contains_code(xs: [string], code: string) -> bool {
  match xs { [] => false, x :: rest => if x == code then true else contains_code(rest, code) }
}

-- The class id a served provider fault is RECORDED under, derived from the two
-- quantities that decide it and from nothing else.
--
-- `chunks_played` is why this is one function rather than two. D3's
-- `provider_partial_stream_then_error` is "a partial stream FOLLOWED BY an
-- error", so a faulted exchange that played emissions before failing is that
-- class and not the plain error class — its accompanying AIError still decides
-- the retry-or-finalize transition, exactly as the catalogue row says, but a
-- `TimedOutcome` carries ONE `fault_class_id` and the partial-stream fact is
-- the one that would otherwise be unobservable. A blank code is not a fault and
-- returns "", which is what stage 1's validator requires of an `OutcomeOk`.
export pure func provider_fault_class_id(code: string, chunks_played: int) -> string {
  if code == "" then ""
  else if chunks_played > 0 then fault_class_provider_partial_stream_then_error()
  else if provider_error_is_retryable(code) then fault_class_provider_error_retryable()
  else fault_class_provider_error_non_retryable()
}

-- ============================================================================
-- The artifact's shape
-- ============================================================================

export type FaultBoundary
  = ProviderBoundary
  | ToolBoundary
  | ApprovalBoundary
  | ExtensionEffectBoundary

export pure func boundary_id(b: FaultBoundary) -> string {
  match b {
    ProviderBoundary => "provider",
    ToolBoundary => "tool",
    ApprovalBoundary => "approval",
    ExtensionEffectBoundary => "extension_effect"
  }
}

-- D3: two of the required classes are conditional, and when a profile does not
-- exercise them the run report and the profile definition must NAME the waived
-- class and the condition that waived it. An unstated waiver is a coverage claim
-- this decision does not grant — so the condition is a field, not a comment.
export type Applicability
  = AlwaysApplicable
  | ConditionalOn(string)

-- The named production branch the class is intended to reach.
--
-- `NoReachableBranch` exists because D3 requires a named branch per class and
-- the honest answer for one required class is that there is not one. A class
-- with nowhere to point is a coverage gap worth more than a placeholder, so the
-- artifact can say it — but only for a CONDITIONAL class, and only with a
-- reason. `validate_catalogue` rejects an AlwaysApplicable class that claims it:
-- an unconditional class must point somewhere.
export type RecoveryBranch
  = Branch(string)
  | NoReachableBranch(string)

export pure func branch_id(r: RecoveryBranch) -> string {
  match r {
    Branch(b) => b,
    NoReachableBranch(_) => "<none>"
  }
}

-- 034 W1.5 (ADR-001 D4): who may see the class id. `Wire` is every class D3's
-- table names: its id is what the model is shown (the three tool ids inside
-- `fault_class`) or names an observation the model can make. `WorldOnly(twin)`
-- is a class the model must NOT be able to tell apart from its wire twin: it is
-- delivered as the twin, by the twin's constructor, to the twin's branch, and
-- differs only in world truth the harness holds. Every row carries the field,
-- so all rows keep one shape; a field on the two world-only rows alone would be
-- the per-row shape change D4 rejects.
export type Visibility
  = Wire
  | WorldOnly(string)

export pure func visibility_id(v: Visibility) -> string
  ensures { result != "" }
{
  match v {
    Wire => "wire",
    WorldOnly(_) => "world_only"
  }
}

-- One row. The five fields are exactly D3's: a stable class id; the
-- applicability condition if the class is conditional; the production result or
-- error constructor it is delivered as; the named recovery-branch id it is
-- intended to reach; and its logical-state transition.
--
-- The logical transition is not decorative. D3: "Write-like tool faults specify
-- whether the all-or-nothing logical update occurred; server-drop faults update
-- availability for subsequent calls; deadline outcomes specify whether work
-- completed before or after the observation." Timeout may not leave the
-- simulator's logical state ambiguous, so every row says what happened.
--
-- 034 W1.5 adds a sixth field, `visibility` (above), outside D3's five.
export type FaultClass = {
  class_id: string,
  boundary: FaultBoundary,
  applicability: Applicability,
  delivery_constructor: string,
  recovery_branch: RecoveryBranch,
  logical_transition: string,
  visibility: Visibility
}

-- ============================================================================
-- The required set. D3's table, transcribed.
-- ============================================================================
--
-- Set completeness is the load-bearing check: every downstream counter (D11's
-- class-reached and branch-reached counters, WI-A14) reads its ids from this
-- artifact and therefore cannot discover a class the artifact omits. A
-- catalogue missing a class is not a smaller catalogue, it is a silent coverage
-- claim. So the required ids are listed independently of the rows and the
-- validator checks the rows against them — an empty catalogue must fail, and it
-- does.
export pure func required_class_ids() -> [string] {
  [-- Provider: retryable AIError, non-retryable AIError, protocol-inconsistent
   -- typed result, partial stream followed by error, empty terminal response
   "provider_error_retryable",
   "provider_error_non_retryable",
   "provider_protocol_inconsistent_result",
   "provider_partial_stream_then_error",
   "provider_empty_terminal_response",
   -- Tool: typed execution error, protocol-inconsistent result, completion
   -- after the declared deadline. Ids adopted from the live wire surface.
   "ToolFailed",
   "ToolCorrelationMismatch",
   "ToolDeadlineExceeded",
   -- 034 W1.5, ADR-001 D4: the tool's update DID occur, then the same fault
   -- was delivered. World-only; never on the wire.
   "tool_effect_applied_then_failed",
   "tool_effect_applied_then_deadline",
   -- Approval: explicit denial, and no response before a declared deadline
   "approval_denied",
   "approval_deadline_exceeded",
   -- Conformant extension effect
   "extension_effect_fault"]
}

-- The production constructors a row may name. D3 requires the validator to fail
-- closed on a row "naming an unknown constructor"; without an enumeration that
-- check cannot exist, because any string would be acceptable.
export pure func known_constructors() -> [string] {
  ["AIError",
   "StepResult",
   "ProviderExchange",
   "ToolCall.arguments",
   "ToolCompleted",
   "ToolFailed",
   "ToolCorrelationMismatch",
   "ToolDeadlineExceeded",
   "ApprovalAllowed",
   "ApprovalDenied",
   "ExtPorts.ai_step"]
}

-- ============================================================================
-- The catalogue
-- ============================================================================

export pure func fault_catalogue() -> [FaultClass] {
  [
    -- ---- Provider boundary ------------------------------------------------
    {
      class_id: "provider_error_retryable",
      boundary: ProviderBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "AIError",
      recovery_branch: Branch("session.c2_loop/stream_error_retry"),
      logical_transition: "No assistant message is appended and totals are unchanged; step_idx advances by one and the world advances to exchange.next_state, so the retry consumes step budget. Availability for subsequent calls is unchanged — the retry re-sends the same payload.",
      visibility: Wire
    },
    {
      class_id: "provider_error_non_retryable",
      boundary: ProviderBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "AIError",
      recovery_branch: Branch("session.c2_loop/provider_failure_finalize"),
      logical_transition: "Terminal. No assistant message is appended; the run finalizes as TermProviderFailure with the provider's message, and the returned outcome is Err. The provider is unavailable for the remainder of this run by construction — there is no remainder.",
      visibility: Wire
    },
    {
      class_id: "provider_protocol_inconsistent_result",
      boundary: ProviderBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "ToolCall.arguments",
      recovery_branch: Branch("tool_dispatch_adapter.tool_call_to_envelope/malformed_arguments"),
      logical_transition: "No logical update occurs for the malformed call: the arguments degrade to an empty JSON object and the per-tool argument extraction reports missing fields back to the model, so the loop continues with a tool-role error message. Delivered through the TYPED provider boundary, so it exercises session validation and claims no wire-parser coverage (D3).",
      visibility: Wire
    },
    {
      class_id: "provider_partial_stream_then_error",
      boundary: ProviderBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "ProviderExchange",
      recovery_branch: Branch("session.c2_loop/stream_error_retry"),
      logical_transition: "The emissions preceding the error were already projected to the wire during the callback, so the logical obligation is D6.4 PARITY rather than a state change: the projected sequence and the returned emission log must match in order and content. The retry or finalize transition is the one the accompanying AIError's class specifies.",
      visibility: Wire
    },
    {
      class_id: "provider_empty_terminal_response",
      boundary: ProviderBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "StepResult",
      recovery_branch: Branch("session.c2_loop/empty_stop_finalize"),
      logical_transition: "Terminal, and NOT an error: an EmptyStopFinalize record is appended to the returned trace and projected, then the run finalizes as TermSuccess with an empty output. The history is unchanged beyond the empty assistant turn.",
      visibility: Wire
    },

    -- ---- Tool boundary ----------------------------------------------------
    {
      class_id: "ToolFailed",
      boundary: ToolBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "ToolFailed",
      recovery_branch: Branch("tool_phase.tool_outcome_message/ToolFailed"),
      logical_transition: "The tool's all-or-nothing logical update did NOT occur — ports.world_tool returns the fault instead of reaching the dispatcher. The typed fault is rendered into a tool-role message carrying fault_class, code and message, and the loop continues; the model, not the driver, decides how to react.",
      visibility: Wire
    },
    {
      class_id: "ToolCorrelationMismatch",
      boundary: ToolBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "ToolCorrelationMismatch",
      recovery_branch: Branch("tool_phase.tool_outcome_message/ToolCorrelationMismatch"),
      logical_transition: "No logical update occurs, and none is recorded against the REQUESTED call either: the world answered an id nobody asked for, so the requested call has no result. Checked before the deadline and before the code, so a misaddressed answer is never mistaken for a late or failed one.",
      visibility: Wire
    },
    {
      class_id: "ToolDeadlineExceeded",
      boundary: ToolBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "ToolDeadlineExceeded",
      recovery_branch: Branch("tool_phase.tool_outcome_message/ToolDeadlineExceeded"),
      logical_transition: "The work did NOT complete before the observation — unambiguously, which is what D3 requires of a deadline outcome. ports.world_tool advances the virtual clock by the scripted duration and returns the fault WITHOUT reaching the dispatcher, so no logical update occurred. Enabling this class needs a positive MOTOKO_TOOL_TIMEOUT_MS, which the deterministic world supplies through the env class, so any profile can enable it and it is not conditional on anything outside the world.",
      visibility: Wire
    },

    -- ---- Tool boundary, world-only (034 W1.5, ADR-001 D4) ------------------
    --
    -- Each copies its twin's delivery constructor and recovery branch, and
    -- `validate_catalogue` holds it to that: the model receives exactly the
    -- twin's bytes, so the production branch the class reaches is the twin's.
    -- What differs is the world, and only the harness can see it: `applied` on
    -- the `ScriptedTool` and the entry `ports.world_tool` appends to
    -- `WorldState.effect_log`.
    {
      class_id: "tool_effect_applied_then_failed",
      boundary: ToolBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "ToolFailed",
      recovery_branch: Branch("tool_phase.tool_outcome_message/ToolFailed"),
      logical_transition: "The tool's all-or-nothing logical update DID occur — ports.world_tool appends the call to WorldState.effect_log because the scripted entry has `applied` set — and the outcome then delivered is a ToolFailed BYTE-IDENTICAL to the ToolFailed class's: same constructor, same code and message, same rendered tool-role message, same recovery branch. The model cannot tell the two apart and must not be able to, so this id never reaches the wire. Only an after-dispatch fault can be applied; `applied` on a before-dispatch fault is rejected at replay.",
      visibility: WorldOnly("ToolFailed")
    },
    {
      class_id: "tool_effect_applied_then_deadline",
      boundary: ToolBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "ToolDeadlineExceeded",
      recovery_branch: Branch("tool_phase.tool_outcome_message/ToolDeadlineExceeded"),
      logical_transition: "The tool's work DID complete and its logical update DID occur — ports.world_tool appends the call to WorldState.effect_log because the scripted entry has `applied` set — but after the observation: the virtual clock advances by the scripted duration and the outcome delivered is a ToolDeadlineExceeded BYTE-IDENTICAL to the ToolDeadlineExceeded class's: same constructor, same elapsed and timeout, same rendered tool-role message, same recovery branch. The model cannot tell the two apart and must not be able to, so this id never reaches the wire.",
      visibility: WorldOnly("ToolDeadlineExceeded")
    },

    -- ---- Approval boundary -------------------------------------------------
    {
      class_id: "approval_denied",
      boundary: ApprovalBoundary,
      applicability: AlwaysApplicable,
      delivery_constructor: "ApprovalDenied",
      recovery_branch: Branch("session.c2_loop/approval_denied"),
      logical_transition: "No tool executes, so no logical update occurs. A NativeToolDenied record is projected and a denial message is appended to the accumulated tool batch; the loop continues with the remaining calls in the plan.",
      visibility: Wire
    },
    {
      class_id: "approval_deadline_exceeded",
      boundary: ApprovalBoundary,
      applicability: ConditionalOn("the production approval policy declares a deadline AND the request's default_allow is false; with default_allow true the same input resolves to ApprovalAllowed and the class is not exercised"),
      delivery_constructor: "ApprovalDenied",
      recovery_branch: Branch("tool_phase.resolve_approval/eof"),
      logical_transition: "No tool executes and no logical update occurs; the request resolves to the policy default. NOTE: no production policy declares a CLOCK-DRIVEN approval deadline today. The only reachable branch is channel closure, which resolve_approval itself reports as \"timeout — no approval received\". A profile claiming this class covers a timed deadline would be over-claiming — see catalogue_coverage_gaps().",
      visibility: Wire
    },

    -- ---- Conformant extension effect --------------------------------------
    {
      class_id: "extension_effect_fault",
      boundary: ExtensionEffectBoundary,
      applicability: ConditionalOn("the selected D5 profile installs an extension with an effectful hook that issues this world request; driver_only installs none, so it waives this class by construction (plan P4)"),
      delivery_constructor: "ExtPorts.ai_step",
      recovery_branch: Branch("compaction_ai.compact_with_ai/summarizer_failed"),
      logical_transition: "REWRITTEN AT WI-B4, and the previous text was false rather than merely stale. It said session.ext_ai_step \"hands the port a FRESH EMPTY world (empty_world_state())\", so the empty script served terminal_step() and the extension was told the model answered — no fault, no transition, no branch. WI-B2b removed both halves of that. ext_ports_of's ai_step closure now decodes ctx.world (token_to_world) and hands the DRIVER's world to Ports.model_step, and ScriptedStep gained error_code/error_message, so a scripted entry can serve Err at this seam — before B2b, stub_step's world provider wrapped every entry in Ok(...) and the provider_error_* classes had no scripted delivery at all. The transition is now specified: a faulted script entry produces Err(\"code: message\") in AiStepOutcome.result, the successor world advances past the consumed entry via AiStepOutcome.next_state, and the extension's own recovery is reachable — summarize_attempt retries, exhausts, and compact_with_ai emits PassThroughObserved(\"compaction_ai.summarizer_failed\") at compaction_ai.ail:514. The class stays WAIVED by driver_only, and that is applicability rather than reachability: driver_only installs no extension, and per src/core/dst_driver_only.ail's header NO extension is installable under D5 on declared effect rows while on_budget_plan carries the ABI's closed ! {Env, FS} row. SECOND CLAUSE SUPERSEDED AT WI-D6 (2026-08-06), FIRST CLAUSE UNCHANGED, and the split is the point: D6 narrowed that ABI row after measuring all fifteen on_budget_plan bindings, so the sentence about on_budget_plan's closed row is no longer true. CORRECTED AT WI-D7 (2026-08-06), AND THE CORRECTION IS TO THE SENTENCE THAT FOLLOWED IT HERE. This reason used to continue \"so an extension IS now installable\", and that does not follow: on_budget_plan was ONE of FOUR unconditionally-dispatched slots and D5 forbids installing an extension with any of them excluded. WI-D7 measured the other three across all fifteen bindings each — on_pre_step is refused by compaction_ai (reached through ExtPorts.ai_step; WI-D7 recorded this as 'the full ten effects' and WI-D8 measured the port and found THREE — AI, IO, Trace, which is exactly Ports.model_step's row — so the slot narrowed to match and the barrier did NOT move, because a non-empty row fails criterion 1 at three effects as it did at ten), on_response_intercept by compose (Clock, FS, IO, Process on the inline path), on_solver_candidate by context_mode (Process, a node bridge spawned fire-and-forget) — and all three still declare non-empty rows, so all three still fail criterion 1 and NO EXTENSION IS INSTALLABLE. The WAIVER is unaffected either way, because it never rested on any of this — it rests on driver_only installing no extension, which is still the case. AND THE CONCENTRATION D6 RECORDED HERE DID NOT HAPPEN: D6 wrote that the waiver went from doubly secured (the profile's emptiness AND the ABI) to secured by the first alone, which was true only under the wrong installability conclusion. Both reasons still stand. Per plan rule S21 this item re-asked and found the count UNCHANGED rather than concentrated, which is the rule working rather than the rule finding nothing. So the branch exists and this profile does not walk it — which is a different sentence from the one that used to be here, and the difference is the whole point of D1's rule now having an instrument behind it.",
      visibility: Wire
    }
  ]
}

-- ============================================================================
-- Coverage gaps: machine-readable, because a gap recorded as a comment is a
-- gap nothing can report
-- ============================================================================

export type CoverageGap = { class_id: string, form: string, why: string }

export pure func catalogue_coverage_gaps() -> [CoverageGap] {
  [
    {
      class_id: "provider_protocol_inconsistent_result",
      form: "an internally inconsistent StepResult, as opposed to a malformed ToolCall.arguments string",
      why: "Nothing validates a returned StepResult for internal consistency. model_phase.phase_from_result projects it into a ProviderResult event without checking it, so a result whose finish_reason disagrees with its tool_calls, or which repeats a tool-call id, reaches the loop unremarked. D3 names both forms; only the arguments form has a reachable production branch."
    },
    {
      class_id: "provider_partial_stream_then_error",
      form: "an ADVERSARIAL partial stream: emissions whose content the driver has begun to act on before the error arrives",
      why: "CLOSED AT WI-D1 IN THE FORM THIS ENTRY DESCRIBED, and the entry is rewritten rather than deleted because the residue is real. What it said was: `a seeded run cannot produce a stream that fails PART-WAY, because ScriptedStep has no error channel, so parity is exercised on completed streams only`. THE CLAUSE AFTER `because` HAD BEEN FALSE SINCE WI-B2b, which added error_code/error_message to ScriptedStep; this is the sixth artifact found carrying that clause and the only one no handoff named. What was actually missing was that stub_step's two scripted model_step closures wrapped every entry in Ok(...), so nothing could serve Err on the core Ports.model_step path. WI-D1 built that branch: a faulted entry plays its chunks and THEN returns Err, so a seeded run produces a stream that fails part-way, and the class is reached by 91 of 260 swept seeds with two witnesses in the fixed bank. WHAT REMAINS is narrower again and is not a field: the generated partial stream is a PREFIX of a well-formed one, so the driver consumes chunks it would have consumed anyway. A stream whose emissions are internally inconsistent before the error — a tool-call delta the error then contradicts — has no generator and would need one; it is the streaming form of the inconsistency the provider_protocol_inconsistent_result gap above describes for a completed result."
    },
    {
      class_id: "approval_deadline_exceeded",
      form: "a CLOCK-DRIVEN approval deadline",
      why: "No production policy declares one. resolve_approval's only no-response branch is end-of-input, which it labels \"timeout\" but which is channel closure, not elapsed virtual time. D3's class is conditional on the deadline being enabled by production policy, so every profile waives it today — but with the condition named, per D3, rather than silently."
    },
    {
      class_id: "extension_effect_fault",
      form: "every world-request class reached through ExtPorts OTHER than the provider fault, which WI-B2b closed",
      why: "NARROWED AT WI-B4. The ai_step half of this gap is gone: the seam threads the driver's world and a faulted ScriptedStep now delivers Err through AiStepOutcome.result, so the provider-fault class has a real delivery and a real recovery branch. What remains is the other two seams, and both are still genuine. NARROWED AGAIN AT WI-C5: the clock half is also gone. `ExtPorts.clock_now` was widened to take and return the world token, so `ext_ports_of` routes it through `Ports.clock_now` and a scripted world drives the extension clock. ExtPorts.tool_handle IS routed but projects the typed tool outcome back down to a string, so an extension can observe that a tool failed and not which fault class it was — WI-C5 owns widening it, and it is deliberately left as a live classifier-2 member so C5 keeps a real target. NARROWED A THIRD TIME AT WI-D23, and the sentence before this one is now half true, which half matters: `ExtProcOutcome.exit_code` exists and the bridge fills it from the typed outcome, so an extension CAN now observe that a subprocess failed — and with what code — without parsing a string. What it still cannot observe is WHICH FAULT CLASS a non-completed outcome was: ToolFailed's D3 code, a correlation mismatch's two ids and a deadline's two times all cross the ABI rendered into `output`'s fault text, projected to exit_code -1. The four-variant discrimination is the residue — a further widening on D1's part-3 typed-fault ground, separate from the exit code's, exactly as the ExtProcOutcome type note has said since WI-D16."
    }
  ]
}

-- ============================================================================
-- 007 D1.3's physical-fault tripwire, carried verbatim rather than paraphrased
-- ============================================================================
--
-- D3 excludes torn/partial physical writes from scope and binds that exclusion
-- to accepted 007 D1.3, carrying its triggers VERBATIM. Any one of these gives
-- Motoko a physical durability contract it does not have today, and the moment
-- it has one the physical-fault exclusion stops being a scope decision and
-- becomes an untested gap. `make fault_catalogue` greps the tree for the
-- machine-checkable ones.
export pure func physical_fault_reopen_triggers() -> [string] {
  ["crash-recovery", "fsync", "WAL", "resume-from-ledger", "replicated-state"]
}

-- ============================================================================
-- The validator. Fails closed on row shape AND on set completeness.
-- ============================================================================

export type CatalogueRejection
  = MissingRequiredClass(string)
  | UnknownClassId(string)
  | DuplicateClassId(string)
  | EmptyField(string, string)
  | UnknownConstructor(string, string)
  | ConditionalWithoutCondition(string)
  | UnconditionalWithoutBranch(string)
  -- 034 W1.5, ADR-001 D4: a world-only row against its twin. Each is
  -- (class id, twin id).
  | WorldOnlyTwinMissing(string, string)
  | WorldOnlyTwinWorldOnly(string, string)
  | WorldOnlyTwinConstructorDiffers(string, string)
  | WorldOnlyTwinBranchDiffers(string, string)

export pure func catalogue_rule(r: CatalogueRejection) -> string {
  match r {
    MissingRequiredClass(_) => "required-class-missing",
    UnknownClassId(_) => "unknown-class-id",
    DuplicateClassId(_) => "duplicate-class-id",
    EmptyField(_, _) => "row-field-empty",
    UnknownConstructor(_, _) => "unknown-constructor",
    ConditionalWithoutCondition(_) => "conditional-without-condition",
    UnconditionalWithoutBranch(_) => "unconditional-without-branch",
    WorldOnlyTwinMissing(_, _) => "world-only-twin-missing",
    WorldOnlyTwinWorldOnly(_, _) => "world-only-twin-world-only",
    WorldOnlyTwinConstructorDiffers(_, _) => "world-only-twin-constructor-differs",
    WorldOnlyTwinBranchDiffers(_, _) => "world-only-twin-branch-differs"
  }
}

export pure func catalogue_message(r: CatalogueRejection) -> string {
  match r {
    MissingRequiredClass(c) =>
      "[required-class-missing] D3 requires class '${c}' and the catalogue does not carry it; every downstream counter reads its ids from here and cannot discover a class this artifact omits",
    UnknownClassId(c) =>
      "[unknown-class-id] class '${c}' is not in D3's required set; growing the catalogue is allowed, but the required list must be extended in the same change so set completeness stays decidable",
    DuplicateClassId(c) =>
      "[duplicate-class-id] class '${c}' appears more than once",
    EmptyField(c, f) =>
      "[row-field-empty] class '${c}' leaves required field '${f}' empty",
    UnknownConstructor(c, k) =>
      "[unknown-constructor] class '${c}' names delivery constructor '${k}', which is not a known production constructor",
    ConditionalWithoutCondition(c) =>
      "[conditional-without-condition] class '${c}' is conditional but states no waiving condition; an unstated waiver is a coverage claim D3 does not grant",
    UnconditionalWithoutBranch(c) =>
      "[unconditional-without-branch] class '${c}' is unconditionally applicable but names no reachable recovery branch; a decorative fault that cannot influence the production session does not satisfy D3",
    WorldOnlyTwinMissing(c, t) =>
      "[world-only-twin-missing] world-only class '${c}' names twin '${t}', which is not a row of this catalogue; a world-only class is delivered AS its twin, so without one it has no delivery at all (ADR-001 D4)",
    WorldOnlyTwinWorldOnly(c, t) =>
      "[world-only-twin-world-only] world-only class '${c}' names twin '${t}', which is itself world-only; the twin is the class the model sees, so it must be a wire class (ADR-001 D4)",
    WorldOnlyTwinConstructorDiffers(c, t) =>
      "[world-only-twin-constructor-differs] world-only class '${c}' names a delivery constructor different from its twin '${t}''s; a world-only class must reach the model as its twin's bytes, so the constructor is the twin's (ADR-001 D4)",
    WorldOnlyTwinBranchDiffers(c, t) =>
      "[world-only-twin-branch-differs] world-only class '${c}' names a recovery branch different from its twin '${t}''s; the model receives the twin's bytes, so the branch they reach is the twin's (ADR-001 D4)"
  }
}

pure func contains_str(xs: [string], target: string) -> bool {
  match xs {
    [] => false,
    x :: rest => if x == target then true else contains_str(rest, target)
  }
}

pure func class_ids(rows: [FaultClass]) -> [string] {
  match rows {
    [] => [],
    r :: rest => r.class_id :: class_ids(rest)
  }
}

pure func count_str(xs: [string], target: string) -> int {
  match xs {
    [] => 0,
    x :: rest => (if x == target then 1 else 0) + count_str(rest, target)
  }
}

-- Row shape: every field D3 fixes must be present, the constructor must be one
-- the production code actually has, a conditional class must carry its
-- condition, and an unconditional class must point at a branch.
pure func validate_row(r: FaultClass) -> [CatalogueRejection] {
  let id_empty = if r.class_id == "" then [EmptyField("<anonymous>", "class_id")] else [];
  let ctor_empty =
    if r.delivery_constructor == "" then [EmptyField(r.class_id, "delivery_constructor")] else [];
  let ctor_known =
    if r.delivery_constructor != "" && not contains_str(known_constructors(), r.delivery_constructor)
    then [UnknownConstructor(r.class_id, r.delivery_constructor)] else [];
  let transition_empty =
    if r.logical_transition == "" then [EmptyField(r.class_id, "logical_transition")] else [];
  let branch_empty = match r.recovery_branch {
    Branch(b) => if b == "" then [EmptyField(r.class_id, "recovery_branch")] else [],
    NoReachableBranch(why) => if why == "" then [EmptyField(r.class_id, "recovery_branch")] else []
  };
  let condition = match r.applicability {
    AlwaysApplicable =>
      match r.recovery_branch {
        NoReachableBranch(_) => [UnconditionalWithoutBranch(r.class_id)],
        Branch(_) => []
      },
    ConditionalOn(c) => if c == "" then [ConditionalWithoutCondition(r.class_id)] else []
  };
  let twin_empty = match r.visibility {
    Wire => [],
    WorldOnly(t) => if t == "" then [EmptyField(r.class_id, "visibility")] else []
  };
  id_empty ++ ctor_empty ++ ctor_known ++ transition_empty ++ branch_empty ++ condition ++ twin_empty
}

-- 034 W1.5, ADR-001 D4: a world-only row is delivered AS its twin, so the twin
-- must be a row, must be a wire class, and must have the same delivery
-- constructor and the same recovery branch. Checked against the WHOLE row set,
-- not the row alone, which is why it is not in `validate_row`. A blank twin id
-- is `validate_row`'s `row-field-empty`, and is not reported again here as a
-- missing twin.
-- contracts: BLOCKED — RECURSIVE over the rows.
pure func validate_twins(rows: [FaultClass], each: [FaultClass]) -> [CatalogueRejection] {
  match each {
    [] => [],
    r :: rest => twin_rejections(rows, r) ++ validate_twins(rows, rest)
  }
}

-- contracts: BLOCKED — calls `find_class`, RECURSIVE over the rows.
pure func twin_rejections(rows: [FaultClass], r: FaultClass) -> [CatalogueRejection] {
  match r.visibility {
    Wire => [],
    WorldOnly(t) =>
      if t == "" then []
      else match find_class(rows, t) {
        None => [WorldOnlyTwinMissing(r.class_id, t)],
        Some(twin) => {
          let world_only = match twin.visibility {
            Wire => [],
            WorldOnly(_) => [WorldOnlyTwinWorldOnly(r.class_id, t)]
          };
          let ctor =
            if twin.delivery_constructor == r.delivery_constructor then []
            else [WorldOnlyTwinConstructorDiffers(r.class_id, t)];
          let branch =
            if same_branch(twin.recovery_branch, r.recovery_branch) then []
            else [WorldOnlyTwinBranchDiffers(r.class_id, t)];
          world_only ++ ctor ++ branch
        }
      }
  }
}

-- Two branches are the same when they are the same arm with the same text.
pure func same_branch(a: RecoveryBranch, b: RecoveryBranch) -> bool
  ensures { result == false || branch_id(a) == branch_id(b) }
{
  match a {
    Branch(x) => match b { Branch(y) => x == y, NoReachableBranch(_) => false },
    NoReachableBranch(x) => match b { NoReachableBranch(y) => x == y, Branch(_) => false }
  }
}

pure func validate_rows(rows: [FaultClass]) -> [CatalogueRejection] {
  match rows {
    [] => [],
    r :: rest => validate_row(r) ++ validate_rows(rest)
  }
}

-- Set completeness in BOTH directions. Missing a required class is the
-- dangerous one; carrying an id outside the required set is caught too, because
-- growing the catalogue without extending the required list would make the
-- completeness check quietly weaker on the next change.
pure func missing_classes(present: [string], required: [string]) -> [CatalogueRejection] {
  match required {
    [] => [],
    c :: rest =>
      (if contains_str(present, c) then [] else [MissingRequiredClass(c)])
        ++ missing_classes(present, rest)
  }
}

pure func extra_and_duplicate_classes(present: [string], seen: [string]) -> [CatalogueRejection] {
  match present {
    [] => [],
    c :: rest => {
      let unknown =
        if contains_str(required_class_ids(), c) then [] else [UnknownClassId(c)];
      let dup = if contains_str(seen, c) then [DuplicateClassId(c)] else [];
      unknown ++ dup ++ extra_and_duplicate_classes(rest, c :: seen)
    }
  }
}

export pure func validate_catalogue(rows: [FaultClass]) -> [CatalogueRejection] {
  let ids = class_ids(rows);
  validate_rows(rows)
    ++ validate_twins(rows, rows)
    ++ missing_classes(ids, required_class_ids())
    ++ extra_and_duplicate_classes(ids, [])
}

export pure func catalogue_ok(rows: [FaultClass]) -> bool {
  List.length(validate_catalogue(rows)) == 0
}

-- ============================================================================
-- Lookup, for WI-A10's waiver list and WI-A14's counters
-- ============================================================================

export pure func find_class(rows: [FaultClass], class_id: string) -> Option[FaultClass] {
  match rows {
    [] => None,
    r :: rest => if r.class_id == class_id then Some(r) else find_class(rest, class_id)
  }
}

-- The classes a profile must name as waived if it does not exercise them, each
-- with the condition that waives it. P4's `driver_only` waives both.
export pure func conditional_class_ids(rows: [FaultClass]) -> [string] {
  match rows {
    [] => [],
    r :: rest =>
      match r.applicability {
        ConditionalOn(_) => r.class_id :: conditional_class_ids(rest),
        AlwaysApplicable => conditional_class_ids(rest)
      }
  }
}

export pure func waiving_condition(rows: [FaultClass], class_id: string) -> Option[string] {
  match find_class(rows, class_id) {
    None => None,
    Some(r) => match r.applicability {
      ConditionalOn(c) => Some(c),
      AlwaysApplicable => None
    }
  }
}

-- 034 W1.5: the ids no projected tool message may contain (standing rule 6),
-- read off the rows rather than listed, so a third world-only row joins the
-- guard by being written.
-- contracts: BLOCKED — RECURSIVE over the rows.
export pure func world_only_class_ids(rows: [FaultClass]) -> [string] {
  match rows {
    [] => [],
    r :: rest =>
      match r.visibility {
        WorldOnly(_) => r.class_id :: world_only_class_ids(rest),
        Wire => world_only_class_ids(rest)
      }
  }
}

-- The ids of `ids` that occur anywhere in `text`. LEXICAL on purpose: the guard
-- does not parse the message, so a world-only id in any field, or in prose,
-- is a hit.
-- contracts: BLOCKED — RECURSIVE over the ids.
export pure func ids_occurring_in(text: string, ids: [string]) -> [string] {
  match ids {
    [] => [],
    i :: rest => (if contains(text, i) then [i] else []) ++ ids_occurring_in(text, rest)
  }
}

-- ============================================================================
-- Inline tests
-- ============================================================================

pure func has_rule(rs: [CatalogueRejection], rule: string) -> bool {
  match rs {
    [] => false,
    r :: rest => if catalogue_rule(r) == rule then true else has_rule(rest, rule)
  }
}

pure func ok_row(id: string) -> FaultClass {
  {
    class_id: id,
    boundary: ProviderBoundary,
    applicability: AlwaysApplicable,
    delivery_constructor: "AIError",
    recovery_branch: Branch("session.c2_loop/stream_error_retry"),
    logical_transition: "t",
    visibility: Wire
  }
}

pure func test_shipped_catalogue_validates() -> bool
  tests [((), true)]
  {
    catalogue_ok(fault_catalogue())
      && List.length(fault_catalogue()) == List.length(required_class_ids())
  }

-- SET COMPLETENESS. An empty catalogue must fail — it is the limiting case of
-- a catalogue that is well-formed row-by-row (vacuously) while claiming
-- coverage of nothing.
pure func test_empty_catalogue_fails() -> bool
  tests [((), true)]
  {
    let rs = validate_catalogue([]);
    not catalogue_ok([])
      && has_rule(rs, "required-class-missing")
      && List.length(rs) == List.length(required_class_ids())
  }

-- The sharper set-completeness case: every remaining row is perfect, so every
-- row-shape check passes, and one required class is simply absent.
pure func test_catalogue_missing_one_class_fails() -> bool
  tests [((), true)]
  {
    let short = drop_class(fault_catalogue(), "ToolDeadlineExceeded");
    let rs = validate_catalogue(short);
    List.length(short) == List.length(fault_catalogue()) - 1
      && has_rule(rs, "required-class-missing")
      && not has_rule(rs, "row-field-empty")
  }

pure func drop_class(rows: [FaultClass], id: string) -> [FaultClass] {
  match rows {
    [] => [],
    r :: rest => if r.class_id == id then drop_class(rest, id) else r :: drop_class(rest, id)
  }
}

pure func test_row_missing_a_field_fails() -> bool
  tests [((), true)]
  {
    let bad: FaultClass = { ok_row("provider_error_retryable") | logical_transition: "" };
    has_rule(validate_catalogue([bad]), "row-field-empty")
  }

pure func test_unknown_constructor_fails() -> bool
  tests [((), true)]
  {
    let bad: FaultClass = { ok_row("provider_error_retryable") | delivery_constructor: "NotAConstructor" };
    has_rule(validate_catalogue([bad]), "unknown-constructor")
  }

pure func test_conditional_without_condition_fails() -> bool
  tests [((), true)]
  {
    let bad: FaultClass = { ok_row("provider_error_retryable") | applicability: ConditionalOn("") };
    has_rule(validate_catalogue([bad]), "conditional-without-condition")
  }

-- A decorative fault that cannot influence the production session does not
-- satisfy D3, and "cannot influence" must be decidable by reading the artifact.
pure func test_unconditional_without_branch_fails() -> bool
  tests [((), true)]
  {
    let bad: FaultClass = { ok_row("provider_error_retryable") | recovery_branch: NoReachableBranch("nowhere") };
    has_rule(validate_catalogue([bad]), "unconditional-without-branch")
  }

pure func test_duplicate_class_fails() -> bool
  tests [((), true)]
  {
    has_rule(validate_catalogue([ok_row("provider_error_retryable"), ok_row("provider_error_retryable")]), "duplicate-class-id")
  }

pure func test_unknown_class_fails() -> bool
  tests [((), true)]
  {
    has_rule(validate_catalogue([ok_row("invented_class")]), "unknown-class-id")
  }

-- D3: exactly two of the required classes are conditional, and both must carry
-- their waiving condition so a profile can name it.
pure func test_two_conditional_classes_carry_conditions() -> bool
  tests [((), true)]
  {
    let conds = conditional_class_ids(fault_catalogue());
    List.length(conds) == 2
      && contains_str(conds, "approval_deadline_exceeded")
      && contains_str(conds, "extension_effect_fault")
      && match waiving_condition(fault_catalogue(), "extension_effect_fault") {
           Some(c) => c != "",
           None => false
         }
  }

-- ----------------------------------------------------------------------------
-- 034 W1.5, ADR-001 D4: the world-only rows against their twins. Each rejection
-- row starts from the SHIPPED catalogue, which validates, and changes one field
-- of one world-only row, so the rule named is the only rejection produced:
-- `== 1` is what stops a row being green on another rule's finding. These are
-- 034 PLAN-001 W1.7's v08-v11 targets.
-- ----------------------------------------------------------------------------

pure func replace_row(rows: [FaultClass], r: FaultClass) -> [FaultClass] {
  match rows {
    [] => [],
    x :: rest => (if x.class_id == r.class_id then r else x) :: replace_row(rest, r)
  }
}

pure func applied_failed_row() -> FaultClass {
  match find_class(fault_catalogue(), fault_class_tool_effect_applied_then_failed()) {
    Some(r) => r,
    None => ok_row("<absent>")
  }
}

pure func only_rule(rs: [CatalogueRejection], rule: string) -> bool {
  List.length(rs) == 1 && has_rule(rs, rule)
}

-- The survival case the four below are mutations of: both world-only rows
-- name a wire twin, carry its constructor and branch, and are the only two.
pure func test_the_world_only_rows_copy_their_wire_twins() -> bool
  tests [((), true)]
  {
    let rows = fault_catalogue();
    let wo = world_only_class_ids(rows);
    List.length(wo) == 2
      && contains_str(wo, fault_class_tool_effect_applied_then_failed())
      && contains_str(wo, fault_class_tool_effect_applied_then_deadline())
      && List.length(validate_twins(rows, rows)) == 0
      && match find_class(rows, fault_class_tool_effect_applied_then_failed()) {
           Some(r) => match r.visibility { WorldOnly(t) => t == fault_class_tool_failed(), Wire => false },
           None => false
         }
      && match find_class(rows, fault_class_tool_effect_applied_then_deadline()) {
           Some(r) => match r.visibility { WorldOnly(t) => t == fault_class_tool_deadline_exceeded(), Wire => false },
           None => false
         }
      -- and both are AlwaysApplicable, so the conditional count stays 2
      && List.length(conditional_class_ids(rows)) == 2
  }

-- v08: the twin must exist.
pure func test_world_only_twin_missing_fails() -> bool
  tests [((), true)]
  {
    let bad: FaultClass = { applied_failed_row() | visibility: WorldOnly("no_such_class") };
    only_rule(validate_catalogue(replace_row(fault_catalogue(), bad)), "world-only-twin-missing")
  }

-- v09: the twin must not be world-only. The row names ITSELF, so constructor
-- and branch agree and the world-only rule is the only one that can fire.
pure func test_world_only_twin_that_is_world_only_fails() -> bool
  tests [((), true)]
  {
    let bad: FaultClass = { applied_failed_row() | visibility: WorldOnly(fault_class_tool_effect_applied_then_failed()) };
    only_rule(validate_catalogue(replace_row(fault_catalogue(), bad)), "world-only-twin-world-only")
  }

-- v10: the twin's delivery constructor must match. `ToolCorrelationMismatch` is
-- a known constructor, so `unknown-constructor` stays silent.
pure func test_world_only_twin_constructor_differs_fails() -> bool
  tests [((), true)]
  {
    let bad: FaultClass = { applied_failed_row() | delivery_constructor: "ToolCorrelationMismatch" };
    only_rule(validate_catalogue(replace_row(fault_catalogue(), bad)), "world-only-twin-constructor-differs")
  }

-- v11: the twin's recovery branch must match.
pure func test_world_only_twin_branch_differs_fails() -> bool
  tests [((), true)]
  {
    let bad: FaultClass = { applied_failed_row() | recovery_branch: Branch("tool_phase.tool_outcome_message/ToolCorrelationMismatch") };
    only_rule(validate_catalogue(replace_row(fault_catalogue(), bad)), "world-only-twin-branch-differs")
  }

-- A blank twin id is a row-field-empty, reported once and not again as a
-- missing twin.
pure func test_world_only_blank_twin_is_an_empty_field() -> bool
  tests [((), true)]
  {
    let bad: FaultClass = { applied_failed_row() | visibility: WorldOnly("") };
    only_rule(validate_catalogue(replace_row(fault_catalogue(), bad)), "row-field-empty")
  }

pure func test_ids_occurring_in_is_lexical() -> bool
  tests [((), true)]
  {
    let wo = world_only_class_ids(fault_catalogue());
    List.length(ids_occurring_in("{\"fault_class\":\"ToolFailed\"}", wo)) == 0
      && ids_occurring_in("{\"fault_class\":\"tool_effect_applied_then_failed\"}", wo)
           == [fault_class_tool_effect_applied_then_failed()]
      && List.length(ids_occurring_in("prose naming tool_effect_applied_then_deadline", wo)) == 1
  }

-- The three ids adopted from the live wire surface must remain the strings
-- tool_phase actually emits. If someone renames a class id here, this fails
-- rather than the tree quietly carrying two vocabularies again.
pure func test_tool_class_ids_are_the_wire_names() -> bool
  tests [((), true)]
  {
    let ids = class_ids(fault_catalogue());
    contains_str(ids, fault_class_tool_failed())
      && contains_str(ids, fault_class_tool_correlation_mismatch())
      && contains_str(ids, fault_class_tool_deadline_exceeded())
      && fault_class_tool_failed() == "ToolFailed"
      && fault_class_tool_correlation_mismatch() == "ToolCorrelationMismatch"
      && fault_class_tool_deadline_exceeded() == "ToolDeadlineExceeded"
  }

-- WI-D1. The four provider ids are held to the catalogue the same way, and the
-- code vocabulary is held to the property that makes the derivation sound:
-- the two lists are non-empty and DISJOINT, so no code is both. A code in both
-- lists would make `provider_error_is_retryable` answer by list order, which is
-- a silently wrong answer of exactly the kind this project counts.
pure func test_provider_class_ids_and_the_code_vocabulary() -> bool
  tests [((), true)]
  {
    let ids = class_ids(fault_catalogue());
    contains_str(ids, fault_class_provider_error_retryable())
      && contains_str(ids, fault_class_provider_error_non_retryable())
      && contains_str(ids, fault_class_provider_partial_stream_then_error())
      && contains_str(ids, fault_class_provider_protocol_inconsistent_result())
      && List.length(provider_error_codes_retryable()) > 0
      && List.length(provider_error_codes_non_retryable()) > 0
      && disjoint_codes(provider_error_codes_retryable(), provider_error_codes_non_retryable())
      && all_codes_classify(provider_error_codes_retryable(), true)
      && all_codes_classify(provider_error_codes_non_retryable(), false)
  }

pure func disjoint_codes(a: [string], b: [string]) -> bool {
  match a { [] => true, x :: rest => if contains_code(b, x) then false else disjoint_codes(rest, b) }
}

pure func all_codes_classify(xs: [string], want: bool) -> bool {
  match xs {
    [] => true,
    x :: rest => if provider_error_is_retryable(x) == want then all_codes_classify(rest, want) else false
  }
}

-- The class derivation, asserted on every branch INCLUDING the two that are
-- easy to get silently wrong: an unknown code must be non-retryable (the
-- fail-safe direction), and chunks-then-error must win over the retryability
-- split rather than the other way round. Both alternatives type-check.
pure func test_the_provider_fault_class_derivation() -> bool
  tests [((), true)]
  {
    provider_fault_class_id("", 0) == ""
      && provider_fault_class_id("", 3) == ""
      && provider_fault_class_id("E_PROVIDER_TIMEOUT", 0) == fault_class_provider_error_retryable()
      && provider_fault_class_id("E_PROVIDER_PROTOCOL", 0) == fault_class_provider_error_non_retryable()
      && provider_fault_class_id("E_PROVIDER_TIMEOUT", 2) == fault_class_provider_partial_stream_then_error()
      && provider_fault_class_id("E_PROVIDER_PROTOCOL", 2) == fault_class_provider_partial_stream_then_error()
      -- the fail-safe direction for a code no list names
      && not provider_error_is_retryable("E_NOT_A_DECLARED_CODE")
      && provider_fault_class_id("E_NOT_A_DECLARED_CODE", 0) == fault_class_provider_error_non_retryable()
  }

pure func test_required_ids_are_distinct() -> bool
  tests [((), true)]
  {
    no_duplicates(required_class_ids(), [])
      -- 034 W1.5: 11 -> 13, the two world-only tool rows (ADR-001 D4).
      && List.length(required_class_ids()) == 13
  }

pure func no_duplicates(xs: [string], seen: [string]) -> bool {
  match xs {
    [] => true,
    x :: rest => if contains_str(seen, x) then false else no_duplicates(rest, x :: seen)
  }
}

-- Every gap names a class the catalogue carries. A gap recorded against a class
-- id that does not exist is a gap nobody will find.
pure func test_gaps_reference_real_classes() -> bool
  tests [((), true)]
  {
    List.length(catalogue_coverage_gaps()) > 0 && gaps_resolve(catalogue_coverage_gaps())
  }

pure func gaps_resolve(gs: [CoverageGap]) -> bool {
  match gs {
    [] => true,
    g :: rest =>
      match find_class(fault_catalogue(), g.class_id) {
        None => false,
        Some(_) => if g.why == "" || g.form == "" then false else gaps_resolve(rest)
      }
  }
}

pure func test_reopen_triggers_are_007_d1_3_verbatim() -> bool
  tests [((), true)]
  {
    let t = physical_fault_reopen_triggers();
    List.length(t) == 5
      && contains_str(t, "crash-recovery")
      && contains_str(t, "fsync")
      && contains_str(t, "WAL")
      && contains_str(t, "resume-from-ledger")
      && contains_str(t, "replicated-state")
  }

pure func test_every_class_names_a_boundary() -> bool
  tests [((), true)]
  {
    boundaries_named(fault_catalogue())
  }

pure func boundaries_named(rows: [FaultClass]) -> bool {
  match rows {
    [] => true,
    r :: rest => if boundary_id(r.boundary) == "" then false else boundaries_named(rest)
  }
}
