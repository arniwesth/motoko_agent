-- src/core/ports.ail
--
-- Phase C ports: function-valued seams for nondeterminism. The live driver
-- consumes the model port through the StepProvider compatibility surface while
-- keeping the historical public entrypoints stable.

module src/core/ports

import std/ai (Message, StepResult, ToolCall, AIError, StreamChunk)
import std/list as List (length)
import std/result (Result)
import std/trace as Trace
-- WI-A13 stage 3 needs `decode` and the accessors as well: the recorded
-- provider and tool outcomes are structured projections, and the same module
-- that writes them reads them back. See "the recorded outcome must be
-- sufficient to re-serve the response" below.
import std/json (Json, encode, decode, jo, ja, kv, js, jnum, jb, get, asString, asNumber, asBool, asArray)
-- NOT decoration, and NOT optional. `std/json`'s accessors return `Option`, and
-- without this import `None` and `Some(j)` in a match arm are not constructor
-- patterns — they are FRESH VARIABLE BINDINGS. The first arm then matches
-- everything, the second is unreachable, every field silently reads back as its
-- fallback, and the module type-checks clean with no warning. That is what
-- happened while these codecs were being written, and the round-trip tests
-- below are what caught it; nothing else could have.
import std/option (Option, Some, None)
import src/core/phase_vocab (ApprovalRequest)
import src/core/tool_contract (ToolCallEnvelope)
import src/core/tool_dispatch_adapter (dispatch_one)
-- WI-A13 stage 2. The interaction log rides in `WorldState`, so this module has
-- to name D2's `Interaction`. `src/core/dst_interaction` was split out of
-- `src/core/dst_program` for exactly this: it imports nothing but std, so the
-- production port layer can name the recorded type WITHOUT the 1559-line
-- `dst_profile` closure entering the driver's import graph. See that module's
-- header for why a second, flatter "recorded request" record projected into
-- `Interaction` was rejected.
import src/core/dst_interaction (
  Interaction, CausalIdentity, IdentityBody, TimedOutcome, StreamChunkRecord,
  ToolIdentity, ApprovalIdentity, EnvironmentReadIdentity, ClockAdvanceIdentity,
  OutcomeStatus, OutcomeOk, OutcomeFault, OutcomeMissing
)
-- WI-A13 stage 4. The GENERATOR STATE rides in `WorldState` for exactly the
-- reason the interaction log does: the ports are the only place that sees a
-- request at the moment it is made, and D2 makes each discovery choice a
-- function of the request. `src/core/dst_generator` imports nothing but std for
-- the same reason `dst_interaction` does not — see either module's header.
--
-- Threaded, never captured. A generator state a closure holds is F6 with a
-- different cursor: it serves the same choice forever, nothing crashes, and the
-- programs are perfectly reproducible.
import src/core/dst_generator (
  GeneratorState, GeneratorBounds, ToolFaultChoice,
  ToolChoiceOk, ToolChoiceFailed, ToolChoiceMismatch, ToolChoiceLate,
  no_generator, generator_installed, choose_provider, choose_tool, choose_approval
)
-- A7's class ids are READ, not restated. A10 established the policy and S6
-- measured why it matters: a read binding is free and cannot go stale, while a
-- copied literal is where an item's risk lives. A fault recorded under a class
-- id no catalogue defines is rejected outright by stage 1's validator, so a
-- drifted literal here would surface as a valid run producing an invalid
-- program — the least legible failure available.
import src/core/dst_fault_catalogue (
  fault_class_tool_failed,
  fault_class_tool_correlation_mismatch,
  fault_class_tool_deadline_exceeded,
  -- WI-D1's provider half, read for the same reason and on the same line.
  provider_error_is_retryable, provider_fault_class_id
)

export type ApprovalResolution = ApprovalAllowed | ApprovalDenied(string)

-- A scripted LLM turn: what the "model" returns for one exchange.
--
-- WI-A2 relocated this here from `src/core/test/stub_step.ail`. It has to be
-- declared at or below this module because `WorldState` carries it and both
-- the module declaring the widened port and the driver holding the
-- `C2LoopState` field must name that type. The obvious alternative,
-- `ScriptedPortsState` (`src/core/test/scripted_ports.ail`), cannot be used:
-- that module imports `ports`, `stub_step` AND `session`, so either consumer
-- closes a module cycle, which AILANG rejects (LDR002). Parameterising `Ports`
-- over its state type is not an escape either — the declaration is accepted but
-- instantiation fails unification on the pin. `ScriptedPortsState` and
-- `scripted_model_next` are therefore a design precedent, not reusable code.
export type ScriptedStep = {
  prose: string,
  tool_calls: [ToolCall],
  input_tokens: int,
  output_tokens: int,
  finish_reason: string,
  chunks: [string],

  -- WI-B2b, WIDENING 1 of 2: THE PROVIDER FAULT. An ERROR CASE, and it is a
  -- different change from `advance_ms` below — earlier revisions of the plan
  -- conflated the two with each other and with D4's latency pair.
  --
  -- Until now a scripted step could only ever serve `Ok`: `stub_step`'s world
  -- provider wraps every entry in `Ok(scripted_to_step_result(s))`, so the
  -- provider fault classes the catalogue declares
  -- (`provider_error_retryable`, `provider_error_non_retryable`, …) had no
  -- scripted delivery at all. A non-empty `error_code` makes the entry serve
  -- `Err({code, message})` instead, which is what gives those classes a
  -- deterministic instrument.
  --
  -- Flat `code`/`message` rather than a sum, mirroring `ScriptedTool` directly
  -- above: the two are the provider-side and tool-side halves of the same
  -- scripted-fault idea and a reader should not have to learn two shapes. Empty
  -- `error_code` means "no fault", which keeps every existing entry's meaning.
  error_code: string,
  error_message: string,

  -- WI-B2b, WIDENING 2 of 2: THE PROVIDER LATENCY. Not a fault — how long the
  -- provider TOOK. `ScriptedTool.duration_ms` has always carried this for the
  -- tool side, and `decode_tool_outcome(payload, advance_ms)` already restores
  -- it on replay from `TimedOutcome.advance_ms`. The provider side had no such
  -- field, so `decode_provider_outcome` took no `advance_ms` and a replayed
  -- provider call always took zero virtual time.
  --
  -- Restored the SAME way and for the same reason: the elapsed time is what
  -- actually happened to the clock, so it is read back from the recorded
  -- outcome rather than from the payload. That is why this needs NO codec
  -- change on the wire — `advance_ms` is not written into the provider payload,
  -- it is passed in beside it. See `decode_provider_outcome`.
  advance_ms: int
}

-- The driver's explicit world state, threaded through the ports in and out.
--
-- WI-A12, under ADR-001 D1. This is the type D1 calls `world_state`: the one
-- home for every replay and generator cursor, owned and threaded by the real
-- session driver. WI-A2 introduced it as `ProviderState` carrying the scripted
-- cursor alone, under an explicitly interim name; A12 renames it to what D1
-- always called it and subsumes the interim `C2LoopState.provider_state` field,
-- which is deleted in this same change exactly as D1 requires.
--
-- It is a record and not a sum (plan decision P1): a reviewer's probe on the
-- pin widened a state already used in a cross-module port signature and the
-- port module came out byte-identical, the compiler flagging only the
-- construction site. That is the additive-edit shape the remaining effect
-- classes need — each one adds a field here rather than a new seam.
--
-- `script` is the provider cursor: the remaining script tail, the threading
-- style `scripted_model_next` demonstrates. Live and caller-supplied adapters
-- are stateless and return their input unchanged — D1's specified identity
-- transition, not a per-construction-site decision.
--
-- The live/deterministic difference lives in the PORT CLOSURE, never in this
-- record and never in the driver: `live_ports` performs the ambient read,
-- `scripted_ports` serves from here. Production code calls the port and
-- branches on nothing, which is what keeps D1's prohibition on production
-- test-mode branching true as the later effect classes land.
export type WorldState = {
  script: [ScriptedStep],

  -- The monotonic virtual clock — D4's "the explicit clock value in
  -- `world_state` is the only clock". Read and advanced through `clock_now`,
  -- never directly. The LIVE adapter ignores it entirely and reads ambient wall
  -- time, which is D1's identity transition; the field being meaningless in a
  -- live run is correct, not a bug.
  --
  -- D4 grants the clock no exemption: no runtime-clock mirror, no
  -- `--virtual-time` dependency (it does nothing observable on the pin), and no
  -- conformance assertion comparing an explicit value against a runtime one.
  clock_ms: int,

  -- The approval-input cursor: the remaining queue of raw operator responses,
  -- consumed head-first exactly like `script`. Empty means end-of-input, which
  -- the driver's `resolve_approval` policy turns into the configured default —
  -- the same thing `readLine()` returning "" means today, so an empty queue is
  -- behaviour-preserving.
  --
  -- It holds RAW input lines, not resolutions. What is nondeterministic is the
  -- operator's input; `resolve_approval` is pure policy and stays in the driver
  -- where it belongs. Routing the resolution instead would move production
  -- policy into the adapter, and let the live and deterministic worlds disagree
  -- about it.
  approvals: [string],

  -- The synthetic environment: the key/value map a deterministic run reads
  -- instead of the process environment. A key that is absent falls back to the
  -- caller-supplied default, which is exactly what `getEnvOr` does for an unset
  -- variable, so an empty map is behaviour-preserving.
  --
  -- Unlike `script` and `approvals` this is a KEYED LOOKUP, not a cursor: reads
  -- do not consume it and the successor is the same world. `EnvRead` still
  -- carries a successor because D1 requires every request to return one, and
  -- because A13's interaction log will want to record the read (encounter
  -- ordinals) without changing this port's shape to do it.
  env: [{ key: string, value: string }],

  -- The tool-execution cursor: the remaining queue of scripted tool outcomes,
  -- consumed head-first like `script` and `approvals`.
  --
  -- An EMPTY queue means "the world has no opinion", and the adapter then
  -- delegates to the real dispatcher. That fallback is not a convenience: the
  -- gated smoke scripts `smoke_v2_pending_full_loop` and
  -- `smoke_phase_a_tool_parity` execute tools for real through this path, so a
  -- world-queue-only adapter would silently replace their tool results with
  -- empty strings. Delegating when unseeded is what makes this class
  -- behaviour-preserving, and it is also what makes the seeded case meaningful:
  -- a fully-seeded run performs no process execution at all, which is exactly
  -- what the Process poison pair measures.
  tools: [ScriptedTool],

  -- WI-A13's interaction log: D2's ordered record of every request the driver
  -- actually made, with causal identities and global encounter ordinals.
  --
  -- It rides HERE, in the threaded world, and not in a separate accumulator,
  -- because the ports are the only place that sees a request at the moment it
  -- is made. A12 anticipated this at the env comment above — "A13's interaction
  -- log will want to record the read (encounter ordinals) without changing this
  -- port's shape to do it" — and that is what happened: not one signature in
  -- `Ports` changed to carry the log.
  --
  -- The ordinal is `List.length(log)` at append time, so it is GLOBAL by
  -- construction rather than by a counter that a per-class recorder could
  -- shadow. `dst_discovery`'s density check is the executable statement of that
  -- and it is not redundant: it is what fails if a future recorder introduces
  -- its own counter.
  --
  -- Every adapter carries it forward through record update (`{ state | ... }`),
  -- so the four deterministic seams below preserve it without naming it. Only
  -- the RECORDING adapters append, and they are separate closures — a live or
  -- plain scripted run leaves this empty, which is why adding the field is
  -- behaviour-preserving for every existing target.
  log: [Interaction],

  -- WI-A13 stage 4: D2's seeded generator, as EXPLICIT STATE.
  --
  -- D2 makes every discovery choice "a deterministic function of generator
  -- id/version, seed, generator state, the bounded request projection, and
  -- current world state. No ambient RNG participates." The first three of those
  -- five are this field; the fourth arrives at the port as the request; the
  -- fifth is the rest of this record.
  --
  -- It rides HERE and not in a closure for the reason A12 moved every other
  -- cursor here, and the failure it avoids is the one this project has already
  -- paid for once: a cursor a closure captures is pinned, serves the same value
  -- for the whole run, and produces a result that nothing distinguishes from a
  -- correct one (F6, cluster 1). A pinned GENERATOR is worse than a pinned
  -- script, because its output is still a valid, replayable, perfectly
  -- reproducible program — it is simply the same program for every seed.
  --
  -- `no_generator()` is the default and means "not installed". The four
  -- deterministic seams and the four recording ones never read it; only the
  -- GENERATING adapters do, which is what keeps adding this field
  -- behaviour-preserving for every existing target.
  gen: GeneratorState
}

-- One scripted tool outcome. The fields are ordered by the fault they express,
-- and the adapter checks them in that order:
--
--   tool_call_id  a value different from the request's id is a CORRELATION
--                 fault — the world answering a question nobody asked. Empty
--                 means "answer whatever was asked", the ordinary case.
--   duration_ms   advances the virtual clock. Greater than the invocation's
--                 timeout is a DEADLINE fault. This is why the deadline is
--                 testable at all: a virtual clock makes "slow" a scripted
--                 property rather than a race.
--   code          non-empty is a typed EXECUTION fault (D3's tool fault class).
--   content       the tool's own output, on the success path.
export type ScriptedTool = {
  tool_call_id: string,
  duration_ms: int,
  code: string,
  message: string,
  content: string
}

-- D1's typed tool request: parts 1 and 2 of the three the decision requires —
-- a typed envelope, and the timeout/deadline information that a
-- `(string, string)` signature had nowhere to put.
--
-- `timeout_ms` of 0 means no deadline, which is the default and preserves
-- today's behaviour. `started_at_ms` is a world-clock reading taken by the
-- driver at dispatch, so elapsed time is measured in the same clock the rest of
-- the run uses rather than against wall time.
export type ToolInvocation = {
  call: ToolCallEnvelope,
  workdir: string,
  timeout_ms: int,
  started_at_ms: int
}

-- D1's part 3: the typed result/error that replaces
-- `tool_exec: (string, string) -> string`.
--
-- The plan is explicit that a request-only widening is not enough — it "would
-- pass the listed probes while leaving the return an undifferentiated string,
-- unable to carry D3's typed tool fault classes". The three fault variants are
-- that carrying capacity. `ToolCompleted` keeps the tool's own output as a
-- string because at this layer it genuinely is opaque: the typing that matters
-- is the DISCRIMINATION between completed, failed, misaddressed and late, none
-- of which a string return can express.
export type ToolOutcome
  = ToolCompleted({ tool_call_id: string, content: string })
  | ToolFailed({ tool_call_id: string, code: string, message: string })
  | ToolCorrelationMismatch({ expected_id: string, got_id: string })
  | ToolDeadlineExceeded({ tool_call_id: string, elapsed_ms: int, timeout_ms: int })

export type ToolExecution = {
  outcome: ToolOutcome,
  next_state: WorldState
}

-- One environment read and its successor world.
export type EnvRead = {
  value: string,
  next_state: WorldState
}

-- One approval read and its successor world. `eof` is carried explicitly rather
-- than inferred from `raw == ""`: a recorded world must be able to replay an
-- empty line that the operator actually typed as distinct from a closed
-- channel, and the driver's policy branches differently on the two.
export type ApprovalInput = {
  raw: string,
  eof: bool,
  next_state: WorldState
}

-- A clock read and its successor world. Every port that observes an effect
-- returns its successor explicitly — D1's `next_world_state` — because a read
-- that advances a cursor without handing the successor back is the exact
-- arrangement that reproduced F6 on a second port in P2's reviewer probe.
export type ClockReading = {
  now_ms: int,
  next_state: WorldState
}

-- `ported_provider` returns the initial world alongside the Ports — D1's "a
-- pair, or a paired constructor". Splitting them at the loop boundary is what
-- keeps the cursor in one explicit driver field instead of inside the Ports.
export type PortedProvider = {
  ports: Ports,
  world: WorldState
}

-- The world a stateless provider carries, and the initial world for every
-- non-scripted arm of `ported_provider`.
export pure func empty_world_state() -> WorldState {
  { script: [], clock_ms: 0, approvals: [], env: [], tools: [], log: [], gen: no_generator() }
}

-- One provider exchange: the typed step outcome, plus the ordered log of the
-- intermediate emissions that call produced.
--
-- WI-A1, under ADR-001 D1's loss-channel rule. `model_step` takes a multi-fire
-- `(StreamChunk) -> () ! {IO}` callback whose values the returning closure
-- discards, while returning only `Result[StepResult, AIError]` — a concrete,
-- demonstrated loss, one layer above `std/ai`, which nothing downstream can
-- recover from. The ordering rule is: widen the port before adopting whatever
-- fills it, because the port is where the information is thrown away.
--
-- WI-A1 shipped this with `emissions: []` at every construction site, which
-- made the widening behaviour-preserving; what it bought is that adopting a
-- recorded-stream API later filled exactly one closure. WI-C1 spent that: as of
-- AILANG v0.33.0's `stepWithStreamRecorded`, `live_ports` returns the ordered
-- observed chunks, and the prediction that the adoption would be one closure
-- held exactly — two lines and one import symbol.
--
-- WI-C3 GAVE IT A CONSUMER, which is the sentence three previous versions of
-- this note could not write. `session.ail`'s model-step site converts the
-- returned log once (`stream_chunk_events`), APPENDS the resulting events to
-- the returned `LedgerTrace` — closing `StreamDelta` in D6.4's gap register —
-- and threads the same events forward as the run's emission witness, out
-- through `TracedSessionResult.emissions`. `make stream_parity` drives it.
--
-- The two scripted sites that call `play_chunks` are populated too. They used to
-- play chunks through `on_chunk` and report none — this field's own loss channel
-- one layer down, and the deterministic half of D1's parity claim. They now
-- build the chunk list once and both play it and report it, so it cannot drift
-- from itself. The other 16 scripted sites still return `[]` and that remains
-- correct: an error path or a terminal step emits nothing.
--
-- WHAT IS STILL NOT TRUE, because a consumed log is not the whole obligation:
-- both sides of the in-process parity check derive from THIS field, since the
-- callback's projections go to `ledger_emit` and its row is closed `{IO}`. So a
-- projection that disagrees with the returned log is invisible in-process and is
-- caught only by the wire gate. Measured, not argued — see
-- `scripts/dst/run_stream_parity_wire.sh`.
--
-- The rule is scoped to ports with a *demonstrated* loss channel, and today
-- that is exactly this one field: `approval_read` is a synchronous resolution
-- and `clock_now` is a point read, and neither has an intermediate channel
-- through which a value could be silently dropped.
--
-- WI-A2 added `next_state`. That is a SECOND widening of `model_step`, on a
-- second and separately stated ground — state threading, not a discarded
-- emission channel — and unlike the first it is not behaviour-preserving,
-- because it changes the port's input shape and every construction site's
-- contract. A successor cursor is not an emission; WI-A1 did not enable this.
export type ProviderExchange = {
  emissions: [StreamChunk],
  result: Result[StepResult, AIError],
  next_state: WorldState
}

export type Ports = {
  model_step: (WorldState, string, [Message], (StreamChunk) -> () ! {IO}) -> ProviderExchange ! {AI, IO, Trace},
  -- WI-A12's approval class. State-threaded, and it returns the raw input
  -- rather than a resolution — see `ApprovalInput`. The `ApprovalRequest` is
  -- passed so a recorded world can correlate the read with the call it is
  -- approving (D8 causal identities); the live adapter ignores it.
  approval_read: (WorldState, ApprovalRequest) -> ApprovalInput ! {IO},
  -- WI-A12's clock class. State-threaded in and out, like `model_step`. The
  -- `{Clock}` effect stays in the row and that is expected: AILANG fails on a
  -- capability only when a read is PERFORMED, so the deterministic adapter
  -- never triggering it is precisely what the poison pair measures.
  clock_now: (WorldState) -> ClockReading ! {Clock},
  -- WI-A12's env class. State-threaded like the rest.
  env_get: (WorldState, string, string) -> EnvRead ! {Env},
  -- WI-A12's typed tool contract. State-threaded, typed request, typed result.
  -- No `{Clock}` in the row: the adapter ADVANCES the virtual clock
  -- arithmetically from the scripted duration, it never reads one. That keeps
  -- this row identical to `ExtPorts.proc_exec`'s, which is what lets the
  -- extension seam project onto it without widening the ABI.
  tool_exec: (WorldState, ToolInvocation) -> ToolExecution ! {IO, Process, FS}
}

-- The deterministic approval channel: serve the queue head, advance past it.
-- An empty queue reports end-of-input, which the driver resolves through its
-- own default-allow policy. Exported for the same reason as `virtual_clock` —
-- one implementation of the cursor shared by every non-live adapter.
export func scripted_approval(state: WorldState, _req: ApprovalRequest) -> ApprovalInput ! {IO} {
  match state.approvals {
    [] => { raw: "", eof: true, next_state: state },
    x :: rest => { raw: x, eof: false, next_state: { state | approvals: rest } }
  }
}

-- The deterministic clock: serve the world's own value, advance it by one
-- millisecond. Exported so every non-live adapter shares ONE implementation of
-- the tick — three copies of "read the field, add one" is three chances for
-- them to drift, and a clock that drifts between adapters is a determinism
-- defect no single-adapter test can see.
--
-- The tick must be non-zero. A clock returning a constant is perfectly
-- reproducible and therefore invisible to a determinism assertion — cluster 1's
-- freeze hazard in the clock's clothing — so `world_state_probe` asserts
-- advancement separately.
-- It declares `! {Clock}` while performing no clock read at all. That is not a
-- lie the type system is forced to swallow, it is the mechanism the poison pair
-- rests on: AILANG demands a capability only when an effect is PERFORMED, so a
-- deterministic run keeps `{Clock}` in its row and still completes with the
-- capability withheld. The declaration is also required — a `pure` function
-- will not unify into the effectful port slot ("incompatible closed rows"), so
-- the row cannot simply be narrowed here.
export func virtual_clock(state: WorldState) -> ClockReading ! {Clock} {
  { now_ms: state.clock_ms, next_state: { state | clock_ms: state.clock_ms + 1 } }
}

-- The deterministic environment: serve the world's map, fall back to the
-- caller's default when the key is absent.
export func scripted_env(state: WorldState, key: string, fallback: string) -> EnvRead ! {Env} {
  { value: lookup_env(state.env, key, fallback), next_state: state }
}

pure func lookup_env(entries: [{ key: string, value: string }], key: string, fallback: string) -> string {
  match entries {
    [] => fallback,
    e :: rest => if e.key == key then e.value else lookup_env(rest, key, fallback)
  }
}

-- The tool adapter. One implementation serves both worlds, which is why
-- `live_ports` overrides the clock and the approval channel but NOT this: the
-- only difference between a live and a deterministic tool call is whether the
-- world has an answer queued, and that is data, not a code path.
export func world_tool(state: WorldState, inv: ToolInvocation) -> ToolExecution ! {IO, Process, FS} {
  match state.tools {
    -- No world opinion: perform the real effect, exactly as before A12.
    [] => {
      outcome: ToolCompleted({ tool_call_id: inv.call.id, content: dispatch_one(inv.workdir, envelope_to_call(inv.call)) }),
      next_state: state
    },
    t :: rest => {
      let advanced = { state | tools: rest, clock_ms: state.clock_ms + t.duration_ms };
      let outcome =
        if t.tool_call_id != "" && t.tool_call_id != inv.call.id then
          ToolCorrelationMismatch({ expected_id: inv.call.id, got_id: t.tool_call_id })
        else if inv.timeout_ms > 0 && t.duration_ms > inv.timeout_ms then
          ToolDeadlineExceeded({ tool_call_id: inv.call.id, elapsed_ms: t.duration_ms, timeout_ms: inv.timeout_ms })
        else if t.code != "" then
          ToolFailed({ tool_call_id: inv.call.id, code: t.code, message: t.message })
        else
          ToolCompleted({ tool_call_id: inv.call.id, content: t.content });
      { outcome: outcome, next_state: advanced }
    }
  }
}

pure func envelope_to_call(e: ToolCallEnvelope) -> ToolCall {
  { id: e.id, name: e.tool, arguments: encode(e.arguments) }
}

-- ---------------------------------------------------------------------------
-- WI-A13 stage 2: the recording seams
-- ---------------------------------------------------------------------------

-- Append one interaction to the world's log, assigning it the next global
-- encounter ordinal.
--
-- This is the ONLY place an ordinal is assigned and the ONLY place the log
-- grows. Both properties are deliberate: an ordinal computed from the log's own
-- length cannot disagree with the log's own order, and a single append site is
-- what makes "the recorder logged something twice" a defect that has to be
-- written on purpose rather than one that arises from two adapters both being
-- polite.
export pure func record_interaction(
  state: WorldState,
  body: IdentityBody,
  request_projection: string,
  deadline_ms: int,
  outcome: TimedOutcome
) -> WorldState {
  let identity: CausalIdentity = { ordinal: List.length(state.log), body: body };
  { state |
    log: state.log ++ [{
      identity: identity,
      request_projection: request_projection,
      deadline_ms: deadline_ms,
      outcome: outcome
    }]
  }
}

-- The recording clock. It WRAPS `virtual_clock` rather than reimplementing the
-- tick, for the reason `virtual_clock`'s own comment gives: three copies of
-- "read the field, add one" is three chances to drift, and a clock that drifts
-- between adapters is a determinism defect no single-adapter test can see. The
-- recorded advance is read back from the successor rather than assumed to be 1,
-- so a change to the tick cannot silently desynchronise the log from the world.
export func recording_clock(state: WorldState) -> ClockReading ! {Clock} {
  let reading = virtual_clock(state);
  let advanced = reading.next_state.clock_ms - state.clock_ms;
  {
    now_ms: reading.now_ms,
    next_state: record_interaction(
      reading.next_state,
      ClockAdvanceIdentity,
      "clock_now at=${state.clock_ms}",
      -1,
      { advance_ms: advanced, chunks: [], payload: "${reading.now_ms}", status: OutcomeOk, fault_class_id: "" }
    )
  }
}

-- The recording environment read. `OutcomeMissing` is D2's `value_or_missing`:
-- the key was absent and the caller's fallback was served. That distinction is
-- recorded rather than inferred, because a replay that cannot tell "the world
-- said empty string" from "the world had no opinion" cannot reproduce the
-- driver's `getEnvOr` branch.
export func recording_env(state: WorldState, key: string, fallback: string) -> EnvRead ! {Env} {
  let read = scripted_env(state, key, fallback);
  let present = env_has_key(state.env, key);
  let outcome: TimedOutcome =
    if present then
      { advance_ms: 0, chunks: [], payload: read.value, status: OutcomeOk, fault_class_id: "" }
    else
      { advance_ms: 0, chunks: [], payload: "", status: OutcomeMissing, fault_class_id: "" };
  {
    value: read.value,
    next_state: record_interaction(
      read.next_state,
      EnvironmentReadIdentity(key),
      "env_get key=${key} fallback=${fallback}",
      -1,
      outcome
    )
  }
}

pure func env_has_key(entries: [{ key: string, value: string }], key: string) -> bool {
  match entries {
    [] => false,
    e :: rest => if e.key == key then true else env_has_key(rest, key)
  }
}

-- The recording approval read. The request's call id and tool name are what
-- make this correlatable with the tool interaction that provoked it (D8's
-- causal identities), and they are available here precisely because A12 passed
-- the `ApprovalRequest` through the port for this purpose.
--
-- An end-of-input read IS recorded. It is a request the driver made and a
-- decision the world returned; a recorder that logged only non-empty reads
-- would under-record exactly the runs where the queue ran dry, which is the
-- case a replay most needs to reproduce.
export func recording_approval(state: WorldState, req: ApprovalRequest) -> ApprovalInput ! {IO} {
  let read = scripted_approval(state, req);
  {
    raw: read.raw,
    eof: read.eof,
    next_state: record_interaction(
      read.next_state,
      ApprovalIdentity("loop_v2", req.call.id, req.call.name),
      "approval_read call_id=${req.call.id} tool=${req.call.name} default_allow=${req.default_allow} reason=${req.reason}",
      -- D2 gives ExpectApproval a deadline and the driver's approval channel
      -- carries no numeric one: `Ports.approval_read` takes the request and the
      -- world, and the timeout policy is `DenyAfterTimeout`, a DECISION rather
      -- than a duration. 0 is recorded, which `ToolInvocation.timeout_ms`
      -- already establishes as "no declared deadline" for the tool class, so the
      -- two classes agree on what 0 means. Recording -1 instead would say "this
      -- class has no deadline at all", which contradicts D2 and which stage 1's
      -- validator rejects for exactly that reason.
      --
      -- This is a DECLARED GAP, not a solved problem: until an approval
      -- deadline is routed, D3's `approval_deadline_exceeded` class cannot be
      -- reached by a discovered program, and D11's coverage counters must show
      -- it unreached rather than waived. Reported as a stage 2 finding.
      0,
      { advance_ms: 0, chunks: [],
        payload: if read.eof then "" else read.raw,
        status: if read.eof then OutcomeMissing else OutcomeOk,
        fault_class_id: "" }
    )
  }
}

-- The recording tool dispatch. The deadline recorded is the invocation's own
-- `timeout_ms` — D2 gives ExpectTool a deadline and this is where it comes
-- from — and the advance is read back from the world rather than from the
-- script, so a queue-empty delegation to the real dispatcher (advance 0) and a
-- scripted outcome (advance `duration_ms`) record what actually happened.
export func recording_tool(state: WorldState, inv: ToolInvocation) -> ToolExecution ! {IO, Process, FS} {
  let execution = world_tool(state, inv);
  let advanced = execution.next_state.clock_ms - state.clock_ms;
  {
    outcome: execution.outcome,
    next_state: record_interaction(
      execution.next_state,
      ToolIdentity("loop_v2", inv.call.id, inv.call.tool),
      "tool_exec call_id=${inv.call.id} tool=${inv.call.tool} workdir=${inv.workdir} timeout_ms=${inv.timeout_ms} started_at_ms=${inv.started_at_ms}",
      inv.timeout_ms,
      tool_outcome_record(execution.outcome, advanced)
    )
  }
}

-- The typed tool outcome, projected onto D2's timed outcome. Each of A12's four
-- discriminated results maps to its own recorded status, and the three faults
-- carry A7 class ids: a fault recorded without one is uncountable by D11's
-- class-reached counter, which stage 1's validator rejects outright.
--
-- WI-A13 stage 3 changed the PAYLOAD from a prose summary to the structured
-- projection `encode_tool_outcome` writes. The status and the class id are
-- unchanged, so nothing that grades the fault class moves; what changes is that
-- the payload is now sufficient to re-serve the outcome. Stage 2's version was
-- not: `ToolFailed`'s payload was its message alone, and a failure code that
-- reaches no replay is a D3 fault class that no replayed program can exercise.
pure func tool_outcome_record(o: ToolOutcome, advanced: int) -> TimedOutcome {
  let payload = encode_tool_outcome(o);
  match o {
    ToolCompleted(_) =>
      { advance_ms: advanced, chunks: [], payload: payload, status: OutcomeOk, fault_class_id: "" },
    ToolFailed(_) =>
      { advance_ms: advanced, chunks: [], payload: payload, status: OutcomeFault, fault_class_id: fault_class_tool_failed() },
    ToolCorrelationMismatch(_) =>
      { advance_ms: advanced, chunks: [], payload: payload, status: OutcomeFault, fault_class_id: fault_class_tool_correlation_mismatch() },
    ToolDeadlineExceeded(_) =>
      { advance_ms: advanced, chunks: [], payload: payload, status: OutcomeFault, fault_class_id: fault_class_tool_deadline_exceeded() }
  }
}

-- ---------------------------------------------------------------------------
-- WI-D1: the PROVIDER fault, projected the two ways a fault has to be projected
-- ---------------------------------------------------------------------------
--
-- These live here, beside `tool_outcome_record`, for the reason
-- `generated_provider_entry` gives for the decision mappings: the class
-- mappings belong one screen apart, so "which fields of a scripted fault reach
-- the world, and under which class id" is answerable in one place. Putting them
-- in `stub_step` would also have needed a NEW import statement there, and
-- `stub_step.ail:202` is an A5 attribution anchor (S18).
--
-- 1. THE PRODUCTION VALUE. What `Ports.model_step` hands the driver in place of
--    a `StepResult`, and `retryable` is the whole item: `session.c2_loop` reads
--    it through `should_retry_stream_error` and takes the retry branch or the
--    `TermProviderFailure` finalize. It is DERIVED from the code rather than
--    carried beside it — see `provider_error_is_retryable`'s note in the
--    catalogue for the binding and why the alternative was a codec change.
export pure func scripted_step_ai_error(s: ScriptedStep) -> AIError {
  { code: s.error_code,
    message: if s.error_message == "" then s.error_code else s.error_message,
    retryable: provider_error_is_retryable(s.error_code) }
}

export pure func scripted_step_faults(s: ScriptedStep) -> bool {
  s.error_code != ""
}

-- 2. THE RECORDED VALUE. The same fault as a `TimedOutcome`, so that D11's
--    class-reached counter can see it and a replay can re-serve it.
--
--    The payload is `encode_provider_outcome(s)` on BOTH the ok and the faulted
--    path, unchanged and with no codec change: it already carries `error_code`
--    and `error_message` (WI-B2b), and `decode_provider_outcome` already reads
--    them back. That is what makes the derivation replayable — the code
--    survives the round trip, so `retryable` re-derives to the same bool and a
--    replayed run takes the same branch. A `retryable` FIELD would not have
--    survived it without widening D8's persisted artifact surface.
--
--    The chunks are passed in rather than taken from `s.chunks` because the
--    recorder must record what was PLAYED, and they are also what separates
--    `provider_partial_stream_then_error` from the two plain error classes.
--
-- AND THE DEFECT THIS RECORD MADE VISIBLE, WRITTEN HERE BECAUSE THE SITE IT
-- CORRECTS COULD NOT CARRY IT. `session.ail`'s unretried-provider-failure
-- branch finalized from `st.world_state` — the world the STEP WAS ENTERED
-- with — rather than from `exchange.next_state`. That is plan rule S12's exact
-- shape, the one WI-B2b named and could not instrument: *the decision falls
-- back; the world must not.* The provider call HAPPENED. This record was
-- appended for it and the script cursor advanced past the entry it served, and
-- the pre-step chain before it may have consumed entries of its own.
-- Finalizing from the entered world discarded both, so a run ended having
-- recorded one fewer request than it made — under-recording, on the one path
-- where the run is over and nothing downstream can notice.
--
-- MEASURED, AND THAT IS WHY THE LINE CHANGED RATHER THAN AN ARGUMENT ABOUT IT.
-- Over a 260-seed sweep the wire carried **75** provider-failure finalizes and
-- the interaction logs carried **zero** `provider_error_non_retryable` records.
-- The retry branch directly above it — same fault, same recorder, threading
-- `exchange.next_state` — recorded its own class on 6 seeds of the same sweep.
-- Two arms of one match, differing in this expression and in nothing else, is
-- as close to a controlled experiment as the driver allows. The class was
-- unreachable by search for this reason and no other, and no recorded reason
-- named it.
--
-- The other two `st.world_state` finalize sites in that match
-- (`SealSystemPromptEmpty`, `SealExhausted`) discard `chain.next_state` the
-- same way, and WI-D1 did NOT change them: no profile in this tree reaches
-- either branch, so the edit would be unexercised by every gate here. Reported
-- rather than fixed blind.
export pure func provider_outcome_record(s: ScriptedStep, chunks: [StreamChunkRecord]) -> TimedOutcome {
  { advance_ms: 0,
    chunks: chunks,
    payload: encode_provider_outcome(s),
    status: if scripted_step_faults(s) then OutcomeFault else OutcomeOk,
    fault_class_id: provider_fault_class_id(s.error_code, List.length(chunks)) }
}

-- ---------------------------------------------------------------------------
-- WI-A13 stage 4: the GENERATING seams
-- ---------------------------------------------------------------------------
--
-- Each of these SUPPLIES the world's queue entry from the seeded generator and
-- then delegates to its recording counterpart. That composition is the whole
-- design, and it is chosen over a generating recorder for three reasons:
--
--   1. ONE RECORDER. A generating adapter that also recorded would be a second
--      copy of "serve the head, advance past it, append an interaction", and a
--      log that disagrees with the run it claims to record is the defect stage
--      2 exists to detect. `recording_clock` wraps `virtual_clock` for the same
--      reason and states it in the same words.
--
--   2. D2's "DISCOVERY CHOOSES ONLY AT REQUESTS THE REAL DRIVER ACTUALLY
--      MAKES. It never invents a tool, approval, or extension-effect request
--      disconnected from production control flow." A generator that pre-filled
--      a queue would be choosing before any request existed — and worse, it
--      could not consult the request, which D2 names as an input to every
--      choice. Generating exactly one entry at the moment the port is called
--      makes that structural instead of asserted.
--
--   3. THE GENERATED PROGRAM REPLAYS THROUGH THE UNCHANGED STAGE-3 PATH.
--      Because the recorded interaction is written by the same recorder as
--      before, `dst_replay.world_state_of` reconstitutes a plain world and the
--      replay runs on `recording_ports` — no generator in scope. That is D2's
--      "replay receives that resolved program and never calls the generator",
--      and it is true here by construction rather than by discipline.
--
-- The salt each adapter builds is D2's "bounded request projection ... and
-- current world state": the request's own fields, plus the log length and the
-- clock. Both halves are needed. Without the request the choice cannot depend
-- on what was asked; without the world position two identical requests at
-- different points in one run would receive the same answer, which is a
-- generator with a period of one per request shape.

-- The generating tool dispatch.
--
-- `world_tool` DELEGATES TO THE REAL DISPATCHER on an empty queue, so a
-- generating adapter that failed to supply an entry would silently execute a
-- process — turning a seeded run into a live one and making the Process poison
-- pair meaningless. Supplying the entry first is what keeps a fully-seeded run
-- free of process execution, and `world_state_probe`'s poison pair is what
-- would notice if it stopped.
export func generating_tool(state: WorldState, inv: ToolInvocation) -> ToolExecution ! {IO, Process, FS} {
  if not generator_installed(state.gen) then recording_tool(state, inv)
  else {
    let salt = "tool call_id=${inv.call.id} tool=${inv.call.tool} timeout_ms=${inv.timeout_ms} at=${state.clock_ms} n=${List.length(state.log)}";
    let choice = choose_tool(state.gen, salt, inv.timeout_ms, inv.call.id);
    let d = choice.decision;
    let entry: ScriptedTool = {
      tool_call_id: d.answering_call_id,
      duration_ms: d.duration_ms,
      -- `world_tool` checks correlation, then the deadline, then the code, in
      -- that order. The code is therefore blanked for the two fault choices
      -- that must be reached through an EARLIER branch, or a mismatch decision
      -- would replay as an ordinary execution failure and D3's correlation
      -- class would be unreachable by a generated program.
      code: match d.fault { ToolChoiceFailed => d.code, _ => "" },
      message: match d.fault { ToolChoiceFailed => d.message, _ => "" },
      content: d.content
    };
    recording_tool({ state | gen: choice.state, tools: [entry] }, inv)
  }
}

-- The provider entry the generating provider serves.
--
-- The MAPPING lives here, beside the other two, rather than in
-- `src/core/test/stub_step` where the generating provider closure is. Two
-- reasons, and the second is the load-bearing one:
--
--   * all three class mappings are then one screen apart, so "which fields of
--     a decision reach the world" is answerable in one place;
--   * `stub_step.ail:202` is an A5 attribution anchor. Its history is the point:
--     `:161` until WI-B2b's threading moved it, re-derived to `:163` at WI-B4,
--     moved to `:182` by WI-C1 and to `:202` by WI-C3. Putting the decision
--     mapping HERE
--     means `stub_step` widens ONE existing import line and adds no import
--     statement, so this particular edit does not move the anchor. Cluster 8
--     paid a five-artifact cascade including a mandatory `driver_only` re-issue
--     for a line that shifted; cluster 9 avoided it with one `sed -n '163p'`
--     check, and so does this — now `make anchors`, which reads every anchor in
--     milliseconds.
--
--     **But the technique only covers imports.** WI-C1 moved the anchor with
--     pure COMMENT above `live_ports`, which no amount of insert-below
--     discipline avoids, and paid the full re-issue (v4 -> v5). The avoidable
--     half of this cascade is genuinely avoidable; the rest is the case for a
--     coordinate-independent anchor.
--
-- `terminate` is not returned separately: a terminating decision IS a step with
-- no tool calls and a "stop" finish reason, which is the only thing the driver
-- reads. Returning the flag as well would be a second representation of one
-- fact, and the driver would still ignore it.
export pure func generated_provider_entry(state: WorldState, salt: string) -> { step: ScriptedStep, gen: GeneratorState } {
  let choice = choose_provider(state.gen, salt, List.length(state.log));
  let d = choice.decision;
  let calls: [ToolCall] =
    if d.terminate then []
    else [{ id: d.tool_call_id, name: d.tool_name, arguments: d.tool_args }];
  {
    step: { prose: d.prose,
            tool_calls: calls,
            input_tokens: d.input_tokens,
            output_tokens: d.output_tokens,
            finish_reason: d.finish_reason,
            chunks: repeat_chunk(d.chunk_text, d.chunk_count),
            -- WI-D1. Carried straight through: the generator chose the code and
            -- this is the mechanical mapping the header above says the adapters
            -- do and nothing else. The CLASS is not decided here — it is
            -- `provider_fault_class_id(code, chunks)` at the moment the fault is
            -- recorded, because it depends on the chunks as well as the code.
            error_code: d.error_code, error_message: d.error_message,
            -- Still 0, and deliberately: see `choose_provider`'s restated
            -- latency note. A generated provider latency needs a recorder that
            -- can see it, and `check_discovery`'s clock balance is right to
            -- refuse one that cannot.
            advance_ms: 0 },
    gen: choice.state
  }
}

pure func repeat_chunk(text: string, n: int) -> [string] {
  if n <= 0 then [] else "${text}.${n}" :: repeat_chunk(text, n - 1)
}

-- The generating approval channel. `serve: false` supplies NOTHING, which is
-- how `scripted_approval` reports end-of-input and how stage 2's
-- `OutcomeMissing` on the approval class becomes reachable by a generated
-- program at all.
--
-- The raw line is the operator's own wire format, built here rather than in the
-- generator because it is the DRIVER's vocabulary: `resolve_approval` parses
-- it, and a generator that knew the JSON shape would be encoding production
-- policy in the choice layer.
export func generating_approval(state: WorldState, req: ApprovalRequest) -> ApprovalInput ! {IO} {
  if not generator_installed(state.gen) then recording_approval(state, req)
  else {
    let salt = "approval call_id=${req.call.id} tool=${req.call.name} default_allow=${req.default_allow} at=${state.clock_ms} n=${List.length(state.log)}";
    let choice = choose_approval(state.gen, salt);
    let d = choice.decision;
    let queued =
      if not d.serve then []
      else if d.approve then ["{\"type\":\"approve\"}"]
      else ["{\"type\":\"deny\",\"reason\":\"${d.reason}\"}"];
    recording_approval({ state | gen: choice.state, approvals: queued }, req)
  }
}

-- ---------------------------------------------------------------------------
-- WI-A13 stage 3: the recorded outcome must be SUFFICIENT TO RE-SERVE THE
-- RESPONSE
-- ---------------------------------------------------------------------------
--
-- `dst_program`'s design note 3 refuses to put the provider script, the
-- approval queue and the tool queue on the execution program, because "a
-- program could serve a response that no interaction records, which is the
-- exact shape of the completeness defect this item exists to prevent". They are
-- PROJECTIONS of the interaction list, and `dst_replay.world_state_of` computes
-- them.
--
-- That constraint has a consequence stage 2 did not have to face and stage 3
-- does: a projection can only be lossless if the thing it projects from carries
-- everything. Stage 2 recorded the provider outcome's payload as `s.prose`
-- alone. That is a legible summary and an insufficient record: the step's TOOL
-- CALLS are what cause the next production tool request, so a program
-- discovered from a run with tool calls reconstituted a script that made none,
-- and the replay terminated at step 0 while agreeing with the program at every
-- position it reached.
--
-- The fix belongs HERE and not on the program. D2 says a provider timed outcome
-- carries "a final StepResult or AIError", so recording only the prose was an
-- under-recording of the outcome against D2's own text; widening
-- `ExecutionProgram` with a script field would instead be the defect design
-- note 3 exists to prevent. The payload becomes a structured projection, which
-- is what D2 already calls it ("arguments and message/payload digests are
-- recorded projections, not silently discarded").
--
-- ENCODER AND DECODER SIT TOGETHER, ON PURPOSE. This module's header argues
-- that "two representations of one fact with a hand-written projection between
-- them is the exact shape of the fifteen silent defects this project has now
-- found". A codec is that hazard in miniature, so the two halves are adjacent
-- and a round-trip test below is what holds them together.
--
-- The stream chunks are deliberately NOT in the payload: they are already in
-- `TimedOutcome.chunks`, and duplicating them would create exactly the second
-- representation the paragraph above rejects. `world_state_of` reads them from
-- there, which is what makes that field load-bearing rather than decorative.

pure func str_field(obj: Json, key: string, fallback: string) -> string {
  match get(obj, key) {
    None => fallback,
    Some(j) => match asString(j) { None => fallback, Some(v) => v }
  }
}

pure func int_field(obj: Json, key: string, fallback: int) -> int {
  match get(obj, key) {
    None => fallback,
    Some(j) => match asNumber(j) { None => fallback, Some(v) => _float_to_int(v) }
  }
}

pure func bool_field(obj: Json, key: string, fallback: bool) -> bool {
  match get(obj, key) {
    None => fallback,
    Some(j) => match asBool(j) { None => fallback, Some(v) => v }
  }
}

pure func json_array(obj: Json, key: string) -> [Json] {
  match get(obj, key) {
    None => [],
    Some(j) => match asArray(j) { None => [], Some(xs) => xs }
  }
}

pure func has_key(obj: Json, key: string) -> bool {
  match get(obj, key) { None => false, Some(_) => true }
}

-- What a recorded provider outcome reads back as.
--
-- Three cases and not two: an exhausted script is a request the driver MADE and
-- the world declined to serve from the script, so it is a recorded interaction
-- with no script entry behind it — the same distinction an end-of-input
-- approval read draws with `OutcomeMissing`. Collapsing it into "undecodable"
-- would make a legitimate run unreplayable; collapsing it into "served" would
-- manufacture a script entry the discovery run never had.
export type ProviderOutcome
  = ProviderServed(ScriptedStep)
  | ProviderScriptExhausted
  | ProviderUndecodable(string)

pure func tool_call_json(c: ToolCall) -> Json {
  jo([kv("id", js(c.id)), kv("name", js(c.name)), kv("arguments", js(c.arguments))])
}

pure func tool_calls_json(cs: [ToolCall]) -> [Json] {
  match cs { [] => [], c :: rest => tool_call_json(c) :: tool_calls_json(rest) }
}

pure func tool_calls_of(xs: [Json]) -> [ToolCall] {
  match xs {
    [] => [],
    x :: rest =>
      ({ id: str_field(x, "id", ""),
         name: str_field(x, "name", ""),
         arguments: str_field(x, "arguments", "") }) :: tool_calls_of(rest)
  }
}

-- `finish_reason` is recorded rather than derived. `scripted_to_step_result`
-- WOULD derive it ("tool_calls if there are any, else stop"), and for every
-- step `tool_step` builds that derivation is correct — which is precisely why
-- it must not be relied on: `tool_step_finish` exists to produce a step whose
-- finish reason disagrees with its tool calls, because real providers do that,
-- and a derived value would replay that step as a different one while every
-- count still balanced.
export pure func encode_provider_outcome(s: ScriptedStep) -> string {
  encode(jo([
    kv("served", jb(true)),
    kv("prose", js(s.prose)),
    kv("finish_reason", js(s.finish_reason)),
    kv("input_tokens", jnum(_int_to_float(s.input_tokens))),
    kv("output_tokens", jnum(_int_to_float(s.output_tokens))),
    kv("tool_calls", ja(tool_calls_json(s.tool_calls))),
    -- WI-B2b widening 1: the FAULT travels in the payload, because it is what
    -- the provider said. Contrast `advance_ms` below, which does not.
    kv("error_code", js(s.error_code)),
    kv("error_message", js(s.error_message))
  ]))
}

export pure func encode_exhausted_provider_outcome() -> string {
  encode(jo([kv("served", jb(false))]))
}

-- `advance_ms` comes from the recorded `TimedOutcome`, not from the payload —
-- WI-B2b widening 2, and it is deliberately the SAME shape as
-- `decode_tool_outcome(payload, advance_ms)` directly below, for the same
-- reason: the elapsed time is what happened to the CLOCK, so recording it in
-- the payload as well would be a second representation of one quantity, and the
-- two could drift. Before this parameter existed a replayed provider call
-- always advanced the virtual clock by zero, which made every recorded
-- provider latency unreplayable while every count still balanced.
export pure func decode_provider_outcome(payload: string, advance_ms: int) -> ProviderOutcome {
  match decode(payload) {
    Err(_) => ProviderUndecodable("the payload is not JSON"),
    Ok(root) =>
      if not has_key(root, "served") then
        ProviderUndecodable("the payload carries no 'served' discriminator; a provider outcome recorded before WI-A13 stage 3 held the prose alone and cannot reconstitute the step's tool calls")
      else if not bool_field(root, "served", false) then ProviderScriptExhausted
      else ProviderServed({
        prose: str_field(root, "prose", ""),
        tool_calls: tool_calls_of(json_array(root, "tool_calls")),
        input_tokens: int_field(root, "input_tokens", 0),
        output_tokens: int_field(root, "output_tokens", 0),
        finish_reason: str_field(root, "finish_reason", ""),
        -- Read back from `TimedOutcome.chunks` by the caller; see above.
        chunks: [],
        error_code: str_field(root, "error_code", ""),
        error_message: str_field(root, "error_message", ""),
        advance_ms: advance_ms
      })
  }
}

-- What a recorded tool outcome reads back as: the `ScriptedTool` that reproduces
-- it. One case per fault A12's typed contract discriminates, because the flat
-- string payload stage 2 recorded lost the failure CODE entirely — a
-- `ToolFailed` recorded as its message alone replays as a success, and D3
-- requires the tool fault classes to be reachable.
export type ToolOutcomeRecord
  = ToolRecordDecoded(ScriptedTool)
  | ToolRecordUndecodable(string)

export pure func encode_tool_outcome(o: ToolOutcome) -> string {
  match o {
    ToolCompleted(c) =>
      encode(jo([kv("result", js("completed")), kv("content", js(c.content))])),
    ToolFailed(f) =>
      encode(jo([kv("result", js("failed")), kv("code", js(f.code)), kv("message", js(f.message))])),
    -- `got_id` is the SCRIPT's id, which is what the world must be re-seeded
    -- with for `world_tool` to take the correlation branch again. Recording the
    -- expected id instead would replay as an ordinary success.
    ToolCorrelationMismatch(m) =>
      encode(jo([kv("result", js("correlation_mismatch")),
                 kv("expected_id", js(m.expected_id)), kv("got_id", js(m.got_id))])),
    -- No duration here: the elapsed time IS `TimedOutcome.advance_ms`, and
    -- `world_tool` re-derives the deadline branch from that against the
    -- invocation's own timeout. Recording it twice is a second representation.
    ToolDeadlineExceeded(d) =>
      encode(jo([kv("result", js("deadline_exceeded")), kv("timeout_ms", jnum(_int_to_float(d.timeout_ms)))]))
  }
}

-- `advance_ms` comes from the recorded outcome rather than the payload, for the
-- reason `recording_tool` reads it back from the world rather than from the
-- script: it is what actually happened to the clock, and it is the single
-- quantity that re-derives the deadline branch on replay.
export pure func decode_tool_outcome(payload: string, advance_ms: int) -> ToolOutcomeRecord {
  match decode(payload) {
    Err(_) => ToolRecordUndecodable("the payload is not JSON"),
    Ok(root) => {
      let result = str_field(root, "result", "");
      if result == "completed" then
        ToolRecordDecoded({ tool_call_id: "", duration_ms: advance_ms, code: "",
                            message: "", content: str_field(root, "content", "") })
      else if result == "failed" then
        ToolRecordDecoded({ tool_call_id: "", duration_ms: advance_ms,
                            code: str_field(root, "code", ""),
                            message: str_field(root, "message", ""), content: "" })
      else if result == "correlation_mismatch" then
        ToolRecordDecoded({ tool_call_id: str_field(root, "got_id", ""), duration_ms: advance_ms,
                            code: "", message: "", content: "" })
      else if result == "deadline_exceeded" then
        ToolRecordDecoded({ tool_call_id: "", duration_ms: advance_ms, code: "",
                            message: "", content: "" })
      else
        ToolRecordUndecodable("the payload carries no recognised 'result' discriminator (saw '${result}'); a tool outcome recorded before WI-A13 stage 3 held the content or the message alone and cannot reconstitute the failure code")
    }
  }
}

-- ---------------------------------------------------------------------------
-- Codec round trips. A codec's failure mode is a field that the encoder writes
-- and the decoder ignores, or the reverse; both halves type-check and the loss
-- is silent until a replay serves a different response and every count still
-- balances. These assert the round trip is the IDENTITY on every field, which
-- is the only statement that can see that.
-- ---------------------------------------------------------------------------

pure func eq_tool_calls(a: [ToolCall], b: [ToolCall]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs => match b {
      [] => false,
      y :: ys => x.id == y.id && x.name == y.name && x.arguments == y.arguments && eq_tool_calls(xs, ys)
    }
  }
}

-- Every field of `ScriptedStep` given a DISTINCT value, so that a decoder which
-- reads the right key into the wrong field is visible. Two fields holding the
-- same value cannot distinguish which one a check is reading (S7).
pure func codec_fixture_step() -> ScriptedStep {
  { prose: "the prose",
    tool_calls: [{ id: "call-1", name: "BashExec", arguments: "{\"cmd\":\"true\"}" },
                 { id: "call-2", name: "Read", arguments: "{\"path\":\"x\"}" }],
    input_tokens: 211,
    output_tokens: 307,
    -- Deliberately DISAGREES with the tool calls: a derived finish reason would
    -- produce "tool_calls" here, so this row is what proves it is recorded.
    finish_reason: "stop",
    chunks: [],
    -- WI-B2b widening 1. Distinct from every other string in this fixture, so a
    -- decoder that reads `message` into `code` (or either into `prose`) is
    -- visible rather than merely decodable.
    error_code: "provider_error_retryable",
    error_message: "upstream 503",
    -- WI-B2b widening 2. 449 is distinct from 211, 307 and every other quantity
    -- here, and it is deliberately NOT the value the round trip passes in — see
    -- the test, which passes 983 and asserts the PASSED value wins, because
    -- `advance_ms` travels beside the payload rather than inside it.
    advance_ms: 449 }
}

pure func test_the_provider_outcome_round_trips_every_field() -> bool
  tests [((), true)]
  {
    let s = codec_fixture_step();
    -- 983, not `s.advance_ms` (449). WI-B2b widening 2 puts the elapsed time
    -- BESIDE the payload rather than inside it, so the round trip must show the
    -- passed value winning. Asserting `back.advance_ms == s.advance_ms` would
    -- pass just as readily against an encoder that wrote the field into the
    -- payload and a decoder that ignored the parameter — the exact silent loss
    -- this suite exists to catch.
    match decode_provider_outcome(encode_provider_outcome(s), 983) {
      ProviderServed(back) =>
        back.prose == s.prose
          && back.finish_reason == s.finish_reason
          && back.input_tokens == s.input_tokens
          && back.output_tokens == s.output_tokens
          && eq_tool_calls(back.tool_calls, s.tool_calls)
          && back.error_code == s.error_code
          && back.error_message == s.error_message
          && back.advance_ms == 983,
      ProviderScriptExhausted => false,
      ProviderUndecodable(_) => false
    }
  }

-- The three cases are DISTINGUISHED, not merely decodable. An exhausted script
-- read back as a served empty step would silently lengthen the replay's script
-- by one; a stage-2 payload (bare prose, not JSON) read back as anything other
-- than undecodable would replay a step with no tool calls and terminate early.
pure func test_the_three_provider_cases_are_distinguished() -> bool
  tests [((), true)]
  {
    let exhausted = match decode_provider_outcome(encode_exhausted_provider_outcome(), 0) {
      ProviderScriptExhausted => true, _ => false
    };
    let not_json = match decode_provider_outcome("stub: script exhausted", 0) {
      ProviderUndecodable(_) => true, _ => false
    };
    let json_without_discriminator = match decode_provider_outcome("{\"prose\":\"s0\"}", 0) {
      ProviderUndecodable(_) => true, _ => false
    };
    exhausted && not_json && json_without_discriminator
  }

-- Each of A12's four typed tool outcomes must round-trip to a `ScriptedTool`
-- that `world_tool` maps back to the SAME outcome. The assertion is on the
-- reconstituted world input, because that is what replay actually feeds back.
pure func test_each_tool_outcome_round_trips_to_a_world_input_that_reproduces_it() -> bool
  tests [((), true)]
  {
    let completed = decode_tool_outcome(encode_tool_outcome(ToolCompleted({ tool_call_id: "c1", content: "OUT" })), 7);
    let failed = decode_tool_outcome(encode_tool_outcome(ToolFailed({ tool_call_id: "c1", code: "E42", message: "boom" })), 11);
    let mismatch = decode_tool_outcome(encode_tool_outcome(ToolCorrelationMismatch({ expected_id: "c1", got_id: "c9" })), 13);
    let late = decode_tool_outcome(encode_tool_outcome(ToolDeadlineExceeded({ tool_call_id: "c1", elapsed_ms: 900, timeout_ms: 50 })), 900);
    (match completed {
       ToolRecordDecoded(t) => t.content == "OUT" && t.code == "" && t.tool_call_id == "" && t.duration_ms == 7,
       ToolRecordUndecodable(_) => false
     })
      && (match failed {
            -- The CODE is the field stage 2's flat payload lost.
            ToolRecordDecoded(t) => t.code == "E42" && t.message == "boom" && t.duration_ms == 11,
            ToolRecordUndecodable(_) => false
          })
      && (match mismatch {
            -- `got_id`, not `expected_id`: re-seeding the world with the id the
            -- driver asked for replays as an ordinary success.
            ToolRecordDecoded(t) => t.tool_call_id == "c9" && t.duration_ms == 13,
            ToolRecordUndecodable(_) => false
          })
      && (match late {
            -- Nothing but the duration, which is what re-derives the branch.
            ToolRecordDecoded(t) => t.duration_ms == 900 && t.code == "" && t.tool_call_id == "",
            ToolRecordUndecodable(_) => false
          })
  }

pure func test_a_stage_two_tool_payload_is_undecodable_rather_than_a_silent_success() -> bool
  tests [((), true)]
  {
    match decode_tool_outcome("boom", 3) { ToolRecordUndecodable(_) => true, _ => false }
      && match decode_tool_outcome("{\"content\":\"OUT\"}", 3) { ToolRecordUndecodable(_) => true, _ => false }
  }

-- The sole `Ports` constructor. It keeps ONE function-typed parameter and
-- defaults every other seam, including the deterministic `virtual_clock`;
-- adapters that need a different seam override it by record update, as
-- `live_ports` does for the clock.
--
-- That shape is forced, not preferred. Taking the clock as a second
-- function-typed parameter is the obvious design and it does not compile on
-- pinned v0.26.0: with two function-typed parameters carrying different effect
-- rows, the checker unifies them against the wrong slots and reports the rows
-- swapped ("record field 'clock_now': r1 has extra labels [AI IO Trace], r2 has
-- extra labels [Clock]", and the mirror-image message for 'model_step'). Tested
-- with both a top-level reference and an inline lambda for the second argument;
-- both fail identically, so it is the arity and not the argument form. Record
-- update over a one-parameter constructor avoids the inference path entirely.
export func ports_shape_probe(
  model_step: (WorldState, string, [Message], (StreamChunk) -> () ! {IO}) -> ProviderExchange ! {AI, IO, Trace}
) -> Ports {
  {
    model_step: model_step,
    approval_read: scripted_approval,
    clock_now: virtual_clock,
    env_get: scripted_env,
    tool_exec: world_tool
  }
}
