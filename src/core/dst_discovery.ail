-- D2's discovery: what the real driver actually requested, and the two-sided
-- check that the interaction log says so.
--
-- WI-A13, stage 2. This module is the ASSERTION, and it was written and proven
-- red before the recorder existed (standing rule S1). What it contains is not
-- the recorder; it is the thing that grades the recorder, and it is built to be
-- gradeable from the other side too.
--
-- ---------------------------------------------------------------------------
-- WHY THE CHECK IS TWO-SIDED
-- ---------------------------------------------------------------------------
--
-- Cluster 7 found the fifteenth site in this project where two implementations
-- type-check and the wrong one is silent, and it was caught by a NEGATIVE
-- CONTROL — a fixture that had to survive — after passing all 18 mutation rows.
-- The generalisation is that a one-sided assertion set cannot see failures in
-- the other direction: determinism tests sameness, so it cannot see that
-- nothing moved; mutation tests rejection, so it cannot see over-rejection.
--
-- A RECORDER has exactly that exposure, in both directions:
--
--   UNDER-RECORDING  the recorder drops a class, or drops one request of a
--                    class. The log is consistent, reproducible, replayable,
--                    and describes a shorter execution than the one that ran.
--
--   OVER-RECORDING   the recorder logs a request the driver never made — a
--                    double append, a wrapper that records and then delegates
--                    to an adapter that records again, a synthesised entry to
--                    make a count come out right. The log is consistent,
--                    reproducible, replayable, and describes a LONGER
--                    execution than the one that ran. Strict replay of it then
--                    fails on an "unused interaction" that names the recorder's
--                    defect as if it were the system's.
--
-- Only one of those was named in the handoffs. Both are named here, and they
-- are the SAME comparison run in both directions — `class_balance` emits
-- `UnderRecorded` when the log is short and `OverRecorded` when it is long,
-- from one arithmetic site, so neither direction can be dropped without
-- dropping the other.
--
-- ---------------------------------------------------------------------------
-- WHY THE WITNESSES ARE AN ORACLE AND NOT THE RECORDER GRADING ITSELF
-- ---------------------------------------------------------------------------
--
-- Every field of `DiscoveryWitness` is produced by code that is NOT the
-- recorder, and for the provider and tool classes by code in a different
-- component entirely:
--
--   provider_calls    `ProviderCallPrepared` records in the ledger trace the
--                     driver RETURNS. Written by production driver code
--                     (session.ail:1997) and emitted separately from the
--                     `dispatch_step` call at :2008, so it exists whether or
--                     not the port ever recorded anything. Owned by D6.
--   tool_dispatches   the tool-result messages the driver returned. Written by
--                     `tool_phase.ail`'s `tool_outcome_message`, downstream of
--                     the port but in a different module and a different
--                     record. The wire's `v2_tool_dispatch_start`
--                     (tool_phase.ail:332), emitted BEFORE the port calls at
--                     :342-350, is the stronger form of the same witness and is
--                     compared in the `discovery` make target, because it goes
--                     to the wire and is never appended to the returned trace.
--   approval_reads    the tool-role messages the driver returned. Under a
--                     policy that sends EVERY tool call to the approval channel
--                     — which both discovery scenarios use — the driver makes
--                     exactly one approval read per tool-role message it
--                     eventually returns, whether that message is a result or a
--                     denial. Written by `tool_phase.ail`, not by the recorder.
--
--                     THIS REPLACED THE CURSOR DELTA, and the replacement is a
--                     defect this stage found in its own assertion. Cluster 7
--                     rated the cursor witness "Medium" and this is exactly why:
--                     `world.approvals` measures answers CONSUMED, not reads
--                     PERFORMED, and the two diverge the moment the queue runs
--                     dry. A run with three tool calls and one queued answer
--                     makes three approval reads and moves the cursor by one, so
--                     the cursor witness reported a CORRECT recorder as
--                     over-recording. It is an over-rejection, and it was
--                     invisible to both original scenarios because each queued
--                     exactly as many answers as it needed — cluster 7's result
--                     restated against this stage's own checker.
--   approvals_consumed the cursor delta is KEPT, demoted to what it can
--                     actually witness: how many answers were served. It is
--                     checked exactly against the recorded approvals whose
--                     outcome is not `missing`.
--   clock_delta_ms    the world's own `clock_ms` delta. General across classes:
--                     EVERY class may advance the clock, so this is one number
--                     that no single class's recorder can satisfy alone.
--   known_env_keys    SOURCE-DERIVED, and of a different kind — see below.
--
-- ---------------------------------------------------------------------------
-- THE ENV CLASS'S EVIDENCE IS OF A DIFFERENT KIND, AND MUST BE REPORTED AS SUCH
-- ---------------------------------------------------------------------------
--
-- `ports.env_get` is a keyed lookup, not a cursor (ports.ail:121-125: "reads do
-- not consume it and the successor is the same world"), and no ledger event is
-- emitted for one. There is therefore NO runtime witness that an env read
-- happened: the only record would be the recorder's own log entry, which is the
-- recorder-as-its-own-oracle shape this project has found fifteen silent
-- defects behind.
--
-- So the env class is checked against a SOURCE-DERIVED key set instead. That is
-- genuinely independent of the recorder — it comes from the driver's source —
-- but it is STATIC where the other six are DYNAMIC, and the two must not be
-- added into one completeness number. A13's report and D11's counters must
-- carry six classes with runtime evidence and one with provenance evidence.
--
-- The set is checked against the source by the `discovery` make target, which
-- greps the `ports.env_get(` call sites out of session.ail and tool_phase.ail
-- and diffs the extracted keys against `driver_env_keys()` below. A literal
-- nobody re-derives is a literal that goes stale; the gate is the derivation.
--
-- The two directions land differently for env, and that asymmetry is real:
--
--   over-recording   TOTAL. Every key in the log must be a key some driver call
--                    site can read. A recorder that invents a read fails.
--   under-recording  PER SCENARIO. Not every key is read on every run —
--                    MOTOKO_CAPTURE_FAILED_PAYLOAD is on the non-retryable
--                    provider-error path only — so the expected subset is a
--                    property of the scenario's control flow, supplied by the
--                    caller and justified at the assertion site.

module src/core/dst_discovery

import std/list as List (length)
import src/core/dst_interaction (
  Interaction,
  CausalIdentity,
  IdentityBody,
  ProviderIdentity, ToolIdentity, ApprovalIdentity, ExtensionEffectIdentity,
  EnvironmentReadIdentity, RandomDrawIdentity, ClockAdvanceIdentity,
  TimedOutcome,
  ok_outcome,
  identity_kind,
  identity_projection,
  interaction_kind,
  all_interaction_kinds,
  count_kind,
  total_advance_ms,
  approvals_served,
  env_keys_read,
  OutcomeStatus, OutcomeOk, OutcomeFault, OutcomeMissing
)

-- ---------------------------------------------------------------------------
-- The source-derived env key set
-- ---------------------------------------------------------------------------

-- Every environment key the driver can read through `ports.env_get`, in call
-- order. Provenance, verified at HEAD and re-derived by `make discovery`:
--
--   src/core/session.ail:940    MOTOKO_SESSION_ID           derive_session_id
--   src/core/session.ail:1419   MOTOKO_PERSIST_RETRIES      session_policy_init
--   src/core/session.ail:1420   MOTOKO_RETRY_STREAM_ERROR   session_policy_init
--   src/core/session.ail:1421   OPENAI_BASE_URL             session_policy_init
--   src/core/session.ail:1422   MOTOKO_HEADLESS             session_policy_init
--   src/core/session.ail:2018   MOTOKO_CAPTURE_FAILED_PAYLOAD  provider error path
--   src/core/tool_phase.ail:343 MOTOKO_TOOL_TIMEOUT_MS      native tool dispatch
--
-- session.ail:775 is deliberately NOT here. It is the extension bridge's
-- `env_get` closure, whose key is supplied by an extension at call time and is
-- therefore not statically known. `driver_only` installs no extensions, so it
-- contributes nothing under this profile; a profile that installs one will need
-- its keys declared by the profile rather than derived from the driver.
export pure func driver_env_keys() -> [string] {
  ["MOTOKO_SESSION_ID",
   "MOTOKO_PERSIST_RETRIES",
   "MOTOKO_RETRY_STREAM_ERROR",
   "OPENAI_BASE_URL",
   "MOTOKO_HEADLESS",
   "MOTOKO_CAPTURE_FAILED_PAYLOAD",
   "MOTOKO_TOOL_TIMEOUT_MS"]
}

-- ---------------------------------------------------------------------------
-- The witness
-- ---------------------------------------------------------------------------

-- One expected environment read, with its MULTIPLICITY.
--
-- The count is the load-bearing half and it was missing from the first version
-- of this check. Presence alone is satisfied by a recorder that logs the first
-- read of a key and drops every later one — and the driver reads
-- MOTOKO_TOOL_TIMEOUT_MS once per native tool dispatch, so that recorder loses
-- two of three reads in the `approve` scenario while looking complete. The env
-- class has no runtime witness, so nothing else in this module would have seen
-- it.
--
-- The counts are still PROVENANCE evidence, not capability evidence: they are
-- derived from the driver's source and from the scenario's control flow, not
-- observed. But `MOTOKO_TOOL_TIMEOUT_MS`'s count is expressed in terms of the
-- independently-witnessed tool-dispatch count, so that one is anchored to a
-- runtime witness even though the read itself is not.
export type EnvExpectation = { key: string, count: int }

export type DiscoveryWitness = {
  provider_calls: int,
  tool_dispatches: int,
  -- How many approval READS the driver made. NOT the world's cursor delta —
  -- see the header note on the approval witness for why that under-counts.
  approval_reads: int,
  -- The world's own `approvals` cursor delta. Checked EXACTLY against the
  -- recorded approvals that were SERVED (status other than missing), which is a
  -- second, independent statement about the same class.
  approvals_consumed: int,
  clock_delta_ms: int,
  expected_env_reads: [EnvExpectation]
}

-- ---------------------------------------------------------------------------
-- Findings
-- ---------------------------------------------------------------------------

export type DiscoveryFinding
  = UnderRecorded(string, int, int)     -- kind, witnessed, logged
  | OverRecorded(string, int, int)      -- kind, witnessed, logged
  | ClockUnaccounted(int, int)          -- world delta, sum of recorded advances
  | EnvKeyNotInSource(string)           -- a logged key no driver call site can read
  | EnvReadUnderRecorded(string, int, int)  -- key, expected, logged
  | EnvReadOverRecorded(string, int, int)   -- key, expected, logged
  | ApprovalCursorDisagrees(int, int)   -- cursor delta, recorded approvals served
  | LogNotDense(int, int)               -- expected ordinal, found
  | EmptyLog

export pure func discovery_rule(f: DiscoveryFinding) -> string {
  match f {
    UnderRecorded(_, _, _) => "discovery-under-recorded",
    OverRecorded(_, _, _) => "discovery-over-recorded",
    ClockUnaccounted(_, _) => "discovery-clock-unaccounted",
    EnvKeyNotInSource(_) => "discovery-env-key-not-in-source",
    EnvReadUnderRecorded(_, _, _) => "discovery-env-read-under-recorded",
    EnvReadOverRecorded(_, _, _) => "discovery-env-read-over-recorded",
    ApprovalCursorDisagrees(_, _) => "discovery-approval-cursor-disagrees",
    LogNotDense(_, _) => "discovery-log-not-dense",
    EmptyLog => "discovery-empty-log"
  }
}

export pure func discovery_message(f: DiscoveryFinding) -> string {
  match f {
    UnderRecorded(kind, w, l) =>
      "[discovery-under-recorded] the driver made ${w} '${kind}' request(s) and the interaction log records ${l}; the log does not account for the execution that ran, and a replay of it would assert a shorter run than the one it claims to reproduce",
    OverRecorded(kind, w, l) =>
      "[discovery-over-recorded] the interaction log records ${l} '${kind}' request(s) and the driver made ${w}; the recorder logged a request the driver never issued, and strict replay would report the surplus as an unused interaction — a HarnessFailure naming the recorder's defect as if it were the system's",
    ClockUnaccounted(delta, sum) =>
      "[discovery-clock-unaccounted] the world clock advanced ${delta}ms and the recorded advances sum to ${sum}ms; D4 makes the explicit clock the only clock, so an unaccounted advance means some interaction moved time without recording that it did",
    EnvKeyNotInSource(k) =>
      "[discovery-env-key-not-in-source] the log records a read of '${k}', which no `ports.env_get` call site in the driver can produce; the env class has no runtime witness, so an invented key is the one over-recording failure its static evidence CAN see",
    EnvReadUnderRecorded(k, e, l) =>
      "[discovery-env-read-under-recorded] this scenario's control flow reaches ${e} read(s) of '${k}' and the log records ${l}; the env class has no runtime witness, so this count is derived from the driver's source and the scenario's control flow — provenance evidence, not capability evidence, and it must be reported as a different KIND from the other six classes rather than added into one completeness number",
    EnvReadOverRecorded(k, e, l) =>
      "[discovery-env-read-over-recorded] the log records ${l} read(s) of '${k}' and this scenario's control flow reaches ${e}; a surplus read is an interaction strict replay will never consume, and for the env class it is the only over-recording failure the static evidence CAN see besides an invented key",
    ApprovalCursorDisagrees(consumed, served) =>
      "[discovery-approval-cursor-disagrees] the world's approval cursor advanced by ${consumed} and the log records ${served} approval read(s) that were SERVED rather than end-of-input; the cursor witnesses which answers were consumed, not how many reads happened, and these two must agree exactly or the recorded outcome statuses do not describe the queue the run actually drained",
    LogNotDense(expected, found) =>
      "[discovery-log-not-dense] expected encounter ordinal ${expected} at this position but found ${found}; the ordinal is the global encounter order, so a gap means the recorder appended out of order or skipped a position",
    EmptyLog =>
      "[discovery-empty-log] the run recorded no interactions at all; a driver that requested nothing did not run, and every per-class balance below would be vacuously satisfied by a log that is simply absent"
  }
}

-- ---------------------------------------------------------------------------
-- The balance, in both directions, from one arithmetic site
-- ---------------------------------------------------------------------------

-- ONE comparison, TWO findings. Writing this as two separate predicates is the
-- shape that lets one of them be deleted, forgotten, or never written — which
-- is how a recorder ends up with a completeness check and no over-recording
-- check. Here the two directions are the two arms of a single `if`, so a future
-- edit cannot remove one without staring at the other.
export pure func class_balance(kind: string, witnessed: int, logged: int) -> [DiscoveryFinding] {
  if logged < witnessed then [UnderRecorded(kind, witnessed, logged)]
  else if logged > witnessed then [OverRecorded(kind, witnessed, logged)]
  else []
}

pure func contains_str(xs: [string], target: string) -> bool {
  match xs {
    [] => false,
    x :: rest => if x == target then true else contains_str(rest, target)
  }
}

-- Over-recording for env: every logged key must be one the source can produce.
pure func env_keys_not_in_source(logged: [string], known: [string]) -> [DiscoveryFinding] {
  match logged {
    [] => [],
    k :: rest =>
      (if contains_str(known, k) then [] else [EnvKeyNotInSource(k)])
        ++ env_keys_not_in_source(rest, known)
  }
}

pure func count_str(xs: [string], target: string) -> int {
  match xs {
    [] => 0,
    x :: rest => (if x == target then 1 else 0) + count_str(rest, target)
  }
}

-- Both directions for env, from ONE comparison site, exactly as `class_balance`
-- does for the witnessed classes. Presence would have been the easy check and
-- the wrong one; see `EnvExpectation`.
pure func env_balance(expected: [EnvExpectation], logged: [string]) -> [DiscoveryFinding] {
  match expected {
    [] => [],
    e :: rest => {
      let got = count_str(logged, e.key);
      (if got < e.count then [EnvReadUnderRecorded(e.key, e.count, got)]
       else if got > e.count then [EnvReadOverRecorded(e.key, e.count, got)]
       else [])
        ++ env_balance(rest, logged)
    }
  }
}

-- The recorder assigns ordinals; density is the check that it assigned them
-- from one counter rather than per class. A per-class counter produces a log
-- whose ordinals repeat across classes, which stage 1's `duplicate_ordinals`
-- would also catch — this catches it at discovery time, with the recorder still
-- in scope, rather than at validation time with only the artifact in hand.
pure func dense(xs: [Interaction], expected: int) -> [DiscoveryFinding] {
  match xs {
    [] => [],
    i :: rest =>
      if i.identity.ordinal == expected then dense(rest, expected + 1)
      else [LogNotDense(expected, i.identity.ordinal)] ++ dense(rest, expected + 1)
  }
}

-- Classes with no witness of their own under `driver_only`, checked at zero in
-- BOTH directions. This is not filler: `driver_only` installs no extensions and
-- the randomness guard asserts no `src/core` module reaches `std/rand`, so a
-- non-zero count here is a recorder inventing a class that cannot have run.
pure func absent_classes(log: [Interaction]) -> [DiscoveryFinding] {
  class_balance(identity_kind(ExtensionEffectIdentity("", "", "")), 0,
                count_kind(log, identity_kind(ExtensionEffectIdentity("", "", ""))))
    ++ class_balance(identity_kind(RandomDrawIdentity("")), 0,
                     count_kind(log, identity_kind(RandomDrawIdentity(""))))
}

-- The whole discovery gate, in one call.
--
-- Note what is NOT here: nothing compares the log against itself, and nothing
-- compares two runs. Determinism is a separate axis and it is asserted
-- separately in the script — across six clusters it has caught none of the
-- fifteen silent defects, precisely because a recorder that drops a class drops
-- it identically twice.
export pure func check_discovery(log: [Interaction], w: DiscoveryWitness) -> [DiscoveryFinding] {
  (if List.length(log) == 0 then [EmptyLog] else [])
    ++ dense(log, 0)
    ++ class_balance(identity_kind(ProviderIdentity("", 0, "")), w.provider_calls,
                     count_kind(log, identity_kind(ProviderIdentity("", 0, ""))))
    ++ class_balance(identity_kind(ToolIdentity("", "", "")), w.tool_dispatches,
                     count_kind(log, identity_kind(ToolIdentity("", "", ""))))
    ++ class_balance(identity_kind(ApprovalIdentity("", "", "")), w.approval_reads,
                     count_kind(log, identity_kind(ApprovalIdentity("", "", ""))))
    ++ (if approvals_served(log) == w.approvals_consumed then []
        else [ApprovalCursorDisagrees(w.approvals_consumed, approvals_served(log))])
    ++ (if total_advance_ms(log) == w.clock_delta_ms then []
        else [ClockUnaccounted(w.clock_delta_ms, total_advance_ms(log))])
    ++ env_keys_not_in_source(env_keys_read(log), driver_env_keys())
    ++ env_balance(w.expected_env_reads, env_keys_read(log))
    ++ absent_classes(log)
}

export pure func discovery_ok(log: [Interaction], w: DiscoveryWitness) -> bool {
  List.length(check_discovery(log, w)) == 0
}

export pure func has_discovery_rule(fs: [DiscoveryFinding], rule: string) -> bool {
  match fs {
    [] => false,
    f :: rest => if discovery_rule(f) == rule then true else has_discovery_rule(rest, rule)
  }
}

export pure func first_discovery_message(fs: [DiscoveryFinding]) -> string {
  match fs {
    [] => "(no findings)",
    f :: _ => discovery_message(f)
  }
}

-- ---------------------------------------------------------------------------
-- Per-class census, for D11's counters and for a legible failure
-- ---------------------------------------------------------------------------

export type ClassCensus = { kind: string, logged: int }

pure func census_of(kinds: [string], log: [Interaction]) -> [ClassCensus] {
  match kinds {
    [] => [],
    -- Parenthesised: a match arm body starting with `{` parses as a BLOCK on
    -- this pin, so a bare record literal here is a parse error at the `::`.
    k :: rest => ({ kind: k, logged: count_kind(log, k) }) :: census_of(rest, log)
  }
}

-- Iterates `all_interaction_kinds()` rather than a list written out here, so a
-- class added to `IdentityBody` appears in the census automatically instead of
-- being a class nobody counts.
export pure func census(log: [Interaction]) -> [ClassCensus] {
  census_of(all_interaction_kinds(), log)
}

export pure func census_line(cs: [ClassCensus]) -> string {
  match cs {
    [] => "",
    c :: [] => "${c.kind}=${c.logged}",
    c :: rest => "${c.kind}=${c.logged} ${census_line(rest)}"
  }
}

-- ---------------------------------------------------------------------------
-- Inline tests. These are the assertion's OWN negative controls: a checker that
-- only ever reports findings is as useless as a validator that only ever
-- rejects, and cluster 7 established that only a fixture which must SURVIVE can
-- see that.
-- ---------------------------------------------------------------------------

pure func mk(b: IdentityBody, ord: int, advance: int) -> Interaction {
  { identity: { ordinal: ord, body: b },
    request_projection: "p",
    deadline_ms: match b {
      ToolIdentity(_, _, _) => 0,
      ApprovalIdentity(_, _, _) => 0,
      ExtensionEffectIdentity(_, _, _) => 0,
      _ => -1
    },
    outcome: ok_outcome(advance, "") }
}

-- The negative control's fixture: a four-interaction log and the witness that
-- exactly accounts for it. Provider, tool, approval and a clock advance — one
-- of each class `driver_only` can reach — because a balanced fixture that omits
-- a class cannot show that the balance for that class is satisfiable at all.
pure func balanced_log() -> [Interaction] {
  [mk(ProviderIdentity("loop_v2", 0, "m"), 0, 0),
   mk(ToolIdentity("loop_v2", "c1", "T"), 1, 3),
   mk(ApprovalIdentity("loop_v2", "c1", "T"), 2, 0),
   mk(ClockAdvanceIdentity, 3, 1)]
}

pure func balanced_witness() -> DiscoveryWitness {
  { provider_calls: 1,
    tool_dispatches: 1,
    approval_reads: 1,
    approvals_consumed: 1,
    clock_delta_ms: 4,
    expected_env_reads: [] }
}

-- A balanced log and a matching witness must produce NO findings. This is the
-- negative control, and without it every assertion below is satisfied by a
-- checker that returns a finding unconditionally.
pure func test_a_balanced_log_produces_no_findings() -> bool
  tests [((), true)]
  {
    List.length(check_discovery(balanced_log(), balanced_witness())) == 0
  }

-- Under-recording: drop the tool interaction, keep the witness. This is the
-- failure the handoffs named.
pure func test_dropping_a_class_is_under_recorded() -> bool
  tests [((), true)]
  {
    let dropped = [mk(ProviderIdentity("loop_v2", 0, "m"), 0, 0),
                   mk(ClockAdvanceIdentity, 1, 1)];
    let fs = check_discovery(dropped, { balanced_witness() | clock_delta_ms: 1 });
    has_discovery_rule(fs, "discovery-under-recorded")
  }

-- Over-recording: log a tool interaction the witness does not account for. This
-- is the failure NOTHING in the handoffs named, and it is the reason this
-- module exists in this shape.
pure func test_inventing_an_interaction_is_over_recorded() -> bool
  tests [((), true)]
  {
    let invented = balanced_log() ++ [mk(ToolIdentity("loop_v2", "c2", "T"), 4, 0)];
    has_discovery_rule(check_discovery(invented, balanced_witness()),
                       "discovery-over-recorded")
  }

-- The clock cross-check is exact, and it is general: an interaction that moves
-- time without recording the move is invisible to every per-class count.
pure func test_an_unrecorded_advance_is_caught_by_the_clock() -> bool
  tests [((), true)]
  {
    has_discovery_rule(check_discovery(balanced_log(), { balanced_witness() | clock_delta_ms: 99 }),
                       "discovery-clock-unaccounted")
  }

-- Env, over-recording direction: a key no call site can produce.
pure func test_an_invented_env_key_is_rejected() -> bool
  tests [((), true)]
  {
    let bad = balanced_log() ++ [mk(EnvironmentReadIdentity("MOTOKO_NOT_A_REAL_KEY"), 4, 0)];
    has_discovery_rule(check_discovery(bad, balanced_witness()),
                       "discovery-env-key-not-in-source")
  }

-- Env, under-recording direction: a key the scenario reaches and the log omits.
pure func test_a_missing_expected_env_key_is_rejected() -> bool
  tests [((), true)]
  {
    has_discovery_rule(check_discovery(balanced_log(),
                         { balanced_witness() | expected_env_reads: [{ key: "OPENAI_BASE_URL", count: 1 }] }),
                       "discovery-env-read-under-recorded")
  }

-- Env, the MULTIPLICITY case. Two reads of one key expected, one recorded: the
-- log names the key, so a presence check passes and this must not. This is the
-- row that exists because the first version of the env check was presence-only.
pure func test_a_dropped_repeat_read_is_rejected() -> bool
  tests [((), true)]
  {
    let one_read = balanced_log() ++ [mk(EnvironmentReadIdentity("OPENAI_BASE_URL"), 4, 0)];
    let fs = check_discovery(one_read,
               { balanced_witness() | expected_env_reads: [{ key: "OPENAI_BASE_URL", count: 2 }] });
    has_discovery_rule(fs, "discovery-env-read-under-recorded")
  }

-- Env, over-recording direction: a legitimate key read more often than the
-- scenario's control flow can reach it.
pure func test_a_surplus_env_read_is_rejected() -> bool
  tests [((), true)]
  {
    let two_reads = balanced_log()
                      ++ [mk(EnvironmentReadIdentity("OPENAI_BASE_URL"), 4, 0),
                          mk(EnvironmentReadIdentity("OPENAI_BASE_URL"), 5, 0)];
    has_discovery_rule(check_discovery(two_reads,
                         { balanced_witness() | expected_env_reads: [{ key: "OPENAI_BASE_URL", count: 1 }] }),
                       "discovery-env-read-over-recorded")
  }

-- The ordinal is global. A recorder counting per class produces this.
pure func test_per_class_ordinals_are_not_dense() -> bool
  tests [((), true)]
  {
    let per_class = [mk(ProviderIdentity("loop_v2", 0, "m"), 0, 0),
                     mk(ToolIdentity("loop_v2", "c1", "T"), 0, 0)];
    has_discovery_rule(check_discovery(per_class, { balanced_witness() | clock_delta_ms: 0, approvals_consumed: 0 }),
                       "discovery-log-not-dense")
  }

-- `driver_only` installs no extensions and no driver module reaches std/rand,
-- so either class appearing at all is a recorder inventing a class.
pure func test_a_class_that_cannot_have_run_is_over_recorded() -> bool
  tests [((), true)]
  {
    let bad = balanced_log() ++ [mk(RandomDrawIdentity("0..10"), 4, 0)];
    has_discovery_rule(check_discovery(bad, balanced_witness()),
                       "discovery-over-recorded")
  }
