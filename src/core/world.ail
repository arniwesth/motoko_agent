-- src/core/world.ail
--
-- SPIKE ONLY — throwaway vertical slice for
-- .agent/projects/009_motoko_dst_execution/PLAN-spike-real-driver-vertical.md.
-- This is not the production migration and must never merge.
--
-- D1's driver-owned, state-threaded execution-world protocol, cut down to the
-- two request kinds the spike needs (provider exchange, clock read):
--
--   handle(world_state, world_request)
--     -> Result({ intermediate_emissions[], response, next_world_state }, HarnessError)
--
-- The driver owns `WorldState` and threads it alongside C2LoopState. Every
-- request returns the next state explicitly, including error outcomes. No
-- cursor, clock, or generator state hides in SharedMem, a process global, or a
-- mutable singleton — the whole point of D1 is that two test processes can run
-- the same program concurrently without interfering.
--
-- A live world delegates to the production adapter (StepProvider). A
-- deterministic world interprets the recorded program. The driver calls the
-- same functions in both cases; production code does not branch on test mode.

module src/core/world

import std/ai (Message, StepResult, AIError, StreamChunk, ContentDelta, ThinkingDelta, Usage)
import std/clock (now)
import std/list as List (length)
import std/result (Result, Ok, Err)
import std/string as Str (find, substring, length)
import std/trace as Trace
import pkg/sunholo/motoko_ext_abi/types (ExtRuntime)
import src/core/test/stub_step (StepProvider, ScriptedStep, dispatch_step, scripted_to_step_result)

-- ---------------------------------------------------------------------------
-- Program
-- ---------------------------------------------------------------------------

-- One resolved external interaction. `latency_ms` is the modelled duration of
-- the exchange; the world adds it to the virtual clock when the request
-- completes. `emissions` are the ordered intermediate chunks the exchange
-- produced, recorded at discovery and replayed verbatim.
export type ProgramEntry
  = ProviderReply({
      projection: string,
      latency_ms: int,
      emissions: [string],
      reply: ScriptedStep
    })
  | ProviderFailure({
      projection: string,
      latency_ms: int,
      emissions: [string],
      code: string,
      message: string,
      retryable: bool
    })

export pure func entry_projection(e: ProgramEntry) -> string {
  match e {
    ProviderReply(r) => r.projection,
    ProviderFailure(f) => f.projection
  }
}

export pure func entry_latency(e: ProgramEntry) -> int {
  match e {
    ProviderReply(r) => r.latency_ms,
    ProviderFailure(f) => f.latency_ms
  }
}

export pure func entry_emissions(e: ProgramEntry) -> [string] {
  match e {
    ProviderReply(r) => r.emissions,
    ProviderFailure(f) => f.emissions
  }
}

-- ---------------------------------------------------------------------------
-- World state
-- ---------------------------------------------------------------------------

-- Everything the run can observe that is not derivable from production state.
-- D1: this is a value the driver threads, never ambient mutable state.
export type WorldState = {
  now_ms: int,
  cursor: int,
  program: [ProgramEntry],
  interaction_log: [string],
  emission_log: [string]
}

export pure func initial_world(now_ms: int, program: [ProgramEntry]) -> WorldState {
  { now_ms: now_ms, cursor: 0, program: program, interaction_log: [], emission_log: [] }
}

export pure func empty_world(now_ms: int) -> WorldState {
  initial_world(now_ms, [])
}

-- The adapter. Mechanism, analogous to StepProvider — not a second behaviour
-- implementation. `LiveWorld` carries the production provider; `DeterministicWorld`
-- interprets `WorldState.program`.
export type World = LiveWorld | DeterministicWorld

export type HarnessError
  = ProgramExhausted({ position: int, actual_request: string })
  | ProgramMismatch({ position: int, expected: string, actual_request: string })

export pure func harness_error_message(e: HarnessError) -> string {
  match e {
    ProgramExhausted(x) =>
      "program exhausted at position ${show(x.position)}: ${x.actual_request}",
    ProgramMismatch(x) =>
      "program mismatch at position ${show(x.position)}: expected ${x.expected}, got ${x.actual_request}"
  }
}

-- ---------------------------------------------------------------------------
-- Emission projection
-- ---------------------------------------------------------------------------

-- One canonical string per chunk, so a live emission log and a replayed one
-- are comparable without carrying the whole ADT through the program schema.
export pure func describe_chunk(c: StreamChunk) -> string {
  match c {
    ContentDelta(t) => "content:${t}",
    ThinkingDelta(t) => "thinking:${t}",
    Usage(_) => "usage"
  }
}

export pure func emission_to_chunk(s: string) -> StreamChunk {
  ContentDelta(strip_kind(s))
}

-- Drop the "content:" / "thinking:" tag a recorded emission carries.
pure func strip_kind(s: string) -> string {
  let i = Str.find(s, ":");
  if i < 0 then s else Str.substring(s, i + 1, Str.length(s))
}

-- ---------------------------------------------------------------------------
-- Requests
-- ---------------------------------------------------------------------------

-- A provider exchange returns its ordered intermediate emissions alongside the
-- final typed outcome (D1). The live adapter projects each chunk at arrival;
-- the deterministic adapter projects each at its virtual arrival point. Both
-- return the identical log, and the driver appends it to the returned trace.
export type WorldExchange = {
  emissions: [string],
  outcome: Result[StepResult, AIError],
  next: WorldState,
  next_provider: StepProvider
}

export func world_provider_exchange(
  w: World,
  ws: WorldState,
  provider: StepProvider,
  rt: ExtRuntime,
  model: string,
  msgs: [Message],
  project: (StreamChunk) -> () ! {IO, Trace}
) -> Result[WorldExchange, HarnessError] ! {AI, IO, Trace} {
  let projection = "provider:${model}:msgs=${show(List.length(msgs))}";
  match w {
    LiveWorld => {
      -- Live: the production adapter runs and projects at arrival. The current
      -- std/ai API returns no emission log, so the live emission log is empty
      -- here; that is the open D1 substrate gate, not a modelling choice.
      --
      -- The provider is passed in rather than carried by `World`: its script
      -- cursor is already explicitly threaded through C2LoopState.provider,
      -- which satisfies D1. Capturing it in the adapter froze that cursor and
      -- silently replayed step 0 forever — see spike/README.md, Q1.
      let d = dispatch_step(provider, model, msgs, rt, project);
      Ok({
        emissions: [],
        outcome: d.result,
        next: { ws | interaction_log: ws.interaction_log ++ [projection] },
        next_provider: d.next_provider
      })
    },
    DeterministicWorld => {
      match entry_at(ws.program, ws.cursor) {
        None2 => Err(ProgramExhausted({ position: ws.cursor, actual_request: projection })),
        Some2(e) => {
          let emissions = entry_emissions(e);
          let _ = project_all(emissions, project);
          let advanced: WorldState = {
            now_ms: ws.now_ms + entry_latency(e),
            cursor: ws.cursor + 1,
            program: ws.program,
            interaction_log: ws.interaction_log ++ [projection],
            emission_log: ws.emission_log ++ emissions
          };
          match e {
            ProviderReply(r) =>
              Ok({
                emissions: emissions,
                outcome: Ok(scripted_to_step_result(r.reply)),
                next: advanced,
                next_provider: provider
              }),
            ProviderFailure(f) =>
              Ok({
                emissions: emissions,
                outcome: Err({ code: f.code, message: f.message, retryable: f.retryable }),
                next: advanced,
                next_provider: provider
              })
          }
        }
      }
    }
  }
}

-- Clock reads return the current world time without advancing it (D4). The
-- deterministic branch never performs the Clock effect, so a run with the
-- Clock capability withheld executes to completion — the coarse fail-closed
-- backstop D4 names.
export type WorldClockRead = { value: int, next: WorldState }

export func world_clock_now(w: World, ws: WorldState) -> WorldClockRead ! {Clock} {
  match w {
    LiveWorld => { value: now(), next: ws },
    DeterministicWorld => { value: ws.now_ms, next: ws }
  }
}

-- Explicit movement. Rejects negative movement (D4).
export pure func world_advance(ws: WorldState, delta: int) -> Result[WorldState, string] {
  if delta < 0 then Err("negative clock advance: ${show(delta)}")
  else Ok({ ws | now_ms: ws.now_ms + delta })
}

-- ---------------------------------------------------------------------------
-- Helpers
-- ---------------------------------------------------------------------------

type Maybe2 = None2 | Some2(ProgramEntry)

pure func entry_at(program: [ProgramEntry], idx: int) -> Maybe2 {
  match program {
    [] => None2,
    e :: rest => if idx <= 0 then Some2(e) else entry_at(rest, idx - 1)
  }
}

func project_all(emissions: [string], project: (StreamChunk) -> () ! {IO, Trace}) -> () ! {IO, Trace} {
  match emissions {
    [] => (),
    e :: rest => {
      let _ = project(emission_to_chunk(e));
      project_all(rest, project)
    }
  }
}
