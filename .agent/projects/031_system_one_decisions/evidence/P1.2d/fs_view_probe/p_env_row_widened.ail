-- P1.2d probe 2 (expect REJECT): the same render declares {FS, Env}; the
-- ExitIntent payload row is closed at {FS}.
module local/p12d/p_env_row_widened
import std/env (getEnvOr)
import std/json (jo)
import pkg/sunholo/motoko_ext_abi/types (FsCtx, ExitIntentOutcome, ExtRegistration, ExitIntent)

func herdr_exit(ctx: FsCtx) -> ExitIntentOutcome ! {FS, Env} {
  let pane = getEnvOr("HERDR_PANE_ID", "");
  let read = ctx.ports.file_read(ctx.world, "${ctx.workdir}/.dagr/run-${pane}.json");
  { actions: [], next_state: read.next_state }
}

export func register_with_config(_cfg: a) -> ExtRegistration {
  { config: jo([]), caps: [ExitIntent("delegate-panes", true, herdr_exit)] }
}
