-- 031 PLAN-001 P1.4r -- END TO END, PER VARIANT: P0.6's two scripted
-- consumers dispatched through the line-R decision cursor in
-- `src/core/ext/runtime.ail`, the HOST context now carrying NO decision state
-- (`decision_state: None`, as every host literal does). The state each
-- consumer reads is the one the CURSOR stamps from its own descriptor.
--
-- Built into the P1.4r workspace (`p14r_check.sh e2e`) at
-- `src/p14r/cursor_e2e.ail`; it imports the real runtime and the real example
-- consumers (`packages/motoko_ext_conformance/examples/`), registered through
-- their own `register_with_config`. Nothing here is a copy of a consumer.
--
-- For each variant, everything below goes THROUGH THE DISPATCHER:
--   1. P1.3r's votes, unchanged: dispatched alone the merged vote is the
--      consumer's abstention on the stub's `Unavailable(UnconfiguredBackend)`
--      (`NoDecision` / `NoOpinion`); with a legacy atom behind it the next
--      atom runs and its vote merges (`Accept` / `Pending`).
--   2. THE STATE IT IS HANDED: a probe wrapping the consumer's slot reports
--      that the view carries `Some`, with the consumer's descriptor limit,
--      both projections BYTE-EQUAL to what its registration disclosed, and
--      every ledger term zero.
--   3. PREPARE READS `question_config` FROM IT: the consumer's own `prepare`,
--      dispatched, queries with the binding from its `question_config` (with
--      `None` it would vote immediately).
--   4. INTERPRET READS `interpretation_config` FROM IT: the consumer's own
--      `interpret`, dispatched with the stub's observation swapped for a
--      scripted `Answered`, applies the threshold of ITS registration: the
--      default threshold intervenes, a registration with a threshold on the
--      other side of the answer abstains.
-- The host's evidence (failed verification, two failed Bash calls) is a
-- SCRIPTED context -- line X constructs real evidence -- chosen so that both
-- consumers ask. The context's `clock_now` port is a TRIPWIRE: if anything
-- calls it the run faults and exits nonzero. Everything here is synthetic.
-- Exit 1 on any mismatch.
module src/p14r/cursor_e2e

import std/io (println, exit)
import std/json (Json, jo, ja, kv, js, jnum, getObject, encode)
import std/option (Option, Some, None)
import std/string (find)
import pkg/sunholo/motoko_ext_abi/types (
  ExtCtx, ExtEntry, ExtRuntime, ExtWorld, ExtClockReading, ExtRegistration, Capability, PureCtx,
  DecisionSolverJudge, DecisionToolPolicy, SolverJudge, ToolPolicy, ProcessCtx, FinalizeOutcome,
  DecisionInvocationState, EnforcingDecision, DecisionObservation, DecisionRequest, Answered, BinaryAnswer,
  JudgePreparation, JudgeImmediate, JudgeQuery, ToolPreparation, ToolImmediate, ToolQuery,
  FinalizeDecision, Accept, ContinueWithFeedback, NoDecision,
  ToolPolicyDecision, Allow, Deny, NoOpinion, Pending, DenyAfterTimeout,
  ToolCallEnvelope, VerificationEvidence, Failed, ToolEvidence, CommandExit
)
import src/core/config (VerificationConfig)
import src/core/ext_world (clear_holder)
import src/core/ext/ctx_defaults (noop_ext_ports, empty_ext_artifacts, zero_token_telemetry)
import src/core/ext/runtime (dispatch_solver_candidate, dispatch_tool_policy)
import pkg/sunholo/motoko_ext_conformance/examples/completion_guard (register_with_config as register_completion)
import pkg/sunholo/motoko_ext_conformance/examples/repeat_failure_policy (register_with_config as register_repeat)

-- ---------------------------------------------------------------------------
-- The host's context: full ExtCtx, NO decision state, tripwire clock
-- ---------------------------------------------------------------------------

-- The port's row is closed at `{Clock}`, so the tripwire cannot print: it
-- FAULTS instead (integer division by zero), which aborts the run nonzero.
func tripwire_clock(world: ExtWorld) -> ExtClockReading ! {Clock} {
  let zero = length_of(world.token);
  { now_ms: 1 / zero, next_state: world }
}

pure func length_of(_j: Json) -> int { 0 }

pure func e2e_world() -> ExtWorld { { token: jo([kv("trace", js("e2e;"))]) } }

pure func failed_verification() -> VerificationEvidence {
  Failed({ occurrence: "v1", step: 3, command: "make test", exit_code: Some(2), output: "1 failed", truncated: false, workspace_revision: None })
}

pure func failure(call_id: string, step: int) -> ToolEvidence {
  { call_id: call_id, step: step, tool_name: "Bash", outcome: CommandExit(1), output: "", truncated: false, workspace_revision: None }
}

func e2e_ctx() -> ExtCtx {
  {
    task: "e2e",
    step: 4,
    model: "m",
    cwd: ".",
    hybrid_tools: true,
    budget: { total: 10, solver: 6, verifier: 4 },
    mode: "default",
    workdir: ".",
    env_server_url: "",
    budget_remaining: 10,
    history_slice: [],
    state_key: "k",
    finish_reason: "",
    work_in_flight: [],
    open_waits: ja([]),
    context_limit: 0,
    ports: { noop_ext_ports() | clock_now: tripwire_clock },
    artifacts: empty_ext_artifacts(),
    telemetry: zero_token_telemetry(),
    verification: failed_verification(),
    tool_evidence: { records: [failure("c1", 1), failure("c2", 2)], complete_from_session_start: true, omitted_count: Some(0) },
    decision_state: None,
    world: e2e_world()
  }
}

pure func rt_of(entries: [ExtEntry]) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "make test" };
  { registry: { entries: entries }, strict_mode: false, verification: v }
}

pure func entry_of(id: string, reg: ExtRegistration) -> ExtEntry { { id: id, config: reg.config, caps: reg.caps } }

func accept_after(ctx: ProcessCtx, _c: string) -> FinalizeOutcome ! {Process} { { decision: Accept, next_state: ctx.world } }

pure func pending_after(_ctx: PureCtx, _call: ToolCallEnvelope) -> ToolPolicyDecision { Pending("next atom ran", DenyAfterTimeout) }

pure func answered(qid: string, bp: int) -> DecisionObservation {
  { result: Answered({ answers: [{ question_id: qid, answer: BinaryAnswer(bp) }] }), usage: { input_tokens: None, output_tokens: None, cost_millicents: None } }
}

pure func proj(cfg: Json, key: string) -> Json { match getObject(cfg, key) { Some(v) => v, None => jo([kv("absent", js(key))]) } }

pure func limit_of(cfg: Json) -> string { encode(match getObject(cfg, "max_interventions") { Some(v) => v, None => js("absent") }) }

-- What the handed state says, against the REGISTRATION's disclosed config
-- (the descriptor's projections are the same values, P0.6's contract).
pure func state_report(reg: ExtRegistration, st: Option[DecisionInvocationState]) -> string {
  match st {
    None => "None",
    Some(s) => {
      let q = encode(s.question_config) == encode(proj(reg.config, "question_config"));
      let i = encode(s.interpretation_config) == encode(proj(reg.config, "interpretation_config"));
      let lim = show(s.intervention_limit) == limit_of(reg.config);
      let zero = s.interventions_used == 0 && s.allowance_millicents == 0 && s.known_spend_millicents == 0
        && s.outstanding_millicents == 0 && s.run_cost_millicents == 0
        && (match s.run_cap_millicents { None => true, Some(_) => false });
      let enforcing = match s.mode { EnforcingDecision => true, _ => false };
      "Some(${s.invocation_id}) question_config=${if q then "same" else "DIFFERENT"} interpretation_config=${if i then "same" else "DIFFERENT"} limit=${if lim then "own" else "OTHER"} ledger=${if zero then "zero" else "NONZERO"} mode=${if enforcing then "enforcing" else "OTHER"}"
    }
  }
}

pure func contains(hay: string, needle: string) -> bool { find(hay, needle) >= 0 }

-- ---------------------------------------------------------------------------
-- Labels
-- ---------------------------------------------------------------------------

pure func judge_label(d: FinalizeDecision) -> string {
  match d { Accept => "Accept", NoDecision => "NoDecision", ContinueWithFeedback(_) => "ContinueWithFeedback" }
}

pure func tool_label(d: ToolPolicyDecision) -> string {
  match d { Allow => "Allow", NoOpinion => "NoOpinion", Deny(_) => "Deny", Pending(r, _) => "Pending(${r})" }
}

func check(label: string, got: string, want: string) -> bool ! {IO} {
  let ok = got == want;
  let _ = println("  ${if ok then "ok  " else "FAIL"} ${label}: ${got}${if ok then "" else " (want ${want})"}");
  ok
}

-- ---------------------------------------------------------------------------
-- Finalize: the completion guard
-- ---------------------------------------------------------------------------

pure func judge_feedback(d: FinalizeDecision) -> string { match d { ContinueWithFeedback(m) => m, _ => "" } }

func finalize_case() -> bool ! {Process, IO, Clock} {
  let _ = println("finalize (completion_guard, DecisionSolverJudge):");
  let reg = register_completion(jo([]));
  let strict = register_completion(jo([kv("min_complete_bp", jnum(1000.0))]));
  let ctx = e2e_ctx();
  let host = check("host context decision_state", match ctx.decision_state { None => "None", Some(_) => "Some" }, "None");
  let candidate = "Done: all tests pass.";
  let legacy: ExtEntry = { id: "after", config: jo([]), caps: [SolverJudge(accept_after)] };
  let alone = dispatch_solver_candidate(rt_of([entry_of("completion_guard#0", reg)]), ctx, candidate);
  let a = check("dispatched alone, merged vote", judge_label(alone.decision), "NoDecision");
  let w = check("successor world is the input world", encode(alone.next_state.token), encode(clear_holder(e2e_world()).token));
  let behind = dispatch_solver_candidate(rt_of([entry_of("completion_guard#0", reg), legacy]), ctx, candidate);
  let b = check("with a legacy Accept behind it, merged vote", judge_label(behind.decision), "Accept");
  let probes = match (reg.caps, strict.caps) {
    (DecisionSolverJudge(d, prepare, interpret) :: _, DecisionSolverJudge(sd, sprepare, sinterpret) :: _) => {
      let report_now = \view c. JudgeImmediate(ContinueWithFeedback(state_report(reg, view.decision_state)));
      let seen = judge_feedback(dispatch_solver_candidate(rt_of([{ id: "completion_guard#0", config: reg.config, caps: [DecisionSolverJudge(d, report_now, interpret)] }]), ctx, candidate).decision);
      let s = check("state handed to the atom", seen, "Some(completion_guard#0/finalize/example.completion_guard) question_config=same interpretation_config=same limit=own ledger=zero mode=enforcing");
      let asked = \view c. match prepare(view, c) { JudgeQuery(req) => JudgeImmediate(ContinueWithFeedback("JudgeQuery(${req.backend_binding})")), JudgeImmediate(v) => JudgeImmediate(v) };
      let q = check("its own prepare, dispatched", judge_feedback(dispatch_solver_candidate(rt_of([{ id: "completion_guard#0", config: reg.config, caps: [DecisionSolverJudge(d, asked, interpret)] }]), ctx, candidate).decision), "JudgeQuery(completion-judge)");
      let scripted = \view c req _obs. interpret(view, c, req, answered("task_complete", 1500));
      let voted = dispatch_solver_candidate(rt_of([{ id: "completion_guard#0", config: reg.config, caps: [DecisionSolverJudge(d, prepare, scripted)] }]), ctx, candidate).decision;
      let i1 = check("its own interpret on Answered(1500 bp), default threshold", judge_label(voted), "ContinueWithFeedback");
      let i2 = check("  feedback names the threshold from interpretation_config", if contains(judge_feedback(voted), "below the 6000 bp threshold") then "6000" else judge_feedback(voted), "6000");
      let sscripted = \view c req _obs. sinterpret(view, c, req, answered("task_complete", 1500));
      let i3 = check("a registration with min_complete_bp 1000, same answer", judge_label(dispatch_solver_candidate(rt_of([{ id: "completion_guard#0", config: strict.config, caps: [DecisionSolverJudge(sd, sprepare, sscripted)] }]), ctx, candidate).decision), "NoDecision");
      s && q && i1 && i2 && i3
    },
    _ => check("registration", "no DecisionSolverJudge first", "DecisionSolverJudge")
  };
  host && a && w && b && probes
}

-- ---------------------------------------------------------------------------
-- Tool policy: the repeat-failure policy
-- ---------------------------------------------------------------------------

pure func tool_feedback(d: ToolPolicyDecision) -> string { match d { Deny(m) => m, _ => "" } }

func tool_case() -> bool ! {IO, Clock} {
  let _ = println("tool_policy (repeat_failure_policy, DecisionToolPolicy):");
  let reg = register_repeat(jo([]));
  let lax = register_repeat(jo([kv("deny_min_bp", jnum(9500.0))]));
  let ctx = e2e_ctx();
  let call: ToolCallEnvelope = { id: "c3", tool: "Bash", arguments: jo([kv("cmd", js("make test"))]) };
  let legacy: ExtEntry = { id: "after", config: jo([]), caps: [ToolPolicy(pending_after)] };
  let a = check("dispatched alone, merged vote", tool_label(dispatch_tool_policy(rt_of([entry_of("repeat_failure_policy#0", reg)]), ctx, call)), "NoOpinion");
  let b = check("with a legacy Pending behind it, merged vote", tool_label(dispatch_tool_policy(rt_of([entry_of("repeat_failure_policy#0", reg), legacy]), ctx, call)), "Pending(next atom ran)");
  let probes = match (reg.caps, lax.caps) {
    (DecisionToolPolicy(d, prepare, interpret) :: _, DecisionToolPolicy(ld, lprepare, linterpret) :: _) => {
      let report_now = \view c. ToolImmediate(Deny(state_report(reg, view.decision_state)));
      let seen = tool_feedback(dispatch_tool_policy(rt_of([{ id: "repeat_failure_policy#0", config: reg.config, caps: [DecisionToolPolicy(d, report_now, interpret)] }]), ctx, call));
      let s = check("state handed to the atom", seen, "Some(repeat_failure_policy#0/tool_policy/example.repeat_failure_policy) question_config=same interpretation_config=same limit=own ledger=zero mode=enforcing");
      let asked = \view c. match prepare(view, c) { ToolQuery(req) => ToolImmediate(Deny("ToolQuery(${req.backend_binding})")), ToolImmediate(v) => ToolImmediate(v) };
      let q = check("its own prepare, dispatched", tool_feedback(dispatch_tool_policy(rt_of([{ id: "repeat_failure_policy#0", config: reg.config, caps: [DecisionToolPolicy(d, asked, interpret)] }]), ctx, call)), "ToolQuery(repeat-failure-judge)");
      let scripted = \view c req _obs. interpret(view, c, req, answered("repeats_failure", 9000));
      let i1 = check("its own interpret on Answered(9000 bp), default threshold", tool_label(dispatch_tool_policy(rt_of([{ id: "repeat_failure_policy#0", config: reg.config, caps: [DecisionToolPolicy(d, prepare, scripted)] }]), ctx, call)), "Deny");
      let lscripted = \view c req _obs. linterpret(view, c, req, answered("repeats_failure", 9000));
      let i2 = check("a registration with deny_min_bp 9500, same answer", tool_label(dispatch_tool_policy(rt_of([{ id: "repeat_failure_policy#0", config: lax.config, caps: [DecisionToolPolicy(ld, lprepare, lscripted)] }]), ctx, call)), "NoOpinion");
      s && q && i1 && i2
    },
    _ => check("registration", "no DecisionToolPolicy first", "DecisionToolPolicy")
  };
  a && b && probes
}

export func main() -> () ! {Process, IO, Clock} {
  let f = finalize_case();
  let t = tool_case();
  let _ = println("END_TO_END finalize=${if f then "PASS" else "FAIL"} tool_policy=${if t then "PASS" else "FAIL"}");
  if f && t then () else exit(1)
}
