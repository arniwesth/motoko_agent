  classDef value fill:#3a2f12,stroke:#e0af68,color:#f2e2c2,stroke-width:2.5px;
  classDef now fill:#16351f,stroke:#3fb950,color:#c6f0cf;
  classDef later fill:#2f2145,stroke:#bb9af7,color:#e5d5fb;
  classDef artifact fill:#2a2f3a,stroke:#9aa4b2,color:#d5dbe5,stroke-width:2px;
