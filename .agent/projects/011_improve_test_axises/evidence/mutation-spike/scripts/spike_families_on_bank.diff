+-- ============================================================================
+-- SPIKE ONLY — the invariant set over every bank member's REAL run. NEVER MERGES.
+-- ============================================================================
+-- One FAMROW per member. A = the set evaluated with the driver's structural retry
+-- bound (step budget 12, a retry needs remaining budget > 1, so at most 11) and NO
+-- declared decision budget. B = `stream_parity_dst.ail`'s literal budgets (12, 3),
+-- the only precedent in the tree. Both are printed; neither is a verdict.
+
+pure func spk_rules(vs: [Violation]) -> [string] {
+  match vs {
+    [] => [],
+    v :: rest => "${family_id(violation_family(v))}:${violation_rule(v)}" :: spk_rules(rest)
+  }
+}
+
+pure func spk_join(xs: [string]) -> string {
+  match xs {
+    [] => "",
+    x :: rest => match rest { [] => x, _ => "${x},${spk_join(rest)}" }
+  }
+}
+
+func spk_row(label: string, r: TracedSessionResult, clock0: int) -> () ! {IO} {
+  let a = evaluate(execution_of(r, clock0, NoReplay, 0 - 1, 11, 0, [], unknown_replay_metadata()));
+  let b = evaluate(execution_of(r, clock0, NoReplay, 12, 3, 0, [], unknown_replay_metadata()));
+  let ended = match r.result { Ok(_) => "ok", Err(_) => "err" };
+  println("FAMROW ${label} ended=${ended} n=${List.length(r.world.log)} A=[${spk_join(spk_rules(a))}] B=[${spk_join(spk_rules(b))}]")
+}
+
+func spk_seeds(es: [BankEntry])
+  -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
+  match es {
+    [] => (),
+    e :: rest => {
+      let initial = generated_world(e.seed);
+      let r = run_generated("corpus_${e.seed}", initial);
+      let _ = spk_row("seed-${e.seed}", r, initial.clock_ms);
+      spk_seeds(rest)
+    }
+  }
+}
+
+export func families_probe() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
+  let _ = println("FAMPROBE begin");
+  let _ = spk_seeds(fixed_bank());
+  let initial = empty_terminal_world();
+  let r = run_recording("corpus_constructed", initial);
+  let _ = spk_row("constructed-empty-terminal", r, initial.clock_ms);
+  println("FAMPROBE end")
+}
