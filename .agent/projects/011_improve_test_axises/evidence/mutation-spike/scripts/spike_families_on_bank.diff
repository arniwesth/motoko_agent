+-- ============================================================================
+-- SPIKE ONLY, part 4 — the prototype. NEVER MERGES.
+-- ============================================================================
+-- A = the invariant set (driver's structural retry bound, no decision budget), which in
+-- this worktree carries the two prototype rule changes in dst_invariants.ail.
+-- X = three rules computed HERE from the run's own configuration and its two channels:
+--   step-budget:provider-calls-exceed-budget   provider calls in the trace > the step budget
+--   step-budget:retry-with-one-step-left        a StreamErrorRetry at step >= budget - 1
+--   census:provider-calls-unbalanced            provider calls in the TRACE != provider
+--                                               interactions in the world's LOG
+-- X is printed in the row's second slot so part 2's tested scorer reads it unchanged.
+
+pure func spk_prepared(rs: [LedgerRecord]) -> int {
+  match rs {
+    [] => 0,
+    r :: rest =>
+      (match r { WireRecord(e) => match e { ProviderCallPrepared(_) => 1, _ => 0 }, _ => 0 }) + spk_prepared(rest)
+  }
+}
+
+pure func spk_edge_retries(rs: [LedgerRecord], budget: int) -> int {
+  match rs {
+    [] => 0,
+    r :: rest =>
+      (match r {
+         WireRecord(e) => match e { StreamErrorRetry(i) => if i.step >= budget - 1 then 1 else 0, _ => 0 },
+         _ => 0
+       }) + spk_edge_retries(rest, budget)
+  }
+}
+
+pure func spk_log_providers(xs: [Interaction]) -> int {
+  match xs {
+    [] => 0,
+    i :: rest => (if interaction_kind(i) == "expect_provider" then 1 else 0) + spk_log_providers(rest)
+  }
+}
+
+pure func spk_messages(vs: [Violation]) -> [string] {
+  match vs { [] => [], v :: rest => violation_message(v) :: spk_messages(rest) }
+}
+
+func spk_say(label: string, xs: [string]) -> () ! {IO} {
+  match xs { [] => (), x :: rest => { let _ = println("FAMMSG ${label} | ${x}"); spk_say(label, rest) } }
+}
+
+func spk_row2(label: string, r: TracedSessionResult, clock0: int, budget: int) -> () ! {IO} {
+  let a = evaluate(execution_of(r, clock0, NoReplay, 0 - 1, budget - 1, 0, [], unknown_replay_metadata()));
+  let calls = spk_prepared(r.trace.records);
+  let logged = spk_log_providers(r.world.log);
+  let edge = spk_edge_retries(r.trace.records, budget);
+  let x1 = if calls > budget then ["step-budget:provider-calls-exceed-budget"] else [];
+  let x2 = if edge > 0 then ["step-budget:retry-with-one-step-left"] else [];
+  let x3 = if calls != logged then ["census:provider-calls-unbalanced"] else [];
+  let ended = match r.result { Ok(_) => "ok", Err(_) => "err" };
+  let _ = println("FAMROW ${label} ended=${ended} n=${List.length(r.world.log)} A=[${spk_join(spk_rules(a))}] B=[${spk_join(x1 ++ x2 ++ x3)}]");
+  let _ = spk_say(label, spk_messages(a));
+  println("FAMNUM ${label} provider_calls_trace=${calls} provider_calls_log=${logged} budget=${budget} edge_retries=${edge}")
+}
+
+func spk_seeds2(es: [BankEntry])
+  -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
+  match es {
+    [] => (),
+    e :: rest => {
+      let initial = generated_world(e.seed);
+      let r = run_generated("corpus_${e.seed}", initial);
+      let _ = spk_row2("seed-${e.seed}", r, initial.clock_ms, 12);
+      spk_seeds2(rest)
+    }
+  }
+}
+
+export func families_probe2() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
+  let _ = println("FAMPROBE begin");
+  let _ = spk_seeds2(fixed_bank());
+  let initial = empty_terminal_world();
+  let r = run_recording("corpus_constructed", initial);
+  let _ = spk_row2("constructed-empty-terminal", r, initial.clock_ms, 12);
+  println("FAMPROBE end")
+}
