flowchart TB
  %% What core's DP7 verifier does to a final answer, as built.
  %% Grounded 2026-10-09 at origin/main 36a96b1e:
  %%   src/core/session.ail:2218-2299 (the verifier), :3255-3310 (classify_candidate),
  %%   src/core/step_machine.ail:53-61 and :130-131 (the injected message),
  %%   src/core/ext/runtime.ail:919-925 (how the judges' decisions merge).
  %% 005 ADR-001 Amendment 1 and PLAN-finalize-policy-migration.md remove everything inside "DP7".
  %% The three "back to the model step" boxes are the same place as the top box. They are drawn
  %% as ends because this renderer lays a looping graph out upside down.
  %% Left out: the persist nudge (off by default), and response intercept and hybrid bash, which
  %% sit between the model step and the final answer and do not involve the verifier.
  %% Renderer notes (beautiful-mermaid 1.1.3): no ";" after a class line, or it becomes a node.

  model["<b>Model step</b><br/>the model returns a response"]
  qtools{"tool calls in<br/>the response?"}
  tools["<b>Tool phase</b><br/>each call passes the extensions' ToolPolicy, then runs<br/>repetition_guard's other half sits here: it refuses a call<br/>repeated with the same result, or carried by repeated prose"]
  back1["back to the model step<br/>with the tool results"]
  cand["<b>A final answer</b> · a response with no tool calls<br/>classify_candidate · session.ail:3255"]
  qblank{"is the answer<br/>blank?"}
  blanknote["a blank answer skips the verifier here and<br/>meets the same verifier after the judges"]

  subgraph DP7["DP7 · the verifier · built into core, not an extension · session.ail:2218-2299"]
    direction TB
    qon{"does the profile set<br/>verification.enabled?"}
    run["<b>run the profile's command in the workdir</b><br/>bash -c 'cd workdir && verification.command'<br/>until #251, eight profiles set it to <b>make check_core</b>"]
    qexit{"how did the<br/>command end?"}
    qinfra{"does the output look<br/>like missing setup?"}
    infranote["a substring match on the output:<br/>'no rule to make target' · 'no makefile found'<br/>'no such file or directory' · 'command not found'"]
    approve["<b>Approve</b><br/>nothing is recorded"]
    reject["<b>Reject</b><br/>emit dp7_verifier_rejected<br/>to the wire log, not the journal"]
  end

  inject["<b>Inject a message in the user's name</b><br/>'The code you just wrote does not type-check.<br/>Fix all errors before declaring done:'<br/>followed by the command's whole output"]
  back2["<b>back to the model step</b><br/>the model answers again, and the answer<br/>is verified again"]
  loopnote["<b>nothing counts the rejections</b><br/>the loop ends when the command passes, or at<br/>agent.max_steps, the cost cap or a full context window<br/>2026-10-08: 320 rejections · 2026-10-09: 57"]

  qwaits{"open waits?<br/>a delegate still running"}
  park["<b>Park</b><br/>until a wake arrives"]

  subgraph JUDGES["Extension judges · reached only after the verifier approves"]
    direction TB
    judges["<b>every SolverJudge, in profile order</b><br/>empty_stop_guard · progress_contract_guard · repetition_guard<br/>merge: ContinueWithFeedback beats Accept beats NoDecision"]
  end

  feedback["<b>Inject the guard's feedback</b><br/>each guard counts its own and stops"]
  back3["back to the model step"]
  done["<b>Finalize</b><br/>done event · run_summary"]

  model --> qtools
  qtools -->|"yes"| tools
  tools --> back1
  qtools -->|"no"| cand
  cand --> qblank
  qblank -->|"no"| qon
  qblank -->|"yes"| qwaits
  qblank -.-> blanknote
  qon -->|"no · the code default"| approve
  qon -->|"yes"| run
  run --> qexit
  qexit -->|"exit 0"| approve
  qexit -->|"could not start"| approve
  qexit -->|"non-zero exit"| qinfra
  qinfra -->|"yes"| approve
  qinfra -->|"no"| reject
  reject ==> inject
  inject ==> back2
  back2 -.-> loopnote
  qinfra -.-> infranote
  approve --> qwaits
  qwaits -->|"yes"| park
  qwaits -->|"no"| judges
  judges -->|"a guard continues"| feedback
  feedback --> back3
  judges -->|"Accept or NoDecision"| done

  classDef step fill:#1e2a4a,stroke:#7aa2f7,color:#c8d3f5
  classDef decision fill:#3a2f12,stroke:#e0af68,color:#f2e2c2,stroke-width:2.5px
  classDef dp7 fill:#2f2145,stroke:#bb9af7,color:#e5d5fb
  classDef danger fill:#3d1418,stroke:#f7768e,color:#fbd5db,stroke-width:2.5px
  classDef ext fill:#143d24,stroke:#56d364,color:#c6f0cf
  classDef leaf fill:#123038,stroke:#2ac3de,color:#bdeef5,stroke-width:2.5px
  classDef note fill:#262a30,stroke:#9aa4b0,color:#d6dbe2

  class model,tools,cand,park,feedback,back1,back3 step
  class qtools,qblank,qon,qexit,qinfra,qwaits decision
  class run,approve dp7
  class reject,inject,back2 danger
  class judges ext
  class done leaf
  class loopnote,blanknote,infranote note

  %% The rejection path, in the danger colour: qinfra-no, reject-inject, inject-back.
  linkStyle 15,16,17 stroke:#f7768e,stroke-width:2.5px
