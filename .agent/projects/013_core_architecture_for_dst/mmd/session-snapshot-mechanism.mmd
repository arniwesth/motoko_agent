flowchart TB
  %% 013 ADR-003 v4.1 — SESSION SNAPSHOT AND RESUME: the mechanism, from the loss at HEAD to the
  %% four processes that touch a snapshot (the traced run, the conversation loop, the host, the
  %% resumer) and what each decision makes true.
  %% Colour = role: blue a loss measured at HEAD · amber the ADR · green decided now (D1–D6, D8,
  %% PLAN-003 P1–P3) · purple decided but unscheduled (D7, PLAN-003 P4) · teal a capability with its
  %% proving gate in italics · gray-solid a file on disk · gray-dashed what stays out of scope.
  %% Layout note: the renderer lays same-rank nodes in a row and ignores invisible links, so the
  %% in-memory path is one vertical chain and the on-disk path a second chain beside it; the
  %% three processes are subgraphs so the writer rule (one process writes at a time) is visible.
  %% Grounded 2026-09-06: ADR-003 v4.1 at HEAD 97827bf, branch arniwesth/013-dst-architecture-adr,
  %% after four adversarial reviews (REVIEW-adr003-*-verdicts-fable.md) and the v2.1 review of
  %% ADR-002 whose §3 rejected the predecessor design. PLAN-003 v2.1 carries the phases.
  %% NOTHING in the green, teal or purple nodes exists at HEAD — this is the target.

  subgraph LOSS["What is lost at HEAD — session.ail, verified at 97827bf"]
    direction TB
    l1["<b>the history dies at the Fail arm</b><br/>call_model_or_fail returns Fail(Internal) at the budget<br/>:2437 passes totals and step_idx to c2_fail — not st.msgs"]:::cap
    l2["<b>the outer loops keep the pre-turn history</b><br/>TracedSessionResult is result · trace · world · emissions<br/>Err arms at :3421 and :3606 recurse with what they had before"]:::cap
    l3["<b>two ids in one log</b><br/>every traced run derives its own session_id at :3137<br/>the child env forwards MOTOKO_SESSION_MS, never the id"]:::cap
    l4["<b>nothing can be trusted back in</b><br/>world_of_json is total — every field has a fallback<br/>history_from_resume exists and has no caller"]:::cap
  end

  adr{"<b>ADR-003 v4.1</b><br/>a session suspends into a typed snapshot,<br/>and resume is a strict decode of it"}:::decision
  l1 --> adr
  l2 --> adr
  l3 --> adr
  l4 --> adr

  subgraph RUN["The traced run — c2_loop, one RunIdentity in, one result out"]
    direction TB
    d2["<b>D2 · typed suspension</b><br/>StepBudgetExhausted, its own code<br/>the Fail arm splits: c2_suspend builds the snapshot from st<br/>result stays Err · suspended: Some · written: Some"]:::now
    d1["<b>D1 · two objects, one envelope</b><br/>TurnSnapshot: boot inputs, history, world, cumulative counts<br/>ContinuationSnapshot: plus the loop state minus ports, trace, emissions, totals<br/>compat digests · task · RunIdentity"]:::now
    d3["<b>D3 · one writer at a time</b><br/>file_replace: a ported atomic leaf, class FileReplace, fs_atomic.ail<br/>after the P2 publish returns its world, before RunSummary<br/>frame opens at snapshot.world.ordinal · final = that + 2"]:::now
  end
  adr --> d2
  d2 --> d1
  d1 --> d3

  subgraph LOOP["The conversation loop — holds suspended · generation · run_ordinal · task · profile"]
    direction TB
    d5a["<b>D5 · identity</b><br/>session_id forwarded to the child — one id per log<br/>run_id = session.g&lt;generation&gt;.r&lt;ordinal&gt;, no clock read<br/>generation := written.generation, published or not"]:::now
    d6a["<b>D6 · in-process resume</b><br/>a suspended run does not exit<br/>next user_message → c2_state_from_continuation<br/>step_idx 0 · totals zero · prior_counts = cumulative<br/>→ the next traced run, same session, back into c2_loop above"]:::now
  end
  d2 -->|"suspended, written"| d5a
  d5a --> d6a

  snap[("<b>.motoko/sessions/&lt;id&gt;/snapshot.json</b><br/>replaced in place · generations kept for post-mortem<br/>0700 · 8 MiB cap · never in the JSONL log")]:::artifact
  d3 -->|"TurnEnd · BudgetExhausted · Park · Restart (child)"| snap

  subgraph HOST["The host — TUI, outermost process"]
    direction TB
    d5b["<b>D5 · the lease</b><br/>owner_pid in .motoko/sessions/&lt;id&gt;/lease<br/>its own unconditional exit and signal hooks, before the reporter<br/>MOTOKO_LEASE_HELD to the child · hostless runtime takes it itself"]:::now
    d2h["<b>D2 · the wire</b><br/>run_suspended replaces error on this path<br/>seven consumers, AgentEvent, three run-state enums<br/>herdr sees blocked with a message"]:::now
  end
  adr --> d5b
  d5b -->|"Abort update, after the child exits"| snap
  d2 -.->|"stdout"| d2h

  subgraph RESUME["The resumer — --resume &lt;session_id&gt;, a fresh process"]
    direction TB
    d4["<b>D4 · strict decode</b><br/>snapshot_of_json → a Result: the Snapshot, or a named Refusal<br/>whole-history digest · head prefix · valid transcript<br/>no fallbacks · the extension token keeps the total codec"]:::now
    d6b["<b>D6 · cross-process resume</b><br/>runtime and prompt rebuilt from the stored task<br/>same profile: prompt digest must match, or --resume-force<br/>new profile: accepted, head prefix replaced, ext_artifacts reset"]:::now
    d5c["<b>D5 · refusals and the seam</b><br/>refused: schema · workdir · ext set · live lease<br/>accepted and recorded: profile switch · model change<br/>SessionResumed opens the frame at from_ordinal,<br/>then the loop above runs with generation seeded from the snapshot"]:::now
  end
  snap -->|"read, under the lease"| d4
  d4 --> d6b
  d6b --> d5c

  u1["<b>the judging number</b><br/>after a budget stop, continue's first payload holds the exhausted history<br/>and the step count carries on<br/><i>gate: PLAN-003 P1 — DST fixture at budget 3 (8 messages), pure loop-rule tests, a live probe on rpc.main</i>"]:::unlocked
  u2["<b>a session survives its process</b><br/>respawn, restart into another profile, container restart<br/>with one id, one log, one directory<br/><i>gate: PLAN-003 P3 — a resume across a TUI respawn; a restart into a second profile with history intact</i>"]:::unlocked
  u3["<b>the plus-two, asserted once</b><br/>a snapshot then a finalize then a resumed frame:<br/>END₁.final == BEGIN₂.ordinal₀ + 2<br/><i>gate: PLAN-003 P2 — snapshot_resume_dst.ail, with PLAN-001 P2's ordinal</i>"]:::unlocked
  d6a --> u1
  d5c --> u2
  d3 --> u3

  d7["<b>D7 · durable park — unscheduled</b><br/>ContinuationSnapshot with reason Park after ParkEntered<br/>one owner per wake: runtime alive and wake_read returns, or<br/>--park-exits and the host's suspended-child state owns the request<br/>the persisted wake is consumed exactly once, through wake_read, from a seeded wakes cursor<br/>gates: ADR-002 D2 activated · ADR-001's between-turn frame"]:::later
  adr -.->|"what ADR-002 v3 D6 now points at"| d7
  d7 -.-> snap

  out["<b>out of scope — ADR-003 'Not decided'</b><br/>cost and context exhaustion as suspensions · a cumulative token total<br/>retention beyond three generations · checkpoint-chain continuity<br/>--resume of a headless one-shot · the snapshot-to-ExecutionProgram adapter"]:::capped
  adr -.-> out

