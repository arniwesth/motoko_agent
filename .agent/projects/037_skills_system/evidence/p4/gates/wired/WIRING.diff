# worktree's gitignored .motoko/herdr-delegates/p4/wired; nothing in it is committed.
# Root ailang.lock was regenerated by `ailang lock` and the registry by `make registry_gen`.

diff --git a/ailang.toml b/ailang.toml
index 195a8d0..a25a5c7 100644
--- a/ailang.toml
+++ b/ailang.toml
@@ -30,6 +30,7 @@ ailang = ">=0.47.2"
