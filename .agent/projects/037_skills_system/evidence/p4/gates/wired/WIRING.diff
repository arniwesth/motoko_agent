+"sunholo/motoko_ext_skills" = { path = "packages/motoko-ext-skills" }
 
 [extensions]
 packages      = [
@@ -52,6 +53,7 @@ packages      = [
   "sunholo/motoko_ext_repetition_guard@0.1.0",
   "sunholo/motoko_ext_agentcli@0.1.0",
   "sunholo/motoko_ext_herdr@0.1.0",
+  "sunholo/motoko_ext_skills@0.1.0",
 ]
 config_import   = "src/core/config.RuntimeConfig"
 # hooks_import is required by upstream's manifest loader and names a 5.x type
diff --git a/src/core/ext/registry_generated.ail b/src/core/ext/registry_generated.ail
index c013e95..cc65799 100644
--- a/src/core/ext/registry_generated.ail
+++ b/src/core/ext/registry_generated.ail
@@ -30,6 +30,7 @@ import pkg/sunholo/motoko_ext_progress_contract_guard/register (register_with_co
 import pkg/sunholo/motoko_ext_repetition_guard/register (register_with_config as register_repetition_guard)
 import pkg/sunholo/motoko_ext_agentcli/register (register_with_config as register_agentcli)
 import pkg/sunholo/motoko_ext_herdr/register (register_with_config as register_herdr)
+import pkg/sunholo/motoko_ext_skills/register (register_with_config as register_skills)
 import src/core/config (RuntimeConfig)
 import pkg/sunholo/motoko_ext_abi/types (ExtRegistration, ExtEntry)
 import pkg/sunholo/motoko_ext_abi/types (ExtRegistry)
@@ -61,6 +62,7 @@ func resolve(name: string, cfg: RuntimeConfig) -> Option[ExtRegistration] ! {AI,
   else if name == "repetition_guard" then Some(register_repetition_guard(cfg))
   else if name == "agentcli" then Some(register_agentcli(cfg))
   else if name == "herdr" then Some(register_herdr(cfg))
+  else if name == "skills" then Some(register_skills(cfg))
   else None
 }
 

