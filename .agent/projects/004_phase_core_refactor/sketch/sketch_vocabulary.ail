-- sketch_vocabulary.ail — substrate validation for the phase-core type vocabulary.
-- Companion to RESEARCH-phase-core-dst-design.md (D1-D8). NOT the implementation:
-- the deliverable is that this file CHECKS and the four pre-ADR questions have
-- answers (see ../RESEARCH-phase-core-dst-design.md and probe_* files here).
--
-- Q1 (opacity, answered by probes): variants with UNEXPORTED constructors are
--     sealed (IMP010 on constructor import); unexported TYPE NAMES are also not
--     importable, so records embedding History (StepState) must be CO-LOCATED in
--     the defining module. Exported record types are structurally forgeable, so
--     opacity requires a variant wrapper. Hence this single vocabulary module.
-- Q2 (event vocabularies): LedgerEvent is the typed superset; to_schema_v1
--     projects onto the existing production event contract (28 event types
--     inventoried below); ADR-001 canonical names map via ledger constructors.
-- Q3 (state_delta): patch-record style with Option fields + ONE application
--     point (apply_state_delta), mirroring single-point event emission.
-- Q4 (decision payloads): StepDecision variants carry named record types.
--
-- Toolchain: AILANG v0.26.0 (commit 3b52a24).

module sketch_vocabulary

import std/ai (Message, ToolCall)
import std/io (println)
import std/json (Json, jo, kv, js, jnum, encode)
import std/list (length)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)

-- ============================================================================
-- History: sealed. MkHistory is deliberately NOT exported — the only ways to
-- obtain a History are history_from_seed (session entry) and checkpoint (D7).
-- ============================================================================

type History = MkHistory([Message])

export func history_from_seed(msgs: [Message]) -> Result[History, string] {
  -- session-entry gate: system messages must form a head prefix (§7.1 case 1)
  if system_is_head_prefix(msgs, true)
  then Ok(MkHistory(msgs))
  else Err("history seed: system messages must form a head prefix")
}

export func history_append(h: History, m: Message) -> History {
  match h { MkHistory(xs) => MkHistory(xs ++ [m]) }
}

export func history_len(h: History) -> int {
  match h { MkHistory(xs) => length(xs) }
}

-- placeholder digest: real one hashes content; enough to prove the D7 shape
export func history_digest(h: History) -> string {
  match h { MkHistory(xs) => "h${show(length(xs))}" }
}

pure func system_is_head_prefix(msgs: [Message], still_head: bool) -> bool {
  match msgs {
    [] => true,
    m :: rest =>
      if m.role == "system"
      then still_head && system_is_head_prefix(rest, true)
      else system_is_head_prefix(rest, false)
  }
}

-- ============================================================================
-- Compaction pipeline types (§7.2): both sealed — a CompactableSegment only
-- comes from pinning, a ProviderPayload only from project().
-- ============================================================================

type CompactableSegment = MkSegment([Message])
type ProviderPayload = MkPayload([Message])

export func payload_messages(p: ProviderPayload) -> [Message] {
  match p { MkPayload(xs) => xs }
}

export type TokenTelemetry = {
  last_input_tokens: int,          -- actual tokens of the PREVIOUS payload (§7.1 case 5)
  last_output_tokens: int
}

export type CompactionPolicy = {
  context_limit: int,
  output_headroom: int,            -- exported constant per ADR-001 R5, not a literal
  actual_tiers: [int],             -- 60/75/85
  estimate_tiers: [int]            -- 70/85/95
}

-- The pure projection (§7.2). Sketch body: pin + passthrough; the real one
-- runs normalize -> ext compaction -> tiers -> emergency.
export func project(h: History, t: TokenTelemetry, pol: CompactionPolicy)
  -> Result[{ payload: ProviderPayload, events: [LedgerEvent] }, string] {
  match h {
    MkHistory(xs) =>
      if pol.context_limit > 0 && t.last_input_tokens >= pol.context_limit
      then Err("context exhausted")
      else Ok({
        payload: MkPayload(xs),
        events: [ProviderCallPrepared({ step: 0, msg_count: length(xs), payload_digest: "p${show(length(xs))}" })]
      })
  }
}

-- D7: the ONE op producing a rebuilt History, self-auditing (§7.4).
export type CheckpointPlan = { reason: string, summary: string }

export func checkpoint(h: History, plan: CheckpointPlan)
  -> { history: History, event: LedgerEvent } {
  match h {
    MkHistory(xs) => {
      let summary_msg: Message =
        { role: "assistant", content: "[CHECKPOINT] ${plan.summary}", tool_calls: [], tool_call_id: "" };
      let rebuilt = MkHistory([summary_msg]);
      {
        history: rebuilt,
        event: CheckpointTaken({
          reason: plan.reason,
          before_digest: history_digest(h),
          after_digest: history_digest(rebuilt)
        })
      }
    }
  }
}

-- ============================================================================
-- StepState (co-located because it embeds sealed History — Q1 consequence)
-- ============================================================================

export type LoopTotals = {
  input_tokens: int,
  output_tokens: int,
  cost_millicents: int,
  cost_warned_pct: int
}

export type StepPolicy = {
  step_budget: int,
  max_cost_millicents: int,
  persist_retries: int,            -- resolved ONCE at session init; no mid-loop Env reads
  retry_stream_errors: bool,
  compaction: CompactionPolicy
}

export type StepState = {
  step_idx: int,
  history: History,
  telemetry: TokenTelemetry,
  totals: LoopTotals,
  nudges_used: int,                -- replaces transcript marker scanning (§5)
  ext_artifacts: Json,             -- compaction summary cache etc. (§7.1 case 3)
  pending_decision_seed: string    -- placeholder for continuation-ish data
}

-- Q3: patch-style delta with ONE application point. Absent field = unchanged.
export type StateDelta = {
  telemetry: Option[TokenTelemetry],
  totals: Option[LoopTotals],
  nudges_used: Option[int],
  ext_artifacts: Option[Json]
}

export pure func empty_delta() -> StateDelta {
  { telemetry: None, totals: None, nudges_used: None, ext_artifacts: None }
}

-- The single place state changes are applied (mirror of single-point emission).
export func apply_state_delta(s: StepState, d: StateDelta) -> StepState {
  {
    step_idx: s.step_idx,
    history: s.history,
    telemetry: match d.telemetry { Some(t) => t, None => s.telemetry },
    totals: match d.totals { Some(t) => t, None => s.totals },
    nudges_used: match d.nudges_used { Some(n) => n, None => s.nudges_used },
    ext_artifacts: match d.ext_artifacts { Some(a) => a, None => s.ext_artifacts },
    pending_decision_seed: s.pending_decision_seed
  }
}

-- ============================================================================
-- StepDecision (Q4): decisions as data; payloads are named record types.
-- ============================================================================

export type ExecutorKind = ExecNative | ExecDelegated | ExecHandledByExt | ExecWsLoopback | ExecStreamIsland

export type ToolPlanEntry = { call: ToolCall, executor: ExecutorKind }
export type ToolPlan = { entries: [ToolPlanEntry] }

export type ApprovalRequest = { call: ToolCall, default_allow: bool, reason: string }
export type FinalizeInfo = { reason: string, output: string }
export type FailInfo = { code: string, message: string, retryable: bool }

export type StepDecision
  = CallModel(ProviderPayload)
  | RunTools(ToolPlan)
  | AwaitApproval(ApprovalRequest)
  | InjectUserMessage(Message)
  | TakeCheckpoint(CheckpointPlan)   -- D7; v1 policy never returns this
  | Finalize(FinalizeInfo)
  | Fail(FailInfo)

-- ============================================================================
-- PhaseResult (P2): what every phase returns. No 'continuation' field — the
-- step machine re-derives the next decision from applied state (see decide).
-- ============================================================================

export type PhaseResult = {
  delta: StateDelta,
  transcript_append: [Message],    -- consumed via history_append by the driver
  events: [LedgerEvent],
  cost_delta_millicents: int
}

-- ============================================================================
-- LedgerEvent (Q2): typed superset of BOTH vocabularies.
--
-- Existing production schema-v1 event types (inventoried 2026-07-02 from
-- agent_loop_v2.ail emit_event sites; the projection below must cover ALL of
-- these before Phase B ships — sketch covers a representative subset):
--   compaction_exhausted compaction_extension cost_exhausted cost_warning
--   delegated_tool_deferred done dp7_verifier_rejected error
--   ext_intercept_handled ext_solver_feedback ext_tool_handled
--   hybrid_bash_extracted native_tool_calls native_tool_denied
--   native_tool_results persist_nudge run_summary scratchpad_result
--   session_start session_suspend stream_error_retry thinking
--   thinking_delta thinking_stream_end thinking_stream_start tool_pending
--   v2_tool_dispatch_complete v2_tool_dispatch_start
--
-- ADR-001 canonical trace events map to constructors here:
--   provider_call_prepared -> ProviderCallPrepared
--   provider_result        -> ProviderResult
--   tool_policy_decision   -> ToolPolicyDecided
--   tool_result_appended   -> ToolResultAppended
--   loop_totals_updated    -> TotalsUpdated
-- ============================================================================

export type ProviderCallInfo = { step: int, msg_count: int, payload_digest: string }
export type ProviderResultInfo = { step: int, finish_reason: string, input_tokens: int, output_tokens: int }
export type PolicyInfo = { step: int, tool: string, call_id: string, decision: string, reason: string }
export type ToolResultInfo = { step: int, tool: string, call_id: string, exit_code: int }
export type CompactionInfo = { step: int, tier: int, note: string }
export type CostWarningInfo = { step: int, threshold_pct: int, total_millicents: int }
export type CheckpointInfo = { reason: string, before_digest: string, after_digest: string }
export type DoneInfo = { step: int, output: string, source: string }

export type LedgerEvent
  = ProviderCallPrepared(ProviderCallInfo)
  | ProviderResult(ProviderResultInfo)
  | ToolPolicyDecided(PolicyInfo)
  | ToolResultAppended(ToolResultInfo)
  | CompactionApplied(CompactionInfo)
  | ExtCompactionRejected(CompactionInfo)
  | CostWarning(CostWarningInfo)
  | PersistNudge(CompactionInfo)
  | TotalsUpdated(ProviderResultInfo)
  | CheckpointTaken(CheckpointInfo)
  | DoneEvent(DoneInfo)

-- Projection onto the existing schema-v1 wire contract (event names MUST
-- match production strings — this is the compatibility gate for the TUI and
-- eval harnesses).
export func to_schema_v1(e: LedgerEvent) -> Json {
  match e {
    ProviderCallPrepared(i) => jo([kv("type", js("provider_call_prepared")), kv("step", jnum(_int_to_float(i.step))), kv("msg_count", jnum(_int_to_float(i.msg_count))), kv("payload_digest", js(i.payload_digest))]),
    ProviderResult(i) => jo([kv("type", js("thinking")), kv("step", jnum(_int_to_float(i.step))), kv("finish_reason", js(i.finish_reason)), kv("input_tokens", jnum(_int_to_float(i.input_tokens))), kv("output_tokens", jnum(_int_to_float(i.output_tokens)))]),
    ToolPolicyDecided(i) => jo([kv("type", js(if i.decision == "deny" then "native_tool_denied" else "tool_pending")), kv("step", jnum(_int_to_float(i.step))), kv("tool", js(i.tool)), kv("id", js(i.call_id)), kv("reason", js(i.reason))]),
    ToolResultAppended(i) => jo([kv("type", js("native_tool_results")), kv("step", jnum(_int_to_float(i.step))), kv("tool", js(i.tool)), kv("id", js(i.call_id)), kv("exit_code", jnum(_int_to_float(i.exit_code)))]),
    CompactionApplied(i) => jo([kv("type", js("compaction_extension")), kv("step", jnum(_int_to_float(i.step))), kv("note", js(i.note))]),
    ExtCompactionRejected(i) => jo([kv("type", js("ext_compaction_rejected")), kv("step", jnum(_int_to_float(i.step))), kv("note", js(i.note))]),
    CostWarning(i) => jo([kv("type", js("cost_warning")), kv("step", jnum(_int_to_float(i.step))), kv("threshold", js("${show(i.threshold_pct)}pct")), kv("total_cost_millicents", jnum(_int_to_float(i.total_millicents)))]),
    PersistNudge(i) => jo([kv("type", js("persist_nudge")), kv("step", jnum(_int_to_float(i.step))), kv("note", js(i.note))]),
    TotalsUpdated(i) => jo([kv("type", js("loop_totals_updated")), kv("step", jnum(_int_to_float(i.step))), kv("input_tokens", jnum(_int_to_float(i.input_tokens))), kv("output_tokens", jnum(_int_to_float(i.output_tokens)))]),
    CheckpointTaken(i) => jo([kv("type", js("history_checkpoint")), kv("reason", js(i.reason)), kv("before_digest", js(i.before_digest)), kv("after_digest", js(i.after_digest))]),
    DoneEvent(i) => jo([kv("type", js("done")), kv("step", jnum(_int_to_float(i.step))), kv("output", js(i.output)), kv("source", js(i.source))])
  }
}

-- ============================================================================
-- Pure step machine skeleton (P1): decide is a pure function of StepState.
-- Real policy is richer; this proves decisions-as-data composes with the
-- sealed projection pipeline.
-- ============================================================================

export func decide(s: StepState, pol: StepPolicy) -> StepDecision {
  if pol.step_budget > 0 && s.step_idx >= pol.step_budget
  then Fail({ code: "Internal", message: "step budget exhausted", retryable: false })
  else if pol.max_cost_millicents > 0 && s.totals.cost_millicents >= pol.max_cost_millicents
  then Fail({ code: "BudgetExceeded", message: "cost cap reached", retryable: false })
  else match project(s.history, s.telemetry, pol.compaction) {
    Err(reason) => Fail({ code: "ContextExhausted", message: reason, retryable: false }),
    Ok(projection) => CallModel(projection.payload)
  }
}

-- ============================================================================
-- Inline pure tests + runnable demo
-- ============================================================================

pure func test_empty_delta_is_identity_shape() -> bool
  tests [((), true)]
  {
    match empty_delta().telemetry { None => true, Some(_) => false }
  }

func mk_msg(role: string, content: string) -> Message {
  { role: role, content: content, tool_calls: [], tool_call_id: "" }
}

export func main() -> () ! {IO} {
  let seed = [mk_msg("system", "you are motoko"), mk_msg("user", "fix the bug")];
  match history_from_seed(seed) {
    Err(e) => println("seed rejected: ${e}"),
    Ok(h) => {
      let pol: StepPolicy = {
        step_budget: 8,
        max_cost_millicents: 0,
        persist_retries: 0,
        retry_stream_errors: true,
        compaction: { context_limit: 200000, output_headroom: 75000, actual_tiers: [60, 75, 85], estimate_tiers: [70, 85, 95] }
      };
      let s: StepState = {
        step_idx: 0,
        history: h,
        telemetry: { last_input_tokens: 0, last_output_tokens: 0 },
        totals: { input_tokens: 0, output_tokens: 0, cost_millicents: 0, cost_warned_pct: 0 },
        nudges_used: 0,
        ext_artifacts: jo([]),
        pending_decision_seed: ""
      };
      match decide(s, pol) {
        CallModel(payload) => println("decision=CallModel msgs=${show(length(payload_messages(payload)))}"),
        Fail(f) => println("decision=Fail ${f.code}"),
        _ => println("decision=other")
      };
      let cp = checkpoint(h, { reason: "sketch-demo", summary: "2 msgs" });
      println("checkpoint event: ${encode(to_schema_v1(cp.event))}");
      println("history after cp: len=${show(history_len(cp.history))} digest=${history_digest(cp.history)}")
    }
  }
}
