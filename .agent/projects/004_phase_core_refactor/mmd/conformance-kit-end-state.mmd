  classDef file fill:#1e2a4a,stroke:#7aa2f7,color:#c8d3f5;
  classDef gate fill:#16294d,stroke:#7aa2f7,color:#cdd9f5,stroke-width:2px;
  classDef leaf fill:#123038,stroke:#2ac3de,color:#bdeef5,stroke-width:2.5px;

  class self,probe,harn,inv,fix new;
  class runtime,phasevocab,roottoml edited;
  class registrygen file;
  class aireg,streg frozen;
  class gself,gprobe gate;
  class abi leaf;
