  classDef decision fill:#3a2f12,stroke:#e0af68,color:#f2e2c2,stroke-width:2.5px;
  classDef terminal fill:#3a1620,stroke:#f7768e,color:#f7c6cf;

  class flag,pct,c1,c2,c3,struct,spos,sterm new;
  class sneg,sout,tmod edited;
  class decide,callmodel existing;
  class handler,cp,rebuilt frozen;
  class law leaf;
  class cmof decision;
  class fail,seal terminal;
