  %% decisions drive artifacts
  dA --> inv
  dB --> inv
  dC --> fix
  dD --> harn

  %% law move + acyclic dep direction (core to invariants to ABI)
  pv == "extract + retype on ABI Msg" ==> inv
  inv -- "core imports back" --> rt
  abi --> inv

  %% package wiring
  inv --> harn
  harn --> s1
  harn --> s2
  harn --> s3
  harn --> s4

  %% self-test (fail-then-pass)
  harn --> self
  fix -- "must FAIL" --> self
  ai -- "must PASS" --> self
  struct -- "must PASS" --> self
  self --> gself

  %% registry probe
  harn --> probe
  reg --> probe
  probe --> gprobe

