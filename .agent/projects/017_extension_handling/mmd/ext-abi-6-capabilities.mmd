  classDef ok fill:#16351f,stroke:#3fb950,color:#c6f0cf;
  classDef vote fill:#3a1620,stroke:#f7768e,color:#f7c6cf,stroke-dasharray:5 5;
  classDef keep fill:#16294d,stroke:#7aa2f7,color:#cdd9f5;
  classDef openq fill:#24262f,stroke:#6e7681,color:#9aa4b2,stroke-dasharray:5 5;
