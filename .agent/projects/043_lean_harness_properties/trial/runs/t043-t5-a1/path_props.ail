-- path_props.ail — exhaustive, executed property check of the REAL `path_up` / `find_entry`
-- (src/core/journal.ail:1392-1410, reached through gen/journal_t5.ail, an export-only copy
-- regenerated by gen_exports.sh), against its twin `ev_path_up` (src/eval/journal/reader.ail,
-- through gen/reader_t5.ail) and against the exported `strict_path` of the same reader.
--
-- The generator: every entry list of length 0..L whose entries are drawn from
--   id      in IDS      = a, b, c         (and "" with the `with_empty` entry point)
--   parent  in PARENTS  = "", a, b, c, z  ("" is the root sentinel, z names no entry)
-- with `seq` = position and `kind` = "header" exactly when the parent is "" (so `strict_path`,
-- which also demands a header root, can accept), and every start id in a, b, c, "", z.
-- Duplicate ids, self-parents, 2- and 3-cycles, cycles hanging off a chain, dangling parents
-- and empty lists are all in this space.
--
-- The properties, as executable statements over r = path_up(es, start, [], []):
--   P5.1  the call returns (the run finishing is the check; every case is a call)
--   P5.2  no id occurs twice in r
--   P5.3c each entry's parent_id is the id of the entry before it
--   P5.3l if some entry of es has id == start, r is non-empty and its last entry has id start
--   X-1   maximal: r == [] only if start is "" or names no entry; otherwise r's first entry's
--         parent_id is "", or names no entry, or is the id of an entry already in r
--         (D4 rule 1: the walk stops at the root, at a missing parent, or at the first repeat)
--   X-2   every entry of r is the FIRST entry of es with its id (find_entry's contract)
--   X-3   twin: r and ev_path_up(es, start, [], []) are the same entries (by seq)
--   X-4   where strict_path(es, start) is Ok(p), p and r are the same entries (by seq)
--
--   cd out && ./gen_exports.sh && ailang run --relax-modules --caps IO --entry main path_props.ail
--   ... --entry run --args-json '{"maxlen":3,"empty":true}'    (any length / alphabet)
--
-- Prints one count per property and up to 4 witnesses each; exits 1 on any violation.

module path_props

import std/io (println, exit)
import std/json (Json, jo)
import std/string as Str (join, concat, intToStr)
import std/list as List (length, map, foldl, range)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import gen/journal_t5 (path_up, JournalEntry)
import gen/reader_t5 (ev_path_up, strict_path, EvJournalEntry, source_refusal_family)

-- ---------------------------------------------------------------------------
-- The alphabet.
-- ---------------------------------------------------------------------------

pure func nth_s(xs: [string], i: int) -> string {
  match xs { [] => "?", x :: rest => if i == 0 then x else nth_s(rest, i - 1) }
}

pure func ids_of(empty: bool) -> [string] { if empty then ["a", "b", "c", ""] else ["a", "b", "c"] }
pure func parents() -> [string] { ["", "a", "b", "c", "z"] }
pure func starts() -> [string] { ["a", "b", "c", "", "z"] }

type Spec = { id: string, parent: string }

-- Option index k -> (id, parent): id = ids[k / 5], parent = parents[k % 5].
pure func spec_of(ids: [string], k: int) -> Spec {
  { id: nth_s(ids, k / 5), parent: nth_s(parents(), k % 5) }
}

-- Code c in [0, m^n) -> the n option indices, least significant first.
pure func digits(c: int, m: int, n: int) -> [int] {
  if n == 0 then [] else (c % m) :: digits(c / m, m, n - 1)
}

pure func pow(m: int, n: int) -> int { if n == 0 then 1 else m * pow(m, n - 1) }

pure func specs_of(ids: [string], ks: [int]) -> [Spec] {
  match ks { [] => [], k :: rest => spec_of(ids, k) :: specs_of(ids, rest) }
}

pure func kind_of(s: Spec) -> string { if s.parent == "" then "header" else "x" }

pure func core_es(ss: [Spec], i: int) -> [JournalEntry] {
  match ss {
    [] => [],
    s :: rest => { id: s.id, parent_id: s.parent, seq: i, at_ms: 0, kind: kind_of(s), raw: jo([]) } :: core_es(rest, i + 1)
  }
}

pure func twin_es(ss: [Spec], i: int) -> [EvJournalEntry] {
  match ss {
    [] => [],
    s :: rest => { id: s.id, parent_id: s.parent, seq: i, at_ms: 0, kind: kind_of(s), raw: jo([]) } :: twin_es(rest, i + 1)
  }
}

-- ---------------------------------------------------------------------------
-- The properties. Statements over the output, not a second implementation.
-- ---------------------------------------------------------------------------

pure func c_id(e: JournalEntry) -> string { e.id }
pure func c_seq(e: JournalEntry) -> int { e.seq }
pure func t_seq(e: EvJournalEntry) -> int { e.seq }

pure func mem_s(xs: [string], t: string) -> bool {
  match xs { [] => false, x :: rest => x == t || mem_s(rest, t) }
}

pure func has_dup(xs: [string]) -> bool {
  match xs { [] => false, x :: rest => mem_s(rest, x) || has_dup(rest) }
}

pure func is_chain(r: [JournalEntry]) -> bool {
  match r {
    [] => true,
    p :: rest => match rest {
      [] => true,
      q :: _ => q.parent_id == p.id && is_chain(rest)
    }
  }
}

pure func last_id(r: [JournalEntry]) -> Option[string] {
  match r { [] => None, x :: rest => match rest { [] => Some(x.id), _ => last_id(rest) } }
}

pure func names(ss: [Spec], id: string) -> bool {
  match ss { [] => false, s :: rest => s.id == id || names(rest, id) }
}

pure func p53_last(ss: [Spec], start: string, r: [JournalEntry]) -> bool {
  if not names(ss, start) then true
  else match last_id(r) { None => false, Some(l) => l == start }
}

pure func maximal(ss: [Spec], start: string, r: [JournalEntry]) -> bool {
  match r {
    [] => start == "" || not names(ss, start),
    h :: _ => h.parent_id == "" || not names(ss, h.parent_id) || mem_s(List.map(c_id, r), h.parent_id)
  }
}

-- The seq of the first spec with this id, -1 if none.
pure func first_seq(ss: [Spec], id: string, i: int) -> int {
  match ss { [] => -1, s :: rest => if s.id == id then i else first_seq(rest, id, i + 1) }
}

pure func all_first(ss: [Spec], r: [JournalEntry]) -> bool {
  match r { [] => true, e :: rest => first_seq(ss, e.id, 0) == e.seq && all_first(ss, rest) }
}

pure func ints_eq(a: [int], b: [int]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs => match b { [] => false, y :: ys => x == y && ints_eq(xs, ys) }
  }
}

-- ---------------------------------------------------------------------------
-- Rendering a witness.
-- ---------------------------------------------------------------------------

pure func show_id(s: string) -> string { if s == "" then "\"\"" else s }

pure func spec_text(s: Spec) -> string { "${show_id(s.id)}<${show_id(s.parent)}" }

pure func seqs_text(xs: [int]) -> string { concat(["[", join(",", List.map(intToStr, xs)), "]"]) }

pure func case_text(ss: [Spec], start: string) -> string {
  concat(["es=[", join(" ", List.map(spec_text, ss)), "] start=", show_id(start)])
}

-- ---------------------------------------------------------------------------
-- The fold over every case.
-- ---------------------------------------------------------------------------

type St = {
  cases: int,
  p52: int, p53c: int, p53l: int, p53l_empty: int,
  x1: int, x2: int, x3: int, x4: int, x4_empty: int, strict_ok: int,
  wits: [string], nwit: int
}

pure func st0() -> St {
  { cases: 0, p52: 0, p53c: 0, p53l: 0, p53l_empty: 0, x1: 0, x2: 0, x3: 0, x4: 0, x4_empty: 0, strict_ok: 0, wits: [], nwit: 0 }
}

pure func wit(st: St, tag: string, bad: bool, n_so_far: int, text: string) -> St {
  if bad && n_so_far < 4 then { st | wits: concat(["  ", tag, "  ", text]) :: st.wits, nwit: st.nwit + 1 } else st
}

pure func bump(b: bool) -> int { if b then 1 else 0 }

pure func check_case(ss: [Spec], st: St, start: string) -> St {
  let es = core_es(ss, 0);
  let tes = twin_es(ss, 0);
  let r = path_up(es, start, [], []);
  let tr = ev_path_up(tes, start, [], []);
  let rs = List.map(c_seq, r);
  let trs = List.map(t_seq, tr);
  let strict = strict_path(tes, start);
  let strict_seqs = match strict { Ok(p) => Some(List.map(t_seq, p)), Err(_) => None };
  let b52 = has_dup(List.map(c_id, r));
  let b53c = not is_chain(r);
  let b53l = not p53_last(ss, start, r);
  let bx1 = not maximal(ss, start, r);
  let bx2 = not all_first(ss, r);
  let bx3 = not ints_eq(rs, trs);
  let bx4 = match strict_seqs { None => false, Some(p) => not ints_eq(p, rs) };
  let strict_txt = match strict { Ok(p) => seqs_text(List.map(t_seq, p)), Err(e) => concat(["Err(", source_refusal_family(e), ")"]) };
  let text = concat([case_text(ss, start), "  path_up=", seqs_text(rs), " ev_path_up=", seqs_text(trs), " strict_path=", strict_txt]);
  let st1 = wit(st, "P5.2", b52, st.p52, text);
  let st2 = wit(st1, "P5.3c", b53c, st.p53c, text);
  let st3 = wit(st2, if start == "" then "P5.3l(start \"\")" else "P5.3l", b53l, if start == "" then st.p53l_empty else st.p53l, text);
  let st4 = wit(st3, "X-1", bx1, st.x1, text);
  let st5 = wit(st4, "X-2", bx2, st.x2, text);
  let st6 = wit(st5, "X-3", bx3, st.x3, text);
  let st7 = wit(st6, if start == "" then "X-4(start \"\")" else "X-4", bx4, if start == "" then st.x4_empty else st.x4, text);
  { st7 |
    cases: st.cases + 1,
    p52: st.p52 + bump(b52),
    p53c: st.p53c + bump(b53c),
    p53l: st.p53l + bump(b53l && start != ""),
    p53l_empty: st.p53l_empty + bump(b53l && start == ""),
    x1: st.x1 + bump(bx1),
    x2: st.x2 + bump(bx2),
    x3: st.x3 + bump(bx3),
    x4: st.x4 + bump(bx4 && start != ""),
    x4_empty: st.x4_empty + bump(bx4 && start == ""),
    strict_ok: st.strict_ok + bump(match strict_seqs { None => false, Some(_) => true })
  }
}

type Ctx = { ids: [string], m: int, n: int }

pure func check_list(ctx: Ctx, st: St, code: int) -> St {
  let ss = specs_of(ctx.ids, digits(code, ctx.m, ctx.n));
  List.foldl(\a s. check_case(ss, a, s), st, starts())
}

pure func check_len(ids: [string], st: St, n: int) -> St {
  let m = 5 * List.length(ids);
  let ctx: Ctx = { ids: ids, m: m, n: n };
  List.foldl(\a c. check_list(ctx, a, c), st, List.range(0, pow(m, n)))
}

func report(label: string, maxlen: int, st: St) -> () ! {IO} {
  println("path_props ${label}: entry lists of length 0..${show(maxlen)}, ${show(st.cases)} (list, start) cases");
  println("  P5.1 terminates:                 all ${show(st.cases)} calls returned");
  println("  P5.2 no repeated id:             ${show(st.p52)} violations");
  println("  P5.3 chain (parent = previous):  ${show(st.p53c)} violations");
  println("  P5.3 last = start (start != \"\"): ${show(st.p53l)} violations");
  println("  P5.3 last = start (start == \"\"): ${show(st.p53l_empty)} violations");
  println("  X-1 maximal (D4 rule 1 stops):   ${show(st.x1)} violations");
  println("  X-2 first entry with each id:    ${show(st.x2)} violations");
  println("  X-3 twin ev_path_up agrees:      ${show(st.x3)} disagreements");
  println("  X-4 strict_path agrees when Ok:  ${show(st.x4)} disagreements with start != \"\", ${show(st.x4_empty)} with start == \"\" (strict_path Ok on ${show(st.strict_ok)})");
  print_all(reverse_s(st.wits))
}

func print_all(xs: [string]) -> () ! {IO} {
  match xs { [] => (), x :: rest => { println(x); print_all(rest) } }
}

pure func reverse_s(xs: [string]) -> [string] { List.foldl(\acc x. x :: acc, [], xs) }

pure func total(st: St) -> int { st.p52 + st.p53c + st.p53l + st.p53l_empty + st.x1 + st.x2 + st.x3 + st.x4 + st.x4_empty }

func go(maxlen: int, empty: bool) -> () ! {IO} {
  let ids = ids_of(empty);
  let st = List.foldl(\a n. check_len(ids, a, n), st0(), List.range(0, maxlen + 1));
  report(if empty then "ids {a,b,c,\"\"}" else "ids {a,b,c}", maxlen, st);
  if total(st) > 0 then exit(1) else ()
}

export func main() -> () ! {IO} { go(4, false) }

export func with_empty() -> () ! {IO} { go(3, true) }

type RunArgs = { maxlen: int, empty: bool }

export func run(args: RunArgs) -> () ! {IO} { go(args.maxlen, args.empty) }
