      { role: "", content: "", tool_calls: [{ id: "}", name: "read", arguments: "{\"a\":1}" }, { id: "{\u{fc}", name: "bash", arguments: "tc-end;b" }], tool_call_id: "", images: [] },
      { role: "", content: "\u{1f600} a;{\u{65e5}\u{672c}", tool_calls: [{ id: ":", name: " ", arguments: "{\"a\":1}" }, { id: "\u{24}{x}\u{65e5}\u{672c}", name: "bash", arguments: "\u{24}{x}" }, { id: "sha256:", name: "bash", arguments: "m{" }], tool_call_id: "", images: [] },
      { role: "tool", content: "", tool_calls: [], tool_call_id: "", images: [] },
