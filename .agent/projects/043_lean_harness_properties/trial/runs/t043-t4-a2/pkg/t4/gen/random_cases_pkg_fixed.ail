      { role: "assistant", content: "\u{24}", tool_calls: [], tool_call_id: "", images: [] },
      { role: "tool", content: "a{ {:a", tool_calls: [], tool_call_id: "", images: [] },
      { role: "\u{e9}", content: "\u{9}\u{a}", tool_calls: [{ id: "tc-end;\"", name: "bash", arguments: "{}" }, { id: "m{\u{1f600}", name: "read", arguments: "" }, { id: "m{{", name: "\u{e9}", arguments: "{}" }], tool_call_id: "", images: [] },
      { role: "tool", content: "", tool_calls: [], tool_call_id: "\"", images: [] },
