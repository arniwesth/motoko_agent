      { role: "tool", content: "0", tool_calls: [], tool_call_id: "b", images: [{ source: ":", mime: "}" }] },
      { role: "assistant", content: "\u{24}{x}}\"}", tool_calls: [], tool_call_id: "\u{1f600}\u{24}", images: [] },
      { role: "system", content: "tc-end;content:1:a;\u{24}{x}}b", tool_calls: [{ id: "role:4:user;}", name: "read", arguments: "{\"a\":1}" }], tool_call_id: "", images: [] },
      { role: "tool", content: "", tool_calls: [{ id: "", name: "", arguments: "\"\u{9}\"" }, { id: "\"", name: "a", arguments: "{\"a\":1}" }], tool_call_id: "", images: [] },
      { role: "tool", content: "\u{24}", tool_calls: [], tool_call_id: "", images: [] },
      { role: "tool", content: "sha256:\u{9}", tool_calls: [{ id: "tc-end;12", name: "sha256:", arguments: "" }, { id: "sha256:b", name: "} ", arguments: "{\"a\":1}" }, { id: "\u{9}", name: "read", arguments: "{" }], tool_call_id: "", images: [] },
      { role: "", content: "", tool_calls: [], tool_call_id: "", images: [] },
      { role: "", content: "", tool_calls: [{ id: "{\u{a}", name: "bash", arguments: "{\"a\":1}" }], tool_call_id: "\u{e9}tc-end;", images: [] },
      { role: "user", content: "sha256:0\u{fc}12", tool_calls: [], tool_call_id: "", images: [] },
      { role: "user", content: "ba\u{a}tc-end;12\u{9}", tool_calls: [], tool_call_id: "", images: [] },
      { role: "system", content: "0", tool_calls: [], tool_call_id: "", images: [{ source: "", mime: "" }, { source: "\u{a}", mime: "image/png" }] },
      { role: "system", content: ";", tool_calls: [], tool_call_id: "", images: [] },
      { role: "system", content: "\"\u{24}", tool_calls: [{ id: "", name: "", arguments: "{}" }, { id: "", name: "bash", arguments: "{}" }], tool_call_id: "", images: [] },
      { role: "user", content: "", tool_calls: [], tool_call_id: "\u{a}", images: [] },
      { role: "user", content: " \u{a}role:4:user;im-end;", tool_calls: [], tool_call_id: "\u{9}", images: [{ source: "\u{e9}content:1:a;", mime: "image/jpeg" }, { source: "", mime: "im-end;" }] },
      { role: "assistant", content: "", tool_calls: [], tool_call_id: "", images: [] },
      { role: "assistant", content: "b \u{65e5}\u{672c}b", tool_calls: [], tool_call_id: "", images: [{ source: "", mime: "image/png" }, { source: "b ", mime: "image/png" }] },
      { role: "tool", content: "\"\u{fc}\u{24}{x}content:1:a;\"", tool_calls: [], tool_call_id: "", images: [] },
      { role: "content:1:a;", content: "\u{9}\u{1f600}content:1:a;", tool_calls: [], tool_call_id: "", images: [{ source: "", mime: "image/jpeg" }, { source: "\u{fc}a", mime: "image/jpeg" }] },
      { role: "system", content: "tc-end;{sha256:m{", tool_calls: [], tool_call_id: "", images: [] },
      { role: "system", content: ":12sha256:\u{e9}", tool_calls: [], tool_call_id: "", images: [] },
      { role: "tool", content: "}", tool_calls: [{ id: "", name: "bash", arguments: "a;content:1:a;" }, { id: "a", name: "bash", arguments: "{\"a\":1}" }], tool_call_id: "", images: [] },
      { role: "assistant", content: "m{", tool_calls: [{ id: "\u{65e5}\u{672c}", name: "bash", arguments: "{}" }, { id: "\u{1f600}", name: "bash", arguments: "12\u{e9}12" }], tool_call_id: "{", images: [] },
      { role: "user", content: "\u{a}tc-end;tc-end;b:", tool_calls: [], tool_call_id: "", images: [] }] }
  ]
}

func emit(ci: int, c: Case) -> () ! {IO} {
  let ms = c.ms;
  let n = length(ms);
  let ds = chain_digests_over(c.base, ms);
  println("C\t${intToStr(ci)}\t${intToStr(n)}\t${encode(js(c.base))}");
  println("M\t${intToStr(ci)}\t${encode(messages_json(ms))}");
  println("D\t${intToStr(ci)}\t${join(" ", ds)}");
  println("J\t${intToStr(ci)}\t${encode(chain_digests_json(ds))}");
  println("O\t${intToStr(ci)}\t${encode(js(chain_digest_over(c.base, ms)))}");
  emitPrefixes(ci, c.base, ms, 0, n);
  emitSplits(ci, c.base, ms, 0, n)
}

func emitPrefixes(ci: int, b: string, ms: [Message], i: int, n: int) -> () ! {IO} {
  if i >= n then () else {
    println("P\t${intToStr(ci)}\t${intToStr(i)}\t${chain_digest_over(b, take(i + 1, ms))}");
    emitPrefixes(ci, b, ms, i + 1, n)
  }
}

func emitSplits(ci: int, b: string, ms: [Message], k: int, n: int) -> () ! {IO} {
  if k > n then () else {
    let xs = take(k, ms);
    let ys = drop(k, ms);
    let ox = chain_digest_over(b, xs);
    println("S\t${intToStr(ci)}\t${intToStr(k)}\t${join(" ", chain_digests_over(b, xs))}\t${encode(js(ox))}\t${join(" ", chain_digests_over(ox, ys))}");
    emitSplits(ci, b, ms, k + 1, n)
  }
}

func emitAll(i: int, cs: [Case]) -> () ! {IO} {
  match cs {
    [] => (),
    c :: rest => { emit(i, c); emitAll(i + 1, rest) }
  }
}

export func main() -> () ! {IO} {
  emitAll(0, cases());
  println("END")
}
