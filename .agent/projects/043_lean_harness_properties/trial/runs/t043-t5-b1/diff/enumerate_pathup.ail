-- enumerate_pathup.ail — the AILANG half of the differential test for ../PathUpModel.lean.
--
-- The REAL `path_up` (src/core/journal.ail:1403), reached through the export-only shim that
-- make_root.sh builds, over the same inputs, in the same order, as enumerate.lean.tail.
--
-- Bounded family (B): every entry list of length 0..3 over a 20-entry alphabet. Entry k has
-- id IDS[k / 5] and parent PARS[k % 5], and its seq is its position in the list:
--   IDS  = "", a, b, c          PARS = "", a, b, c, z   ("z" names no entry)
-- Each list is run from every start id in STARTS = "", a, b, c, z. Lists of length 0..2 are
-- also run with three non-empty (seen, acc) pairs, variants 1..3 below; the caller's form,
-- variant 0, is ([], []).
--   B|<alphabet indices>|<start index>|<variant>|<result seqs>|<result length>
--
-- Ring family (R): entries e0..e(n-1), e_i's parent e_(i-1), and e0's parent e_k (k < n: a
-- cycle of length n - k... through e0) or "" (k = n: a plain chain). Run from every e_j, and
-- from the missing e_n. n = 1..8.
--   R|<n>|<k>|<j>|<result seqs>|<result length>
--
-- Random family (X): 2,000 lists of length 4..10, entries drawn from ids "", a..f and parents
-- "", a..f, z by the LCG s' = (1103515245 s + 12345) mod 2^31 from seed 42, the start id from
-- the parents' alphabet. The line carries the generated input, so a generator that drifted
-- between the two halves would show as a mismatch, not pass silently.
--   X|<t>|<id>parent;... >|<start>|<result seqs>|<result length>
--
-- From the shim root (make_root.sh <tree> <root> shim):
--   ailang run --relax-modules --caps IO --entry main enumerate_pathup.ail

module enumerate_pathup

import std/io (println)
import std/json (Json, jo)
import std/string as Str (join, concat, intToStr)
import std/list as List (length, map)
import src/core/journal (JournalEntry, path_up)

pure func nth(xs: [string], n: int) -> string {
  match xs { [] => "?", x :: rest => if n == 0 then x else nth(rest, n - 1) }
}

pure func ids() -> [string] { ["", "a", "b", "c"] }
pure func pars() -> [string] { ["", "a", "b", "c", "z"] }
pure func starts() -> [string] { ["", "a", "b", "c", "z"] }

pure func ent(seq: int, id: string, parent: string) -> JournalEntry {
  { id: id, parent_id: parent, seq: seq, at_ms: 0, kind: "x", raw: jo([]) }
}

pure func alpha(k: int, seq: int) -> JournalEntry {
  ent(seq, nth(ids(), k / 5), nth(pars(), k - 5 * (k / 5)))
}

pure func entries_of(s: [int], pos: int) -> [JournalEntry] {
  match s { [] => [], k :: rest => alpha(k, pos) :: entries_of(rest, pos + 1) }
}

pure func range_from(i: int, n: int) -> [int] {
  if i >= n then [] else i :: range_from(i + 1, n)
}

pure func append_each(s: [int], is: [int]) -> [[int]] {
  match is { [] => [], i :: rest => (s ++ [i]) :: append_each(s, rest) }
}

pure func extend_all(ss: [[int]]) -> [[int]] {
  match ss { [] => [], s :: rest => append_each(s, range_from(0, 20)) ++ extend_all(rest) }
}

pure func seqs_of_len(n: int) -> [[int]] {
  if n == 0 then [[]] else extend_all(seqs_of_len(n - 1))
}

pure func var_seen(v: int) -> [string] {
  if v == 1 then ["a"] else if v == 3 then ["c", "a"] else []
}

pure func var_acc(v: int) -> [JournalEntry] {
  if v >= 2 then [ent(9, "q", "q")] else []
}

pure func seq_str(e: JournalEntry) -> string { intToStr(e.seq) }

pure func show_result(r: [JournalEntry]) -> string {
  concat([join(",", map(seq_str, r)), "|", intToStr(length(r))])
}

func run_variants(s: [int], es: [JournalEntry], st: int, v: int, nv: int) -> () ! {IO} {
  if v >= nv then ()
  else {
    let r = path_up(es, nth(starts(), st), var_seen(v), var_acc(v));
    println(concat(["B|", join(",", map(intToStr, s)), "|", intToStr(st), "|", intToStr(v), "|", show_result(r)]));
    run_variants(s, es, st, v + 1, nv)
  }
}

func run_starts(s: [int], es: [JournalEntry], st: int) -> () ! {IO} {
  if st >= 5 then ()
  else {
    run_variants(s, es, st, 0, if length(s) <= 2 then 4 else 1);
    run_starts(s, es, st + 1)
  }
}

func run_seqs(ss: [[int]]) -> () ! {IO} {
  match ss {
    [] => (),
    s :: rest => { run_starts(s, entries_of(s, 0), 0); run_seqs(rest) }
  }
}

pure func eid(i: int) -> string { concat(["e", intToStr(i)]) }

pure func ring(n: int, k: int, i: int) -> [JournalEntry] {
  if i >= n then []
  else {
    let parent = if i == 0 then (if k == n then "" else eid(k)) else eid(i - 1);
    ent(i, eid(i), parent) :: ring(n, k, i + 1)
  }
}

func run_ring_j(n: int, k: int, j: int) -> () ! {IO} {
  if j > n then ()
  else {
    let r = path_up(ring(n, k, 0), eid(j), [], []);
    println(concat(["R|", intToStr(n), "|", intToStr(k), "|", intToStr(j), "|", show_result(r)]));
    run_ring_j(n, k, j + 1)
  }
}

func run_ring_k(n: int, k: int) -> () ! {IO} {
  if k > n then () else { run_ring_j(n, k, 0); run_ring_k(n, k + 1) }
}

func run_ring_n(n: int) -> () ! {IO} {
  if n > 8 then () else { run_ring_k(n, 0); run_ring_n(n + 1) }
}

pure func ids2() -> [string] { ["", "a", "b", "c", "d", "e", "f"] }
pure func pars2() -> [string] { ["", "a", "b", "c", "d", "e", "f", "z"] }

pure func lcg(s: int) -> int {
  let t = s * 1103515245 + 12345;
  t - 2147483648 * (t / 2147483648)
}

pure func pick(s: int, m: int) -> int {
  let h = s / 65536;
  h - m * (h / m)
}

type Gen = { s: int, es: [JournalEntry] }

pure func gen_entries(s: int, i: int, n: int) -> Gen {
  if i >= n then { s: s, es: [] }
  else {
    let s1 = lcg(s);
    let s2 = lcg(s1);
    let e = ent(i, nth(ids2(), pick(s1, 7)), nth(pars2(), pick(s2, 8)));
    let rest = gen_entries(s2, i + 1, n);
    { s: rest.s, es: e :: rest.es }
  }
}

pure func enc(e: JournalEntry) -> string { concat([e.id, ">", e.parent_id]) }

func run_rand(t: int, s: int) -> () ! {IO} {
  if t >= 2000 then ()
  else {
    let s1 = lcg(s);
    let n = 4 + pick(s1, 7);
    let g = gen_entries(s1, 0, n);
    let s2 = lcg(g.s);
    let start = nth(pars2(), pick(s2, 8));
    let r = path_up(g.es, start, [], []);
    println(concat(["X|", intToStr(t), "|", join(";", map(enc, g.es)), "|", start, "|", show_result(r)]));
    run_rand(t + 1, s2)
  }
}

export func main() -> () ! {IO} {
  run_seqs(seqs_of_len(0));
  run_seqs(seqs_of_len(1));
  run_seqs(seqs_of_len(2));
  run_seqs(seqs_of_len(3));
  run_ring_n(1);
  run_rand(0, 42)
}
