
/-
diff/enumerate_e2e.lean.tail — appended to ../HerdrGateModel.lean by run_e2e.sh. Prints, for every
triple of `e2eAlphabet` (the same values in the same order as E2E in enumerate_e2e.ts):

  <i>,<j>,<k>|<readHerdrEnvironment>|<fe>,<fb>,<fp>|<registerGate>

fX is the index of `forwarded` of that variable (`-` when it is dropped).
-/

def e2eAlphabet : List (Option Str) :=
  [none, some [], some [' '], some [' '], some ['1'], some ['2'],
   some ['w', '1', ':', 'p', '7'], some ['1', ' ']]

def tsFieldE (e b p : Option Str) : String :=
  match readHerdrEnvironment e b p with
  | none => "null"
  | some r =>
    s!"obj:{if some r.paneId = p then "P" else "?"}:{if some r.bin = b then "B" else "?"}"

def fwdField (v : Option Str) (idx : Nat) : String :=
  match forwarded v with
  | none => "-"
  | some s => if some s = v then toString idx else "?"

#eval show IO Unit from do
  let a := e2eAlphabet.toArray
  for i in List.range a.size do
    for j in List.range a.size do
      for k in List.range a.size do
        let e := a[i]!
        let b := a[j]!
        let p := a[k]!
        IO.println s!"{i},{j},{k}|{tsFieldE e b p}|{fwdField e i},{fwdField b j},{fwdField p k}|{registerGate e b p}"
