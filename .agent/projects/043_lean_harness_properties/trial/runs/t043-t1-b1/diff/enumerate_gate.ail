--
-- From the repository root:
--   ailang run --relax-modules --caps IO --entry main <this file>

module enumerate_gate

import std/io (println)
import std/string (join, intToStr)
import pkg/sunholo/motoko_ext_herdr/types (herdr_env_ready)

pure func show_b(b: bool) -> string { if b then "true" else "false" }

pure func row_k(e: string, b: string, ps: [string], prefix: string, k: int) -> [string] {
  match ps {
    [] => [],
    p :: rest => "${prefix},${intToStr(k)}|${show_b(herdr_env_ready(e, b, p))}" :: row_k(e, b, rest, prefix, k + 1)
  }
}

func loop_j(e: string, bs: [string], i: int, j: int, all: [string]) -> () ! {IO} {
  match bs {
    [] => (),
    b :: rest => {
      println(join("\n", row_k(e, b, all, "${intToStr(i)},${intToStr(j)}", 0)));
      loop_j(e, rest, i, j + 1, all)
    }
  }
}

func loop_i(es: [string], i: int, all: [string]) -> () ! {IO} {
  match es {
    [] => (),
    e :: rest => {
      loop_j(e, all, i, 0, all);
      loop_i(rest, i + 1, all)
    }
  }
}

export func main() -> () ! {IO} {
  let a = alphabet();
  loop_i(a, 0, a)
}

