
/-
Appended to HerdrGateModel.lean by diff/run_chain.sh; GENERATED by diff/gen_inputs.py, seed
43. The exploratory chain model (X-1, X-2) over every triple, in the order of
enumerate_chain.ts, one line each:

  <e>,<b>,<p>|<model readHerdrEnvironment>|<forwarded e>,<forwarded b>,<forwarded p>|<registerGate>

`forward` is instantiated with `jsBlank`, JavaScript's `trim() === ""`: every character is in
ECMA-262's WhiteSpace or LineTerminator set. (The theorems leave `blank` abstract.)
-/

def alphabet : Array String := #[
  "",
  "1",
  "0",
  "2",
  "9",
  "10",
  "11",
  "01",
  "1 ",
  " 1",
  "1\n",
  "\t1",
  "1\t",
  "+1",
  "-1",
  "1.0",
  "0x1",
  "true",
  "false",
  "yes",
  "on",
  "TRUE",
  "a",
  "A",
  "z",
  "~",
  "/",
  "!",
  " ",
  "  ",
  "\t",
  "\n",
  "\r",
  "\"",
  "\\",
  "é",
  "日本",
  "🙂",
  " ",
  "　",
  "１",
  "/usr/local/bin/herdr",
  "herdr",
  "w1:p7",
  "w1:p2",
  ":/",
  ":",
  ":!0a-",
  "/!Z🙂-",
  "113１",
  "15",
  ":4🙂:!",
  "2~5:2",
  "22a",
  "1１~\t\t",
  ": \t日 ",
  "~éß",
  "142🙂",
  "0~8",
  "１5é"
]

def opts : List (String × Option String) :=
  ("u", none) :: (List.range alphabet.size).map (fun i => (toString i, some alphabet[i]!))

def idxOf (s : String) : String :=
  match (List.range alphabet.size).find? (fun i => alphabet[i]! == s) with
  | some i => toString i
  | none   => "?"

def idxOpt : Option String → String
  | none   => "u"
  | some s => idxOf s

def showTs : Option HerdrEnvironment → String
  | none   => "null"
  | some r => s!"obj:{idxOf r.paneId},{idxOf r.bin}"

def jsWs (c : Char) : Bool :=
  [0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x20, 0xA0, 0x1680, 0x2000, 0x2001, 0x2002, 0x2003, 0x2004,
   0x2005, 0x2006, 0x2007, 0x2008, 0x2009, 0x200A, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000,
   0xFEFF].contains c.toNat

def jsBlank (s : String) : Bool := s.toList.all jsWs

#eval show IO Unit from do
  for (el, ev) in opts do
    for (bl, bv) in opts do
      for (pl, pv) in opts do
        let env : Env := ⟨ev, bv, pv⟩
        let f := forwardEnv jsBlank env
        IO.println s!"{el},{bl},{pl}|{showTs (readHerdrEnvironment env)}|{idxOpt f.herdrEnv},{idxOpt f.binPath},{idxOpt f.paneId}|{registerGate f}"
