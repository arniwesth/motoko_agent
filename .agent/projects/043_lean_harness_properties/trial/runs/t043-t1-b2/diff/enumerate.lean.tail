
/-
Appended to HerdrGateModel.lean by diff/run_diff.sh; GENERATED by diff/gen_inputs.py, seed
43. Every triple over (unset, then the 60 values below), in the order of enumerate.ts and
enumerate_gate.ail, one line each:

  <e>,<b>,<p>|<model readHerdrEnvironment>|<model herdr_env_ready, unset as "">

The first result is `null`, or `obj:<pane index>,<bin index>`: the returned fields, located in
the alphabet, so the test compares what the TypeScript gate returns and not only whether.
-/

def alphabet : Array String := #[
  "",
  "1",
  "0",
  "2",
  "9",
  "10",
  "11",
  "01",
  "1 ",
  " 1",
  "1\n",
  "\t1",
  "1\t",
  "+1",
  "-1",
  "1.0",
  "0x1",
  "true",
  "false",
  "yes",
  "on",
  "TRUE",
  "a",
  "A",
  "z",
  "~",
  "/",
  "!",
  " ",
  "  ",
  "\t",
  "\n",
  "\r",
  "\"",
  "\\",
  "é",
  "日本",
  "🙂",
  " ",
  "　",
  "１",
  "/usr/local/bin/herdr",
  "herdr",
  "w1:p7",
  "w1:p2",
  ":/",
  ":",
  ":!0a-",
  "/!Z🙂-",
  "113１",
  "15",
  ":4🙂:!",
  "2~5:2",
  "22a",
  "1１~\t\t",
  ": \t日 ",
  "~éß",
  "142🙂",
  "0~8",
  "１5é"
]

def opts : List (String × Option String) :=
  ("u", none) :: (List.range alphabet.size).map (fun i => (toString i, some alphabet[i]!))

def idxOf (s : String) : String :=
  match (List.range alphabet.size).find? (fun i => alphabet[i]! == s) with
  | some i => toString i
  | none   => "?"

def showTs : Option HerdrEnvironment → String
  | none   => "null"
  | some r => s!"obj:{idxOf r.paneId},{idxOf r.bin}"

#eval show IO Unit from do
  for (el, ev) in opts do
    for (bl, bv) in opts do
      for (pl, pv) in opts do
        let env : Env := ⟨ev, bv, pv⟩
        IO.println s!"{el},{bl},{pl}|{showTs (readHerdrEnvironment env)}|{ailOpen env}"
