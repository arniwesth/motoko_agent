pure func show_bool(b: bool) -> string { if b then "true" else "false" }

func walk_p(el: string, ev: string, bl: string, bv: string, ps: [(string, string)]) -> () ! {IO} {
  match ps {
    [] => (),
    q :: rest => match q {
      (pl, pv) => {
        println(concat([el, ",", bl, ",", pl, "|", show_bool(herdr_env_ready(ev, bv, pv))]));
        walk_p(el, ev, bl, bv, rest)
      }
    }
  }
}

func walk_b(el: string, ev: string, bs: [(string, string)]) -> () ! {IO} {
  match bs {
    [] => (),
    q :: rest => match q {
      (bl, bv) => {
        walk_p(el, ev, bl, bv, opts());
        walk_b(el, ev, rest)
      }
    }
  }
}

func walk_e(es: [(string, string)]) -> () ! {IO} {
  match es {
    [] => (),
    q :: rest => match q {
      (el, ev) => {
        walk_b(el, ev, opts());
        walk_e(rest)
      }
    }
  }
}

export func main() -> () ! {IO} {
  walk_e(opts())
}
