-- register_ail.ail — the gate as the extension actually applies it.
--
-- Calls the REAL `register_with_config` (packages/motoko-ext-herdr/register.ail:43),
-- which reads HERDR_ENV, HERDR_BIN_PATH and HERDR_PANE_ID from the process
-- environment with `getEnvOr` and passes them to `herdr_env_ready`. Prints the
-- tools the registration's `ToolProvider` advertises:
--
--   gate=<open|closed> tools=<n> [<names>]
--
-- `gate=open` means the extension advertises its tools. Drive it by setting or
-- unsetting the variables in this process's environment (register_diff.ts does).
--
--   ailang run --relax-modules --caps Clock,Env,FS,IO,Process --entry main \
--     /home/motoko/trial-043/s/t043-t1-a1/out/register_ail.ail
module register_ail

import std/io (println)
import std/string as Str (join, concat, intToStr)
import std/list as List (length)
import pkg/sunholo/motoko_ext_abi/types (Capability, ToolProvider, ExtRegistration)
import pkg/sunholo/motoko_ext_herdr/register (register_with_config)

pure func provided_names(caps: [Capability]) -> [string] {
  match caps {
    [] => [],
    ToolProvider(names, _) :: rest => names ++ provided_names(rest),
    _ :: rest => provided_names(rest)
  }
}

export func main() -> () ! {Clock, Env, FS, IO, Process} {
  let reg = register_with_config(());
  let names = provided_names(reg.caps);
  let n = List.length(names);
  println(concat(["gate=", if n > 0 then "open" else "closed", " tools=", intToStr(n), " [", join(",", names), "]"]))
}
