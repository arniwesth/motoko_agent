-- enumerate_fold.ail — the AILANG half of the differential test for ../PairingModel.lean
-- (RESEARCH-lean-harness-properties.md §6.4, §10 item 2).
--
-- The REAL fold, over the same histories, in the same order, as enumerate.ts and
-- enumerate.lean.tail. Each history becomes a journal through `journal_lines_of_records`,
-- the module's own writer twin, exactly as `journal.ail`'s tests build theirs: session
-- start, the seed (system, user), one `history_appended` per message with the chain's
-- digest, a state delta and the run summary. That journal goes to `fold_journal` at its
-- leaf. One line per history:
--
--   <message indices>|<verdict>|<dangling>|<how many dangling ids>
--
-- where <verdict> is `accept`, or the refusal's id (`pairing`, `transcript`, ...), and
-- <dangling> is `SessionState.dangling` when the fold accepts, empty otherwise. The count is
-- there because joining [""] and [] both give "".
--
-- The `t_*` builders below are copies of journal.ail's private test fixtures
-- (`t_start`, `t_seeded`, `t_append`, `t_delta`, `t_summary`, at origin/main 43530c0a,
-- journal.ail:2691-2763), because they are not exported. Only the message list differs.
--
-- From the repository root:
--
--   ailang run --relax-modules --caps IO --entry main \
--     .agent/projects/043_lean_harness_properties/evidence/diff/enumerate_fold.ail

module enumerate_fold

import std/io (println)
import std/ai (Message, ToolCall)
import std/string as Str (join, concat, intToStr)
import std/list as List (length)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import src/core/phase_vocab (
  RuntimeStatusCounts,
  LedgerRecord, WireRecord,
  HistorySeeded, HistoryAppended, StateDelta, SessionStart, RunSummary
)
import src/core/journal (
  SessionState, Refusal, refusal_id,
  fold_journal, journal_lines_of_records, journal_leaf, harness_header, default_run_identity,
  chain_digest_after, chain_digest_over, chain_digests_over, chain_digests_json, chain_empty_base,
  messages_json, message_json
)

-- The alphabet: same eleven messages, same order, as enumerate.ts and enumerate.lean.tail.

pure func call(id: string) -> ToolCall { { id: id, name: "bash", arguments: "{}" } }

pure func calls_of(ids: [string]) -> [ToolCall] {
  match ids { [] => [], i :: rest => call(i) :: calls_of(rest) }
}

pure func mk(role: string, ids: [string], tcid: string) -> Message {
  { role: role, content: "", tool_calls: calls_of(ids), tool_call_id: tcid, images: [] }
}

pure func alphabet() -> [Message] {
  [ mk("assistant", [], ""),
    mk("assistant", ["a"], ""),
    mk("assistant", ["a", "b"], ""),
    mk("assistant", ["b"], ""),
    mk("tool", [], "a"),
    mk("tool", [], "b"),
    mk("tool", [], ""),
    mk("user", [], ""),
    mk("tool", ["b"], "a"),            -- 8: violates (H2)
    mk("assistant", [], "a"),          -- 9: a non-tool message with an id
    mk("assistant", ["a", ""], "") ]   -- 10: violates (H1)
}

pure func nth(xs: [Message], i: int) -> Message {
  match xs { [] => mk("user", [], ""), x :: rest => if i == 0 then x else nth(rest, i - 1) }
}

-- journal.ail's fixtures, copied (see the header).

pure func t_sys() -> Message { { role: "system", content: "you are motoko", tool_calls: [], tool_call_id: "", images: [] } }
pure func t_user() -> Message { { role: "user", content: "list the files", tool_calls: [], tool_call_id: "", images: [] } }
pure func t_seed() -> [Message] { [t_sys(), t_user()] }
pure func t_seed_digest() -> string { chain_digest_over(chain_empty_base(), t_seed()) }
pure func t_run_id() -> string { "sess_1.r0.0" }

pure func t_counts() -> RuntimeStatusCounts {
  { provider_calls_started: 2, provider_calls_completed: 2, stage_applied_total: 0,
    stage_rejected_total: 0, compaction_ai_applied: 0 }
}

pure func t_seeded() -> LedgerRecord {
  WireRecord(HistorySeeded({
    run_id: t_run_id(),
    messages: messages_json(t_seed()),
    digest: t_seed_digest(),
    digests: chain_digests_json(chain_digests_over(chain_empty_base(), t_seed()))
  }))
}

pure func t_start() -> LedgerRecord {
  WireRecord(SessionStart({ task: "list the files", model: "m", mode: "v2", run_id: t_run_id() }))
}

pure func t_append(step: int, m: Message, replaces: bool, digest: string) -> LedgerRecord {
  WireRecord(HistoryAppended({
    run_id: t_run_id(), step: step, message: message_json(m),
    replaces_previous: replaces, digest_after: digest
  }))
}

pure func t_delta() -> LedgerRecord {
  WireRecord(StateDelta({
    run_id: t_run_id(), step: 1, cumulative: t_counts(),
    telemetry: { last_input_tokens: 120, last_output_tokens: 40, last_estimated_input_tokens: 100 },
    ext_artifacts_digest: "sha256:ext", ext_artifacts: None
  }))
}

pure func t_summary() -> LedgerRecord {
  WireRecord(RunSummary({
    model: "m", motoko_commit: "abc", finish_reason: "stop", steps_executed: 1,
    input_tokens: 10, output_tokens: 2, cache_read_input_tokens: 0,
    cache_creation_input_tokens: 0, total_cost_usd: 0.0, total_cost_millicents: 0,
    duration_ms: 5, error: "", cumulative: t_counts(), world_ordinal: 4
  }))
}

-- One history: its journal, its fold, its line.

pure func appends(ms: [Message], prev: string) -> [LedgerRecord] {
  match ms {
    [] => [],
    m :: rest => {
      let d = chain_digest_after(prev, m);
      t_append(1, m, false, d) :: appends(rest, d)
    }
  }
}

pure func messages_of(ix: [int]) -> [Message] {
  match ix { [] => [], i :: rest => nth(alphabet(), i) :: messages_of(rest) }
}

pure func ints_text(xs: [int]) -> [string] {
  match xs { [] => [], x :: rest => intToStr(x) :: ints_text(rest) }
}

pure func line_of(ix: [int]) -> string {
  let records = [t_start(), t_seeded()] ++ appends(messages_of(ix), t_seed_digest()) ++ [t_delta(), t_summary()];
  let lines = journal_lines_of_records(harness_header(default_run_identity("sess_1"), "m"), records);
  let verdict = match fold_journal(lines, journal_leaf(lines)) {
    Ok(s) => concat(["accept|", join(",", s.dangling), "|", intToStr(List.length(s.dangling))]),
    Err(r) => concat([refusal_id(r), "||"])
  };
  concat([join(",", ints_text(ix)), "|", verdict])
}

-- Every history of length 0 to 4, in lexicographic order of its indices within each
-- length: the order `seqsOfLen` and enumerate.ts produce.

pure func range_from(i: int, n: int) -> [int] {
  if i >= n then [] else i :: range_from(i + 1, n)
}

func walk(prefix: [int], left: int, is: [int]) -> () ! {IO} {
  match is {
    [] => (),
    i :: rest => {
      let p = prefix ++ [i];
      if left == 1 then println(line_of(p)) else walk(p, left - 1, range_from(0, 11));
      walk(prefix, left, rest)
    }
  }
}

func emit_len(n: int) -> () ! {IO} {
  if n == 0 then println(line_of([])) else walk([], n, range_from(0, 11))
}

export func main() -> () ! {IO} {
  emit_len(0);
  emit_len(1);
  emit_len(2);
  emit_len(3);
  emit_len(4)
}
