  classDef req fill:#16294d,stroke:#7aa2f7,color:#cdd9f5,stroke-width:2px;
  classDef fault fill:#3a1620,stroke:#f7768e,color:#f7c6cf;
  classDef clock fill:#123038,stroke:#2ac3de,color:#bdeef5;
  classDef blocked fill:#3a3018,stroke:#d29922,color:#f2e0b8,stroke-dasharray:6 4;
  classDef decision fill:#3a2f12,stroke:#e0af68,color:#f2e2c2,stroke-width:2.5px;
