-- scripts/smoke_v2_compaction.ail
--
-- Direct smoke for compaction.ail's remaining measurement surface.
--
-- Run:
--   ailang run --caps IO --entry main scripts/smoke_v2_compaction.ail
--
-- Pass = prints all 3 ✓ lines and exits 0.

module scripts/smoke_v2_compaction

import std/io (println)
import std/ai (Message)
import src/core/compaction (
  estimate_tokens_messages,
  usage_percent_with_limit,
  exhaustion_pct
)

func mk_user(content: string) -> Message {
  { role: "user", content: content, tool_calls: [], tool_call_id: "" }
}

-- 1. Disabled/unknown limit → usage returns 0 (fail-open).
func test_unknown_limit_zero() -> bool {
  let msgs = [mk_user("hi")];
  usage_percent_with_limit(msgs, 0) == 0
}

-- 2. Explicit limit with a tiny message → usage well under threshold.
func test_below_threshold() -> bool {
  let msgs = [mk_user("hi")];
  let pct = usage_percent_with_limit(msgs, 100);
  pct < 70
}

-- 3. Token estimate rounds content bytes up by fourths.
func test_estimate_rounds_up() -> bool {
  let msgs = [
    mk_user("abcde")
  ];
  estimate_tokens_messages(msgs) == 2 && exhaustion_pct() == 95
}

func report(name: string, ok: bool) -> () ! {IO} {
  if ok then println("  ✓ ${name}")
  else println("  ✗ ${name}")
}

export func main() -> () ! {IO} = {
  println("=== smoke_v2_compaction ===");
  report("unknown_limit_returns_zero_usage", test_unknown_limit_zero());
  report("below_threshold_under_70pct",       test_below_threshold());
  report("estimate_rounds_up",                test_estimate_rounds_up());
  println("done")
}
