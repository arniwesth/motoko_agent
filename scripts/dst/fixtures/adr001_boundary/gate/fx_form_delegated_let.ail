module scripts/dst/fixtures/adr001_boundary/gate/fx_form_delegated_let
import scripts/dst/fixtures/adr001_boundary/gate/gate_abi (Ctx, Capability, ToolPolicy)
type Cfg = { budget: int }
func decide_with(_ctx: Ctx, _budget: int) -> int { 1 }
func make_hooks(cfg: Cfg) -> [Capability] { let policy = func(ctx: Ctx) -> int { decide_with(ctx, cfg.budget) }; [ToolPolicy(policy)] }
export func register_with_config(n: int) -> [Capability] { let cfg: Cfg = { budget: n }; make_hooks(cfg) }
