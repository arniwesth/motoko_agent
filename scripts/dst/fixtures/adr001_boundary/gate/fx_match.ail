module scripts/dst/fixtures/adr001_boundary/gate/fx_match
import std/io (println)
import std/json (JString)
import scripts/dst/fixtures/adr001_boundary/gate/gate_abi (Ctx, Capability, ToolPolicy, Registration)
type W = { f: (Ctx) -> int }
func apply(ctx: Ctx, w: W) -> int { w.f(ctx) }
func body(ctx: Ctx) -> int { 1 }
export func register_with_config(cfg: int) -> Registration ! {IO} { let w: W = { f: func(c: Ctx) -> int ! {} { let _ = println(c.name); 1 } }; { config: JString("synthetic"), caps: match cfg { 0 => [], _ => [ToolPolicy(func(ctx: Ctx) -> int { apply(ctx, w) })] } } }
