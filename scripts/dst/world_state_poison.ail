-- scripts/dst/world_state_poison.ail
--
-- WI-A12's per-class poison probe: the LIVE half of the capability backstop.
--
-- D4, as corrected by F3, asks each effect class for a per-run demonstration
-- that routing actually happened, and the demonstration is a pair:
--
--   1. with the class's capability WITHHELD, the deterministic entry point
--      still completes — proving the scripted world performs no ambient read
--      of that effect. `make world_state` runs `world_state_probe.ail` that way.
--   2. with the same capability withheld, the LIVE world dies — proving the
--      capability is genuinely load-bearing and that (1) is evidence of routing
--      rather than evidence that nothing reads the effect at all.
--
-- This file is (2). Without it, (1) passes vacuously: a probe that completes
-- with `AI` withheld proves nothing if no code path would have used `AI`
-- anyway. That vacuity is the same defect cluster 4 filed as C1b — a green
-- check that implies coverage it does not have.
--
-- IMPORTANT: this script drives the LIVE provider and is only ever invoked with
-- the effect's capability WITHHELD, so it terminates before any network call.
-- It must never be run with the full capability set; `make world_state` invokes
-- it only in the withheld configuration and asserts a NON-ZERO exit.
--
-- On the pin, a denied ambient effect terminates evaluation: no typed result
-- and no partial trace. That is D6.6's distinction and cluster 4 measured it
-- directly — a raw capability bypass stays an expected non-zero run and must
-- NOT be unified into a typed HarnessFailure.

module scripts/dst/world_state_poison

import std/io (println)
import std/env (getEnvOr)
import std/ai (Message)
import std/result (Result, Ok, Err)
import src/core/config (CostRates, VerificationConfig)
import src/core/session as Session
import src/core/session (TracedSessionResult)
import src/core/test/stub_step (LiveAI, ScriptedWorld, tool_step, prose_step)
import src/core/ports (WorldState, empty_world_state)
import pkg/sunholo/motoko_ext_abi/types (PreStepOutcome, ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome, 
  BudgetPlan, BudgetPatch, ExtRuntime, ExtCtx, Allow, PassThrough,
  PreStepDecision, PromptPatch, ToolPolicyDecision, ToolHandleDecision, ToolSchema,
  ResponseInterceptDecision, FinalizeDecision, Delegate, NoIntercept, NoDecision
)
import src/core/test/ext_fixture (fixture_hooks)
import std/option (None)
import src/core/types (Msg)
import src/core/tool_contract (ToolCallEnvelope)

-- Allows every tool, so the unseeded world reaches the real dispatcher.
func allow_rt() -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  let hooks = fixture_hooks("poison_allow", {
    tools: [],
    describe: \_ . [],
    prompt: func(_ctx: ExtCtx) -> PromptPatch { { prepend: [], append: [] } },
    budget: func(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch {
      { requested_total: None, requested_solver: None, requested_verifier: None }
    },
    compact: func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {AI, IO, Trace}  { { decision: { PassThrough }, next_state: ctx.world } },
    policy: func(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolPolicyDecision { Allow },
    provide: func(ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand}  { { decision: { Delegate }, next_state: ctx.world } },
    intercept: func(ctx: ExtCtx, _text: string) -> ResponseInterceptOutcome ! {IO, Process, FS, Clock}  { { decision: { NoIntercept }, next_state: ctx.world } },
    judge: func(ctx: ExtCtx, _text: string) -> FinalizeOutcome ! {Process}  { { decision: { NoDecision }, next_state: ctx.world } }
  });
  { registry: { hooks: [hooks] }, strict_mode: false, verification: v }
}

func msg(role: string, content: string) -> Message {
  { role: role, content: content, tool_calls: [], tool_call_id: "", images: [] }
}

func history() -> [Message] { [msg("system", "s"), msg("user", "u")] }

func budget() -> BudgetPlan { { total: 10, solver: 6, verifier: 4 } }

func zero_rates() -> CostRates { { input_per_1m_millicents: 0, output_per_1m_millicents: 0 } }

func empty_rt() -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  { registry: { hooks: [] }, strict_mode: false, verification: v }
}

-- The tool class's live half. A world with an EMPTY tool queue delegates to the
-- real dispatcher, so a run that allows tools performs genuine process
-- execution — which is what makes the seeded run's completion with `Process`
-- withheld evidence of routing rather than evidence that no tool ran.
--
-- It uses the SCRIPTED provider deliberately: the point is to isolate the tool
-- effect, so the provider must not be what kills the run.
func unseeded_tools_run() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let _ = println("world_state_poison: unseeded tool world, driving the real dispatcher");
  let w: WorldState = { empty_world_state() | script: [tool_step("BashExec", "{\"cmd\":\"true\"}", "p0"), prose_step("done")] };
  let traced = Session.run_v2_session_traced(
    allow_rt(), "task", "", false, budget(), "phase-c-model", history(), ".",
    4, false, 0, zero_rates(), ScriptedWorld(w)
  );
  let outcome = match traced.result { Ok(_) => "ok", Err(e) => "err ${e.code}" };
  println("world_state_poison REACHED COMPLETION outcome=${outcome} — the withheld capability was not load-bearing")
}

-- WI-D3's host-env and filesystem classes, live half.
--
-- IT IS A SEPARATE ENTRY POINT RATHER THAN A `POISON_ARM` VALUE, and that is the
-- whole reason it is trustworthy. `main` below selects its arm with
-- `getEnvOr("POISON_ARM", …)`, which PERFORMS an Env read before it reaches any
-- subject — so an Env-withheld run of `main` dies on the selector and reports a
-- non-zero exit that says nothing about whether the driver's env reads are
-- load-bearing. That is a probe green (here, red) because the effect was never
-- performed by the thing under test: S16's shape, and the exact defect this
-- item was told to hunt for in its own instrument. `--entry` costs nothing and
-- reads no environment.
--
-- The body is `main`'s LiveAI arm verbatim, and that is what makes the pair an
-- argument rather than two observations: `world_state_probe` runs the SAME
-- session call over a scripted world and completes with either capability
-- withheld, while this one dies. One difference between the runs — which
-- closures `ported_provider` bound — so the death is in the binding.
export func main_host_class() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let _ = println("world_state_poison: driving the LIVE world with a host-read capability withheld");
  let traced = Session.run_v2_session_traced(
    empty_rt(), "task", "", false, budget(), "phase-c-model", history(), ".",
    2, false, 0, zero_rates(), LiveAI
  );
  let outcome = match traced.result { Ok(_) => "ok", Err(e) => "err ${e.code}" };
  println("world_state_poison REACHED COMPLETION outcome=${outcome} — the withheld capability was not load-bearing")
}

export func main() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  if getEnvOr("POISON_ARM", "") == "tools" then unseeded_tools_run()
  else {
  let _ = println("world_state_poison: driving the LIVE world with a capability withheld");
  let traced = Session.run_v2_session_traced(
    empty_rt(), "task", "", false, budget(), "phase-c-model", history(), ".",
    2, false, 0, zero_rates(), LiveAI
  );
  let outcome = match traced.result { Ok(_) => "ok", Err(e) => "err ${e.code}" };
  -- Reaching this line at all means the withheld capability was never needed,
  -- which falsifies the deterministic half's claim to be evidence of routing.
  println("world_state_poison REACHED COMPLETION outcome=${outcome} — the withheld capability was not load-bearing")
  }
}
