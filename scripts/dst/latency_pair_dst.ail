import src/core/test/stub_step (RecordingWorld)
import src/core/ports (ScriptedStep, WorldState, ScriptedTool, empty_world_state)
import pkg/sunholo/motoko_ext_abi/types (PreStepOutcome, ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome, 
  ExtCtx, ToolSchema, PromptPatch, BudgetPatch, BudgetPlan,
  PreStepDecision, PassThrough,
  ToolPolicyDecision, Pending, DenyAfterTimeout,
  ToolHandleDecision, Delegate,
  ResponseInterceptDecision, NoIntercept,
  FinalizeDecision, NoDecision,
  ExtRuntime
)
import src/core/test/ext_fixture (fixture_hooks)

import src/core/dst_interaction (
  Interaction, IdentityBody,
  ToolIdentity,
  OutcomeStatus, OutcomeOk, OutcomeFault, OutcomeMissing,
  outcome_status_id, interaction_kind, total_advance_ms, of_kind
)
import src/core/dst_fault_catalogue (
  fault_class_tool_deadline_exceeded, required_class_ids
)
import src/core/dst_program (
  ExecutionProgram, program_schema_version, validate_program, validate_bounds
)
import src/core/dst_profile (ExecutionManifest, validate_manifest)
