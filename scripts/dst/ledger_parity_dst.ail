-- scripts/dst/ledger_parity_dst.ail
--
-- WI-D2 acceptance: D6.4's GENERAL obligation — "every Logical event the driver
-- produces reaches the returned trace" — held on real runs rather than on the
-- vocabulary's `reaches_trace_today` survey.
--
-- ============================================================================
-- What this is, and why it is not `stream_parity_dst`
-- ============================================================================
--
-- WI-C3 discharged D6.4's NAMED EXCEPTION (streams) and said in as many words
-- that the general obligation was not discharged. WI-C4 ran the name-adoption
-- table and found the general obligation is what acceptance row 7 fails on:
-- thirteen Logical variants were emitted to the wire and appended to nothing.
--
-- `stream_parity_dst` compares one variant (`StreamDelta`). This script compares
-- EVERY Logical variant that `dst_invariants.d64_gap_register()` does not
-- register as a gap — so the register and the gate are coupled in the direction
-- that matters: **removing a variant from the register makes this gate demand
-- its append.** A register shrunk without the production change goes red here,
-- and a production append deleted without the register growing goes red here
-- too. Neither is a comment.
--
-- ============================================================================
-- The two producers, named as S16 requires
-- ============================================================================
--
--   PROJECTED  `ledger_emit` writes one JSON line per event to stdout, at the
--              site where the event happens, during the phase that produced it.
--   RETURNED   `ledger_append` puts a `WireRecord` in the `LedgerTrace` the
--              driver returns, and `LEDGER_TRACE` below prints that trace.
--
-- These are the SAME two producers `run_stream_parity_wire.sh` compares for
-- deltas, and the comparison is made in the same place: out of process, by
-- `run_ledger_parity_wire.sh`, because in-process both sides of any comparison
-- I could write here would derive from one accumulation. That is S16's whole
-- point and WI-D1's M5 measured what ignoring it costs — a completely green
-- in-process suite over a wire that was leaking ten retries.
--
-- **So this script asserts a census and prints two channels; it does not
-- compare them.** The comparison is the shell's, and the rows below say which
-- claim is whose.
--
-- ============================================================================
-- The vacuity guard
-- ============================================================================
--
-- Every row is green over a run that produced nothing. The census therefore
-- names the variants each scenario must witness IN THE TRACE and asserts them
-- positively, and the scenarios' witnessed sets are asserted DISJOINT in the
-- variants that discriminate them — a fixture where every scenario reaches the
-- same events cannot tell which scenario closed which variant (S7).

module scripts/dst/ledger_parity_dst

import std/io (println, exit)
import std/json (jo, kv, js)
import std/list as List (length)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/ai (Message)
import src/core/config (CostRates)
import pkg/sunholo/motoko_ext_abi/types (
  BudgetPlan, ExtRuntime, ExtCtx, VerificationConfig,
  ToolCallEnvelope, ToolPolicyDecision, Allow, Deny, Pending, DenyAfterTimeout,
  ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome, PreStepOutcome,
  PromptPatch, BudgetPatch, Msg, Delegate, Handled, NoIntercept, NoDecision, PassThrough
)
import src/core/test/ext_fixture (fixture_hooks, FixtureHooks, FixtureOverrides)
import src/core/session (TracedSessionResult)
import src/core/session as Session
import src/core/test/stub_step (
  Scripted, ScriptedWorld, empty_rt,
  prose_step, tool_step, continuing_token_step, chunked_prose_step
)
import src/core/ports (ScriptedStep, WorldState, empty_world_state)
import src/core/phase_vocab (LedgerTrace, LedgerRecord, WireRecord)
import src/core/dst_event_vocabulary (EventRow, event_vocabulary, is_logical)
import src/core/dst_invariants (d64_gap_register, record_variant, join_str)

-- ---------------------------------------------------------------------------
-- Reporting
-- ---------------------------------------------------------------------------

func report(label: string, ok: bool, detail: string) -> bool ! {IO} {
  let _ = if ok then println("  ✓ ${label}")
          else println("  ✗ ${label}\n      ${detail}");
  ok
}

pure func contains_str(xs: [string], t: string) -> bool {
  match xs {
    [] => false,
    x :: rest => if x == t then true else contains_str(rest, t)
  }
}

pure func pipe_join(xs: [string]) -> string {
  match xs {
    [] => "",
    x :: rest => "${x}|${pipe_join(rest)}"
  }
}

pure func last_of(xs: [string]) -> string {
  match xs {
    [] => "",
    x :: [] => x,
    _ :: rest => last_of(rest)
  }
}

pure func count_of(t: string, xs: [string]) -> int {
  match xs {
    [] => 0,
    x :: rest => (if x == t then 1 else 0) + count_of(t, rest)
  }
}

-- ---------------------------------------------------------------------------
-- The two channels
-- ---------------------------------------------------------------------------

-- The RETURNED side: the wire-record variants of the returned trace, in order.
-- Decision and compaction-stage records are not wire events and are skipped;
-- `record_variant` spells both with angle brackets, which is what this filters.
pure func trace_variants(rs: [LedgerRecord]) -> [string] {
  match rs {
    [] => [],
    r :: rest =>
      match r {
        WireRecord(e) => record_variant(r) :: trace_variants(rest),
        _ => trace_variants(rest)
      }
  }
}

-- The REQUIRED set, read out of the register rather than restated here. A
-- Logical row the register does not list is a variant D6.4 requires in the
-- returned trace, and the shell compares its wire count against its trace count.
--
-- Driving this off `d64_gap_register()` rather than off `reaches_trace_today` is
-- deliberate: the survey field is the CLAIM this gate exists to check, so a gate
-- that read it would agree with whatever the claim said.
pure func required_rows(rows: [EventRow]) -> [EventRow] {
  match rows {
    [] => [],
    r :: rest => {
      let tail = required_rows(rest);
      if is_logical(rows, r.variant) && not contains_str(d64_gap_register(), r.variant)
      then r :: tail
      else tail
    }
  }
}

func print_required(rows: [EventRow]) -> () ! {IO} {
  match rows {
    [] => (),
    r :: rest => {
      let _ = print_wire_names(r.variant, r.wire_names);
      print_required(rest)
    }
  }
}

func print_wire_names(variant: string, names: [string]) -> () ! {IO} {
  match names {
    [] => (),
    n :: rest => {
      let _ = println("LEDGER_REQUIRE ${variant} ${n}");
      print_wire_names(variant, rest)
    }
  }
}

-- ---------------------------------------------------------------------------
-- Runtimes. Each scenario differs from `empty_rt()` in ONE decision, so the
-- variant it witnesses is attributable to that decision.
-- ---------------------------------------------------------------------------

pure func no_verification() -> VerificationConfig {
  { enabled: false, command: "" }
}

func base_hooks(id: string, policy: (ExtCtx, ToolCallEnvelope) -> ToolPolicyDecision) -> FixtureHooks {
  fixture_hooks(id, base_overrides(policy))
}

-- B7: the overrides as a value, updated by KIND below (no slot names).
func base_overrides(policy: (ExtCtx, ToolCallEnvelope) -> ToolPolicyDecision) -> FixtureOverrides {
  {
    tools: [],
    describe: \_ . [],
    prompt: func(_ctx: ExtCtx) -> PromptPatch { { prepend: [], append: [] } },
    budget: func(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch {
      { requested_total: None, requested_solver: None, requested_verifier: None }
    },
    compact: func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {AI, IO, Trace} {
      { decision: PassThrough, next_state: ctx.world }
    },
    policy: policy,
    provide: func(ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand} {
      { decision: Delegate, next_state: ctx.world }
    },
    intercept: func(ctx: ExtCtx, _text: string) -> ResponseInterceptOutcome ! {IO, Process, FS, Clock} {
      { decision: NoIntercept, next_state: ctx.world }
    },
    judge: func(ctx: ExtCtx, _text: string) -> FinalizeOutcome ! {Process} {
      { decision: NoDecision, next_state: ctx.world }
    }
  }
}

func rt_with(id: string, policy: (ExtCtx, ToolCallEnvelope) -> ToolPolicyDecision) -> ExtRuntime {
  { registry: { hooks: [base_hooks(id, policy)] }, strict_mode: false, verification: no_verification() }
}

func deny_rt() -> ExtRuntime {
  rt_with("d2_deny", \_ctx _call. Deny("WI-D2: denied by policy"))
}

func pending_rt() -> ExtRuntime {
  rt_with("d2_pending", \_ctx _call. Pending("WI-D2: approval required", DenyAfterTimeout))
}

-- The extension-served tool. `ExtToolHandled` was recorded as needing an
-- installed extension and therefore as unreachable here; it does NOT — a hook
-- returning `Handled` reaches it, and `scripts/dst/long_qwen_compaction_dst.ail`
-- has been doing so all along. MEASURED at WI-D2: 47 `ext_tool_handled` lines on
-- the wire across one `make dst` run, before this subject existed. This subject
-- exists so the closure is OBSERVED by the wire gate rather than inferred from
-- another target's output.
func handled_rt() -> ExtRuntime {
  let hooks = fixture_hooks("d2_handled", {
    base_overrides(\_ctx _call. Allow) |
    tools: ["BashExec"],
    provide: func(ctx: ExtCtx, call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand} {
      {
        decision: Handled({
          tool_call_id: call.id,
          tool: call.tool,
          exit_code: 0,
          stdout: "WI-D2 handled by extension",
          stderr: "",
          metadata: jo([kv("fixture", js("d2_handled"))])
        }),
        next_state: ctx.world
      }
    }
  });
  { registry: { hooks: [hooks] }, strict_mode: false, verification: no_verification() }
}

-- The DP7 runtime. `enabled` with a command that exits non-zero and prints
-- nothing recognisable as missing infrastructure, so `run_dp7_verifier`
-- Rejects rather than failing open. This is the only scenario that needs the
-- Process capability for its own sake.
func dp7_rt() -> ExtRuntime {
  let v: VerificationConfig = { enabled: true, command: "exit 3" };
  { registry: { hooks: [] }, strict_mode: false, verification: v }
}

-- ---------------------------------------------------------------------------
-- Fixtures
-- ---------------------------------------------------------------------------

pure func system_msg() -> Message {
  { role: "system", content: "ledger parity system prefix", tool_calls: [], tool_call_id: "", images: [] }
}

pure func zero_rates() -> CostRates {
  { input_per_1m_millicents: 0, output_per_1m_millicents: 0 }
}

-- Non-zero rates make `cost_metered` true, which is the precondition for
-- `decide` to ever return BudgetExceeded (src/core/step_machine.ail:104).
pure func metered_rates() -> CostRates {
  { input_per_1m_millicents: 1000000, output_per_1m_millicents: 1000000 }
}

pure func mk_budget() -> BudgetPlan {
  { total: 10, solver: 10, verifier: 0 }
}

pure func tool_script() -> [ScriptedStep] {
  [tool_step("BashExec", "{\"cmd\":\"true\"}", "d2-tc"), prose_step("done")]
}

-- A provider fault with no retry left, so the run reaches the errored half of
-- the stream bracket rather than the retry.
pure func errored_script() -> [ScriptedStep] {
  [{ chunked_prose_step("unused", ["e-alpha", "e-omega"]) |
     error_code: "E_PROVIDER_CONTEXT_LENGTH",
     error_message: "WI-D2: scripted non-retryable provider fault" }]
}

-- `continuing_token_step`, not `token_step`: a "stop" step finalizes before the
-- loop ever re-enters `decide`, so the cost cap is never consulted. The tool
-- call makes the loop iterate, and `decide` reads the accumulated cost on the
-- NEXT entry — which is the only place BudgetExceeded is produced.
pure func metered_script() -> [ScriptedStep] {
  [continuing_token_step(4000, 4000, "d2-cost-1"),
   continuing_token_step(4000, 4000, "d2-cost-2"),
   prose_step("done")]
}

-- The shell token is what makes `needs_delegation_for_process` true. A plain
-- `true` command routes Native and this fixture stops testing what it names.
pure func delegated_script() -> [ScriptedStep] {
  [tool_step("BashExec", "{\"cmd\":\"true | cat\"}", "d2-deleg"), prose_step("done")]
}

pure func approval_world() -> WorldState {
  { empty_world_state() |
    script: tool_script(),
    approvals: ["{\"type\":\"deny\",\"reason\":\"WI-D2 operator denial\"}"] }
}

-- ---------------------------------------------------------------------------
-- One scenario
-- ---------------------------------------------------------------------------

func check_scenario(
  label: string,
  run: TracedSessionResult,
  must_witness: [string]
) -> bool ! {IO} {
  let vs = trace_variants(run.trace.records);
  let _ = println("LEDGER_TRACE ${label} ${pipe_join(vs)}");
  let _ = println("  [${label}] ${show(List.length(vs))} wire record(s) in the returned trace");

  -- ANTI-VACUITY. A scenario that reached none of its own variants makes every
  -- shell row below it compare zero against zero, which is green.
  let non_empty = report("${label}: the returned trace holds wire records at all",
                         List.length(vs) > 0,
                         "the returned trace holds no WireRecord — every wire-vs-trace row for this subject would be vacuous");

  -- ROW 7'S FIRST CONJUNCT, ON A REAL RUN. `terminal_summary_findings` states it
  -- and `invariants_dst` exercises it — but only over a CONSTRUCTED fixture, so
  -- an append that lands after the finalizer is invisible to it. WI-D2 measured
  -- that: the mutant putting `CostExhausted` after `c2_finalize` leaves
  -- `make invariants` completely green. Every append this item added is on a
  -- path where getting this wrong is one expression away, so the claim is made
  -- here, over each of the eight runs, in the same terms D6.1 uses.
  let summary_n = count_of("RunSummary", vs);
  let terminal_ok =
    report("${label}: exactly one RunSummary, and it is the FINAL wire record (D6.1)",
           summary_n == 1 && last_of(vs) == "RunSummary",
           "RunSummary occurs ${show(summary_n)} time(s) and the last wire record is '${last_of(vs)}' — an append that lands after c2_finalize is `record-after-terminal`");

  -- THE CENSUS, and per S19 a zero here is a claim rather than an observation:
  -- the shell checks each of these against the wire independently.
  let witnessed = census(label, must_witness, vs);
  non_empty && terminal_ok && witnessed
}

func census(label: string, want: [string], got: [string]) -> bool ! {IO} {
  match want {
    [] => true,
    v :: rest => {
      let n = count_of(v, got);
      let ok = report("${label}: the returned trace holds ${v}",
                      n > 0,
                      "${v} occurs 0 times in the returned trace — the driver emitted it and appended nothing, which is exactly D6.4's gap");
      let tail = census(label, rest, got);
      ok && tail
    }
  }
}

export func main() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  println("=== ledger_parity_dst (D6.4, general obligation) ===");

  let required = required_rows(event_vocabulary());
  let _ = println("  ${show(List.length(required))} Logical variant(s) are required in the returned trace (vocabulary minus d64_gap_register)");
  let _ = print_required(required);

  -- The required set must be non-empty and must not be the whole vocabulary:
  -- the first would make the shell's loop iterate over nothing, the second
  -- would mean the register was emptied rather than shrunk.
  let req_ok =
    report("the required set is non-empty",
           List.length(required) > 0,
           "d64_gap_register() covers every Logical row — the shell would compare nothing")
    && report("the register still carries the variants no run here can reach",
              List.length(d64_gap_register()) > 0,
              "an empty register is a claim that every Logical variant reaches the trace, which this profile cannot establish");

  -- Subject 1: native dispatch. The tool-dispatch fold's allowed path.
  let native = Session.run_v2_session_traced(
    empty_rt(), "task", "", false, mk_budget(), "phase-c-model",
    [system_msg()], "/tmp", 6, false, 0, zero_rates(), Scripted(tool_script())
  );
  let r1 = check_scenario("native", native,
    ["NativeToolCalls", "V2ToolDispatchStart", "V2ToolDispatchComplete", "NativeToolResults", "ThinkingStreamEnd"]);

  -- Subject 2: policy denial. The fold's Deny arm.
  let denied = Session.run_v2_session_traced(
    deny_rt(), "task", "", false, mk_budget(), "phase-c-model",
    [system_msg()], "/tmp", 6, false, 0, zero_rates(), Scripted(tool_script())
  );
  let r2 = check_scenario("denied", denied, ["NativeToolDenied"]);

  -- Subject 3: approval. The fold's Pending arm, then the driver's resolution.
  let pending = Session.run_v2_session_traced(
    pending_rt(), "task", "", false, mk_budget(), "phase-c-model",
    [system_msg()], "/tmp", 6, false, 0, zero_rates(), ScriptedWorld(approval_world())
  );
  let r3 = check_scenario("pending", pending, ["ToolPending", "NativeToolDenied"]);

  -- Subject 4: the errored half of the stream bracket.
  let errored = Session.run_v2_session_traced(
    empty_rt(), "task", "", false, mk_budget(), "phase-c-model",
    [system_msg()], "/tmp", 6, false, 0, zero_rates(), Scripted(errored_script())
  );
  let r4 = check_scenario("errored", errored, ["ThinkingStreamEnd"]);

  -- Subject 5: the cost-cap terminal path.
  let capped = Session.run_v2_session_traced(
    deny_rt(), "task", "", false, mk_budget(), "phase-c-model",
    [system_msg()], "/tmp", 6, false, 1, metered_rates(), Scripted(metered_script())
  );
  let r5 = check_scenario("capped", capped, ["CostExhausted"]);

  -- Subject 6: the DP7 re-injection path, which is NOT terminal — the run
  -- continues after it, which is why its append is unconstrained by D6.1.
  let rejected = Session.run_v2_session_traced(
    dp7_rt(), "task", "", false, mk_budget(), "phase-c-model",
    [system_msg()], "/tmp", 4, false, 0, zero_rates(), Scripted([prose_step("done"), prose_step("done again")])
  );
  let r6 = check_scenario("dp7", rejected, ["Dp7VerifierRejected"]);

  -- Subject 7: an extension-served tool. See `handled_rt`.
  let handled = Session.run_v2_session_traced(
    handled_rt(), "task", "", false, mk_budget(), "phase-c-model",
    [system_msg()], "/tmp", 6, false, 0, zero_rates(), Scripted(tool_script())
  );
  let r7 = check_scenario("handled", handled, ["ExtToolHandled"]);

  -- Subject 8: the v2 Delegated backend, which defers rather than executing.
  -- `ohmy_pi` true and a shell token in the command is what routes BashExec to
  -- Delegated (`tool_runtime.needs_delegation_for_process`); without both, the
  -- call goes Native and this subject silently becomes a duplicate of `native`.
  let delegated = Session.run_v2_session_traced(
    empty_rt(), "task", "", false, mk_budget(), "phase-c-model",
    [system_msg()], "/tmp", 6, true, 0, zero_rates(), Scripted(delegated_script())
  );
  let r8 = check_scenario("delegated", delegated, ["DelegatedToolDeferred"]);

  -- ORDER, PINNED, because the wire comparison cannot see it. The shell counts
  -- per variant, and a count is green on a log appended as a BLOCK in the wrong
  -- place — after the batch results instead of inside the batch, say. A global
  -- wire-against-trace sequence comparison cannot supply this either: the
  -- `DoneEvent` is deliberately appended BEFORE `c2_finalize` and projected
  -- AFTER it (WI-A14), so the two channels legitimately disagree on order at
  -- exactly one point and an equality would be red by design.
  --
  -- So the order claim is a pinned sequence over the returned trace. Two
  -- subjects rather than all eight: `native` states where the dispatch events
  -- sit, and `capped` states the terminal ordering D6.1 turns on.
  let native_order = pipe_join(trace_variants(native.trace.records));
  let capped_order = pipe_join(trace_variants(capped.trace.records));
  let order_ok =
    report("order: the dispatch events land BETWEEN the batch announcement and its results",
           native_order == "ThinkingStreamStart|ProviderCallPrepared|ThinkingStreamEnd|ProviderResult|NativeToolCalls|V2ToolDispatchStart|V2ToolDispatchComplete|NativeToolResults|ThinkingStreamStart|ProviderCallPrepared|ThinkingStreamEnd|ProviderResult|DoneEvent|RunSummary|",
           "native order is ${native_order}")
    && report("order: CostExhausted is appended BEFORE the RunSummary, which stays final (D6.1)",
           capped_order == "ThinkingStreamStart|ProviderCallPrepared|ThinkingStreamEnd|ProviderResult|NativeToolCalls|NativeToolDenied|NativeToolResults|CostExhausted|RunSummary|",
           "capped order is ${capped_order} — a CostExhausted after the summary is `record-after-terminal`");

  -- S7: the scenarios must DIFFER in what they witness, or one of them is
  -- carrying the others and the per-scenario census is decoration.
  let native_vs = trace_variants(native.trace.records);
  let denied_vs = trace_variants(denied.trace.records);
  let disjoint =
    report("fixture: the denial subject does NOT reach the native dispatch events",
           count_of("V2ToolDispatchStart", denied_vs) == 0,
           "the denial subject executed a tool, so it is not isolating the Deny arm")
    && report("fixture: the native subject does NOT reach the denial event",
              count_of("NativeToolDenied", native_vs) == 0,
              "the native subject denied a tool, so it is not isolating the allowed arm");

  let _ = println("LEDGER_SUBJECTS 8");

  if req_ok && r1 && r2 && r3 && r4 && r5 && r6 && r7 && r8 && order_ok && disjoint then println("ledger_parity_dst PASS")
  else {
    let _ = println("ledger_parity_dst FAIL");
    exit(1)
  }
}
