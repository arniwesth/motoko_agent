module scripts/dst/conformance_selftest

import std/io (println, exit)
import std/result (Result, Ok, Err)
import pkg/sunholo/motoko_ext_abi/types (ExtensionHooks)
import pkg/sunholo/motoko_ext_conformance/harness (
  Scenario,
  run_scenario,
  compaction_occurred,
  scenario_system_prefix_preserved,
  scenario_tool_pairing_preserved,
  scenario_deterministic_replay,
  scenario_artifact_cache_effective
)
import pkg/sunholo/motoko_ext_conformance/fixtures/reject_fixtures (
  reject_prefix_hooks,
  reject_pair_hooks,
  reject_nocache_hooks
)
import pkg/sunholo/motoko_ext_compaction_ai/register (register_with_config as register_ai)
import pkg/sunholo/motoko_ext_compaction_structural/register (register_with_config as register_structural)

func expect_ok(label: string, hooks: ExtensionHooks, s: Scenario) -> int ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  match run_scenario(hooks, s) {
    Ok(_) => 0,
    Err(f) => {
      let _ = println("selftest FAIL ${label} scenario=${s.id} unexpected=${f.failed_invariant}");
      1
    }
  }
}

func expect_fail(label: string, hooks: ExtensionHooks, s: Scenario, expected: string) -> int ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  match run_scenario(hooks, s) {
    Ok(_) => {
      let _ = println("selftest FAIL ${label} scenario=${s.id} expected=${expected} got=ok");
      1
    },
    Err(f) =>
      if f.failed_invariant == expected then 0
      else {
        let _ = println("selftest FAIL ${label} scenario=${s.id} expected=${expected} got=${f.failed_invariant}");
        1
      }
  }
}

func expect_accept(label: string, hooks: ExtensionHooks) -> int ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  let failures =
    expect_ok(label, hooks, scenario_system_prefix_preserved())
    + expect_ok(label, hooks, scenario_tool_pairing_preserved())
    + expect_ok(label, hooks, scenario_deterministic_replay())
    + expect_ok(label, hooks, scenario_artifact_cache_effective());
  if compaction_occurred(hooks) then failures
  else {
    let _ = println("selftest FAIL ${label} invariant=compaction_occurred");
    failures + 1
  }
}

func expect_reject_prefix() -> int ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  let hooks = reject_prefix_hooks();
  expect_fail("reject_prefix", hooks, scenario_system_prefix_preserved(), "no_system_in_output")
    + expect_ok("reject_prefix", hooks, scenario_tool_pairing_preserved())
    + expect_ok("reject_prefix", hooks, scenario_deterministic_replay())
    + expect_ok("reject_prefix", hooks, scenario_artifact_cache_effective())
}

func expect_reject_pair() -> int ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  let hooks = reject_pair_hooks();
  expect_ok("reject_pair", hooks, scenario_system_prefix_preserved())
    + expect_fail("reject_pair", hooks, scenario_tool_pairing_preserved(), "pairing_preserved")
    + expect_ok("reject_pair", hooks, scenario_deterministic_replay())
    + expect_ok("reject_pair", hooks, scenario_artifact_cache_effective())
}

func expect_reject_nocache() -> int ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  let hooks = reject_nocache_hooks();
  expect_ok("reject_nocache", hooks, scenario_system_prefix_preserved())
    + expect_ok("reject_nocache", hooks, scenario_tool_pairing_preserved())
    + expect_ok("reject_nocache", hooks, scenario_deterministic_replay())
    + expect_fail("reject_nocache", hooks, scenario_artifact_cache_effective(), "artifact_cache_effective")
}

export func main() -> () ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  let ai = register_ai({});
  let structural = register_structural({});
  let failures =
    expect_reject_prefix()
    + expect_reject_pair()
    + expect_reject_nocache()
    + expect_accept("compaction_ai", ai)
    + expect_accept("compaction_structural", structural);
  if failures == 0 then println("conformance self-test PASS")
  else {
    let _ = println("conformance self-test FAIL count=${show(failures)}");
    exit(1)
  }
}
