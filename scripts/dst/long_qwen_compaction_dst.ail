-- ---------------------------------------------------------------------------
-- S12's executable instrument, on the ONE hook in the tree that calls ai_step
-- ---------------------------------------------------------------------------
--
-- WI-B2b found the same defect twice inside `compact_with_ai`: a re-wrap that
-- discarded the world the summarizer advanced, and failure branches returning
-- the ENTERED world after attempts had been made and script entries consumed.
-- `next_state: ctx.world` type-checks everywhere and passed every test in the
-- tree, so B2b shipped a comment and said plainly that a comment is weaker than
-- a check. This is the check.
--
-- It needs a RECORDING provider, and that is the whole reason it lives here
-- rather than beside the other direct-ctx scenarios: `summary_ports` above
-- returns `next_state: state` unchanged, so under it EVERY hook looks like it
-- dropped its successor and the assertion would be a false positive on correct
-- code. `stub_step.recording_ports` appends an interaction to `WorldState.log`
-- on every model step, and `ext_world.world_json` round-trips that log through
-- the token -- which is the counter WI-B2b believed the token did not carry,
-- and the reason this could be built at all.
--
-- BOTH directions are asserted, because either alone is satisfiable by a
-- degenerate check: the hook that CALLS the summarizer must advance the world,
-- and the hook that short-circuits below threshold must NOT (S12: an identity
-- transition is the correct answer for a component that did nothing).
func recording_direct_ctx(limit: int, artifacts: Json, w: WorldState)
  -> ExtCtx ! {AI, Clock, Env, FS, IO, Process, Trace} {
  { direct_ctx_with_task_step(limit, recording_ports(empty_rt()), artifacts, "s12", 0)
    | world: world_to_token(w) }
}

func scenario_s12_successor_is_not_dropped() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let cfg: CompactionAiConfig = {
    model: qwen_model, threshold_pct: 1, keep_recent: 4, keep_recent_tokens: 300,
    min_relief_pct: 5, rate_limit_enabled: false, min_gap_steps: 3, hard_override_pct: 95
  };
  let w = scripted_world_state([prose_step("a summary of the earlier turns")]);

  -- (a) OVER threshold: the summarizer is called, so the world MUST advance.
  let entered_hot = world_to_token(w);
  let hot = compact_with_ai(recording_direct_ctx(100, empty_ext_artifacts(), w), direct_msgs(), cfg);
  let hot_ok = not dropped_successor(entered_hot, hot.next_state, true);

  -- (b) UNDER threshold: nothing is called, so the identity transition is
  --     CORRECT and must not be reported as a defect.
  let entered_cold = world_to_token(w);
  let cold = compact_with_ai(recording_direct_ctx(1000000, empty_ext_artifacts(), w),
                             [abi_msg("user", "short")], cfg);
  let cold_ok = not dropped_successor(entered_cold, cold.next_state, false)
                  && not world_advanced(entered_cold, cold.next_state);

  if hot_ok && cold_ok then Ok(())
  else Err({ failed_invariant: "a hook that performed a provider call returns the world it advanced (S12)",
             trace: ["hot_advanced=${show(world_advanced(entered_hot, hot.next_state))}",
                     "hot_log_in=${show(world_interaction_count(entered_hot))}",
                     "hot_log_out=${show(world_interaction_count(hot.next_state))}",
                     "cold_advanced=${show(world_advanced(entered_cold, cold.next_state))}"] })
}

func s12_successor_scenario() -> Scenario {
  { id: "compaction.compaction_ai_successor_is_not_dropped", seed: "fixed", run: scenario_s12_successor_is_not_dropped }
}

export func main() -> () ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  let scenarios = [
    multiple_compactions_scenario(),
    replay_deterministic_scenario(),
    output_shape_scenario(),
    artifact_cache_scenario(),
    hostile_summary_scenario(),
    terminal_observations_scenario(),
    seal_side_exhaustion_scenario(),
    strict_provider_orphaned_toolcall_scenario(),
    s12_successor_scenario()
  ];
  let failed = run_all(scenarios, 0);
  if failed == 0 then println("long_qwen_compaction_dst PASS count=${show(length(scenarios))}")
  else {
    let _ = println("long_qwen_compaction_dst FAIL failed=${show(failed)}");
    exit(1)
  }
}
