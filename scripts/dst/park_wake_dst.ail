  ToolCallEnvelope, ToolPolicyDecision, Allow,
  ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome, PreStepOutcome,
  PromptPatch, BudgetPatch, Msg, Delegate, Handled, NoIntercept, NoDecision, PassThrough
)
import src/core/test/ext_fixture (fixture_hooks)
import src/core/session (TracedSessionResult)
import src/core/session as Session
import src/core/test/stub_step (ScriptedWorld, RecordingWorld, prose_step, tool_step)
import src/core/ports (ScriptedStep, WorldState, empty_world_state, WakeObservation, WakeOutcome, Settled, Lost, OperatorInput, TimedOut, HostError, Aborted)
import src/core/phase_vocab (LedgerRecord, WireRecord, DecisionRecord, ParkEntered, WakeReceived, WorldRequest, DoneEvent, wait_id)
