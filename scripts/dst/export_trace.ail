-- scripts/dst/export_trace.ail
--
-- Project 010, plan task 3.1 — ADR-001 (010) D9's ledger-trace exporter.
--
-- Runs ONE profile at ONE seed and writes the RETURNED ledger trace as JSONL.
-- The output is the overlay trace format v1, owned and versioned by project 010,
-- not by 009.
--
-- ============================================================================
-- Three decisions that are load-bearing, and why
-- ============================================================================
--
-- 1. IT SERIALIZES THE RETURNED TRACE, NEVER THE STDOUT `^{` STREAM. The wire
--    projection already streams to stdout during any DST run (an AILANG `Trace`
--    effect; the Q3 probe counted 364 such lines in one baseline run, which is
--    what the Makefile's `grep -v '^{'` strips). That stream is the
--    EMISSION-WITNESS side: it carries neither of the two non-wire record kinds,
--    carries no run identity, and its parity with the returned trace is a
--    CHECKED INVARIANT rather than an identity. Capturing it is recorded in D9
--    as considered-and-rejected.
--
-- 2. IT WRITES VIA THE FS EFFECT, NOT STDOUT, for the same reason: stdout is
--    already occupied by that stream, and a stdout-JSONL exporter would need
--    fragile grep hygiene to separate its own output from the driver's.
--
-- 3. ONE PROFILE + ONE SEED PER INVOCATION. Non-negotiable, from the Q3 probe:
--    existing DST scripts run MANY driver runs per process under a single
--    shared `session_id`, so "one process = one run" is false for them, and
--    semantic tracing OOM-kills a full script outright. Many seeds means many
--    invocations — which is embarrassingly parallel, so this costs nothing.
--
-- COMPATIBILITY POSTURE. Read-only consumer, built entirely on exported pure
-- functions (`to_schema_v1`, `event_variant_id`, record pattern matching). No
-- core module changes; no DST script changes; nothing here versions the
-- 009/D6-governed vocabulary. Wire-projection drift propagates automatically and
-- is already guarded upstream by the round-trip in `event_vocabulary_dst.ail`.
--
-- SCOPE LIMIT, STATED IN THE HEADER RATHER THAN DISCOVERED LATER (plan Gap 7):
-- the only verified seed-run shape is the generated-corpus path that
-- `corpus_pr_dst.ail` uses. `generated_world`/`generated_world_at` are
-- script-local there, so this script REPLICATES that wiring from `dst_generator`
-- exports — it cannot import it. Any other profile is refused loudly rather than
-- silently forked, and every output file records which rig produced it.
--
-- Run through the wrapper, which supplies caps and run identity:
--   scripts/dst/run_export_trace.sh --seed 7 [--profile driver_only]
--
-- Output: tools/code-graph/.out/traces/<profile>/<seed>.jsonl (generated, D1)

module scripts/dst/export_trace

import std/io (println)
import std/fs (writeFileResult, mkdirAllResult)
import std/env (getEnvOr)
import std/json (Json, encode, jo, ja, kv, js, jb, jint)
import std/result (Result, Ok, Err)
import std/list as List (length, map)
import std/string (stringToInt, join)
import std/option (Option, None, Some)

import std/ai (Message)
import src/core/config (CostRates, VerificationConfig)
import src/core/session as Session
import src/core/session (TracedSessionResult)
import src/core/test/stub_step (GeneratedWorld)
import src/core/ports (WorldState, empty_world_state)
import src/core/types (Msg)
import src/core/tool_contract (ToolCallEnvelope)
import src/core/dst_generator (GeneratorBounds, generator_state, choose_environment)
import src/core/dst_program (program_schema_version)
import src/core/dst_driver_only (driver_only_manifest, driver_only_id, driver_only_version)
import src/core/dst_profile (ExecutionManifest, replay_metadata_of)
import src/core/dst_execution (interaction_log_of)
import src/core/dst_result (DstResult, RunCompleted, RunFailed, completed_run, harness_failure_kind_name)
import src/core/phase_vocab (
  LedgerTrace, LedgerRecord, WireRecord, CompactionStageRecord, DecisionRecord,
  InMemoryStageOutcome, TraceStageApplied, TraceStageRejected, TraceStageObserved, TraceStagePassed,
  to_schema_v1
)
import src/core/dst_event_vocabulary (event_variant_id)
import pkg/sunholo/motoko_ext_abi/types (
  PreStepOutcome, ToolHandleOutcome, ResponseInterceptOutcome, FinalizeOutcome,
  BudgetPlan, BudgetPatch, PromptPatch, ToolSchema, ToolPolicyDecision,
  Pending, DenyAfterTimeout, Delegate, NoIntercept, NoDecision, PassThrough,
  ExtCtx, ExtRuntime, ExtensionHooks
)

-- ============================================================================
-- Format identity. Owned here (D9), versioned here.
-- ============================================================================

pure func overlay_trace_version() -> int { 1 }
pure func supported_profile() -> string { driver_only_id() }

-- ============================================================================
-- The seeded world — REPLICATED from corpus_pr_dst's script-local wiring
-- ============================================================================
-- Kept byte-for-byte in step with `corpus_pr_dst.ail:299-313`. If those diverge,
-- the same seed stops meaning the same world, and the divergence view silently
-- compares two different experiments. That is why the shape is repeated here
-- verbatim rather than approximated.

pure func generator_version() -> string { "1" }

-- THE RECORDS-PER-STEP LEVER, AND IT IS OFF BY DEFAULT.
--
-- `chunk_draw_hi` is the only field here that is not a literal, and `default_chunk_draw_hi()`
-- is what `corpus_pr_dst.ail:301-309` declares — so at the default this function is
-- byte-identical to the wiring it is kept in step with, and the exported trace,
-- `make depth_canary`'s three pinned record counts and every digest downstream are
-- unmoved. `main` supplies the default unless `CG_EXPORT_CHUNK_DRAW_HI` says
-- otherwise; see `chunk_draw_hi_of_env`.
--
-- `max_chunks_per_interaction` RISES WITH THE RANGE and that is not a second knob.
-- `bounded_draw` clamps a draw that exceeds the declared limit and records a
-- `BoundFailure`, `GeneratorBoundFailure` maps to `HarnessHygiene`
-- (`dst_invariants.ail:369`), and that family requires zero — so a range wider than
-- the declared limit would report every run as a generator failure AND cap the
-- record count at the limit, which is the two ways it could ruin the measurement at
-- once. The plan states the rule: widening the draw without raising the declared
-- bound in the same place is a D2 violation, not a re-pin. At the default the
-- expression yields 4, unchanged.
pure func default_chunk_draw_hi() -> int { 3 }

pure func bounds_at(chunk_draw_hi: int) -> GeneratorBounds {
  { max_interactions: 96,
    max_chunks_per_interaction: if chunk_draw_hi > 4 then chunk_draw_hi else 4,
    max_payload_bytes: 512,
    max_resource_size: 8,
    max_clock_advance_ms: 2000,
    chunk_draw_hi: chunk_draw_hi }
}

pure func generated_world_at(version: string, seed: int, chunk_draw_hi: int) -> WorldState {
  let g = generator_state(supported_profile(), version, seed, bounds_at(chunk_draw_hi));
  let e = choose_environment(g, "initial_world");
  { empty_world_state() | gen: e.state, env: e.entries }
}

pure func generated_world(seed: int, chunk_draw_hi: int) -> WorldState {
  generated_world_at(generator_version(), seed, chunk_draw_hi)
}

-- ============================================================================
-- The driver rig — also replicated from corpus_pr_dst's approval runtime
-- ============================================================================

pure func msg(role: string, content: string) -> Message {
  { role: role, content: content, tool_calls: [], tool_call_id: "", images: [] }
}
pure func history() -> [Message] { [msg("system", "s"), msg("user", "u")] }
pure func budget() -> BudgetPlan { { total: 10, solver: 6, verifier: 4 } }
pure func zero_rates() -> CostRates { { input_per_1m_millicents: 0, output_per_1m_millicents: 0 } }

func no_describe() -> [ToolSchema] { [] }
func no_prompt(_ctx: ExtCtx) -> PromptPatch { { prepend: [], append: [] } }
func no_budget(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch {
  { requested_total: None, requested_solver: None, requested_verifier: None }
}
func no_handle(ctx: ExtCtx, _call: ToolCallEnvelope)
  -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand} {
  { decision: { Delegate }, next_state: ctx.world }
}
func no_intercept(ctx: ExtCtx, _text: string)
  -> ResponseInterceptOutcome ! {IO, Process, FS, Clock} {
  { decision: { NoIntercept }, next_state: ctx.world }
}
func no_solver(ctx: ExtCtx, _text: string)
  -> FinalizeOutcome ! {Process} { { decision: { NoDecision }, next_state: ctx.world } }
func passthrough_pre_step(ctx: ExtCtx, _msgs: [Msg])
  -> PreStepOutcome ! {AI, IO, Trace} { { decision: { PassThrough }, next_state: ctx.world } }
func pending_policy(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolPolicyDecision {
  Pending("generated: approval required", DenyAfterTimeout)
}

func approval_rt(id: string) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  let hooks: ExtensionHooks = {
    id: id,
    provided_tools: [],
    on_describe_tools: no_describe,
    on_build_system_prompt: no_prompt,
    on_budget_plan: no_budget,
    on_pre_step: passthrough_pre_step,
    on_tool_policy: pending_policy,
    on_tool_handle: no_handle,
    on_response_intercept: no_intercept,
    on_solver_candidate: no_solver
  };
  { registry: { hooks: [hooks] }, strict_mode: false, verification: v }
}

func run_generated(id: string, w: WorldState) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(
    approval_rt(id), "task", "", false, budget(), "phase-c-model", history(), ".",
    12, false, 0, zero_rates(), GeneratedWorld(w))
}

pure func run_manifest() -> ExecutionManifest {
  driver_only_manifest("HEAD", "ailang 0.33.0", "4.0", "{}",
                       ["ai_step", "env_get", "proc_exec"], ["clock_now"], "HEAD")
}

-- ============================================================================
-- Serialization — the overlay trace format v1
-- ============================================================================
-- Envelope fields (`event_idx`, `record_key`, `seed`) sit OUTSIDE the payload
-- object. For a WireRecord the payload is EXACTLY `to_schema_v1(e)` — the
-- existing wire projection, reused unmodified through its exported API, so drift
-- propagates rather than being re-implemented here.

pure func stage_outcome_json(o: InMemoryStageOutcome) -> Json {
  match o {
    TraceStageApplied(d)     => jo([kv("kind", js("applied")), kv("detail", js(d))]),
    TraceStageRejected(d)    => jo([kv("kind", js("rejected")), kv("detail", js(d))]),
    TraceStageObserved(d, _) => jo([kv("kind", js("observed")), kv("detail", js(d))]),
    TraceStagePassed         => jo([kv("kind", js("passed")), kv("detail", js(""))])
  }
}

-- `record_key` is record-kind aware (D1/D5) and keys on the VARIANT, never on a
-- wire name: `StreamDelta` has two wire names, so a wire-name key would split
-- one variant across two buckets.
pure func record_key(r: LedgerRecord) -> string {
  match r {
    WireRecord(e)              => "WireRecord:${event_variant_id(e)}",
    CompactionStageRecord(_)   => "CompactionStageRecord",
    DecisionRecord(_)          => "DecisionRecord"
  }
}

pure func record_payload(r: LedgerRecord) -> Json {
  match r {
    WireRecord(e) => to_schema_v1(e),
    CompactionStageRecord(i) =>
      jo([kv("step", jint(i.step)), kv("ext_id", js(i.ext_id)),
          kv("outcome", stage_outcome_json(i.outcome))]),
    DecisionRecord(i) =>
      jo([kv("step", jint(i.step)), kv("decision", js(i.decision))])
  }
}

pure func record_line(seed: int, idx: int, r: LedgerRecord) -> string {
  encode(jo([
    kv("event_idx", jint(idx)),
    kv("record_key", js(record_key(r))),
    kv("seed", jint(seed)),
    kv("payload", record_payload(r))
  ]))
}

pure func record_lines(seed: int, idx: int, rs: [LedgerRecord]) -> [string] {
  match rs {
    [] => [],
    r :: rest => record_line(seed, idx, r) :: record_lines(seed, idx + 1, rest)
  }
}

-- The header carries run identity so `activity` rows are joinable to a run
-- without parsing filenames. NO WALL CLOCK ANYWHERE: re-running the same seed
-- must be byte-identical, and a timestamp would destroy that silently.
pure func header_line(
  seed: int, profile: string, complete: bool, failure_kind: string,
  record_count: int, ailang_version: string, motoko_commit: string
) -> string {
  encode(jo([
    kv("overlay_trace_version", jint(overlay_trace_version())),
    kv("seed", jint(seed)),
    kv("profile_id", js(profile)),
    kv("profile_version", js(driver_only_version())),
    kv("generator_version", js(generator_version())),
    kv("program_schema", js(program_schema_version())),
    kv("ailang_version", js(ailang_version)),
    kv("motoko_commit", js(motoko_commit)),
    -- False means the run did not complete and the records below are the
    -- PARTIAL trace. A consumer that ignores this would report a truncated run
    -- as a short one; D6.1's "exactly one final RunSummary" is exempt here.
    kv("run_complete", jb(complete)),
    kv("failure_kind", js(failure_kind)),
    kv("record_count", jint(record_count)),
    -- Gap 7, recorded in-band rather than in a doc nobody re-reads.
    kv("rig", js("generated-corpus path replicated from corpus_pr_dst"))
  ]))
}

pure func document(
  seed: int, profile: string, complete: bool, failure_kind: string,
  trace: LedgerTrace, ailang_version: string, motoko_commit: string
) -> string {
  let lines = record_lines(seed, 0, trace.records);
  let head = header_line(seed, profile, complete, failure_kind,
                         List.length(trace.records), ailang_version, motoko_commit);
  -- Trailing newline: JSONL is line-oriented, and a file whose last line has no
  -- terminator makes `wc -l` under-count by one and trips strict line readers.
  "${join("\n", head :: lines)}\n"
}

-- ============================================================================
-- Entry point
-- ============================================================================

pure func trace_dir(out_root: string, profile: string) -> string {
  "${out_root}/traces/${profile}"
}

export func main() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let out_root = getEnvOr("CG_OUT_DIR", "tools/code-graph/.out");
  let profile = getEnvOr("CG_EXPORT_PROFILE", supported_profile());
  let seed_text = getEnvOr("CG_EXPORT_SEED", "");
  let ailang_version = getEnvOr("CG_AILANG_VERSION", "unknown");
  let motoko_commit = getEnvOr("CG_MOTOKO_COMMIT", "unknown");
  -- CG_EXPORT_CHUNK_DRAW_HI — THE RECORDS-PER-STEP LEVER, unset by default and
  -- unparseable-means-default, so a typo cannot silently produce a narrower run
  -- than the one that was asked for: `widened` below is what decides, and it is
  -- false whenever the value is not a number.
  let chunk_draw_hi = match stringToInt(getEnvOr("CG_EXPORT_CHUNK_DRAW_HI", "")) {
    Some(n) => if n < 0 then default_chunk_draw_hi() else n,
    None => default_chunk_draw_hi()
  };
  let widened = chunk_draw_hi != default_chunk_draw_hi();

  if profile != supported_profile() then
    println("export_trace: REFUSED profile '${profile}'. Only '${supported_profile()}' has a verified seed-run shape (plan Gap 7). Adding another profile is a wiring decision to be argued, not a silent fork.")
  else
    match stringToInt(seed_text) {
      None =>
        println("export_trace: CG_EXPORT_SEED must be an integer, got '${seed_text}'. Run through scripts/dst/run_export_trace.sh."),
      Some(seed) => {
        let run = run_generated("ext_export", generated_world(seed, chunk_draw_hi));
        -- Build the DstResult exactly as dst_execution.result_of does (that
        -- function is script-private there, so the shape is replicated). The
        -- match below is not ceremony: it is what makes the partial-trace path
        -- a first-class output rather than an unhandled case.
        let dst = completed_run(run.result, run.trace, interaction_log_of(run.world),
                                replay_metadata_of(run_manifest()));
        let parts = match dst {
          RunCompleted(sr) => { trace: sr.ledger_trace, complete: true, kind: "" },
          RunFailed(hf)    => { trace: hf.partial_ledger_trace, complete: false,
                                kind: harness_failure_kind_name(hf.kind) }
        };
        -- CG_EXPORT_PHASE=driver — THE MEASUREMENT SEAM. Runs the driver and
        -- stops, reporting only a length. It exists because this exporter is
        -- the only place a real driver run can be observed out of process, and
        -- because `document()` below CANNOT be inside anything that measures
        -- recursion depth: `record_lines` costs one frame per record, so the
        -- whole-export depth is the serializer's, not the driver's. Measured
        -- 2026-08-17 — with the fault of motoko_agent#160 present the driver
        -- phase reports 73→86 over 63→79 records and the full export reports
        -- 70→86; the two are indistinguishable at the top of the range, which
        -- is exactly the discrimination this seam restores.
        --
        -- IT IS NOT A FEATURE AND WRITES NOTHING. The default path is
        -- untouched, so a normal export cannot take it by accident, and nothing
        -- downstream reads its output — it is read by a human or a bisection
        -- harness watching the process exit status.
        --
        -- WHY IT IS HERE RATHER THAN IN A THROWAWAY BRANCH: the spike that
        -- established the above built this seam, measured with it, and disposed
        -- of it by guardrail, which left #160's fix unverifiable end to end for
        -- exactly as long as it took to write this comment. See
        -- `.agent/projects/011_improve_test_axises/ADR-002-resource-growth-as-a-metamorphic-relation.md`
        -- Correction 6.
        --
        -- CG_EXPORT_CHUNK_DRAW_HI RIDES THIS SEAM AND ONLY THIS SEAM. The lever
        -- appears in the phase line so a bisection harness records what it swept,
        -- and a WIDENED run refuses to write a document at all: the file format is
        -- overlay trace v1 and its header records the rig, the profile and the
        -- generator version but has no field for a bounds override, so a written
        -- artifact would be a silent fork of the rig — the thing this file's header
        -- says is "a wiring decision to be argued, not a silent fork". Widening the
        -- exported artifact is that argument, and it is not this item's.
        if getEnvOr("CG_EXPORT_PHASE", "") == "driver" then
          println("export_trace: phase=driver — ${show(List.length(parts.trace.records))} records, run_complete=${show(parts.complete)}, chunk_draw_hi=${show(chunk_draw_hi)}")
        else if widened then
          println("export_trace: REFUSED — CG_EXPORT_CHUNK_DRAW_HI=${show(chunk_draw_hi)} widens the generator's chunk draw past the declared default of ${show(default_chunk_draw_hi())}, and the overlay trace v1 header has no field to record a bounds override in. It is a MEASUREMENT SEAM: run it with CG_EXPORT_PHASE=driver, which reports a record count and writes nothing. Exporting a trace at a non-default lever would fork the rig silently, which the header of this file refuses by name.")
        else {
        let text = document(seed, profile, parts.complete, parts.kind, parts.trace,
                            ailang_version, motoko_commit);
        let dir = trace_dir(out_root, profile);
        let path = "${dir}/${show(seed)}.jsonl";
        let _ = match mkdirAllResult(dir) {
          Ok(_)    => (),
          Err(msg) => println("export_trace: mkdir ${dir} failed: ${msg}")
        };
        match writeFileResult(path, text) {
          Ok(_) =>
            println("export_trace: wrote ${path} — ${show(List.length(parts.trace.records))} records, run_complete=${show(parts.complete)}"),
          Err(msg) =>
            println("export_trace: FAILED writing ${path}: ${msg}")
        }
        }
      }
    }
}
