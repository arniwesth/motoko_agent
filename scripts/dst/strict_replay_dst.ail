-- ---------------------------------------------------------------------------
-- Fixtures
-- ---------------------------------------------------------------------------

func msg(role: string, content: string) -> Message {
  { role: role, content: content, tool_calls: [], tool_call_id: "", images: [] }
}

func history() -> [Message] { [msg("system", "s"), msg("user", "u")] }
func budget() -> BudgetPlan { { total: 10, solver: 6, verifier: 4 } }
func zero_rates() -> CostRates { { input_per_1m_millicents: 0, output_per_1m_millicents: 0 } }

func tc(id: string) -> ToolCall { { id: id, name: "T", arguments: "{}" } }

-- A continuer carrying an arbitrary number of tool calls. `tool_step` builds
-- exactly one; several in one step is what lets a scenario's approval-read
-- count differ from its provider-call count, which S7 requires of the fixture
-- that must survive.
func multi_step(prose: string, calls: [ToolCall], chunks: [string]) -> ScriptedStep {
  { prose: prose,
    tool_calls: calls,
    input_tokens: 200,
    output_tokens: 100,
    finish_reason: "tool_calls",
    chunks: chunks , error_code: "", error_message: "", advance_ms: 0}
}

func approve_line() -> string { "{\"type\":\"approve\"}" }
func deny_line(reason: string) -> string { "{\"type\":\"deny\",\"reason\":\"${reason}\"}" }

-- The synthetic environment. Two keys PRESENT so the env class records
-- `OutcomeOk` reads, while the driver's other five keys are absent and record
-- `OutcomeMissing` — both statuses in one run, which is what makes the
-- reconstituted environment's fidelity observable rather than assumed.
func world_env() -> [{ key: string, value: string }] {
  [{ key: "MOTOKO_TOOL_TIMEOUT_MS", value: "5000" },
   { key: "MOTOKO_HEADLESS", value: "1" }]
}

func base_world(script: [ScriptedStep], answers: [string], tools: [ScriptedTool]) -> WorldState {
  { empty_world_state() | script: script, approvals: answers, env: world_env(), tools: tools }
}

-- ---------------------------------------------------------------------------
-- Extension plumbing: every tool call goes to the approval channel
-- ---------------------------------------------------------------------------

func no_describe(_config: Json) -> [ToolSchema] { [] }
func no_prompt(_ctx: PureCtx) -> PromptPatch { { prepend: [], append: [] } }
func no_budget(_ctx: PureCtx, _plan: BudgetPlan) -> BudgetPatch {
  { requested_total: None, requested_solver: None, requested_verifier: None }
}
func no_handle(ctx: ProviderCtx, _call: ToolCallEnvelope)
  -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand, Trace}  { { decision: { Delegate }, next_state: ctx.world } }
func no_intercept(ctx: InterceptCtx, _text: string)
  -> ResponseInterceptOutcome ! {IO, Process, FS, Clock}  { { decision: { NoIntercept }, next_state: ctx.world } }
func no_solver(ctx: ProcessCtx, _text: string)
  -> FinalizeOutcome ! {Process}  { { decision: { NoDecision }, next_state: ctx.world } }
func passthrough_pre_step(ctx: AiCtx, _msgs: [Msg])
  -> PreStepOutcome ! {AI, IO, Trace}  { { decision: { PassThrough }, next_state: ctx.world } }
func pending_policy(_ctx: PureCtx, _call: ToolCallEnvelope) -> ToolPolicyDecision {
  Pending("strict replay: approval required", DenyAfterTimeout)
}

func approval_rt(id: string) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  let hooks = fixture_hooks(id, {
    config: jo([]),
    tools: [],
    describe: no_describe,
    prompt: no_prompt,
    budget: no_budget,
    compact: passthrough_pre_step,
    policy: pending_policy,
    provide: no_handle,
    intercept: no_intercept,
    judge: no_solver
  });
  { registry: { entries: [hooks] }, strict_mode: false, verification: v }
}

func run_recording(id: string, w: WorldState, step_budget: int) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(
    approval_rt(id), "task", "", budget(), "phase-c-model", history(), ".",
    step_budget, false, 0, zero_rates(), RecordingWorld(w)
  )
}

-- ---------------------------------------------------------------------------
-- Witnesses
-- ---------------------------------------------------------------------------

pure func provider_calls_witnessed(records: [LedgerRecord]) -> int {
  match records {
    [] => 0,
    r :: rest =>
      (match r { WireRecord(ProviderCallPrepared(_)) => 1, _ => 0 })
        + provider_calls_witnessed(rest)
  }
}

pure func provider_steps_witnessed(records: [LedgerRecord]) -> [int] {
  match records {
    [] => [],
    r :: rest =>
      match r {
        WireRecord(ProviderCallPrepared(i)) => i.step :: provider_steps_witnessed(rest),
        _ => provider_steps_witnessed(rest)
      }
  }
}

pure func provider_steps_recorded(xs: [Interaction]) -> [int] {
  match xs {
    [] => [],
    i :: rest =>
      match i.identity.body {
        ProviderIdentity(_, step, _) => step :: provider_steps_recorded(rest),
        _ => provider_steps_recorded(rest)
      }
  }
}

-- How many tool calls the script entries this run CONSUMED carried.
--
-- The Err-surviving approval witness. Under `pending_policy` every tool call
-- goes to the approval channel exactly once, so this is the number of approval
-- READS the driver performed — the quantity stage 2 established the cursor
-- delta cannot witness, expressed from two sources that are both independent of
-- the recorder: the fixture's own script (an INPUT) and the world's `script`
-- cursor (moved by the provider adapter, not by the log append).
pure func tool_calls_in_consumed_prefix(initial: [ScriptedStep], remaining: int) -> int {
  let consumed = List.length(initial) - remaining;
  tool_calls_in_prefix(initial, consumed)
}

pure func tool_calls_in_prefix(xs: [ScriptedStep], n: int) -> int {
  if n <= 0 then 0
  else match xs {
    [] => 0,
    s :: rest => List.length(s.tool_calls) + tool_calls_in_prefix(rest, n - 1)
  }
}

-- The Err-surviving witness set. Every field comes from the returned trace or
-- from a world cursor, so it is identical in shape whether the run ended `Ok`
-- or `Err` — which is the property the failure-path scenarios need and the
-- message-derived witnesses do not have.
func witness_of(initial: WorldState, run: TracedSessionResult, expected_env: [EnvExpectation]) -> DiscoveryWitness {
  {
    provider_calls: provider_calls_witnessed(run.trace.records),
    tool_dispatches: List.length(initial.tools) - List.length(run.world.tools),
    approval_reads: tool_calls_in_consumed_prefix(initial.script, List.length(run.world.script)),
    approvals_consumed: List.length(initial.approvals) - List.length(run.world.approvals),
    clock_delta_ms: run.world.clock_ms - initial.clock_ms,
    -- WI-D19. These three scenarios route no filesystem mutation, so the
    -- expectation is the literal zero WI-D17 and WI-D18 pinned in
    -- `absent_classes` — the field is where that pin now lives, and it is still
    -- a claim rather than silence. See `DiscoveryWitness` for why the classes
    -- moved from a hard-coded 0 to a witness at WI-D19, and note that a
    -- future extension installed into THIS scenario has to change these by
    -- hand: nothing derives them from the run.
    file_writes: 0,
    file_removes: 0,
    dir_makes: 0,
    -- WI-D24 added the extension-effect class on the same terms: this scenario
    -- installs no extension that reaches `ExtPorts.tool_handle`, so the pin holds
    -- here and the class is still claimed at zero rather than unmentioned.
    extension_effects: 0,
    expected_env_reads: expected_env
  }
}

-- Session-wide env reads (session_policy_init's three plus derive_session_id's
-- one), each reached exactly once per traced run — derived from the driver's
-- source, as `dst_discovery`'s header requires for the one class with no
-- runtime witness.
-- P2T Part 5(a): the exit-manifest name read (`publish_turn_exit_manifest`,
-- session.ail:4582, key via `manifest_path_var()`). It runs once per traced
-- run that reaches DoneEvent through the success arm — so `rich` (Ok) reads
-- it on BOTH its discovery and its replay runs, while `maxsteps` (Err: step
-- budget suspends before any DoneEvent) never does. That asymmetry is why it
-- cannot join `env_reads_always`: the always-list is control-flow-independent
-- and this read is terminal-outcome-dependent. Callers pass whether their
-- scenario ends Ok; the count stays a literal because the env class emits no
-- ledger event. Pinned in `driver_env_keys()` by the `verify_exit_intent`
-- literal, since the Makefile grep (anchored to `.env_get(<world>, "KEY"`)
-- cannot see the indirection.
func env_reads_exit_publish(expect_ok: bool) -> [EnvExpectation] {
  if expect_ok then [{ key: "MOTOKO_EXIT_MANIFEST", count: 1 }] else []
}

func env_reads_always(resolutions: int) -> [EnvExpectation] {
  [{ key: "MOTOKO_RETRY_STREAM_ERROR", count: 1 },
   { key: "OPENAI_BASE_URL",           count: 1 },
   { key: "MOTOKO_HEADLESS",           count: 1 },
   { key: "MOTOKO_SESSION_ID",         count: 1 }]
    ++ env_reads_per_context_resolution(resolutions)
}

-- MOTOKO_TOOL_TIMEOUT_MS is read once per NATIVE dispatch (tool_phase.ail:343),
-- so its count is expressed in terms of the independently witnessed dispatch
-- count rather than as a literal.

-- WI-D3's four context-resolution keys, and their MULTIPLICITY.
--
-- `resolve_context_limit` performs five env requests per call against a world
-- whose env table does not carry these keys: MOTOKO_PROFILE_DIR, then
-- MOTOKO_CONFIG, then MOTOKO_REPO (from `profile_dir_path`), then
-- MOTOKO_MODELS_FILE, then MOTOKO_REPO again (from `catalog_path`). MOTOKO_REPO
-- is therefore read TWICE per resolution and the other three once, which is why
-- the rates below are not uniform — a uniform set would be satisfied by a
-- recorder that lost one of the two MOTOKO_REPO reads.
--
-- MEASURED PER SCENARIO, and the resolution count is a PARAMETER because the
-- first version of this made it a shared constant and that was wrong. WI-D3 set
-- it to 12 — correct for discovery's approve, deny and eof, read off
-- `make discovery`'s own census (environment_read=68/65/66 against 8/5/6
-- accounted for before this item, 60 = 12 x 5 in every case) — and strict
-- replay's scenarios reject it immediately: `rich` reaches 19 resolutions and
-- `maxsteps` 8, so the shared literal was over-recorded on one and
-- under-recorded on the other. The count tracks the loop arms a scenario takes,
-- not the run length, and no formula over the witnessed quantities fits the
-- three data points — 12 at provider=4, 19 at provider=5, 8 at provider=1 — so
-- each scenario states its own measurement rather than deriving a rule from
-- three observations.
--
-- The count is a literal because there is NO runtime witness to anchor it to:
-- the env class emits no ledger event, which is the same reason this whole set
-- exists, and deriving it from the log would put both sides of the check on one
-- producer — the defect S16 names.
--
-- It goes RED rather than stale when the driver's loop structure changes the
-- number of resolutions, and that is the intended failure: a changed count is a
-- changed env surface and this set is the env class's only independent evidence.
func env_reads_per_context_resolution(resolutions: int) -> [EnvExpectation] {
  [{ key: "MOTOKO_PROFILE_DIR", count: resolutions },
   { key: "MOTOKO_CONFIG",      count: resolutions },
   { key: "MOTOKO_MODELS_FILE", count: resolutions },
   { key: "MOTOKO_REPO",        count: resolutions * 2 }]
}


func env_reads_with_dispatch(dispatches: int, resolutions: int) -> [EnvExpectation] {
  env_reads_always(resolutions) ++ [{ key: "MOTOKO_TOOL_TIMEOUT_MS", count: dispatches }]
}

-- ---------------------------------------------------------------------------
-- Reporting
-- ---------------------------------------------------------------------------

func check(label: string, ok: bool, detail: string) -> bool ! {IO} {
  let _ = if ok then println("  ✓ ${label}") else println("  ✗ ${label} — ${detail}");
  ok
}

func report_replay(ms: [ReplayMismatch]) -> () ! {IO} {
  match ms {
    [] => (),
    m :: rest => { let _ = println("      ${replay_message(m)}"); report_replay(rest) }
  }
}

func report_discovery(fs: [DiscoveryFinding]) -> () ! {IO} {
  match fs {
    [] => (),
    f :: rest => { let _ = println("      ${discovery_message(f)}"); report_discovery(rest) }
  }
}

func report_reconstitution(fs: [ReconstitutionFinding]) -> () ! {IO} {
  match fs {
    [] => (),
    f :: rest => { let _ = println("      ${reconstitution_message(f)}"); report_reconstitution(rest) }
  }
}

-- A mutation row must trip its rule AND TRIP ONLY THAT RULE. Stage 2's
-- `renumber` established why: a mutant that trips two rules proves neither,
-- because either rule alone would have satisfied the row. Every mutation below
-- is therefore a SINGLE-POSITION edit, which a positional walk answers with a
-- single finding — a class drop would shift every later position and produce a
-- cascade that names nothing in particular.
func mutant(label: string, rule: string, program: [Interaction], actual: [Interaction]) -> bool ! {IO} {
  let ms = strict_replay_findings(program, actual);
  check("${rule} ← ${label}", has_replay_rule(ms, rule) && List.length(ms) == 1,
        "expected exactly one ${rule}; got ${show(List.length(ms))} mismatch(es): ${first_replay_message(ms)}")
}

-- Single-position mutations. Each replaces exactly one interaction and leaves
-- its ordinal alone, so the walk stays aligned and reports one divergence.
pure func replace_at(xs: [Interaction], pos: int, f: (Interaction) -> Interaction) -> [Interaction] {
  match xs {
    [] => [],
    i :: rest => if pos == 0 then f(i) :: rest else i :: replace_at(rest, pos - 1, f)
  }
}

-- The position of the first interaction of a class, or -1. Used so the
-- mutations below land on a class that exists in this scenario rather than at a
-- hard-coded index that a fixture change would silently move off.
pure func first_index_of(xs: [Interaction], kind: string, at: int) -> int {
  match xs {
    [] => -1,
    i :: rest => if interaction_kind(i) == kind then at else first_index_of(rest, kind, at + 1)
  }
}

pure func drop_kind(xs: [Interaction], kind: string) -> [Interaction] {
  match xs {
    [] => [],
    i :: rest => if interaction_kind(i) == kind then drop_kind(rest, kind) else i :: drop_kind(rest, kind)
  }
}

pure func renumber(xs: [Interaction], n: int) -> [Interaction] {
  match xs {
    [] => [],
    i :: rest => ({ i | identity: { i.identity | ordinal: n } }) :: renumber(rest, n + 1)
  }
}

pure func drop_last(xs: [Interaction]) -> [Interaction] {
  match xs {
    [] => [],
    _ :: [] => [],
    i :: rest => i :: drop_last(rest)
  }
}

-- Rewrite the payload of the first interaction of a class, leaving everything
-- else — including the identity — untouched. This is the mutation that only the
-- OUTCOME comparison can see: the request matches at every position.
pure func blank_first_payload(xs: [Interaction], kind: string) -> [Interaction] {
  match xs {
    [] => [],
    i :: rest =>
      if interaction_kind(i) == kind then
        ({ i | outcome: { i.outcome | payload: "" } }) :: rest
      else i :: blank_first_payload(rest, kind)
  }
}

-- ---------------------------------------------------------------------------
-- S7, made executable
-- ---------------------------------------------------------------------------
--
-- The fixture that must SURVIVE has to contain every shape the specification
-- explicitly protects, with no two of its quantities equal. Both halves are
-- CLAIMS, and cluster 8 measured that a fixture's stated justification is a
-- claim worth testing: the first version of `rich` documented a tool FAULT
-- outcome it did not actually reach, because the only fault entry in its queue
-- was never consumed. These two checks are what would have said so.

pure func count_status_of_kind(xs: [Interaction], kind: string, status_id: string) -> int {
  match xs {
    [] => 0,
    i :: rest =>
      (if interaction_kind(i) == kind && outcome_status_id(i.outcome.status) == status_id then 1 else 0)
        + count_status_of_kind(rest, kind, status_id)
  }
}

pure func count_with_chunks(xs: [Interaction]) -> int {
  match xs {
    [] => 0,
    i :: rest => (if List.length(i.outcome.chunks) > 0 then 1 else 0) + count_with_chunks(rest)
  }
}

pure func all_distinct(xs: [int]) -> bool {
  match xs {
    [] => true,
    x :: rest => not contains_int(rest, x) && all_distinct(rest)
  }
}

pure func contains_int(xs: [int], target: int) -> bool {
  match xs { [] => false, x :: rest => if x == target then true else contains_int(rest, target) }
}

pure func eq_ints(a: [int], b: [int]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs => match b { [] => false, y :: ys => x == y && eq_ints(xs, ys) }
  }
}

pure func join_ints(xs: [int]) -> string {
  match xs { [] => "", x :: [] => "${x}", x :: rest => "${x},${join_ints(rest)}" }
}

pure func projections(xs: [Interaction]) -> [string] {
  match xs {
    [] => [],
    i :: rest =>
      "${identity_projection(i.identity)}|${i.request_projection}|${i.outcome.payload}|${i.outcome.advance_ms}"
        :: projections(rest)
  }
}

pure func eq_list(a: [string], b: [string]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs => match b { [] => false, y :: ys => x == y && eq_list(xs, ys) }
  }
}

-- ---------------------------------------------------------------------------
-- The program
-- ---------------------------------------------------------------------------

pure func discovered_manifest() -> ExecutionManifest {
  driver_only_manifest("HEAD", "ailang 0.33.0", "8.0", "{}",
                       ["ai_step", "env_get", "tool_handle"], ["clock_now"], "HEAD")
}

pure func program_of(w: WorldState, initial: WorldState) -> ExecutionProgram {
  {
    schema_version: program_schema_version(),
    -- WI-A13 stage 4 renamed this from "driver_only_discovery". The world this
    -- program was discovered against is HAND-AUTHORED, and D2's three generator
    -- axes are required and validated non-blank, so before a generator existed
    -- these fields necessarily named one that did not. `seed: 0` in particular
    -- was consulted by nothing. The seeded generator is
    -- `src/core/dst_generator`, and its programs are produced by
    -- `scripts/dst/seeded_generator_dst.ail`, which reads these three axes off
    -- the world's own generator state instead of writing literals.
    generator_id: "hand_authored_discovery",
    generator_version: "1",
    seed: 0,
    initial_world: {
      messages_and_policy: "{\"messages\":[\"system\",\"user\"],\"policy\":\"driver_only\"}",
      synthetic_environment: initial.env,
      -- WI-D22: `execution-program/2` seeds the world's file table from the
      -- program. This fixture seeds nothing, which is what it did before the
      -- field existed; the seeded case is exercised in dst_replay and in the
      -- persistence specimen.
      files: [],
      clock_epoch: initial.clock_ms,
      extension_profile: "driver_only/${driver_only_version()}"
    },
    bounds: {
      max_interactions: 256,
      max_chunks_per_interaction: 16,
      max_payload_bytes: 4096,
      max_resource_size: 4096,
      max_clock_advance_ms: 60000,
      chunk_draw_hi: 3
    },
    manifest: discovered_manifest(),
    interactions: w.log,
    -- 034 W1.3: the world's effect-log FAULT entries, by recorded ordinal; empty
    -- unless the scenario scripts an applied fault.
    applied_faults: applied_faults_of_world(w)
  }
}

-- ---------------------------------------------------------------------------
-- One scenario, all axes
-- ---------------------------------------------------------------------------

func run_scenario(
  label: string,
  script: [ScriptedStep],
  answers: [string],
  tools: [ScriptedTool],
  step_budget: int,
  expect_ok: bool,
  -- Whether this scenario is the one carrying S7's obligation. Only one needs
  -- to be, and saying which makes the obligation locatable instead of assumed
  -- of all of them.
  is_survive_fixture: bool,
  -- WI-D3 added this as a per-scenario count because `resolve_context_limit` was
  -- reached once in `session_policy_init` AND again on every loop arm taken, so
  -- the number genuinely varied with control flow — 12 here, 19 and 8 in strict
  -- replay. WI-D4 removed the four per-arm resolutions (they re-derived a value
  -- `session_policy_init` had already stored), so the driver reaches it exactly
  -- ONCE per run and every scenario's answer is 1.
  --
  -- THE PARAMETER STAYS even though every caller now passes the same number, and
  -- that is deliberate rather than an oversight: what makes the answer 1 is a
  -- property of the driver's call graph, not of this suite, and the moment
  -- anything re-resolves per arm the quantity varies again. A parameter that is
  -- currently constant expresses "this may differ per scenario and today does
  -- not"; folding it into a shared literal would express "this cannot differ",
  -- which is the claim WI-D3 measured to be false.
  context_resolutions: int
) -> bool ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let initial = base_world(script, answers, tools);

  -- ---- Discovery: produce the exact program ------------------------------
  let discovery = run_recording("srdisc_${label}", initial, step_budget);
  let program = program_of(discovery.world, initial);

  let _ = println("");
  let _ = println("${label}: discovery recorded ${show(List.length(discovery.world.log))} interactions");
  let _ = println("CENSUS ${label} ${census_line(census(discovery.world.log))}");

  -- The run must have ended the way the scenario intends. For a success
  -- scenario this is stage 2's terminator guard; for a FAILURE scenario it is
  -- the inverse, and it is what stops a failure-path fixture from quietly
  -- becoming another success-path one.
  let ended_ok = match discovery.result { Ok(_) => true, Err(_) => false };
  let ok_end = check("${label}: the discovery run ended ${if expect_ok then "Ok" else "Err"} as the scenario intends",
                     ended_ok == expect_ok,
                     "expected ${if expect_ok then "Ok" else "Err"}; a scenario that silently changed its terminal outcome is testing a different thing from the one it documents");

  -- ---- Axis B: the manifest, and the metadata projected FROM it ----------
  let manifest_rejections = validate_manifest(program.manifest, driver_only());
  let ok_manifest = check("${label}: the program's manifest validates against driver_only/${driver_only_version()}",
                          List.length(manifest_rejections) == 0,
                          "${show(List.length(manifest_rejections))} manifest rejection(s) — strict replay runs UNDER the recorded manifest, so a program whose manifest does not describe the profile it names cannot be replayed strictly at all");
  let meta = replay_metadata_of(program.manifest);
  let ok_meta = check("${label}: replay metadata is projected from the manifest, not restated",
                      meta.profile_id == program.manifest.profile_id
                        && meta.profile_version == program.manifest.profile_version
                        && meta.source_revision == program.manifest.source_revision,
                      "replay_metadata_of disagrees with the manifest it was projected from");

  -- ---- Axis A + C: reconstitution ----------------------------------------
  match world_state_of(program, required_class_ids()) {
    Err(r) => {
      let _ = println("      ${refusal_message(r)}");
      check("${label}: the program reconstitutes a world", false,
            "refused with ${refusal_rule(r)}")
    },
    Ok(replay_world) => {
      let rec = reconstitution_balance(program, replay_world);
      let _ = if List.length(rec) > 0 then report_reconstitution(rec) else ();
      let ok_rec = check("${label}: the reconstituted world accounts for the program, in both directions",
                         List.length(rec) == 0,
                         "${show(List.length(rec))} finding(s) above");
      let _ = println("${label}: reconstituted script=${show(List.length(replay_world.script))} approvals=${show(List.length(replay_world.approvals))} tools=${show(List.length(replay_world.tools))} clock=${show(replay_world.clock_ms)}");

      -- ---- Axis D: the replay ---------------------------------------------
      let replay = run_recording("srplay_${label}", replay_world, step_budget);
      let actual = replay.world.log;
      let ms = strict_replay_findings(program.interactions, actual);
      let _ = if List.length(ms) > 0 then report_replay(ms) else ();
      let ok_replay = check("${label}: the exact program replays to an identical interaction log",
                            List.length(ms) == 0,
                            "${show(List.length(ms))} mismatch(es) above");

      -- The terminal outcome is part of D2's reproduction contract, and it is
      -- the one axis the interaction comparison cannot see: a replay that
      -- reproduced every request and then failed differently has not reproduced
      -- the run.
      let replay_ok_end = match replay.result { Ok(_) => true, Err(_) => false };
      let ok_terminal = check("${label}: the replay reproduces the terminal outcome",
                              replay_ok_end == ended_ok,
                              "discovery ended ${if ended_ok then "Ok" else "Err"} and the replay ended ${if replay_ok_end then "Ok" else "Err"}");

      -- ---- Axis G: the replayed run, graded by INDEPENDENT witnesses -------
      --
      -- Not the program comparison. This is the check that survives the
      -- recorder having the same gap on both sides, and it is why this stage is
      -- not a tautology.
      let probe = witness_of(replay_world, replay, []);
      let expected_env_base = if probe.tool_dispatches > 0
                         then env_reads_with_dispatch(probe.tool_dispatches, context_resolutions)
                         else env_reads_always(context_resolutions);
      let expected_env = expected_env_base ++ env_reads_exit_publish(expect_ok);
      let w = { probe | expected_env_reads: expected_env };
      let _ = println("${label}: replay witness provider=${show(w.provider_calls)} tool=${show(w.tool_dispatches)} approval_reads=${show(w.approval_reads)} approvals_served=${show(w.approvals_consumed)} clock_delta=${show(w.clock_delta_ms)}ms");
      let fs = check_discovery(actual, w);
      let _ = if List.length(fs) > 0 then report_discovery(fs) else ();
      let ok_witness = check("${label}: the REPLAYED run's log accounts for it, against witnesses the recorder did not write",
                             List.length(fs) == 0,
                             "${show(List.length(fs))} finding(s) above");

      -- THE VACUITY CONTROL, generalised so it covers the Err path. Stage 2
      -- asserted "the scenario reached its terminator", which makes the
      -- message-derived witnesses' emptiness loud only for succeeding runs.
      -- Every witness this grading consumes is asserted non-zero instead, which
      -- is the same guarantee on both paths and a stronger one on neither.
      let ok_nonvacuous = check("${label}: every witness the grading consumes is non-zero",
                                w.provider_calls > 0 && w.approval_reads > 0
                                  && w.approvals_consumed > 0 && w.clock_delta_ms > 0
                                  && w.tool_dispatches > 0,
                                "provider=${show(w.provider_calls)} tool=${show(w.tool_dispatches)} reads=${show(w.approval_reads)} served=${show(w.approvals_consumed)} clock=${show(w.clock_delta_ms)} — a zero witness grades its class vacuously, and a vacuous check passes");

      -- ---- Axis F: S7's two obligations, asserted rather than described ----
      let provider_kind = identity_kind(ProviderIdentity("", 0, ""));
      let tool_kind = identity_kind(ToolIdentity("", "", ""));
      let approval_kind = identity_kind(ApprovalIdentity("", "", ""));
      let env_kind = identity_kind(EnvironmentReadIdentity(""));
      let ok_shapes = not is_survive_fixture || check(
        "${label}: the surviving fixture carries every shape the specification protects",
        count_with_chunks(actual) > 0
          && count_kind(actual, provider_kind) > provider_steps_served(actual)
          && count_status_of_kind(actual, tool_kind, "ok") > 0
          && count_status_of_kind(actual, tool_kind, "fault") > 0
          && count_status_of_kind(actual, approval_kind, "ok") > 0
          && count_status_of_kind(actual, approval_kind, "missing") > 0
          && count_status_of_kind(actual, env_kind, "ok") > 0
          && count_status_of_kind(actual, env_kind, "missing") > 0
          && count_kind(actual, identity_kind(ClockAdvanceIdentity)) > 0,
        "chunks=${show(count_with_chunks(actual))} exhausted_providers=${show(count_kind(actual, provider_kind) - provider_steps_served(actual))} tool_ok=${show(count_status_of_kind(actual, tool_kind, "ok"))} tool_fault=${show(count_status_of_kind(actual, tool_kind, "fault"))} approval_ok=${show(count_status_of_kind(actual, approval_kind, "ok"))} approval_missing=${show(count_status_of_kind(actual, approval_kind, "missing"))} env_ok=${show(count_status_of_kind(actual, env_kind, "ok"))} env_missing=${show(count_status_of_kind(actual, env_kind, "missing"))} — a shape the fixture claims and does not reach is a claim, and the fixture's justification is exactly the kind of claim cluster 8 measured to be worth testing");
      let ok_distinct = not is_survive_fixture || check(
        "${label}: no two of the surviving fixture's quantities are equal",
        all_distinct([w.provider_calls, List.length(replay_world.script), w.approval_reads,
                      w.approvals_consumed, w.tool_dispatches]),
        "provider=${show(w.provider_calls)} script=${show(List.length(replay_world.script))} reads=${show(w.approval_reads)} served=${show(w.approvals_consumed)} dispatches=${show(w.tool_dispatches)} — a fixture whose quantities are all equal cannot distinguish which quantity a check is reading, which is how stage 2's sites 17 and 18 stayed hidden");

      -- Identity CONTENT: the provider step is the recorder's one DECIDED
      -- binding (it is derived from log position because the port never
      -- receives step_idx), so it is compared against the driver's own values
      -- in the REPLAY run and not only in discovery.
      let steps_w = provider_steps_witnessed(replay.trace.records);
      let steps_r = provider_steps_recorded(actual);
      let ok_steps = check("${label}: the replay's recorded provider steps equal the driver's own",
                           eq_ints(steps_w, steps_r),
                           "driver=[${join_ints(steps_w)}] recorded=[${join_ints(steps_r)}]");

      -- ---- Axis H: THE TAUTOLOGY CONTROL ----------------------------------
      --
      -- Give the PROGRAM and the LOG the same defect — drop one class from
      -- both, re-densify both — and the strict comparison agrees perfectly.
      -- That models exactly the failure this stage is most exposed to, because
      -- replay re-uses the recorder that produced the program: a recorder gap
      -- is present on both sides by construction.
      --
      -- The witness balance, which is derived from the ledger trace and the
      -- world's cursors, does NOT agree. This is the assertion that separates
      -- strict replay from a restatement of itself.
      -- The two sides are derived INDEPENDENTLY — one from the discovery run's
      -- log, one from the replay's — and each is given the same gap. They are
      -- two different objects that agree, which is the situation a shared
      -- recorder defect actually produces; comparing one list against itself
      -- would agree by construction and would demonstrate nothing.
      let gapped_program = renumber(drop_kind(program.interactions, identity_kind(ProviderIdentity("", 0, ""))), 0);
      let gapped_actual = renumber(drop_kind(actual, identity_kind(ProviderIdentity("", 0, ""))), 0);
      let ok_tautology_matches = check("${label}: a program and a log with the SAME defect match perfectly",
                                       strict_replay_ok(gapped_program, gapped_actual)
                                         && List.length(gapped_actual) < List.length(actual),
                                       "the shared-defect pair did not match, or the gap was not actually applied — either way the control cannot make its point");
      let ok_tautology_caught = check("${label}: …and the independent witnesses reject it anyway",
                                      not discovery_ok(gapped_actual, { w | clock_delta_ms: total_advance_ms(gapped_actual) }),
                                      "program-versus-log agreement was the ONLY thing checked, and a shared recorder gap passed it — this stage is a tautology");

      -- ---- Axis E: mutation ------------------------------------------------
      let _ = println("  mutations (each must go red):");
      let prov_at = first_index_of(actual, identity_kind(ProviderIdentity("", 0, "")), 0);
      let tool_at = first_index_of(actual, identity_kind(ToolIdentity("", "", "")), 0);
      let m_unused = mutant("the replay stops one interaction early", "replay-unused-interaction",
                            program.interactions, drop_last(actual));
      let m_exhausted = mutant("the replay makes one request more than the program holds",
                               "replay-program-exhausted",
                               drop_last(program.interactions), actual);
      -- The five single-position mutants are BOUND rather than inlined, because
      -- stage 5's regression axis grades the same real logs. Two gates reading
      -- one mutant is the arrangement in which the two modes cannot be given
      -- quietly different inputs and then compared.
      let wrong_kind_log = replace_at(actual, prov_at,
                             func(i: Interaction) -> Interaction {
                               { i | identity: { i.identity | body: ClockAdvanceIdentity }, deadline_ms: -1 } });
      let wrong_origin_log = replace_at(actual, prov_at,
                               func(i: Interaction) -> Interaction {
                                 match i.identity.body {
                                   ProviderIdentity(_, s, m) =>
                                     { i | identity: { i.identity | body: ProviderIdentity("other_producer", s, m) } },
                                   _ => i
                                 } });
      let wrong_identity_log = replace_at(actual, tool_at,
                                 func(i: Interaction) -> Interaction {
                                   match i.identity.body {
                                     ToolIdentity(o, _, n) =>
                                       { i | identity: { i.identity | body: ToolIdentity(o, "some_other_call", n) } },
                                     _ => i
                                   } });
      let drifted_projection_log = replace_at(actual, prov_at,
                                     func(i: Interaction) -> Interaction { { i | request_projection: "${i.request_projection} (drifted)" } });
      -- The outcome mutation is the one that matters most for `world_state_of`:
      -- the identity and the projection still match at every position, so only
      -- the outcome comparison can see it.
      let drifted_outcome_log = replace_at(actual, prov_at,
                                  func(i: Interaction) -> Interaction { { i | outcome: { i.outcome | payload: "" } } });

      let m_kind = mutant("one provider request arrives as a clock advance", "replay-wrong-kind",
                          program.interactions, wrong_kind_log);
      let m_origin = mutant("one provider request comes from a different producer", "replay-wrong-origin",
                            program.interactions, wrong_origin_log);
      let m_identity = mutant("one tool request carries a different call id", "replay-unsafe-identity-mismatch",
                              program.interactions, wrong_identity_log);
      let m_projection = mutant("one request projection differs", "replay-projection-differs",
                                program.interactions, drifted_projection_log);
      let m_outcome = mutant("the world served the right request and a different answer",
                             "replay-outcome-differs",
                             program.interactions, drifted_outcome_log);

      -- ---- Axis J: REGRESSION REPLAY (stage 5), on those same real logs -----
      --
      -- D2's second mode: "require compatible causal identity, record projection
      -- differences, and continue" — bound by "never weakens tool-call/result
      -- correlation or delivers an outcome to a different logical request".
      --
      -- Every row below is the SAME mutated log the strict row above just
      -- rejected. That is the whole point: the two modes must disagree on
      -- exactly two of these seven and agree on the other five, and running them
      -- over one set of inputs is what makes the disagreement legible instead of
      -- asserted. The demotion set itself is asserted in `dst_replay`, where a
      -- third demotion goes red on its own.
      let _ = println("  regression replay (D2's second mode), on the same real logs:");
      let r_clean = regression_replay_findings(program.interactions, actual);
      let ok_r_clean = check("${label}: an exact replay is regression-clean AND records nothing",
                             regression_replay_ok(program.interactions, actual)
                               && regression_difference_count(r_clean) == 0,
                             "${regression_report(r_clean)} — a mode that recorded a difference unconditionally would pass every row below, so this negative control is the load-bearing one");

      let r_proj = regression_replay_findings(program.interactions, drifted_projection_log);
      let _ = println("      ${regression_report(r_proj)}");
      let ok_r_proj = check("${label}: a differing request projection is RECORDED and the replay continues",
                            regression_replay_ok(program.interactions, drifted_projection_log)
                              && has_replay_rule(r_proj.differences, "replay-projection-differs")
                              && regression_difference_count(r_proj) == 1,
                            "${regression_report(r_proj)} — strict mode rejected this same log one row above, which is the difference the mode exists to make");

      let r_out = regression_replay_findings(program.interactions, drifted_outcome_log);
      let ok_r_out = check("${label}: a differing outcome is RECORDED and the replay continues",
                           regression_replay_ok(program.interactions, drifted_outcome_log)
                             && has_replay_rule(r_out.differences, "replay-outcome-differs")
                             && regression_difference_count(r_out) == 1,
                           "${regression_report(r_out)}");

      -- The five that stay fatal. `replay-unsafe-identity-mismatch` is the
      -- correlation guarantee itself; the two walk arms are the pair that fail
      -- SILENTLY without their rules, and `replay-unused-interaction` is the one
      -- most easily forgotten because a regression replay that stops early
      -- otherwise reports a clean, short and entirely fictitious "no
      -- differences".
      let r_ident = regression_replay_findings(program.interactions, wrong_identity_log);
      let r_kind = regression_replay_findings(program.interactions, wrong_kind_log);
      let r_origin = regression_replay_findings(program.interactions, wrong_origin_log);
      let r_short = regression_replay_findings(program.interactions, drop_last(actual));
      let r_long = regression_replay_findings(drop_last(program.interactions), actual);
      let ok_r_fatal = check("${label}: causal identity and both walk arms stay FATAL in regression mode",
                             not regression_replay_ok(program.interactions, wrong_identity_log)
                               && has_replay_rule(r_ident.fatal, "replay-unsafe-identity-mismatch")
                               && not regression_replay_ok(program.interactions, wrong_kind_log)
                               && has_replay_rule(r_kind.fatal, "replay-wrong-kind")
                               && not regression_replay_ok(program.interactions, wrong_origin_log)
                               && has_replay_rule(r_origin.fatal, "replay-wrong-origin")
                               && not regression_replay_ok(program.interactions, drop_last(actual))
                               && has_replay_rule(r_short.fatal, "replay-unused-interaction")
                               && not regression_replay_ok(drop_last(program.interactions), actual)
                               && has_replay_rule(r_long.fatal, "replay-program-exhausted"),
                             "identity=${show(List.length(r_ident.fatal))} kind=${show(List.length(r_kind.fatal))} origin=${show(List.length(r_origin.fatal))} short=${show(List.length(r_short.fatal))} long=${show(List.length(r_long.fatal))} — a zero here is a regression mode that has given up the one thing D2 says it may never give up, and it type-checks");

      -- ...and none of the five was quietly filed as a recorded difference,
      -- which is the shape a demotion actually takes: the fatal list empties
      -- while the report grows longer and looks more useful.
      let ok_r_not_demoted = check("${label}: no fatal rule was quietly recorded as a difference instead",
                                   regression_difference_count(r_ident) == 0
                                     && regression_difference_count(r_kind) == 0
                                     && regression_difference_count(r_origin) == 0
                                     && regression_difference_count(r_short) == 0
                                     && regression_difference_count(r_long) == 0,
                                   "identity=${show(regression_difference_count(r_ident))} kind=${show(regression_difference_count(r_kind))} origin=${show(regression_difference_count(r_origin))} short=${show(regression_difference_count(r_short))} long=${show(regression_difference_count(r_long))}");

      -- ---- Axis A: refusals, on real programs ------------------------------
      let bad_schema = { program | schema_version: "execution-program/0" };
      let ok_refuse_schema = match world_state_of(bad_schema, required_class_ids()) {
        Ok(_) => check("${label}: an undecodable schema version refuses replay", false,
                       "the program was replayed anyway; D8 forbids silently reinterpreting an old program"),
        Err(r) => check("${label}: an undecodable schema version refuses replay",
                        refusal_rule(r) == "replay-refused-invalid-program", refusal_rule(r))
      };
      let stage2_payload = { program |
        interactions: blank_first_payload(program.interactions, identity_kind(ProviderIdentity("", 0, ""))) };
      let ok_refuse_payload = match world_state_of(stage2_payload, required_class_ids()) {
        Ok(_) => check("${label}: a provider outcome that cannot be read back refuses replay", false,
                       "the program reconstituted a world anyway, which would replay a step with no tool calls and terminate early while agreeing with the program at every position it reached"),
        Err(r) => check("${label}: a provider outcome that cannot be read back refuses replay",
                        refusal_rule(r) == "replay-refused-provider-outcome-undecodable", refusal_rule(r))
      };

      -- A mismatch must surface as a TYPED HarnessFailure carrying the position
      -- and the projection — D2: "not a simulated system fault".
      let ok_typed = match first_replay_failure(
                            strict_replay_findings(program.interactions, drop_last(actual)),
                            replay.trace, meta) {
        None => check("${label}: a mismatch returns a typed HarnessFailure", false,
                      "the mismatch produced no typed result"),
        Some(RunCompleted(_)) => check("${label}: a mismatch returns a typed HarnessFailure", false,
                                       "the mismatch produced a completed run"),
        Some(RunFailed(f)) =>
          check("${label}: a mismatch returns a typed HarnessFailure with position and projection",
                harness_failure_kind_name(f.kind) == "program_mismatch"
                  && f.interaction_position >= 0
                  && f.replay_metadata.profile_id == program.manifest.profile_id
                  && contains(f.actual_request_projection, "replay-unused-interaction"),
                "kind=${harness_failure_kind_name(f.kind)} position=${show(f.interaction_position)} profile=${f.replay_metadata.profile_id}")
      };

      -- ---- Axis I: determinism, last and least -----------------------------
      let again = run_recording("srplay_${label}", replay_world, step_budget);
      let ok_det = check("${label}: two replays of one program produce the same log",
                         eq_list(projections(actual), projections(again.world.log)),
                         "two replays of one reconstituted world disagree");

      -- ---- The program the REPLAY produced is itself a valid program --------
      let replayed_program = program_of(replay.world, replay_world);
      let ok_valid = check("${label}: the replayed log is itself a structurally valid program",
                           List.length(validate_program(replayed_program, required_class_ids())) == 0
                             && List.length(validate_bounds(replayed_program)) == 0,
                           "the replay produced a log the decoder rejects, so replaying the replay is impossible");

      ok_end && ok_manifest && ok_meta && ok_rec && ok_replay && ok_terminal
        && ok_witness && ok_nonvacuous && ok_shapes && ok_distinct && ok_steps
        && ok_tautology_matches && ok_tautology_caught
        && m_unused && m_exhausted && m_kind && m_origin && m_identity && m_projection && m_outcome
        && ok_r_clean && ok_r_proj && ok_r_out && ok_r_fatal && ok_r_not_demoted
        && ok_refuse_schema && ok_refuse_payload && ok_typed && ok_det && ok_valid
    }
  }
}

-- ---------------------------------------------------------------------------
-- The wire witness, on its own entry point
-- ---------------------------------------------------------------------------
--
-- `V2ToolDispatchStart` is emitted BEFORE the port calls and never appended to
-- the returned trace, so it is the one tool witness that exists whether or not
-- the port was reached — and the only one no AILANG assertion in this file can
-- read. `make strict_replay` runs THIS entry, which performs exactly one
-- DISCOVERY run and one REPLAY of it, and compares the wire's own counts across
-- the pair against the census each printed.
--
-- One run each, so the comparison is exact equality with no multiplier to keep
-- in sync when a scenario is added.
export func wire_witness() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let initial = base_world(rich_script(), rich_answers(), rich_tools());
  let discovery = run_recording("srwire_disc", initial, 12);
  let program = program_of(discovery.world, initial);
  let _ = println("CENSUS discovery ${census_line(census(discovery.world.log))}");
  match world_state_of(program, required_class_ids()) {
    Err(r) => println("REFUSED ${refusal_rule(r)}"),
    Ok(w) => {
      let replay = run_recording("srwire_play", w, 12);
      println("CENSUS replay ${census_line(census(replay.world.log))}")
    }
  }
}

-- ---------------------------------------------------------------------------
-- The scenarios
-- ---------------------------------------------------------------------------

-- THE FIXTURE THAT MUST SURVIVE (S7), and every quantity in it is different.
--
-- Shapes D2 explicitly protects, all present in one program:
--
--   provider served, WITH ordered stream chunks       step "s0"
--   provider script EXHAUSTED                         the 5th provider call
--   tool outcome OK                                   the first approved dispatch
--   tool outcome FAULT (D3's tool_failed class)       the second, code E_BOOM
--   approval served OK — allowed and DENIED           answers 1-3
--   approval MISSING (queue drained)                  reads 4, 5 and 6
--   environment read OK                               MOTOKO_TOOL_TIMEOUT_MS, MOTOKO_HEADLESS
--   environment read MISSING                          the driver's other five keys
--   clock advance                                     every routed clock site
--   a repeated tool NAME at different ordinals        every call is "T"
--
-- Not present, and stated rather than implied: `ToolCorrelationMismatch` and
-- `ToolDeadlineExceeded`. Both travel through the same codec as `ToolFailed`
-- and are covered by `ports.ail`'s round-trip rows; reaching them here would
-- need a third and fourth approved dispatch, which is what the counts below
-- would have to give up.
--
-- And the counts, which are the half S7 sharpened after stage 2's sites 17 and
-- 18 hid behind a fixture whose quantities were all equal:
--
--   provider calls        5   (4 script entries served + 1 exhausted)
--   script entries        4
--   approval reads        6   (3 tool calls in s0, 1 in each of s1, s2, s3)
--   approvals consumed    3   (the queue holds three answers and then drains)
--   tool dispatches       2   (answers 1 and 3 approve; answer 2 denies)
--
-- 5, 4, 6, 3, 2 — pairwise distinct, so a check reading the wrong quantity
-- cannot come out right by coincidence. That property is asserted, not
-- described: `rich_quantities_are_pairwise_distinct` below fails if a future
-- edit collapses any two of them.
func rich_script() -> [ScriptedStep] {
  [multi_step("s0", [tc("s0a"), tc("s0b"), tc("s0c")], ["chunk-one", "chunk-two"]),
   multi_step("s1", [tc("s1a")], []),
   multi_step("s2", [tc("s2a")], []),
   multi_step("s3", [tc("s3a")], [])]
}

-- Approve, DENY, approve. The denial in the middle is what makes
-- `approvals_consumed` (3) differ from `tool_dispatches` (2): stage 2 measured
-- that a scenario in which every answer approves cannot tell those two witness
-- fields apart, and that is where its site 18 hid.
func rich_answers() -> [string] { [approve_line(), deny_line("bravo"), approve_line()] }

-- Three entries against TWO dispatches. The surplus is deliberate: an exhausted
-- queue makes `world_tool` fall back to the REAL dispatcher, which would
-- execute a process for a tool named "T" that does not exist, so the discovery
-- world is kept over-supplied. The replay world is reconstituted from the two
-- recorded tool interactions and is exactly supplied, which is correct — a
-- reconstituted world holds what the program records and nothing else.
func rich_tools() -> [ScriptedTool] {
  -- WI-D22's `exit_code`. All three are -1 ("nothing said"): these are scripted
  -- answers for a tool named "T", not process runs.
  [{ tool_call_id: "", duration_ms: 7,  code: "",       message: "",     content: "OK-ALPHA",   exit_code: -1, after_dispatch: true, applied: false },
   { tool_call_id: "", duration_ms: 11, code: "E_BOOM", message: "boom", content: "",           exit_code: -1, after_dispatch: true, applied: false },
   { tool_call_id: "", duration_ms: 13, code: "",       message: "",     content: "OK-CHARLIE", exit_code: -1, after_dispatch: true, applied: false }]
}

-- THE FAILURE-PATH SCENARIO. A step budget of 1 against a script of three
-- continuers, so the driver runs one step and then terminates with `Fail`,
-- returning `Err` — and the returned message list is empty, which makes every
-- message-derived witness vacuous. This is the scenario stage 2's guard could
-- not cover and the reason `witness_of` reads only the trace and the world.
--
--   provider calls        1
--   script entries        3   (one consumed)
--   approval reads        3   (s0's three tool calls)
--   approvals consumed    2
--   tool dispatches       1
--
-- 1, 3, 3, 2, 1 — reads equals the script length and dispatches equals the
-- provider count here, which is stated rather than hidden: the fixture that
-- carries S7's pairwise-distinct obligation is `rich`, and this one exists to
-- exercise the Err path.
func failure_answers() -> [string] { [approve_line(), deny_line("bravo")] }

-- ---------------------------------------------------------------------------
-- 034 W1.3 ACCEPTANCE (a) AND (b): THE WORLD-TRUTH LIST, RECORDED AND REPLAYED
-- ---------------------------------------------------------------------------
--
-- One step with three tool calls, all approved, against three scripted answers:
--
--   wt0a  completes                                  -> an effect-log entry
--   wt0b  fails AFTER dispatch, `applied` set        -> an effect-log entry, listed
--   wt0c  fails AFTER dispatch, `applied` not set    -> no entry, not listed
--
-- The non-applied fault is after dispatch on purpose: it is the one a mutant
-- that appends on every fault (034 W1.7 v07) or keys on the stage would log, so
-- only `applied` separates it from wt0b. A fourth entry is surplus, for
-- `rich_tools`' reason: an exhausted queue delegates to the real dispatcher.
--
-- The run goes through the REAL driver, so every world adoption the run makes
-- (the pre-step chain, the response intercept, the tool-handle hook: all three
-- are installed by `approval_rt`) is on the path. Each of them round-trips the
-- world through the extension token, which carries neither `applied` nor the
-- effect log; a site that adopted without re-seating (v20, v21) loses wt0b's
-- flag before it is dispatched, or the log before the run ends, and the recorded
-- list or the recorded log below comes out wrong.
func world_truth_script() -> [ScriptedStep] {
  [multi_step("wt", [tc("wt0a"), tc("wt0b"), tc("wt0c")], [])]
}

func world_truth_answers() -> [string] { [approve_line(), approve_line(), approve_line()] }

func world_truth_tools() -> [ScriptedTool] {
  [{ tool_call_id: "", duration_ms: 17, code: "",          message: "",               content: "WT-OK", exit_code: 0,  after_dispatch: true, applied: false },
   { tool_call_id: "", duration_ms: 19, code: "E_APPLIED", message: "effect applied", content: "",      exit_code: -1, after_dispatch: true, applied: true },
   { tool_call_id: "", duration_ms: 23, code: "E_NOT",     message: "effect not",     content: "",      exit_code: -1, after_dispatch: true, applied: false },
   { tool_call_id: "", duration_ms: 29, code: "",          message: "",               content: "WT-SPARE", exit_code: 0, after_dispatch: true, applied: false }]
}

pure func tool_ordinals(xs: [Interaction]) -> [int] {
  match xs {
    [] => [],
    i :: rest => match i.identity.body {
      ToolIdentity(_, _, _) => i.identity.ordinal :: tool_ordinals(rest),
      _ => tool_ordinals(rest)
    }
  }
}

pure func nth_int(xs: [int], n: int) -> int {
  match xs { [] => -1, x :: rest => if n == 0 then x else nth_int(rest, n - 1) }
}

pure func applied_flags(xs: [ScriptedTool]) -> [bool] {
  match xs { [] => [], t :: rest => t.applied :: applied_flags(rest) }
}

pure func eq_bools(a: [bool], b: [bool]) -> bool {
  match a {
    [] => (match b { [] => true, _ => false }),
    x :: xr => match b { [] => false, y :: yr => x == y && eq_bools(xr, yr) }
  }
}

pure func show_bools(xs: [bool]) -> string {
  match xs { [] => "", x :: [] => show(x), x :: rest => "${show(x)},${show_bools(rest)}" }
}

pure func eq_effect_logs(a: [{ ordinal: int, call_id: string, effect_key: string }],
                         b: [{ ordinal: int, call_id: string, effect_key: string }]) -> bool {
  match a {
    [] => (match b { [] => true, _ => false }),
    x :: xr => match b {
      [] => false,
      y :: yr => x.ordinal == y.ordinal && x.call_id == y.call_id && x.effect_key == y.effect_key
                   && eq_effect_logs(xr, yr)
    }
  }
}

pure func effect_log_line(xs: [{ ordinal: int, call_id: string, effect_key: string }]) -> string {
  match xs {
    [] => "",
    e :: rest => "#${show(e.ordinal)} ${e.call_id} ${e.effect_key}; ${effect_log_line(rest)}"
  }
}

func persist_round_trip(p: ExecutionProgram) -> Result[ExecutionProgram, string] {
  match encode_artifact(p) {
    EncodeRefused(_) => Err("the artifact encoder refused the program (secret scan)"),
    Encoded(bytes) => match decode_artifact(bytes) {
      ProgramDecodeRefused(rs) => Err("the artifact did not decode: ${first_decode_message(rs)}"),
      ProgramDecoded(back) => Ok(back)
    }
  }
}

func world_truth_scenario() -> bool ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let _ = println("");
  let _ = println("world_truth (034 W1.3): the effect log, recorded, persisted and replayed");
  let initial = base_world(world_truth_script(), world_truth_answers(), world_truth_tools());
  let discovery = run_recording("srwt_disc", initial, 12);
  let program = program_of(discovery.world, initial);
  let tools = tool_ordinals(discovery.world.log);
  let t0 = nth_int(tools, 0); let t1 = nth_int(tools, 1); let t2 = nth_int(tools, 2);
  let _ = println("world_truth: discovery recorded ${show(List.length(discovery.world.log))} interactions; tool ordinals [${join_ints(tools)}]; effect log ${effect_log_line(discovery.world.effect_log)}");

  -- RECORDING. Three tool interactions, the effect log holds the completed call
  -- and the applied fault (v22 drops the first, v07 adds the third), and the
  -- builder lists the applied fault alone.
  let ok_shape = check("world_truth: the discovery run dispatched the three scripted tools",
                       List.length(tools) == 3,
                       "tool ordinals [${join_ints(tools)}]");
  let ok_log = check("world_truth: the effect log holds the completed call and the applied fault, at their interaction ordinals",
                     eq_ints(effect_log_ordinals(discovery.world.effect_log), [t0, t1]),
                     "effect log [${join_ints(effect_log_ordinals(discovery.world.effect_log))}], expected [${show(t0)},${show(t1)}] — the non-applied fault #${show(t2)} must be absent and the completed call #${show(t0)} present");
  let ok_keys = check("world_truth: each entry carries its call id and the tool-and-arguments key",
                      eq_effect_logs(discovery.world.effect_log,
                                     [{ ordinal: t0, call_id: "wt0a", effect_key: "T:{}" },
                                      { ordinal: t1, call_id: "wt0b", effect_key: "T:{}" }]),
                      effect_log_line(discovery.world.effect_log));
  let ok_listed = check("world_truth: the builder lists exactly the applied fault",
                        eq_ints(program.applied_faults, [t1]),
                        "applied_faults [${join_ints(program.applied_faults)}], expected [${show(t1)}]");

  match persist_round_trip(program) {
    Err(why) => check("world_truth: the program round-trips through the artifact codec", false, why),
    Ok(back) => {
      let ok_persisted = check("world_truth: the program round-trips through the artifact codec with its list",
                               eq_ints(back.applied_faults, program.applied_faults)
                                 && List.length(back.interactions) == List.length(program.interactions),
                               "applied_faults [${join_ints(back.applied_faults)}]");
      match world_state_of(back, required_class_ids()) {
        Err(r) => check("world_truth: the decoded program reconstitutes a world", false, refusal_rule(r)),
        Ok(rw) => {
          -- REPLAY. The queue says which fault applied (v05 says none did).
          let ok_flags = check("world_truth: the reconstituted queue has `applied` on the listed fault only",
                               eq_bools(applied_flags(rw.tools), [false, true, false]),
                               "[${show_bools(applied_flags(rw.tools))}]");
          let replay = run_recording("srwt_play", rw, 12);
          let ms = strict_replay_findings(back.interactions, replay.world.log);
          let _ = if List.length(ms) > 0 then report_replay(ms) else ();
          let ok_replay = check("world_truth: the decoded program replays to an identical interaction log",
                                List.length(ms) == 0, "${show(List.length(ms))} mismatch(es) above");
          let ok_rebuilt = check("world_truth: replay rebuilds the effect log — the completed calls and the listed faults, at the listed ordinals",
                                 eq_ints(effect_log_ordinals(replay.world.effect_log), effect_ordinals_of(back))
                                   && eq_effect_logs(replay.world.effect_log, discovery.world.effect_log)
                                   && eq_ints(applied_faults_of_world(replay.world), back.applied_faults),
                                 "replayed ${effect_log_line(replay.world.effect_log)} expected [${join_ints(effect_ordinals_of(back))}]");

          -- (b) THE TWIN: the same program with the list emptied. It must serve
          -- the same interactions, payload and advance alike — property P2's
          -- precondition, and what 034 W1.7's v06 (`applied` in the payload)
          -- breaks — while its effect log loses the fault, so the list is read.
          let twin = { back | applied_faults: [] };
          match world_state_of(twin, required_class_ids()) {
            Err(r) => check("world_truth (b): the twin reconstitutes a world", false, refusal_rule(r)),
            Ok(tw) => {
              let twin_run = run_recording("srwt_play", tw, 12);
              let between = strict_replay_findings(replay.world.log, twin_run.world.log);
              let _ = if List.length(between) > 0 then report_replay(between) else ();
              let ok_twin = check("world_truth (b): two programs differing only in the list serve identical interactions, payload and advance alike",
                                  List.length(between) == 0
                                    && List.length(strict_replay_findings(twin.interactions, twin_run.world.log)) == 0
                                    && eq_list(served_outcomes(replay.world.log), served_outcomes(twin_run.world.log)),
                                  "${show(List.length(between))} difference(s) above");
              let ok_twin_truth = check("world_truth (b): …and differ in world truth alone — the twin's effect log has no fault entry",
                                        eq_ints(effect_log_ordinals(twin_run.world.effect_log), [t0])
                                          && eq_ints(applied_faults_of_world(twin_run.world), []),
                                        "twin effect log ${effect_log_line(twin_run.world.effect_log)}");
              ok_shape && ok_log && ok_keys && ok_listed && ok_persisted && ok_flags
                && ok_replay && ok_rebuilt && ok_twin && ok_twin_truth
            }
          }
        }
      }
    }
  }
}

-- The served outcome of every interaction, rendered by `outcome_projection`,
-- which reads every field: payload, status, advance, chunks. Compared as
-- strings, position by position, beside the strict walk above.
pure func served_outcomes(xs: [Interaction]) -> [string] {
  match xs { [] => [], i :: rest => outcome_projection(i) :: served_outcomes(rest) }
}

-- ---------------------------------------------------------------------------
-- 034 W1.3 ACCEPTANCE (a) ON THE FROZEN FIXTURE
-- ---------------------------------------------------------------------------
--
-- `scripts/dst/fixtures/execution-program-v5.artifact` holds a completed tool
-- call (#1), an applied fault (#12, listed) and a non-applied fault (#13,
-- unlisted). Its provider, tool-#1 and extension-effect payloads are SPECIMEN
-- PLACEHOLDERS (`payload.provider.zero`, `payload.tool.one`, …): they freeze the
-- line codec, not a run, so the program as frozen reconstitutes no world. The
-- row therefore makes the specimen REPLAYABLE by replacing exactly those
-- placeholders with codec-written payloads that carry the same text — the
-- ordinals, statuses, advances, deadlines and the world-truth list are the
-- frozen bytes' own — and then:
--
--   1. round-trips it through the artifact codec (persistence and decode);
--   2. reconstitutes the world, whose tool queue must carry `applied` on #12
--      alone (034 W1.7 v05);
--   3. replays the TOOL SEAM: every tool interaction, in order, through
--      `recording_tool` on the reconstituted queue, with every other
--      interaction appended as recorded so each call gets its program ordinal.
--      The driver is not run, because the fixture's script is a placeholder;
--      the end-to-end replay is `world_truth_scenario` above.
--
-- The replayed effect log must be #1 and #12 — the completed call present
-- (v22), the non-applied fault absent (v07) — and the served tool outcomes must
-- equal the recorded ones.
pure func v5_fixture_path() -> string { "scripts/dst/fixtures/execution-program-v5.artifact" }

pure func placeholder_step(text: string) -> ScriptedStep {
  { prose: text, tool_calls: [], input_tokens: 1, output_tokens: 2, finish_reason: "stop",
    chunks: [], error_code: "", error_message: "", advance_ms: 0 }
}

pure func replayable_at(i: Interaction) -> Interaction {
  match i.identity.body {
    ProviderIdentity(_, _, _) =>
      { i | outcome: { i.outcome | payload: encode_provider_outcome(placeholder_step(i.outcome.payload)) } },
    ToolIdentity(_, call_id, _) =>
      match i.outcome.status {
        -- Only the completed call is a placeholder; #12 and #13 were codec-written.
        OutcomeOk => { i | outcome: { i.outcome | payload: encode_tool_outcome(ToolCompleted({ tool_call_id: call_id, content: i.outcome.payload, exit_code: 0 })) } },
        _ => i
      },
    ExtensionEffectIdentity(_, _, _) =>
      { i | outcome: { i.outcome | payload: encode_tool_outcome(ToolFailed({ tool_call_id: "", code: "E_EXT", message: i.outcome.payload, after_dispatch: true })) } },
    _ => i
  }
}

pure func replayable(xs: [Interaction]) -> [Interaction] {
  match xs { [] => [], i :: rest => replayable_at(i) :: replayable(rest) }
}

-- The tool seam of a replay. `w.log` is the prefix recorded so far, so the
-- ordinal `world_tool` records an effect under is the interaction's own.
func replay_tool_seam(xs: [Interaction], w: WorldState) -> WorldState ! {IO, Process, FS} {
  match xs {
    [] => w,
    i :: rest =>
      match i.identity.body {
        ToolIdentity(_, call_id, tool) => {
          let inv: ToolInvocation = { call: { id: call_id, tool: tool, arguments: jo([]) },
                                      workdir: "", timeout_ms: i.deadline_ms, started_at_ms: 0 };
          replay_tool_seam(rest, recording_tool(w, inv).next_state)
        },
        _ => replay_tool_seam(rest, { w | log: w.log ++ [i] })
      }
  }
}

pure func tool_outcomes(xs: [Interaction]) -> [string] {
  match xs {
    [] => [],
    i :: rest => match i.identity.body {
      ToolIdentity(_, _, _) => outcome_projection(i) :: tool_outcomes(rest),
      _ => tool_outcomes(rest)
    }
  }
}

func v5_fixture_scenario() -> bool ! {FS, IO, Process} {
  let _ = println("");
  let _ = println("v5_fixture (034 W1.3): the frozen world-truth pair, persisted, reconstituted and replayed");
  match FS.readFileResult(v5_fixture_path()) {
    Err(e) => check("v5_fixture: the frozen v5 specimen is read", false, e),
    Ok(bytes) => match decode_artifact(bytes) {
      ProgramDecodeRefused(rs) => check("v5_fixture: the frozen v5 specimen decodes", false, first_decode_message(rs)),
      ProgramDecoded(frozen) => {
        let ok_frozen = check("v5_fixture: the frozen bytes list #12 and not #13",
                              eq_ints(frozen.applied_faults, [12]),
                              "applied_faults [${join_ints(frozen.applied_faults)}]");
        match persist_round_trip({ frozen | interactions: replayable(frozen.interactions) }) {
          Err(why) => check("v5_fixture: the replayable specimen round-trips through the artifact codec", false, why),
          Ok(back) => match world_state_of(back, [fault_class_tool_failed()]) {
            Err(r) => {
              let _ = println("      ${refusal_message(r)}");
              check("v5_fixture: the replayable specimen reconstitutes a world", false, refusal_rule(r))
            },
            Ok(rw) => {
              let ok_persisted = check("v5_fixture: the replayable specimen round-trips with its list",
                                       eq_ints(back.applied_faults, [12]),
                                       "applied_faults [${join_ints(back.applied_faults)}]");
              let ok_flags = check("v5_fixture: the reconstituted tool queue (#1, #12, #13) has `applied` on #12 alone",
                                   eq_bools(applied_flags(rw.tools), [false, true, false]),
                                   "[${show_bools(applied_flags(rw.tools))}]");
              let replayed = replay_tool_seam(back.interactions, { rw | log: [] });
              let ok_served = check("v5_fixture: the replayed tool seam serves the recorded outcomes",
                                    eq_list(tool_outcomes(replayed.log), tool_outcomes(back.interactions)),
                                    "replayed [${join_strs(tool_outcomes(replayed.log))}] recorded [${join_strs(tool_outcomes(back.interactions))}]");
              let ok_effects = check("v5_fixture: replay reproduces the effect log — #1 completed and #12 listed, #13 absent",
                                     eq_ints(effect_log_ordinals(replayed.effect_log), [1, 12])
                                       && eq_ints(effect_ordinals_of(back), [1, 12])
                                       && eq_ints(applied_faults_of_world(replayed), back.applied_faults),
                                     "effect log ${effect_log_line(replayed.effect_log)}");
              ok_frozen && ok_persisted && ok_flags && ok_served && ok_effects
            }
          }
        }
      }
    }
  }
}

pure func join_strs(xs: [string]) -> string {
  match xs { [] => "", x :: [] => x, x :: rest => "${x} | ${join_strs(rest)}" }
}

export func main() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let _ = println("strict_replay_dst: WI-A13 stage 3 — strict replay against driver_only");

  let ok_rich = run_scenario("rich", rich_script(), rich_answers(), rich_tools(), 12, true, true, 1);
  let ok_fail = run_scenario("maxsteps", rich_script(), failure_answers(), rich_tools(), 1, false, false, 1);
  let ok_world_truth = world_truth_scenario();
  let ok_v5_fixture = v5_fixture_scenario();

  let _ = println("");
  if ok_rich && ok_fail && ok_world_truth && ok_v5_fixture then
    println("strict_replay_dst PASS")
  else {
    let _ = println("strict_replay_dst FAIL");
    exit(1)
  }
}
