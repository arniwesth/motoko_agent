-- scripts/dst/profile_coverage_dst.ail
--
-- WI-A6 acceptance, under ADR-001 D5. Fixture PROFILES of every rejecting
-- shape, plus the two shapes that must pass.
--
-- The inline tests in src/core/dst_profile_coverage.ail check the rules one at
-- a time. This script checks them the way a profile load will actually meet
-- them: as whole install lists, asserting that the rejection NAMES ITS RULE and
-- that a rejecting profile does not accidentally pass by a different route.
--
-- The set-completeness fixture is `partial_disclosure` below. It is the one
-- that separates this validator from a row-shape validator: its two lists are
-- disjoint, every id in them is a real ABI slot, and each is individually
-- well-formed — and it still omits `on_solver_candidate` entirely. A validator
-- that checked shape and disjointness would accept it, and the profile would
-- then claim a coverage classification for a slot it never classified.

module scripts/dst/profile_coverage_dst

import std/io (println, exit)
import std/list as List (length)
import std/result (Result, Ok, Err)
import src/core/dst_profile_coverage (
  CoverageRejection,
  rejection_rule,
  rejection_message,
  coverage_rules_version,
  CapabilityKind,
  DescribeToolsKind, PromptShaperKind, CompactorKind, ToolPolicyKind, ToolProviderKind, SolverJudgeKind,
  AtomRef,
  AtomIds,
  CapabilityDisclosure,
  all_capability_kinds,
  atoms_at_zero,
  atom_id,
  validate_capability_install_list,
  capability_install_list_ok,
  capability_disclosure_from_ids,
  capability_disclosure_ids
)

-- B8: the slot half of the coverage unit is gone; every scenario below is an
-- ATOM scenario. `eight()` is the one-atom-per-kind registration every
-- extension in the tree has at B8; `chain_atoms()` is the legal N>1 shape.

pure func same_ids(a: [string], b: [string]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs => match b {
      [] => false,
      y :: ys => if x == y then same_ids(xs, ys) else false
    }
  }
}

pure func has_rule(rs: [CoverageRejection], rule: string) -> bool {
  match rs {
    [] => false,
    r :: rest => if rejection_rule(r) == rule then true else has_rule(rest, rule)
  }
}

func report_rejections(rs: [CoverageRejection]) -> () ! {IO} {
  match rs {
    [] => (),
    r :: rest => {
      let _ = println("      ${rejection_message(r)}");
      report_rejections(rest)
    }
  }
}

func assert_rejected(label: string, rule: string, install: [CapabilityDisclosure]) -> bool ! {IO} {
  let rs = validate_capability_install_list(install);
  let rejected = List.length(rs) > 0;
  let named = has_rule(rs, rule);
  let ok = rejected && named;
  let _ = if ok then println("  ✓ ${label}: rejected by [${rule}]")
          else {
            let _ = println("  ✗ ${label}: expected rejection by [${rule}], got ${show(List.length(rs))} rejection(s)");
            report_rejections(rs)
          };
  ok
}

func assert_accepted(label: string, install: [CapabilityDisclosure]) -> bool ! {IO} {
  let rs = validate_capability_install_list(install);
  let ok = List.length(rs) == 0;
  let _ = if ok then println("  ✓ ${label}: accepted")
          else {
            let _ = println("  ✗ ${label}: expected acceptance, got ${show(List.length(rs))} rejection(s)");
            report_rejections(rs)
          };
  ok
}

pure func eight() -> [AtomRef] { atoms_at_zero(all_capability_kinds()) }

pure func without(xs: [AtomRef], k: CapabilityKind) -> [AtomRef] {
  match xs {
    [] => [],
    x :: rest => if atom_id(x) == atom_id({ kind: k, index: 0 }) then without(rest, k) else x :: without(rest, k)
  }
}

pure func at0(k: CapabilityKind) -> AtomRef { { kind: k, index: 0 } }

pure func driver_only_install() -> [CapabilityDisclosure] { [] }

pure func fully_covered() -> [CapabilityDisclosure] {
  [{ extension_id: "hello", atoms: eight(), covered: eight(), excluded: [] }]
}

pure func gated_exclusion_only() -> [CapabilityDisclosure] {
  [{ extension_id: "compose", atoms: eight(),
     covered: without(eight(), ToolProviderKind), excluded: [at0(ToolProviderKind)] }]
}

pure func all_excluded() -> [CapabilityDisclosure] {
  [{ extension_id: "inert", atoms: eight(), covered: [], excluded: eight() }]
}

pure func unconditional_excluded() -> [CapabilityDisclosure] {
  [{ extension_id: "no_prompt", atoms: eight(),
     covered: without(eight(), PromptShaperKind), excluded: [at0(PromptShaperKind)] }]
}

pure func describe_tools_excluded() -> [CapabilityDisclosure] {
  [{ extension_id: "silent_catalog", atoms: eight(),
     covered: without(eight(), DescribeToolsKind), excluded: [at0(DescribeToolsKind)] }]
}

-- Eight entries, seven atoms: `solver_judge[0]` classified nowhere and
-- `describe_tools[0]` twice. Only counting per ATOM rejects it.
pure func partial_disclosure() -> [CapabilityDisclosure] {
  [{ extension_id: "partial", atoms: eight(),
     covered: at0(DescribeToolsKind) :: without(without(eight(), ToolProviderKind), SolverJudgeKind),
     excluded: [at0(ToolProviderKind)] }]
}

pure func overlapping() -> [CapabilityDisclosure] {
  [{ extension_id: "overlap", atoms: eight(), covered: eight(), excluded: [at0(ToolPolicyKind)] }]
}

pure func duplicated_extension() -> [CapabilityDisclosure] {
  [{ extension_id: "twice", atoms: eight(), covered: eight(), excluded: [] },
   { extension_id: "twice", atoms: eight(), covered: eight(), excluded: [] }]
}

pure func two_defects() -> [CapabilityDisclosure] {
  [{ extension_id: "inert", atoms: eight(), covered: [], excluded: eight() },
   { extension_id: "overlap", atoms: eight(), covered: eight(), excluded: [at0(ToolPolicyKind)] }]
}

pure func ids(kinds: [string]) -> [AtomIds] {
  match kinds { [] => [], k :: rest => ({ kind: k, index: 0 }) :: ids(rest) }
}

pure func id_strs(xs: [AtomIds]) -> [string] {
  match xs { [] => [], x :: rest => "${x.kind}[${show(x.index)}]" :: id_strs(rest) }
}

-- Two disclosures with EQUAL counts and DIFFERENT ids: the reason the
-- disclosure is ids, not counts.
func scenario_ids_not_counts() -> bool ! {IO} {
  let noop = ids(["describe_tools", "prompt_shaper", "tool_policy"]);
  let behaviour = ids(["compactor", "tool_provider", "solver_judge"]);
  match capability_disclosure_from_ids({ extension_id: "noop", atoms: noop, covered: noop, excluded: [] }) {
    Err(_) => { let _ = println("  ✗ ids: noop disclosure failed to parse"); false },
    Ok(a) =>
      match capability_disclosure_from_ids({ extension_id: "behaviour", atoms: behaviour, covered: behaviour, excluded: [] }) {
        Err(_) => { let _ = println("  ✗ ids: behaviour disclosure failed to parse"); false },
        Ok(b) => {
          let ia = capability_disclosure_ids(a);
          let ib = capability_disclosure_ids(b);
          let same_count = List.length(ia.covered) == List.length(ib.covered);
          let different_ids = not same_ids(id_strs(ia.covered), id_strs(ib.covered));
          let ok = same_count && different_ids;
          let _ = if ok then println("  ✓ ids: equal counts (3), distinguishable ids")
                  else println("  ✗ ids: counts=${show(same_count)} distinct=${show(different_ids)}");
          ok
        }
      }
  }
}

func scenario_unknown_id_fails_closed() -> bool ! {IO} {
  let bad = { extension_id: "typo", atoms: ids(["describe_tools", "compacter"]), covered: [], excluded: [] };
  match capability_disclosure_from_ids(bad) {
    Err(r) => {
      let ok = rejection_rule(r) == "unknown-capability-kind";
      let _ = if ok then println("  ✓ unknown kind id: rejected by [unknown-capability-kind]")
              else println("  ✗ unknown kind id: rejected by [${rejection_rule(r)}]");
      ok
    },
    Ok(_) => { let _ = println("  ✗ unknown kind id: parsed clean, should have failed closed"); false }
  }
}

-- ---------------------------------------------------------------------------
-- B3: the atom unit (extension, kind, index) -- the N>1 shapes
-- ---------------------------------------------------------------------------

pure func chain_atoms() -> [AtomRef] {
  [{ kind: CompactorKind, index: 0 }, { kind: CompactorKind, index: 1 },
   { kind: ToolProviderKind, index: 0 }]
}

pure func cap_same_kind_twice() -> [CapabilityDisclosure] {
  [{ extension_id: "chain", atoms: chain_atoms(),
     covered: [{ kind: CompactorKind, index: 0 }, { kind: CompactorKind, index: 1 }],
     excluded: [{ kind: ToolProviderKind, index: 0 }] }]
}

pure func cap_no_capabilities() -> [CapabilityDisclosure] {
  [{ extension_id: "inert", atoms: [], covered: [], excluded: [] }]
}

pure func cap_second_atom_unaccounted() -> [CapabilityDisclosure] {
  [{ extension_id: "partial", atoms: chain_atoms(),
     covered: [{ kind: CompactorKind, index: 0 }],
     excluded: [{ kind: ToolProviderKind, index: 0 }] }]
}

pure func cap_atom_in_both() -> [CapabilityDisclosure] {
  [{ extension_id: "overlap", atoms: chain_atoms(),
     covered: chain_atoms(), excluded: [{ kind: CompactorKind, index: 1 }] }]
}

pure func cap_phantom_atom() -> [CapabilityDisclosure] {
  [{ extension_id: "phantom", atoms: chain_atoms(),
     covered: chain_atoms() ++ [{ kind: SolverJudgeKind, index: 0 }], excluded: [] }]
}

func cap_section() -> bool ! {IO} {
  let _ = println("  -- B3: the atom unit (extension, kind, index), N>1 --");
  let a2 = assert_accepted("two Compactor atoms + gated ToolProvider excluded (legal N>1, D4 signed)", cap_same_kind_twice());
  let r1 = assert_rejected("registers no capability (D7, recommended)", "installed-with-no-capabilities", cap_no_capabilities());
  let r2 = assert_rejected("second atom of a kind classified nowhere", "atoms-covered-excluded-exhaustive", cap_second_atom_unaccounted());
  let r3 = assert_rejected("atom in both lists", "atoms-covered-excluded-disjoint", cap_atom_in_both());
  let r4 = assert_rejected("atom the registration does not hold", "atom-not-registered", cap_phantom_atom());
  a2 && r1 && r2 && r3 && r4
}

-- Printed for `make profile_coverage`, which pins it against the ABI's count
-- of `type Capability` variants.
export func print_capability_kind_count() -> () ! {IO} {
  println(show(List.length(all_capability_kinds())))
}

export func main() -> () ! {IO} {
  let _ = println("=== profile_coverage_dst (D5/D6, ${coverage_rules_version()}) ===");

  let _ = println("  -- profiles that must load --");
  let p1 = assert_accepted("driver_only (empty install list)", driver_only_install());
  let p2 = assert_accepted("fully covered (one atom per kind)", fully_covered());
  let p3 = assert_accepted("gated atom excluded (tool_provider[0])", gated_exclusion_only());

  let _ = println("  -- profiles that must be rejected --");
  let r1 = assert_rejected("all atoms excluded", "coverage-floor", all_excluded());
  let r2 = assert_rejected("unconditional atom excluded", "unconditional-hook-excluded", unconditional_excluded());
  let r3 = assert_rejected("describe_tools[0] excluded (the seventh)", "unconditional-hook-excluded", describe_tools_excluded());
  let r4 = assert_rejected("atom classified nowhere", "atoms-covered-excluded-exhaustive", partial_disclosure());
  let r5 = assert_rejected("covered and excluded overlap", "atoms-covered-excluded-disjoint", overlapping());
  let r6 = assert_rejected("extension disclosed twice", "duplicate-extension-id", duplicated_extension());

  let _ = println("  -- both defects reported, not just the first --");
  let both = validate_capability_install_list(two_defects());
  let r7 = has_rule(both, "coverage-floor") && has_rule(both, "atoms-covered-excluded-disjoint");
  let _ = if r7 then println("  ✓ two defects: both rules named")
          else {
            let _ = println("  ✗ two defects: only some rules named");
            report_rejections(both)
          };

  let _ = println("  -- atom ids, not counts --");
  let i1 = scenario_ids_not_counts();
  let i2 = scenario_unknown_id_fails_closed();

  let cap = cap_section();

  let control = not capability_install_list_ok(all_excluded()) && capability_install_list_ok(driver_only_install());
  let _ = if control then println("  ✓ control: the validator both accepts and rejects")
          else println("  ✗ control: the validator never rejects — every check above is vacuous");

  if p1 && p2 && p3 && r1 && r2 && r3 && r4 && r5 && r6 && r7 && i1 && i2 && control && cap
  then println("profile_coverage_dst PASS")
  else {
    let _ = println("profile_coverage_dst FAIL");
    exit(1)
  }
}
