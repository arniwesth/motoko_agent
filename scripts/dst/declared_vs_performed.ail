-- ---------------------------------------------------------------------------
-- A context with no driver behind it
-- ---------------------------------------------------------------------------

-- SUPERSEDED IN ITS FIRST CLAUSE AT WI-D19, and kept in the past tense per plan
-- rule S15. This note READ: "These ports are never CALLED by any arm below".
-- That was true from WI-C5 through WI-D18 and it is now false — WI-D19 routed
-- compose's `on_response_intercept`, so `compose_intercept_inline` calls
-- `clock_now`, `dir_make`, `file_write`, `path_stat` and `file_remove` on the way
-- through. Five of these ten stubs acquired their first caller in this file, and
-- a reader who trusted the old sentence would mis-read the FS rows below.
--
-- The SECOND clause still holds and is why the rows stay valid: every one of them
-- is a constant, so binding them cannot contribute a performed effect and cannot
-- make a subject die for the harness's reasons rather than the hook's. That is
-- precisely why `compose_intercept_inline` stopped dying on FS — see the runner.
--
-- Because they are constants they answer nothing about THREADING, which is a
-- different question and has its own ports below (`trace_*`).
func probe_ai_step(world: ExtWorld, _model: string, _msgs: [Msg]) -> AiStepOutcome ! {AI, IO, Trace} {
  { result: { Ok("unused") }, next_state: world }
}

-- `_tool, _args_json` per the ABI row (WI-D23 renamed this probe's `_cmd, _args`
-- with the census's other stragglers); `exit_code: -1` because a constant probe
-- executes nothing and 0 would assert a success no process produced.
func probe_proc_exec(world: ExtWorld, _tool: string, _args_json: string) -> ExtProcOutcome ! {IO, Process, FS} { { output: "", exit_code: -1, next_state: world } }
func probe_file_read(world: ExtWorld, _path: string) -> ExtFileRead ! {FS} { { present: false, content: "", next_state: world } }
func probe_file_write(world: ExtWorld, _path: string, _content: string) -> ExtFileMutation ! {FS} { { ok: false, error: "no filesystem behind this port", next_state: world } }
func probe_file_remove(world: ExtWorld, _path: string) -> ExtFileMutation ! {FS} { { ok: false, error: "no filesystem behind this port", next_state: world } }
func probe_path_stat(world: ExtWorld, _path: string) -> ExtPathStat ! {FS} { { kind: ExtPathMissing, next_state: world } }
func probe_dir_list(world: ExtWorld, _path: string) -> ExtDirListing ! {FS} { { present: false, entries: [], next_state: world } }
func probe_dir_make(world: ExtWorld, _path: string) -> ExtFileMutation ! {FS} { { ok: false, error: "no filesystem behind this port", next_state: world } }
func probe_clock_now(world: ExtWorld) -> ExtClockReading ! {Clock} { { now_ms: 0, next_state: world } }
func probe_env_get(_key: string, fallback: string) -> string ! {Env} { fallback }

func probe_ports() -> ExtPorts {
  { ai_step: probe_ai_step,
    proc_exec: probe_proc_exec,
    file_read: probe_file_read,
    file_write: probe_file_write,
    file_remove: probe_file_remove,
    path_stat: probe_path_stat,
    dir_list: probe_dir_list,
    dir_make: probe_dir_make,
    clock_now: probe_clock_now,
    env_get: probe_env_get }
}

-- ---------------------------------------------------------------------------
-- WI-D19: THE THREADING PORTS, and the question they answer that the constant
-- stubs above cannot
-- ---------------------------------------------------------------------------
--
-- PER PLAN RULE S24, REACHABILITY IS ASSERTED SEPARATELY FROM VERDICT. A routed
-- call that type-checks and never executes proves nothing, and this project has
-- counted 74 sites across forty-two runs where two answers type-checked and the
-- silent one was wrong. `on_response_intercept` has that shape twice over:
--
--   * `let made = p.dir_make(...)` whose `.next_state` is never read compiles
--     clean and routes nothing;
--   * `next_state: ctx.world` instead of `next_state: cleaned.next_state`
--     compiles clean, satisfies the closed row, and silently discards every
--     successor the five seams produced. That is F6, and it is the exact defect
--     the whole world-token protocol exists to prevent.
--
-- Neither is visible to the compiler, to `ext_ambient_inventory` (which counts
-- CALL SITES, so both mutants are green there) or to the `must_die_on` rows
-- (which observe a capability, not a value). These ports make both observable by
-- writing their own name into the world token they are handed and returning it,
-- so the world that comes back out of the dispatcher IS the list of seams that
-- were called, in the order they were called.
--
-- `trace_path_stat` answers `ExtPathFile` DELIBERATELY. `ExtPathMissing` would
-- send `remove_if_file` down its no-op arm, `file_remove` would never be called,
-- and the arm would witness four seams while its label claimed five — WI-D18's
-- mutant 5 exactly, where a word in a row's label turned out to be pinned by
-- nothing.
pure func trace_of(w: ExtWorld) -> string {
  match get(w.token, "trace") {
    Some(v) => match asString(v) { Some(s) => s, None => "" },
    None => ""
  }
}

pure func with_step(w: ExtWorld, step: string) -> ExtWorld {
  { token: jo([kv("trace", js("${trace_of(w)}${step};"))]) }
}

func trace_clock_now(w: ExtWorld) -> ExtClockReading ! {Clock} {
  { now_ms: 7, next_state: with_step(w, "clock_now") }
}
func trace_dir_make(w: ExtWorld, path: string) -> ExtFileMutation ! {FS} {
  { ok: true, error: "", next_state: with_step(w, "dir_make(${path})") }
}
func trace_file_write(w: ExtWorld, path: string, _content: string) -> ExtFileMutation ! {FS} {
  { ok: true, error: "", next_state: with_step(w, "file_write(${path})") }
}
func trace_path_stat(w: ExtWorld, path: string) -> ExtPathStat ! {FS} {
  { kind: ExtPathFile, next_state: with_step(w, "path_stat(${path})") }
}
func trace_file_remove(w: ExtWorld, path: string) -> ExtFileMutation ! {FS} {
  { ok: true, error: "", next_state: with_step(w, "file_remove(${path})") }
}

func trace_ports() -> ExtPorts {
  { ai_step: probe_ai_step,
    proc_exec: probe_proc_exec,
    file_read: probe_file_read,
    file_write: trace_file_write,
    file_remove: trace_file_remove,
    path_stat: trace_path_stat,
    dir_list: probe_dir_list,
    dir_make: trace_dir_make,
    clock_now: trace_clock_now,
    env_get: probe_env_get }
}

pure func zero_telemetry() -> TokenTelemetry {
  { last_input_tokens: 0, last_output_tokens: 0, last_estimated_input_tokens: 0 }
}

pure func plan() -> BudgetPlan { { total: 100, solver: 60, verifier: 40 } }

func probe_ctx(mode: string) -> ExtCtx {
  { task: "declared_vs_performed",
    step: 1,
    model: "probe-model",
    cwd: ".",
    hybrid_tools: false,
    budget: plan(),
    mode: mode,
    workdir: ".",
    env_server_url: "",
    budget_remaining: 100,
    history_slice: [],
    state_key: "probe",
    context_limit: 0,
    ports: probe_ports(),
    artifacts: jo([]),
    telemetry: zero_telemetry(),
    world: empty_ext_world() }
}

pure func no_verification() -> VerificationConfig { { enabled: false, command: "" } }

pure func stage_ids(ss: [PreStepStage]) -> [string] {
  match ss {
    [] => [],
    s :: rest => s.ext_id :: stage_ids(rest)
  }
}

pure func join_ids(xs: [string]) -> string {
  match xs {
    [] => "",
    x :: [] => x,
    x :: rest => "${x}+${join_ids(rest)}"
  }
}

func rt_of(h: ExtensionHooks) -> ExtRuntime {
  { registry: { hooks: [h] }, strict_mode: false, verification: no_verification() }
}

-- ---------------------------------------------------------------------------
-- The subject: compose, built the way the host builds it
-- ---------------------------------------------------------------------------

-- The config is a LITERAL rather than `read_compose_host_config`, which is
-- `! {FS}` and would read a file — under an FS-withheld run that read would die
-- in the harness and be scored as a performed effect of the hook. The literal
-- is the only construction that keeps the measurement about compose.
--
-- `mode` is a parameter because it SELECTS what `on_response_intercept`
-- performs; see limitation 1 in the header.
pure func compose_cfg(mode: string) -> ComposeHostConfig {
  { compose: { mode: mode,
               subagent_model: "probe-model",
               max_attempts: 1,
               effect_guard: "off",
               certificate_template: false,
               authoring: { structured: false,
                            author_tools: false,
                            author_tools_budget: 0,
                            author_tools_max_bytes: 0,
                            author_tools_max_turns: 0,
                            author_tools_deny_globs: [],
                            authoring_budget: 0,
                            fallback_after: 0,
                            min_observed_chars: 0,
                            stdout_max_bytes: 0 },
               claimcheck: { enabled: false,
                             informalizer_model: "",
                             comparator_model: "",
                             timeout_ms: 0,
                             max_invocations: 0,
                             stdout_max_bytes: 0,
                             ledger_in_informalizer: false } },
    snippet_caps: [] }
}

-- ---------------------------------------------------------------------------
-- The controls: hooks that genuinely perform the capability under test
-- ---------------------------------------------------------------------------

-- WI-D6 MOVED THESE CONTROLS FROM `on_budget_plan` TO `on_pre_step`, AND THE
-- REASON IS THE ITEM'S RESULT RATHER THAN A CONVENIENCE.
--
-- At WI-C5 both controls were bound into `on_budget_plan`, whose row was then
-- the ABI's closed `! {Env, FS}`, so a performing body fitted the slot. D6
-- narrowed that row to `! {}` — and the compiler IMMEDIATELY REJECTED both
-- controls:
--
--   incompatible closed rows: r1 has extra labels [], r2 has extra labels [Env]
--
-- That rejection is the narrowing's own strongest evidence: after D6 it is not
-- merely true that no binding performs Env or FS in this slot, it is
-- UNWRITABLE. But it also means the runtime vacuity control can no longer live
-- in the slot under test, so it moves to the nearest slot that still admits the
-- capability — `on_pre_step`, dispatched through its own unconditional fold in
-- the same `ext/runtime.ail`. The control still answers the question it existed
-- to answer (is the withholding real, and does the harness reach a dispatched
-- hook), from the same registry shape and the same process.
--
-- The control that is LOST — a performing body in this exact slot — is not
-- lost, it is PROMOTED: it is now a compile-time control in
-- `run_declared_vs_performed.sh`'s producer-3 section, where a mutant binding
-- that performs Env under the narrowed row must be REJECTED by the effect
-- checker. That control is strictly stronger than the runtime one it replaces,
-- because it is total over inputs where the capability trap is a witness over
-- one path.

-- WI-D8 MOVED THESE CONTROLS AGAIN, ONE SLOT LATER, AND THE MOVE IS NOT THE
-- SAME KIND OF MOVE D6 MADE. D6 relocated them from `on_budget_plan` to
-- `on_pre_step` because narrowing the first slot made a performing body
-- unwritable there. D8 narrowed `on_pre_step` to `! {AI, IO, Trace}` — the row
-- `ExtPorts.ai_step` actually performs — and a body reading `Env` or `FS` no
-- longer fits this slot EITHER, when it is written as a top-level function:
--
--   Effect checking failed for function 'env_reading_pre_step'
--   Missing effects: Env
--
-- SO THERE IS NOWHERE LEFT TO MOVE THEM TO, and the thing that keeps them
-- alive is a LIMITATION rather than a slot. MEASURED AT WI-D8 across four
-- syntactic positions, because the first reading of it was WRONG in the
-- permissive direction and a single probe would have shipped that reading:
--
--   top-level `func`,    row ! {IO},  body reads Env  -> REJECTED
--   `let`-bound lambda,  row ! {IO},  body reads Env  -> REJECTED
--   argument lambda,     row ! {IO},  body reads Env  -> REJECTED
--   RECORD-FIELD lambda, row ! {IO},  body reads Env  -> ACCEPTED   <-- the gap
--
-- and separately, at ANY position:
--
--   lambda,              row ! {},    body performs   -> ACCEPTED
--
-- because an EMPTY row on a lambda is read as "unannotated, infer" rather than
-- as the claim "performs nothing".
--
-- RECORD-FIELD POSITION IS EXACTLY WHERE EVERY HOOK IN THIS TREE IS BOUND —
-- eight of the fifteen extensions in `registry_generated.ail` bind THIS slot
-- that way. Both facts are asserted as their own rows in
-- `run_declared_vs_performed.sh`, so if either is fixed upstream these
-- controls go RED rather than silently ceasing to perform.
--
-- AND THE EFFECT IS NOT LOST, IT MOVES — which is the half that matters and
-- the half a reader would otherwise get backwards. The lambda's OWN annotation
-- is not checked against its body, but the body's effects still propagate to
-- the ENCLOSING top-level function, whose row IS checked. So the enforcement
-- D6 and D7 recorded is real and it lives one level up from where those
-- reports put it:
--
--   narrowing a HOOK SLOT's row constrains a binding written as a top-level
--   function, and constrains NOTHING about a binding written inline in the
--   record — for that one, the constraint is `register_with_config`'s row.
--
-- MEASURED, in `empty_stop_guard`: an inline `on_pre_step` reading `Env` under
-- `! {AI, IO, Trace}` compiles while `register_with_config` carries a row that
-- admits `Env`, and is REJECTED the moment that row is narrowed past it —
-- `Effect checking failed for function 'register_with_config' … Missing
-- effects: Env`.
--
-- SO THE ABSORPTION IS PER EFFECT, NOT GLOBAL, and the first draft of this note
-- said "all fifteen carry the wide row and absorb anything", which the
-- derivation refuted on sight. DERIVED, and asserted in the runner:
--
--   Env      admitted by 14 of the 14 registration ROWS
--   FS       admitted by 12 of 14
--   Process  admitted by  7 of 14
--
-- and the denominator is ROWS rather than extensions because the two differ:
-- fifteen extensions declare fourteen rows between them. `decision_framework`
-- and `microrag` declare NO registration row at all — so an inline hook there
-- that performs anything is caught — and `compose` declares two, a wrapper in
-- `register.ail` and the real one in `compose.ail`, which is also the file
-- that binds the hook.
--
-- `Env` is admitted by every row that exists, which is the sharp end: an
-- inline hook that begins reading `Env` is absorbed wherever a registration
-- row exists at all.
--
-- Exactly ONE registration, `compaction_ai`'s, still carries the full
-- ten-effect row and therefore absorbs everything. This item reports that and
-- does NOT act on it: WI-D6 measured that nine of fifteen genuinely read `Env`
-- at registration, so narrowing those rows is its own measurement item rather
-- than an ABI edit.
--
-- These two builders declare `! {Env}` and `! {FS}` for exactly that reason —
-- the leak reaches them, and they are honest about it.
--
-- The controls are therefore written in the SAME FORM THE SUBJECTS USE, which
-- is what S16 asks of an instrument: a control bound as a top-level function
-- would be measuring a construct no extension in this tree writes.
-- The performing body is INLINE IN THE RECORD FIELD in each of the two
-- builders below, and it has to be: passing it in as a parameter puts the
-- lambda in ARGUMENT position, where the effect checker does fire, and the
-- control stops compiling. That is why `control_hooks` is no longer
-- parameterised over the hook.
func env_control_hooks() -> ExtensionHooks ! {Env} {
  { control_base() | on_pre_step: func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {AI, IO, Trace} {
      let _ = getEnvOr("PATH", "");
      { decision: { PassThrough }, next_state: ctx.world }
    } }
}

func fs_control_hooks() -> ExtensionHooks ! {FS} {
  { control_base() | on_pre_step: func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {AI, IO, Trace} {
      let _ = readFile("ailang.toml");
      { decision: { PassThrough }, next_state: ctx.world }
    } }
}

func control_base() -> ExtensionHooks {
  { id: "dvp_control",
    provided_tools: [],
    on_describe_tools: \_ . [],
    on_build_system_prompt: \_ctx. { prepend: [], append: [] },
    on_budget_plan: func(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch {
      { requested_total: None, requested_solver: None, requested_verifier: None }
    },
    on_pre_step: func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {AI, IO, Trace} { { decision: { PassThrough }, next_state: ctx.world } },
    on_tool_policy: \_ctx _call. Allow,
    on_tool_handle: func(ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand} { { decision: { Delegate }, next_state: ctx.world } },
    on_response_intercept: func(ctx: ExtCtx, _t: string) -> ResponseInterceptOutcome ! {IO, Process, FS, Clock} { { decision: { NoIntercept }, next_state: ctx.world } },
    on_solver_candidate: func(ctx: ExtCtx, _c: string) -> FinalizeOutcome ! {Process} { { decision: { NoDecision }, next_state: ctx.world } } }
}

-- ---------------------------------------------------------------------------
-- The witness hook, and the mutant that forced it to exist
-- ---------------------------------------------------------------------------
--
-- FOUND BY MUTATION, and it is the failure mode this whole item was warned
-- about. The first version of these arms printed a fixed completion marker.
-- Deleting the dispatch from an arm — leaving a program that measures NOTHING —
-- left this gate GREEN AT NINE OF NINE ROWS, because the marker's producer was
-- the arm's own code rather than the dispatch. That is S16 one level down,
-- inside the instrument built to answer S16.
--
-- The fix is that every subject arm now prints a value it can only obtain BY
-- DISPATCHING. `dvp_witness` is registered AFTER compose in the same registry,
-- and the folds in `src/core/ext/runtime.ail` are unconditional and in order,
-- so the witness's sentinel can only appear in the result if the fold ran and
-- invoked compose's hook FIRST. Deleting the dispatch now fails to compile;
-- faking the sentinel takes a deliberate edit rather than a deletion.
--
-- The sentinels are pairwise distinct (S7): a single shared value could not
-- distinguish which arm's fold produced it.
pure func budget_sentinel() -> int { 4242 }
pure func solver_sentinel() -> string { "dvp-solver-witness" }
pure func intercept_sentinel() -> string { "dvp-intercept-witness" }
pure func witness_id() -> string { "dvp_witness" }

func witness_hooks() -> ExtensionHooks {
  { id: witness_id(),
    provided_tools: [],
    on_describe_tools: \_ . [],
    on_build_system_prompt: \_ctx. { prepend: [], append: [] },
    on_budget_plan: func(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch {
      { requested_total: Some(budget_sentinel()), requested_solver: None, requested_verifier: None }
    },
    on_pre_step: func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {AI, IO, Trace} { { decision: { PassThrough }, next_state: ctx.world } },
    on_tool_policy: \_ctx _call. Allow,
    on_tool_handle: func(ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand} { { decision: { Delegate }, next_state: ctx.world } },
    on_response_intercept: func(ctx: ExtCtx, _t: string) -> ResponseInterceptOutcome ! {IO, Process, FS, Clock} {
      { decision: { InterceptHandled({ tool_call_id: intercept_sentinel(), tool: "dvp", exit_code: 0,
                                       stdout: "", stderr: "", metadata: jo([]) }) },
        next_state: ctx.world }
    },
    on_solver_candidate: func(ctx: ExtCtx, _c: string) -> FinalizeOutcome ! {Process} {
      { decision: { Accept(solver_sentinel()) }, next_state: ctx.world }
    } }
}

-- compose FIRST, witness SECOND. The order is the load-bearing part: every fold
-- in ext/runtime.ail walks the registry in order, so reaching the witness
-- entails having invoked compose.
func compose_then_witness(mode: string) -> ExtRuntime ! {AI, Clock, Env, FS, IO, Process, Rand} {
  let hooks = Compose.register_with_config(compose_cfg(mode));
  { registry: { hooks: [hooks, witness_hooks()] }, strict_mode: false, verification: no_verification() }
}

-- ---------------------------------------------------------------------------
-- The arms. Each prints a value DERIVED FROM ITS DISPATCH; the runner asserts
-- the exact sentinel. Exit status alone is not the measurement — see the
-- witness note above for the mutant that established why.
-- ---------------------------------------------------------------------------

func reached(arm: string, witnessed: string) -> () ! {IO} {
  println("declared_vs_performed[${arm}] REACHED COMPLETION witness=${witnessed}")
}

-- SUBJECT. compose's `on_budget_plan`, dispatched through the production fold.
-- Declared `! {Env, FS}` by the ABI row at types.ail:298 and by compose's own
-- `budget_hook`. Run with Env and FS withheld.
export func compose_budget() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let out = Rt.dispatch_budget_plan(compose_then_witness("tool"), probe_ctx("tool"), plan());
  reached("compose_budget", show(out.total))
}

-- SUBJECT. compose's `on_pre_step`. Declared `! {AI, IO, Trace}` at the
-- binding site (ten effects until WI-D8 measured `ExtPorts.ai_step` and the
-- slot followed the port down); the body is `PassThrough` beside `ctx.world`.
-- The strongest witness of the four: `PreStepChainResult.stages` carries one
-- entry PER HOOK, each tagged with `ext_id`, so this arm names compose directly
-- rather than inferring it from fold order.
export func compose_pre_step() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let out = Rt.dispatch_pre_step_chain(compose_then_witness("tool"), probe_ctx("tool"), []);
  reached("compose_pre_step", join_ids(stage_ids(out.stages)))
}

-- SUBJECT. compose's `on_solver_candidate`. Declared with nine effects; the
-- body is `no_finalize_decision()` beside `ctx.world`.
export func compose_solver() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let out = Rt.dispatch_solver_candidate(compose_then_witness("tool"), probe_ctx("tool"), "candidate");
  let seen = match out.decision { Accept(s) => s, ContinueWithFeedback(_) => "continue", NoDecision => "none" };
  reached("compose_solver", seen)
}

-- SUBJECT, and the honest one. compose's `on_response_intercept` with
-- `mode != "inline"`, which short-circuits to `NoIntercept` before touching the
-- filesystem. Completes with FS and Process withheld.
-- The witness sentinel appearing here means compose returned `NoIntercept` and
-- `first_intercept` recursed PAST it — which is exactly "compose's
-- on_response_intercept was invoked and did not perform".
export func compose_intercept_noninline() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let out = Rt.dispatch_response_intercept(compose_then_witness("tool"), probe_ctx("tool"), "no fence here");
  let seen = match out.decision { InterceptHandled(r) => r.tool_call_id, NoIntercept => "none" };
  reached("compose_intercept_noninline", seen)
}

-- THE LIMIT, MADE EXECUTABLE. The SAME hook, the SAME declared row, and the
-- same withheld capabilities as the arm above — differing only in `mode` and in
-- the response carrying an AILANG fence. This one reaches `mkdirAll`/`writeFile`
-- and DIES.
--
-- The runner asserts this arm fails. That assertion is what stops
-- `compose_intercept_noninline`'s green from being read as "compose's
-- `on_response_intercept` performs no FS", which is false. Per header
-- limitation 1: performed is a property of a hook AND ITS INPUTS, and a
-- detector that reported only the first arm would be reporting a per-hook fact
-- that does not exist.
export func compose_intercept_inline() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let out = Rt.dispatch_response_intercept(compose_then_witness("inline"), probe_ctx("inline"),
            "here is code\n```ailang\nexport func main() -> () ! {IO} { () }\n```\n");
  let seen = match out.decision { InterceptHandled(r) => r.tool_call_id, NoIntercept => "none" };
  reached("compose_intercept_inline", seen)
}

-- WI-D19. THE REACHABILITY ARM, and per plan rule S24 it is separate from every
-- verdict above on purpose: nothing else in this file — nor in
-- `ext_ambient_inventory`, nor in the effect checker — can tell a routed call
-- that RAN from a routed call that merely compiled.
--
-- It runs the same hook on the same input as `compose_intercept_inline`, with
-- the threading ports substituted, and prints the world token that came back out
-- of the production dispatcher. The runner compares that string against the
-- sequence written out LITERALLY, because a witness derived from the run would
-- be satisfied by a run that did nothing.
--
-- The expected value is
--   clock_now;dir_make(tmp);file_write(tmp/inline_7.ail);path_stat(...);file_remove(...)
-- and every part of it is load-bearing:
--
--   * `dir_make(tmp)` — not `dir_make(./tmp)` and not an absolute path. This is
--     the assertion for WI-D19's SPELLING FIX: the create and the write must name
--     ONE path key, which is the rule WI-D18 §5 wrote at `WorldState.files` and
--     the defect `world_state_probe` row 8 pins. If the create ever goes back to
--     `"${ctx.workdir}/tmp"` this row names both spellings side by side.
--   * `inline_7` — `7` is `trace_clock_now`'s reading, so the name is derived
--     from the ROUTED clock. An `on_response_intercept` that kept the ambient
--     `now()` produces a wall-clock millisecond here and cannot match.
--   * `file_remove` present at all — the routed `fileExists` guard took its
--     removing arm, so `path_stat` is genuinely deciding and not merely called.
--   * the whole string surviving to the end — every seam threaded its successor
--     into the next, and the hook returned the LAST one. `next_state: ctx.world`
--     yields the empty token, which is the same answer a hook that routed
--     nothing gives.
export func compose_intercept_threading() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let out = Rt.dispatch_response_intercept(compose_then_witness("inline"),
            { probe_ctx("inline") | ports: trace_ports() },
            "here is code\n```ailang\nexport func main() -> () ! {IO} { () }\n```\n");
  reached("compose_intercept_threading", trace_of(out.next_state))
}

-- WI-D20. THE `on_tool_handle` REACHABILITY ARM, and it witnesses LESS than its
-- intercept sibling for a structural reason that is stated rather than hidden.
--
-- `compose_intercept_threading` above can trace `on_response_intercept`'s whole
-- routed chain because that hook reaches its filesystem seams without a model.
-- `on_tool_handle` cannot: `handle_compose_tool` -> `run_attempts` ->
-- `one_attempt` calls `callStreamResult`, which is AMBIENT AI from `ai_compat`
-- and not `ExtPorts.ai_step`, so `trace_ports` has nothing to substitute for it.
-- With no provider the author returns no snippet, `one_attempt` takes its early
-- `NeedRetry`, and the seventeen routed FS sites below that point are never
-- reached in this process.
--
-- SO THIS ARM PINS TWO LINKS OF THE SPINE, AND EXACTLY TWO. The first draft of
-- this comment claimed three; the third was measured and found NOT pinned, and
-- the label is narrowed here rather than the claim left standing.
--
-- WHAT IT PINS, each confirmed by running the mutant:
--
--   * `on_tool_handle` returning `handled.next_state` rather than `ctx.world`.
--     Mutated, the witness comes back EMPTY — the same answer a hook that routed
--     nothing gives.
--   * `handle_compose_tool` passing `started.next_state` into `run_attempts`
--     rather than its own `w`. Mutated, the witness is `clock_now;` — the entry
--     clock's successor is discarded and the exhaust clock starts from a fresh
--     token.
--
-- WHAT IT DOES NOT PIN, AND WHY NO IN-PROCESS FIXTURE CAN: `run_attempts`
-- recursing on `w2` (the attempt's successor) rather than on `w`. Mutated, this
-- witness is UNCHANGED — because without a model `one_attempt` reaches its early
-- `NeedRetry` before any routed seam, so `w2` and `w` are the SAME WORLD and the
-- two answers agree by construction. That is WI-D18's empty-directory shape and
-- WI-D19's populated-directory shape a third time: the distinguishing input is an
-- attempt that actually performed something, which needs the model this process
-- does not have. Named as a gap rather than covered by a row that would pass
-- either way.
--
-- The graded end of this is `discovery_dst`'s `batch_handle_scenario`, which
-- drives the production driver rather than the dispatcher alone. The two are
-- complementary and neither subsumes the other: that one grades the DRIVER's
-- threading with a compose-shaped hook, this one grades COMPOSE's threading with
-- a driver-shaped dispatch.
export func compose_tool_handle_threading() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let out = Rt.dispatch_tool_handle(compose_then_witness("subagent"),
            { probe_ctx("subagent") | ports: trace_ports() },
            { id: "probe-handle", tool: "Compose", arguments: jo([]) });
  reached("compose_tool_handle_threading", trace_of(out.next_state))
}

-- CONTROL for Env. Must die with Env withheld. Dispatched through the pre-step
-- fold — see the note above `env_reading_pre_step` for why this control no
-- longer lives in `on_budget_plan`.
export func control_env() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let out = Rt.dispatch_pre_step_chain(rt_of(env_control_hooks()), probe_ctx("tool"), []);
  reached("control_env", join_ids(stage_ids(out.stages)))
}

-- CONTROL for FS. Must die with FS withheld.
export func control_fs() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let out = Rt.dispatch_pre_step_chain(rt_of(fs_control_hooks()), probe_ctx("tool"), []);
  reached("control_fs", join_ids(stage_ids(out.stages)))
}


-- ===========================================================================
-- WI-D6: THE OTHER FOURTEEN BINDINGS, and the confound that makes the pairing
-- non-optional
-- ===========================================================================
--
-- WI-C5 measured ONE binding of `on_budget_plan` — compose's. Fifteen
-- extensions bind the slot, and D6's mission is a row narrowed to what is
-- HONESTLY performed, which cannot be decided from one of fifteen.
--
-- THE CONFOUND, MEASURED BEFORE THE ARMS WERE WRITTEN AND THE REASON THEY COME
-- IN PAIRS. `register_with_config` is not effect-free for most of these
-- packages: nine of fourteen read `Env` (a `getEnvOr` for a workdir or profile
-- directory) and seven of those also read `FS` (a config file, or a
-- portability gate probing for a marker file). Those reads happen at
-- REGISTRATION, before any hook is dispatched.
--
-- So the naive arm — install the extension, dispatch the hook, capability
-- withheld — DIES for nine of fifteen subjects, and every one of those deaths
-- would be scored as "the hook performs Env". That is a FALSE POSITIVE in the
-- direction that blocks the narrowing, and it would have been indistinguishable
-- from the real thing in exit status alone.
--
-- The fix is a differential. Each extension gets TWO arms run under the SAME
-- withheld capabilities:
--
--   reg_<ext>     registration only, no dispatch
--   budget_<ext>  the same registration, then the dispatch
--
-- and the runner reads the PAIR rather than either arm:
--
--   reg completes, budget completes  -> the HOOK performs neither. MEASURED.
--   reg completes, budget dies       -> the HOOK performs it.     BLOCKING.
--   reg dies                         -> registration performed it first; the
--                                       hook was never reached.  CONFOUNDED,
--                                       and this instrument cannot settle it.
--
-- The confounded subjects are settled by a SECOND producer that has no such
-- blind spot — the compiler's effect inference over the binding's body, which
-- is total over inputs where the capability trap is a witness over the one path
-- an arm exercises. See `run_declared_vs_performed.sh`'s producer-3 section and
-- the mutant control that proves the narrowed row is load-bearing.
--
-- WHY THESE ARMS USE `register_with_config` WHERE compose's USES A LITERAL
-- CONFIG. compose's arm above deliberately bypasses `read_compose_host_config`
-- so its measurement is about the hook rather than about config IO. These arms
-- deliberately do the opposite and take the host's real route, because the
-- question they answer is different: not "can this hook be reached effect-free"
-- but "what happens when the host installs this extension". The two are
-- complementary, and the difference is stated here rather than left for a
-- reader to infer from the call.

-- test_dummy — REGISTER arm. Witness is the registered record's own `id`, a value
-- obtainable only by having called the registration.
export func reg_test_dummy() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let h = TestDummy.register_with_config(0);
  reached("reg_test_dummy", h.id)
}

-- test_dummy — DISPATCH arm. The witness hook is registered AFTER the subject in
-- the same unconditional, ordered fold, so `total == 4242` is unobtainable
-- unless the fold ran and invoked test_dummy's `on_budget_plan` first.
export func budget_test_dummy() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let h = TestDummy.register_with_config(0);
  let rt = { registry: { hooks: [h, witness_hooks()] }, strict_mode: false, verification: no_verification() };
  let out = Rt.dispatch_budget_plan(rt, probe_ctx("tool"), plan());
  reached("budget_test_dummy", show(out.total))
}

