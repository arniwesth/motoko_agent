func msg(role: string, content: string) -> Message {
  { role: role, content: content, tool_calls: [], tool_call_id: "", images: [] }
}

func history() -> [Message] {
  [msg("system", "s"), msg("user", "u")]
}

func budget() -> BudgetPlan {
  { total: 10, solver: 6, verifier: 4 }
}

func zero_rates() -> CostRates {
  { input_per_1m_millicents: 0, output_per_1m_millicents: 0 }
}

func names_equal(a: [string], b: [string]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs =>
      match b {
        y :: ys => x == y && names_equal(xs, ys),
        [] => false
      }
  }
}

func join_names(xs: [string]) -> string {
  match xs {
    [] => "",
    x :: [] => x,
    x :: rest => "${x},${join_names(rest)}"
  }
}

func decision_names(records: [LedgerRecord]) -> [string] {
  match records {
    [] => [],
    r :: rest =>
      match r {
        DecisionRecord(d) => d.decision :: decision_names(rest),
        _ => decision_names(rest)
      }
  }
}

func trace_decision_names(trace: LedgerTrace) -> [string] {
  decision_names(trace.records)
}

func assert_decisions(trace: LedgerTrace, expected: [string]) -> Result[(), ScenarioFailure] {
  let actual = trace_decision_names(trace);
  ok_or_failure(names_equal(actual, expected), "decision sequence", [
    "actual=${join_names(actual)}",
    "expected=${join_names(expected)}"
  ])
}

func run_scripted(rt: ExtRuntime, script: [ScriptedStep]) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(rt, "task", "", false, budget(), "phase-c-model", history(), ".", 8, false, 0, zero_rates(), Scripted(script))
}

-- Task-bearing runner for progress-contract scenarios: the guard reads ctx.task,
-- and run_scripted hardcodes "task", so those scenarios need to inject a contract.
func run_scripted_task(rt: ExtRuntime, task: string, script: [ScriptedStep]) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(rt, task, "", false, budget(), "phase-c-model", history(), ".", 8, false, 0, zero_rates(), Scripted(script))
}

func scenario_traced_prose_decisions() -> Result[(), ScenarioFailure] ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let traced = run_scripted(empty_rt(), [prose_step("done")]);
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "scripted prose succeeds", trace: ["${e.code}:${e.message}"] })
  }
}

func traced_prose_decisions_scenario() -> Scenario {
  { id: "phase_c.c2.traced_prose_decisions", seed: "fixed", run: scenario_traced_prose_decisions }
}

func scenario_traced_tool_decisions() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted(deny_all_rt(), [tool_step("BashExec", "{\"cmd\":\"true\"}", "tc"), prose_step("done")]);
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "RunTools", "CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "scripted tool succeeds", trace: ["${e.code}:${e.message}"] })
  }
}

func traced_tool_decisions_scenario() -> Scenario {
  { id: "phase_c.c2.traced_tool_decisions", seed: "fixed", run: scenario_traced_tool_decisions }
}

-- Regression: a step that emits a tool_call but reports finish_reason="stop"
-- (as hy3:free/Novita does) must still RunTools, not drop the call and
-- Finalize. The drop produced a malformed [assistant(tool_calls) -> user]
-- payload the provider rejected with 400 invalid_request_error.
func scenario_tool_call_with_stop_finish_still_runs() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted(deny_all_rt(), [tool_step_finish("BashExec", "{\"cmd\":\"true\"}", "tc", "stop"), prose_step("done")]);
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "RunTools", "CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "tool_call with stop finish still runs", trace: ["${e.code}:${e.message}"] })
  }
}

func tool_call_with_stop_finish_still_runs_scenario() -> Scenario {
  { id: "phase_c.c2.tool_call_with_stop_finish_still_runs", seed: "fixed", run: scenario_tool_call_with_stop_finish_still_runs }
}

func scenario_traced_persist_nudge_decisions() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = Session.run_v2_session_traced_with_persist_retries(
    empty_rt(),
    "task",
    "",
    false,
    budget(),
    "phase-c-model",
    history(),
    ".",
    8,
    false,
    0,
    zero_rates(),
    1,
    Scripted([prose_step("not done"), prose_step("done")])
  );
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "InjectUserMessage", "CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "scripted nudge succeeds", trace: ["${e.code}:${e.message}"] })
  }
}

func traced_persist_nudge_decisions_scenario() -> Scenario {
  { id: "phase_c.c2.traced_persist_nudge_decisions", seed: "fixed", run: scenario_traced_persist_nudge_decisions }
}

func no_describe() -> [ToolSchema] { [] }

func no_prompt(_ctx: ExtCtx) -> PromptPatch {
  { prepend: [], append: [] }
}

func no_budget(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch {
  { requested_total: None, requested_solver: None, requested_verifier: None }
}

func no_policy(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolPolicyDecision {
  NoOpinion
}

func pending_policy(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolPolicyDecision {
  Pending("approval required", DenyAfterTimeout)
}

func no_handle(ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand}  { { decision: {
  Delegate
}, next_state: ctx.world } }

func no_intercept(ctx: ExtCtx, _text: string) -> ResponseInterceptOutcome ! {IO, Process, FS, Clock}  { { decision: {
  NoIntercept
}, next_state: ctx.world } }

func no_solver(ctx: ExtCtx, _text: string) -> FinalizeOutcome ! {Process}  { { decision: {
  NoDecision
}, next_state: ctx.world } }

func guard_solver(ctx: ExtCtx, text: string) -> FinalizeOutcome ! {Process}  { { decision: {
  decide_with_budget(ctx, text, 2)
}, next_state: ctx.world } }

func bad_system_msg() -> Msg {
  { role: "system", content: "bad", tool_calls: [], tool_call_id: "" }
}

func stage_pre(mode: string) -> (ExtCtx, [Msg]) -> PreStepOutcome ! {AI, IO, Trace} {
  func(ctx: ExtCtx, msgs: [Msg]) -> PreStepOutcome ! {AI, IO, Trace}  { { decision: {
    if mode == "pass" then PassThrough
    else if mode == "apply" then Compacted(msgs, "applied", jo([]))
    else Compacted([bad_system_msg()], "rejected", jo([]))
  }, next_state: ctx.world } }
}

func stage_hook(id: string, mode: string) -> FixtureHooks {
  let on_pre = stage_pre(mode);
  fixture_hooks(id, {
    tools: [],
    describe: no_describe,
    prompt: no_prompt,
    budget: no_budget,
    compact: on_pre,
    policy: no_policy,
    provide: no_handle,
    intercept: no_intercept,
    judge: no_solver
  })
}

func guard_hook() -> FixtureHooks {
  fixture_hooks("empty_stop_guard", {
    tools: [],
    describe: no_describe,
    prompt: no_prompt,
    budget: no_budget,
    compact: func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {AI, IO, Trace}  { { decision: {
      PassThrough
    }, next_state: ctx.world } },
    policy: no_policy,
    provide: no_handle,
    intercept: no_intercept,
    judge: guard_solver
  })
}

func guard_rt() -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "make check_core" };
  {
    registry: { entries: [guard_hook()] },
    strict_mode: false,
    verification: v
  }
}

func pc_guard_solver(ctx: ExtCtx, text: string) -> FinalizeOutcome ! {Process}  { { decision: {
  pc_decide_with_budget(ctx, text, 2)
}, next_state: ctx.world } }

func pc_guard_hook() -> FixtureHooks {
  fixture_hooks("progress_contract_guard", {
    tools: [],
    describe: no_describe,
    prompt: no_prompt,
    budget: no_budget,
    compact: func(ctx: ExtCtx, _msgs: [Msg]) -> PreStepOutcome ! {AI, IO, Trace}  { { decision: {
      PassThrough
    }, next_state: ctx.world } },
    policy: no_policy,
    provide: no_handle,
    intercept: no_intercept,
    judge: pc_guard_solver
  })
}

func pc_guard_rt() -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "make check_core" };
  {
    registry: { entries: [pc_guard_hook()] },
    strict_mode: false,
    verification: v
  }
}

-- empty_stop_guard first, then progress_contract_guard, mirroring profile order.
func combined_guard_rt() -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "make check_core" };
  {
    registry: { entries: [guard_hook(), pc_guard_hook()] },
    strict_mode: false,
    verification: v
  }
}

func pc_contract_task() -> string {
  "Do not stop early. Complete at least 200 phases. Check MotokoRuntimeStatus current_step and step_budget."
}

func pc_compaction_task() -> string {
  "Continue until the task is done or until the runtime compacts. Complete at least 200 phases."
}

func pc_failure_candidate() -> string {
  "**Phase 51 complete.** Step 53/200. Context is growing. Continuing Phase 52."
}

func stage_rt() -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "make check_core" };
  {
    registry: { entries: [stage_hook("stage-pass", "pass"), stage_hook("stage-apply", "apply"), stage_hook("stage-reject", "reject")] },
    strict_mode: false,
    verification: v
  }
}

func pending_rt() -> ExtRuntime {
  let h_pre = stage_pre("pass");
  let v: VerificationConfig = { enabled: false, command: "make check_core" };
  {
    registry: { entries: [fixture_hooks("approval-pending", {
      tools: [],
      describe: no_describe,
      prompt: no_prompt,
      budget: no_budget,
      compact: h_pre,
      policy: pending_policy,
      provide: no_handle,
      intercept: no_intercept,
      judge: no_solver
    })] },
    strict_mode: false,
    verification: v
  }
}

func has_tool_content(msgs: [Message], needle: string) -> bool {
  match msgs {
    [] => false,
    m :: rest =>
      if m.role == "tool" && contains(m.content, needle) then true
      else has_tool_content(rest, needle)
  }
}

func scenario_traced_approval_default_deny() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted(pending_rt(), [tool_step("BashExec", "{\"cmd\":\"true\"}", "tc"), prose_step("done")]);
  match traced.result {
    Ok(history_after) => {
      let decisions_ok = names_equal(trace_decision_names(traced.trace), ["CallModel", "RunTools", "AwaitApproval", "CallModel", "Finalize"]);
      let denial_ok = has_tool_content(history_after, "timeout — no approval received");
      ok_or_failure(decisions_ok && denial_ok, "approval await/default deny", [
        "actual=${join_names(trace_decision_names(traced.trace))}",
        "denial_ok=${show(denial_ok)}"
      ])
    },
    Err(e) => Err({ failed_invariant: "approval default deny succeeds", trace: ["${e.code}:${e.message}"] })
  }
}

func traced_approval_default_deny_scenario() -> Scenario {
  { id: "phase_c.c2.traced_approval_default_deny", seed: "fixed", run: scenario_traced_approval_default_deny }
}

func has_stage_passed(records: [LedgerRecord]) -> bool {
  match records {
    [] => false,
    r :: rest =>
      match r {
        CompactionStageRecord(s) =>
          match s.outcome {
            TraceStagePassed => true,
            _ => has_stage_passed(rest)
          },
        _ => has_stage_passed(rest)
      }
  }
}

func has_stage_applied(records: [LedgerRecord]) -> bool {
  match records {
    [] => false,
    r :: rest =>
      match r {
        CompactionStageRecord(s) =>
          match s.outcome {
            TraceStageApplied(_) => true,
            _ => has_stage_applied(rest)
          },
        _ => has_stage_applied(rest)
      }
  }
}

func has_stage_rejected(records: [LedgerRecord]) -> bool {
  match records {
    [] => false,
    r :: rest =>
      match r {
        CompactionStageRecord(s) =>
          match s.outcome {
            TraceStageRejected(_) => true,
            _ => has_stage_rejected(rest)
          },
        _ => has_stage_rejected(rest)
      }
  }
}

func stage_tag(r: LedgerRecord) -> string {
  match r {
    CompactionStageRecord(s) =>
      match s.outcome {
        TraceStagePassed => "${s.ext_id}:pass",
        TraceStageApplied(_) => "${s.ext_id}:apply",
        TraceStageRejected(_) => "${s.ext_id}:reject"
        ,TraceStageObserved(_, _) => "${s.ext_id}:observe"
      },
    _ => ""
  }
}

func stage_order_matches(records: [LedgerRecord], expected: [string]) -> bool {
  match records {
    [] => match expected { [] => true, _ => false },
    r :: rest =>
      match r {
        CompactionStageRecord(_) =>
          match expected {
            [] => false,
            e :: es => stage_tag(r) == e && stage_order_matches(rest, es)
          },
        _ => stage_order_matches(rest, expected)
      }
  }
}

func scenario_traced_stage_records() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted(stage_rt(), [prose_step("done")]);
  match traced.result {
    Ok(_) => {
      let ok = has_stage_passed(traced.trace.records) && has_stage_applied(traced.trace.records) && has_stage_rejected(traced.trace.records);
      ok_or_failure(ok, "stage records include pass/apply/reject", ["records=${show(length(traced.trace.records))}"])
    },
    Err(e) => Err({ failed_invariant: "stage run succeeds", trace: ["${e.code}:${e.message}"] })
  }
}

func traced_stage_records_scenario() -> Scenario {
  { id: "phase_c.c2.traced_stage_records", seed: "fixed", run: scenario_traced_stage_records }
}

func scenario_compactor_chain_order_is_registry_order() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted(stage_rt(), [prose_step("done")]);
  match traced.result {
    Ok(_) => {
      let expected = ["stage-pass:pass", "stage-apply:apply", "stage-reject:reject"];
      ok_or_failure(stage_order_matches(traced.trace.records, expected), "compactor chain order is registry order", [
        "expected=${join_names(expected)}",
        "records=${show(length(traced.trace.records))}"
      ])
    },
    Err(e) => Err({ failed_invariant: "stage order run succeeds", trace: ["${e.code}:${e.message}"] })
  }
}

func compactor_chain_order_is_registry_order_scenario() -> Scenario {
  { id: "phase_c.c2.compactor_chain_order_is_registry_order", seed: "fixed", run: scenario_compactor_chain_order_is_registry_order }
}

func has_empty_stop_finalize(records: [LedgerRecord]) -> bool {
  match records {
    [] => false,
    r :: rest =>
      match r {
        WireRecord(event) =>
          match event {
            EmptyStopFinalize(_) => true,
            _ => has_empty_stop_finalize(rest)
          },
        _ => has_empty_stop_finalize(rest)
      }
  }
}

func assert_has_empty_stop_finalize(trace: LedgerTrace, invariant_name: string) -> Result[(), ScenarioFailure] {
  ok_or_failure(has_empty_stop_finalize(trace.records), invariant_name, [
    "records=${show(length(trace.records))}",
    "decisions=${join_names(trace_decision_names(trace))}"
  ])
}

func scenario_empty_stop_guard_loops_within_budget() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted(guard_rt(), [prose_step(""), prose_step("done")]);
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "InjectUserMessage", "CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "empty stop guard loops within budget", trace: ["${e.code}:${e.message}"] })
  }
}

func empty_stop_guard_loops_within_budget_scenario() -> Scenario {
  { id: "phase_c.c2.empty_stop_guard_loops_within_budget", seed: "fixed", run: scenario_empty_stop_guard_loops_within_budget }
}

func scenario_empty_stop_guard_budget_exhaustion_floors() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted(guard_rt(), [prose_step(""), prose_step(""), prose_step("")]);
  match traced.result {
    Ok(_) => {
      match assert_decisions(traced.trace, ["CallModel", "InjectUserMessage", "CallModel", "InjectUserMessage", "CallModel", "Finalize"]) {
        Err(f) => Err(f),
        Ok(_) => assert_has_empty_stop_finalize(traced.trace, "empty stop floor after guard budget exhaustion")
      }
    },
    Err(e) => Err({ failed_invariant: "empty stop guard budget exhaustion run succeeds", trace: ["${e.code}:${e.message}"] })
  }
}

func empty_stop_guard_budget_exhaustion_floors_scenario() -> Scenario {
  { id: "phase_c.c2.empty_stop_guard_budget_exhaustion_floors", seed: "fixed", run: scenario_empty_stop_guard_budget_exhaustion_floors }
}

func scenario_empty_stop_floor_without_guard() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted(empty_rt(), [prose_step("")]);
  match traced.result {
    Ok(_) => {
      match assert_decisions(traced.trace, ["CallModel", "Finalize"]) {
        Err(f) => Err(f),
        Ok(_) => assert_has_empty_stop_finalize(traced.trace, "empty stop floor without guard")
      }
    },
    Err(e) => Err({ failed_invariant: "empty stop floor without guard run succeeds", trace: ["${e.code}:${e.message}"] })
  }
}

func empty_stop_floor_without_guard_scenario() -> Scenario {
  { id: "phase_c.c2.empty_stop_floor_without_guard", seed: "fixed", run: scenario_empty_stop_floor_without_guard }
}

-- 1. Catches the latest live failure shape: a non-empty stop that self-reports
--    "Continuing Phase 52" against an explicit progress contract, then finalizes on
--    a genuine completion.
func scenario_progress_contract_catches_failure_shape() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted_task(pc_guard_rt(), pc_contract_task(), [
    prose_step(pc_failure_candidate()),
    prose_step("Reached 200/200. Final summary: all phases complete.")
  ]);
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "InjectUserMessage", "CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "progress contract catches failure shape", trace: ["${e.code}:${e.message}"] })
  }
}

func progress_contract_catches_failure_shape_scenario() -> Scenario {
  { id: "phase_c.c2.progress_contract_catches_failure_shape", seed: "fixed", run: scenario_progress_contract_catches_failure_shape }
}

-- 2. Budget exhaustion: the same self-contradictory candidate three times. Budget 2
--    injects twice, then NoDecision finalizes on the non-empty candidate. No core
--    floor event is required.
func scenario_progress_contract_budget_exhaustion_finalizes() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted_task(pc_guard_rt(), pc_contract_task(), [
    prose_step(pc_failure_candidate()),
    prose_step(pc_failure_candidate()),
    prose_step(pc_failure_candidate())
  ]);
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "InjectUserMessage", "CallModel", "InjectUserMessage", "CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "progress contract budget exhaustion finalizes", trace: ["${e.code}:${e.message}"] })
  }
}

func progress_contract_budget_exhaustion_finalizes_scenario() -> Scenario {
  { id: "phase_c.c2.progress_contract_budget_exhaustion_finalizes", seed: "fixed", run: scenario_progress_contract_budget_exhaustion_finalizes }
}

-- 3a. Blank candidate is not the progress guard's business: it returns NoDecision, so
--     the core empty-stop floor still fires and the run finalizes without looping.
func scenario_progress_contract_ignores_blank() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted_task(pc_guard_rt(), pc_contract_task(), [prose_step("")]);
  match traced.result {
    Ok(_) => {
      match assert_decisions(traced.trace, ["CallModel", "Finalize"]) {
        Err(f) => Err(f),
        Ok(_) => assert_has_empty_stop_finalize(traced.trace, "progress guard leaves blank to empty-stop floor")
      }
    },
    Err(e) => Err({ failed_invariant: "progress contract ignores blank run succeeds", trace: ["${e.code}:${e.message}"] })
  }
}

func progress_contract_ignores_blank_scenario() -> Scenario {
  { id: "phase_c.c2.progress_contract_ignores_blank", seed: "fixed", run: scenario_progress_contract_ignores_blank }
}

-- 3b. Combined chain (empty_stop_guard before progress_contract_guard): a blank stop
--     is owned by the empty-stop guard, which injects feedback and loops.
func scenario_progress_contract_combined_chain_blank_owned_by_empty_stop() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted_task(combined_guard_rt(), pc_contract_task(), [prose_step(""), prose_step("done")]);
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "InjectUserMessage", "CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "combined chain blank owned by empty stop", trace: ["${e.code}:${e.message}"] })
  }
}

func progress_contract_combined_chain_blank_owned_by_empty_stop_scenario() -> Scenario {
  { id: "phase_c.c2.progress_contract_combined_chain_blank_owned_by_empty_stop", seed: "fixed", run: scenario_progress_contract_combined_chain_blank_owned_by_empty_stop }
}

-- 4. Legitimate completion passes: an explicit "Reached 200/200" finalizes immediately.
func scenario_progress_contract_completion_passes() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted_task(pc_guard_rt(), pc_contract_task(), [
    prose_step("Reached 200/200. Final summary: all phases complete.")
  ]);
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "progress contract completion passes", trace: ["${e.code}:${e.message}"] })
  }
}

func progress_contract_completion_passes_scenario() -> Scenario {
  { id: "phase_c.c2.progress_contract_completion_passes", seed: "fixed", run: scenario_progress_contract_completion_passes }
}

-- 5. Allowed compaction stop passes: the task permits stopping on runtime compaction,
--    so a candidate that reports it finalizes even though it also says "Continuing".
func scenario_progress_contract_allowed_compaction_passes() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted_task(pc_guard_rt(), pc_compaction_task(), [
    prose_step("Runtime compaction occurred. Continuing is unnecessary. Final summary: state saved.")
  ]);
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "progress contract allowed compaction passes", trace: ["${e.code}:${e.message}"] })
  }
}

func progress_contract_allowed_compaction_passes_scenario() -> Scenario {
  { id: "phase_c.c2.progress_contract_allowed_compaction_passes", seed: "fixed", run: scenario_progress_contract_allowed_compaction_passes }
}

-- 6. No explicit progress contract: "continuing" in ordinary prose must not trigger.
func scenario_progress_contract_no_contract_passes() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted_task(pc_guard_rt(), "Write a short poem.", [
    prose_step("Continuing to refine the poem. Step 1/3.")
  ]);
  match traced.result {
    Ok(_) => assert_decisions(traced.trace, ["CallModel", "Finalize"]),
    Err(e) => Err({ failed_invariant: "progress contract no contract passes", trace: ["${e.code}:${e.message}"] })
  }
}

func progress_contract_no_contract_passes_scenario() -> Scenario {
  { id: "phase_c.c2.progress_contract_no_contract_passes", seed: "fixed", run: scenario_progress_contract_no_contract_passes }
}

func scenario_decision_record_append_name_round_trip() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let trace = ledger_append(empty_ledger_trace(), DecisionRecord({ step: 2, decision: "CallModel" }));
  match trace.records {
    record :: [] => {
      let ok = ledger_record_name(record) == "decision"
        && match record {
          DecisionRecord(r) => r.step == 2 && r.decision == "CallModel",
          _ => false
        };
      ok_or_failure(ok, "decision record append/name round-trip", [
        "record_name=${ledger_record_name(record)}"
      ])
    },
    _ => Err({ failed_invariant: "single decision record appended", trace: ["record_count=${show(length(trace.records))}"] })
  }
}

func decision_record_append_name_round_trip_scenario() -> Scenario {
  { id: "phase_c.c2.decision_record_append_name_round_trip", seed: "fixed", run: scenario_decision_record_append_name_round_trip }
}

-- WI-A1 acceptance, REVISED AT WI-C3 BECAUSE ITS OWN TRIPWIRE FIRED.
--
-- The original scenario asserted `emission_count == 0` and carried this
-- sentence: "if this scenario ever starts failing on the emptiness clause,
-- something began populating the log and the behaviour-preserving claim needs
-- re-checking." WI-C3 populated it, this row went red on the first `make dst`
-- after, and that is the tripwire working rather than a scenario to relax. It
-- is recorded here rather than quietly rewritten, because a pin that is edited
-- to match whatever the code now does is not a pin.
--
-- WHAT THE ROW ASSERTS NOW, and it is strictly stronger than the emptiness it
-- replaces: the scripted exchange reports EXACTLY the chunks it played. The
-- script's step is a chunked one, so `play_chunks` fires the callback twice
-- during the call; before WI-C3 both were delivered and neither appeared in
-- `exchange.emissions`, which was the same loss channel `live_ports` had one
-- layer up and which made every seeded run produce a witness of zero against a
-- trace of N. The count is derived from the fixture rather than written as a
-- literal, so the two cannot drift.
func scenario_scripted_exchange_reports_the_chunks_it_played() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let base = [msg("system", "s"), msg("user", "u")];
  let ports = scripted_ports();
  let played = ["chunk-a", "chunk-b"];
  let state = scripted_world_state([chunked_prose_step("done", played)]);
  let swallow = func(_c: StreamChunk) -> () ! {IO} { () };
  let exchange = ports.model_step(state, "phase-c-model", base, swallow);
  let emission_count = length(exchange.emissions);
  let served = match exchange.result {
    Ok(r) => r.message.content,
    Err(e) => "err:${e.code}"
  };
  ok_or_failure(emission_count == length(played) && emission_count > 0 && served == "done",
    "scripted exchange reports exactly the chunks it played", [
    "emission_count=${show(emission_count)}",
    "played=${show(length(played))}",
    "served=${served}"
  ])
}

func scripted_exchange_reports_played_chunks_scenario() -> Scenario {
  { id: "phase_c.c2.scripted_exchange_reports_the_chunks_it_played", seed: "fixed", run: scenario_scripted_exchange_reports_the_chunks_it_played }
}

-- ============================================================================
-- ADR-003 D2 ACCEPTANCE, RED FIRST (PLAN-003 v3.1, P1 Part 1).
--
-- WHAT THIS ROW IS FOR. A run that reaches its step budget must stop being an
-- internal error whose history dies in the driver's `Fail` arm and become a
-- typed suspension that carries the loop state out of the run. This is the
-- in-memory half of that, asserted DIRECTLY ON THE RETURNED VALUE: the fold
-- over a journal is P3's, and a fixture that went through it would be testing
-- the fold rather than the suspension.
--
-- IT IS RED ON PURPOSE AT THIS COMMIT. P1 Part 1 lands the acceptance test
-- before the code, so the four `suspended` / `final` checks below and the
-- `run_suspended` ledger check fail here and go green with P1 Part 4. Every
-- other check in the row is green today and must STAY green: they are what
-- says the change is a widening rather than a rewrite.
--
-- THE TWO SHIMS, AND WHY THEY EXIST. `TracedSessionResult` has no `suspended`
-- and no `final` field at this commit (`session.ail:175–180`), so the target
-- assertions cannot name them and still compile — and a file that does not
-- compile takes the other eighteen scenarios and `ailang check` down with it,
-- which is not what "red" is supposed to buy. `suspended_view` and
-- `final_history` are therefore the ONE line each that P1 Part 4 rewrites:
--
--   suspended_view -> match traced.suspended {
--                       Some(c) => Some({ history: c.history,
--                                         provider_calls_completed: c.cumulative.provider_calls_completed,
--                                         step_idx: c.step_idx }),
--                       None => None }
--   final_history  -> traced.final.history
--
-- Nothing else in this scenario changes when the fields land. The assertions
-- ARE the specification; the shims are the missing accessor, and they return
-- what the driver hands back today: no continuation and no history, which is
-- exactly the loss ADR-003 is about.
--
-- THE SCRIPT AND THE ARITHMETIC. `step_budget` is 3 and every scripted step is
-- a CONTINUING one — `continuing_token_step` (`stub_step.ail:771–781`), one
-- `BashExec` call with `finish_reason: "tool_calls"`. A plain assistant reply
-- would finalize at the first step (a `stop` finish reason goes straight to
-- `Finalize`, `step_machine.ail:128–129`) and the budget would never be
-- reached. `scenario_max_steps` (`terminal_trace_dst.ail:127–134`) is the
-- precedent, with a budget of 2. Each continuing step appends an assistant
-- message AND a tool result (denied by `deny_all_rt`, still a tool-role
-- message), so from the seed of system+user:
--
--   step 0: payload 2 -> history 4      step 1: payload 4 -> history 6
--   step 2: payload 6 -> history 8      step 3: budget reached, no call
--
-- 8 is the number pinned at first green, and the two payload checks below
-- corroborate it FROM THE WIRE at this commit — `provider_call_prepared` is
-- emitted three times and its last `msg_count` is 6 — so the pin is derived
-- rather than guessed. `provider_calls_completed == 3` and `step_idx == 3`
-- are the same three steps counted the other two ways.
-- ============================================================================

-- The third runner. `run_scripted` hardcodes `step_budget` 8 and
-- `run_scripted_task` varies the task; this one varies the budget, which is
-- the only knob the suspension needs.
func run_scripted_with_budget(rt: ExtRuntime, step_budget: int, script: [ScriptedStep]) -> TracedSessionResult ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(rt, "task", "", false, budget(), "phase-c-model", history(), ".", step_budget, false, 0, zero_rates(), Scripted(script))
}

-- Five steps against a budget of three: the BUDGET ends the run, not the
-- script running out, which is a different terminal path.
func continuing_script() -> [ScriptedStep] {
  [
    continuing_token_step(100, 50, "tc1"),
    continuing_token_step(100, 50, "tc2"),
    continuing_token_step(100, 50, "tc3"),
    continuing_token_step(100, 50, "tc4"),
    continuing_token_step(100, 50, "tc5")
  ]
}

-- P1 Part 4 REPLACES THIS BODY (see the header). Until then the driver returns
-- no continuation, which is what makes the four target checks red.
func suspended_view(_traced: TracedSessionResult) -> Option[{ history: [Message], provider_calls_completed: int, step_idx: int }] {
  None
}

-- P1 Part 4 REPLACES THIS BODY with `traced.final.history`. Today the `Err`
-- arm of `traced.result` carries an `AIError` and nothing else, so there is no
-- history to return: D4's projection does not exist yet.
func final_history(_traced: TracedSessionResult) -> [Message] {
  []
}

-- The wire name of any `LedgerEvent`, including ones that do not exist yet:
-- every arm of `to_schema_v1_kvs` leads with `kv("type", js(...))`
-- (`phase_vocab.ail:789–826`), so this reads `RunSuspended` correctly the day
-- the variant lands, with no edit here. Same shape as the driver's own
-- `event_type_from_projected` (`session.ail:315–325`).
func event_wire_name(e: LedgerEvent) -> string {
  match to_schema_v1_kvs(e) {
    [] => "",
    x :: _ => match x.value { JString(s) => s, _ => "" }
  }
}

func record_wire_name(r: LedgerRecord) -> string {
  match r {
    WireRecord(e) => event_wire_name(e),
    _ => ledger_record_name(r)
  }
}

-- The record immediately before the RunSummary. D2 puts `RunSuspended` there
-- and nothing after the summary, which is `RecordAfterTerminal`'s clause
-- (`dst_invariants.ail:788–796`) asserted here on the value.
func name_before_summary(records: [LedgerRecord], prev: string) -> string {
  match records {
    [] => "<no summary>",
    r :: rest => if is_run_summary(r) then prev else name_before_summary(rest, record_wire_name(r))
  }
}

func records_after_summary(records: [LedgerRecord], seen: bool, acc: int) -> int {
  match records {
    [] => acc,
    r :: rest => records_after_summary(rest, seen || is_run_summary(r), if seen then acc + 1 else acc)
  }
}

func count_wire_named(records: [LedgerRecord], name: string) -> int {
  match records {
    [] => 0,
    r :: rest => (if record_wire_name(r) == name then 1 else 0) + count_wire_named(rest, name)
  }
}

func prepared_msg_count(r: LedgerRecord, fallback: int) -> int {
  match r {
    WireRecord(e) =>
      match e {
        ProviderCallPrepared(i) => i.msg_count,
        _ => fallback
      },
    _ => fallback
  }
}

func last_prepared_msg_count(records: [LedgerRecord], acc: int) -> int {
  match records {
    [] => acc,
    r :: rest => last_prepared_msg_count(rest, prepared_msg_count(r, acc))
  }
}

func record_summary_error(r: LedgerRecord) -> Option[string] {
  match r {
    WireRecord(e) =>
      match e {
        RunSummary(i) => Some(i.error),
        _ => None
      },
    _ => None
  }
}

func summary_error_of(records: [LedgerRecord]) -> string {
  match records {
    [] => "<no summary>",
    r :: rest =>
      match record_summary_error(r) {
        Some(err) => err,
        None => summary_error_of(rest)
      }
  }
}

func count_error_emissions(events: [LedgerEvent]) -> int {
  match events {
    [] => 0,
    e :: rest => (if event_wire_name(e) == "error" then 1 else 0) + count_error_emissions(rest)
  }
}

func message_equal(a: Message, b: Message) -> bool {
  a.role == b.role && a.content == b.content && a.tool_call_id == b.tool_call_id
    && length(a.tool_calls) == length(b.tool_calls)
}

func messages_equal(a: [Message], b: [Message]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs => match b { y :: ys => message_equal(x, y) && messages_equal(xs, ys), [] => false }
  }
}

-- One row, many clauses: report EVERY failing clause rather than the first, so
-- the red output is the whole delta between today and D2 and not a bisect.
func failed_clauses(cs: [{ name: string, ok: bool, detail: string }]) -> [string] {
  match cs {
    [] => [],
    c :: rest => (if c.ok then [] else ["${c.name} ${c.detail}"]) ++ failed_clauses(rest)
  }
}

func failed_or_ok(cs: [{ name: string, ok: bool, detail: string }]) -> Result[(), ScenarioFailure] {
  let bad = failed_clauses(cs);
  match bad {
    [] => Ok(()),
    _ => Err({ failed_invariant: "step budget suspends with the run's history", trace: bad })
  }
}

func scenario_step_budget_suspends_with_history() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace, Rand} {
  let traced = run_scripted_with_budget(deny_all_rt(), 3, continuing_script());

  let outcome_err = match traced.result { Ok(_) => false, Err(_) => true };
  let code = match traced.result { Ok(_) => "<ok>", Err(e) => e.code };
  let returned_history = match traced.result { Ok(h) => length(h), Err(_) => -1 };
  let reason = match run_summary_finish_reason(traced.trace) {
    Some(r) => r,
    None => "<none>"
  };
  let summary_err = summary_error_of(traced.trace.records);
  let prepared = count_wire_named(traced.trace.records, "provider_call_prepared");
  let last_payload = last_prepared_msg_count(traced.trace.records, -1);
  let before_summary = name_before_summary(traced.trace.records, "<start>");
  let trailing = records_after_summary(traced.trace.records, false, 0);
  let error_emissions = count_error_emissions(traced.emissions);

  let view = suspended_view(traced);
  let hist_len = match view { Some(s) => length(s.history), None => -1 };
  let calls_completed = match view { Some(s) => s.provider_calls_completed, None => -1 };
  let step_idx = match view { Some(s) => s.step_idx, None => -1 };
  let final_matches = match view {
    Some(s) => messages_equal(final_history(traced), s.history),
    None => false
  };

  failed_or_ok([
    -- Today's behaviour. Green here, and each one still green after D2 lands:
    -- the suspension keeps the outcome, the reason and the summary it has.
    { name: "outcome is Err", ok: outcome_err, detail: "(result=${code})" },
    -- P1 Part 2 REWROTE THIS LITERAL from "Internal" (ADR-003 D2 item 1): the
    -- code is the discriminator now, not the message. Named in Part 1 so the
    -- edit was a decision someone makes, not a red row someone relaxes.
    { name: "Err code is StepBudgetExhausted", ok: code == "StepBudgetExhausted", detail: "(code=${code})" },
    { name: "run_summary finish_reason is max_steps", ok: reason == "max_steps", detail: "(reason=${reason})" },
    { name: "the Err arm carries no history", ok: returned_history == -1, detail: "(returned=${show(returned_history)})" },
    { name: "run_summary.error is non-empty", ok: summary_err != "", detail: "(error='${summary_err}')" },
    { name: "outcome agrees with the summary", ok: outcome_err && summary_err != "", detail: "(err=${show(outcome_err)} summary_error='${summary_err}')" },
    { name: "nothing after the run_summary", ok: trailing == 0, detail: "(trailing=${show(trailing)})" },
    { name: "no error event in emissions", ok: error_emissions == 0, detail: "(errors=${show(error_emissions)})" },
    -- The wire-side corroboration of the 8 below: three payloads, the last of
    -- them 6 messages, so the run ended holding 6 + assistant + tool result.
    { name: "three provider calls prepared", ok: prepared == 3, detail: "(prepared=${show(prepared)})" },
    { name: "last payload is 6 messages", ok: last_payload == 6, detail: "(msg_count=${show(last_payload)})" },
    -- RED UNTIL P1 Part 4. ADR-003 D2's suspension, D4's projection.
    { name: "RED-UNTIL-P4 suspended history is 8", ok: hist_len == 8, detail: "(history=${show(hist_len)}, -1 = no continuation)" },
    { name: "RED-UNTIL-P4 cumulative provider_calls_completed is 3", ok: calls_completed == 3, detail: "(completed=${show(calls_completed)})" },
    { name: "RED-UNTIL-P4 step_idx is 3", ok: step_idx == 3, detail: "(step_idx=${show(step_idx)})" },
    { name: "RED-UNTIL-P4 final.history equals suspended.history", ok: final_matches, detail: "(final=${show(length(final_history(traced)))} suspended=${show(hist_len)})" },
    { name: "RED-UNTIL-P4 run_suspended immediately precedes run_summary", ok: before_summary == "run_suspended", detail: "(before_summary=${before_summary})" }
  ])
}

func step_budget_suspends_with_history_scenario() -> Scenario {
  { id: "phase_c.c2.step_budget_suspends_with_history", seed: "fixed", run: scenario_step_budget_suspends_with_history }
}

export func main() -> () ! {IO, AI, Clock, Env, FS, Net, Process, SharedMem, Stream, Trace} {
  let scenarios = [
    decision_record_append_name_round_trip_scenario(),
    scripted_exchange_reports_played_chunks_scenario(),
    traced_prose_decisions_scenario(),
    traced_tool_decisions_scenario(),
	    tool_call_with_stop_finish_still_runs_scenario(),
	    traced_persist_nudge_decisions_scenario(),
	    traced_approval_default_deny_scenario(),
	    traced_stage_records_scenario(),
	    compactor_chain_order_is_registry_order_scenario(),
	    empty_stop_guard_loops_within_budget_scenario(),
	    empty_stop_guard_budget_exhaustion_floors_scenario(),
	    empty_stop_floor_without_guard_scenario(),
	    progress_contract_catches_failure_shape_scenario(),
	    progress_contract_budget_exhaustion_finalizes_scenario(),
	    progress_contract_ignores_blank_scenario(),
	    progress_contract_combined_chain_blank_owned_by_empty_stop_scenario(),
	    progress_contract_completion_passes_scenario(),
	    progress_contract_allowed_compaction_passes_scenario(),
	    progress_contract_no_contract_passes_scenario(),
	    step_budget_suspends_with_history_scenario()
	  ];
  let failed = run_all(scenarios, 0);
  if failed == 0 then
    println("phase_c2_wiring_scenarios PASS count=${show(length(scenarios))}")
  else {
    let _ = println("phase_c2_wiring_scenarios FAIL failed=${show(failed)}");
    exit(1)
  }
}
