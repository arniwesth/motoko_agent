-- ---------------------------------------------------------------------------
-- The scripted herdr, as the world serves it
-- ---------------------------------------------------------------------------
--
-- `ext_effects` is served IN ORDER and never matched against argv
-- (`ports.world_ext_effect`), so this list is the exact call sequence a
-- successful claude `Delegate` makes, and a wrong order is a wrong test rather
-- than a failure. Read off `herdr.do_delegate` at HEAD:
--
--   1 pane split          2 agent start      3 agent explain
--   4 agent get           5 agent prompt     6 pane report-metadata
--   7 dagr check          8 mv
--
-- STEP 4 IS NEW TODAY and is exactly the kind of thing this spike is for: the
-- retry's baseline read (`prompt_with_retry`) added a call between the readiness
-- gate and the prompt. A fixture written against last week's code would serve
-- the prompt's answer to the `agent get` and desynchronise everything after it.
--
-- THE TRAILING SLACK ENTRY IS LOAD-BEARING, for `driver_plus_compose_dst`'s
-- reason: an EMPTY queue does not fail, it falls through to a REAL exec — which
-- in this container would spawn the live herdr against the operator's own
-- panes. Sized one longer than the expectation so an off-by-one is a wrong
-- answer rather than a real subprocess.
func bash_envelope(stdout: string) -> string {
  "{\"tool\":\"BashExec\",\"cmd\":\"herdr\",\"exit_code\":0,\"stdout\":\"${stdout}\",\"stderr\":\"\",\"truncated\":false}"
}

func eff(duration_ms: int, exit_code: int, stdout: string)
  -> { tool_call_id: string, duration_ms: int, code: string, message: string, content: string, exit_code: int } {
  { tool_call_id: "", duration_ms: duration_ms, code: "", message: "",
    content: bash_envelope(stdout), exit_code: exit_code }
}

-- Durations 101..113 and codes 127/131: distinct from every queue constant in
-- the tree (S7), which uses 41…61, 43/47/53/59 and 79/83.
func herdr_effects() -> [{ tool_call_id: string, duration_ms: int, code: string, message: string, content: string, exit_code: int }] {
  [ -- 0. THE STARTUP SWEEP, and missing it is what this spike caught. `sweep_once`
    --    runs on the FIRST tool call, before `do_delegate` does anything, and
    --    issues `pane list`. A fixture that starts at the split serves the
    --    split's answer to the sweep and desynchronises every entry after it —
    --    which is precisely the failure mode `ext_effects` being served IN ORDER
    --    rather than matched by argv makes possible.
    eff(97, 127, "{\\\"result\\\":{\\\"panes\\\":[{\\\"pane_id\\\":\\\"w9:p0\\\"}]}}"),
    -- 1. pane split -> a pane id
    eff(101, 127, "{\\\"result\\\":{\\\"pane\\\":{\\\"pane_id\\\":\\\"w9:pS\\\"},\\\"type\\\":\\\"pane_info\\\"}}"),
    -- 2. agent start
    eff(103, 127, "{\\\"result\\\":{}}"),
    -- 3. agent explain -> READY (the rule id `explain_says_ready` looks for)
    eff(107, 127, "{\\\"agent\\\":\\\"claude\\\",\\\"matched_rule\\\":{\\\"id\\\":\\\"live_prompt_box\\\",\\\"state\\\":\\\"idle\\\"},\\\"state\\\":\\\"idle\\\"}"),
    -- 4. agent get -> the retry's baseline status
    eff(109, 127, "{\\\"result\\\":{\\\"agent\\\":{\\\"agent_status\\\":\\\"idle\\\",\\\"pane_id\\\":\\\"w9:pS\\\"}}}"),
    -- 5. agent prompt -> accepted
    eff(113, 127, "{\\\"result\\\":{}}"),
    -- 6. pane report-metadata (the mot-owner tag)
    eff(127, 127, "{\\\"result\\\":{}}"),
    -- 7. THE PUBLISH'S `dagr check --strict` on the candidate. Added when the
    --    producer gained step 2 of the skill's transaction; before that the
    --    publish went straight to `mv`. Exit 0 in the envelope = clean, so the
    --    rename below happens.
    eff(131, 127, ""),
    -- 8. dagr publish's `mv`
    eff(137, 127, ""),
    -- SLACK: never consumed if the sequence above is right.
    eff(139, 131, "{\\\"slack\\\":true}")]
}

func delegate_call() -> ToolCall {
  { id: "tc-spike-1", name: "Delegate",
    arguments: "{\"prompt\":\"do a small thing\",\"kind\":\"claude\",\"task_kind\":\"impl\"}" }
}

func tool_step(tc: ToolCall) -> ScriptedStep {
  { prose: "", tool_calls: [tc], input_tokens: 1, output_tokens: 1,
    finish_reason: "tool_calls", chunks: [], error_code: "", error_message: "",
    advance_ms: 0 }
}

func spike_script() -> [ScriptedStep] {
  [tool_step(delegate_call()), prose_step("done")]
}

func msg(role: string, content: string) -> Message {
  { role: role, content: content, tool_calls: [], tool_call_id: "", images: [] }
}

func history() -> [Message] { [msg("system", "s"), msg("user", "delegate something")] }
func budget() -> BudgetPlan { { total: 10, solver: 6, verifier: 4 } }
func zero_rates() -> CostRates { { input_per_1m_millicents: 0, output_per_1m_millicents: 0 } }

func world_env() -> [{ key: string, value: string }] {
  [{ key: "MOTOKO_TOOL_TIMEOUT_MS", value: "5000" },
   { key: "MOTOKO_HEADLESS", value: "1" }]
}

func graded_world() -> WorldState {
  { empty_world_state() |
    script: spike_script(),
    approvals: [],
    env: world_env(),
    ext_effects: herdr_effects() }
}

-- The real registration, wholesale. `register_with_config` reads HERDR_ENV,
-- HERDR_BIN_PATH and HERDR_PANE_ID from the PROCESS environment — the ambient
-- registration read this profile would have to disclose exactly as compose
-- discloses its own — so the runner sets them.
func herdr_rt() -> ExtRuntime ! {Env, FS, AI, Clock, IO, Process, Rand} {
  let v: VerificationConfig = { enabled: false, command: "" };
  { registry: { entries: [{ id: "herdr", caps: Herdr.register_with_config(()) }] },
    strict_mode: false, verification: v }
}

func run_graded(w: WorldState) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, SharedMem, Stream, Trace, Rand, Process} {
  Session.run_v2_session_traced(
    herdr_rt(), "spike", "", false, budget(), "phase-c-model", history(), ".",
    12, false, 0, zero_rates(), RecordingWorld(w)
  )
}

pure func result_msgs(r: TracedSessionResult) -> [Message] {
  match r.result { Ok(msgs) => msgs, Err(_) => [] }
}

pure func tool_texts(msgs: [Message]) -> [string] {
  match msgs {
    [] => [],
    m :: rest =>
      if m.role == "tool" then m.content :: tool_texts(rest) else tool_texts(rest)
  }
}

func show_each(xs: [string]) -> () ! {IO} {
  match xs { [] => (), x :: rest => { let _ = println("    | ${x}"); show_each(rest) } }
}

pure func any_contains(xs: [string], needle: string) -> bool {
  match xs { [] => false, x :: rest => if contains(x, needle) then true else any_contains(rest, needle) }
}


-- ---------------------------------------------------------------------------
-- The discovery chain: record -> grade -> validate -> reconstitute -> replay
-- ---------------------------------------------------------------------------
--
-- WHY THIS EXISTS AND WHY IT IS NOT OPTIONAL. `dst_profile.recognised_producers`
-- is a CLOSED set of five, and for herdr exactly one of them can carry a
-- `WorldMediated` entry. classifier 3 reports herdr AMBIENT (one source,
-- `register.ail:26 std/env.getEnvOr`), so it cannot clear criterion 2 whatever
-- that source is; classifier 2's own note says "never on its own for
-- WorldMediated"; `declared_row` is criterion 1 only and both of herdr's rowed
-- slots declare non-empty rows; `disclosure` is admissible for exclusions.
-- `discovery` is what is left, and it measures its clauses over a RECORDED,
-- VALIDATED, STRICTLY REPLAYED run. This is that run. A profile record naming
-- `discovery` without this chain would be a basis with nothing behind it.
--
-- AND THE PROFILE CANNOT DODGE IT: `work_in_flight[0]` is unconditionally
-- dispatched with a non-empty declared row, and D5 forbids installing an
-- extension with an unconditionally-dispatched hook excluded.

func report_discovery(fs: [DiscoveryFinding]) -> () ! {IO} {
  match fs { [] => (), f :: rest => { let _ = println("      ${discovery_message(f)}"); report_discovery(rest) } }
}
func report_program(rs: [ProgramRejection]) -> () ! {IO} {
  match rs { [] => (), r :: rest => { let _ = println("      ${program_message(r)}"); report_program(rest) } }
}
func report_recon(fs: [ReconstitutionFinding]) -> () ! {IO} {
  match fs { [] => (), f :: rest => { let _ = println("      ${reconstitution_message(f)}"); report_recon(rest) } }
}
func report_replay(ms: [ReplayMismatch]) -> () ! {IO} {
  match ms { [] => (), m :: rest => { let _ = println("      ${replay_message(m)}"); report_replay(rest) } }
}

pure func effect_origins(xs: [Interaction]) -> [string] {
  match xs {
    [] => [],
    i :: rest =>
      match i.identity.body {
        ExtensionEffectIdentity(_, _, _) => identity_origin(i.identity.body) :: effect_origins(rest),
        _ => effect_origins(rest)
      }
  }
}

pure func all_equal(xs: [string], v: string) -> bool {
  match xs { [] => true, x :: rest => x == v && all_equal(rest, v) }
}

pure func joins(xs: [string]) -> string {
  match xs { [] => "", x :: rest => match rest { [] => x, _ => "${x}, ${joins(rest)}" } }
}

func check(label: string, ok: bool, detail: string) -> bool ! {IO} {
  let _ = if ok then println("  ✓ ${label}") else println("  ✗ ${label} — ${detail}");
  ok
}

-- THE WITNESS, DERIVED FROM herdr'S CONTROL FLOW AND NOT FROM THE LOG. A
-- witness read off the recorder agrees with it by construction, which is the
-- failure `class_balance` exists to catch. Every count below is read off
-- `on_tool_handle`'s path for ONE `Delegate` with kind=claude, under this
-- target's configuration (dagr_pane off, sweep_stale off, sweep_settle off,
-- dagr_plan empty, reap_on_exit off):
--
--   sweep_once      dir_make(work_dir), file_write(sentinel), run_herdr(pane list)
--   do_delegate     dir_make(work_dir), file_write(task file),
--                   run_herdr x6: pane split, agent start, agent explain,
--                                 agent get (the retry baseline), agent prompt,
--                                 pane report-metadata
--   dagr_open       dir_make(dagr_dir), file_write(tmp),
--                   run_cmd(dagr check), run_cmd(mv),
--                   file_write(settled candidate)
--
-- so extension_effects = 9, dir_makes = 3, file_writes = 4, file_removes = 0.
--
-- `ensure_dagr_pane` contributes NOTHING and that is a configuration fact this
-- target pins: it early-outs on `cfg.dagr_pane == false` before any call.
--
-- tool_dispatches = 0. The model emits a native `Delegate`, but a ToolProvider
-- handles it — the driver's own tool phase is never reached, so no
-- `ToolIdentity` interaction is written. That zero is the shape of the thing
-- this profile is about: the dispatch went to an extension.
func graded_witness(clock_delta: int, resolutions: int) -> DiscoveryWitness {
  { provider_calls: 2,
    tool_dispatches: 0,
    approval_reads: 0,
    approvals_consumed: 0,
    clock_delta_ms: clock_delta,
    file_writes: 4,
    file_removes: 0,
    dir_makes: 3,
    extension_effects: 9,
    expected_env_reads: env_reads_always(resolutions) }
}

pure func env_reads_always(resolutions: int) -> [EnvExpectation] {
  [{ key: "MOTOKO_PERSIST_RETRIES",    count: 1 },
   { key: "MOTOKO_RETRY_STREAM_ERROR", count: 1 },
   { key: "OPENAI_BASE_URL",           count: 1 },
   { key: "MOTOKO_HEADLESS",           count: 1 },
   { key: "MOTOKO_SESSION_ID",         count: 1 }]
    ++ [{ key: "MOTOKO_PROFILE_DIR", count: resolutions },
        { key: "MOTOKO_CONFIG",      count: resolutions },
        { key: "MOTOKO_MODELS_FILE", count: resolutions },
        { key: "MOTOKO_REPO",        count: resolutions * 2 }]
}

func herdr_manifest() -> ExecutionManifest {
  { source_revision: "HEAD",
    toolchain: "ailang 0.33.0",
    extension_packages: [{ package_id: "sunholo/motoko_ext_herdr", version: "0.1.0" }],
    abi_version: "7.3",
    profile_id: "driver_plus_herdr",
    profile_version: "1",
    event_vocabulary_version: event_vocabulary_version(),
    normalized_configuration: "{}",
    classifier_2_set: ["env_get"],
    unrouted_fields: [],
    scan_roots: ["src/core", "packages/motoko-ext-herdr"],
    scan_root_commit: "HEAD",
    profile_rules_version: profile_rules_version(),
    coverage_rules_version: Cov.coverage_rules_version(),
    attribution_rules_version: Attr.attribution_rules_version(),
    fault_catalogue_version: fault_catalogue_version() }
}

pure func graded_program(w: WorldState, initial: WorldState) -> ExecutionProgram {
  {
    schema_version: program_schema_version(),
    generator_id: "hand_authored_herdr_demonstration",
    generator_version: "1",
    seed: 0,
    initial_world: {
      messages_and_policy: "{\"messages\":[\"system\",\"user\"],\"policy\":\"driver_plus_herdr\"}",
      synthetic_environment: initial.env,
      files: [],
      clock_epoch: initial.clock_ms,
      extension_profile: "driver_plus_herdr/1"
    },
    bounds: {
      max_interactions: 256,
      max_chunks_per_interaction: 16,
      max_payload_bytes: 4096,
      max_resource_size: 4096,
      max_clock_advance_ms: 60000,
      chunk_draw_hi: 3
    },
    manifest: herdr_manifest(),
    interactions: w.log
  }
}

-- The chain. Returns (ok, resolutions_used) so `main` can print one line.
func scenario_discovery(resolutions: int)
  -> bool ! {AI, Clock, Env, FS, IO, Net, SharedMem, Stream, Trace, Rand, Process} {
  let initial = graded_world();
  let run = run_graded(initial);
  let log = run.world.log;
  let effects = count_kind(log, identity_kind(ExtensionEffectIdentity("", "", "")));
  let origins = effect_origins(log);
  let _ = println("      census: ${census_line(census(log))}");

  let ok_ran = check("the graded session reached its terminator",
                     match run.result { Ok(_) => true, Err(_) => false },
                     "the run returned Err, so every witness below is vacuous");

  -- REACHABILITY BEFORE VERDICT (S24). A ToolProvider that never ran records
  -- nothing and asserts nothing.
  let ok_reached = check("herdr's routed seam RAN — nine scripted herdr calls reached the recorder",
                         effects == 9,
                         "extension effects=${show(effects)}, expected 9 — the call sequence changed, or a call escaped the ports");

  -- THE ASSERTION THE PROFILE RESTS ON. Criterion 2's first two clauses as a
  -- fact about the recorded program: an ExtensionEffect interaction exists (only
  -- the ExtPorts recording adapter writes that class, so an ambient call would
  -- leave none) and its origin is stamped by the fold in `ext/runtime.ail` —
  -- not by the hook, not by the recorder, not by this file.
  let ok_origin = check("NON-VACUITY: the program carries world-mediated effects ORIGIN-TAGGED to herdr",
                        List.length(origins) >= 1 && all_equal(origins, "herdr"),
                        "origins=[${joins(origins)}] — expected at least one, all \"herdr\"");

  let findings = check_discovery(log, graded_witness(run.world.clock_ms - initial.clock_ms, resolutions));
  let _ = if List.length(findings) > 0 then report_discovery(findings) else ();
  let ok_discovery = check("the DISCOVERY instrument grades the run clean in both directions",
                           List.length(findings) == 0,
                           "${show(List.length(findings))} finding(s); `discovery` is the only producer that can carry herdr's criterion-2 entries, so a finding here unmakes the record");

  let program = graded_program(run.world, initial);
  let rejections = validate_program(program, required_class_ids());
  let _ = if List.length(rejections) > 0 then report_program(rejections) else ();
  let ok_valid = check("the recorded program VALIDATES",
                       List.length(rejections) == 0,
                       "${show(List.length(rejections))} rejection(s)");

  match world_state_of(program, required_class_ids()) {
    Err(r) => {
      let _ = println("      ${refusal_message(r)}");
      let ok_recon = check("the program reconstitutes a world", false, "refused");
      ok_ran && ok_reached && ok_origin && ok_discovery && ok_valid && ok_recon
    },
    Ok(replay_world) => {
      -- NOTHING UNCONSUMED, NOTHING MISSING. An `ext_effects` queue short by one
      -- is not a quiet failure at this seam: the adapter DELEGATES, so a replay
      -- would perform a REAL herdr call against the operator's live panes.
      let recon = reconstitution_balance(program, replay_world);
      let _ = if List.length(recon) > 0 then report_recon(recon) else ();
      let ok_balance = check("the reconstituted world's queues balance against the log",
                             List.length(recon) == 0,
                             "${show(List.length(recon))} finding(s)");

      let replay = run_graded(replay_world);
      let ms = strict_replay_findings(program.interactions, replay.world.log);
      let _ = if List.length(ms) > 0 then report_replay(ms) else ();
      let ok_replay = check("the graded session REPLAYS to an identical interaction log",
                            List.length(ms) == 0,
                            "${show(List.length(ms))} mismatch(es)");

      -- The second half of the goal line's clause 1: "present in the recorded
      -- program AND reproduced by its replay". An identical log already implies
      -- it; asserting it by name means a future weakening of
      -- `strict_replay_findings` cannot take the clause down silently.
      let replay_origins = effect_origins(replay.world.log);
      let ok_replay_effect =
        check("NON-VACUITY, REPRODUCED: the replay records the same origin-tagged herdr effects",
              List.length(replay_origins) == List.length(origins)
                && all_equal(replay_origins, "herdr") && List.length(replay_origins) >= 1,
              "replay origins=[${joins(replay_origins)}] against recorded [${joins(origins)}]");

      let _ = println("CLAIM clause1 extension_effects=${show(effects)} origins=${show(List.length(origins))} replayed=${show(List.length(replay_origins))} mismatches=${show(List.length(ms))}");

      ok_ran && ok_reached && ok_origin && ok_discovery && ok_valid && ok_balance
        && ok_replay && ok_replay_effect
    }
  }
}

export func main() -> () ! {AI, Clock, Env, FS, IO, Net, SharedMem, Stream, Trace, Rand, Process} {
  let r = run_graded(graded_world());
  let msgs = result_msgs(r);
  let tools = tool_texts(msgs);
  let dispatched = List.length(tools) > 0;
  -- The delegation SUCCEEDED, not merely reached the hook: an error result also
  -- mentions the pane.
  let succeeded = any_contains(tools, "is running `claude` in pane w9:pS");
  -- THE ELAPSED FIGURE IS THE DETERMINISM ASSERTION. `0.6s` is
  -- 97+101+103+107+109+113 = 630ms of THIS FILE'S scripted durations, read back
  -- off the world clock through the extension's own two `clock_now` readings: a
  -- run that reached a real herdr could not produce it, and neither could one
  -- that consumed a different NUMBER of entries, since each is ~100ms.
  --
  -- ITS RESOLUTION IS A TENTH OF A SECOND, and that is measured rather than
  -- assumed: changing one duration by 1ms leaves this assertion green, because
  -- `format_ms` rounds. So it pins the COUNT and the ORDER of the queue, not the
  -- exact clock. Stated because the first version of this comment claimed more.
  let served = any_contains(tools, "Starting it took 0.6s");
  let _ = println("HERDR-GRADED: a ToolProvider dispatch reached the extension:      ${show(dispatched)}");
  let _ = println("HERDR-GRADED: the delegation completed against the scripted herdr: ${show(succeeded)}");
  let _ = println("HERDR-GRADED: elapsed is the scripted durations, so nothing ran:   ${show(served)}");
  let _ = println("  ---- the discovery chain ----");
  let disc = scenario_discovery(1);
  if dispatched && succeeded && served && disc then
    println("HERDR-GRADED: PASS — the ToolProvider path is reachable under DST, and the run is recorded, graded, validated and strictly replayed")
  else {
    let _ = println("HERDR-GRADED: FAIL — the call sequence desynchronised or an effect reached the live world");
    let _ = show_each(tools);
    exit(1)
  }
}
