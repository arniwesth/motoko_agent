-- ---------------------------------------------------------------------------
-- Fixtures
-- ---------------------------------------------------------------------------

func msg(role: string, content: string) -> Message {
  { role: role, content: content, tool_calls: [], tool_call_id: "", images: [] }
}

func history() -> [Message] { [msg("system", "s"), msg("user", "u")] }
func budget() -> BudgetPlan { { total: 10, solver: 6, verifier: 4 } }
func zero_rates() -> CostRates { { input_per_1m_millicents: 0, output_per_1m_millicents: 0 } }

func step_named(name: string) -> ScriptedStep {
  { tool_step("T", "{}", name) | prose: name }
}

-- Three continuers then a terminator. Three tool calls is deliberate: two would
-- let an off-by-one in the recorder agree with an off-by-one in the witness.
func script() -> [ScriptedStep] {
  [step_named("s0"), step_named("s1"), step_named("s2"), prose_step("done")]
}

func approve_line() -> string { "{\"type\":\"approve\"}" }
func deny_line(reason: string) -> string { "{\"type\":\"deny\",\"reason\":\"${reason}\"}" }

-- The synthetic environment. `MOTOKO_TOOL_TIMEOUT_MS` is present so the tool
-- deadline is configured by the world, and so the env class has at least one
-- key whose read is PRESENT rather than missing — a recorder that only ever
-- records `OutcomeMissing` would otherwise look correct.
func world_env() -> [{ key: string, value: string }] {
  [{ key: "MOTOKO_TOOL_TIMEOUT_MS", value: "5000" },
   { key: "MOTOKO_HEADLESS", value: "1" }]
}

-- WI-D22 added `exit_code`. The return type is written out structurally rather
-- than as `[ScriptedTool]`, so a field added to the record is a compile error
-- HERE rather than a silent shape mismatch at the call site — which is the
-- property that made this signature worth keeping when the field landed.
--
-- All three are -1 ("nothing said"): these tools do not run a process, and a 0
-- would assert that they did and succeeded.
func scripted_tools() -> [{ tool_call_id: string, duration_ms: int, code: string, message: string, content: string, exit_code: int }] {
  [{ tool_call_id: "", duration_ms: 7,  code: "", message: "", content: "OK-ALPHA",   exit_code: -1 },
   { tool_call_id: "", duration_ms: 11, code: "", message: "", content: "OK-BRAVO",   exit_code: -1 },
   { tool_call_id: "", duration_ms: 13, code: "", message: "", content: "OK-CHARLIE", exit_code: -1 }]
}

func base_world(answers: [string]) -> WorldState {
  { empty_world_state() |
    script: script(),
    approvals: answers,
    env: world_env(),
    tools: scripted_tools() }
}

-- ---------------------------------------------------------------------------
-- Extension plumbing: every tool call goes to the approval channel
-- ---------------------------------------------------------------------------

func no_describe() -> [ToolSchema] { [] }
func no_prompt(_ctx: ExtCtx) -> PromptPatch { { prepend: [], append: [] } }
func no_budget(_ctx: ExtCtx, _plan: BudgetPlan) -> BudgetPatch {
  { requested_total: None, requested_solver: None, requested_verifier: None }
}
func no_handle(ctx: ExtCtx, _call: ToolCallEnvelope)
  -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand}  { { decision: { Delegate }, next_state: ctx.world } }
func no_intercept(ctx: ExtCtx, _text: string)
  -> ResponseInterceptOutcome ! {IO, Process, FS, Clock}  { { decision: { NoIntercept }, next_state: ctx.world } }
func no_solver(ctx: ExtCtx, _text: string)
  -> FinalizeOutcome ! {Process}  { { decision: { NoDecision }, next_state: ctx.world } }

-- ---------------------------------------------------------------------------
-- WI-D19: THE ROUTED INTERCEPT, and why this scenario exists at all
-- ---------------------------------------------------------------------------
--
-- WI-D19 routed `motoko_ext_compose`'s `on_response_intercept` through
-- `ExtPorts`. That gave five seams their first CALLER, but it gave the
-- RECORDER nothing, because no graded profile in this tree installs compose —
-- C5's compose-bearing profile is still owed. Left there, the item would have
-- shipped a routing with no graded evidence and `absent_classes`' three pinned
-- classes would have stayed green for the wrong reason. The handoff's own words:
-- do not silence the tripwire by not grading the profile.
--
-- So this hook is compose's ROUTED CHAIN, in this scenario's registry, driven by
-- the same production dispatcher and the same `RecordingWorld` adapters. It is
-- the shape and not the extension — `compose.ail:769-785` in miniature:
--
--   dir_make("tmp") -> file_write("tmp/inline.ail") -> path_stat -> file_remove
--
-- ONE SPELLING FOR THE DIRECTORY AND THE FILE UNDER IT, which is WI-D18 §5's rule
-- and the defect WI-D19 fixed at compose's call site. A census cannot see that
-- rule — the three counts balance whether or not the two paths agree — so the
-- `dir_list` below is wired to GUARD the remove, which is what puts a path-key
-- failure into a count. Written `"/w/tmp"` here against `"tmp/inline.ail"` there,
-- the listing comes back empty, the remove never happens, and `file_remove`
-- balances 0 against a witnessed 4.
--
-- It returns `NoIntercept` so the driver's own loop is unchanged and every other
-- witness in this file keeps measuring what it measured before. The effects are
-- performed; only the decision is empty.
--
-- THE THREE CLASSES IT PRODUCES ARE EXACTLY THE THREE WI-D17 AND WI-D18 PINNED
-- AT ZERO. `path_stat` produces none, deliberately — it is a READ, and WI-D18 §6
-- decided reads are not recorded because `InitialWorld` cannot rebuild them.
-- That asymmetry is why the witness has three fields and not five.
func routing_intercept(ctx: ExtCtx, _text: string)
  -> ResponseInterceptOutcome ! {IO, Process, FS, Clock} {
  let p = ctx.ports;
  let made = p.dir_make(ctx.world, "tmp");
  let wrote = p.file_write(made.next_state, "tmp/inline.ail", "module tmp/inline\n");
  let stat = p.path_stat(wrote.next_state, "tmp/inline.ail");
  -- THE LISTING IS HERE FOR TWO REASONS AND NEITHER IS THE CENSUS, which cannot
  -- see it — `dir_list` is a READ and WI-D18 §6 decided reads are not recorded.
  --
  --   1. IT IS `ExtPorts.dir_list`'S FIRST EXECUTED CALLER. WI-D18 §7 listed the
  --      `session.ext_ports_of` bridge closure that derives `present` from the
  --      entry count as a mutant it could not run, because nothing in the tree
  --      called an `ExtPorts.dir_list` at all. This calls one, through the
  --      production bridge, so the mutant became runnable — and WI-D19 ran it.
  --   2. IT IS WHERE THE PATH KEY IS OBSERVABLE. `dir_make("tmp")` and
  --      `file_write("tmp/inline.ail")` use ONE spelling, so the listing holds the
  --      file. Spelled the way `compose.ail:769`/`:771` were before WI-D19 —
  --      absolute create, relative write — the created directory is a DIFFERENT
  --      key and this listing comes back empty.
  --
  -- SO THE REMOVE IS GUARDED BY THE LISTING, and that is how a read with no
  -- census reaches the census. `file_removes` is witnessed at one per dispatch;
  -- if the listing ever comes back empty or misspelled the removes stop happening
  -- and the balance goes red by name. A bare `dir_list` whose answer nothing
  -- consumed would be a call site, not a test — WI-D18's mutant 5 is what taught
  -- this file that a claim nothing reads is pinned by nothing.
  let listed = p.dir_list(stat.next_state, "tmp");
  let holds_the_file = listed.present && show(listed.entries) == show(["inline.ail"]);
  -- THE SECOND DIRECTORY, AND IT IS THE HALF THAT CATCHES THE BRIDGE MUTANT.
  -- The listing above cannot: it is a POPULATED directory, so `present` and
  -- `List.length(entries) > 0` agree on it, and WI-D19 ran the mutant and watched
  -- it pass for exactly that reason. The distinguishing input is a directory that
  -- EXISTS AND IS EMPTY — `present: true, entries: []` — which is the state
  -- WI-D18's whole kinded table was built to represent and which a bridge
  -- deriving presence from the count reports as ABSENT.
  --
  -- It is created OUTSIDE `tmp` on purpose. Created under it, `tmp`'s own listing
  -- would gain a second entry and `holds_the_file` above would go red for an
  -- unrelated reason — one assertion breaking another is how a suite stops
  -- measuring what its labels say.
  let mk_empty = p.dir_make(listed.next_state, "probe_empty");
  let empty_listing = p.dir_list(mk_empty.next_state, "probe_empty");
  let empty_is_present = empty_listing.present && List.length(empty_listing.entries) == 0;
  let gone: ExtFileMutation =
    if holds_the_file && empty_is_present then
      match stat.kind {
        ExtPathFile    => p.file_remove(empty_listing.next_state, "tmp/inline.ail"),
        ExtPathDir     => { ok: true, error: "", next_state: empty_listing.next_state },
        ExtPathMissing => { ok: true, error: "", next_state: empty_listing.next_state }
      }
    else { ok: true, error: "", next_state: empty_listing.next_state };
  { decision: NoIntercept, next_state: gone.next_state }
}
-- ---------------------------------------------------------------------------
-- WI-D20: THE ROUTED `on_tool_handle`, and the half a census cannot see
-- ---------------------------------------------------------------------------
--
-- `routing_intercept` above proves the RECORDER counts a routed hook's effects.
-- This hook proves something the census structurally cannot: that each dispatch
-- SEES THE WORLD THE PREVIOUS ONE LEFT.
--
-- WHY THAT NEEDED ITS OWN INSTRUMENT. `tool_phase.execute_allowed_tool_call` had
-- TWO independent defects:
--
--   * it projected `.decision` off `dispatch_tool_handle` and returned
--     `next_state: world` on every arm, dropping the successor;
--   * it fed the hook a `ctx` built ONCE per batch, so `ctx.world` goes stale
--     from the second tool call onward.
--
-- THIS HOOK, IN THIS SCENARIO, CATCHES THE FIRST ONLY, and that is stated here
-- because the first draft of this comment claimed both and was wrong. Reverting
-- the successor turns the rows below red; reverting the re-seating leaves them
-- GREEN, because `script()` puts one tool call in each batch and a per-batch
-- `ctx` is never stale within a batch of one. The second defect needs a batch of
-- two, which is `batch_handle_scenario` further down. Measured by running both
-- mutants, not reasoned about.
--
-- SO THE FILENAME IS DERIVED FROM WHAT THE HOOK OBSERVES. It lists `handled/`,
-- takes the entry count, and writes `handled/call_<n>.ail`. Threaded correctly
-- the three dispatches see 0, 1 and 2 and leave THREE distinct files. With the
-- successor dropped — or with a stale `ctx.world` — every dispatch sees an empty
-- directory, every write names `call_0.ail`, and the final world holds ONE
-- entry while the census still reports three writes.
--
-- That difference is read off the FINAL WORLD rather than off the log, which is
-- the S24 split `routing_scenario` states: the log knows whether the calls ran,
-- the world knows whether they composed.
--
-- IT RETURNS `Delegate`, DELIBERATELY AND NOT FOR CONVENIENCE. Delegate is the
-- arm the driver was MOST wrong on — it dropped the successor there and then
-- started the native dispatch's `ports.clock_now(world)` from the pre-hook world,
-- so a delegating hook's effects were discarded twice over. It also keeps this
-- scenario one hook slot away from `approve`, so every other witness in the file
-- keeps measuring what it measured before.
func routing_tool_handle(ctx: ExtCtx, _call: ToolCallEnvelope)
  -> ToolHandleOutcome ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream, Rand} {
  let p = ctx.ports;
  let made = p.dir_make(ctx.world, "handled");
  let listed = p.dir_list(made.next_state, "handled");
  -- `listed.entries` and NOT a counter closed over at registration: a counter
  -- would advance whether or not the world threaded, which is the exact
  -- non-measurement this row exists to avoid.
  let seen = List.length(listed.entries);
  let wrote = p.file_write(listed.next_state, "handled/call_${show(seen)}.ail", "seen=${show(seen)}\n");
  { decision: Delegate, next_state: wrote.next_state }
}

func passthrough_pre_step(ctx: ExtCtx, _msgs: [Msg])
  -> PreStepOutcome ! {AI, IO, Trace}  { { decision: { PassThrough }, next_state: ctx.world } }
func pending_policy(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolPolicyDecision {
  Pending("discovery: approval required", DenyAfterTimeout)
}

-- NAMED AND SHARED AT WI-D19, and the sharing is the point rather than tidiness:
-- the routed scenario differs from the three original ones in EXACTLY ONE hook
-- slot, so a second hooks literal would let the two drift in a way no reader
-- would see and no gate would report.
func approval_hooks_of(id: string) -> FixtureHooks {
  fixture_hooks(id, approval_overrides())
}

-- B7: the overrides as a value, so the routed variants below differ from the
-- approval shape by ONE kind-keyed field and no site spells a slot name.
func approval_overrides() -> FixtureOverrides {
  {
    tools: [],
    describe: no_describe,
    prompt: no_prompt,
    budget: no_budget,
    compact: passthrough_pre_step,
    policy: pending_policy,
    provide: no_handle,
    intercept: no_intercept,
    judge: no_solver
  }
}

func approval_rt(id: string) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  { registry: { hooks: [approval_hooks_of(id)] }, strict_mode: false, verification: v }
}

-- ---------------------------------------------------------------------------
-- Running
-- ---------------------------------------------------------------------------

func run_recording(id: string, w: WorldState) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(
    approval_rt(id), "task", "", false, budget(), "phase-c-model", history(), ".",
    12, false, 0, zero_rates(), RecordingWorld(w)
  )
}

-- The same scenario with the NON-recording adapters. Axis C.
func run_plain(id: string, w: WorldState) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(
    approval_rt(id), "task", "", false, budget(), "phase-c-model", history(), ".",
    12, false, 0, zero_rates(), ScriptedWorld(w)
  )
}

-- ---------------------------------------------------------------------------
-- The witnesses, read off records the recorder did not write
-- ---------------------------------------------------------------------------

-- Provider: `ProviderCallPrepared` in the RETURNED trace.
pure func provider_calls_witnessed(records: [LedgerRecord]) -> int {
  match records {
    [] => 0,
    r :: rest =>
      (match r {
         WireRecord(ProviderCallPrepared(_)) => 1,
         _ => 0
       }) + provider_calls_witnessed(rest)
  }
}

-- The `step` field of each `ProviderCallPrepared`, in order. This is the
-- driver's OWN step index, and it is what the recorded provider identity's step
-- must equal.
--
-- This check exists because the provider step is the one binding in the
-- recorder that could not be read and had to be DECIDED (see
-- `recording_model_step`): `Ports.model_step` does not receive `step_idx`, so
-- the recorder derives the step from the provider class's own position in the
-- log. S6 says a recorded binding is where an item's risk lives, and a count
-- check cannot see this one — four provider interactions numbered 0,0,0,0 are
-- four provider interactions. Only comparing the VALUES against the driver's
-- own can.
pure func provider_steps_witnessed(records: [LedgerRecord]) -> [int] {
  match records {
    [] => [],
    r :: rest =>
      match r {
        WireRecord(ProviderCallPrepared(i)) => i.step :: provider_steps_witnessed(rest),
        _ => provider_steps_witnessed(rest)
      }
  }
}

-- The recorded provider identities' steps, in log order.
pure func provider_steps_recorded(xs: [Interaction]) -> [int] {
  match xs {
    [] => [],
    i :: rest =>
      match i.identity.body {
        ProviderIdentity(_, step, _) => step :: provider_steps_recorded(rest),
        _ => provider_steps_recorded(rest)
      }
  }
}

-- The tool call ids the driver correlated its RESULT MESSAGES to, in order.
-- `tool_call_id` on a tool message is set by `tool_phase.ail` from the call it
-- answered, so this is the driver's own correlation and not the recorder's.
pure func tool_call_ids_witnessed(msgs: [Message]) -> [string] {
  match msgs {
    [] => [],
    m :: rest =>
      if m.role == "tool" && not contains(m.content, "denied_by_policy") then
        m.tool_call_id :: tool_call_ids_witnessed(rest)
      else tool_call_ids_witnessed(rest)
  }
}

pure func tool_call_ids_recorded(xs: [Interaction]) -> [string] {
  match xs {
    [] => [],
    i :: rest =>
      match i.identity.body {
        ToolIdentity(_, call_id, _) => call_id :: tool_call_ids_recorded(rest),
        _ => tool_call_ids_recorded(rest)
      }
  }
}

pure func eq_ints(a: [int], b: [int]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs => match b { [] => false, y :: ys => x == y && eq_ints(xs, ys) }
  }
}

pure func join_ints(xs: [int]) -> string {
  match xs { [] => "", x :: [] => "${x}", x :: rest => "${x},${join_ints(rest)}" }
}

pure func join(xs: [string]) -> string {
  match xs { [] => "", x :: [] => x, x :: rest => "${x},${join(rest)}" }
}

-- Tool: the tool-result messages the driver returned, EXCLUDING the ones a
-- denial produced. `denied_by_policy` is a field of the denial payload built by
-- `tool_phase.ail`'s `denial_message` / `policy_denied_message`, so the
-- discriminator is production code's own, not this script's.
pure func tool_results_witnessed(msgs: [Message]) -> int {
  match msgs {
    [] => 0,
    m :: rest =>
      (if m.role == "tool" && not contains(m.content, "denied_by_policy") then 1 else 0)
        + tool_results_witnessed(rest)
  }
}

-- Every tool-role message the driver returned, result or denial alike. Under
-- these scenarios' policy EVERY tool call goes to the approval channel, so this
-- is one per approval read the driver performed — the witness that replaced the
-- cursor delta after the cursor was measured under-counting a drained queue.
pure func tool_role_messages(msgs: [Message]) -> int {
  match msgs {
    [] => 0,
    m :: rest => (if m.role == "tool" then 1 else 0) + tool_role_messages(rest)
  }
}

func witness_for(initial: WorldState, run: TracedSessionResult, expected_env: [EnvExpectation]) -> DiscoveryWitness {
  let final_msgs = match run.result { Ok(ms) => ms, Err(_) => [] };
  {
    provider_calls: provider_calls_witnessed(run.trace.records),
    tool_dispatches: tool_results_witnessed(final_msgs),
    approval_reads: tool_role_messages(final_msgs),
    approvals_consumed: List.length(initial.approvals) - List.length(run.world.approvals),
    clock_delta_ms: run.world.clock_ms - initial.clock_ms,
    -- WI-D19. This scenario routes no filesystem mutation, so the expectation is
    -- the literal zero WI-D17 and WI-D18 pinned in `absent_classes` — the field is
    -- where that pin now lives, and it is still a claim rather than silence. See
    -- `DiscoveryWitness` for why the three classes moved from a hard-coded 0 to a
    -- witness at WI-D19, and note that an extension installed into THIS scenario
    -- has to change these by hand: nothing derives them from the run.
    file_writes: 0,
    file_removes: 0,
    dir_makes: 0,
    -- WI-D24 added the extension-effect class on the same terms: this scenario
    -- installs no extension that reaches `ExtPorts.proc_exec`, so the pin holds
    -- here and the class is still claimed at zero rather than unmentioned.
    extension_effects: 0,
    expected_env_reads: expected_env
  }
}

-- The env keys this scenario's control flow reaches, DERIVED FROM THE DRIVER'S
-- SOURCE and not from the run:
--
--   session.ail:1417  session_policy_init runs unconditionally, four keys
--   session.ail:939   derive_session_id runs on the traced path (called at
--                     session.ail:2283), one key
--   tool_phase.ail:343 once per NATIVE tool dispatch — so it is reached in the
--                     `approve` scenario and NOT in `deny`, where every call is
--                     refused before dispatch
--
-- MOTOKO_CAPTURE_FAILED_PAYLOAD (session.ail:2018) is on the non-retryable
-- provider-error path, which neither scenario takes, and is correctly absent
-- from both lists.
-- The COUNTS matter, not merely the keys. Each of the five below is read
-- exactly once per traced run: `session_policy_init` runs once before the loop
-- and `derive_session_id` once at its start. A recorder that logged the first
-- read of a key and dropped later ones would satisfy a presence check.
func env_reads_always(resolutions: int) -> [EnvExpectation] {
  [{ key: "MOTOKO_PERSIST_RETRIES",    count: 1 },
   { key: "MOTOKO_RETRY_STREAM_ERROR", count: 1 },
   { key: "OPENAI_BASE_URL",           count: 1 },
   { key: "MOTOKO_HEADLESS",           count: 1 },
   { key: "MOTOKO_SESSION_ID",         count: 1 }]
    ++ env_reads_per_context_resolution(resolutions)
}

-- MOTOKO_TOOL_TIMEOUT_MS is read once per NATIVE dispatch (tool_phase.ail:343),
-- so its expected count is expressed in terms of the independently WITNESSED
-- dispatch count rather than written as a literal. That anchors the one
-- repeated env read to a runtime witness, even though the read itself has none.

-- WI-D3's four context-resolution keys, and their MULTIPLICITY.
--
-- `resolve_context_limit` performs five env requests per call against a world
-- whose env table does not carry these keys: MOTOKO_PROFILE_DIR, then
-- MOTOKO_CONFIG, then MOTOKO_REPO (from `profile_dir_path`), then
-- MOTOKO_MODELS_FILE, then MOTOKO_REPO again (from `catalog_path`). MOTOKO_REPO
-- is therefore read TWICE per resolution and the other three once, which is why
-- the rates below are not uniform — a uniform set would be satisfied by a
-- recorder that lost one of the two MOTOKO_REPO reads.
--
-- MEASURED PER SCENARIO, and the resolution count is a PARAMETER because the
-- first version of this made it a shared constant and that was wrong. WI-D3 set
-- it to 12 — correct for discovery's approve, deny and eof, read off
-- `make discovery`'s own census (environment_read=68/65/66 against 8/5/6
-- accounted for before this item, 60 = 12 x 5 in every case) — and strict
-- replay's scenarios reject it immediately: `rich` reaches 19 resolutions and
-- `maxsteps` 8, so the shared literal was over-recorded on one and
-- under-recorded on the other. The count tracks the loop arms a scenario takes,
-- not the run length, and no formula over the witnessed quantities fits the
-- three data points — 12 at provider=4, 19 at provider=5, 8 at provider=1 — so
-- each scenario states its own measurement rather than deriving a rule from
-- three observations.
--
-- The count is a literal because there is NO runtime witness to anchor it to:
-- the env class emits no ledger event, which is the same reason this whole set
-- exists, and deriving it from the log would put both sides of the check on one
-- producer — the defect S16 names.
--
-- It goes RED rather than stale when the driver's loop structure changes the
-- number of resolutions, and that is the intended failure: a changed count is a
-- changed env surface and this set is the env class's only independent evidence.
func env_reads_per_context_resolution(resolutions: int) -> [EnvExpectation] {
  [{ key: "MOTOKO_PROFILE_DIR", count: resolutions },
   { key: "MOTOKO_CONFIG",      count: resolutions },
   { key: "MOTOKO_MODELS_FILE", count: resolutions },
   { key: "MOTOKO_REPO",        count: resolutions * 2 }]
}


func env_reads_with_dispatch(dispatches: int, resolutions: int) -> [EnvExpectation] {
  env_reads_always(resolutions) ++ [{ key: "MOTOKO_TOOL_TIMEOUT_MS", count: dispatches }]
}

-- ---------------------------------------------------------------------------
-- Reporting
-- ---------------------------------------------------------------------------

func check(label: string, ok: bool, detail: string) -> bool ! {IO} {
  let _ = if ok then println("  ✓ ${label}") else println("  ✗ ${label} — ${detail}");
  ok
}

func report_findings(fs: [DiscoveryFinding]) -> () ! {IO} {
  match fs {
    [] => (),
    f :: rest => {
      let _ = println("      ${discovery_message(f)}");
      report_findings(rest)
    }
  }
}

-- A mutation row: mutate the REAL recorded log, and require the named rule to
-- fire. `label` says what was broken; `rule` is what must catch it.
func mutant(label: string, rule: string, log: [Interaction], w: DiscoveryWitness) -> bool ! {IO} {
  let fs = check_discovery(log, w);
  check("${rule} ← ${label}", has_discovery_rule(fs, rule),
        "expected ${rule}; got ${show(List.length(fs))} finding(s): ${first_discovery_message(fs)}")
}

pure func drop_kind(xs: [Interaction], kind: string) -> [Interaction] {
  match xs {
    [] => [],
    i :: rest => if interaction_kind(i) == kind then drop_kind(rest, kind) else i :: drop_kind(rest, kind)
  }
}

-- Re-densify after a drop, so the mutation tests the CLASS BALANCE and not the
-- density rule. A mutant that trips two rules proves neither.
pure func renumber(xs: [Interaction], n: int) -> [Interaction] {
  match xs {
    [] => [],
    i :: rest => ({ i | identity: { i.identity | ordinal: n } }) :: renumber(rest, n + 1)
  }
}

pure func log_kinds(xs: [Interaction]) -> [string] {
  match xs {
    [] => [],
    i :: rest => interaction_kind(i) :: log_kinds(rest)
  }
}

pure func eq_list(a: [string], b: [string]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs => match b { [] => false, y :: ys => x == y && eq_list(xs, ys) }
  }
}

pure func projections(xs: [Interaction]) -> [string] {
  match xs {
    [] => [],
    i :: rest => "${identity_projection(i.identity)}|${i.request_projection}|${i.outcome.advance_ms}" :: projections(rest)
  }
}

-- ---------------------------------------------------------------------------
-- Axis G: the recorded log, as an ExecutionProgram
-- ---------------------------------------------------------------------------

pure func discovered_manifest() -> ExecutionManifest {
  driver_only_manifest("HEAD", "ailang 0.33.0", "4.0", "{}",
                       ["ai_step", "env_get", "proc_exec"], ["clock_now"], "HEAD")
}

pure func program_of(w: WorldState, initial: WorldState) -> ExecutionProgram {
  {
    schema_version: program_schema_version(),
    -- WI-A13 stage 4 renamed this from "driver_only_discovery". The world this
    -- program was discovered against is HAND-AUTHORED, and D2's three generator
    -- axes are required and validated non-blank, so before a generator existed
    -- these fields necessarily named one that did not. `seed: 0` in particular
    -- was consulted by nothing. The seeded generator is
    -- `src/core/dst_generator`, and its programs are produced by
    -- `scripts/dst/seeded_generator_dst.ail`, which reads these three axes off
    -- the world's own generator state instead of writing literals.
    generator_id: "hand_authored_discovery",
    generator_version: "1",
    seed: 0,
    initial_world: {
      messages_and_policy: "{\"messages\":[\"system\",\"user\"],\"policy\":\"driver_only\"}",
      synthetic_environment: initial.env,
      -- WI-D22: `execution-program/2` seeds the world's file table from the
      -- program. This fixture seeds nothing, which is what it did before the
      -- field existed; the seeded case is exercised in dst_replay and in the
      -- persistence specimen.
      files: [],
      clock_epoch: initial.clock_ms,
      extension_profile: "driver_only/1"
    },
    bounds: {
      max_interactions: 256,
      max_chunks_per_interaction: 16,
      max_payload_bytes: 4096,
      max_resource_size: 4096,
      max_clock_advance_ms: 60000,
      chunk_draw_hi: 3
    },
    manifest: discovered_manifest(),
    interactions: w.log
  }
}

-- ---------------------------------------------------------------------------
-- One scenario, all axes
-- ---------------------------------------------------------------------------

func run_scenario(
  label: string,
  answers: [string],
  tool_timeout_read_per_dispatch: bool,
  -- WI-D3 added this as a per-scenario count because `resolve_context_limit` was
  -- reached once in `session_policy_init` AND again on every loop arm taken, so
  -- the number genuinely varied with control flow — 12 here, 19 and 8 in strict
  -- replay. WI-D4 removed the four per-arm resolutions (they re-derived a value
  -- `session_policy_init` had already stored), so the driver reaches it exactly
  -- ONCE per run and every scenario's answer is 1.
  --
  -- THE PARAMETER STAYS even though every caller now passes the same number, and
  -- that is deliberate rather than an oversight: what makes the answer 1 is a
  -- property of the driver's call graph, not of this suite, and the moment
  -- anything re-resolves per arm the quantity varies again. A parameter that is
  -- currently constant expresses "this may differ per scenario and today does
  -- not"; folding it into a shared literal would express "this cannot differ",
  -- which is the claim WI-D3 measured to be false.
  context_resolutions: int
) -> bool ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let initial = base_world(answers);
  let run = run_recording("discovery_${label}", initial);
  let log = run.world.log;
  -- Built in two passes: the witness's dispatch count is needed to state the
  -- expected MOTOKO_TOOL_TIMEOUT_MS multiplicity, and that count comes from the
  -- returned messages, never from the log.
  let probe = witness_for(initial, run, []);
  let expected_env =
    if tool_timeout_read_per_dispatch then env_reads_with_dispatch(probe.tool_dispatches, context_resolutions)
    else env_reads_always(context_resolutions);
  let w = { probe | expected_env_reads: expected_env };

  let _ = println("");
  let _ = println("${label}: ${show(List.length(log))} interactions recorded");
  let _ = println("${label}: witness provider=${show(w.provider_calls)} tool=${show(w.tool_dispatches)} approval_reads=${show(w.approval_reads)} approvals_served=${show(w.approvals_consumed)} clock_delta=${show(w.clock_delta_ms)}ms");
  -- The machine-readable census. `make discovery` diffs this against the wire's
  -- own `provider_call_prepared` and `v2_tool_dispatch_start` counts, which is
  -- where the STRONGER pre-port tool witness is consumed.
  let _ = println("CENSUS ${label} ${census_line(census(log))}");

  -- The message-derived witnesses (tool dispatches, approval reads) come from
  -- the returned message list, which is EMPTY on the Err path. A scenario that
  -- started failing would therefore witness zero of both and silently downgrade
  -- two of the four runtime witnesses to vacuous. Asserted rather than assumed.
  let ok_ran = check("${label}: the scenario reached its terminator",
                     match run.result { Ok(_) => true, Err(_) => false },
                     "the run returned Err, so the message-derived witnesses are empty and would pass vacuously");

  -- ---- Axes A + B + E: the real log, both directions, and it must SURVIVE ---
  let fs = check_discovery(log, w);
  let _ = if List.length(fs) > 0 then report_findings(fs) else ();
  let ok_real = check("${label}: the recorded log accounts for the run, in both directions",
                      List.length(fs) == 0,
                      "${show(List.length(fs))} finding(s) above");

  -- ---- Identity CONTENT, not just counts ---------------------------------
  --
  -- The balance checks above compare how MANY. These compare WHICH, against the
  -- driver's own values. A recorder can produce the right number of provider
  -- interactions all carrying step 0, or the right number of tool interactions
  -- all carrying the first call id — both type-check, both are perfectly
  -- reproducible, and both make strict replay match the wrong outcome to the
  -- right-looking request.
  let steps_w = provider_steps_witnessed(run.trace.records);
  let steps_r = provider_steps_recorded(log);
  let ok_steps = check("${label}: recorded provider steps equal the driver's own",
                       eq_ints(steps_w, steps_r),
                       "driver=[${join_ints(steps_w)}] recorded=[${join_ints(steps_r)}] — the step is the recorder's one DECIDED binding, derived from log position because the port never receives step_idx");
  let final_msgs2 = match run.result { Ok(ms) => ms, Err(_) => [] };
  let ids_w = tool_call_ids_witnessed(final_msgs2);
  let ids_r = tool_call_ids_recorded(log);
  let ok_ids = check("${label}: recorded tool call ids equal the driver's own correlation",
                     eq_list(ids_w, ids_r),
                     "driver=[${join(ids_w)}] recorded=[${join(ids_r)}]");

  -- ---- Axis D: every guard, red under a deliberate mutation ---------------
  let _ = println("  mutations (each must go red):");
  let dropped_provider = renumber(drop_kind(log, identity_kind(ProviderIdentity("", 0, ""))), 0);
  let m1 = mutant("the recorder drops the provider class", "discovery-under-recorded",
                  dropped_provider, { w | clock_delta_ms: total_advance_ms(dropped_provider) });
  let dropped_env = renumber(drop_kind(log, identity_kind(EnvironmentReadIdentity(""))), 0);
  let m2 = mutant("the recorder drops the environment class", "discovery-env-read-under-recorded",
                  dropped_env, { w | clock_delta_ms: total_advance_ms(dropped_env) });
  let dropped_clock = renumber(drop_kind(log, identity_kind(ClockAdvanceIdentity)), 0);
  let m3 = mutant("the recorder drops the clock class", "discovery-clock-unaccounted",
                  dropped_clock, w);
  let doubled = renumber(log ++ log, 0);
  let m4 = mutant("the recorder appends every interaction twice", "discovery-over-recorded",
                  doubled, { w | clock_delta_ms: total_advance_ms(doubled) });
  let shifted = renumber(log, 1);
  let m5 = mutant("the recorder numbers from 1 instead of 0", "discovery-log-not-dense",
                  shifted, w);
  let m6 = mutant("the world clock moved further than the log accounts for",
                  "discovery-clock-unaccounted", log, { w | clock_delta_ms: w.clock_delta_ms + 1 });
  let m7 = mutant("the log records nothing at all", "discovery-empty-log",
                  [], { w | clock_delta_ms: 0 });
  let m8 = mutant("the approval cursor moved further than the served reads account for",
                  "discovery-approval-cursor-disagrees", log,
                  { w | approvals_consumed: w.approvals_consumed + 1 });

  -- ---- Axis C: the same scenario, recorder absent, must be RED ------------
  let plain = run_plain("plain_${label}", initial);
  let plain_w = witness_for(initial, plain, expected_env);
  let ok_vacuity = check("${label}: the check is RED when the adapters do not record",
                         not discovery_ok(plain.world.log, plain_w),
                         "the non-recording run passed the completeness check — the assertion is vacuous");

  -- ---- Axis F: determinism ------------------------------------------------
  let again = run_recording("discovery_${label}", initial);
  let ok_det = check("${label}: two runs of the same world record the same log",
                     eq_list(projections(log), projections(again.world.log)),
                     "the recorded logs differ between two runs of one world");

  -- ---- Axis G: the log is a valid ExecutionProgram ------------------------
  let prog = program_of(run.world, initial);
  let rejections = validate_program(prog, required_class_ids());
  let _ = match rejections { [] => (), r :: _ => println("      ${program_message(r)}") };
  let ok_prog = check("${label}: the recorded log is a structurally valid ExecutionProgram",
                      List.length(rejections) == 0,
                      "${show(List.length(rejections))} structural rejection(s)");
  let ok_bounds = check("${label}: the discovered program is within its declared bounds",
                        List.length(validate_bounds(prog)) == 0,
                        "a declared generator bound was exceeded");

  ok_ran && ok_real && ok_steps && ok_ids && m1 && m2 && m3 && m4 && m5 && m6 && m7 && m8
    && ok_vacuity && ok_det && ok_prog && ok_bounds
}

-- ---------------------------------------------------------------------------
-- The wire witness, on its own entry point
-- ---------------------------------------------------------------------------
--
-- THE STRONGEST WITNESS IN THIS STAGE, and it is strongest because it is
-- OUT OF PROCESS. `V2ToolDispatchStart` is emitted BEFORE the port calls that
-- follow it, which makes it the one tool witness that exists whether or not the
-- port was ever reached.
--
--   TENSED AT WI-D2, AND THE CONCLUSION SURVIVED THE REASON. Until WI-D2 the
--   note read "it goes to the wire through `ledger_emit` and is never appended
--   to the returned trace, so `run.trace.records` cannot see it" — cluster 4
--   measured that emit/append imbalance at 37 against 15. WI-D2 appends it, so
--   `run.trace.records` CAN see it now. This gate still reads the wire, because
--   what makes it an oracle is that the two records have different AUTHORS, and
--   a witness read from the returned trace would be produced by the same
--   process as the census it is compared against. The append made the witness
--   available in a second place; it did not make the second place independent.
--
-- `make discovery` therefore runs THIS entry, captures stdout, and compares the
-- JSONL the driver emitted against the census this prints. Two authors, two
-- records, one execution — the property that makes it an oracle rather than the
-- recorder grading itself.
--
-- It is a SEPARATE entry point because `main` performs six driver runs across
-- its two scenarios, and the wire accumulates over all of them while a census
-- describes one. Comparing a wire total against a per-run census would need a
-- multiplier, and a multiplier is a number that goes stale the moment a
-- scenario is added. One run, one census, exact equality, nothing to maintain.
export func wire_witness() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let initial = base_world([approve_line(), approve_line(), approve_line()]);
  let run = run_recording("wire_witness", initial);
  println("CENSUS wire ${census_line(census(run.world.log))}")
}

-- ---------------------------------------------------------------------------
-- WI-D19: the routed scenario, and the tripwire it answers
-- ---------------------------------------------------------------------------

func routing_rt(id: string) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  { registry: { hooks: [fixture_hooks(id, { approval_overrides() | intercept: routing_intercept })] },
    strict_mode: false, verification: v }
}

func run_routing(id: string, w: WorldState) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(
    routing_rt(id), "task", "", false, budget(), "phase-c-model", history(), ".",
    12, false, 0, zero_rates(), RecordingWorld(w)
  )
}

-- The three counts, derived from the SCENARIO rather than from the log.
--
-- `routing_intercept` performs exactly one `dir_make`, one `file_write` and one
-- `file_remove` per dispatch, and the driver dispatches the intercept once per
-- assistant response. So the expectation is the response count — which is
-- `provider_calls_witnessed`, read off `ProviderCallPrepared` records that
-- production driver code writes and that exist whether or not the recorder ever
-- recorded anything.
--
-- THIS IS THE POINT OF THE WHOLE SCENARIO. A count read off `log` would agree
-- with the recorder by construction and the balance would be an identity; this
-- one can disagree, and the mutation rows below make it.
func routing_scenario() -> bool ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let _ = println("");
  let _ = println("-- WI-D19: a ROUTED extension on a graded profile --");
  let initial = base_world([approve_line(), approve_line(), approve_line()]);
  let run = run_routing("discovery_routing", initial);
  let log = run.world.log;
  let intercepts = provider_calls_witnessed(run.trace.records);
  -- TWO `dir_make`s per dispatch and ONE of everything else, counted from
  -- `routing_intercept`'s own text: the compose-shaped `tmp` and the empty
  -- `probe_empty` that exists to make the bridge's `present` derivation
  -- falsifiable. Written as an arithmetic expression rather than a literal so
  -- that adding a seam to the hook and forgetting this line is a red row.
  let w = { witness_for(initial, run, env_reads_always(1))
            | file_writes: intercepts, file_removes: intercepts, dir_makes: intercepts * 2 };

  let ok_ran = check("routing: the scenario reached its terminator",
                     match run.result { Ok(_) => true, Err(_) => false },
                     "the run returned Err, so every witness below is vacuous");

  -- REACHABILITY, ASSERTED SEPARATELY FROM THE BALANCE (S24). A scenario whose
  -- hook was never dispatched records nothing and balances against zero, and
  -- that is byte-identical to the pre-WI-D19 state. This row is what stops the
  -- balance below from being satisfied by a routing that never ran.
  --
  -- IT IS READ OFF THE LOG DELIBERATELY, and that is not the circularity the
  -- balance below avoids — the two rows ask different questions. This one asks
  -- DID THE ROUTED CALL RUN, and the log is the only thing that knows; the
  -- balance asks DID THE RECORDER COUNT IT RIGHT, and answers that against a
  -- witness the recorder did not write. A first draft of this row used
  -- `intercepts > 0` — the PROVIDER-call count — and that measured less than its
  -- own label: it is satisfied by a run in which the driver called the model and
  -- the hook was never dispatched at all, which is precisely the state this file
  -- was in before the routed scenario existed.
  let ok_reached = check("routing: the routed hook actually RAN — its seams reached the recorder",
                         count_kind(log, "dir_make") > 0
                           && count_kind(log, "file_write") > 0
                           && count_kind(log, "file_remove") > 0,
                         "dir_make=${show(count_kind(log, "dir_make"))} file_write=${show(count_kind(log, "file_write"))} file_remove=${show(count_kind(log, "file_remove"))} — a routed call that never executes proves nothing, and every row below would pass vacuously");

  let _ = println("  routed classes: dir_make=${show(count_kind(log, "dir_make"))} file_write=${show(count_kind(log, "file_write"))} file_remove=${show(count_kind(log, "file_remove"))} (witness ${show(intercepts)} of each)");

  let fs = check_discovery(log, w);
  let _ = if List.length(fs) > 0 then report_findings(fs) else ();
  let ok_balanced = check("routing: the three routed classes balance against a witness that is not the log",
                          List.length(fs) == 0,
                          "${show(List.length(fs))} finding(s) above");

  -- THE TRIPWIRE, DEMONSTRATED RATHER THAN DESCRIBED. WI-D17 and WI-D18 pinned
  -- these three at zero so that the first routing would have to answer for them
  -- by name. This is that answer executed: the old expectation, against the new
  -- run, must be RED — and red by the rule those items named.
  let _ = println("  the WI-D17/D18 tripwire, run against the routed log (each must go red):");
  let t1 = mutant("the pre-WI-D19 pin: file_write expected 0", "discovery-over-recorded",
                  log, { w | file_writes: 0 });
  let t2 = mutant("the pre-WI-D19 pin: file_remove expected 0", "discovery-over-recorded",
                  log, { w | file_removes: 0 });
  let t3 = mutant("the pre-WI-D19 pin: dir_make expected 0", "discovery-over-recorded",
                  log, { w | dir_makes: 0 });
  -- And the other direction, which the pin could never state: a recorder that
  -- acts without logging. WI-D17's mutant 8 on the adapter, restated on the gate.
  let t4 = mutant("the recorder drops the file_write class", "discovery-under-recorded",
                  renumber(drop_kind(log, identity_kind(FileWriteIdentity(""))), 0),
                  { w | clock_delta_ms: total_advance_ms(renumber(drop_kind(log, identity_kind(FileWriteIdentity(""))), 0)) });
  let t5 = mutant("the recorder drops the dir_make class", "discovery-under-recorded",
                  renumber(drop_kind(log, identity_kind(DirMakeIdentity(""))), 0),
                  { w | clock_delta_ms: total_advance_ms(renumber(drop_kind(log, identity_kind(DirMakeIdentity(""))), 0)) });

  ok_ran && ok_reached && ok_balanced && t1 && t2 && t3 && t4 && t5
}

-- ---------------------------------------------------------------------------
-- WI-D24: the routed extension EFFECT — record, validate, replay
-- ---------------------------------------------------------------------------
--
-- THIS IS THE ROW THAT CLOSES WI-D21 §4. Through WI-D23 the first extension to
-- call `ExtPorts.proc_exec` in a recorded run made the recorder emit a program
-- its own validator refused: `recording_tool` wrote `ToolIdentity("loop_v2", "", tool)`
-- and a blank tool call id is a rejection. WI-D21 asserted that latent defect
-- against hand-built identities. This scenario is the executable answer — a real
-- hook, the real bridge, the real recorder — and it asserts three things the
-- unit rows cannot:
--
--   1. the recorded interaction is `expect_extension_effect` and VALIDATES;
--   2. the ORIGIN is the extension's own id, taken off the transport;
--   3. `world_state_of` reconstitutes a queue that SERVES the dispatch, so the
--      replay performs no subprocess and leaves no interaction unconsumed.
--
-- THE EXT ID IS DELIBERATELY NOT COMPOSE'S. `recording_ext_effect` could satisfy
-- every other row in this file with the string "compose" hardcoded, because
-- compose is the only extension the project ever talks about at this seam (S33:
-- the proxy and the truth agree on almost every input by construction). The id
-- below is one no production registry contains, and the origin row is what makes
-- the difference observable.
--
-- THE DRIVER'S OWN TOOL DISPATCHES INTERLEAVE WITH THE EXTENSION'S, and that is
-- the scenario's second job. Two classes, two queues, one run: the driver
-- consumes `WorldState.tools` (durations 7/11/13) and the extension consumes
-- `WorldState.ext_effects` (durations 17/19/23/29), and no two quantities in
-- either queue are equal (S7). A world serving one queue from the other shows up
-- as a content mismatch rather than as a count that still balances.
func effect_tools() -> [{ tool_call_id: string, duration_ms: int, code: string, message: string, content: string, exit_code: int }] {
  -- SIX entries against the four intercepts the script produces, and the slack
  -- is load-bearing rather
  -- than defensive: an empty `ext_effects` queue does not fail, it DELEGATES —
  -- `world_ext_effect`'s `[]` arm runs a real subprocess. A fixture that seeded
  -- exactly the expected number would turn any future off-by-one in the dispatch
  -- count into a live `bash -lc` inside a deterministic gate. The unconsumed tail
  -- is invisible to every check here: `reconstitution_balance` counts the queue
  -- the LOG rebuilds, not the one the scenario seeded.
  --
  -- The exit codes are real and distinct (41/43/47/53). `-1` would be the honest
  -- value for a tool that runs no process, and it is exactly wrong here: this
  -- seam's whole point since WI-D23 is that a subprocess code crosses the ABI,
  -- so the fixture states codes a replay can be caught losing.
  [{ tool_call_id: "", duration_ms: 17, code: "", message: "", content: "EXT-EFFECT-1", exit_code: 41 },
   { tool_call_id: "", duration_ms: 19, code: "", message: "", content: "EXT-EFFECT-2", exit_code: 43 },
   { tool_call_id: "", duration_ms: 23, code: "", message: "", content: "EXT-EFFECT-3", exit_code: 47 },
   { tool_call_id: "", duration_ms: 29, code: "", message: "", content: "EXT-EFFECT-4", exit_code: 53 },
   { tool_call_id: "", duration_ms: 31, code: "", message: "", content: "EXT-EFFECT-5", exit_code: 59 },
   { tool_call_id: "", duration_ms: 37, code: "", message: "", content: "EXT-EFFECT-6", exit_code: 61 }]
}

func effect_world(answers: [string]) -> WorldState {
  { base_world(answers) | ext_effects: effect_tools() }
}

-- The routed hook. ONE `proc_exec` per intercept, through `ctx.ports` — the
-- production bridge, not a rebuilt closure (S14's two subjects).
--
-- The successor is threaded from the call's own `next_state`, which is what
-- makes the queue advance visible to the next dispatch. Returning `ctx.world`
-- here would be S29's dropped successor: every intercept would consume the same
-- head, the recorder would log three identical outcomes, and every count would
-- still balance.
func effect_intercept(ctx: ExtCtx, _text: string)
  -> ResponseInterceptOutcome ! {IO, Process, FS, Clock} {
  let p = ctx.ports;
  let out = p.proc_exec(ctx.world, "BashExec", "{\"cmd\":\"true\"}");
  { decision: { NoIntercept }, next_state: out.next_state }
}

func effect_rt(id: string) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  { registry: { hooks: [fixture_hooks(id, { approval_overrides() | intercept: effect_intercept })] },
    strict_mode: false, verification: v }
}

func run_effect(id: string, w: WorldState) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(
    effect_rt(id), "task", "", false, budget(), "phase-c-model", history(), ".",
    12, false, 0, zero_rates(), RecordingWorld(w)
  )
}

-- Every recorded origin of the extension-effect class, in order. The row that
-- kills the hardcoded-id mutant reads THIS and not a count.
pure func effect_origins(xs: [Interaction]) -> [string] {
  match xs {
    [] => [],
    i :: rest =>
      match i.identity.body {
        ExtensionEffectIdentity(_, _, _) => identity_origin(i.identity.body) :: effect_origins(rest),
        _ => effect_origins(rest)
      }
  }
}

pure func effect_class_ids(xs: [Interaction]) -> [string] {
  match xs {
    [] => [],
    i :: rest =>
      match i.identity.body {
        ExtensionEffectIdentity(_, c, _) => c :: effect_class_ids(rest),
        _ => effect_class_ids(rest)
      }
  }
}

pure func all_equal(xs: [string], v: string) -> bool {
  match xs {
    [] => true,
    x :: rest => x == v && all_equal(rest, v)
  }
}

func effect_scenario() -> bool ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let _ = println("");
  let _ = println("-- WI-D24: an extension EFFECT recorded, validated and REPLAYED --");
  let ext_id = "ext_delta_24";
  let initial = effect_world([approve_line(), approve_line(), approve_line()]);
  let run = run_effect(ext_id, initial);
  let log = run.world.log;
  -- One `proc_exec` per intercept, and the driver dispatches the intercept once
  -- per assistant response. `provider_calls_witnessed` reads `ProviderCallPrepared`
  -- records production driver code writes, so the expectation cannot agree with
  -- the recorder by construction — WI-D19's argument, one class over.
  let intercepts = provider_calls_witnessed(run.trace.records);
  let w = { witness_for(initial, run, env_reads_always(1)) | extension_effects: intercepts };
  let effects = count_kind(log, identity_kind(ExtensionEffectIdentity("", "", "")));
  let tools = count_kind(log, identity_kind(ToolIdentity("", "", "")));

  let ok_ran = check("effect: the scenario reached its terminator",
                     match run.result { Ok(_) => true, Err(_) => false },
                     "the run returned Err, so every witness below is vacuous");

  -- REACHABILITY BEFORE BALANCE (S24). A hook that never ran records nothing and
  -- balances against zero, which is byte-identical to every run in this tree
  -- before this item.
  let ok_reached = check("effect: the routed hook actually RAN — the extension seam reached the recorder",
                         effects > 0,
                         "expect_extension_effect count is 0; a routed call that never executes proves nothing");

  -- THE INTERLEAVING, ASSERTED. Both classes in one log, from two queues. A
  -- single shared queue would still produce these counts, so the row that
  -- separates them is the CONTENT row below, not this one — this one only says
  -- the run exercised both.
  let ok_interleaved = check("effect: the driver's tool dispatches and the extension's effects are both in the log",
                             tools > 0 && effects > 0,
                             "expect_tool=${show(tools)} expect_extension_effect=${show(effects)} — a run with only one class cannot exercise the queue discipline");

  let _ = println("  recorded: expect_extension_effect=${show(effects)} expect_tool=${show(tools)} (witness ${show(intercepts)} effects)");

  -- THE ORIGIN. This is the S33 row: the ext id must come off the transport, and
  -- an adapter that wrote a constant would pass every other row in this file.
  let origins = effect_origins(log);
  let ok_origin = check("effect: every recorded effect names the EXTENSION that performed it, not a constant",
                        List.length(origins) == effects && effects > 0 && all_equal(origins, ext_id),
                        "origins=[${join(origins)}] — expected ${show(effects)} of \"${ext_id}\"; an adapter that hardcodes an id passes every count-based row here");

  -- The class id, read from the catalogue rather than restated. `validate_static_references`
  -- would reject a drifted one, so this row is the cheap statement of what that
  -- rejection would be about.
  let ok_class = check("effect: every recorded effect names the catalogue's extension-effect row",
                       all_equal(effect_class_ids(log), fault_class_extension_effect()),
                       "class ids=[${join(effect_class_ids(log))}] — expected \"${fault_class_extension_effect()}\"");

  let fs = check_discovery(log, w);
  let _ = if List.length(fs) > 0 then report_findings(fs) else ();
  let ok_balanced = check("effect: the extension-effect class balances against a witness that is not the log",
                          List.length(fs) == 0,
                          "${show(List.length(fs))} finding(s) above");

  -- THE PIN, RUN AGAINST THE ROUTED LOG. WI-D19 pinned this class at literal
  -- zero and WI-D21 measured that its stated ground did not hold. This is the
  -- old expectation executed against a run that routes the class: it must be RED,
  -- and red by the rule the pin named.
  let _ = println("  the WI-D19 pin, run against the routed log (must go red):");
  let t_pin = mutant("the pre-WI-D24 pin: extension_effect expected 0", "discovery-over-recorded",
                     log, { w | extension_effects: 0 });

  -- ---- VALIDATE ---------------------------------------------------------
  --
  -- The headline. WI-D21 §4's defect was that this call returned a rejection.
  let program = program_of(run.world, initial);
  let rejections = validate_program(program, required_class_ids());
  let _ = if List.length(rejections) > 0 then println("      ${first_rejection_message(rejections)}") else ();
  let ok_valid = check("effect: the recorded program VALIDATES — WI-D21 §4's rejected program is closed by measurement",
                       List.length(rejections) == 0,
                       "${show(List.length(rejections))} rejection(s); through WI-D23 this call returned program-identity-component-missing for the bridge's blank tool call_id");

  -- ---- REPLAY -----------------------------------------------------------
  match world_state_of(program, required_class_ids()) {
    Err(r) => {
      let _ = println("      ${refusal_message(r)}");
      let ok_recon = check("effect: the program reconstitutes a world", false,
                           "refused with ${refusal_rule(r)}");
      ok_ran && ok_reached && ok_interleaved && ok_origin && ok_class && ok_balanced && t_pin && ok_valid && ok_recon
    },
    Ok(replay_world) => {
      let rec = reconstitution_balance(program, replay_world);
      let ok_rec = check("effect: the reconstituted world accounts for BOTH dispatch queues",
                         List.length(rec) == 0,
                         "${show(List.length(rec))} reconstitution finding(s) — an extension-effect class the projection drops leaves an EMPTY ext_effects queue, and an empty queue delegates to the real dispatcher");
      let _ = println("  reconstituted: tools=${show(List.length(replay_world.tools))} ext_effects=${show(List.length(replay_world.ext_effects))}");

      -- THE SERVED CONTENT. The reconstituted queue must hold what the recording
      -- run served — not merely the right NUMBER of entries. This is the row that
      -- separates the two queues: the driver's tools carry OK-ALPHA and exit_code
      -- -1, the extension's carry EXT-EFFECT-n and a real code, and a projection
      -- that collected either class into the other passes the count and fails
      -- here.
      let ok_served = match replay_world.ext_effects {
        e :: _ =>
          check("effect: the reconstituted queue SERVES the recorded dispatch, content and exit code",
                e.content == "EXT-EFFECT-1" && e.exit_code == 41,
                "head is content=\"${e.content}\" exit_code=${show(e.exit_code)} — expected EXT-EFFECT-1/41; a queue holding the DRIVER's entries here means the two classes share a home"),
        [] =>
          check("effect: the reconstituted queue SERVES the recorded dispatch, content and exit code",
                false,
                "the reconstituted ext_effects queue is EMPTY, so a replay would perform a real subprocess at the first extension effect")
      };

      -- The replay itself, against the reconstituted world. No live arm is
      -- reachable for either class: both queues are seeded from the log.
      -- THE SAME `ext_id`, and this line is where the scenario's first draft was
      -- wrong in a way worth keeping on the record: it replayed under
      -- `"${ext_id}_replay"` and strict replay reported `WrongOrigin` at the
      -- first extension effect. That is the identity doing its job — the origin
      -- of this class NAMES THE EXTENSION, so a replay by a different extension
      -- is a different run, and the walk says so. It is also the cheapest
      -- available proof that the origin is read from the transport rather than
      -- being decorative.
      let replay = run_effect(ext_id, replay_world);
      let actual = replay.world.log;
      let ms = strict_replay_findings(program.interactions, actual);
      let _ = if List.length(ms) > 0 then println("      ${replay_message_first(ms)}") else ();
      let ok_replay = check("effect: the program replays to an identical interaction log, with nothing left unconsumed",
                            List.length(ms) == 0,
                            "${show(List.length(ms))} mismatch(es); UnusedInteraction here would mean the replay never asked for an effect the recording run performed");

      let ok_terminal = check("effect: the replay reproduces the terminal outcome",
                              (match replay.result { Ok(_) => true, Err(_) => false })
                                == (match run.result { Ok(_) => true, Err(_) => false }),
                              "the replay ended differently from the recorded run");

      ok_ran && ok_reached && ok_interleaved && ok_origin && ok_class && ok_balanced
        && t_pin && ok_valid && ok_rec && ok_served && ok_replay && ok_terminal
    }
  }
}

-- ===========================================================================
-- WI-D26: THE FIRST DETERMINISTIC COMPOSE AUTHORING LOOP IN THE PROJECT
-- ===========================================================================
--
-- Every scenario above this one drives a hook that WI-D19–WI-D24 wrote for this
-- file — compose's shape, in miniature, in this file's registry. This one
-- installs `motoko_ext_compose` itself, through `register_with_config`, and
-- drives `on_response_intercept`'s real body: `dir_make` -> `clock_now` ->
-- `file_write` -> `check_snippet` -> branch -> `file_remove`. The `check_snippet`
-- in that chain is WI-D26's routed site, and the `ailang check` it would run is
-- SERVED FROM `WorldState.ext_effects` instead of run.
--
-- WHAT THAT BUYS, AND IT IS THE ITEM'S HEADLINE: compose's authoring loop takes
-- its failure branch, on a compiler diagnostic that no compiler produced, in a
-- run that records, validates and replays. Before this item that sentence had no
-- referent — the `exec` was ambient, so a deterministic run of this path
-- performed a real subprocess and a replay performed it again.
--
-- WHY `on_response_intercept` AND NOT `handle_compose_tool`. The handoff asked
-- for the tool-handle chain, and that chain is not reachable deterministically:
-- `one_attempt` calls `callStreamResult` — compose's AMBIENT AI, a disclosed
-- class and explicitly out of this item's scope — before it ever reaches a
-- snippet to check. There is no branch through `handle_compose_tool` that
-- authors nothing. The intercept chain is the AI-free half of the same code:
-- SAME `check_snippet`, SAME `run_snippet`, same two call sites the item routed,
-- reached from a fenced response instead of from an authored one. So the
-- deviation is in the entry point and not in the subject, and the subject is the
-- routed seam.
--
-- ---------------------------------------------------------------------------
-- THE FIXTURE'S TWO EXIT CODES DISAGREE ON PURPOSE. This is the whole row.
-- ---------------------------------------------------------------------------
--
-- `ScriptedTool` carries `exit_code` as a TYPED field and `content` as the
-- string the ABI renders into `ExtProcOutcome.output`. In a LIVE run the two
-- cannot disagree: both come out of one `run_process_result`, which writes the
-- subprocess's code to the record and encodes that same record to JSON. In a
-- SCRIPTED world they are two independent fields, and this fixture sets them
-- apart — typed 71, embedded 0.
--
-- That is S33's distinguishing input, and it is one of the cases S33 names as
-- not having EXISTED until the project built it: WI-D22 added
-- `ScriptedTool.exit_code`, and the divergence became constructible in the same
-- edit. A routed `check_snippet` that reads the typed field sees 71 and fails
-- the check. One that recovers a code by parsing `output` — the pre-WI-D23 shape,
-- and the natural thing to write for anyone who remembers that the exit code
-- "is in the JSON" — sees 0 and passes it. Both compile. Both are green on every
-- live input and on every fixture whose two codes agree.
--
-- THE FIXTURE IS AN ORACLE AND IS NOT A CLAIM ABOUT PRODUCTION. Nothing here
-- says a real seam produces disagreeing codes; the row says compose reads the
-- one the ABI types. Stated because a reader who found `"exit_code":0` inside a
-- fixture whose typed code is 71 is owed the reason on the spot.
--
-- The stderr text is a REAL diagnostic, measured by running `ailang check` on a
-- module with an undefined variable through the production dispatcher, so the
-- `errors` assertion below is about the string compose actually forwards.

func compose_cfg() -> ComposeHostConfig {
  { compose: { mode: "inline",
               subagent_model: "dst-model",
               max_attempts: 1,
               effect_guard: "off",
               certificate_template: false,
               authoring: { structured: false,
                            author_tools: false,
                            author_tools_budget: 0,
                            author_tools_max_bytes: 4096,
                            author_tools_max_turns: 0,
                            author_tools_deny_globs: [],
                            authoring_budget: 0,
                            fallback_after: 0,
                            min_observed_chars: 0,
                            stdout_max_bytes: 0 },
               claimcheck: { enabled: false,
                             informalizer_model: "",
                             comparator_model: "",
                             timeout_ms: 0,
                             max_invocations: 0,
                             stdout_max_bytes: 0,
                             ledger_in_informalizer: false } },
    snippet_caps: ["IO"] }
}

-- The diagnostic, as `ailang check` really emits it. Kept as one function
-- because the fixture below embeds it in JSON and the assertion compares against
-- it — two spellings of one string is the drift S23 exists to stop.
func check_stderr_text() -> string {
  "Error: type error in tmp/inline_1 (decl 0): undefined variable: undefined_symbol_xyz"
}

-- The served answer. `content` is a `BashExecResult` rendering — the shape
-- `dispatch_one`'s `tool_result_item_to_json` produces and `proc.decode_bash_result`
-- reads — carrying the diagnostic on STDERR, which is where a real failing
-- `ailang check` puts it (progress goes to stdout; measured).
--
-- `exit_code: 71` on the ScriptedTool, `"exit_code":0` inside the content. See
-- the block above: the disagreement is the oracle. 71 is distinct from every
-- other quantity in this file (S7) — the driver's tools carry -1, D24's effects
-- 41/43/47/53/59/61, and the grep scenario below uses 1.
func compose_check_effects() -> [{ tool_call_id: string, duration_ms: int, code: string, message: string, content: string, exit_code: int }] {
  -- TWO entries against the ONE dispatch the script produces, and the slack is
  -- WI-D24's load-bearing kind rather than defensive: an empty `ext_effects`
  -- queue does not fail, it DELEGATES to the real dispatcher, so a fixture sized
  -- exactly to its expectation turns any future off-by-one into a live
  -- `ailang check` inside a deterministic gate. The second entry is never
  -- consumed and nothing here can see it — `reconstitution_balance` counts the
  -- queue the LOG rebuilds, not the one this function seeded.
  [{ tool_call_id: "", duration_ms: 43, code: "", message: "",
     content: "{\"tool\":\"BashExec\",\"cmd\":\"ailang check tmp/inline_1.ail\",\"exit_code\":0,\"stdout\":\"\",\"stderr\":\"${check_stderr_text()}\",\"truncated\":false}",
     exit_code: 71 },
   { tool_call_id: "", duration_ms: 47, code: "", message: "",
     content: "{\"tool\":\"BashExec\",\"cmd\":\"unreached\",\"exit_code\":0,\"stdout\":\"\",\"stderr\":\"\",\"truncated\":false}",
     exit_code: 73 }]
}

-- The response the model "returns". The fence is what `extract_ailang_fence`
-- looks for, and reaching it is what puts compose on the routed path at all —
-- a response without one returns `NoIntercept` before any effect happens, which
-- is the reachability half S24 requires be asserted separately.
func fenced_response() -> string {
  "here is the snippet\n```ailang\nexport func main() -> () ! {IO} { undefined_symbol_xyz() }\n```\n"
}

-- TWO prose steps and no tool steps. The intercept's `InterceptHandled` makes
-- the driver append a tool message and LOOP rather than dispatch tool calls, so
-- a script of tool steps would leave `WorldState.tools` unconsumed and put this
-- scenario's census in a different shape from every other one in this file for
-- reasons that have nothing to do with compose. The second step carries no
-- fence, so the intercept returns `NoIntercept` and the run finalises.
func compose_script() -> [ScriptedStep] {
  [prose_step(fenced_response()), prose_step("done")]
}

func compose_check_world() -> WorldState {
  { empty_world_state() |
    script: compose_script(),
    approvals: [],
    env: world_env(),
    ext_effects: compose_check_effects() }
}

func compose_rt() -> ExtRuntime ! {Env, FS, AI, Clock, IO, Process, Rand} {
  let v: VerificationConfig = { enabled: false, command: "" };
  -- THE REAL REGISTRY, WHOLESALE. Not `approval_hooks_of` with one slot
  -- overridden: the id, the tool policy, the pre-step and the solver slot are
  -- compose's own, so the origin the fold stamps onto the recorded effect is the
  -- extension's real id rather than one this file chose. WI-D24's scenario
  -- deliberately used an id no production registry contains, to kill an adapter
  -- that hardcoded "compose"; this one is the other half of that pair, and the
  -- id it asserts is "compose" because compose is the subject.
  { registry: { hooks: [Compose.register_with_config(compose_cfg())] },
    strict_mode: false, verification: v }
}

func run_compose(w: WorldState) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, SharedMem, Stream, Trace, Rand, Process} {
  Session.run_v2_session_traced(
    compose_rt(), "task", "", false, budget(), "phase-c-model", history(), ".",
    12, false, 0, zero_rates(), RecordingWorld(w)
  )
}

-- The decision compose returned, read off the MESSAGE LIST rather than off the
-- hook. `InterceptHandled` becomes a tool message the driver appends, and the
-- driver's own return value is that message list, so the run's transcript
-- carries compose's verdict — a witness the recorder did not write and compose
-- did not hand to this file.
pure func result_msgs(r: TracedSessionResult) -> [Message] {
  match r.result {
    Ok(msgs) => msgs,
    Err(_) => []
  }
}

pure func tool_message_contents(msgs: [Message]) -> [string] {
  match msgs {
    [] => [],
    m :: rest =>
      if m.role == "tool" then m.content :: tool_message_contents(rest)
      else tool_message_contents(rest)
  }
}

pure func any_contains(xs: [string], needle: string) -> bool {
  match xs {
    [] => false,
    x :: rest => if contains(x, needle) then true else any_contains(rest, needle)
  }
}

func compose_check_scenario() -> bool ! {AI, Clock, Env, FS, IO, Net, SharedMem, Stream, Trace, Rand, Process} {
  let _ = println("");
  let _ = println("-- WI-D26: COMPOSE's own check path, served from the world --");
  let initial = compose_check_world();
  let run = run_compose(initial);
  let log = run.world.log;
  let effects = count_kind(log, identity_kind(ExtensionEffectIdentity("", "", "")));

  let ok_ran = check("compose: the scenario reached its terminator",
                     match run.result { Ok(_) => true, Err(_) => false },
                     "the run returned Err, so every witness below is vacuous");

  -- REACHABILITY BEFORE VERDICT (S24). A `check_snippet` that never ran records
  -- nothing and asserts nothing, and that is byte-identical to every run in this
  -- tree before WI-D26.
  let ok_reached = check("compose: the routed check RAN — compose's own seam reached the recorder",
                         effects == 1,
                         "expect_extension_effect=${show(effects)}, expected 1; a routed call that never executes proves nothing, and more than one means the failure branch was not taken");

  -- THE ORIGIN IS COMPOSE'S OWN ID, off the transport.
  let origins = effect_origins(log);
  let ok_origin = check("compose: the recorded effect names compose as the performer",
                        all_equal(origins, "compose") && List.length(origins) == 1,
                        "origins=[${join(origins)}] — expected one \"compose\"");

  -- ---- THE BRANCH -------------------------------------------------------
  --
  -- THE ROW THE ITEM EXISTS FOR. Compose took the failure branch, and the only
  -- thing that could have told it to is `ExtProcOutcome.exit_code` — 71 on the
  -- typed field against 0 inside the rendered output. `ComposeInline` with
  -- exit_code 1 is what `on_response_intercept`'s `not checked.ok` arm builds;
  -- the success arm builds `mk_result(…, "inline", …)` and would have consumed a
  -- SECOND ext_effect, which is why the reachability row above pins 1 and not
  -- "at least 1".
  let tool_msgs = tool_message_contents(result_msgs(run));
  let ok_branch = check("compose: the FAILURE branch was taken, on the typed exit code and not on the rendered one",
                        any_contains(tool_msgs, "ComposeInline"),
                        "no ComposeInline tool message in the transcript — compose either did not intercept, or took the success branch, which is what reading \"exit_code\":0 out of `output` would do");

  -- AND IT FORWARDED THE SEAM'S STDERR. The branch alone does not establish that
  -- the streams survived the decode: a routed site that got the code right and
  -- dropped the text would pass the row above and hand the model an empty
  -- diagnostic, which is a worse failure than a wrong branch because nothing
  -- downstream can see it.
  let ok_errors = check("compose: the diagnostic came back through the decode, not lost with the rendering",
                        any_contains(tool_msgs, "undefined variable: undefined_symbol_xyz"),
                        "the ComposeInline result carries no diagnostic text — `decode_bash_result` lost the seam's stderr, and the model would be told the check failed for no stated reason");

  let _ = println("  recorded: expect_extension_effect=${show(effects)} origin=[${join(origins)}]");

  -- ---- VALIDATE and REPLAY ----------------------------------------------
  let program = program_of(run.world, initial);
  let rejections = validate_program(program, required_class_ids());
  let _ = if List.length(rejections) > 0 then println("      ${first_rejection_message(rejections)}") else ();
  let ok_valid = check("compose: the recorded program VALIDATES",
                       List.length(rejections) == 0,
                       "${show(List.length(rejections))} rejection(s)");

  match world_state_of(program, required_class_ids()) {
    Err(r) => {
      let _ = println("      ${refusal_message(r)}");
      let ok_recon = check("compose: the program reconstitutes a world", false,
                           "refused with ${refusal_rule(r)}");
      ok_ran && ok_reached && ok_origin && ok_branch && ok_errors && ok_valid && ok_recon
    },
    Ok(replay_world) => {
      -- THE RECONSTITUTED QUEUE MUST CARRY THE TYPED CODE. If the projection
      -- dropped `exit_code` — defaulting it to 0, which is the shape WI-D22's
      -- schema bump exists to refuse — the replay would take compose's SUCCESS
      -- branch and this scenario would be a recorded failure replaying as a pass.
      let ok_served = match replay_world.ext_effects {
        e :: _ =>
          check("compose: the reconstituted queue serves the same TYPED code the recording did",
                e.exit_code == 71,
                "head exit_code=${show(e.exit_code)} — expected 71; a 0 here is a recorded compiler failure replaying as a pass"),
        [] =>
          check("compose: the reconstituted queue serves the same TYPED code the recording did",
                false,
                "the reconstituted ext_effects queue is EMPTY, so a replay would run a real `ailang check`")
      };

      let replay = run_compose(replay_world);
      let ms = strict_replay_findings(program.interactions, replay.world.log);
      let _ = if List.length(ms) > 0 then println("      ${replay_message_first(ms)}") else ();
      let ok_replay = check("compose: the authoring loop REPLAYS to an identical interaction log",
                            List.length(ms) == 0,
                            "${show(List.length(ms))} mismatch(es)");

      let ok_replay_branch = check("compose: the REPLAY takes the same failure branch",
                                   any_contains(tool_message_contents(result_msgs(replay)), "ComposeInline"),
                                   "the replay produced no ComposeInline result — the recorded run failed the check and the replay did not");

      ok_ran && ok_reached && ok_origin && ok_branch && ok_errors && ok_valid
        && ok_served && ok_replay && ok_replay_branch
    }
  }
}

-- ===========================================================================
-- WI-D26: THE QUIET SEARCH — `grep_impl`'s no-match branch, which must NOT gate
-- on the exit code
-- ===========================================================================
--
-- `author_tools.grep_impl` is the one routed site in the compose package whose
-- typed exit code is available and deliberately unread, because ripgrep exits 1
-- when it matches nothing and that is a normal answer rather than a failure.
-- The site's own comment says so; this scenario is the input that makes the
-- claim cost something.
--
-- THE DIVERGENT INPUT IS A SEARCH WITH NO HITS. The seeded answer is exactly
-- what ripgrep produces for one — exit 1, empty stdout — and the correct
-- behaviour is to run `grep_fallback_scan`, which reads the file through
-- `ExtPorts` and finds the pattern the subprocess did not report. A routed form
-- that gated on `exit_code == 0` would skip the scan and return nothing, and
-- would be GREEN on every search that finds something, which is every realistic
-- fixture anyone would write (S33's mechanism).
--
-- THE SCAN'S OWN READS ARE NOT RECORDED — WI-D18 §6 decided reads are not, since
-- `InitialWorld` cannot rebuild them — so the census cannot see this. The
-- verdict is carried out of the hook by a `file_write`, which IS recorded and
-- which lands in the final world. That is WI-D20's `routing_tool_handle` shape:
-- put the observation somewhere a witness outside the hook can read it.
func grep_effects() -> [{ tool_call_id: string, duration_ms: int, code: string, message: string, content: string, exit_code: int }] {
  -- exit_code 1 with EMPTY stdout: ripgrep's "no matches". The embedded code
  -- agrees with the typed one here, unlike the check scenario's fixture — this
  -- row is not about which code is read, it is about the code not being read at
  -- all, so a disagreement would only muddy it.
  [{ tool_call_id: "", duration_ms: 53, code: "", message: "",
     content: "{\"tool\":\"BashExec\",\"cmd\":\"rg -n --no-heading -F needle_xyz haystack.txt\",\"exit_code\":1,\"stdout\":\"\",\"stderr\":\"\",\"truncated\":false}",
     exit_code: 1 },
   { tool_call_id: "", duration_ms: 59, code: "", message: "",
     content: "{\"tool\":\"BashExec\",\"cmd\":\"unreached\",\"exit_code\":1,\"stdout\":\"\",\"stderr\":\"\",\"truncated\":false}",
     exit_code: 1 }]
}

-- The file the FALLBACK SCAN must find the pattern in. It is in the world's
-- table and not on disk, so a scan that did not go through `ExtPorts` would read
-- nothing here either — which means this row also witnesses that WI-D20's FS
-- routing of the scan is real.
func grep_haystack() -> [{ path: string, node: FsNode }] {
  [{ path: "haystack.txt", node: FsFile("alpha\nbravo needle_xyz charlie\ndelta\n") }]
}

func grep_world() -> WorldState {
  { empty_world_state() |
    script: [prose_step("no fence here"), prose_step("done")],
    approvals: [],
    env: world_env(),
    files: grep_haystack(),
    ext_effects: grep_effects() }
}

-- The hook: compose's REAL `dispatch_author_tool_with_globs`, reached through
-- `ctx.ports`, with a grep tool call the model might have written. The verdict
-- is written to a path the scenario reads off the final world.
--
-- It returns `NoIntercept` so the driver's loop is unchanged; the effects happen
-- and only the decision is empty, which is `routing_intercept`'s arrangement one
-- module over.
func grep_probe_intercept(ctx: ExtCtx, _text: string)
  -> ResponseInterceptOutcome ! {IO, Process, FS, Clock} {
  let p = ctx.ports;
  let call = "{\"tool\":\"grep\",\"args\":{\"pattern\":\"needle_xyz\",\"path_glob\":\"haystack.txt\",\"max_matches\":10}}";
  let out = AuthorTools.dispatch_author_tool_with_globs(p, ctx.world, call, 4096, []);
  -- `excerpt` AND NOT `ok`: `grep_impl` answers `ok: true` on both branches, so
  -- a verdict read off `ok` would be satisfied by a grep that found nothing —
  -- the exact non-measurement this scenario exists to avoid.
  let verdict = if contains(out.excerpt, "needle_xyz") then "SCANNED" else "SKIPPED";
  let wrote = p.file_write(out.next_state, "grep_verdict.txt", verdict);
  { decision: NoIntercept, next_state: wrote.next_state }
}

func grep_rt(id: string) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  { registry: { hooks: [fixture_hooks(id, { approval_overrides() | intercept: grep_probe_intercept })] },
    strict_mode: false, verification: v }
}

func run_grep(id: string, w: WorldState) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, SharedMem, Stream, Trace, Rand, Process} {
  Session.run_v2_session_traced(
    grep_rt(id), "task", "", false, budget(), "phase-c-model", history(), ".",
    12, false, 0, zero_rates(), RecordingWorld(w)
  )
}

pure func file_content_of(files: [{ path: string, node: FsNode }], path: string) -> string {
  match files {
    [] => "(absent)",
    f :: rest =>
      if f.path == path then (match f.node { FsFile(c) => c, FsDir => "(dir)" })
      else file_content_of(rest, path)
  }
}

func compose_grep_quiet_scenario() -> bool ! {AI, Clock, Env, FS, IO, Net, SharedMem, Stream, Trace, Rand, Process} {
  let _ = println("");
  let _ = println("-- WI-D26: a QUIET ripgrep — exit 1 means no matches, not failure --");
  let initial = grep_world();
  let run = run_grep("ext_grep_26", initial);
  let effects = count_kind(run.world.log, identity_kind(ExtensionEffectIdentity("", "", "")));

  let ok_ran = check("grep: the scenario reached its terminator",
                     match run.result { Ok(_) => true, Err(_) => false },
                     "the run returned Err, so every witness below is vacuous");

  let ok_reached = check("grep: the routed search RAN — the seam reached the recorder",
                         effects > 0,
                         "expect_extension_effect=0; a routed call that never executes proves nothing");

  let verdict = file_content_of(run.world.files, "grep_verdict.txt");
  -- THE ROW. `SKIPPED` is what an `exit_code == 0` gate produces: the search
  -- exited 1, the gate calls that a failure, the fallback scan never runs and
  -- the caller is told there are no matches in a file that contains one.
  let ok_scanned = check("grep: a no-match search still runs the fallback scan — the exit code is NOT the gate",
                         verdict == "SCANNED",
                         "verdict=${verdict} — `grep_impl` gated on the exit code, so ripgrep's normal \"no matches\" answer (exit 1) suppressed the fallback scan; every quiet search silently loses its second chance");

  let _ = println("  verdict=${verdict} (expect_extension_effect=${show(effects)})");
  ok_ran && ok_reached && ok_scanned
}

pure func first_rejection_message(rs: [ProgramRejection]) -> string {
  match rs {
    [] => "(none)",
    r :: _ => program_message(r)
  }
}

pure func replay_message_first(ms: [ReplayMismatch]) -> string {
  match ms {
    [] => "(none)",
    m :: _ => "[${replay_rule(m)}] ${replay_message(m)}"
  }
}

-- ---------------------------------------------------------------------------
-- WI-D20: the routed `on_tool_handle` scenario
-- ---------------------------------------------------------------------------

-- `provided_tools: ["T"]` IS LOAD-BEARING AND IS THE ONE THING THAT DIFFERS
-- BESIDES THE SLOT. `on_tool_handle` is the ONE GATED slot in the ABI —
-- `ext/runtime.first_handle` only invokes a hook whose `provided_tools` contains
-- the call's tool name, and `script()` emits `tool_step("T", …)`. Left at `[]`
-- the hook is never invoked, every count below is zero, and the scenario passes
-- while measuring nothing. That is precisely the vacuity `ok_reached` exists to
-- refuse, and it is why this line has a comment.
func handle_rt(id: string) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  { registry: { hooks: [fixture_hooks(id, { approval_overrides() | tools: ["T"], provide: routing_tool_handle })] },
    strict_mode: false, verification: v }
}

func run_handle(id: string, w: WorldState) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(
    handle_rt(id), "task", "", false, budget(), "phase-c-model", history(), ".",
    12, false, 0, zero_rates(), RecordingWorld(w)
  )
}

-- The distinct filenames the hook left behind, read from the FINAL WORLD's
-- directory rather than from the interaction log.
--
-- This is the whole instrument. `count_kind(log, "file_write")` is 3 under every
-- one of the three behaviours — correct threading, a dropped successor, and a
-- stale `ctx.world` — because three writes happened in all three. What separates
-- them is whether they collided on one key, and only the world knows that.
-- `scripted_dir_list` is the SAME reader `ExtPorts.dir_list` bottoms out in, so
-- this row and the hook agree on what "the entries of `handled`" means by
-- construction rather than by a second implementation that could drift.
func handled_entries(w: WorldState) -> [string] ! {FS} {
  scripted_dir_list(w, "handled").entries
}

-- ---------------------------------------------------------------------------
-- WI-D20: the BATCH scenario, and why the scenario above could not be it
-- ---------------------------------------------------------------------------
--
-- THIS FIXTURE EXISTS BECAUSE THE ONE ABOVE MEASURED LESS THAN ITS LABEL, AND
-- THE MUTANT IS WHAT SAID SO. `routing_handle_scenario`'s threading row was
-- written claiming it caught BOTH driver defects — the dropped successor and the
-- stale `ctx.world`. Reverting the successor turned it red; reverting the
-- re-seating left it GREEN. The row was half an instrument and read like a whole
-- one.
--
-- WHY IT COULD NOT SEE THE SECOND HALF, and the reason is structural rather than
-- an oversight: `ctx` is rebuilt per BATCH, and `script()` emits one tool call per
-- assistant step, so every batch above holds exactly one call and a per-batch
-- `ctx` is never stale within it. The two answers agree on every single-call
-- batch BY CONSTRUCTION — which is WI-D18's empty-directory shape and WI-D19's
-- populated-directory shape for the third consecutive item.
--
-- THE DISTINGUISHING INPUT IS A BATCH OF TWO, and it needs BOTH halves:
--
--   * two tool calls in ONE assistant step, so the fold in
--     `dispatch_tool_entries_with_builtin` runs twice against one `ctx`;
--   * a policy that ALLOWS rather than one that suspends for approval, because
--     the pending path resolves one call at a time through `c2_loop` and builds a
--     fresh `ctx` for each — so an approval-gated batch of two is still, for this
--     defect, two batches of one.
--
-- Both differences are here and nowhere else in the file, which is why this
-- scenario carries its own runtime and its own script rather than sharing
-- `approval_hooks_of`'s policy.
func allow_policy(_ctx: ExtCtx, _call: ToolCallEnvelope) -> ToolPolicyDecision {
  Allow
}

-- ONE step carrying TWO calls. `ScriptedStep.tool_calls` is a list and nothing
-- but convention put one element in it; `tool_step` is not used here because it
-- builds the single-call shape this scenario exists to escape.
func two_call_step() -> ScriptedStep {
  { tool_step("T", "{}", "b0") | tool_calls: [{ id: "b0", name: "T", arguments: "{}" },
                                              { id: "b1", name: "T", arguments: "{}" }] }
}

func batch_script() -> [ScriptedStep] {
  [two_call_step(), prose_step("done")]
}

func batch_world() -> WorldState {
  { empty_world_state() |
    script: batch_script(),
    approvals: [],
    env: world_env(),
    tools: scripted_tools() }
}

func batch_rt(id: string) -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  { registry: { hooks: [fixture_hooks(id, { approval_overrides() | tools: ["T"],
                          policy: allow_policy,
                          provide: routing_tool_handle })] },
    strict_mode: false, verification: v }
}

func run_batch(id: string, w: WorldState) -> TracedSessionResult
  ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  Session.run_v2_session_traced(
    batch_rt(id), "task", "", false, budget(), "phase-c-model", history(), ".",
    12, false, 0, zero_rates(), RecordingWorld(w)
  )
}

func batch_handle_scenario() -> bool ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let _ = println("");
  let _ = println("-- WI-D20: TWO tool calls in ONE batch — the stale-ctx input --");
  let initial = batch_world();
  let run = run_batch("discovery_batch", initial);
  let entries = handled_entries(run.world);
  let log = run.world.log;

  let ok_ran = check("batch: the scenario reached its terminator",
                     match run.result { Ok(_) => true, Err(_) => false },
                     "the run returned Err, so every row below is vacuous");

  -- The batch really did hold TWO calls. Without this the scenario could silently
  -- degrade to a one-call batch — a script edit, a policy that denies the second —
  -- and the threading row below would go green for the reason it is meant to
  -- refuse. It is the `provided_tools` trap one level up.
  let ok_batched = check("batch: the fold really ran twice against ONE ctx",
                         count_kind(log, "dir_make") == 2,
                         "dir_make=${show(count_kind(log, "dir_make"))} — expected 2, one per call in a single batch. It reads 1 under EITHER of two causes and both are worth failing on: the batch stopped being a batch and the stale-ctx input was never presented, or the stale ctx was handed back as the successor and took the first call's log entry down with it");

  -- THE ROW THE FIXTURE WAS BUILT FOR. Both calls share one `ctx`, so the second
  -- one sees the first's world ONLY through `execute_allowed_tool_call`'s
  -- re-seating. Without it the second dispatch reads a `ctx.world` from before the
  -- batch, lists an empty `handled/`, and writes `call_0.ail` a second time — one
  -- entry where there should be two, with both `dir_make`s and both `file_write`s
  -- still faithfully logged and every class balanced.
  let ok_reseated = check("batch: the SECOND call in the batch saw the FIRST call's world",
                          show(entries) == show(["call_0.ail", "call_1.ail"]),
                          "handled/ holds ${show(entries)} — expected [call_0.ail, call_1.ail]; a single call_0.ail means the second dispatch was handed the batch-start ctx.world, which is the defect no class count can see");

  let _ = println("  handled/ holds ${show(List.length(entries))}: ${show(entries)} (dir_make=${show(count_kind(log, "dir_make"))} file_write=${show(count_kind(log, "file_write"))})");

  ok_ran && ok_batched && ok_reseated
}

func routing_handle_scenario() -> bool ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let _ = println("");
  let _ = println("-- WI-D20: a ROUTED on_tool_handle on a graded profile --");
  let initial = base_world([approve_line(), approve_line(), approve_line()]);
  let run = run_handle("discovery_handle", initial);
  let log = run.world.log;

  -- ONE `dir_make` and ONE `file_write` per DISPATCH, counted from the hook's own
  -- text, and the dispatch count is `tool_dispatches` — the witness read off tool
  -- ROLE MESSAGES in the returned conversation, which production driver code
  -- writes and which exists whether or not the recorder recorded anything.
  --
  -- NOT `provider_calls`. The intercept scenario above uses the provider count
  -- because the intercept fires once per assistant RESPONSE; this hook fires once
  -- per approved TOOL CALL, and `script()` ends with a prose terminator, so the
  -- two differ by one. Using the wrong one here is a green row for the wrong
  -- reason, which is why the two scenarios name different fields.
  let dispatches = tool_results_witnessed(match run.result { Ok(ms) => ms, Err(_) => [] });
  let w = { witness_for(initial, run, env_reads_always(1))
            | file_writes: dispatches, dir_makes: dispatches, file_removes: 0 };

  let ok_ran = check("handle: the scenario reached its terminator",
                     match run.result { Ok(_) => true, Err(_) => false },
                     "the run returned Err, so every witness below is vacuous");

  -- REACHABILITY, SEPARATE FROM VERDICT (S24), AND IT MEASURES WHAT ITS LABEL
  -- SAYS. The label claims the routed hook RAN, so the row reads the two classes
  -- the hook itself performs. It deliberately does NOT read `provider_calls` or
  -- `tool_dispatches`: both are non-zero in a run where the driver dispatched
  -- tools and `provided_tools` was left empty, which is the state this file was
  -- in before this scenario existed — the same measures-less-than-its-label
  -- defect WI-D19 §8 recorded and the third consecutive item to face it.
  let ok_reached = check("handle: the routed hook actually RAN — its seams reached the recorder",
                         count_kind(log, "dir_make") > 0 && count_kind(log, "file_write") > 0,
                         "dir_make=${show(count_kind(log, "dir_make"))} file_write=${show(count_kind(log, "file_write"))} — a gated hook whose provided_tools does not contain the tool is never invoked, and every row below would pass vacuously");

  let entries = handled_entries(run.world);
  let _ = println("  handled/ holds ${show(List.length(entries))} entr(y|ies): ${show(entries)} (dispatches ${show(dispatches)})");

  let fs = check_discovery(log, w);
  let _ = if List.length(fs) > 0 then report_findings(fs) else ();
  let ok_balanced = check("handle: the routed classes balance against a witness that is not the log",
                          List.length(fs) == 0,
                          "${show(List.length(fs))} finding(s) above");

  -- THE ROW THIS SCENARIO EXISTS FOR, and the one no count can stand in for.
  -- THREE distinct names means every dispatch observed its predecessor's world.
  -- ONE name means the successor was dropped or `ctx.world` was stale — and the
  -- census above is GREEN in that state, which is why this is a separate row and
  -- not a clause of `ok_balanced`.
  let ok_threaded = check("handle: each dispatch SAW the previous dispatch's world",
                          List.length(entries) == dispatches && dispatches > 1,
                          "handled/ holds ${show(List.length(entries))} entr(y|ies) ${show(entries)} against ${show(dispatches)} dispatches — fewer names than dispatches means the writes collided on call_0.ail, which is what a DROPPED SUCCESSOR produces. The stale-ctx defect is NOT visible here and is graded by batch_handle_scenario instead");

  ok_ran && ok_reached && ok_balanced && ok_threaded
}

export func main() -> () ! {AI, Clock, Env, FS, IO, Net, Process, SharedMem, Stream, Trace, Rand} {
  let _ = println("discovery_dst: WI-A13 stage 2 — completeness AND fidelity against driver_only");

  -- approve: three approvals granted, three native dispatches follow.
  let ok_approve = run_scenario("approve",
                                [approve_line(), approve_line(), approve_line()],
                                true, 1);

  -- deny: three approvals refused, ZERO dispatches. This is the scenario in
  -- which a recorder that logged an approval as a tool interaction is visible,
  -- and it is invisible in `approve` where the counts happen to agree.
  let ok_deny = run_scenario("deny",
                             [deny_line("alpha"), deny_line("bravo"), deny_line("charlie")],
                             false, 1);

  -- eof: THREE tool calls and ONE queued answer, so the approval queue runs dry
  -- and the last two reads hit end-of-input.
  --
  -- This scenario found two defects that `approve` and `deny` could not, and
  -- both were invisible for the same structural reason: each of those queues
  -- exactly as many answers as its run consumes, so "reads performed" and
  -- "answers consumed" are equal in both and any confusion between them is
  -- hidden. It is the drained-queue case, and it is the third distinct thing
  -- cluster 7's rule predicted — a fixture exercising a shape the balanced ones
  -- structurally cannot reach.
  --
  --   1. the cursor delta was the approval WITNESS, and it counts answers
  --      consumed rather than reads performed, so a CORRECT recorder was
  --      reported as over-recording — an over-rejection in the checker itself;
  --   2. an end-of-input approval read records `OutcomeMissing`, which stage 1's
  --      validator accepted only for an environment read, so a valid discovered
  --      log was rejected as a malformed program.
  --
  -- The first dispatch is approved and the remaining two are refused by the
  -- default-deny policy, so `tool_dispatches` is 1 while `approval_reads` is 3
  -- and `approvals_consumed` is 1 — three quantities that are pairwise distinct
  -- here and pairwise equal in `approve`.
  let ok_eof = run_scenario("eof", [approve_line()], true, 1);

  -- WI-D19: the first graded run in this tree whose extension routes a
  -- filesystem mutation through `ExtPorts`.
  let ok_routing = routing_scenario();

  -- WI-D20: the second routed slot, and the first graded run that can see
  -- whether one dispatch's world reached the next.
  let ok_handle = routing_handle_scenario();
  let ok_batch = batch_handle_scenario();

  -- WI-D24: the first graded run in this tree in which an EXTENSION-INITIATED
  -- dispatch is recorded under its own identity class, validated, and replayed
  -- from the world rather than performed again. It is the only scenario in this
  -- file that carries the round trip through to a replay, which is why it also
  -- imports `dst_replay`.
  let ok_effect = effect_scenario();

  -- WI-D26: the first deterministic run of COMPOSE's own authoring loop. The
  -- scenario above drives a hook this file wrote; these two install the
  -- extension and drive its real bodies.
  let ok_compose = compose_check_scenario();
  let ok_grep = compose_grep_quiet_scenario();

  let _ = println("");
  if ok_approve && ok_deny && ok_eof && ok_routing && ok_handle && ok_batch && ok_effect
     && ok_compose && ok_grep then
    println("discovery_dst PASS")
  else {
    let _ = println("discovery_dst FAIL");
    exit(1)
  }
}
