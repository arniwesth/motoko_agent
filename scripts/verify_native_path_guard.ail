-- scripts/verify_native_path_guard.ail
--
-- The native tools' symlink guard must refuse a path that resolves outside the
-- workdir. validate_path_common runs a bash guard that exits 43/44 on an
-- escape, and std/process `exec` returns Ok for ANY exit code (Err only when
-- the process cannot run), so a guard matched on `Ok(_)` accepted every path.
-- The lexical checks (absolute, `..`) never went through exec, so only
-- symlink escapes got past it; AILANG_FS_SANDBOX, where the TUI sets it, was
-- the only thing stopping them. This runs without that variable, so the guard
-- is the only thing under test.
--
-- `main` runs the checks twice, in a child with SHLVL unset and in one with
-- SHLVL=1, and fails if either leg fails. The caller's SHLVL used to decide the
-- result: the guard ran under `bash -lc`, a login shell sources ~/.bash_logout
-- on `exit`, Debian's stock file runs clear_console when SHLVL is 1, and under
-- `set -e` its failure turned the guard's 43 into 1, which read as a pass. The
-- guard now runs under `bash -c` and fails closed, so neither can recur; the two
-- legs keep it that way. The Motoko runtime has no SHLVL, so the unset leg is
-- the one production sees.
--
-- The guard needs only plain `realpath`, so every check runs on every
-- platform: no SKIP. It used GNU-only `realpath -m`, and on stock macOS let
-- these escapes through (#332). EditFile on an existing file goes through
-- atomic_write's mode copy, which used GNU-only `chmod --reference` and failed
-- every edit on macOS.
--
-- A third leg runs the checks with a HOME whose .bash_profile is `exit 0`. A
-- login shell would source it and exit 0 before the guard ran, which reads as
-- inside; the guard runs under `bash -c`, which sources no profile.
--
-- A fourth leg runs `no_resolver` with a `realpath` first on PATH that always
-- fails. The guard fails closed: a path it cannot judge is refused, inside ones
-- included, and a symlink escape writes nothing. Only that leg can notice a
-- return to failing open, because the guard no longer fails in normal use.
--
-- The guard has two copies, in src/core/tool_runtime (the native tools) and
-- motoko_ext_ailang_tools/register (inside_workdir); this asserts they are the
-- same string, so the escape checks below cover both.
--
-- Usage, from the repository root:
--   AILANG_RELAX_MODULES=1 ailang run --caps IO,FS,Process,Env,Clock \
--     --entry main scripts/verify_native_path_guard.ail
-- One leg, in whatever SHLVL the caller has: --entry scenario.
-- The fail-closed leg on its own needs a failing `realpath` first on PATH:
-- --entry no_resolver.
module scripts/verify_native_path_guard

import std/io (println, exit)
import std/string (contains, trim, split, startsWith, substring, length)
import std/bytes (toString)
import std/json (jo, ja, kv, js, jnum, encode)
import std/fs (readFileResult, fileExists, writeFileResult)
import std/process (exec)
import std/env (getEnvOr)
import std/result (Ok, Err)
import src/core/tool_dispatch_adapter (dispatch_one)
import src/core/tool_runtime (path_guard_script as native_guard)
import pkg/sunholo/motoko_ext_ailang_tools/register (path_guard_script as tools_guard)

func call(workdir: string, id: string, name: string, args: string) -> string ! {IO, FS, Process, Env, Clock} {
  dispatch_one(workdir, { id: id, name: name, arguments: args })
}

func check(label: string, ok: bool, detail: string) -> bool ! {IO} {
  if ok then { println("OK: ${label}"); true }
  else { println("FAIL: ${label} — ${detail}"); false }
}

func refused(result: string) -> bool {
  contains(result, "\"error\":true") && contains(result, "escapes workspace")
}

func refused_undecided(result: string) -> bool {
  contains(result, "\"error\":true") && contains(result, "could not judge the path")
}

func file_text(p: string) -> string ! {FS} {
  match readFileResult(p) { Ok(t) => t, Err(_) => "" }
}

-- The SHLVL this process really has, not the one the parent meant to give it.
func shlvl_seen() -> string ! {Process} {
  match exec("printenv", ["SHLVL"]) {
    Ok(out) => if out.exitCode == 0 then trim(toString(out.stdout)) else "unset",
    Err(_) => "unknown"
  }
}

export func scenario() -> () ! {IO, FS, Process, Env, Clock} {
  println("SHLVL seen: ${shlvl_seen()}");
  let root = match exec("mktemp", ["-d"]) { Ok(out) => trim(toString(out.stdout)), Err(_) => "" };
  if root == "" then { println("FAIL: mktemp -d"); exit(1) } else {
    let workdir = "${root}/work";
    let outside = "${root}/outside";
    let _ = exec("mkdir", ["-p", workdir, outside]);
    let _ = exec("ln", ["-s", outside, "${workdir}/link"]);
    let _ = writeFileResult("${outside}/secret.txt", "secret\n");
    let _ = writeFileResult("${workdir}/inside.txt", "inside\n");
    let _ = exec("ln", ["-s", "${outside}/ghost.txt", "${workdir}/ghost"]);
    -- A link whose name ends in a newline: `$(dirname ...)` drops it, so a
    -- guard walking with dirname looked up "nl", found nothing, and climbed
    -- past the link.
    let _ = exec("ln", ["-s", outside, "${workdir}/nl\n"]);

    let read_esc = call(workdir, "r1", "ReadFile",
      encode(jo([kv("path", js("link/secret.txt")), kv("start", jnum(1.0)), kv("end", jnum(5.0))])));
    let write_esc = call(workdir, "w1", "WriteFile",
      encode(jo([kv("path", js("link/planted.txt")), kv("content", js("planted"))])));
    let edit_esc = call(workdir, "e1", "EditFile",
      encode(jo([kv("path", js("link/secret.txt")),
        kv("edits", ja([jo([kv("old", js("secret")), kv("new", js("changed"))])]))])));
    let write_dangling = call(workdir, "w2", "WriteFile",
      encode(jo([kv("path", js("ghost")), kv("content", js("planted"))])));
    let write_nl = call(workdir, "w3", "WriteFile",
      encode(jo([kv("path", js("nl\n/planted_nl.txt")), kv("content", js("planted"))])));
    -- An empty workdir is ".": the guard judges it rather than refusing every
    -- call. Run from the repo root (the make target), so Makefile is inside.
    let read_empty_wd = call("", "r3", "ReadFile",
      encode(jo([kv("path", js("Makefile")), kv("start", jnum(1.0)), kv("end", jnum(2.0))])));
    let read_in = call(workdir, "r2", "ReadFile",
      encode(jo([kv("path", js("inside.txt")), kv("start", jnum(1.0)), kv("end", jnum(5.0))])));
    let _ = exec("chmod", ["640", "${workdir}/inside.txt"]);
    let edit_in = call(workdir, "e2", "EditFile",
      encode(jo([kv("path", js("inside.txt")),
        kv("edits", ja([jo([kv("old", js("inside")), kv("new", js("edited"))])]))])));
    let mode_in = match exec("bash", ["-c", "stat -c %a \"$1\" 2>/dev/null || stat -f %Lp \"$1\"", "mode", "${workdir}/inside.txt"]) {
      Ok(out) => trim(toString(out.stdout)), Err(_) => ""
    };

    let inside = [
      check("ReadFile inside the workdir still works", not contains(read_in, "\"error\":true"), read_in),
      check("ReadFile with an empty workdir is judged as \".\", not refused", not contains(read_empty_wd, "\"error\":true"), read_empty_wd),
      check("EditFile on an existing file inside the workdir works", not contains(edit_in, "\"error\":true") && file_text("${workdir}/inside.txt") == "edited\n", edit_in),
      check("...and keeps the file's mode bits", mode_in == "640", "mode is ${mode_in}")
    ];
    let escapes = [
      check("ReadFile through a symlink out of the workdir is refused", refused(read_esc), read_esc),
      check("WriteFile through a symlink out of the workdir is refused", refused(write_esc), write_esc),
      check("...and nothing was written outside", not fileExists("${outside}/planted.txt"), "planted.txt exists"),
      check("EditFile through a symlink out of the workdir is refused", refused(edit_esc), edit_esc),
      check("...and the outside file is unchanged", file_text("${outside}/secret.txt") == "secret\n", file_text("${outside}/secret.txt")),
      check("WriteFile through a dangling symlink out of the workdir is refused", refused(write_dangling), write_dangling),
      check("...and nothing was created outside", not fileExists("${outside}/ghost.txt"), "ghost.txt exists"),
      check("WriteFile through a symlink whose name ends in a newline is refused", refused(write_nl), write_nl),
      check("...and nothing appeared outside", not fileExists("${outside}/planted_nl.txt"), "planted_nl.txt exists")
    ];
    let shared = [
      check("tool_runtime and ailang_tools run the same guard script", native_guard() == tools_guard(), "the two path_guard_script copies differ")
    ];
    let results = inside ++ escapes ++ shared;
    let _ = exec("rm", ["-rf", root]);
    if all_true(results) then () else exit(1)
  }
}

-- Run with a `realpath` that always fails (see `main`). Every path must be
-- refused as undecided, not let through and not reported as an escape.
export func no_resolver() -> () ! {IO, FS, Process, Env, Clock} {
  let root = match exec("mktemp", ["-d"]) { Ok(out) => trim(toString(out.stdout)), Err(_) => "" };
  if root == "" then { println("FAIL: mktemp -d"); exit(1) } else {
    let workdir = "${root}/work";
    let outside = "${root}/outside";
    let _ = exec("mkdir", ["-p", workdir, outside]);
    let _ = exec("ln", ["-s", outside, "${workdir}/link"]);
    let _ = writeFileResult("${workdir}/inside.txt", "inside\n");
    let read_in = call(workdir, "r1", "ReadFile",
      encode(jo([kv("path", js("inside.txt")), kv("start", jnum(1.0)), kv("end", jnum(5.0))])));
    let write_esc = call(workdir, "w1", "WriteFile",
      encode(jo([kv("path", js("link/planted.txt")), kv("content", js("planted"))])));
    let results = [
      check("ReadFile inside the workdir is refused as undecided", refused_undecided(read_in), read_in),
      check("WriteFile through a symlink out of the workdir is refused as undecided", refused_undecided(write_esc), write_esc),
      check("...and nothing was written outside", not fileExists("${outside}/planted.txt"), "planted.txt exists")
    ];
    let _ = exec("rm", ["-rf", root]);
    if all_true(results) then () else exit(1)
  }
}

pure func all_true(xs: [bool]) -> bool {
  match xs { [] => true, x :: rest => x && all_true(rest) }
}

pure func count_ok(lines: [string]) -> int {
  match lines {
    [] => 0,
    l :: rest => (if startsWith(l, "OK: ") then 1 else 0) + count_ok(rest)
  }
}

func print_verdicts(label: string, lines: [string]) -> () ! {IO} {
  match lines {
    [] => (),
    l :: rest => {
      if startsWith(l, "OK: ") then println("OK: [${label}] ${substring_from(l, 4)}")
      else if startsWith(l, "FAIL: ") then println("FAIL: [${label}] ${substring_from(l, 6)}")
      else ();
      print_verdicts(label, rest)
    }
  }
}

pure func substring_from(s: string, n: int) -> string {
  substring(s, n, length(s))
}

-- How many OK lines a passing child prints: scenario's inside, escapes and
-- shared lists, and no_resolver's list. A leg that prints fewer did not run
-- every check.
pure func expected_checks() -> int { 14 }
pure func expected_no_resolver_checks() -> int { 3 }

-- One leg: `ailang run --entry <entry>` in a child, with AILANG_FS_SANDBOX
-- cleared and `pin` (env arguments) applied. Started through `env`, not a
-- shell, which would move SHLVL itself. A child that could not run, or that ran
-- without the pinned SHLVL or without every check passing, fails: a leg must
-- not pass by not testing.
func leg(label: string, pin: [string], entry: string, expected: int, shlvl: string) -> bool ! {IO, Process} {
  let argv = ["-u", "AILANG_FS_SANDBOX"] ++ pin ++ ["AILANG_RELAX_MODULES=1", "ailang", "run",
    "--caps", "IO,FS,Process,Env,Clock", "--entry", entry, "scripts/verify_native_path_guard.ail"];
  match exec("env", argv) {
    Err(_) => check("[${label}] the probe's child runs", false, "exec failed"),
    Ok(out) => {
      let text = toString(out.stdout);
      let lines = split(text, "\n");
      print_verdicts(label, lines);
      let pinned = if shlvl == "" then true
        else check("[${label}] the child really had that SHLVL", contains(text, "SHLVL seen: ${shlvl}\n"), text);
      let passed = check("[${label}] all ${show(expected)} checks ran and passed", out.exitCode == 0 && count_ok(lines) == expected,
        "exit ${show(out.exitCode)}, ${show(count_ok(lines))} OK");
      pinned && passed
    }
  }
}

-- A HOME whose .bash_profile exits 0, for the profile leg. Its .ailang links to
-- the real one, where ailang keeps its package cache.
func exit_zero_profile_home() -> string ! {Process} {
  match exec("bash", ["-c", "d=$(mktemp -d) && printf 'exit 0\\n' > \"$d/.bash_profile\" && ln -s \"$HOME/.ailang\" \"$d/.ailang\" && printf '%s' \"$d\""]) {
    Ok(out) => if out.exitCode == 0 then toString(out.stdout) else "",
    Err(_) => ""
  }
}

-- A directory holding a `realpath` that always fails, for the no_resolver leg.
func failing_realpath_dir() -> string ! {Process} {
  match exec("bash", ["-c", "d=$(mktemp -d) && printf '#!/bin/sh\\necho \"realpath: stubbed to fail\" >&2\\nexit 1\\n' > \"$d/realpath\" && chmod +x \"$d/realpath\" && printf '%s' \"$d\""]) {
    Ok(out) => if out.exitCode == 0 then toString(out.stdout) else "",
    Err(_) => ""
  }
}

export func main() -> () ! {IO, FS, Process, Env, Clock} {
  let unset_ok = leg("SHLVL unset", ["-u", "SHLVL"], "scenario", expected_checks(), "unset");
  let one_ok = leg("SHLVL 1", ["SHLVL=1"], "scenario", expected_checks(), "1");
  let home = exit_zero_profile_home();
  let profile_ok = if home == "" then check("[profile exits 0] a HOME with that profile was made", false, "mktemp or ln failed")
    else {
      let ok = leg("profile exits 0", ["-u", "SHLVL", "HOME=${home}"], "scenario", expected_checks(), "unset");
      let _ = exec("rm", ["-rf", home]);
      ok
    };
  let stub = failing_realpath_dir();
  let closed_ok = if stub == "" then check("[no realpath] a failing realpath stub was made", false, "mktemp or chmod failed")
    else {
      let path = getEnvOr("PATH", "/usr/bin:/bin");
      let ok = leg("no realpath", ["PATH=${stub}:${path}"], "no_resolver", expected_no_resolver_checks(), "");
      let _ = exec("rm", ["-rf", stub]);
      ok
    };
  if unset_ok && one_ok && profile_ok && closed_ok then () else exit(1)
}
