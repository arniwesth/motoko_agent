-- scripts/verify_native_path_guard.ail
--
-- The native tools' symlink guard must refuse a path that resolves outside the
-- workdir. validate_path_common runs a bash guard that exits 43/44 on an
-- escape, and std/process `exec` returns Ok for ANY exit code (Err only when
-- the process cannot run), so a guard matched on `Ok(_)` accepted every path.
-- The lexical checks (absolute, `..`) never went through exec, so only
-- symlink escapes got past it; AILANG_FS_SANDBOX, where the TUI sets it, was
-- the only thing stopping them. This runs without that variable, so the guard
-- is the only thing under test.
--
-- `main` runs the checks twice, in a child with SHLVL unset and in one with
-- SHLVL=1, and fails if either leg fails. The caller's SHLVL used to decide the
-- result: the guard ran under `bash -lc`, a login shell sources ~/.bash_logout
-- on `exit`, Debian's stock file runs clear_console when SHLVL is 1, and under
-- `set -e` its failure turned the guard's 43 into 1, which reads as a pass. The
-- Motoko runtime has no SHLVL, so the unset leg is the one production sees.
--
-- Usage, from the repository root:
--   AILANG_RELAX_MODULES=1 ailang run --caps IO,FS,Process,Env,Clock \
--     --entry main scripts/verify_native_path_guard.ail
-- One leg, in whatever SHLVL the caller has: --entry scenario.
module scripts/verify_native_path_guard

import std/io (println, exit)
import std/string (contains, trim, split, startsWith, substring, length)
import std/bytes (toString)
import std/json (jo, ja, kv, js, jnum, encode)
import std/fs (readFileResult, fileExists, writeFileResult)
import std/process (exec)
import std/result (Ok, Err)
import src/core/tool_dispatch_adapter (dispatch_one)

func call(workdir: string, id: string, name: string, args: string) -> string ! {IO, FS, Process, Env, Clock} {
  dispatch_one(workdir, { id: id, name: name, arguments: args })
}

func check(label: string, ok: bool, detail: string) -> bool ! {IO} {
  if ok then { println("OK: ${label}"); true }
  else { println("FAIL: ${label} — ${detail}"); false }
}

func refused(result: string) -> bool {
  contains(result, "\"error\":true") && contains(result, "escapes workspace")
}

func file_text(p: string) -> string ! {FS} {
  match readFileResult(p) { Ok(t) => t, Err(_) => "" }
}

-- The SHLVL this process really has, not the one the parent meant to give it.
func shlvl_seen() -> string ! {Process} {
  match exec("printenv", ["SHLVL"]) {
    Ok(out) => if out.exitCode == 0 then trim(toString(out.stdout)) else "unset",
    Err(_) => "unknown"
  }
}

export func scenario() -> () ! {IO, FS, Process, Env, Clock} {
  println("SHLVL seen: ${shlvl_seen()}");
  let root = match exec("mktemp", ["-d"]) { Ok(out) => trim(toString(out.stdout)), Err(_) => "" };
  if root == "" then { println("FAIL: mktemp -d"); exit(1) } else {
    let workdir = "${root}/work";
    let outside = "${root}/outside";
    let _ = exec("mkdir", ["-p", workdir, outside]);
    let _ = exec("ln", ["-s", outside, "${workdir}/link"]);
    let _ = writeFileResult("${outside}/secret.txt", "secret\n");
    let _ = writeFileResult("${workdir}/inside.txt", "inside\n");

    let read_esc = call(workdir, "r1", "ReadFile",
      encode(jo([kv("path", js("link/secret.txt")), kv("start", jnum(1.0)), kv("end", jnum(5.0))])));
    let write_esc = call(workdir, "w1", "WriteFile",
      encode(jo([kv("path", js("link/planted.txt")), kv("content", js("planted"))])));
    let edit_esc = call(workdir, "e1", "EditFile",
      encode(jo([kv("path", js("link/secret.txt")),
        kv("edits", ja([jo([kv("old", js("secret")), kv("new", js("changed"))])]))])));
    let read_in = call(workdir, "r2", "ReadFile",
      encode(jo([kv("path", js("inside.txt")), kv("start", jnum(1.0)), kv("end", jnum(5.0))])));

    let results = [
      check("ReadFile through a symlink out of the workdir is refused", refused(read_esc), read_esc),
      check("WriteFile through a symlink out of the workdir is refused", refused(write_esc), write_esc),
      check("...and nothing was written outside", not fileExists("${outside}/planted.txt"), "planted.txt exists"),
      check("EditFile through a symlink out of the workdir is refused", refused(edit_esc), edit_esc),
      check("...and the outside file is unchanged", file_text("${outside}/secret.txt") == "secret\n", file_text("${outside}/secret.txt")),
      check("ReadFile inside the workdir still works", not contains(read_in, "\"error\":true"), read_in)
    ];
    let _ = exec("rm", ["-rf", root]);
    if all_true(results) then () else exit(1)
  }
}

pure func all_true(xs: [bool]) -> bool {
  match xs { [] => true, x :: rest => x && all_true(rest) }
}

pure func count_ok(lines: [string]) -> int {
  match lines {
    [] => 0,
    l :: rest => (if startsWith(l, "OK: ") then 1 else 0) + count_ok(rest)
  }
}

func print_verdicts(label: string, lines: [string]) -> () ! {IO} {
  match lines {
    [] => (),
    l :: rest => {
      if startsWith(l, "OK: ") then println("OK: [SHLVL ${label}] ${substring_from(l, 4)}")
      else if startsWith(l, "FAIL: ") then println("FAIL: [SHLVL ${label}] ${substring_from(l, 6)}")
      else ();
      print_verdicts(label, rest)
    }
  }
}

pure func substring_from(s: string, n: int) -> string {
  substring(s, n, length(s))
}

-- One leg. A child that could not run, or that ran without the pinned SHLVL or
-- without all six checks passing, fails: a leg must not pass by not testing.
func leg(label: string, pin: [string]) -> bool ! {IO, Process} {
  let argv = ["-u", "AILANG_FS_SANDBOX"] ++ pin ++ ["AILANG_RELAX_MODULES=1", "ailang", "run",
    "--caps", "IO,FS,Process,Env,Clock", "--entry", "scenario", "scripts/verify_native_path_guard.ail"];
  match exec("env", argv) {
    Err(_) => check("[SHLVL ${label}] the probe's child runs", false, "exec failed"),
    Ok(out) => {
      let text = toString(out.stdout);
      let lines = split(text, "\n");
      print_verdicts(label, lines);
      let pinned = check("[SHLVL ${label}] the child really had that SHLVL", contains(text, "SHLVL seen: ${label}\n"), text);
      let passed = check("[SHLVL ${label}] all six checks ran and passed", out.exitCode == 0 && count_ok(lines) == 6,
        "exit ${show(out.exitCode)}, ${show(count_ok(lines))} OK");
      pinned && passed
    }
  }
}

export func main() -> () ! {IO, FS, Process, Env, Clock} {
  let unset_ok = leg("unset", ["-u", "SHLVL"]);
  let one_ok = leg("1", ["SHLVL=1"]);
  if unset_ok && one_ok then () else exit(1)
}
