export func main() -> () ! {IO} {
  let scenarios = [
    harness_self_test_scenario(),
    segment_excludes_system_prefix_scenario(),
    project_prep_vs_uncompacted_history_pressure_scenario(),
    empty_system_prompt_rejected_scenario(),
    oversized_payload_rejected_scenario(),
    ext_compaction_invalid_rejected_scenario(),
    summary_cache_replay_stable_scenario(),
    history_rewrite_requires_checkpoint_event_scenario(),
    checkpoint_never_emitted_when_policy_off_scenario(),
    checkpoint_emitted_under_pressure_scenario(),
    checkpoint_terminates_not_spins_scenario(),
    checkpoint_output_is_valid_transcript_scenario(),
    compactor_chain_order_is_registry_order_scenario(),
    invalid_stage_skipped_chain_continues_scenario(),
    actual_token_pressure_defers_to_seal_scenario()
  ];
  let failed = run_all(scenarios, 0);
  if failed == 0 then
    println("phase_c_l1_scenarios PASS count=${show(length(scenarios))}")
  else {
    let _ = println("phase_c_l1_scenarios FAIL failed=${show(failed)}");
    exit(1)
  }
}
