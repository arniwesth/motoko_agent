let qwen_model = "openrouter/qwen/qwen3.6-35b-a3b"
let runtime_status_call_id = "runtime-status-after-compaction"

type ScenarioFailure = { failed_invariant: string, trace: [string] }
type Scenario = { id: string, run: () -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} }
type LongStats = { applied: int, rejected: int, prepared: int, provider_results: int, projection: [string], final_count: int, final_digest: string, runtime_status_ok: bool }

func print_trace(lines: [string]) -> () ! {IO} {
  match lines {
    [] => (),
    line :: rest => {
      let _ = println("trace ${line}");
      print_trace(rest)
    }
  }
}

func run_one(s: Scenario) -> bool ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  match s.run() {
    Ok(_) => {
      println("scenario=${s.id} ok");
      true
    },
    Err(f) => {
      let _ = println("scenario=${s.id} invariant=${f.failed_invariant}");
      let _ = print_trace(f.trace);
      false
    }
  }
}

func run_all(scenarios: [Scenario], failed: int) -> int ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  match scenarios {
    [] => failed,
    s :: rest => {
      let ok = run_one(s);
      run_all(rest, if ok then failed else failed + 1)
    }
  }
}

func ok_or_failure(ok: bool, invariant_name: string, trace: [string]) -> Result[(), ScenarioFailure] {
  if ok then Ok(()) else Err({ failed_invariant: invariant_name, trace: trace })
}

func no_rates() -> CostRates {
  { input_per_1m_millicents: 0, output_per_1m_millicents: 0 }
}

func budget() -> BudgetPlan {
  { total: 40, solver: 40, verifier: 0 }
}

func msg(role: string, content: string) -> Message {
  { role: role, content: content, tool_calls: [], tool_call_id: "" }
}

func abi_msg(role: string, content: string) -> Msg {
  { role: role, content: content, tool_calls: [], tool_call_id: "" }
}

func abi_tool(id: string, content: string) -> Msg {
  { role: "tool", content: content, tool_calls: [], tool_call_id: id }
}

func abi_assistant(content: string, calls: [ToolCall]) -> Msg {
  { role: "assistant", content: content, tool_calls: calls, tool_call_id: "" }
}

func tool_call(id: string) -> ToolCall {
  { id: id, name: "LongResult", arguments: "{\"marker\":\"${id}\"}" }
}

func runtime_status_call() -> ToolCall {
  { id: runtime_status_call_id, name: "MotokoRuntimeStatus", arguments: "{}" }
}

func step_marker(n: int) -> string {
  "long-qwen-step-${show(n)}"
}

func filler_block() -> string {
  " deterministic tool payload abcdefghijklmnopqrstuvwxyz 0123456789 abcdefghijklmnopqrstuvwxyz 0123456789"
}

func repeat_block(n: int) -> string {
  if n <= 0 then "" else "${filler_block()}${repeat_block(n - 1)}"
}

func long_stdout(current: string, next: string) -> string {
  "tool-result current=${current} next=${next}${repeat_block(8)}"
}

func is_summarizer_prompt(msgs: [Message]) -> bool {
  match msgs {
    m :: [] => m.role == "user" && length(m.tool_calls) == 0 && m.tool_call_id == "",
    _ => false
  }
}

func contains_marker(msgs: [Message], marker: string) -> bool {
  match msgs {
    [] => false,
    m :: rest => if contains(m.content, marker) || m.tool_call_id == marker then true else contains_marker(rest, marker)
  }
}

func highest_agent_idx_from_markers(msgs: [Message], n: int) -> int {
  if n <= 0 then 1
  else if contains_marker(msgs, step_marker(n)) then n
  else highest_agent_idx_from_markers(msgs, n - 1)
}

func step_result(content: string, calls: [ToolCall], finish: string) -> StepResult {
  {
    message: { role: "assistant", content: content, tool_calls: [], tool_call_id: "" },
    tool_calls: calls,
    finish_reason: finish,
    input_tokens: 100,
    output_tokens: 40,
    cache_read_input_tokens: 0,
    cache_creation_input_tokens: 0
  }
}

func routed_step(max_tools: int, model: string, msgs: [Message], _on_chunk: (StreamChunk) -> () ! {IO}) -> Result[StepResult, AIError] ! {AI, IO, Trace} {
  if is_summarizer_prompt(msgs) then {
    let prompt = match msgs { m :: [] => m.content, _ => "" };
    Ok(step_result("summary:${show(string_length(prompt))}", [], "stop"))
  } else {
    let idx = highest_agent_idx_from_markers(msgs, max_tools + 1);
    if idx <= max_tools then {
      let marker = step_marker(idx);
      Ok(step_result("calling LongResult ${marker}", [tool_call(marker)], "tool_calls"))
    } else if not contains_marker(msgs, runtime_status_call_id) then {
      Ok(step_result("checking runtime status after compaction", [runtime_status_call()], "tool_calls"))
    } else {
      Ok(step_result("long qwen deterministic run complete", [], "stop"))
    }
  }
}

func fixed_clock() -> int ! {Clock} { 123456789 }
func fixed_env(_key: string, fallback: string) -> string ! {Env} { fallback }
func fixed_exec(_name: string, _args: string) -> string ! {IO, Process, FS} { "" }

func runtime_hooks() -> ExtRuntime ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
  long_runtime()
}

func long_ports(max_tools: int) -> Ports ! {AI, IO, Trace} {
  let model_step = func(model: string, msgs: [Message], on_chunk: (StreamChunk) -> () ! {IO})
    -> Result[StepResult, AIError] ! {AI, IO, Trace} {
    routed_step(max_tools, model, msgs, on_chunk)
  };
  let base = ports_shape_probe(model_step, runtime_hooks);
  {
    model_step: base.model_step,
    approval_read: base.approval_read,
    clock_now: fixed_clock,
    env_get: fixed_env,
    tool_exec: fixed_exec,
    hooks_runtime: runtime_hooks
  }
}

-- ---------------------------------------------------------------------------
-- Strict-provider fixture (models hy3:free/Novita). Rejects any payload that
-- contains an assistant tool_call without a matching tool result (an orphaned
-- tool_call — invalid per the OpenAI tool-call protocol). The scripted run's
-- SECOND agent turn emits a tool_call with finish_reason="stop" (the hy3:free
-- quirk); the loop must still run that tool and continue, so the strict
-- provider never sees an orphaned-tool-call payload.
-- ---------------------------------------------------------------------------

func strict_has_tool_result_for(msgs: [Message], id: string) -> bool {
  match msgs {
    [] => false,
    m :: rest => if m.role == "tool" && m.tool_call_id == id then true else strict_has_tool_result_for(rest, id)
  }
}

func strict_calls_all_answered(all: [Message], calls: [ToolCall]) -> bool {
  match calls {
    [] => true,
    c :: rest => if strict_has_tool_result_for(all, c.id) then strict_calls_all_answered(all, rest) else false
  }
}

func strict_orphan_scan(all: [Message], rest: [Message]) -> bool {
  match rest {
    [] => false,
    m :: tail =>
      if m.role == "assistant" && length(m.tool_calls) > 0 && not strict_calls_all_answered(all, m.tool_calls)
      then true
      else strict_orphan_scan(all, tail)
  }
}

func payload_has_orphaned_toolcall(msgs: [Message]) -> bool {
  strict_orphan_scan(msgs, msgs)
}

func routed_step_strict(_model: string, msgs: [Message], _on_chunk: (StreamChunk) -> () ! {IO}) -> Result[StepResult, AIError] ! {AI, IO, Trace} {
  if payload_has_orphaned_toolcall(msgs) then
    Err({ code: "ProtocolError", message: "strict provider: payload contains an unanswered tool_call", retryable: false })
  else if is_summarizer_prompt(msgs) then
    Ok(step_result("strict summary", [], "stop"))
  else {
    let idx = highest_agent_idx_from_markers(msgs, 4);
    if idx <= 3 then {
      -- idx==2 is the hy3:free quirk: tool_calls present, finish_reason="stop".
      let finish = if idx == 2 then "stop" else "tool_calls";
      Ok(step_result("calling LongResult ${step_marker(idx)} - task still in progress, continuing", [tool_call(step_marker(idx))], finish))
    } else if not contains_marker(msgs, runtime_status_call_id) then
      Ok(step_result("checking runtime status after compaction", [runtime_status_call()], "tool_calls"))
    else
      Ok(step_result("strict deterministic run complete", [], "stop"))
  }
}

func strict_ports() -> Ports ! {AI, IO, Trace} {
  let model_step = func(model: string, msgs: [Message], on_chunk: (StreamChunk) -> () ! {IO})
    -> Result[StepResult, AIError] ! {AI, IO, Trace} {
    routed_step_strict(model, msgs, on_chunk)
  };
  let base = ports_shape_probe(model_step, runtime_hooks);
  {
    model_step: base.model_step,
    approval_read: base.approval_read,
    clock_now: fixed_clock,
    env_get: fixed_env,
    tool_exec: fixed_exec,
    hooks_runtime: runtime_hooks
  }
}

func run_strict() -> TracedSessionResult ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  Session.run_v2_session_traced(
    long_runtime(),
    "strict provider orphaned-toolcall dst",
    "",
    false,
    budget(),
    qwen_model,
    initial_history(),
    ".",
    40,
    false,
    0,
    no_rates(),
    Ported(strict_ports())
  )
}

func compaction_ai_hook() -> ExtensionHooks {
  let cfg: CompactionAiConfig = {
    model: qwen_model,
    threshold_pct: 60,
    keep_recent: 8,
    keep_recent_tokens: 600,
    min_relief_pct: 5,
    rate_limit_enabled: false,
    min_gap_steps: 3,
    hard_override_pct: 95
  };
  {
    id: "compaction_ai",
    provided_tools: [],
    on_describe_tools: \_ . [],
    on_build_system_prompt: \_ . { prepend: [], append: [] },
    on_budget_plan: \_ _ . { requested_total: None, requested_solver: None, requested_verifier: None } ! {Env, FS},
    on_pre_step: func(ctx: ExtCtx, msgs: [Msg]) -> PreStepDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
      compact_with_ai(ctx, msgs, cfg)
    },
    on_tool_policy: \_ _ . Allow,
    on_tool_handle: \_ _ . Delegate ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream},
    on_response_intercept: \_ _ . NoIntercept ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream},
    on_solver_candidate: \_ _ . NoDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream}
  }
}

func structural_hook() -> ExtensionHooks {
  {
    id: "compaction_structural",
    provided_tools: [],
    on_describe_tools: \_ . [],
    on_build_system_prompt: \_ . { prepend: [], append: [] },
    on_budget_plan: \_ _ . { requested_total: None, requested_solver: None, requested_verifier: None } ! {Env, FS},
    on_pre_step: func(ctx: ExtCtx, msgs: [Msg]) -> PreStepDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
      compact_for_pre_step(ctx, msgs)
    },
    on_tool_policy: \_ _ . Allow,
    on_tool_handle: \_ _ . Delegate ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream},
    on_response_intercept: \_ _ . NoIntercept ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream},
    on_solver_candidate: \_ _ . NoDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream}
  }
}

func next_marker_from_call_id(id: string) -> string {
  if id == step_marker(1) then step_marker(2)
  else if id == step_marker(2) then step_marker(3)
  else if id == step_marker(3) then step_marker(4)
  else if id == step_marker(4) then step_marker(5)
  else if id == step_marker(5) then step_marker(6)
  else if id == step_marker(6) then step_marker(7)
  else if id == step_marker(7) then step_marker(8)
  else if id == step_marker(8) then step_marker(9)
  else if id == step_marker(9) then step_marker(10)
  else if id == step_marker(10) then step_marker(11)
  else if id == step_marker(11) then step_marker(12)
  else step_marker(13)
}

func long_tool_hook() -> ExtensionHooks {
  {
    id: "long_result_tool",
    provided_tools: ["LongResult"],
    on_describe_tools: \_ . [{ name: "LongResult", description: "deterministic long-result fixture", parameters: "{\"type\":\"object\"}" }],
    on_build_system_prompt: \_ . { prepend: [], append: [] },
    on_budget_plan: \_ _ . { requested_total: None, requested_solver: None, requested_verifier: None } ! {Env, FS},
    on_pre_step: \_ _ . PassThrough ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream},
    on_tool_policy: \_ _ . Allow,
    on_tool_handle: func(_ctx: ExtCtx, call) -> ToolHandleDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream} {
      let next = next_marker_from_call_id(call.id);
      Handled({
        tool_call_id: call.id,
        tool: call.tool,
        exit_code: 0,
        stdout: long_stdout(call.id, next),
        stderr: "",
        metadata: jo([kv("fixture", js("long_qwen")), kv("next", js(next))])
      })
    },
    on_response_intercept: \_ _ . NoIntercept ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream},
    on_solver_candidate: \_ _ . NoDecision ! {IO, Process, FS, AI, Env, Net, SharedMem, Clock, Stream}
  }
}

func long_runtime() -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  let reg: ExtRegistry = { hooks: [compaction_ai_hook(), structural_hook(), long_tool_hook()] };
  { registry: reg, strict_mode: false, verification: v }
}

func structural_only_runtime() -> ExtRuntime {
  let v: VerificationConfig = { enabled: false, command: "" };
  let reg: ExtRegistry = { hooks: [structural_hook()] };
  { registry: reg, strict_mode: false, verification: v }
}

func initial_history() -> [Message] {
  [
    msg("system", "deterministic long qwen compaction dst system prompt"),
    msg("user", "Start the long deterministic tool loop. ${step_marker(1)}")
  ]
}

func run_long() -> TracedSessionResult ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  Session.run_v2_session_traced(
    long_runtime(),
    "long qwen compaction dst",
    "",
    false,
    budget(),
    qwen_model,
    initial_history(),
    ".",
    40,
    false,
    0,
    no_rates(),
    Ported(long_ports(12))
  )
}

func digest_msgs(msgs: [Message], acc: int) -> string {
  match msgs {
    [] => show(acc),
    m :: rest => digest_msgs(rest, acc + string_length(m.role) + string_length(m.content) + string_length(m.tool_call_id) + length(m.tool_calls))
  }
}

func record_projection(r: LedgerRecord) -> string {
  match r {
    CompactionStageRecord(s) => {
      let tag = match s.outcome {
        TraceStageApplied(note) => "applied:${note}",
        TraceStageRejected(reason) => "rejected:${reason}",
        TraceStageObserved(code, fields) => "observed:${code}:${show(fields)}",
        TraceStagePassed => "passed"
      };
      "stage step=${show(s.step)} ext=${s.ext_id} ${tag}"
    },
    WireRecord(ev) => event_projection(ev),
    DecisionRecord(d) => "decision step=${show(d.step)} ${d.decision}"
  }
}

func event_projection(ev: LedgerEvent) -> string {
  match ev {
    ProviderCallPrepared(i) => "prepared step=${show(i.step)} model=${i.model} msg=${show(i.msg_count)} est=${show(i.estimated_input_tokens)} sys=${show(i.system_prefix_count)} chars=${show(i.system_prefix_chars)} sys_digest=${i.system_prefix_digest} digest=${i.payload_digest}",
    ProviderResult(i) => "provider_result step=${show(i.step)} finish=${i.finish_reason} tools=${show(i.tool_calls)}",
    CompactionExhausted(info) => "compaction_exhausted step=${show(info.step)}",
    ErrorEvent(info) => "error code=${info.code}",
    RunSummary(info) => "run_summary finish=${info.finish_reason} steps=${show(info.steps_executed)} error=${info.error}",
    _ => "event"
  }
}

func projection_records(records: [LedgerRecord]) -> [string] {
  match records {
    [] => [],
    r :: rest => record_projection(r) :: projection_records(rest)
  }
}

func applied_count(records: [LedgerRecord]) -> int {
  match records {
    [] => 0,
    r :: rest => {
      let inc = match r {
        CompactionStageRecord(s) => if s.ext_id == "compaction_ai" then match s.outcome { TraceStageApplied(_) => 1, _ => 0 } else 0,
        _ => 0
      };
      inc + applied_count(rest)
    }
  }
}

func rejected_count(records: [LedgerRecord]) -> int {
  match records {
    [] => 0,
    r :: rest => {
      let inc = match r {
        CompactionStageRecord(s) => match s.outcome { TraceStageRejected(_) => 1, _ => 0 },
        _ => 0
      };
      inc + rejected_count(rest)
    }
  }
}

func prepared_count(records: [LedgerRecord]) -> int {
  match records {
    [] => 0,
    r :: rest => {
      let inc = match r { WireRecord(ProviderCallPrepared(_)) => 1, _ => 0 };
      inc + prepared_count(rest)
    }
  }
}

func provider_result_count(records: [LedgerRecord]) -> int {
  match records {
    [] => 0,
    r :: rest => {
      let inc = match r { WireRecord(ProviderResult(_)) => 1, _ => 0 };
      inc + provider_result_count(rest)
    }
  }
}

func has_exhausted_or_system_empty(records: [LedgerRecord]) -> bool {
  match records {
    [] => false,
    r :: rest => {
      let here = match r {
        WireRecord(CompactionExhausted(_)) => true,
        WireRecord(ErrorEvent(info)) => info.code == "SystemPromptEmpty",
        _ => false
      };
      here || has_exhausted_or_system_empty(rest)
    }
  }
}

func prepared_fields_ok(records: [LedgerRecord]) -> bool {
  match records {
    [] => true,
    r :: rest => {
      let here = match r {
        WireRecord(ProviderCallPrepared(info)) =>
          info.model == qwen_model && info.estimated_input_tokens > 0 && info.system_prefix_count >= 1 && info.system_prefix_chars > 0 && digest_shape_ok(info.system_prefix_digest) && info.payload_digest != "",
        _ => true
      };
      here && prepared_fields_ok(rest)
    }
  }
}

func digest_shape_ok(d: string) -> bool {
  string_length(d) == 71 && substring(d, 0, 7) == "sha256:"
}

func first_system_prefix_digest(records: [LedgerRecord]) -> string {
  match records {
    [] => "",
    r :: rest => match r {
      WireRecord(ProviderCallPrepared(info)) => info.system_prefix_digest,
      _ => first_system_prefix_digest(rest)
    }
  }
}

func system_prefix_digest_stable(records: [LedgerRecord], expected: string) -> bool {
  match records {
    [] => expected != "",
    r :: rest => {
      let here = match r {
        WireRecord(ProviderCallPrepared(info)) => info.system_prefix_digest == expected,
        _ => true
      };
      here && system_prefix_digest_stable(rest, expected)
    }
  }
}

func runtime_status_after_compaction_ok(msgs: [Message], expected_digest: string) -> bool {
  match msgs {
    [] => false,
    m :: rest => {
      let here =
        m.role == "tool"
          && m.tool_call_id == runtime_status_call_id
          && contains(m.content, "\"tool\":\"MotokoRuntimeStatus\"")
          && contains(m.content, "\"provider_calls_started\":")
          && contains(m.content, "\"provider_calls_completed\":")
          && contains(m.content, "\"steps_executed_so_far\":")
          && contains(m.content, "\"compaction_ai_applied\":")
          && not contains(m.content, "\"compaction_ai_applied\":0")
          && contains(m.content, "\"digest\":\"${expected_digest}\"");
      here || runtime_status_after_compaction_ok(rest, expected_digest)
    }
  }
}

func provider_result_after_prepared(records: [LedgerRecord], step: int, seen_prepared: bool) -> bool {
  match records {
    [] => false,
    r :: rest => match r {
      WireRecord(ProviderCallPrepared(info)) =>
        if info.step == step then provider_result_after_prepared(rest, step, true)
        else provider_result_after_prepared(rest, step, seen_prepared),
      WireRecord(ProviderResult(info)) =>
        if seen_prepared && info.step == step then true
        else provider_result_after_prepared(rest, step, seen_prepared),
      CompactionStageRecord(s) =>
        if s.ext_id == "compaction_ai" && s.step > step then false
        else provider_result_after_prepared(rest, step, seen_prepared),
      _ => provider_result_after_prepared(rest, step, seen_prepared)
    }
  }
}

func applied_stages_have_dispatch_success(records: [LedgerRecord], all_records: [LedgerRecord]) -> bool {
  match records {
    [] => true,
    r :: rest => {
      let here = match r {
        CompactionStageRecord(s) =>
          if s.ext_id == "compaction_ai" then match s.outcome {
            TraceStageApplied(_) => provider_result_after_prepared(all_records, s.step, false),
            _ => true
          } else true,
        _ => true
      };
      here && applied_stages_have_dispatch_success(rest, all_records)
    }
  }
}

func summarize_long_result(result: TracedSessionResult) -> Result[LongStats, ScenarioFailure] {
  match result.result {
    Err(e) => Err({ failed_invariant: "session result is Ok", trace: ["${e.code}: ${e.message}"] }),
    Ok(final_history) => {
      let records = result.trace.records;
      let stats = {
        applied: applied_count(records),
        rejected: rejected_count(records),
        prepared: prepared_count(records),
        provider_results: provider_result_count(records),
        projection: projection_records(records) ++ ["final count=${show(length(final_history))} digest=${digest_msgs(final_history, 0)}"],
        final_count: length(final_history),
        final_digest: digest_msgs(final_history, 0),
        runtime_status_ok: runtime_status_after_compaction_ok(final_history, first_system_prefix_digest(records))
      };
      Ok(stats)
    }
  }
}

func scenario_multiple_compactions() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  let result = run_long();
  match summarize_long_result(result) {
    Err(f) => Err(f),
    Ok(s) => {
      let records = result.trace.records;
      if s.applied < 3 then Err({ failed_invariant: "at least three compaction_ai stages applied", trace: s.projection })
      else if s.rejected != 0 then Err({ failed_invariant: "no TraceStageRejected records", trace: s.projection })
      else if has_exhausted_or_system_empty(records) then Err({ failed_invariant: "no compaction exhausted or SystemPromptEmpty", trace: s.projection })
      else if not prepared_fields_ok(records) then Err({ failed_invariant: "prepared call has Qwen model, system prefix, and digest", trace: s.projection })
      else if not system_prefix_digest_stable(records, first_system_prefix_digest(records)) then Err({ failed_invariant: "system prefix digest is stable across provider calls", trace: s.projection })
      else if not s.runtime_status_ok then Err({ failed_invariant: "runtime status tool reports compaction and stable system digest", trace: s.projection })
      else if not applied_stages_have_dispatch_success(records, records) then Err({ failed_invariant: "each applied compaction_ai stage has same-step ProviderCallPrepared then ProviderResult", trace: s.projection })
      else if s.prepared < s.applied then Err({ failed_invariant: "each compaction reaches provider_call_prepared", trace: s.projection })
      else if s.provider_results < s.prepared then Err({ failed_invariant: "each prepared provider call has ProviderResult", trace: s.projection })
      else {
        let _ = println("long_qwen_counts applied=${show(s.applied)} rejected=${show(s.rejected)} prepared=${show(s.prepared)} provider_results=${show(s.provider_results)} projection_records=${show(length(s.projection))}");
        ok_or_failure(s.final_count >= 25, "persisted history grows through tool loop", s.projection)
      }
    }
  }
}

func scenario_seal_side_exhaustion() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  let history = [
    msg("system", "seal-side exhaustion system prompt"),
    msg("user", "prose bulk ${repeat_block(80)}")
  ];
  let result = Session.run_v2_session_traced(
    structural_only_runtime(),
    "seal-side exhaustion dst",
    "",
    false,
    budget(),
    qwen_model,
    history,
    ".",
    4,
    false,
    0,
    no_rates(),
    Ported(long_ports(1))
  );
  let records = result.trace.records;
  match result.result {
    Ok(_) => Err({ failed_invariant: "oversized non-tool window is rejected by seal", trace: projection_records(records) }),
    Err(e) =>
      if contains(e.message, "compaction_exhausted") && has_exhausted_or_system_empty(records) then Ok(())
      else Err({ failed_invariant: "CompactionExhausted event and error are emitted", trace: ["${e.code}: ${e.message}"] ++ projection_records(records) })
  }
}

func same_string_list(a: [string], b: [string]) -> bool {
  match a {
    [] => match b { [] => true, _ => false },
    x :: xs => match b { [] => false, y :: ys => x == y && same_string_list(xs, ys) }
  }
}

func scenario_replay_deterministic() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  let r1 = run_long();
  let r2 = run_long();
  match summarize_long_result(r1) {
    Err(f) => Err(f),
    Ok(s1) => match summarize_long_result(r2) {
      Err(f) => Err(f),
      Ok(s2) => {
        let same = same_string_list(s1.projection, s2.projection);
        if same then {
          let _ = println("long_qwen_replay deterministic=true projection_records=${show(length(s1.projection))}");
          Ok(())
        }
        else Err({ failed_invariant: "normalized trace projection replays deterministically", trace: ["left_count=${show(length(s1.projection))}", "right_count=${show(length(s2.projection))}"] ++ s1.projection })
      }
    }
  }
}

-- A stop-finish tool turn must run its tool and continue (never ship an
-- orphaned tool_call). Two failure modes are both caught:
--   (1) the loop drops the tool_call and finalizes early -> never reaches
--       step-3 in the final history;
--   (2) it drops the call but a later turn ships the orphaned payload -> the
--       strict provider rejects it (session result is Err).
-- Also asserts the strict run replays deterministically.
func scenario_strict_provider_rejects_orphaned_toolcall() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  let r1 = run_strict();
  let recs1 = projection_records(r1.trace.records);
  match r1.result {
    Err(e) =>
      Err({ failed_invariant: "strict provider must never receive an orphaned tool_call payload", trace: ["${e.code}: ${e.message}"] ++ recs1 }),
    Ok(final_history) =>
      if not contains_marker(final_history, step_marker(3)) then
        Err({ failed_invariant: "stop-finish tool turn must run its tool and continue past step-3", trace: recs1 ++ ["final digest=${digest_msgs(final_history, 0)}"] })
      else {
        let r2 = run_strict();
        let recs2 = projection_records(r2.trace.records);
        if same_string_list(recs1, recs2) then {
          let _ = println("strict_provider_orphaned_toolcall ok deterministic=true records=${show(length(recs1))}");
          Ok(())
        } else
          Err({ failed_invariant: "strict provider run replays deterministically", trace: ["left=${show(length(recs1))}", "right=${show(length(recs2))}"] ++ recs1 })
      }
  }
}

func strict_provider_orphaned_toolcall_scenario() -> Scenario {
  { id: "strict_provider_orphaned_toolcall", run: scenario_strict_provider_rejects_orphaned_toolcall }
}

func direct_ctx_with_task_step(limit: int, ports: Ports, artifacts: Json, task: string, step: int) -> ExtCtx {
  {
    task: task,
    step: step,
    model: qwen_model,
    context_limit: limit,
    cwd: ".",
    hybrid_tools: false,
    budget: budget(),
    mode: "default",
    workdir: ".",
    env_server_url: "",
    budget_remaining: 1,
    history_slice: [],
    state_key: "k",
    ports: {
      ai_step: func(model: string, msgs: [Msg]) -> Result[string, string] ! {AI, IO, Process, FS, Env, Net, SharedMem, Clock, Stream} {
        let on_chunk = func(_chunk: StreamChunk) -> () ! {IO} { () };
        match ports.model_step(model, msgs, on_chunk) {
          Ok(r) => Ok(r.message.content),
          Err(e) => Err(e.message)
        }
      },
      proc_exec: fixed_exec,
      clock_now: fixed_clock,
      env_get: fixed_env
    },
    artifacts: artifacts,
    telemetry: zero_token_telemetry()
  }
}

func direct_ctx(limit: int, ports: Ports, artifacts: Json) -> ExtCtx {
  direct_ctx_with_task_step(limit, ports, artifacts, "direct", 0)
}

func summary_ports(summary: string) -> Ports ! {AI, IO, Trace} {
  let model_step = func(_model: string, _msgs: [Message], _on_chunk: (StreamChunk) -> () ! {IO})
    -> Result[StepResult, AIError] ! {AI, IO, Trace} {
    Ok(step_result(summary, [], "stop"))
  };
  ports_shape_probe(model_step, runtime_hooks)
}

func direct_msgs() -> [Msg] {
  [
    abi_msg("user", "old plain one ${repeat_block(4)}"),
    abi_msg("assistant", "old answer one ${repeat_block(4)}"),
    abi_msg("user", "old plain two ${repeat_block(4)}"),
    abi_assistant("call LongResult", [tool_call("direct-call-1")]),
    abi_tool("direct-call-1", "direct tool result ${repeat_block(4)}"),
    abi_msg("user", "recent question"),
    abi_msg("assistant", "recent answer")
  ]
}

func direct_msgs_with_status() -> [Msg] {
  [
    abi_msg("user", "old plain one ${repeat_block(4)}"),
    abi_assistant("call runtime status", [runtime_status_call()]),
    abi_tool(runtime_status_call_id, "{\"tool\":\"MotokoRuntimeStatus\",\"current_step\":47,\"step_budget\":100,\"finish_reason_so_far\":\"tool_calls\",\"stage_applied_total\":9,\"compaction_ai_applied\":8}${repeat_block(20)}"),
    abi_assistant("call LongResult", [tool_call("direct-call-1")]),
    abi_tool("direct-call-1", "direct tool result ${repeat_block(4)}"),
    abi_msg("user", "recent question"),
    abi_msg("assistant", "recent answer")
  ]
}

func contains_summary_msg(msgs: [Msg], text: string) -> bool {
  match msgs {
    [] => false,
    m :: rest => if m.role == "assistant" && contains(m.content, text) then true else contains_summary_msg(rest, text)
  }
}

func scenario_output_shape_valid() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  let input = direct_msgs();
  let cfg: CompactionAiConfig = {
    model: qwen_model,
    threshold_pct: 1,
    keep_recent: 4,
    keep_recent_tokens: 300,
    min_relief_pct: 5,
    rate_limit_enabled: false,
    min_gap_steps: 3,
    hard_override_pct: 95
  };
  match compact_with_ai(direct_ctx(100, summary_ports("DIRECT-SUMMARY"), empty_ext_artifacts()), input, cfg) {
    PassThrough => Err({ failed_invariant: "direct compact_with_ai compacts", trace: ["decision=PassThrough"] }),
    PassThroughObserved(code, _) => Err({ failed_invariant: "direct compact_with_ai compacts", trace: ["decision=${code}"] }),
    Compacted(out, _, _) => {
      if not contains_summary_msg(out, "[RUNTIME COMPACTION SUMMARY]") then Err({ failed_invariant: "runtime capsule emitted", trace: ["out_len=${show(length(out))}"] })
      else if not contains_summary_msg(out, "DIRECT-SUMMARY") then Err({ failed_invariant: "ai summary prose preserved", trace: ["out_len=${show(length(out))}"] })
      else if not contains_summary_msg(out, "not a fresh session") then Err({ failed_invariant: "capsule marks non-fresh session", trace: [] })
      else match validate_compactor_output(input, out) {
        Err(reason) => Err({ failed_invariant: "validate_compactor_output accepts direct compaction", trace: [reason] }),
        Ok(_) => Ok(())
      }
    }
  }
}

func scenario_artifact_cache_stable() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  let input = direct_msgs();
  let cfg: CompactionAiConfig = {
    model: qwen_model,
    threshold_pct: 1,
    keep_recent: 4,
    keep_recent_tokens: 300,
    min_relief_pct: 5,
    rate_limit_enabled: false,
    min_gap_steps: 3,
    hard_override_pct: 95
  };
  match compact_with_ai(direct_ctx(100, summary_ports("CACHED-SUMMARY-A"), empty_ext_artifacts()), input, cfg) {
    PassThrough => Err({ failed_invariant: "first cache run compacts", trace: ["decision=PassThrough"] }),
    PassThroughObserved(code, _) => Err({ failed_invariant: "first cache run compacts", trace: ["decision=${code}"] }),
    Compacted(out1, _, artifacts) => {
      if not contains_summary_msg(out1, "CACHED-SUMMARY-A") then Err({ failed_invariant: "first run records cached summary", trace: [] })
      else match compact_with_ai(direct_ctx_with_task_step(100, summary_ports("CACHE-MISS-FAIL"), artifacts, "direct cache second task", 12), input, cfg) {
        PassThrough => Err({ failed_invariant: "second cache run compacts", trace: ["decision=PassThrough"] }),
        PassThroughObserved(code, _) => Err({ failed_invariant: "second cache run compacts", trace: ["decision=${code}"] }),
        Compacted(out2, _, _) => {
          if contains_summary_msg(out2, "CACHED-SUMMARY-A")
            && not contains_summary_msg(out2, "CACHE-MISS-FAIL")
            && contains_summary_msg(out2, "direct cache second task")
            && contains_summary_msg(out2, "current_step_before_request: 12") then Ok(())
          else Err({ failed_invariant: "same-segment artifact cache reuses summary", trace: ["second_len=${show(length(out2))}"] })
        }
      }
    }
  }
}

func scenario_hostile_summary_preserves_control_capsule() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  let input = direct_msgs_with_status();
  let task = "Continue the 200-phase compaction stress task. Stop only after phase 200 is complete. Call MotokoRuntimeStatus every 10 phases and do not ask what to work on next.";
  let cfg: CompactionAiConfig = {
    model: qwen_model,
    threshold_pct: 1,
    keep_recent: 4,
    keep_recent_tokens: 300,
    min_relief_pct: 5,
    rate_limit_enabled: false,
    min_gap_steps: 3,
    hard_override_pct: 95
  };
  match compact_with_ai(direct_ctx_with_task_step(100, summary_ports("What would you like to work on?"), empty_ext_artifacts(), task, 48), input, cfg) {
    PassThrough => Err({ failed_invariant: "hostile summary compact_with_ai compacts", trace: ["decision=PassThrough"] }),
    PassThroughObserved(code, _) => Err({ failed_invariant: "hostile summary compact_with_ai compacts", trace: ["decision=${code}"] }),
    Compacted(out, _, _) => {
      if not contains_summary_msg(out, "[RUNTIME COMPACTION SUMMARY]") then Err({ failed_invariant: "hostile path emits capsule", trace: ["out_len=${show(length(out))}"] })
      else if not contains_summary_msg(out, task) then Err({ failed_invariant: "capsule preserves exact task", trace: [] })
      else if not contains_summary_msg(out, "not a fresh session") then Err({ failed_invariant: "capsule rejects fresh-session framing", trace: [] })
      else if not contains_summary_msg(out, "Continue the original task") then Err({ failed_invariant: "capsule preserves continue obligation", trace: [] })
      else if not contains_summary_msg(out, "MotokoRuntimeStatus") then Err({ failed_invariant: "capsule preserves status cadence/status facts", trace: [] })
      else if not contains_summary_msg(out, "\"current_step\":47") then Err({ failed_invariant: "capsule mirrors latest runtime status", trace: [] })
      else if not contains_summary_msg(out, "What would you like to work on?") then Err({ failed_invariant: "hostile ai prose still included as prose only", trace: [] })
      else match validate_compactor_output(input, out) {
        Err(reason) => Err({ failed_invariant: "validate_compactor_output accepts hostile capsule compaction", trace: [reason] }),
        Ok(_) => Ok(())
      }
    }
  }
}

func decision_code_is(d: PreStepDecision, code: string) -> bool {
  match d { PassThroughObserved(actual, _) => actual == code, _ => false }
}

func scenario_terminal_observations() -> Result[(), ScenarioFailure] ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  let input = direct_msgs();
  let base: CompactionAiConfig = {
    model: qwen_model, threshold_pct: 1, keep_recent: 4, keep_recent_tokens: 300,
    min_relief_pct: 5, rate_limit_enabled: false, min_gap_steps: 3, hard_override_pct: 95
  };
  let no_prefix = compact_with_ai(direct_ctx(10, summary_ports("unused"), empty_ext_artifacts()), [abi_msg("user", repeat_block(4))], { base | keep_recent_tokens: 100000 });
  let insufficient = compact_with_ai(direct_ctx(100, summary_ports("unused"), empty_ext_artifacts()), input, { base | min_relief_pct: 1000 });
  let failed = compact_with_ai(direct_ctx(100, summary_ports(""), empty_ext_artifacts()), input, base);
  let not_relieving = compact_with_ai(direct_ctx(100, summary_ports(repeat_block(200)), empty_ext_artifacts()), input, base);
  ok_or_failure(
    decision_code_is(no_prefix, "compaction_ai.no_foldable_prefix")
      && decision_code_is(insufficient, "compaction_ai.insufficient_relief")
      && decision_code_is(failed, "compaction_ai.summarizer_failed")
      && decision_code_is(not_relieving, "compaction_ai.output_not_relieving"),
    "all terminal over-threshold paths are observed",
    [show(no_prefix), show(insufficient), show(failed), show(not_relieving)]
  )
}

func multiple_compactions_scenario() -> Scenario {
  { id: "compaction.long_qwen_ai_multiple_compactions", run: scenario_multiple_compactions }
}

func replay_deterministic_scenario() -> Scenario {
  { id: "compaction.long_qwen_ai_replay_deterministic", run: scenario_replay_deterministic }
}

func output_shape_scenario() -> Scenario {
  { id: "compaction.compaction_ai_output_shape_valid", run: scenario_output_shape_valid }
}

func artifact_cache_scenario() -> Scenario {
  { id: "compaction.compaction_ai_artifact_cache_stable", run: scenario_artifact_cache_stable }
}

func hostile_summary_scenario() -> Scenario {
  { id: "compaction.compaction_ai_hostile_summary_control_capsule", run: scenario_hostile_summary_preserves_control_capsule }
}

func terminal_observations_scenario() -> Scenario {
  { id: "compaction.compaction_ai_terminal_observations", run: scenario_terminal_observations }
}

func seal_side_exhaustion_scenario() -> Scenario {
  { id: "compaction.structural_seal_side_exhaustion", run: scenario_seal_side_exhaustion }
}

export func main() -> () ! {AI, FS, Process, IO, Env, Net, SharedMem, Clock, Stream, Trace} {
  let scenarios = [
    multiple_compactions_scenario(),
    replay_deterministic_scenario(),
    output_shape_scenario(),
    artifact_cache_scenario(),
    hostile_summary_scenario(),
    terminal_observations_scenario(),
    seal_side_exhaustion_scenario(),
    strict_provider_orphaned_toolcall_scenario()
  ];
  let failed = run_all(scenarios, 0);
  if failed == 0 then println("long_qwen_compaction_dst PASS count=${show(length(scenarios))}")
  else {
    let _ = println("long_qwen_compaction_dst FAIL failed=${show(failed)}");
    exit(1)
  }
}
