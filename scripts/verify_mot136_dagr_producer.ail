-- scripts/verify_mot136_dagr_producer.ail
--
-- MOT-136: the dagr producer, driven end to end through the two real check
-- lifecycles, with an IN-MEMORY FILESYSTEM behind the ports.
--
-- Why a fake filesystem rather than scripted returns: the producer's publish is
-- a transaction — `file_write(tmp)` then `mv` — and its whole point is that the
-- live file only ever changes at the rename. A port that just says "ok" would
-- assert nothing about that. Here `file_write` really stores bytes, `mv` really
-- moves them, and the document this script prints is the one a dagr pane would
-- have read. The Makefile target pipes each printed document through
-- `dagr check --strict --json` against the pinned v0.3.1 binary, which is where
-- contract validity is established (§6: not at runtime, once in CI).
--
-- The lifecycle covers, in one continuous world:
--
--   1. Delegate (claude)                  -> task + a1 working, one note
--   2. DelegateCheck, still working       -> liveness latched, no settle
--   3. DelegateCheck, blocked             -> task blocked, attempt still working
--   4. DelegateCheck, answer on disk      -> done · reported, receipt = the path
--   5. DelegateCheck again                -> IDEMPOTENT: nothing appended (§3.5)
--   6. Delegate with retry_of             -> a2 on the SAME task, cause followup
--   7. Delegate (motoko) + agent gone     -> attempt lost, task failed (§4)
--   8. `pane split` itself fails            -> NO task at all (§3.2)
--   9. a spawn that fails AFTER the split -> a task BORN failed (F3)
--  10. a refused `retry_of`               -> the tool result says so, not just
--                                            the run file
--
-- Usage:
--   AILANG_RELAX_MODULES=1 ailang run \
--     --caps IO,Env,FS,AI,Process,Net,SharedMem,Clock,Stream,Trace \
--     --ai-stub --entry main scripts/verify_mot136_dagr_producer.ail
--
-- Prints OK/FAIL per assertion and one `DAGR_DOC <json>` line per published
-- document. Exits non-zero on any FAIL.
module scripts/verify_mot136_dagr_producer

import std/io (println, exit)
import std/json (Json, jo, ja, kv, js, jnum, encode, decode, get, asString, asArray, asObject)
import std/string (contains, join, intToStr, length)
import std/option (Option, Some, None)
import std/result (Ok, Err)
import pkg/sunholo/motoko_ext_abi/types (
  ExtCtx, ExtWorld, ExtPorts, ExtProcOutcome, ExtFileRead, ExtFileMutation, ExtClockReading,
  ToolCallEnvelope, ToolResultEnvelope, ToolHandleOutcome, ToolHandleDecision,
  Handled, Delegate, BudgetPlan, empty_ext_world
)
import src/core/ext/ctx_defaults (noop_ext_ports, empty_ext_artifacts, zero_token_telemetry)
import pkg/sunholo/motoko_ext_herdr/herdr (HerdrConfig, on_tool_handle)
import src/core/test/herdr_fixture (argv_text, envelope, herdr_error, strings_of)

-- ---------------------------------------------------------------------------
-- A filesystem in the world token
-- ---------------------------------------------------------------------------

func kvs_without(kvs: [{key: string, value: Json}], key: string) -> [{key: string, value: Json}] {
  match kvs {
    [] => [],
    p :: rest => if p.key == key then kvs_without(rest, key) else p :: kvs_without(rest, key)
  }
}

func obj_set(o: Json, key: string, v: Json) -> Json {
  match asObject(o) {
    None => jo([kv(key, v)]),
    Some(kvs) => jo(kvs_without(kvs, key) ++ [kv(key, v)])
  }
}

func obj_del(o: Json, key: string) -> Json {
  match asObject(o) { None => o, Some(kvs) => jo(kvs_without(kvs, key)) }
}

func sfield(o: Json, key: string) -> string {
  match get(o, key) {
    None => "",
    Some(v) => match asString(v) { Some(s) => s, None => "" }
  }
}

func files_of(w: ExtWorld) -> Json {
  match get(w.token, "files") { Some(f) => f, None => jo([]) }
}

func with_files(w: ExtWorld, f: Json) -> ExtWorld { { token: obj_set(w.token, "files", f) } }

func read_file(w: ExtWorld, path: string) -> string { sfield(files_of(w), path) }

func has_file(w: ExtWorld, path: string) -> bool {
  match get(files_of(w), path) { Some(_) => true, None => false }
}

func put_file(w: ExtWorld, path: string, content: string) -> ExtWorld {
  with_files(w, obj_set(files_of(w), path, js(content)))
}

func drop_file(w: ExtWorld, path: string) -> ExtWorld {
  with_files(w, obj_del(files_of(w), path))
}

-- ---------------------------------------------------------------------------
-- Ports over that filesystem
-- ---------------------------------------------------------------------------

func fs_read(world: ExtWorld, path: string) -> ExtFileRead ! {FS} {
  if has_file(world, path)
  then { present: true, content: read_file(world, path), next_state: world }
  else { present: false, content: "", next_state: world }
}

func fs_write(world: ExtWorld, path: string, content: string) -> ExtFileMutation ! {FS} {
  { ok: true, error: "", next_state: put_file(world, path, content) }
}

func fs_remove(world: ExtWorld, path: string) -> ExtFileMutation ! {FS} {
  { ok: true, error: "", next_state: drop_file(world, path) }
}

func fs_dir(world: ExtWorld, _path: string) -> ExtFileMutation ! {FS} {
  { ok: true, error: "", next_state: world }
}

func cmd_of(args_json: string) -> string {
  match decode(args_json) { Err(_) => "", Ok(o) => sfield(o, "cmd") }
}

func argv_list(args_json: string) -> [string] {
  match decode(args_json) {
    Err(_) => [],
    Ok(o) => match get(o, "args") {
      None => [],
      Some(a) => match asArray(a) { Some(xs) => strings_of(xs), None => [] }
    }
  }
}

-- `agent get` answers with `status`; `agent wait` and `agent get` fail with
-- `agent_not_found` when `gone`; `pane split` always succeeds so that step 8's
-- setup failure is staged on `agent start` instead.
-- `fail_at` names the FIRST spawn step that fails: "" (none), "split", "start"
-- or "prompt". It replaces the old `split_ok` boolean because F3 is a failure
-- AFTER the split — the pane, the agent and the task file are all spent — and a
-- flag that fails the split cannot reach it.
func scripted(ms: int, status: string, gone: bool, fail_at: string)
  -> (ExtWorld, string, string) -> ExtProcOutcome ! {IO, Process, FS} {
  func(world: ExtWorld, _tool: string, args_json: string) -> ExtProcOutcome ! {IO, Process, FS} {
    let cmd = cmd_of(args_json);
    let argv = argv_text(args_json);
    -- THE PUBLISH TRANSACTION, FOR REAL: the live file changes only here.
    if cmd == "mv" then {
      let parts = argv_list(args_json);
      match parts {
        src :: rest => match rest {
          dst :: _ => {
            let moved = drop_file(put_file(world, dst, read_file(world, src)), src);
            { output: envelope("", "", 0), exit_code: 0, next_state: moved }
          },
          [] => { output: envelope("", "mv: missing destination", 1), exit_code: 1, next_state: world }
        },
        [] => { output: envelope("", "mv: missing operand", 1), exit_code: 1, next_state: world }
      }
    }
    else if contains(argv, "pane split") then
      if fail_at == "split" then { output: envelope("", herdr_error("pane_split_failed"), 1), exit_code: 1, next_state: world }
      else
        { output: envelope("{\"id\":\"cli:pane:split\",\"result\":{\"pane\":{\"pane_id\":\"w1:pA\"},\"type\":\"pane_info\"}}", "", 0),
          exit_code: 0, next_state: put_file(world, "/tmp/.last-pane-split", argv) }
    else if contains(argv, "agent explain") then
      { output: envelope("{\"agent\":\"claude\",\"matched_rule\":{\"id\":\"live_prompt_box\"},\"fallback_reason\":null}", "", 0),
        exit_code: 0, next_state: world }
    else if contains(argv, "agent start") then
      if fail_at == "start" then { output: envelope("", herdr_error("agent_start_failed"), 1), exit_code: 1, next_state: world }
      else { output: envelope("{\"result\":{}}", "", 0), exit_code: 0,
             next_state: put_file(world, "/tmp/.last-agent-start", argv) }
    -- THE F3 SHAPE, MEASURED 2026-09-01: the pane split, the agent started and
    -- the readiness gate passed, and only then did `agent prompt` refuse.
    -- PROMPT REFUSALS ARE COUNTED, not merely switched on. `prompt_with_retry`
    -- makes up to three attempts, so a fixture that can only fail ALL of them
    -- cannot express the case the retry exists for: refused once, then
    -- accepted. The tally lives in the world, which is the only state a
    -- scripted port has.
    --
    --   "prompt"        every attempt is refused        (the pre-retry case)
    --   "prompt_once"   the FIRST is refused, then it succeeds
    --   "prompt_stall"  every attempt refused with a code that must NOT retry
    else if contains(argv, "agent prompt") then {
      -- KEYED PER CASE. The world threads from one `drive` to the next, so a
      -- single counter path accumulates across cases: by case 19 it already
      -- held case 9's three attempts. That is not cosmetic — it made case 16
      -- pass by never refusing at all, which is the opposite of what it claims
      -- to test. `ms` is unique per case and is the case's own identity.
      let tries = "/tmp/.prompt-tries-${intToStr(ms)}";
      let seen = length(read_file(world, tries));
      let w2 = put_file(world, tries, "${read_file(world, tries)}x");
      if fail_at == "prompt" || fail_at == "prompt_moved" then { output: envelope("", herdr_error("agent_not_ready"), 1), exit_code: 1, next_state: w2 }
      else if fail_at == "prompt_stall" then { output: envelope("", herdr_error("agent_prompt_stalled"), 1), exit_code: 1, next_state: w2 }
      else if fail_at == "prompt_once" && seen == 0 then { output: envelope("", herdr_error("agent_not_ready"), 1), exit_code: 1, next_state: w2 }
      else { output: envelope("{\"result\":{}}", "", 0), exit_code: 0, next_state: w2 }
    }
    else if contains(argv, "agent get") || contains(argv, "agent wait") then
      if gone then { output: envelope("", herdr_error("agent_not_found"), 1), exit_code: 1, next_state: world }
      -- "prompt_moved": the agent's status CHANGES once a prompt has been
      -- attempted, which is the shape the retry's probe exists for — a refusal
      -- that may have been delivered anyway. The baseline is read before any
      -- attempt, so it sees `status`; every read after one sees "working".
      else if fail_at == "prompt_moved" && length(read_file(world, "/tmp/.prompt-tries-${intToStr(ms)}")) > 0 then
        { output: envelope("{\"id\":\"cli:agent:get\",\"result\":{\"agent\":{\"agent_status\":\"working\",\"pane_id\":\"w1:pA\"}}}", "", 0),
          exit_code: 0, next_state: world }
      else
        { output: envelope("{\"id\":\"cli:agent:get\",\"result\":{\"agent\":{\"agent_status\":\"${status}\",\"pane_id\":\"w1:pA\"}}}", "", 0),
          exit_code: 0, next_state: world }
    -- THE PUBLISH'S VALIDATOR. `fail_at == "vet"` is dagr saying the candidate
    -- is invalid — exit 1, its documented "findings" code — which is the ONE
    -- outcome that stops a publish. Every other code, including a missing
    -- binary, publishes; `dagr_says_invalid` is the classifier.
    else if contains(argv, "check") && contains(argv, "--strict") then
      if fail_at == "vet" then { output: envelope("", "ERROR E150 tasks[0] — scripted rejection", 1), exit_code: 1, next_state: world }
      -- 127 is the shell's "command not found": no dagr on PATH. §6's rule is
      -- that this must NOT stop a publish, and case 21 asserts it.
      else if fail_at == "vet_missing" then { output: envelope("", "dagr: command not found", 127), exit_code: 1, next_state: world }
      else { output: envelope("", "", 0), exit_code: 0, next_state: world }
    else if contains(argv, "pane list") then
      { output: envelope("{\"result\":{\"panes\":[{\"pane_id\":\"w1:p1\"}]}}", "", 0), exit_code: 0, next_state: world }
    else
      { output: envelope("{\"result\":{}}", "", 0), exit_code: 0, next_state: world }
  }
}

-- One clock per step, so `started_at` precedes `ended_at` the way the contract
-- requires and the validator checks.
func clock_at(ms: int) -> (ExtWorld) -> ExtClockReading ! {Clock} {
  func(world: ExtWorld) -> ExtClockReading ! {Clock} { { now_ms: ms, next_state: world } }
}

func ports_at(ms: int, status: string, gone: bool, split_ok: bool) -> ExtPorts {
  ports_failing_at(ms, status, gone, if split_ok then "" else "split")
}

func ports_failing_at(ms: int, status: string, gone: bool, fail_at: string) -> ExtPorts {
  let base = noop_ext_ports();
  { ai_step: base.ai_step,
    tool_handle: scripted(ms, status, gone, fail_at),
    file_read: fs_read,
    file_write: fs_write,
    file_remove: fs_remove,
    path_stat: base.path_stat,
    dir_list: base.dir_list,
    dir_make: fs_dir,
    clock_now: clock_at(ms),
    env_get: base.env_get }
}

func mk_ctx(ports: ExtPorts, world: ExtWorld) -> ExtCtx {
  let budget: BudgetPlan = { total: 4, solver: 4, verifier: 0 };
  { task: "verify-mot136", step: 0, model: "test-model", cwd: "/tmp",
    hybrid_tools: false, budget: budget, mode: "v2", workdir: "/tmp",
    env_server_url: "", budget_remaining: 4, history_slice: [],
    state_key: "test", context_limit: 0, ports: ports,
    finish_reason: "",
    work_in_flight: [],
    artifacts: empty_ext_artifacts(), telemetry: zero_token_telemetry(),
    world: world }
}

func mk_cfg_plan(plan: string) -> HerdrConfig {
  { mk_cfg() | dagr_plan: plan }
}

func mk_cfg() -> HerdrConfig {
  { bin: "herdr", own_pane: "w1:p1", work_dir: "/tmp/mot", kind: "claude",
    allowed_kinds: "claude,motoko", depth: 0, max_depth: 1, motoko_script: "./x.sh",
    session_ms: "200", sweep_stale: false, dagr_dir: "/tmp/.dagr",
    -- MOT-137 off: this leg pins the DOCUMENT, and the opener is a herdr call
    -- that writes nothing into it. Its own gate is `verify_mot137_dagr_pane.ail`.
    dagr_pane: false,
    start_timeout_ms: 1000, check_wait_ms: 1000, max_output_chars: 16000,
    -- ABI 7.0: the exit intent is declared either way; this says whether it
    -- renders actions. These gates exercise the tool paths, not the exit path.
    reap_on_exit: false, settle_on_exit: false, sweep_settle: false, dagr_bin: "dagr", dagr_plan: "" }
}

func run_file_path() -> string { "/tmp/.dagr/run-w1-p1-200.json" }

-- ---------------------------------------------------------------------------
-- Driving it
-- ---------------------------------------------------------------------------

type Step = { world: ExtWorld, out: string, err: string, code: int }

func drive(world: ExtWorld, ports: ExtPorts, call: ToolCallEnvelope) -> Step ! {IO, Process, FS, Clock} {
  drive_cfg(mk_cfg(), world, ports, call)
}

func drive_cfg(cfg: HerdrConfig, world: ExtWorld, ports: ExtPorts, call: ToolCallEnvelope) -> Step ! {IO, Process, FS, Clock} {
  let r = on_tool_handle(cfg, mk_ctx(ports, world), call);
  match r.decision {
    Handled(res) => { world: r.next_state, out: res.stdout, err: res.stderr, code: res.exit_code },
    Delegate => { world: r.next_state, out: "", err: "on_tool_handle delegated the call", code: 1 }
  }
}

-- A2: a delegation that names the operator's plan task.
func delegate_plan_call(id: string, prompt: string, dagr_task: string) -> ToolCallEnvelope {
  { id: id, tool: "Delegate",
    arguments: jo([kv("prompt", js(prompt)), kv("kind", js("claude")),
                   kv("task_kind", js("impl")), kv("dagr_task", js(dagr_task))]) }
}

-- A2's second channel: the model was told the plan path in conversation and
-- passes it here, with no `HERDR_DAGR_PLAN` anywhere.
func delegate_declare_call(id: string, prompt: string, dagr_task: string, dagr_plan: string) -> ToolCallEnvelope {
  { id: id, tool: "Delegate",
    arguments: jo([kv("prompt", js(prompt)), kv("kind", js("claude")),
                   kv("task_kind", js("impl")), kv("dagr_task", js(dagr_task)),
                   kv("dagr_plan", js(dagr_plan))]) }
}

func delegate_call(id: string, prompt: string, kind: string, task_kind: string, retry_of: string) -> ToolCallEnvelope {
  delegate_call_model(id, prompt, kind, task_kind, retry_of, "")
}

func delegate_call_model(id: string, prompt: string, kind: string, task_kind: string, retry_of: string, model: string) -> ToolCallEnvelope {
  { id: id, tool: "Delegate",
    arguments: jo([kv("prompt", js(prompt)), kv("kind", js(kind)),
                   kv("model", js(model)),
                   kv("task_kind", js(task_kind)), kv("retry_of", js(retry_of))]) }
}

-- The last `agent start` argv the scripted port saw. The `agent start` branch
-- answers blindly, so without this the model flag would be asserted only against
-- the run file and never against the call that carries it.
func last_start_argv(world: ExtWorld) -> string { read_file(world, "/tmp/.last-agent-start") }

-- The last `pane split` argv. A motoko delegate never reaches `agent start`, so
-- this is the ONLY place its model can be asserted: the split is where `MODEL`
-- is handed over (`types.argv_split`).
func last_split_argv(world: ExtWorld) -> string { read_file(world, "/tmp/.last-pane-split") }

func check_call(id: string, name: string) -> ToolCallEnvelope {
  { id: id, tool: "DelegateCheck", arguments: jo([kv("name", js(name))]) }
}

func doc_of(w: ExtWorld) -> Json {
  match decode(read_file(w, run_file_path())) { Ok(d) => d, Err(_) => jo([]) }
}

func count_of(xs: [Json]) -> int {
  match xs { [] => 0, _ :: rest => 1 + count_of(rest) }
}

func arr_field(o: Json, key: string) -> [Json] {
  match get(o, key) {
    None => [],
    Some(v) => match asArray(v) { Some(xs) => xs, None => [] }
  }
}

func events(w: ExtWorld) -> int { count_of(arr_field(doc_of(w), "events")) }

func sfield(o: Json, key: string) -> string {
  match get(o, key) {
    None => "",
    Some(v) => match asString(v) { Some(x) => x, None => "" }
  }
}

func in_state(xs: [Json], state: string) -> int {
  match xs {
    [] => 0,
    a :: rest => (if sfield(a, "state") == state then 1 else 0) + in_state(rest, state)
  }
}

func find_task(ts: [Json], id: string) -> Option[Json] {
  match ts {
    [] => None,
    t :: rest => if sfield(t, "id") == id then Some(t) else find_task(rest, id)
  }
}

-- How many of a task's attempts sit in `state`. Used to assert that the
-- born-failed task has exactly one attempt and it is already terminal.
func count_in_state(w: ExtWorld, id: string, state: string) -> int {
  match find_task(arr_field(doc_of(w), "tasks"), id) {
    None => 0,
    Some(t) => in_state(arr_field(t, "attempts"), state)
  }
}
func tasks(w: ExtWorld) -> int { count_of(arr_field(doc_of(w), "tasks")) }

func check(label: string, ok: bool) -> bool ! {IO} {
  if ok then { println("OK: ${label}"); true } else { println("FAIL: ${label}"); false }
}

func emit(w: ExtWorld) -> () ! {IO} {
  println("DAGR_DOC ${read_file(w, run_file_path())}")
}

export func main() -> () ! {AI, Clock, Env, FS, IO, Net, Process, Rand, SharedMem, Stream, Trace} {
  let w0 = empty_ext_world();

  -- 1. Delegate (claude). Handle is seeded from the clock: mot-dlg-1000.
  let s1 = drive(w0, ports_at(1000, "working", false, true),
                 delegate_call("c1", "Fix the parser\nmore detail", "claude", "impl", ""));
  let a1 = check("Delegate opens one task with one attempt", tasks(s1.world) == 1 && s1.code == 0);
  -- ONCE PER RUN, and the first delegation is the only place it may appear:
  -- repeating it on every Delegate call would be noise in the one output the
  -- model reads most.
  let a1b = check("the first delegation of a run says how to open the dagr view",
                  contains(s1.out, "scripts/dagr-pane.sh"));
  let a2 = check("the run file carries a contract version and a task id that is not a pane id",
                 contains(read_file(s1.world, run_file_path()), "\"dagr\":3")
                   && contains(read_file(s1.world, run_file_path()), "mot-dlg-1000")
                   && contains(read_file(s1.world, run_file_path()), "\"kind\":\"impl\""));
  emit(s1.world);

  -- 2. Still working: liveness latches, nothing settles.
  let s2 = drive(s1.world, ports_at(2000, "working", false, true), check_call("c2", "mot-dlg-1000"));
  let a3 = check("a working check latches prompt_acknowledged and settles nothing",
                 contains(read_file(s2.world, run_file_path()), "\"prompt_acknowledged\":true")
                   && contains(read_file(s2.world, run_file_path()), "attempt_settled") == false);
  emit(s2.world);

  -- 3. Blocked: the TASK blocks, the attempt keeps working, and the unblocker
  --    is named (dagr refuses a blocked node that is only a red mark).
  let s3 = drive(s2.world, ports_at(3000, "blocked", false, true), check_call("c3", "mot-dlg-1000"));
  let a4 = check("a blocked delegate blocks the task and names its unblocker",
                 contains(read_file(s3.world, run_file_path()), "\"state\":\"blocked\"")
                   && contains(read_file(s3.world, run_file_path()), "\"unblock\":\"operator"));
  emit(s3.world);

  -- 4. The answer lands. done · reported, receipt = the answer path.
  let seeded = put_file(s3.world, "/tmp/mot/answer-mot-dlg-1000.md", "the delegate delivered");
  let s4 = drive(seeded, ports_at(4000, "idle", false, true), check_call("c4", "mot-dlg-1000"));
  let a5 = check("an answer on disk settles done at tier reported, receipted by path",
                 contains(read_file(s4.world, run_file_path()), "\"evidence\":\"reported\"")
                   && contains(read_file(s4.world, run_file_path()), "\"receipt\":\"/tmp/mot/answer-mot-dlg-1000.md\"")
                   && contains(read_file(s4.world, run_file_path()), "\"verified\"") == false);
  -- The unblock line from step 3 must not outlive the block: a settled task
  -- still asking the operator to answer a prompt is a stale fact, and stale
  -- facts are what a confidently wrong graph is made of.
  let a5b = check("settling clears the unblock line the blocked check wrote",
                  contains(read_file(s4.world, run_file_path()), "unblock") == false);
  emit(s4.world);

  -- 5. THE IDEMPOTENCE CASE. Nothing consumes the answer file, so this check
  --    reaches the same branch and must append nothing.
  let before = events(s4.world);
  let s5 = drive(s4.world, ports_at(5000, "idle", false, true), check_call("c5", "mot-dlg-1000"));
  let a6 = check("a second check on a finished delegate appends no second settlement",
                 events(s5.world) == before && tasks(s5.world) == 1);

  -- 6. retry_of links a new attempt onto the SAME task.
  let s6 = drive(s5.world, ports_at(6000, "working", false, true),
                 delegate_call("c6", "Fix the parser again", "claude", "impl", "mot-dlg-1000"));
  -- ...and no later one repeats it. Once per run is the whole point: this rides
  -- on the output the model reads most, and a line on every Delegate call is
  -- noise, not documentation.
  let a7b = check("later delegations do not repeat the view pointer",
                  contains(s6.out, "scripts/dagr-pane.sh") == false);
  let a7 = check("retry_of appends attempt a2 to the existing task, cause followup",
                 tasks(s6.world) == 1
                   && contains(read_file(s6.world, run_file_path()), "mot-dlg-1000·a2")
                   && contains(read_file(s6.world, run_file_path()), "\"type\":\"followup\""));
  emit(s6.world);

  -- 7. The delegate is gone: attempt lost, task failed. The handle is the one
  --    minted at 6000, which the retry now owns.
  let s7 = drive(s6.world, ports_at(7000, "working", true, true), check_call("c7", "mot-dlg-6000"));
  let a8 = check("agent_not_found settles the attempt lost and the task failed",
                 contains(read_file(s7.world, run_file_path()), "\"result\":\"lost\"")
                   && contains(read_file(s7.world, run_file_path()), "\"state\":\"failed\""));
  emit(s7.world);

  -- 8. A setup failure after the split writes NO task: the pane is closed and
  --    a task appended at the split would survive as a phantom working row.
  let t8 = tasks(s7.world);
  let s8 = drive(s7.world, ports_at(8000, "working", false, false),
                 delegate_call("c8", "never starts", "claude", "impl", ""));
  let a9 = check("a delegation that fails its setup appends no task at all",
                 s8.code == 1 && tasks(s8.world) == t8);
  emit(s8.world);

  -- 9. F3: a spawn that fails AFTER the split is a fact, not a silence. Two
  --    `claude` delegations died here on 2026-09-01 — a pane, an `agent start`
  --    and a task file each — and appended nothing at all. The row is born
  --    terminal, so the phantom `working` §3.2 refuses still cannot appear.
  let s9 = drive(s8.world, ports_failing_at(9000, "working", false, "prompt"),
                 delegate_call("c9", "never gets the task", "claude", "impl", ""));
  let d9 = read_file(s9.world, run_file_path());
  let a10 = check("a spawn that fails after the split is recorded as a failed task",
                  s9.code == 1 && tasks(s9.world) == t8 + 1
                    && contains(d9, "\"result\":\"failed\"")
                    && contains(d9, "agent_not_ready"));
  -- The model still gets the WHOLE failure sentence. Recording the failure
  -- rewrote this error's construction, and a truncated or mangled message would
  -- be a worse regression than the omission it fixes.
  let a10b = check("the model still gets the full failure explanation",
                   contains(s9.err, "Submitting the task to the delegate")
                     && contains(s9.err, "agent_not_ready"));
  let a11 = check("that failed task is never observable as working",
                  contains(d9, "\"id\":\"mot-dlg-9000\",\"title\"")
                    && count_in_state(s9.world, "mot-dlg-9000", "failed") == 1);
  -- The refusal reaches the MODEL too, not only the graph: a delegation whose
  -- setup failed already errors, so what is asserted here is the receipt.
  let a12 = check("the failed spawn carries a mechanical receipt, not a claim",
                  contains(d9, "\"evidence\":\"verified\"") && contains(d9, "herdr exit 1"));
  emit(s9.world);

  -- 10. §3.6, the half the model could not see. A `retry_of` this extension
  --     never issued is refused as a LINKAGE and the work opens as new — which
  --     the run file always said and the tool result never did (measured
  --     2026-09-01: steps 6 and 7 both returned a bare success).
  let s10 = drive(s9.world, ports_at(10000, "working", false, true),
                  delegate_call("c10", "gamma", "claude", "docs", "not-a-real-handle"));
  let a13 = check("a refused retry_of link is stated in the tool result, not only the run file",
                  s10.code == 0
                    && contains(s10.out, "was NOT recorded")
                    && contains(s10.out, "not a handle this extension issued")
                    && contains(read_file(s10.world, run_file_path()), "was not linked"));
  emit(s10.world);

  -- 11. A requested model threads into `agent start` AND the run file, verbatim.
  --     The flag rides the same `--` slot the relaxation flags use; the run file
  --     records the ASK (display chip), never a claim about what ran.
  let s11 = drive(s10.world, ports_at(11000, "working", false, true),
                  delegate_call_model("c11", "model work", "claude", "impl", "", "claude-fable-5"));
  let a14 = check("a requested model is passed to agent start after --",
                  s11.code == 0
                    && contains(last_start_argv(s11.world), "--model claude-fable-5"));
  let a15 = check("a requested model is recorded verbatim on the attempt",
                  contains(read_file(s11.world, run_file_path()), "\"model\":\"claude-fable-5\""));
  emit(s11.world);

  -- 12. A model with a shell token degrades to CLI-default: refused from the
  --     argv, visible in the transcript and the run file as asked.
  let s12 = drive(s11.world, ports_at(12000, "working", false, true),
                  delegate_call_model("c12", "metachar work", "claude", "impl", "", "a;b"));
  let a16 = check("a model with metacharacters is refused from agent start",
                  s12.code == 0
                    && contains(last_start_argv(s12.world), "--model") == false);
  let a17 = check("the refused model ask is still recorded verbatim",
                  contains(read_file(s12.world, run_file_path()), "\"model\":\"a;b\""));
  -- AND IT IS SAID, not merely done (2026-09-07). The refusal is silent by
  -- policy; the transcript claiming the delegate runs on the refused model is a
  -- different thing, and was true until this assertion existed.
  let a17b = check("a refused model is described as refused, not as the model in use",
                   contains(s12.out, "REFUSED")
                     && contains(s12.out, "runs on its own default")
                     && contains(s12.out, "with model `a;b`") == false);
  emit(s12.world);

  -- 13. THE MOTOKO HALF OF THE MODEL STORY (2026-09-07). A motoko delegate is a
  --     shell running `run-agent.sh`, not an `agent start`, so its model cannot
  --     ride a flag after `--`. It rides the pane split as `MODEL`, which the
  --     receiving Motoko resolves ahead of its configured profile.
  let s13 = drive(s12.world, ports_at(13000, "working", false, true),
                  delegate_call_model("c13", "motoko model work", "motoko", "impl", "", "openrouter/meta/muse-spark-1.3"));
  let a18 = check("a motoko delegate's model rides the pane split as MODEL",
                  s13.code == 0
                    && contains(last_split_argv(s13.world), "--env MODEL=openrouter/meta/muse-spark-1.3"));
  emit(s13.world);

  -- 14. The same degradation as the flag path: a shell token yields no MODEL at
  --     all, so the delegate resolves its own model rather than the call failing.
  let s14 = drive(s13.world, ports_at(14000, "working", false, true),
                  delegate_call_model("c14", "motoko metachar", "motoko", "impl", "", "a;b"));
  let a19 = check("a motoko model with metacharacters is refused from the split",
                  s14.code == 0
                    && contains(last_split_argv(s14.world), "MODEL=") == false);
  emit(s14.world);

  -- 15. AND THE OTHER DIRECTION, which is the half that catches a model threaded
  --     unconditionally: claude takes its model as a flag, so ITS split must not
  --     carry MODEL — a variable the claude CLI does not read, in a pane holding
  --     no Motoko.
  let s15 = drive(s14.world, ports_at(15000, "working", false, true),
                  delegate_call_model("c15", "claude model work", "claude", "impl", "", "claude-fable-5"));
  let a20 = check("a claude delegate's split carries no MODEL: its transport is the flag",
                  s15.code == 0
                    && contains(last_start_argv(s15.world), "--model claude-fable-5")
                    && contains(last_split_argv(s15.world), "MODEL=") == false);
  emit(s15.world);

  -- 16. THE RETRY (2026-09-07). Refused once with `agent_not_ready`, accepted on
  --     the second attempt: the delegation SUCCEEDS and the task is open and
  --     working, where before this it was a failed row and a dead pane. This is
  --     finding C surviving rather than being fixed — the herdr-side cause is
  --     untouched.
  let s16 = drive(s15.world, ports_failing_at(16000, "working", false, "prompt_once"),
                  delegate_call("c16", "retried work", "claude", "impl", ""));
  let a21 = check("a prompt refused once with agent_not_ready is retried and the delegation succeeds",
                  s16.code == 0
                    && contains(read_file(s16.world, run_file_path()), "\"state\":\"working\"")
                    && contains(s16.out, "is running `claude`"));
  emit(s16.world);

  -- 17. Refused every time: the outcome is what it always was — closed pane,
  --     failed task, the model told — and the RECEIPT now says how many tries,
  --     because `verified` grades a claim about the spawn.
  let s17 = drive(s16.world, ports_failing_at(17000, "working", false, "prompt"),
                  delegate_call("c17", "never accepted", "claude", "impl", ""));
  let d17 = read_file(s17.world, run_file_path());
  let a22 = check("a prompt refused every time still fails, and the receipt counts the attempts",
                  s17.code == 1
                    && contains(d17, "\"result\":\"failed\"")
                    && contains(d17, "agent_not_ready")
                    && contains(d17, "after 3 attempts"));
  emit(s17.world);

  -- 18. THE CODE THAT MUST NEVER BE RETRIED. `agent_prompt_stalled` says the
  --     delegate ACCEPTED the input, so a second attempt is a second delivery.
  --     One attempt, and the receipt must not claim more.
  let s18 = drive(s17.world, ports_failing_at(18000, "working", false, "prompt_stall"),
                  delegate_call("c18", "stalled work", "claude", "impl", ""));
  let d18 = read_file(s18.world, run_file_path());
  -- SCOPED TO THIS TASK'S RECEIPT, not to the document. A bare
  -- `contains(doc, "attempts")` matches the two EARLIER tasks that were retried,
  -- so it would fail while the code was right — which is what it did. Matching
  -- the closing quote is what proves nothing follows the code inside the string.
  let a23 = check("agent_prompt_stalled is never retried: it says the input was accepted",
                  s18.code == 1
                    && contains(d18, "code `agent_prompt_stalled`\",")
                    && contains(d18, "code `agent_prompt_stalled`, after") == false);
  emit(s18.world);

  -- 19. THE PROBE. Same retryable code as case 17, but the agent's status MOVES
  --     after the refusal — so the prompt may have landed after all, and a
  --     second delivery is the one outcome worse than a clean failure. Exactly
  --     one attempt, and the receipt must not claim more.
  let s19 = drive(s18.world, ports_failing_at(19000, "idle", false, "prompt_moved"),
                  delegate_call("c19", "moved after refusal", "claude", "impl", ""));
  let d19 = read_file(s19.world, run_file_path());
  -- Scoped to the receipt, for case 18's reason: two EARLIER tasks in this same
  -- document were retried three times, so a document-wide "no attempt count"
  -- assertion is false no matter how this case behaves. The closing quote is
  -- what pins "nothing follows the code", and only this task's receipt ends
  -- there.
  let a24 = check("a refusal is NOT retried once the agent has moved: it may have been delivered",
                  s19.code == 1
                    && contains(d19, "\"id\":\"mot-dlg-19000·a1\"")
                    && contains(d19, "code `agent_not_ready`\",\"reason\""));
  emit(s19.world);

  -- 20. THE PUBLISH REFUSES A CANDIDATE ITS OWN VALIDATOR REJECTS (2026-09-07).
  --     `DESIGN-dagr` §6 moved this guarantee to CI so a missing dagr could
  --     never stop a write, and that is unchanged — what is new is the case §6
  --     does not describe: dagr present, running, saying the document is
  --     broken. The live file must keep the PREVIOUS content, and the model
  --     must be told, because this can only be a producer bug.
  let before20 = read_file(s19.world, run_file_path());
  let s20 = drive(s19.world, ports_failing_at(20000, "working", false, "vet"),
                  delegate_call("c20", "rejected candidate", "claude", "impl", ""));
  let a25 = check("a candidate dagr rejects is NOT published, and the previous version stands",
                  read_file(s20.world, run_file_path()) == before20
                    && contains("${s20.out}${s20.err}", "dagr view was NOT updated")
                    && contains("${s20.out}${s20.err}", "producer bug"));
  emit(s20.world);

  -- 21. §6'S RULE, PINNED: "the producer should always write and never require
  --     the binary". A validator that cannot run — 127, no dagr on PATH — must
  --     leave the publish exactly as it was before validation existed. Without
  --     this case, tightening `dagr_says_invalid` to `code != 0` would silently
  --     make a container without dagr stop producing a run file at all.
  let s21 = drive(s20.world, ports_failing_at(21000, "working", false, "vet_missing"),
                  delegate_call("c21", "no validator here", "claude", "impl", ""));
  let a26 = check("a validator that cannot run does not stop the publish (§6: never require the binary)",
                  s21.code == 0
                    && contains(read_file(s21.world, run_file_path()), "mot-dlg-21000"));
  emit(s21.world);

  -- 22. OPTION A2 (DESIGN §10.4): the operator declares the plan, this producer
  --     owns the state. The plan carries two structural tasks and one the
  --     operator did by hand; a delegation then attaches its attempt to a
  --     DECLARED task rather than opening a second one with the same id.
  let planned = put_file(s21.world, "/tmp/.dagr/plan.json",
    "{\"dagr\":3,\"tasks\":[{\"id\":\"P1A\",\"title\":\"declared\",\"kind\":\"impl\",\"deps\":[]},{\"id\":\"P1B\",\"kind\":\"impl\",\"deps\":[\"P1A\"]},{\"id\":\"INV\",\"state\":\"done\"}]}");
  let s22 = drive_cfg(mk_cfg_plan("/tmp/.dagr/plan.json"), planned,
                      ports_at(22000, "working", false, true),
                      delegate_plan_call("c22", "work on the plan", "P1A"));
  let d22 = read_file(s22.world, run_file_path());
  let a27 = check("the operator's plan is seeded: declared tasks, their deps, and the hand-done one settled",
                  s22.code == 0
                    && contains(d22, "\"id\":\"P1A\"")
                    && contains(d22, "\"deps\":[\"P1A\"]")
                    && contains(d22, "\"actor\":\"operator\"")
                    && contains(d22, "declared `done` in the operator's plan"));
  -- THE ATTACHMENT, which is what makes this A2 and not merely "seed a plan".
  -- The delegation names P1A, so its attempt belongs to P1A — an INITIAL one,
  -- because a declared task has none yet — and NO mot-dlg-* task is opened for
  -- it. Without this the plan's tasks would sit queued for ever beside a
  -- parallel set of the producer's own, which is the two-documents problem
  -- moved inside one file.
  let a27b = check("a delegation naming a plan task attaches to it, and opens no second task",
                   contains(d22, "\"id\":\"P1A·a1\"")
                     && contains(d22, "\"id\":\"mot-dlg-22000\"") == false
                     && contains(s22.out, "recorded against the plan task `P1A`"));
  -- THE HALF THAT MAKES IT A2 RATHER THAN A1: the plan file is READ and never
  -- written. If this producer ever wrote it, the operator's document would have
  -- two writers again and §10.2's clobber would be back.
  let a28 = check("the plan file itself is never written",
                  read_file(s22.world, "/tmp/.dagr/plan.json") == read_file(planned, "/tmp/.dagr/plan.json"));
  emit(s22.world);

  -- 23. SEEDING IS IDEMPOTENT, and this is the case that pins it. P1A now
  --     carries an attempt and state `working` from case 22. Re-reading the
  --     plan must leave it ALONE: a seeder that re-emitted a declared task
  --     would reset it to `queued` with no attempts, silently deleting an
  --     observation with an operator's declaration. The plan describes
  --     intent; once a task exists here its state is this producer's.
  let s23 = drive_cfg(mk_cfg_plan("/tmp/.dagr/plan.json"), s22.world,
                      ports_at(23000, "working", false, true),
                      delegate_plan_call("c23", "second go at the same plan task", "P1A"));
  let d23 = read_file(s23.world, run_file_path());
  let a29 = check("re-reading the plan does not reset a task this producer has observed",
                  s23.code == 0
                    && contains(d23, "\"id\":\"P1A·a1\"")
                    && contains(d23, "\"id\":\"P1A·a2\""));
  emit(s23.world);

  -- 24. THE MODEL DECLARES THE PLAN, and this is the case the 2026-09-08
  --     failure would have caught. `mk_cfg()` carries NO `dagr_plan`, so the
  --     container channel is off exactly as it is in a checkout whose
  --     `.devcontainer` is mounted read-only. The plan reaches the producer
  --     only because the operator said its path and the model passed it on.
  --
  --     A SECOND PLAN FILE WITH IDS THIS RUN FILE HAS NEVER SEEN, deliberately:
  --     P1A and P1B are already in the document from cases 22-23, so attaching
  --     to one of those would prove nothing about where the plan came from.
  --     `Q1` can only be here if the declaration was read.
  let declared_plan = put_file(s23.world, "/tmp/.dagr/plan-declared.json",
    "{\"dagr\":3,\"tasks\":[{\"id\":\"Q1\",\"title\":\"declared by the model\",\"kind\":\"impl\",\"deps\":[]},{\"id\":\"Q2\",\"kind\":\"impl\",\"deps\":[\"Q1\"]}]}");
  let s24 = drive_cfg(mk_cfg(), declared_plan,
                      ports_at(24000, "working", false, true),
                      delegate_declare_call("c24", "work the declared plan", "Q1", "/tmp/.dagr/plan-declared.json"));
  let d24 = read_file(s24.world, run_file_path());
  let a30 = check("a plan named by the model seeds and attaches, with no HERDR_DAGR_PLAN set",
                  s24.code == 0
                    && contains(d24, "\"id\":\"Q1\"")
                    && contains(d24, "\"deps\":[\"Q1\"]")
                    && contains(d24, "\"id\":\"Q1·a1\"")
                    && contains(d24, "\"id\":\"mot-dlg-24000\"") == false
                    && contains(s24.out, "is in effect for the rest of this session"));
  -- THE DECLARATION IS ON DISK, keyed by pane and session like every other
  -- per-run path, because that is the whole mechanism: this extension holds no
  -- state between tool calls.
  let a30b = check("the declaration is recorded in the session's plan marker",
                   read_file(s24.world, "/tmp/.dagr/.plan-w1-p1-200") == "/tmp/.dagr/plan-declared.json");
  emit(s24.world);

  -- 25. AND IT STICKS. The operator names the plan once, in their first
  --     sentence; a model that had to repeat the path on every call would drop
  --     it, and the graph would go back to accumulating parallel work. This
  --     call passes NO `dagr_plan` and must still attach.
  let s25 = drive_cfg(mk_cfg(), s24.world,
                      ports_at(25000, "working", false, true),
                      delegate_plan_call("c25", "the next task in the declared plan", "Q2"));
  let d25 = read_file(s25.world, run_file_path());
  let a31 = check("a later delegation inherits the declared plan without naming it again",
                  s25.code == 0
                    && contains(d25, "\"id\":\"Q2·a1\"")
                    && contains(d25, "\"id\":\"mot-dlg-25000\"") == false);
  emit(s25.world);

  -- 26. A PLAN IN EFFECT THAT CANNOT BE READ SAYS SO. This is the failure mode
  --     the container channel had and the reason it went undiagnosed for a
  --     whole session: seeding nothing is indistinguishable from having no plan
  --     unless the producer says which it is. The work still runs — a refused
  --     linkage never refuses the delegation (§3.6).
  let s26 = drive_cfg(mk_cfg(), s25.world,
                      ports_at(26000, "working", false, true),
                      delegate_declare_call("c26", "name a plan that is not there", "Q3", "/tmp/.dagr/nope.json"));
  --     `Q3` and not `Q1`: an unreadable plan does not UN-seed what a readable
  --     one already put in the document, and it must not — those tasks carry
  --     this producer's own observations now. So the id has to be one the
  --     document has never held for the refusal to be about the plan at all.
  --     Both halves of the diagnosis have to be present: which id could not be
  --     found, and why no plan could supply it. Either alone is what left the
  --     2026-09-08 session guessing.
  let a32 = check("a plan in effect with no file behind it is reported, and the work is opened as new",
                  s26.code == 0
                    && contains(s26.out, "there is no such file")
                    && contains(s26.out, "was NOT linked")
                    && contains(read_file(s26.world, run_file_path()), "\"id\":\"mot-dlg-26000\""));
  emit(s26.world);

  -- 27. A PLAN OUTSIDE THE SANDBOX IS REFUSED BEFORE IT IS READ, not around
  --     the read: a path outside AILANG_FS_SANDBOX terminates the run rather
  --     than returning an error, so the check cannot be a `catch`. The previous
  --     declaration survives, because a refused declaration must not quietly
  --     retire a working one.
  let s27 = drive_cfg(mk_cfg(), s26.world,
                      ports_at(27000, "working", false, true),
                      delegate_declare_call("c27", "name a plan outside the sandbox", "Q1", "/etc/passwd"));
  let a33 = check("a plan outside the working directory is refused with its reason, and nothing is recorded",
                  s27.code == 0
                    && contains(s27.out, "outside Motoko's filesystem sandbox")
                    && read_file(s27.world, "/tmp/.dagr/.plan-w1-p1-200") == "/tmp/.dagr/nope.json");
  emit(s27.world);

  -- 28. THE SHAPE A HUMAN ACTUALLY TYPES. The operator says
  --     ".dagr/run-plan003.json" and the model repeats it; nobody writes an
  --     absolute path in prose. `path_within` is a lexical prefix test against
  --     an absolute workdir, so before this case the one path shape that ever
  --     occurs was refused as "outside the sandbox" while sitting inside it —
  --     measured on the first live use of `dagr_plan`, 2026-09-08, with the
  --     schema's own example as the failing value.
  let rel_plan = put_file(s27.world, "/tmp/plan-rel.json",
    "{\"dagr\":3,\"tasks\":[{\"id\":\"R1\",\"title\":\"named relatively\",\"kind\":\"impl\",\"deps\":[]}]}");
  let s28 = drive_cfg(mk_cfg(), rel_plan,
                      ports_at(28000, "working", false, true),
                      delegate_declare_call("c28", "name the plan the way a human types it", "R1", "plan-rel.json"));
  let a34 = check("a plan path relative to the working directory resolves and attaches",
                  s28.code == 0
                    && contains(read_file(s28.world, run_file_path()), "\"id\":\"R1·a1\"")
                    && contains(s28.out, "/tmp/plan-rel.json")
                    && read_file(s28.world, "/tmp/.dagr/.plan-w1-p1-200") == "/tmp/plan-rel.json");
  emit(s28.world);

  -- 29. AND TRAVERSAL IS REFUSED BY SHAPE. `path_within` would ACCEPT
  --     `/tmp/../etc/passwd` — it is a lexical prefix test — so `..` has to be
  --     rejected before resolution. This is the only path in this file supplied
  --     by a model rather than by the operator's environment, which is why the
  --     rule is stricter here than anywhere else.
  let s29 = drive_cfg(mk_cfg(), s28.world,
                      ports_at(29000, "working", false, true),
                      delegate_declare_call("c29", "escape the sandbox", "R1", "../etc/passwd"));
  let a35 = check("a plan path containing `..` is refused and the previous declaration stands",
                  s29.code == 0
                    && contains(s29.out, "may not contain `..`")
                    && read_file(s29.world, "/tmp/.dagr/.plan-w1-p1-200") == "/tmp/plan-rel.json");
  emit(s29.world);

  if a1 && a1b && a2 && a3 && a4 && a5 && a5b && a6 && a7 && a7b && a8 && a9
     && a10 && a10b && a11 && a12 && a13 && a14 && a15 && a16 && a17 && a17b
     && a18 && a19 && a20 && a21 && a22 && a23 && a24 && a25 && a26 && a27 && a27b && a28 && a29
     && a30 && a30b && a31 && a32 && a33 && a34 && a35 then () else exit(1)
}
