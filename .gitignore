# Dependencies
node_modules/
src/tui/dist/

# Build caches
.ailang/
!.ailang/state/
!.ailang/state/sprints/

# Generated build artifacts
.packages/

# Local AILANG source checkout used to build a patched binary (e.g. the Bedrock
# OPENAI_BASE_URL direct-fallback fix). Its own git repo + ailang/.bin/ailang
# build artifact must never be committed into motoko_agent.
/ailang/
# Environment
.env

# reMarkable Cloud device token (scripts/rm-send.sh). Kept in the workspace
# rather than ~/.config so it survives a devcontainer rebuild — never commit it.
.remarkable/
.venv-litellm/

# OS
.DS_Store

# Session data
.motoko/logfile/
.motoko-store/
.omp

# Autoresearch experiment scratch / session dirs (runtime DBs, JSONL logs, notes)
.motoko/ar_bench_scratch/
.motoko/autoresearch*/

# Emscripten SDK toolchain (large; installed locally, not vendored)
.emsdk/

# Mirrored absolute-path profiles (build artifact created by
# runtime-process.ts mirrorAbsoluteProfile; source is e.g. ~/.motoko/config/mark)
.motoko/config/*/.source

artifacts/*
tmp/*
eval_results/*
logs/*
.motoko/logfile/
polyglot_logs/
benchmark_generared_files/
benchmarks/results/
__pycache__
/ext/
/web/
benchmarks/fixtures/autoresearch_intcodec/corpus/
code-graph/
!tools/code-graph/
!tools/code-graph/**
tools/code-graph/.out/
tools/code-graph/**/__pycache__/
tools/code-graph/.pytest_cache/
# The two un-ignores above re-include EVERYTHING under tools/code-graph/, which swept
# AILANG compile caches into git twice (B2a's 7bca61c, WI-B4's 072bb05 — 34 files each).
# A tracked compile cache is the worst file class in this repo: a stale .ailang cache
# produces phantom type errors, and a fresh checkout would start with one it never built.
# Nothing reads them — test_precision_recall.py and test_source_index.py read the
# fixtures' .ail sources, not the cache.
tools/code-graph/**/.ailang/
.venv-marimo/
__marimo__
deepseek-harness/
.pnpm-store/

# GitHub PR ops cache (.agent/github/): raw API JSON, immutable and regenerable
# by `make pr_sync`. Deleting it must lose nothing, and committing it would
# break the invariant that separates it from the git-versioned state records
# next door — see ADR-001 D3 in .agent/projects/016_github_ops/.
.agent/github/cache/

# Generated review renderings and in-flight posting buffers from `pr-loop`.
# Both are derived from the cache plus the authored response artifact, so they
# are regenerable and must not be committed alongside the versioned records.
.agent/github/prs/*/review-*.md
.agent/github/prs/*/.response-*.posting.md
